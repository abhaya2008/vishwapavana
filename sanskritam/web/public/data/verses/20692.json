[{"id": 7000692000, "chapter_id": 20692, "verse_number": "६-३५-१", "content_sanskrit": "महादेव उवाच ।\nअतस्त्वां संप्रवक्ष्यामि उन्मीलनीमनुत्तमाम् ।\nयस्याः श्रवणमात्रेण जन्मसंसारबंधनात् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000692001, "chapter_id": 20692, "verse_number": "६-३५-२", "content_sanskrit": "पापात्मा मुच्यते पापैः स्वर्गलोके महीयते ।\nदेवताः पितरश्चैव तस्या गतिमवाप्नुयुः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000692002, "chapter_id": 20692, "verse_number": "६-३५-३", "content_sanskrit": "विद्यार्थी लभते विद्यां सर्वकामानवाप्नुयात् ।\nतस्या व्रतान्न संदेहः स्वर्गलोके महीयते ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000692003, "chapter_id": 20692, "verse_number": "६-३५-४", "content_sanskrit": "स्वस्थानं तत्र वै प्राप्तः शिवलोके महीयते ।\nअतस्त्वं कुरुषे राजन्वैष्णवानां तु पूजनम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000692004, "chapter_id": 20692, "verse_number": "६-३५-५", "content_sanskrit": "वैष्णवानां तु ये राजन्सेवा कुर्वंति नित्यशः ।\nतेषां दंडं च कुरुषे नो वा तेषां नराधिपः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000692005, "chapter_id": 20692, "verse_number": "६-३५-६", "content_sanskrit": "भोजनानंतरं तेषां भोजनं कुरुते नृप ।\nतैरेव पूजितो विष्णुर्यैर्भक्त्या तु प्रपूजितः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000692006, "chapter_id": 20692, "verse_number": "६-३५-७", "content_sanskrit": "शालग्रामशिलाभूतां दत्त्वा मूर्द्धनि प्रत्यहम् ।\nत्वं धारयसि भूपाल कंठे नित्यं सुभक्तितः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000692007, "chapter_id": 20692, "verse_number": "६-३५-८", "content_sanskrit": "धूपशेषं तु वै विष्णोर्भक्त्या भजसि भूपते ।\nआरार्तिकं सदा कृत्वा भक्तानां वेदयेर्नृप ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000692008, "chapter_id": 20692, "verse_number": "६-३५-९", "content_sanskrit": "शंखोदकं हरेर्मूर्ध्नि भ्रामयित्वा तु भक्तितः ।\nनित्यं बिभर्षि शिरसि शेषं यच्छसि वैष्णवान् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000692009, "chapter_id": 20692, "verse_number": "६-३५-१०", "content_sanskrit": "नैवेद्यं प्रत्यहं कृत्वा सर्वोपस्करसंयुतम् ।\nविष्वक्सेनाय दत्वा वै स्वयं भुनक्षि वाडव ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000692010, "chapter_id": 20692, "verse_number": "६-३५-११", "content_sanskrit": "विष्णोर्निवेदितं चान्नं वैष्णवैः सह भुज्यते ।\nनित्यं नामसहस्रेण भक्त्या स्तौषि जनार्दनम् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000692011, "chapter_id": 20692, "verse_number": "६-३५-१२", "content_sanskrit": "दीपार्घदानं वै विष्णोः कुरुषे गीतनर्तनम् ।\nश्यामांकुरैः पूजयसे पूज्यंते नृपसत्तम ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000692012, "chapter_id": 20692, "verse_number": "६-३५-१३", "content_sanskrit": "श्यामांकुरैः सदा वत्स पूजनं चाति दुर्ल्लभम् ।\nपृथ्वीदानसमं पुण्यं दूर्वया पूजने कृते ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000692013, "chapter_id": 20692, "verse_number": "६-३५-१४", "content_sanskrit": "अतो वै नास्ति लोकेऽस्मिन्दूर्वायाः सदृशं भुवि ।\nतया वै पूजनं कार्यं विष्णुसायुज्यमिच्छता ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000692014, "chapter_id": 20692, "verse_number": "६-३५-१५", "content_sanskrit": "अतस्त्वं कुरुषे नित्यं पूजनं दूर्वया सह ।\nयवाक्षतैर्विशेषेण पूजनं कुरुषेन वा ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000692015, "chapter_id": 20692, "verse_number": "६-३५-१६", "content_sanskrit": "पक्षेपक्षे नृपश्रेष्ठ विधिवद्द्वादशीव्रतम् ।\nयत्कृतं तु महाराज महापापप्रणाशनम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000692016, "chapter_id": 20692, "verse_number": "६-३५-१७", "content_sanskrit": "मोक्षदं सुखदं चैव तथायुष्यप्रदं सदा ।\nएतद्विष्णुव्रतं प्रोक्तं वैष्णवानां तु मोक्षदम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000692017, "chapter_id": 20692, "verse_number": "६-३५-१८", "content_sanskrit": "गृहस्थानां तु सुखदं यतीनां मुक्तिदायकम् ।\nसर्वरोगादिशमनं पवित्रं कायशोधनम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000692018, "chapter_id": 20692, "verse_number": "६-३५-१९", "content_sanskrit": "व्रतमेतच्च कुरुषे नो वा चैव नराधिप ।\nदशमीवेधरहितं कुरुषे जागरान्वितम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000692019, "chapter_id": 20692, "verse_number": "६-३५-२०", "content_sanskrit": "तुलसीपत्रनिकरैर्नित्यं पूजयसे हरिम् ।\nगोपीचंदनजं पत्रं भाले वा नृपसत्तम ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000692020, "chapter_id": 20692, "verse_number": "६-३५-२१", "content_sanskrit": "धारितं सर्वलोकानां पवित्रीकरणं नृप ।\nअतस्त्वं च धारयसे गोपीचंदनसंभवम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000692021, "chapter_id": 20692, "verse_number": "६-३५-२२", "content_sanskrit": "ब्रह्महा हेमहारी च मद्यपानी तथैव च ।\nअगम्यगो महापापी तथा ह्यनृतभाषितः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000692022, "chapter_id": 20692, "verse_number": "६-३५-२३", "content_sanskrit": "ते सर्वे मुक्तिमायांति तिलकं धारणादृताः ।\nबिभर्षि कंठे नित्यं त्वं धात्रीफलसमुद्भवाम् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000692023, "chapter_id": 20692, "verse_number": "६-३५-२४", "content_sanskrit": "मालां मुख्यायुतसमां तुलसीपत्रसंभवाम् ।\nशालग्रामशिलायुक्तां द्वारकायां समुद्भवाम् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000692024, "chapter_id": 20692, "verse_number": "६-३५-२५", "content_sanskrit": "नित्यं पूजयसे भूप भुक्तिमुक्तिफलप्रदाम् ।\nपद्मसंज्ञं पुराणं वै पठसे पुरतो हरेः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000692025, "chapter_id": 20692, "verse_number": "६-३५-२६", "content_sanskrit": "चरितं दैत्यराज्यस्य प्रह्लादस्य च भूपते ।\nवासरं वासुदेवस्य सवेधं कुर्वतो नरान् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000692026, "chapter_id": 20692, "verse_number": "६-३५-२७", "content_sanskrit": "निवारयसि भूपाल शास्त्रं दृष्ट्वा प्रयत्नतः ।\nसवेधं वासरं विष्णोर्यस्मिन्राष्ट्रे प्रवर्तते ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000692027, "chapter_id": 20692, "verse_number": "६-३५-२८", "content_sanskrit": "लिप्यते तेन पापेन राजा भवति नारकी ।\nवेधं चतुर्विधं त्यक्त्वा समुपोष्य हरेर्दिनम् ।\nकुलकोटिं समुद्धृत्य विष्णुलोके महीयते ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000692028, "chapter_id": 20692, "verse_number": "६-३५-२९", "content_sanskrit": "गौतम उवाच ।\nशृणु भूपाल वक्ष्यामि वैष्णवाख्यं महाव्रतम् ।\nयं श्रुत्वा पापिनः सर्वे मुक्तिमायांति तत्क्षणात् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000692029, "chapter_id": 20692, "verse_number": "६-३५-३०", "content_sanskrit": "द्वादशीसंभवं पुण्यं मया ख्यातं न कस्यचित् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000692030, "chapter_id": 20692, "verse_number": "६-३५-३१", "content_sanskrit": "वैष्णवोऽसि महाराज भक्तो भागवते नृणाम् ।\nवैष्णवं तु महागुह्यं तद्व्रतं त्वं निशामय ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000692031, "chapter_id": 20692, "verse_number": "६-३५-३२", "content_sanskrit": "उन्मीलनी नाम पुरा भक्त्या मे माधवेन तु ।\nकथिता सुप्रसन्नेन तां ते भूप वदाम्यहम् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000692032, "chapter_id": 20692, "verse_number": "६-३५-३३", "content_sanskrit": "एकादशी अहोरात्रं प्रभाते घटिका भवेत् ।\nउन्मीलनी तु सा ज्ञेया विशेषेण हरिप्रिया ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000692033, "chapter_id": 20692, "verse_number": "६-३५-३४", "content_sanskrit": "त्रैलोक्ये यानि तीर्थानि पुण्यान्यायतनानि च ।\nकोट्यंशे नैव तुल्यानि मखा वेदास्तपांसि च ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000692034, "chapter_id": 20692, "verse_number": "६-३५-३५", "content_sanskrit": "उन्मीलनी समं किंचिन्न भूतं न भविष्यति ।\nप्रयागो न कुरुक्षेत्रं न काशी न च पुष्करः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000692035, "chapter_id": 20692, "verse_number": "६-३५-३६", "content_sanskrit": "शैलो हिमाचलो नैव न मेरुर्गंधमादनः ।\nशैलो न नीलनिषधो न विंध्यो नैव नैमिषम् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000692036, "chapter_id": 20692, "verse_number": "६-३५-३७", "content_sanskrit": "गोदावरी न कावेरी चंद्रभागा न वेदिका ।\nन तापी न पयोष्णी च न क्षिप्रा नैव चंदना ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000692037, "chapter_id": 20692, "verse_number": "६-३५-३८", "content_sanskrit": "चर्मण्वती च सरयूश्चंद्रभागा न गंडिका ।\nगोमती च विपाशा च शोणाख्यश्च महानदः ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000692038, "chapter_id": 20692, "verse_number": "६-३५-३९", "content_sanskrit": "किमत्र बहुनोक्तेन भूयोभूयो नराधिप ।\nउन्मीलनीसमं किंचिन्न देवः केशवात्परः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000692039, "chapter_id": 20692, "verse_number": "६-३५-४०", "content_sanskrit": "उन्मीलनीमनु प्राप्य यैः कृतं केशवार्चनम् ।\nपापचक्रसमूहस्य राशयः पतिताः क्षणात् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000692040, "chapter_id": 20692, "verse_number": "६-३५-४१", "content_sanskrit": "यस्मिन्मासे महीपाल तिथिरुन्मीलनी भवेत् ।\nतन्मासनाम्ना गोविंदः पूजनीयः प्रयत्नतः ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000692041, "chapter_id": 20692, "verse_number": "६-३५-४२", "content_sanskrit": "जातरूपमयः कार्यं मासनाम्ना तु माधवः ।\nस्वशक्त्या विश्वरूपस्तु श्रद्धाभक्तिसमन्वितः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000692042, "chapter_id": 20692, "verse_number": "६-३५-४३", "content_sanskrit": "पवित्रोदकसंयुक्तं पंचरत्नसमन्वितम् ।\nगंधपुष्पाक्षतैर्युक्तं कुंभं स्रग्दामभूषितम् ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000692043, "chapter_id": 20692, "verse_number": "६-३५-४४", "content_sanskrit": "पात्रं च सोदकं कार्यं गोधूमैश्चापि पूरितम् ।\nनानारत्नैश्च संयुक्तं नानागंधैः प्रपूजितम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000692044, "chapter_id": 20692, "verse_number": "६-३५-४५", "content_sanskrit": "मल्लिकामोदसंयुक्तं जातीपुष्पैः प्रपूजितम् ।\nश्वेताख्यैस्तंदुलैश्चैव पूरणीयः प्रयत्नतः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000692045, "chapter_id": 20692, "verse_number": "६-३५-४६", "content_sanskrit": "प्रदद्याद्वस्त्रयुग्मं तु उपवीतं तु सोत्तरम् ।\nउपानहौ तु राजर्षे आतपत्रं शिरोपरि ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000692046, "chapter_id": 20692, "verse_number": "६-३५-४७", "content_sanskrit": "भोजनं जलपात्रं च सप्तधान्यं तिलैः सह ।\nरूप्यं चैव तु कार्पासं पायसं मुद्रिका हरेः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000692047, "chapter_id": 20692, "verse_number": "६-३५-४८", "content_sanskrit": "धेनुर्वात्र तु दातव्या वत्सालंकारसंयुता ।\nसुवर्णशृंगी रौप्यखुरी ताम्रपृष्ठी तथैव च ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000692048, "chapter_id": 20692, "verse_number": "६-३५-४९", "content_sanskrit": "कांस्यदोहीं रत्नपुच्छीं दद्याद्वै गुरवे तदा ।\nशय्यां सोपस्करां दद्यात्साधवे भक्तिपूर्वकम् ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000692049, "chapter_id": 20692, "verse_number": "६-३५-५०", "content_sanskrit": "धूपं दीपं तु नैवेद्यं फलपत्रं निवेदयेत् ।\nपूजनीयो महाभक्तैर्मंत्रैरेभिस्तु केशवः ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000692050, "chapter_id": 20692, "verse_number": "६-३५-५१", "content_sanskrit": "तुलसीपत्रसंयुक्तैः पुष्पैः कालोद्भवैस्तथा ।\nमासनाम्नैव चरणौ जानुनी विष्णुरूपिणे ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000692051, "chapter_id": 20692, "verse_number": "६-३५-५२", "content_sanskrit": "गुह्ये तु गुह्यपतये कटे वै पीतवाससे ।\nब्रह्ममूर्तिभृते नाभावुदरे विश्वयोनये ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000692052, "chapter_id": 20692, "verse_number": "६-३५-५३", "content_sanskrit": "हृदये ज्ञानगम्याय कंठे वैकुंठमूर्तये ।\nऊर्द्ध्वगाय ललाटे तु बाहौ दक्षांतकारिणे ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000692053, "chapter_id": 20692, "verse_number": "६-३५-५४", "content_sanskrit": "उत्तमांगे सुरेशाय सर्वांगे सर्वमूर्तये ।\nस्वनाम्ना चायुधादीनि पूजनीयानि भक्तितः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000692054, "chapter_id": 20692, "verse_number": "६-३५-५५", "content_sanskrit": "अर्घदानं प्रकर्तव्यं नालिकेरादिभिः समम् ।\nशंखोपरि जले कृत्वा गंधपुष्पाक्षतान्वितम् ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000692055, "chapter_id": 20692, "verse_number": "६-३५-५६", "content_sanskrit": "सूत्रेणावेष्टितं कृत्वा दद्यादर्घं विधानतः ।\nदेवदेव महादेव श्रीकेशव जनार्दन ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000692056, "chapter_id": 20692, "verse_number": "६-३५-५७", "content_sanskrit": "सुब्रह्मण्य नमस्तेऽस्तु पुण्यराशिविवर्धन ।\nशोकमोहमहापापान्मामुद्धर भवार्णवात् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000692057, "chapter_id": 20692, "verse_number": "६-३५-५८", "content_sanskrit": "सुकृतं न कृतं किचिज्जन्मकोटिशतैरपि ।\nतथापि मां महास्वामिन्मामुद्धर भवार्णवात् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000692058, "chapter_id": 20692, "verse_number": "६-३५-५९", "content_sanskrit": "व्रतेनानेन देवेश ये चान्ये मम पूर्वजाः ।\nवियोनिं च गताश्चान्ये पापमृत्युवशं गताः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000692059, "chapter_id": 20692, "verse_number": "६-३५-६०", "content_sanskrit": "ये भविष्यंति येऽतीताः प्रेतलोकान्समुद्धर ।\nश्रांतोस्म्यहमधीनस्य भक्तिरव्यभिचारिणी ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000692060, "chapter_id": 20692, "verse_number": "६-३५-६१", "content_sanskrit": "दत्तमर्घं मया तुभ्यं भक्त्या गृह्ण गदाधर ।\nदत्वार्घं धूपदीपाद्यैर्नैवेद्यैर्विष्णुसंभवैः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000692061, "chapter_id": 20692, "verse_number": "६-३५-६२", "content_sanskrit": "स्तोत्रैर्नीराजनैर्गीतैर्भृत्यैः संतोषयेद्धरिम् ।\nवस्त्रैर्दानैश्च गोदानैर्भोजनैस्तोषयेद्गुरुम् ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000692062, "chapter_id": 20692, "verse_number": "६-३५-६३", "content_sanskrit": "तथातथा विधातव्यं गुरुर्वै प्रीतिमाप्नुयात् ।\nलोकानां तारणार्थाय धात्रा सृष्टो गुरुर्यतः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000692063, "chapter_id": 20692, "verse_number": "६-३५-६४", "content_sanskrit": "अतो वै गुरुपूजा च कर्त्तव्या वै प्रयत्नतः ।\nअहितं यो नाशयति स्वहितं दर्शयेत्सदा ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000692064, "chapter_id": 20692, "verse_number": "६-३५-६५", "content_sanskrit": "स गुरुः स च विज्ञेयः सर्वधर्मार्थकोविदः ।\nअकुर्वन्वित्तशाठ्यं तु गुरवे तं निवेदयेत् ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000692065, "chapter_id": 20692, "verse_number": "६-३५-६६", "content_sanskrit": "गुरोर्निवेदिते भूप परिपूर्णं भवेद्व्रतम् ।\nकृत्वा दिवातनं कर्म भोजनं ब्राह्मणैः सह ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000692066, "chapter_id": 20692, "verse_number": "६-३५-६७", "content_sanskrit": "कर्त्तव्यं नृपशार्दूल दिनं नेयं कथानकैः ।\nअनेन विधिना यस्तु कुर्यादुन्मीलनीव्रतम् ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000692067, "chapter_id": 20692, "verse_number": "६-३५-६८", "content_sanskrit": "कल्पकोटिसहस्राणि वसते विष्णुसन्निधौ ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]