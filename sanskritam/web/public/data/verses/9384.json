[{"id": 40022172, "chapter_id": 9384, "verse_number": "1", "content_sanskrit": "प्रस्थाप्य च बलं सर्वं मासमात्रोषितः पथि । एक एवाशु शत्रुघ्नो जगाम त्वरितं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022173, "chapter_id": 9384, "verse_number": "2", "content_sanskrit": "द्विरात्रमन्तरे शूर उष्य राघवनन्दनः । वाल्मीकेराश्रमं पुण्यमगच्छद्वासमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022174, "chapter_id": 9384, "verse_number": "3", "content_sanskrit": "सो ऽभिवाद्य महात्मानं वाल्मीकिं मुनिसत्तमम् । कृताञ्जलिरथो भूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022175, "chapter_id": 9384, "verse_number": "4", "content_sanskrit": "भगवन्वस्तुमिच्छामि गुरोः कृत्यादिहागतः । श्वः प्रभाते गमिष्यामि प्रतीचीं वारुणीं दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022176, "chapter_id": 9384, "verse_number": "5", "content_sanskrit": "शत्रुघ्नस्य वचः श्रुत्वा प्रहस्य मुनिपुङ्गवः । प्रत्युवाच महात्मानं स्वागतं ते महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022177, "chapter_id": 9384, "verse_number": "6", "content_sanskrit": "स्वमाश्रममिदं सौम्य राघवाणां कुलस्य हि । आसनं पाद्यमर्ध्यं च निर्विशङ्कः प्रतीच्छ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022178, "chapter_id": 9384, "verse_number": "7", "content_sanskrit": "प्रतिगृह्य तदा पूजां फलमूलं च भोजनम् । भक्षयामास काकुत्स्थस्तृप्तिं च परमां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022179, "chapter_id": 9384, "verse_number": "8", "content_sanskrit": "स भुक्त्वा फलमूलं च महर्षिं तमुवाच ह । इयं यज्ञविभूतिस्ते कस्याश्रमसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022180, "chapter_id": 9384, "verse_number": "9", "content_sanskrit": "तत्तस्य भाषितं श्रुत्वा वाल्मीकिर्वाक्यमब्रवीत् । शत्रुघ्न शृणु यस्येदं बभूवायतनं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022181, "chapter_id": 9384, "verse_number": "10", "content_sanskrit": "युष्माकं पूर्वको राजा सौदासस्तस्य भूपतेः । पुत्रो वीरसहो नाम वीर्यवानतिधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022182, "chapter_id": 9384, "verse_number": "11", "content_sanskrit": "स बाल एव सौदासो मृगयामुपचक्रमे । चञ्चूर्यमाणं ददृशे स शूरो राक्षसद्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022183, "chapter_id": 9384, "verse_number": "12", "content_sanskrit": "शार्दूलरूपिणौ घोरौ मृगान्बहुसहस्रशः । भक्षमाणावसन्तुष्टौ पर्याप्तिं नैव जग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022184, "chapter_id": 9384, "verse_number": "13", "content_sanskrit": "स तु तौ राक्षसौ दृष्ट्वा निर्मृगं च वनं कृतम् । क्रोधेन महता ऽ ऽविष्टो जघानैकं महेषुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022185, "chapter_id": 9384, "verse_number": "14", "content_sanskrit": "विनिपात्य तमेकं तु सौदासः पुरुषर्षभः । विज्वरो विगतामार्षो हतं रक्षो ह्युदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022186, "chapter_id": 9384, "verse_number": "15", "content_sanskrit": "निरीक्षमाणं तं दृष्ट्वा सहायं तस्य रक्षसः । सन्तापमकरोद्घोरं सौदासं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022187, "chapter_id": 9384, "verse_number": "16", "content_sanskrit": "यस्मादनपराधं त्वं सहायं मम जघ्निवान् । तस्मात्तवापि पापिष्ठ प्रदास्यामि प्रतिक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022188, "chapter_id": 9384, "verse_number": "17", "content_sanskrit": "एवमुक्त्वा तु तद्राक्षस्तत्रैवान्तरधीयत । कालपर्याययोगेन राजा मित्रसहो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022189, "chapter_id": 9384, "verse_number": "18", "content_sanskrit": "राजापि यजते यज्ञमस्याश्रमसमीपतः । अश्वमेधं महायज्ञं तं वसिष्ठो ऽभ्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022190, "chapter_id": 9384, "verse_number": "19", "content_sanskrit": "तत्र यज्ञो महानासीद्बहुवर्षगणायुतः । समृद्धः परया लक्ष्म्या देवयज्ञसमो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022191, "chapter_id": 9384, "verse_number": "20", "content_sanskrit": "अथावसाने यज्ञस्य पूर्ववैरमनुस्मरन् । वसिष्ठरूपी राजानमिति होवाच राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022192, "chapter_id": 9384, "verse_number": "21", "content_sanskrit": "अस्य यज्ञस्य जातो ऽन्तः सामिषं भोजनं मम । दीयतामिह शीघ्रं वै नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022193, "chapter_id": 9384, "verse_number": "22", "content_sanskrit": "तच्छ्रुत्वा व्याहृतं वाक्यं रक्षसा ब्रह्मरूपिणा । भक्ष्यसंस्कारकुशलमुवाच पृथिवीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022194, "chapter_id": 9384, "verse_number": "23", "content_sanskrit": "हविष्यं सामिषं स्वादु यथा भवति भोजनम् । तथा कुरुष्व शीघ्रं वै परितुष्येद्यथा गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022195, "chapter_id": 9384, "verse_number": "24", "content_sanskrit": "शासनात्पार्थिवेन्द्रस्य सूदः सम्भ्रान्तमानसः । स राक्षसः पुनस्तत्र सूदवेषमथाकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022196, "chapter_id": 9384, "verse_number": "25", "content_sanskrit": "स मानुषमथो मांसं पार्थिवाय न्यवेदयत् । इदं स्वादु हविष्यं च सामिषं चान्नमाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022197, "chapter_id": 9384, "verse_number": "26", "content_sanskrit": "स भोजनं वसिष्ठाय पत्न्या सार्धमुपाहरत् । मदयन्त्या नरव्याघ्र सामिषं रक्षसा हृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40022198, "chapter_id": 9384, "verse_number": "27", "content_sanskrit": "ज्ञात्वा तदामिषं विप्रो मानुषं भाजनं गतम् । क्रोधेन महता ऽ ऽविष्टो व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40022199, "chapter_id": 9384, "verse_number": "28", "content_sanskrit": "यस्मात्त्वं भोजनं राजन्ममैतद्दातुमिच्छसि । तस्माद्भोजनमेतत्ते भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40022200, "chapter_id": 9384, "verse_number": "29", "content_sanskrit": "ततः क्रुद्धस्तु सौदासस्तोयं जग्राह पाणिना । वसिष्ठं शप्तुमारेभे भार्या चैनमवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40022201, "chapter_id": 9384, "verse_number": "30", "content_sanskrit": "राजन्प्रभुर्यतो ऽस्माकं वसिष्ठो भगवानृषिः । प्रतिशप्तुं न शक्तस्त्वं देवतुल्यं पुरोधसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40022202, "chapter_id": 9384, "verse_number": "31", "content_sanskrit": "ततः क्रोधमयं तोयं तेजोबलसमन्वितम् । व्यसर्जयत धर्मात्मा ततः पादौ सिषेच च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40022203, "chapter_id": 9384, "verse_number": "32", "content_sanskrit": "तेनास्य राज्ञस्तौ पादौ तदा कल्माषतां गतौ । तदाप्रभृति राजा ऽसौ सौदासः सुमहायशाः । कल्माषपादः संवृत्तः ख्यातश्चैव तथा नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40022204, "chapter_id": 9384, "verse_number": "33", "content_sanskrit": "स राजा सह पत्न्या वै प्रणिपत्य मुहुर्मुहुः । पुनर्वसिष्ठं प्रोवाच यदुक्तं ब्रह्मरूपिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40022205, "chapter_id": 9384, "verse_number": "34", "content_sanskrit": "तच्छ्रुत्वा पार्थिवेन्द्रस्य रक्षसा विकृतं च तत् । पुनः प्रोवाच राजानं वसिष्ठः पुरुषर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40022206, "chapter_id": 9384, "verse_number": "35", "content_sanskrit": "मया रोषपरीतेन यदिदं व्याहृतं वचः । नैतच्छक्यं वृथा कर्तुं प्रदास्यामि च ते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40022207, "chapter_id": 9384, "verse_number": "36", "content_sanskrit": "कालो द्वादश वर्षाणि शापस्यान्तो भविष्यति । मत्प्रासादाच्च राजेन्द्र व्यतीतं न स्मरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40022208, "chapter_id": 9384, "verse_number": "37", "content_sanskrit": "एवं स राजा तं शापमुपभुज्यारिसूदनः । प्रतिलेभे पुना राज्यं प्रजाश्चैवान्वपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40022209, "chapter_id": 9384, "verse_number": "38", "content_sanskrit": "तस्य कल्माषपादस्य यज्ञस्यायतनं शुभम् । आश्रमस्य समीपे ऽस्य यन्मां पृच्छसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40022210, "chapter_id": 9384, "verse_number": "39", "content_sanskrit": "तस्य तां पार्थिवेन्द्रस्य कथां श्रुत्वा सुदारुणाम् । विवेश पर्णशालायां महर्षिमभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]