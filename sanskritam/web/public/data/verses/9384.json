[{"id": 5000384000, "chapter_id": 9384, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000384001, "chapter_id": 9384, "verse_number": "५-४५-१", "content_sanskrit": "ततस्ते राक्षसेन्द्रेण चोदिता मन्त्रिणः सुताः।\nनिर्ययुर्भवनात् तस्मात् सप्त सप्तार्चिवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000384002, "chapter_id": 9384, "verse_number": "५-४५-२", "content_sanskrit": "महद‍्बलपरीवारा धनुष्मन्तो महाबलाः।\nकृतास्त्रास्त्रविदां श्रेष्ठाः परस्परजयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000384003, "chapter_id": 9384, "verse_number": "५-४५-३", "content_sanskrit": "हेमजालपरिक्षिप्तैर्ध्वजवद्भिः पताकिभिः।\nतोयदस्वननिर्घोषैर्वाजियुक्तैर्महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000384004, "chapter_id": 9384, "verse_number": "५-४५-४", "content_sanskrit": "तप्तकाञ्चनचित्राणि चापान्यमितविक्रमाः।\nविस्फारयन्तः संहृष्टास्तडिद्वन्त इवाम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000384005, "chapter_id": 9384, "verse_number": "५-४५-५", "content_sanskrit": "जनन्यस्तास्ततस्तेषां विदित्वा किंकरान् हतान्।\nबभूवुः शोकसम्भ्रान्ताः सबान्धवसुहृज्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000384006, "chapter_id": 9384, "verse_number": "५-४५-६", "content_sanskrit": "ते परस्परसंघर्षात् तप्तकाञ्चनभूषणाः।\nअभिपेतुर्हनूमन्तं तोरणस्थमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000384007, "chapter_id": 9384, "verse_number": "५-४५-७", "content_sanskrit": "सृजन्तो बाणवृष्टिं ते रथगर्जितनिःस्वनाः।\nप्रावृट्काल इवाम्भोदा विचेरुर्नैर्ऋताम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000384008, "chapter_id": 9384, "verse_number": "५-४५-८", "content_sanskrit": "अवकीर्णस्ततस्ताभिर्हनूमान् शरवृष्टिभिः।\nअभवत् संवृताकारः शैलराडिव वृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000384009, "chapter_id": 9384, "verse_number": "५-४५-९", "content_sanskrit": "स शरान् वञ्चयामास तेषामाशुचरः कपिः।\nरथवेगांश्च वीराणां विचरन् विमलेऽम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000384010, "chapter_id": 9384, "verse_number": "५-४५-१०", "content_sanskrit": "स तैः क्रीडन् धनुष्मद्भिर्व्योम्नि वीरः प्रकाशते।\nधनुष्मद्भिर्यथा मेघैर्मारुतः प्रभुरम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000384011, "chapter_id": 9384, "verse_number": "५-४५-११", "content_sanskrit": "स कृत्वा निनदं घोरं त्रासयंस्तां महाचमूम्।\nचकार हनुमान् वेगं तेषु रक्षःसु वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000384012, "chapter_id": 9384, "verse_number": "५-४५-१२", "content_sanskrit": "तलेनाभिहनत् कांश्चित् पादैः कांश्चित् परंतपः।\nमुष्टिभिश्चाहनत् कांश्चिन्नखैः कांश्चिद् व्यदारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000384013, "chapter_id": 9384, "verse_number": "५-४५-१३", "content_sanskrit": "प्रममाथोरसा कांश्चिदूरुभ्यामपरानपि।\nकेचित् तस्यैव नादेन तत्रैव पतिता भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000384014, "chapter_id": 9384, "verse_number": "५-४५-१४", "content_sanskrit": "ततस्तेष्ववसन् नेषु भूमौ निपतितेषु च।\nतत्सैन्यमगमत् सर्वं दिशो दश भयार्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000384015, "chapter_id": 9384, "verse_number": "५-४५-१५", "content_sanskrit": "विनेदुर्विस्वरं नागा निपेतुर्भुवि वाजिनः।\nभग्ननीडध्वजच्छत्रैर्भूश्च कीर्णाभवद् रथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000384016, "chapter_id": 9384, "verse_number": "५-४५-१६", "content_sanskrit": "स्रवता रुधिरेणाथ स्रवन्त्यो दर्शिताः पथि।\nविविधैश्च स्वनैर्लङ्का ननाद विकृतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000384017, "chapter_id": 9384, "verse_number": "५-४५-१७", "content_sanskrit": "स तान् प्रवृद्धान् विनिहत्य राक्षसान्\nमहाबलश्चण्डपराक्रमः कपिः।\nयुयुत्सुरन्यैः पुनरेव राक्षसै-\nस्तदेव वीरोऽभिजगाम तोरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000384018, "chapter_id": 9384, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]