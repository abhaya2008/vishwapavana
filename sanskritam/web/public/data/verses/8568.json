[{"id": 900007521, "chapter_id": 8568, "verse_number": "149.1", "content_sanskrit": "ॐ पूर्वविकल्पः प्रकरणात्स्यात्क्रियामानसवत् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007522, "chapter_id": 8568, "verse_number": "149.2", "content_sanskrit": "विपर्ययस्तु कर्तव्यः सर्वथा शुभमिच्छता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007523, "chapter_id": 8568, "verse_number": "149.3", "content_sanskrit": "समे विकल्प एव स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007524, "chapter_id": 8568, "verse_number": "149.4", "content_sanskrit": "तदुत्तमगुरुप्राप्त्यै पूर्वानुज्ञा न मृग्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007525, "chapter_id": 8568, "verse_number": "149.5", "content_sanskrit": "गुरर्ब्रह्माऽखिलानां च विद्या चैव सरस्वती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007526, "chapter_id": 8568, "verse_number": "149.6", "content_sanskrit": "स्वोत्तमास्तु क्रमेणैव सर्वेषां गुरवः स्मृताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007527, "chapter_id": 8568, "verse_number": "149.7", "content_sanskrit": "उपदेशो ब्रह्मणस्तु सर्वेषामेव मुक्तये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]