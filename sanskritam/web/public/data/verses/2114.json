[{"id": 2050828, "chapter_id": 2114, "verse_number": "७-४१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050829, "chapter_id": 2114, "verse_number": "७-४१-१", "content_sanskrit": "सोऽभ्यगच्छद्धनुष्पाणिर्ज्यां विकर्षन्पुनः पुनः।\nसच्छत्रध्वजयन्तारं साश्वमाशु स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050830, "chapter_id": 2114, "verse_number": "७-४१-२", "content_sanskrit": "सोऽपिध्यद्दशभिर्बाणैरभिमन्युं दुरासदम्।\nसच्छत्रध्वजयन्तारं साश्वमाशु स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050831, "chapter_id": 2114, "verse_number": "७-४१-३", "content_sanskrit": "पितृपैतामहं कर्म कुर्वाणमतिमानुषम्।\nदृष्ट्वार्दितं शरैः कार्ष्मिं त्वदीया हृषिताऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050832, "chapter_id": 2114, "verse_number": "७-४१-४", "content_sanskrit": "तस्याभिमन्युरायम्य स्मयन्नेकेन पत्रिणा।\nशिरः प्रच्यावयामास तद्रथात्प्रापतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050833, "chapter_id": 2114, "verse_number": "७-४१-५", "content_sanskrit": "कर्णिकारमिवाधूतं वातेनापतितं नगात्।\n`कर्णानुजं च सम्प्रेक्ष्य तावका व्यथिताऽभवन्।\nभ्रातरं निहतं दृष्ट्वा कर्णश्चासीत्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050834, "chapter_id": 2114, "verse_number": "७-४१-६", "content_sanskrit": "विमुखीकृत्य कर्णं तु सौभद्रः कङ्कपत्रिभिः।\nअन्यानपि महेष्वासांस्तूर्णमेवाभिदुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050835, "chapter_id": 2114, "verse_number": "७-४१-७", "content_sanskrit": "ततस्तद्विततं सेन्यं हस्त्यश्वरथपत्तिमत्।\nक्रद्धोऽभिमन्युरभिनत्तिग्मतेजा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050836, "chapter_id": 2114, "verse_number": "७-४१-८", "content_sanskrit": "कर्णस्तु बहुभिर्बाणैरर्द्यमानोऽभिमन्युना।\nअपायाज्जवनैरश्वैस्ततोऽनीकमभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050837, "chapter_id": 2114, "verse_number": "७-४१-९", "content_sanskrit": "`तिंष्ठ कर्ण महेष्वास कृप दुर्योधनेति च।\nद्रोणस्य क्रोशतो राजंस्तदनीकमभज्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050838, "chapter_id": 2114, "verse_number": "७-४१-१०", "content_sanskrit": "शलभैरिव चाकाशं धाराभिरिव पर्वतः।\nअभिमन्यो शरैश्छन्नं न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050839, "chapter_id": 2114, "verse_number": "७-४१-११", "content_sanskrit": "तावकानां तु योधानां वध्यतां निशितैः शरैः।\nअन्यत्र सैन्धवाद्राजन्न स्म कश्चिदतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050840, "chapter_id": 2114, "verse_number": "७-४१-१२", "content_sanskrit": "सौभद्रस्तु ततः शङ्खं प्रध्माय पुरुषर्षभः॥\nशीघ्रमभ्यपतत्सेनां भारतीं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050841, "chapter_id": 2114, "verse_number": "७-४१-१३", "content_sanskrit": "स कक्षेऽग्निरिवोत्सृष्टो निर्दहंस्तरसा रिपून्।\nमध्ये भारतसैन्यानामार्जुनिः पर्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050842, "chapter_id": 2114, "verse_number": "७-४१-१४", "content_sanskrit": "रथनागाश्वमनुजानर्दयन्निशितैः शरैः।\nसम्प्रविश्याकरोद्भूमिं कबन्धगणसङ्कुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050843, "chapter_id": 2114, "verse_number": "७-४१-१५", "content_sanskrit": "सौभद्रचापप्रभवैर्निकृत्ताः परमेषुभिः।\nस्वानेवाभिमुखान्ध्नन्तः प्राद्रवञ्जीवितार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050844, "chapter_id": 2114, "verse_number": "७-४१-१६", "content_sanskrit": "ते घोरा रौद्रकर्माणो विपाठा बहवः शिताः।\nनिघ्न्तो रथनागाश्वाञ्जग्मुराशु वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050845, "chapter_id": 2114, "verse_number": "७-४१-१७", "content_sanskrit": "सायुधाः साङ्गुलित्राणाः सगदाः साङ्गदा रणे।\nदृश्यन्ते बाहवश्चिन्ना हेमाभारणभूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050846, "chapter_id": 2114, "verse_number": "७-४१-१८", "content_sanskrit": "शराश्चापानि खङ्गाश्च शरीराणि शिरांसि च।\nसकुण्डलानि स्रग्वीणि भूमावासन्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050847, "chapter_id": 2114, "verse_number": "७-४१-१९", "content_sanskrit": "सोपस्करैरधिष्ठानैरीषादण्डकबन्धुरैः।\nअक्षैर्विमथितैश्चक्रैर्बहुधा पतितैर्युगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050848, "chapter_id": 2114, "verse_number": "७-४१-२०", "content_sanskrit": "शक्तिचापासिभिश्चैव पतितैश्च महाध्वजैः।\nचर्मचापशरैश्चैव व्यवकीर्णैः समन्तततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050849, "chapter_id": 2114, "verse_number": "७-४१-२१", "content_sanskrit": "निहतैः क्षत्रियैरश्वैर्वारणैश्च विशाम्पते।\nअगम्यरूपा पृथिवी क्षणेनासीत्सुदारुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050850, "chapter_id": 2114, "verse_number": "७-४१-२२", "content_sanskrit": "वध्यतां राजपुत्राणां क्रन्दतामितरेतरम्।\nप्रादुरासीन्महाशब्दो भीरूणां भयवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050851, "chapter_id": 2114, "verse_number": "७-४१-२३", "content_sanskrit": "स शब्दो भरतश्चेष्ठ दिशः सर्वा व्यनादयत्॥\nसौभद्रश्चाद्रवत्सेनां घ्नन्वराश्वरथद्विपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050852, "chapter_id": 2114, "verse_number": "७-४१-२४", "content_sanskrit": "कक्षमग्निरिवोत्सृष्टो निर्दहंस्तरसा रिपून्।\nमध्ये भारतसैन्यानामार्जुनिः प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050853, "chapter_id": 2114, "verse_number": "७-४१-२५", "content_sanskrit": "विचरन्तं दिशः सर्वाः प्रदिशश्चापि भारत।\nतं तदा नानुपश्यामः सैन्ये च रजसाऽऽवृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050854, "chapter_id": 2114, "verse_number": "७-४१-२६", "content_sanskrit": "आददानं गजाश्वानां णां चायुंषि भारत।\nक्षमेन भूयः पश्यामः सूर्यं मध्यंदिने यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050855, "chapter_id": 2114, "verse_number": "७-४१-२७", "content_sanskrit": "अभिमन्युं महाराज प्रतपन्तं द्विषद्गणान्।\nस वासवसमः सङ्ख्ये वासवस्यात्मजात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050856, "chapter_id": 2114, "verse_number": "७-४१-२८", "content_sanskrit": "अभिमन्युर्महाराज सैन्यमध्ये व्यरोचत।\n`यथा पुरा वह्निसुतः सुरसैन्येषु वीर्यवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050857, "chapter_id": 2114, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे एकचत्वारिंशोऽध्यायः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]