[{"id": 7004293000, "chapter_id": 24293, "verse_number": "५-२-७१-१", "content_sanskrit": "ईश्वर उवाच ।\nएकसप्ततिकं विद्धि प्रयागेश्वरसंज्ञकम् ।\nअद्वितीयं विजानीहि महापातकनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004293001, "chapter_id": 24293, "verse_number": "५-२-७१-२", "content_sanskrit": "हास्तिनेऽ भूत्पुरे श्रीमाञ्छंतनुर्नृपसत्तमः ।\nवैवस्वतेंऽतरे कल्पे युगे द्वापरसंज्ञके॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004293002, "chapter_id": 24293, "verse_number": "५-२-७१-३", "content_sanskrit": "स चाद्भुतमहावीर्यो वज्रसंहननो युवा ।\nसर्वशास्त्रेषु कुशलः कला पुंजविचक्षणः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004293003, "chapter_id": 24293, "verse_number": "५-२-७१-४", "content_sanskrit": "बलेन विष्णुसदृशस्तेजसा भास्करोपमः ।\nगंगामेष चचारैकः सिद्धचारणसेविताम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004293004, "chapter_id": 24293, "verse_number": "५-२-७१-५", "content_sanskrit": "स कदाचिन्महाबाहुः प्रभूत बलवाहनः ।\nवनं जगाम गहनं हयनागशतैर्वृतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004293005, "chapter_id": 24293, "verse_number": "५-२-७१-६", "content_sanskrit": "गत्वा तत्र मृगान्व्याघ्रान्घातयामास लीलया ।\nमहिषाश्ववराहांश्च विनिघ्नन्राजसत्तमः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004293006, "chapter_id": 24293, "verse_number": "५-२-७१-७", "content_sanskrit": "स कदाचिद्वने तस्मिन्ददर्श परमां स्त्रियम् ।\nजाज्वल्यमानां वपुषा साक्षात्पद्मामिवापराम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004293007, "chapter_id": 24293, "verse_number": "५-२-७१-८", "content_sanskrit": "तां दृष्ट्वा हृष्टरोमाभूद्विस्मितो रूपसंपदा ।\nपिबन्निव च नेत्राभ्यां नातृप्यत नराधिपः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004293008, "chapter_id": 24293, "verse_number": "५-२-७१-९", "content_sanskrit": "सा दृष्ट्वैव च राजानं विचरंतं महाद्युतिम् ।\nस्नेहादागतसौहार्दान्नातृप्यत विलासिनी॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004293009, "chapter_id": 24293, "verse_number": "५-२-७१-१०", "content_sanskrit": "तामुवाच ततो राजा सांत्वयञ्छ्लक्ष्णया गिरा ।\nदेवी वा दानवी त्वं च गंधर्वी यदि वाप्सराः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004293010, "chapter_id": 24293, "verse_number": "५-२-७१-११", "content_sanskrit": "यक्षी वा पन्नगी वा त्वं मानुषी वा सुमध्यमे ।\nयाचे त्वांऽभोजगर्भाभे भार्या मे भव शोभने॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004293011, "chapter_id": 24293, "verse_number": "५-२-७१-१२", "content_sanskrit": "एतच्छ्रुत्वा वचो राज्ञः संस्तुतं मृदु वल्गु च ।\nअंगीकृतं तया देवि समयं प्रार्थितो नृपः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004293012, "chapter_id": 24293, "verse_number": "५-२-७१-१३", "content_sanskrit": "वारिता विप्रिये वापि त्यजेयं त्वामसंशयम् ।\nन प्रष्टव्या त्वया राजन्कासि कस्येति सर्वथा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004293013, "chapter_id": 24293, "verse_number": "५-२-७१-१४", "content_sanskrit": "एवमस्त्विति तेनोक्तं सत्येन सुकृतेन च ।\nस तस्याः शीलवृत्तेन रूपौदार्यगुणेन च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004293014, "chapter_id": 24293, "verse_number": "५-२-७१-१५", "content_sanskrit": "उपचारेण च रहस्तुतोष जगतीपतिः ।\nदिव्यरूपा हि सा देवी गंगा त्रिपथगा नदी॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004293015, "chapter_id": 24293, "verse_number": "५-२-७१-१६", "content_sanskrit": "मानुषं विग्रहं कृत्वा श्रीमंतं वरवर्णिनि ।\nराजानं रमयामास यथा रेमे तथैव च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004293016, "chapter_id": 24293, "verse_number": "५-२-७१-१७", "content_sanskrit": "स राजा रति सक्तत्वादुत्तमस्त्रीगुणैर्हृतः ।\nसंवत्सरानृतून्मासान्न बुबोध बहून्गतान्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004293017, "chapter_id": 24293, "verse_number": "५-२-७१-१८", "content_sanskrit": "रममाणस्तया सार्द्धं यथाकामं नरेश्वरः ।\nअष्टावजनयत्पुत्रां स्तस्याममरवर्णिनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004293018, "chapter_id": 24293, "verse_number": "५-२-७१-१९", "content_sanskrit": "जातं जातं च सा पुत्रं क्षिपत्यंभसि मुक्तये ।\nप्रीणामि त्वामहमिति गंगास्रोतसि पावने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004293019, "chapter_id": 24293, "verse_number": "५-२-७१-२०", "content_sanskrit": "नास्य तत्तु प्रियं राज्ञः शंतनोर्ह्यभवत्तदा ।\nनोवाच किंचित्तां देवीं त्यागाद्भीतो महीपतिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004293020, "chapter_id": 24293, "verse_number": "५-२-७१-२१", "content_sanskrit": "अथैनामष्टमे पुत्रे जाते प्रहसतीमिव ।\nउवाच राजा दुःखार्त्तः परीप्सन्पुत्रमात्मनः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004293021, "chapter_id": 24293, "verse_number": "५-२-७१-२२", "content_sanskrit": "मा वधीः कस्य कासीति किं विध्वंसि सुतानिति ।\nपुत्रहिंसा महत्पापं मा प्राप्सीस्तिष्ठ गर्हिते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004293022, "chapter_id": 24293, "verse_number": "५-२-७१-२३", "content_sanskrit": "गंगोवाच ।\nपुत्रकामा न ते हन्मि पुत्रं पुत्रवतांवर ।\nजीर्णस्तु मम वासोऽयं यथा मे समयः कृतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004293023, "chapter_id": 24293, "verse_number": "५-२-७१-२४", "content_sanskrit": "अहं गंगा जह्नुसुता महर्षिगणसेविता ।\nदेवकार्यार्थसिद्ध्यर्थमुषित्वाहं त्वया सह॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004293024, "chapter_id": 24293, "verse_number": "५-२-७१-२५", "content_sanskrit": "इमेऽष्टौ वसवो देवा महाभीमा महौजसः ।\nवशिष्ठशापदोषेण मानुषत्वमुपागताः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004293025, "chapter_id": 24293, "verse_number": "५-२-७१-२६", "content_sanskrit": "तेषामानयिता नान्यस्त्वदृते भुवि विद्यते ।\nमद्विधा मानुषी धात्री न चैवास्ति कदाचन॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004293026, "chapter_id": 24293, "verse_number": "५-२-७१-२७", "content_sanskrit": "तस्मात्तज्जननीहेतोर्मानुषत्वमुपागता ।\nस्वस्ति तेऽस्तु गमिष्यामि पुत्रं पाहि महाव्रत॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004293027, "chapter_id": 24293, "verse_number": "५-२-७१-२८", "content_sanskrit": "सैवमुक्त्वा तदा गङ्गा विष्णुमायाविमोहिता ।\nरुरोद मानुषं भावमाश्रिता तनुमध्यमा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004293028, "chapter_id": 24293, "verse_number": "५-२-७१-२९", "content_sanskrit": "अहो बत महत्कष्टं यदमी घातिताः सुताः ।\nमया नृशंसया मोहाज्जले क्षिप्तास्तु बालकाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004293029, "chapter_id": 24293, "verse_number": "५-२-७१-३०", "content_sanskrit": "हा वत्सा हा सुताः पुत्रा हा तातास्तनयाः क्व वै ।\nमां विहाय गताः कुत्र हृदयं किं न दीर्यते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004293030, "chapter_id": 24293, "verse_number": "५-२-७१-३१", "content_sanskrit": "मातर्मातेति करुणं ब्रुवाणाः स्वयमागता ।\nउपगुह्ये कदा पुत्रान्वत्सवत्सेति सौहृदात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004293031, "chapter_id": 24293, "verse_number": "५-२-७१-३२", "content_sanskrit": "कस्य जातु प्रणीतेन पिंगेन क्षितिरेणुना ।\nममोत्तरीयमुत्संगं कदाङ्ग मलयिष्यति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004293032, "chapter_id": 24293, "verse_number": "५-२-७१-३३", "content_sanskrit": "अंगप्रत्यंगसंभूता मनोहृदयनंदनाः ।\nमया तु मात्रा हा वत्सा मारिता निधनं गताः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004293033, "chapter_id": 24293, "verse_number": "५-२-७१-३४", "content_sanskrit": "कांल्लोकान्नु गमिष्यामि कृत्वा कर्म सुदारुणम् ।\nकथं पुण्या भविष्यामि पुत्रप्नी निर्दया सती॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004293034, "chapter_id": 24293, "verse_number": "५-२-७१-३५", "content_sanskrit": "इत्येवं करुणं कृत्वा रुदित्वा च पुनःपुनः ।\nमूर्छिता पतिताप्यार्ता निश्चेष्टा धरणीतले॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004293035, "chapter_id": 24293, "verse_number": "५-२-७१-३६", "content_sanskrit": "एतस्मिन्नंतरे देवि नारदो मुनिसत्तमः ।\nतस्या विलापशब्दं तमाकर्ण्य सहसा तदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004293036, "chapter_id": 24293, "verse_number": "५-२-७१-३७", "content_sanskrit": "विस्मयोप्फुल्लनयनः किमेतदिति चिंतयत् ।\nएषा सा जाह्नवी गंगा पावनी देववंदिता॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004293037, "chapter_id": 24293, "verse_number": "५-२-७१-३८", "content_sanskrit": "समुद्रमहिषी दिव्या पुण्या त्रिपथगा नदी ।\nमानुषं भावमाश्रित्य कस्माद्रोदिति विह्वला॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004293038, "chapter_id": 24293, "verse_number": "५-२-७१-३९", "content_sanskrit": "इत्येवं चिंतयित्वा च समीपमगमन्मुनिः ।\nगंगाया विलपन्त्याश्च ब्रह्मपुत्रस्तु नारदः ।\nउवाचोच्चैर्वियत्स्थोऽसौ देवि गंगे नमोऽस्तुते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004293039, "chapter_id": 24293, "verse_number": "५-२-७१-४०", "content_sanskrit": "नारदोऽहं महापुण्ये कस्माद्रोदिषि पावनि ।\nहिमाद्रिपुत्री विख्याता देवगंधर्वसेविता॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004293040, "chapter_id": 24293, "verse_number": "५-२-७१-४१", "content_sanskrit": "धृता शिरसि देवेन शिवेन परमेष्ठिना॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004293041, "chapter_id": 24293, "verse_number": "५-२-७१-४२", "content_sanskrit": "नारदस्य वचः श्रुत्वा दिव्या देवनदी तथा ।\nअवलोक्य विमानस्थं प्रत्युवाच महामुनिम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004293042, "chapter_id": 24293, "verse_number": "५-२-७१-४३", "content_sanskrit": "मया नारद मोहेन कृतोऽधर्मो जुगुप्सितः ।\nजानंत्या सुमहत्पापं सप्तपुत्रा हता मया॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004293043, "chapter_id": 24293, "verse_number": "५-२-७१-४४", "content_sanskrit": "समुद्रेण वियोगस्तु संजातो मम दैवतः ।\nभार्या जाता मनुष्यस्य पुत्रा जाता हताश्च मे॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004293044, "chapter_id": 24293, "verse_number": "५-२-७१-४५", "content_sanskrit": "अतो मया विलपितं मग्नया शोकसागरे ।\nकथ्यतां मम देवर्षे येन पुण्या भवामि वै॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004293045, "chapter_id": 24293, "verse_number": "५-२-७१-४६", "content_sanskrit": "इति तस्या वचः श्रुत्वा नारदो मुनिसत्तमः ।\nत्रिकालवेदी शुद्धात्मा गंगां वचनमब्रवीत्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004293046, "chapter_id": 24293, "verse_number": "५-२-७१-४७", "content_sanskrit": "नारद उवाच ।\nकिं विस्मृतो जगद्वंद्ये देवानां समयः शुभः ।\nप्रतिज्ञातं त्वया देवि वसूनां मोक्षकारणे॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004293047, "chapter_id": 24293, "verse_number": "५-२-७१-४८", "content_sanskrit": "प्राप्तास्ते वसवो लोकान्प्रसादात्तव सुव्रते ।\nत्वयावतारितो देवि समुद्रः शंतनुः स्मृतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004293048, "chapter_id": 24293, "verse_number": "५-२-७१-४९", "content_sanskrit": "इति तस्य वचः श्रुत्वा नारदस्य महात्मनः ।\nगंगा त्रिपथगा पुण्या प्रत्युवाच महामुनिम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004293049, "chapter_id": 24293, "verse_number": "५-२-७१-५०", "content_sanskrit": "सत्यमुक्तं त्वया ब्रह्मञ्ज्ञातं सर्वं मयाऽधुना ।\nकिंतु योनिर्यतो लब्धा मानुषी तेन मोहिता॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004293050, "chapter_id": 24293, "verse_number": "५-२-७१-५१", "content_sanskrit": "अपवादभयाद्भीता भवंतं शरणं गता ।\nदीयतामुपदेशो मे कथ्यतां स्थानमुत्तमम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004293051, "chapter_id": 24293, "verse_number": "५-२-७१-५२", "content_sanskrit": "नारद उवाच ।\nकिं विस्मृतो जगद्वंद्ये देवानां समयः कृतः ।\nअपवादभयाद्भीता यदि त्वं देवि पुण्यदे ।\nमां पृच्छसि परं स्थानं शृणु त्वं वच्मि सुव्रते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004293052, "chapter_id": 24293, "verse_number": "५-२-७१-५३", "content_sanskrit": "अवंती तु समाख्याता सप्त कल्पसनातनी ।\nतस्यां सखी त्वदीया तु शिप्रा विप्रप्रिया सदा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004293053, "chapter_id": 24293, "verse_number": "५-२-७१-५४", "content_sanskrit": "तस्यास्तीरे शुभं लिंगं दुर्द्धर्षेश्वरदक्षिणे ।\nविद्यते त्रिदशैः पूज्यं सर्वती र्थैश्च सेवितम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004293054, "chapter_id": 24293, "verse_number": "५-२-७१-५५", "content_sanskrit": "तस्य दर्शनमात्रेण कृतकृत्या भविष्यसि ।\nतस्माद्गच्छ महापुण्ये गंगे देवर्षिसेविते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004293055, "chapter_id": 24293, "verse_number": "५-२-७१-५६", "content_sanskrit": "इत्युक्ता सा त्रिपथगा नारदेन महात्मना ।\nगता तत्र महापुण्या सखीं शिप्रां ददर्श ह॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004293056, "chapter_id": 24293, "verse_number": "५-२-७१-५७", "content_sanskrit": "संश्लेषं च तदा कृत्वा लिंगं दृष्ट्वा सुपावनम् ।\nपूजयामास भावेन तत्रैव च चिरं स्थिता॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004293057, "chapter_id": 24293, "verse_number": "५-२-७१-५८", "content_sanskrit": "अथ सूर्यसुता देवी यमुना पापनाशिनी ।\nतत्रायाता सुहार्द्देन यत्र गंगा व्यवस्थिता॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004293058, "chapter_id": 24293, "verse_number": "५-२-७१-५९", "content_sanskrit": "ददर्श देवी तां गंगां ध्यायंती शंकरं शिवम् ।\nसापि तत्रैव तिष्ठंती पूजयंती परं शिवम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004293059, "chapter_id": 24293, "verse_number": "५-२-७१-६०", "content_sanskrit": "अथ तेनैव कालेन प्राचीदेवी सरस्वती ।\nसमायाता सुगुप्ता च गंगायमुनयो र्जले॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004293060, "chapter_id": 24293, "verse_number": "५-२-७१-६१", "content_sanskrit": "एतस्मिन्नंतरे देवि शक्रं प्राह स नारदः ।\nन दृश्यते प्रयागस्तु महाकालवनं गतः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004293061, "chapter_id": 24293, "verse_number": "५-२-७१-६२", "content_sanskrit": "गंगायमुनयोर्मध्ये यत्र गुप्ता सरस्वती ।\nप्रयागः स तु विज्ञेयः सर्वपापप्रणाशनः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004293062, "chapter_id": 24293, "verse_number": "५-२-७१-६३", "content_sanskrit": "स सांप्रतं प्रयागस्तु महाकालवनोत्तमे ।\nकेनापि कारणेनैव गतो न ज्ञायते मया॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004293063, "chapter_id": 24293, "verse_number": "५-२-७१-६४", "content_sanskrit": "इति तस्य वचः श्रुत्वा नारदस्य महात्मनः ।\nशक्रेण सहिताः सर्वे ह्यवंतीं तु समागताः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004293064, "chapter_id": 24293, "verse_number": "५-२-७१-६५", "content_sanskrit": "स्तुवंतो विविधैः स्तोत्रैर्गंगां त्रिपथगां शुभाम् ।\nगंगे देवि नमस्तुभ्यं सर्वपापप्रणाशिनि॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004293065, "chapter_id": 24293, "verse_number": "५-२-७१-६६", "content_sanskrit": "वसूनां जननी देवि वसूनां मोक्षदायिनि ।\nत्रैलोक्यपावनी नित्यं हरेण शिरसा धृता॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004293066, "chapter_id": 24293, "verse_number": "५-२-७१-६७", "content_sanskrit": "सेविता वालखिल्यैश्च कृष्णस्य परमा कला ।\nयमुने त्वां नमस्यामः कालिंदीं वरवाहिनीम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004293067, "chapter_id": 24293, "verse_number": "५-२-७१-६८", "content_sanskrit": "सुता त्वं पाविनी देवि मार्त्तंडस्य दिवस्पतेः ।\nशिप्रे देवि नमस्तुभ्यं ब्रह्मदेहोद्भवे शुभे॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004293068, "chapter_id": 24293, "verse_number": "५-२-७१-६९", "content_sanskrit": "प्राची त्वमेव विख्याता पुण्यदेहा सरस्वती ।\nया प्राची कौरवक्षेत्रे पुष्करे या महालये ।\nसा त्वं शिप्रा प्रसिद्धा च सर्वपातकनाशिनी॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004293069, "chapter_id": 24293, "verse_number": "५-२-७१-७०", "content_sanskrit": "त्वं दया सर्वजंतूनां स्वर्गः शरणं नृणाम् ।\nत्वं माता सर्वजंतूनां त्वं प्राची भुवि गीयसे॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004293070, "chapter_id": 24293, "verse_number": "५-२-७१-७१", "content_sanskrit": "बहुजन्मकलंकांकं दृष्ट्वा या देहिनां भुवि ।\nकरोषि क्षालनं देवि सा त्वं त्रैलोक्यसंस्थिता॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004293071, "chapter_id": 24293, "verse_number": "५-२-७१-७२", "content_sanskrit": "आसां च संगमो यस्तु स प्रयागो बुधैः स्मृतः ।\nअत्रागत्य तु युष्माभिः स्थापितः स्नापितोऽधुना॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004293072, "chapter_id": 24293, "verse_number": "५-२-७१-७३", "content_sanskrit": "सोद्य प्रभृति देवोऽयं प्रयागेश्वरसंज्ञकः ।\nत्रिषु लोकेषु विख्यातः स्मरणात्पापनाशनः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004293073, "chapter_id": 24293, "verse_number": "५-२-७१-७४", "content_sanskrit": "अत्रागत्य प्रपश्यंति ये प्रयागेश्वरं ततः ।\nते कृतार्था भविष्यंति सर्वपातकवर्जिताः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004293074, "chapter_id": 24293, "verse_number": "५-२-७१-७५", "content_sanskrit": "कुलं च तारितं तेषां पैतृकं मातृकं तथा ।\nगंगायास्त्रियुगं पुण्यं चतुर्वर्गफलप्रदम् ।\nजायते नात्र संदेहः प्रयागेश्वरदर्शनात्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004293075, "chapter_id": 24293, "verse_number": "५-२-७१-७६", "content_sanskrit": "गंगायां च प्रयागे च देवदारुवने शुभे ।\nनैमिषे पुष्करे चैव श्रीशैले च त्रिपुष्करे॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004293076, "chapter_id": 24293, "verse_number": "५-२-७१-७७", "content_sanskrit": "त्र्यंबके धौतपापे च महेन्द्रे भैरवे तथा ।\nगोकर्णे च सुवर्णाख्ये रेवाकपिलसङ्गमे॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004293077, "chapter_id": 24293, "verse_number": "५-२-७१-७८", "content_sanskrit": "एतेषां दर्शनेनैव या सिद्धिर्द्वादशाब्दिका ।\nसा लभ्या मासमात्रेण प्रयागेश्वरदर्शनात्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004293078, "chapter_id": 24293, "verse_number": "५-२-७१-७९", "content_sanskrit": "ये पश्यंति चतुर्द्दश्यामष्टम्यां च विशेषतः ।\nभक्त्या च नियमं कृत्वा प्रयागेश्वरसंज्ञकम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004293079, "chapter_id": 24293, "verse_number": "५-२-७१-८०", "content_sanskrit": "न तेषां पुनरावृत्तिः कल्पकोटिशतैरपि ।\nभोगदं मोक्षदं लिंगं भविष्यति महीतले॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004293080, "chapter_id": 24293, "verse_number": "५-२-७१-८१", "content_sanskrit": "कलास्तिस्रो भविष्यंति लिंगेऽस्मिन्मोक्षदे शुभे ।\nगंगा च यमुना प्राची सर्वपातकनाशिनी॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004293081, "chapter_id": 24293, "verse_number": "५-२-७१-८२", "content_sanskrit": "एवमुक्त्वा स्तुता गंगा यमुना च सरस्वती ।\nदेवैः प्रणतिपूर्वेण गताः स्थानं स्वकं तदा॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004293082, "chapter_id": 24293, "verse_number": "५-२-७१-८३", "content_sanskrit": "देवाः प्रहृष्टाः शकाद्याः प्रयागेश्वरसंज्ञकम् ।\nस्तुत्वा च विविधैः स्तोत्रैः पूजयित्वा दिवं गताः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004293083, "chapter_id": 24293, "verse_number": "५-२-७१-८४", "content_sanskrit": "एष ते कथितो देवि प्रभावः पापनाशनः ।\nप्रयागेश्वर देवस्य चंद्रादित्येश्वरं शृणु॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]