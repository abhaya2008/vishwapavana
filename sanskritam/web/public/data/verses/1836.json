[{"id": 2038301, "chapter_id": 1836, "verse_number": "५-८१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038302, "chapter_id": 1836, "verse_number": "५-८१-१", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा धर्मार्थसहितं हितम्।\nकृष्णा दाशार्हमासीनमब्रवीच्छोककर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038303, "chapter_id": 1836, "verse_number": "५-८१-२", "content_sanskrit": "सुता द्रुपदराजस्य स्वसितायतमूर्धजा ।\nसंपूज्य सहदेवं च सात्यकिं च महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038304, "chapter_id": 1836, "verse_number": "५-८१-३", "content_sanskrit": "भीमसेनं च संशान्तं दृष्ट्वा परमदुर्मनाः ।\nअश्रुपूर्णेक्षणा वाक्यमुवाचेदं मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038305, "chapter_id": 1836, "verse_number": "५-८१-४", "content_sanskrit": "विदितं ते महाबाहो धर्मज्ञ मधुसूदन ।\nयथा निकृतिमास्थाय भ्रंशिताः पाण्डवाः सुखात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038306, "chapter_id": 1836, "verse_number": "५-८१-५", "content_sanskrit": "धृतराष्ट्रस्य पुत्रेण सामात्येन जनार्दन।\nयथा च सञ्जयो राज्ञा मन्त्रं रहसि श्रावितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038307, "chapter_id": 1836, "verse_number": "५-८१-६", "content_sanskrit": "युधिष्ठिरस्य दाशार्ह तच्चापि विदितं तव।\nयथोक्तः सञ्जयश्चैव तच्च सर्वं श्रुतं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038308, "chapter_id": 1836, "verse_number": "५-८१-७", "content_sanskrit": "पञ्च नस्तात दीयन्तां ग्रामा इति महाद्युते।\nअविस्थलं वृकस्थलं माकन्दीं वारणावतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038309, "chapter_id": 1836, "verse_number": "५-८१-८", "content_sanskrit": "अवसानं महाबाहो कंचिदेकं च पञ्चमम्।\nइति दुर्योधनो वाच्यः सुहृदश्चास्य केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038310, "chapter_id": 1836, "verse_number": "५-८१-९", "content_sanskrit": "न चापि ह्यकरोद्वाक्यं श्रुत्वा कृष्ण सुयोधनः ।\nयुधिष्ठिरस्य दाशार्ह श्रीमतः सन्धिमिच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038311, "chapter_id": 1836, "verse_number": "५-८१-१०", "content_sanskrit": "अप्रदानेन राज्यस्य यदि कृष्ण सुयोधनः।\nसन्धिमिच्छेन्न कर्तव्यं तत्र गत्वा कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038312, "chapter_id": 1836, "verse_number": "५-८१-११", "content_sanskrit": "शक्ष्यन्ति हि महाबाहो पाण्डवाः सृञ्जयैः सह।\nधार्तराष्ट्रबलं घोरं क्रुद्धं प्रतिसमासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038313, "chapter_id": 1836, "verse_number": "५-८१-१२", "content_sanskrit": "न हि साम्ना न दानेन शक्योऽर्थस्तेषु कश्चन ।\nतस्मात्तेषु न कर्तव्या कृपा ते मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038314, "chapter_id": 1836, "verse_number": "५-८१-१३", "content_sanskrit": "साम्ना दानेन वा कृष्ण ये न शाम्यन्ति शत्रवः।\nयोक्तव्यस्तेषु दण्डः स्याज्जीवितं परिरक्षता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038315, "chapter_id": 1836, "verse_number": "५-८१-१४", "content_sanskrit": "तस्मात्तेषु महादण्डः क्षेप्तव्यः क्षिप्रमच्युत।\nत्वया चैव महाबाहो पाण्डवैः सह सृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038316, "chapter_id": 1836, "verse_number": "५-८१-१५", "content_sanskrit": "एतत्समर्थं पार्थानां तव चैव यशस्करम्।\nक्रियमाणं भवेत्कृष्ण क्षत्रस्य च सुखावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038317, "chapter_id": 1836, "verse_number": "५-८१-१६", "content_sanskrit": "क्षत्रियेण हि हन्तव्यः क्षत्रियो लोभमास्थितः।\nअक्षत्रियो वा दाशार्ह स्वधर्ममनुतिष्ठता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038318, "chapter_id": 1836, "verse_number": "५-८१-१७", "content_sanskrit": "अन्यत्र ब्राह्मणात्तात सर्वपापेष्ववस्थितात्।\nगुरुर्हि सर्ववर्णानां ब्राह्मणः प्रसृताग्रभुक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038319, "chapter_id": 1836, "verse_number": "५-८१-१८", "content_sanskrit": "यथाऽवध्ये वध्यमाने भवेद्दोषो जनार्दन ।\nस वध्यस्यावधे दृष्ट इति धर्मविदो विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038320, "chapter_id": 1836, "verse_number": "५-८१-१९", "content_sanskrit": "यथा त्वां न स्पृशेदेष दोषः कृष्ण तथा कुरु।\nपाण्डवैः सह दाशर्हैः सृञ्जयैश्च ससैनिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038321, "chapter_id": 1836, "verse_number": "५-८१-२०", "content_sanskrit": "पुनरुक्तं च वक्ष्यामि विश्रम्भेण जनार्दन।\nका तु सीमन्तिनी मादृकं पृथिव्यामस्ति केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038322, "chapter_id": 1836, "verse_number": "५-८१-२१", "content_sanskrit": "सुता द्रुपदराजस्य वेदिमध्यात्समुत्थिता।\nधृष्टद्युम्नस्य भगिनी तव कृष्ण प्रिया सखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038323, "chapter_id": 1836, "verse_number": "५-८१-२२", "content_sanskrit": "आजमूढकुलं प्राप्त स्नुषा पाण्डोर्महात्मनः ।\nमहिषी पाण्डुपुत्राणां पञ्चेन्द्रसमवर्चसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038324, "chapter_id": 1836, "verse_number": "५-८१-२३", "content_sanskrit": "सुता मे पञ्चभिर्वीरैः पञ्च जाता महारथाः ।\nअभिमन्युर्यथा कृष्ण तथा ते तव धर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038325, "chapter_id": 1836, "verse_number": "५-८१-२४", "content_sanskrit": "साऽहं केशग्रहं प्राप्ता परिक्लिष्टा सभां गता।\nपश्यतां पाण्डुपुत्राणां त्वयि जीवति केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038326, "chapter_id": 1836, "verse_number": "५-८१-२५", "content_sanskrit": "जीवस्तु पाण्डुपुत्रेषु पञ्चालेष्वथ वृष्णिषु।\nदासीभाताऽस्मि पापानां सभामध्ये व्यवस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038327, "chapter_id": 1836, "verse_number": "५-८१-२६", "content_sanskrit": "निरमर्षेष्वचेष्टेषु प्रेक्ष्यमाणेषु पाण्डुषु ।\nपाहि मामिति गोविन्द मनसा चिन्तितोसि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038328, "chapter_id": 1836, "verse_number": "५-८१-२७", "content_sanskrit": "यत्र मां भगवान्राजा श्वशुरो वाक्यमब्रवीत्।\nवरं वृणीष्व पाञ्चालि वरार्हाऽसि मता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038329, "chapter_id": 1836, "verse_number": "५-८१-२८", "content_sanskrit": "अदासाः पाण्डवाः सन्तु सरथाः सायुधा इति।\nमयोक्ते यत्र निर्मुक्ता वनवासाय केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038330, "chapter_id": 1836, "verse_number": "५-८१-२९", "content_sanskrit": "एवंविधानां दुःखानामभिज्ञोऽसि जनार्दन ।\nत्रायस्व पुण्डरीकाक्ष सभर्तृज्ञातिबान्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038331, "chapter_id": 1836, "verse_number": "५-८१-३०", "content_sanskrit": "नन्वहं कृष्ण भीष्मस्य धृतराष्ट्रस्य चोभयोः ।\nश्नुषा भवामि धर्मेण साऽहं दासीकृता बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038332, "chapter_id": 1836, "verse_number": "५-८१-३१", "content_sanskrit": "धिक्पार्थस्य धनुष्मत्तां भीमसेनस्य धिग्बलम्।\nयत्र दुर्योधनः कृष्ण मुहूर्तमपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038333, "chapter_id": 1836, "verse_number": "५-८१-३२", "content_sanskrit": "यदि तेऽहमनुग्राह्या यदि तेऽस्ति कृपा मयि।\nधार्तराष्ट्रेषु वै कोपः सर्वः कृष्ण विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038334, "chapter_id": 1836, "verse_number": "५-८१-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038335, "chapter_id": 1836, "verse_number": "५-८१-३३", "content_sanskrit": "इत्युक्त्वा मृदुसंहारं वृजिनाग्रं सुदर्शनम्।\nसुनीलमसितापाङ्गी सर्वगन्धादिवासितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038336, "chapter_id": 1836, "verse_number": "५-८१-३४", "content_sanskrit": "सर्वलक्षणसंपन्नं महाभुजगवर्चसम् ।\nकेशपक्षं वरारोहा गृह्व वामेन पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038337, "chapter_id": 1836, "verse_number": "५-८१-३५", "content_sanskrit": "पद्माक्षी पुण्डरीकाक्षमुपेत्य गजगामिनी ।\nअश्रुपूर्णेक्षणा कृष्णा कृष्णं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038338, "chapter_id": 1836, "verse_number": "५-८१-३६", "content_sanskrit": "अयं ते पुण्डरीकाक्ष दुःशासनकरोद्धृतः।\nस्मर्तव्यः सर्वकार्येषु परेषां सन्धिमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038339, "chapter_id": 1836, "verse_number": "५-८१-३७", "content_sanskrit": "यदि भीमार्जुनौ कृष्ण कृपणौ सन्धिकामुकौ ।\nपिता मे योत्स्यते वृद्धः सह पुत्रैर्महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038340, "chapter_id": 1836, "verse_number": "५-८१-३८", "content_sanskrit": "पञ्च चैव महावीर्याः पुत्रा मे मधुसूदन ।\nअभिमन्युं पुरस्कृत्य योत्स्यन्ते कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038341, "chapter_id": 1836, "verse_number": "५-८१-३९", "content_sanskrit": "दुःशासनभुजं श्यामं संछिन्नं पांसुकुण्ठितम्।\nयद्यहं तु न पश्यामि का शान्तिर्हृदयस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038342, "chapter_id": 1836, "verse_number": "५-८१-४०", "content_sanskrit": "त्रयोदश हि वर्षाणि प्रतीक्षन्त्या गतानि मे।\nविधाय हृदये मन्युं प्रदीप्तमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038343, "chapter_id": 1836, "verse_number": "५-८१-४१", "content_sanskrit": "विदीर्यते मे हृदयं भीमवाक्शल्यपीडितम् ।\nयोऽयमद्य महाबाहुर्धर्ममेवानुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038344, "chapter_id": 1836, "verse_number": "५-८१-४२", "content_sanskrit": "इत्युक्त्वा बाष्परुद्धेन कण्ठेनायतलोचना ।\nरुरोद कृष्णा सोत्कम्पं सस्वरं बाष्पगद्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2038345, "chapter_id": 1836, "verse_number": "५-८१-४३", "content_sanskrit": "स्तनौ पीनायतश्रोणी सहितावभिवर्षती।\nद्रवीभूतमिवात्युष्णं मुञ्चन्ती वारि नेत्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2038346, "chapter_id": 1836, "verse_number": "५-८१-४४", "content_sanskrit": "तामुवाच महाबाहुः केशवः परिसान्त्वयन्।\nअचिराद्द्रक्ष्यसे कृष्णे रुदतीर्भरतस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2038347, "chapter_id": 1836, "verse_number": "५-८१-४५", "content_sanskrit": "एवं ता भीरु रोस्त्यन्ति निहतज्ञातिबान्धवाः।\nहतमित्रा हतबला येषां क्रुद्धाऽसि भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2038348, "chapter_id": 1836, "verse_number": "५-८१-४६", "content_sanskrit": "अहं च तत्करिष्यामि भीमार्जुनयमैः सह ।\nयुधिष्ठिरनियोगेन दैवाच्च विधिनिर्मितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2038349, "chapter_id": 1836, "verse_number": "५-८१-४७", "content_sanskrit": "धार्तराष्ट्राः कालपक्वा न चेच्छृण्वन्ति मे वचः।\nशेष्यन्ते निहता भूमौ श्वसृगालादनीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2038350, "chapter_id": 1836, "verse_number": "५-८१-४८", "content_sanskrit": "चलेद्धि हिमवाञ्शैलो मेदिनी शतधा भवेत्।\nद्यौः पतेच्च सनक्षत्रा न मे मोघं वचो भवेत् ॥ ५-८१-४९a` शुष्येत्तोयनिधिः कृष्णे न मे मोघं वचो भवेत्।\nसत्यं ते प्रतिजानामि कृष्णे बाष्पो निगृह्यताम् ।\nहतामित्राञ्श्रिया युक्तानचिदाद्द्रक्ष्यसे पतीन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2038351, "chapter_id": 1836, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकाशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]