[{"id": 2097879, "chapter_id": 3095, "verse_number": "१३-२२५-१", "content_sanskrit": "उमोवाच।\nभगवन्भगनेत्रघ्न मानुषाणां विचेष्टितम्।\nसर्वमात्मकृतं चेति श्रुतं मे भगवन्मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097880, "chapter_id": 3095, "verse_number": "१३-२२५-२", "content_sanskrit": "लोके ग्रहकृतं सर्वं मत्वा कर्म शुभाशुभम्।\nतदेव ग्रहनक्षत्रं प्रायशः पर्युपासते।\nएष मे संशयो देव तं मे त्वं छेत्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097881, "chapter_id": 3095, "verse_number": "१३-२२५-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097882, "chapter_id": 3095, "verse_number": "१३-२२५-३", "content_sanskrit": "स्थाने संशयितं देवि शृणु तत्वविनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097883, "chapter_id": 3095, "verse_number": "१३-२२५-४", "content_sanskrit": "नक्षत्राणि ग्रहाश्चैव शुभाशुभनिवेदकाः।\nमानवानां महाभागे न तु कर्मकराः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097884, "chapter_id": 3095, "verse_number": "१३-२२५-५", "content_sanskrit": "प्रजानां तु हितार्थाय शुभाशुभविधिं प्रति।\nअनागतमतिक्रान्तं ज्योतिश्चक्रेण बोध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097885, "chapter_id": 3095, "verse_number": "१३-२२५-६", "content_sanskrit": "किन्तु तत्र शुभं कर्म सुग्रहैस्तु निवेद्यते।\nदुष्कृतस्याशुभैरेव समावायो भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097886, "chapter_id": 3095, "verse_number": "१३-२२५-७", "content_sanskrit": "तस्मात्तु ग्रहवैषम्ये विषमं कुरुते जनः।\nग्रहसाम्ये शुभं कुर्याज्ज्ञात्वाऽऽत्मानं तथा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097887, "chapter_id": 3095, "verse_number": "१३-२२५-८", "content_sanskrit": "केवलं ग्रहनक्षत्रं न करोति शुभाशुभम्।\nसर्वमात्मकृतं कर्म लोकवादो ग्रहा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097888, "chapter_id": 3095, "verse_number": "१३-२२५-९", "content_sanskrit": "पृथग्ग्रहाः पृथक्कर्ता कर्ता स्वं भुञ्जते फलम्।\nइति ते कथितं सर्वं विशङ्कां जहि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097889, "chapter_id": 3095, "verse_number": "१३-२२५-१०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097890, "chapter_id": 3095, "verse_number": "१३-२२५-१०", "content_sanskrit": "भगवन्विविधं कर्म कृत्वा जन्तुः शुभाशुभम्।\nकिं तयोः पूर्वकतरं भुङ्क्ते जन्मान्तरे पुनः।\nएष मे संशयो देव तं मे त्वं छेत्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097891, "chapter_id": 3095, "verse_number": "१३-२२५-११x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097892, "chapter_id": 3095, "verse_number": "१३-२२५-११", "content_sanskrit": "स्थाने संशयितं देवि तत्ते वक्ष्यामि तत्वतः॥\nअशुभं पूर्वमित्याहुरपरे शुभमित्यपि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097893, "chapter_id": 3095, "verse_number": "१३-२२५-१२", "content_sanskrit": "मिथ्या तदुभयं प्रोक्तं केवलं तद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097894, "chapter_id": 3095, "verse_number": "१३-२२५-१३", "content_sanskrit": "मानुषे तु पदे कर्म युगपद्भुज्यते सदा।\nयथाकृतं यथायोगमुभयं भुज्यते क्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097895, "chapter_id": 3095, "verse_number": "१३-२२५-१४", "content_sanskrit": "भुञ्जानाश्चापि दृश्यन्ते क्रमशो भुवि मानवाः।\nऋद्धिं हानिं सुखं दुःखं तत्सर्वमुभयं भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097896, "chapter_id": 3095, "verse_number": "१३-२२५-१५", "content_sanskrit": "दुःखान्यनुभवन्त्याढ्या दरिद्राश्च सुखानि च।\nयौगपद्याद्धि भुञ्जाना दृश्यन्ते लोकसाक्षिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097897, "chapter_id": 3095, "verse_number": "१३-२२५-१६", "content_sanskrit": "नरके स्वर्गलोके च न तथा संस्थितिः प्रिये।\nनित्यं दुःखं हि नरके स्वर्गे नित्यं सुखं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097898, "chapter_id": 3095, "verse_number": "१३-२२५-१७", "content_sanskrit": "शुभाशुभानामाधिक्यं कर्मणां तत्र सेव्यते।\nनिरन्तरं सुखं दुःखं स्वर्गे च नरके भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097899, "chapter_id": 3095, "verse_number": "१३-२२५-१८", "content_sanskrit": "तत्रापि सुमहद्भुक्त्वा पूर्वमल्पं पुनः शुभे।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097900, "chapter_id": 3095, "verse_number": "१३-२२५-१९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097901, "chapter_id": 3095, "verse_number": "१३-२२५-१९", "content_sanskrit": "भगवन्प्राणिनो लोके म्रियन्ते केन हेतुना।\nजाताजाता न तिष्ठन्ति तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097902, "chapter_id": 3095, "verse_number": "१३-२२५-२०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097903, "chapter_id": 3095, "verse_number": "१३-२२५-२०", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु सत्यं समाहिता।\nआत्मा कर्मक्षयाद्देहं यथा मुञ्चति तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097904, "chapter_id": 3095, "verse_number": "१३-२२५-२१", "content_sanskrit": "शरीरात्मसमाहारो जन्तुरित्यभिधीयते।\nतत्रात्मानं नित्यमाहुरनित्यं क्षेत्रिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097905, "chapter_id": 3095, "verse_number": "१३-२२५-२२", "content_sanskrit": "एवं कालेन सङ्क्रान्तं शरीरं जर्झरीकृतम्।\nअकर्मयोग्यं संशीर्णं त्यक्त्वा देही ततो व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097906, "chapter_id": 3095, "verse_number": "१३-२२५-२३", "content_sanskrit": "नित्यस्यानित्यसंत्यागाल्लोके तन्मरणं विदुः।\nकालं नातिक्रमेरन्हि सदेवासुरमानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097907, "chapter_id": 3095, "verse_number": "१३-२२५-२४", "content_sanskrit": "यथाऽऽकाशे न तिष्ठेत द्रव्यं किञ्चिदचेतनम्।\nतथा धावति कालोऽयं क्षणं किञ्चिन्न तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097908, "chapter_id": 3095, "verse_number": "१३-२२५-२५", "content_sanskrit": "स पुनर्जायतेऽन्यत्र शरीरं नवमाविशन्।\nएवंलोकगतिर्नित्यमादिप्रभृति वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097909, "chapter_id": 3095, "verse_number": "१३-२२५-२६x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097910, "chapter_id": 3095, "verse_number": "१३-२२५-२६", "content_sanskrit": "भगवन्प्राणिनो बाला दृश्यन्ते मरणं गताः।\nअतिवृद्धाश्च जीवन्तो दृश्यन्ते चिरजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097911, "chapter_id": 3095, "verse_number": "१३-२२५-२७", "content_sanskrit": "केवलं कालमरणं न प्रमाणं महेश्वर।\nतस्मान्मे संशय ब्रूहि प्राणिनां जीवकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097912, "chapter_id": 3095, "verse_number": "१३-२२५-२८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097913, "chapter_id": 3095, "verse_number": "१३-२२५-२८", "content_sanskrit": "शृणु तत्कारणं देवि निर्णयस्त्वेक एव सः।\nजीर्णत्वमात्रं कुरुते कालो देहं न पातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097914, "chapter_id": 3095, "verse_number": "१३-२२५-२९", "content_sanskrit": "जीर्णे कर्मणि संघातः स्वयमेव विशीर्यते।\nपूर्वकर्मप्रमाणेन जीवितं मृत्युरेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097915, "chapter_id": 3095, "verse_number": "१३-२२५-३०", "content_sanskrit": "यावत्पूर्वकृतं कर्म तावज्जीवति मानवः।\nतत्र कर्मवशाद्बाला म्रियन्ते कालसंक्षयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097916, "chapter_id": 3095, "verse_number": "१३-२२५-३१", "content_sanskrit": "चिरं जीवन्ति वृद्धाश्च तथा कर्मप्रमाणतः।\nइति ते कथितं देवि निर्विशङ्का भव प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097917, "chapter_id": 3095, "verse_number": "१३-२२५-३२x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097918, "chapter_id": 3095, "verse_number": "१३-२२५-३२", "content_sanskrit": "भगवन्केन वृत्तेन भवन्ति चिरजीविनः।\nअल्पायुषो नराः केन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097919, "chapter_id": 3095, "verse_number": "१३-२२५-३३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097920, "chapter_id": 3095, "verse_number": "१३-२२५-३३", "content_sanskrit": "शृणु तत्सर्वमखिलं गुह्यं पथ्यतरं नृणाम्।\nयेन वृत्तेन सम्पन्ना भवन्ति चिरजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097921, "chapter_id": 3095, "verse_number": "१३-२२५-३४", "content_sanskrit": "अहिंसा सत्यवचनमक्रोधः क्षीन्तिरार्जवम्।\nगुरूणां नित्यशुश्रूषा वृद्धानामपि पूजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097922, "chapter_id": 3095, "verse_number": "१३-२२५-३५", "content_sanskrit": "शौचादकार्यसंत्यागात्सदा पथ्यस्य भोजनम्।\nएवमादिगुणं वृत्तं नराणां दीर्घजीविनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097923, "chapter_id": 3095, "verse_number": "१३-२२५-३६", "content_sanskrit": "तपसा ब्रह्मचर्येण रसायननिषेवणात्।\nउदग्रसत्त्वा बलिनो भवन्ति चिरजीविनः।\nस्वर्गे वा मानुषे वाऽपि चिरं तिष्ठन्ति धार्मिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097924, "chapter_id": 3095, "verse_number": "१३-२२५-३७", "content_sanskrit": "अपरे पापकर्माणः प्रायशोऽनृतवादिनः।\nहिंसाप्रिया गुरुद्विष्टा निष्क्रियाः शौचवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097925, "chapter_id": 3095, "verse_number": "१३-२२५-३८", "content_sanskrit": "नास्तिका घोरकर्माणः सततं मांसपानपाः।\nपापाचारा गुरुद्विष्टाः कोपनाः कलहप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097926, "chapter_id": 3095, "verse_number": "१३-२२५-३९", "content_sanskrit": "एवमेवाशुभाचारास्तिष्ठन्ति नरके चिरम्।\nतिर्यग्योनौ तथाऽत्यन्तमल्पास्तिष्ठन्ति मानवाः।\nतस्मादल्पायुषो मर्त्यास्तादृशाः सम्भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097927, "chapter_id": 3095, "verse_number": "१३-२२५-४०", "content_sanskrit": "अगम्यदेशगमनादपथ्यानां च भोजनात्।\nआयुःक्षयो भवेन्नॄणामायुःक्षयकरा हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097928, "chapter_id": 3095, "verse_number": "१३-२२५-४१", "content_sanskrit": "भवन्त्यल्पायुषस्तैस्तैरन्यथा चिरजीविनः।\nएतत्ते कथितं सर्वं भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097929, "chapter_id": 3095, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चविँशत्यधिकद्विशततमोऽध्यायः॥ २२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]