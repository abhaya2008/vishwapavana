[{"id": 7006327000, "chapter_id": 26327, "verse_number": "१-३७-१", "content_sanskrit": "वैशम्पायन उवाच सत्त्वतात्सत्त्वसम्पन्नान् कौशल्या सुषुवे सुतान्।\nभजिनं भजमानं च दिव्यं देवावृधं नृपम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006327001, "chapter_id": 26327, "verse_number": "१-३७-२", "content_sanskrit": "अन्धकं च महावाहु वृष्णिं च यदुनन्दनम् ।\nषां विसर्गाश्चत्वारो विस्तरेणेह ताञ्छृणु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006327002, "chapter_id": 26327, "verse_number": "१-३७-३", "content_sanskrit": "भजमानस्य सृंजय्यौ बाह्यकाथोपबाह्यका ।\nस्तां भार्ये तयोस्तस्माज्जज्ञिरे बहवः सुताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006327003, "chapter_id": 26327, "verse_number": "१-३७-४", "content_sanskrit": "कृमिश्च क्रमणश्चैव धृष्टः शूरः पुरंजयः ।\nते बाह्यकसृञ्जय्यां भजमानाद् विजज्ञिरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006327004, "chapter_id": 26327, "verse_number": "१-३७-५", "content_sanskrit": "अयुताजित्सहस्राजिच्छताजिच्चाथ दाशकः ।\nपबाह्यकसृञ्जय्यां भजमानाद् विजज्ञिरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006327005, "chapter_id": 26327, "verse_number": "१-३७-६", "content_sanskrit": "यज्वा देवावृधो राजा चचार विपुलं तपः ।\nत्रः सर्वगुणोपेतो मम स्यादिति निश्चितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006327006, "chapter_id": 26327, "verse_number": "१-३७-७", "content_sanskrit": "संयुज्यात्मानमेवं तु पर्णाशाया जलं स्पृशन् ।\nदोपस्पृशतस्तस्य चकार प्रियमापगा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006327007, "chapter_id": 26327, "verse_number": "१-३७-८", "content_sanskrit": "चिन्तयाभिपरीता सा जगामैकाभिनिश्चयम् ।\nल्याणत्वान्नरपतेस्तस्य सा निम्नगोत्तमा  ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006327008, "chapter_id": 26327, "verse_number": "१-३७-९", "content_sanskrit": "नाध्यगच्छत तां नारीं यस्यामेवंविधः सुतः ।\nयेत्तस्मात्स्वयं हन्त भवाम्यस्य सहव्रता॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006327009, "chapter_id": 26327, "verse_number": "१-३७-१०", "content_sanskrit": "अथ भूत्वा कुमारी सा बिभ्रती परमं वपुः ।\nरयामास नृपतिं तामियेष च स प्रभुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006327010, "chapter_id": 26327, "verse_number": "१-३७-११", "content_sanskrit": "तस्यामाधत्त गर्भं च तेजस्विनमुदारधीः ।\nथ सा दशमे मासि सुषुवे सरितां वरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006327011, "chapter_id": 26327, "verse_number": "१-३७-१२", "content_sanskrit": "पुत्रं सर्वगुणोपेतं बभ्रुं देवावृधान्नृपात् ।\nअत्र वंशे पुराणज्ञा गायन्तीति परिश्रुतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006327012, "chapter_id": 26327, "verse_number": "१-३७-१३", "content_sanskrit": "गुणान् देवावृधस्याथ  कीर्तयन्तो महात्मनः ।\nथैवाग्रे समं दूरात् पश्याम  च तथान्तिके ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006327013, "chapter_id": 26327, "verse_number": "१-३७-१४", "content_sanskrit": "बभ्रुः श्रेष्ठो मनुष्याणां देवैर्देवावृधः समः ।\nष्टिश्च षट् च पुरुषाः सहस्राणि च सप्त च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006327014, "chapter_id": 26327, "verse_number": "१-३७-१५", "content_sanskrit": "एतेऽमृतत्वं सम्प्राप्ता बभ्रुर्देवावृधावपि ।\nज्वा दानपतिर्विद्वान् ब्रह्मण्यः सुदृढायुधः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006327015, "chapter_id": 26327, "verse_number": "१-३७-१६", "content_sanskrit": "कीर्तिमांश्च महातेजाः सात्त्वतानां महावरः ।\nस्यान्ववायः सुमहान्भोजा ये मार्तिकावताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006327016, "chapter_id": 26327, "verse_number": "१-३७-१७", "content_sanskrit": "अन्धकात्काश्यदुहिता चतुरोऽलभतात्मजान् ।\nकुकुरं भजमानं च शमिं कम्बलबर्हिषम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006327017, "chapter_id": 26327, "verse_number": "१-३७-१८", "content_sanskrit": "कुकुरस्य सुतो धृष्णुर्धृष्णोस्तु तनयस्तथा ।\nपोतरोमा तस्याथ तैत्तिरिस्तनयोऽभवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006327018, "chapter_id": 26327, "verse_number": "१-३७-१९", "content_sanskrit": "जज्ञे पुनर्वसुस्तस्मादभिजित् तु पुनर्वसोः ।\nतस्य वै पुत्रमिथुनं बभूवाभिजितः किल ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006327019, "chapter_id": 26327, "verse_number": "१-३७-२०", "content_sanskrit": "आहुकश्चाहुकी चैव ख्यातौ ख्यातिमतां वरौ ।\nमां चोदाहरन्त्यत्र गाथां प्रति तमाहुकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006327020, "chapter_id": 26327, "verse_number": "१-३७-२१", "content_sanskrit": "श्वेतेन परिवारेण किशोरप्रतिमो महान् ।\nशीतिचर्मणा युक्तः स नृपः प्रथमं व्रजेत् ॥२१ ॥।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006327021, "chapter_id": 26327, "verse_number": "१-३७-२२", "content_sanskrit": "नापुत्रवान् नाशतदो नासहस्रशतायुषः ।\nशुद्धकर्मा नायज्वा यो भोजमभितो व्रजेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006327022, "chapter_id": 26327, "verse_number": "१-३७-२३", "content_sanskrit": "पूर्वस्यां दिशि नागानां भोजस्येत्यनुमोदनम् ।\nपासङ्गानुकर्षाणां ध्वजिनां सवरूथिनाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006327023, "chapter_id": 26327, "verse_number": "१-३७-२४", "content_sanskrit": "रथानां मेघघोषाणां सहस्राणि दशैव तु ।\nप्यकाञ्चनकक्षाणां सहस्राणि दशापि च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006327024, "chapter_id": 26327, "verse_number": "१-३७-२५", "content_sanskrit": "तावन्त्येव सहस्राणि उत्तरस्यां तथा दिशि ।\nभूमिपालान्भोजाः स्वानुपतिष्ठन्किङ्किणीकिणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006327025, "chapter_id": 26327, "verse_number": "१-३७-२६", "content_sanskrit": "आहुकी चाप्यवन्तिभ्यः स्वसारं ददुरन्धकाः ।\nहुकस्य तु काश्यायां द्वौ पुत्रौ सम्बभूवतुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006327026, "chapter_id": 26327, "verse_number": "१-३७-२७", "content_sanskrit": "देवकश्चोग्रसेनश्च देवपुत्रसमावुभौ ।\nवकस्याभवन्पुत्राश्चत्वारस्त्रिदशोपमाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006327027, "chapter_id": 26327, "verse_number": "१-३७-२८", "content_sanskrit": "देववानुपदेवश्च सुदेवो देवरक्षितः ।\nमार्यः सप्त चाप्यासन् वसुदेवाय ता ददौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006327028, "chapter_id": 26327, "verse_number": "१-३७-२९", "content_sanskrit": "देवकी शान्तिदेवा च सुदेवा देवरक्षिता ।\nकदेव्युपदेवी च सुनासी चैव सप्तमी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006327029, "chapter_id": 26327, "verse_number": "१-३७-३०", "content_sanskrit": "नवोग्रसेनस्य सुतास्तेषां कंसस्तु पूर्वजः ।\nयग्रोधश्च सुनामा  च कङ्कः शङ्कुः सुभूमिपः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006327030, "chapter_id": 26327, "verse_number": "१-३७-३१", "content_sanskrit": "राष्ट्रपालोऽथ सुतनुरनाधृष्टिश्च पुष्टिमान् ।\nषां स्वसारः पञ्चाऽऽसन्कंसा कंसवती तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006327031, "chapter_id": 26327, "verse_number": "१-३७-३२", "content_sanskrit": "सुतनू राष्ट्रपाली च कङ्का चैव वराङ्गना ।\nग्रसेनः सहापत्यो व्याख्यातः कुकुरोद्भवः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006327032, "chapter_id": 26327, "verse_number": "१-३७-३३", "content_sanskrit": "कुकुराणामिमं वंशं धारयन्नमितौजसाम् ।\nत्मनो विपुलं वंशं प्रजावानाप्नुयान्नरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]