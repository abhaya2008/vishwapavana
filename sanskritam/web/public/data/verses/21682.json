[{"id": 7001682000, "chapter_id": 21682, "verse_number": "१-६८-१", "content_sanskrit": "श्रीसनत्कुमार उवाच ।\nअथ वक्ष्ये गणेशस्य मंत्रान्सर्वेष्टदायकान् ।\nयान्समाराध्य विप्रेंद्र साधको भुक्तिमुक्तिमान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001682001, "chapter_id": 21682, "verse_number": "१-६८-२", "content_sanskrit": "अव्ययो विष्णुवनिता शंभुस्त्री मीनकेतनः ।\nस्मृतिर्मांसेंदुमन्वाढ्या सा पुनश्चंद्रशेखरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001682002, "chapter_id": 21682, "verse_number": "१-६८-३", "content_sanskrit": "ङेतो गणपतिस्तोयं भुजंगो वरदेति च ।\nसर्वांते जनमुञ्चार्य ततो मे वशमानय ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001682003, "chapter_id": 21682, "verse_number": "१-६८-४", "content_sanskrit": "वह्निः प्रियांतो मंत्रोऽयष्टाविंशतिवर्णवान् ।\nगणकोऽस्य मुनिश्छंदो गायत्री वियुदादिका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001682004, "chapter_id": 21682, "verse_number": "१-६८-५", "content_sanskrit": "गणेशो देवता बीजं षष्टशक्तिस्तदादिका ।\nश्रीमन्महागणपतिप्रीतये विनियोगकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001682005, "chapter_id": 21682, "verse_number": "१-६८-६", "content_sanskrit": "ऋषिं शिरसि वक्रे तु छन्दश्च हृदि देवताम् ।\nगुह्ये बीजं पदोः शक्तिं न्यसेत्साधकसत्तमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001682006, "chapter_id": 21682, "verse_number": "१-६८-७", "content_sanskrit": "षड्दीर्घाढ्येन बीजेन यं च बीजादिना पुनः ।\nषङंगानि न्यसेदस्य जातियुक्तानि मंत्रवित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001682007, "chapter_id": 21682, "verse_number": "१-६८-८", "content_sanskrit": "शैवी षडंगमुद्राय न्यस्तव्या हि षडंगके ।\nगामाद्यं चैव भूर्लोकं नाभ्यंतं पादयोर्न्यसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001682008, "chapter_id": 21682, "verse_number": "१-६८-९", "content_sanskrit": "गीमाद्यं च भुवर्लोकं कंठांतं नाभितो न्यसेत् ।\nस्वर्लोकं चैव गूमाद्यं कंठदिमस्तकावधि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001682009, "chapter_id": 21682, "verse_number": "१-६८-१०", "content_sanskrit": "व्यापकं मूलमन्त्रेण न्यासोऽयं भुवनाभिधः ।\nमूलमंत्रं समुञ्चार्य मातृकावर्णमीरयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001682010, "chapter_id": 21682, "verse_number": "१-६८-११", "content_sanskrit": "तदंतेऽपि च मूलं स्यान्नमोंऽतं मातृकास्थले ।\nक्षांतं विन्यस्य मूलेन व्यापकं रचयेत्सुधीः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001682011, "chapter_id": 21682, "verse_number": "१-६८-१२", "content_sanskrit": "वर्णन्या सोऽयमाख्यातः पदन्यासस्तथोच्यते ।\nपञ्चत्रिबाणवह्नींदुचंद्राक्षिनिगमैः क्रमात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001682012, "chapter_id": 21682, "verse_number": "१-६८-१३", "content_sanskrit": "विभक्तैर्मूलगायत्र्या हृदंतैरष्टभिः पदैः ।\nभालदेशे मुखे कण्ठे हृदि नाभ्यूरुजानुषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001682013, "chapter_id": 21682, "verse_number": "१-६८-१४", "content_sanskrit": "पादयोश्चैव विन्यस्य मूलने व्यापकं चरेत् ।\nवदेत्तत्पुरुषायांते विद्महेति पदं ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001682014, "chapter_id": 21682, "verse_number": "१-६८-१५", "content_sanskrit": "वक्रतुंडाय शब्दांते धीमहीति समीरयेत् ।\nतन्नो दंतिः प्रचोवर्णा दयादिति वदेत्पुनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001682015, "chapter_id": 21682, "verse_number": "१-६८-१६", "content_sanskrit": "एषोक्ता मूलगायत्री सर्वसिद्धिप्रदायिनी ।\nएवं न्यासविधिं कृत्वा ध्यायेदेवं हृदंबुजे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001682016, "chapter_id": 21682, "verse_number": "१-६८-१७", "content_sanskrit": "उद्यन्मार्तण्डसदृशं लोकस्थित्यंतकारणम् ।\nसशक्तिकं भूषितांगं दंत चक्राद्युदायुधम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001682017, "chapter_id": 21682, "verse_number": "१-६८-१८", "content_sanskrit": "एवं ध्यात्वा चतुश्चत्वारिंशत्साहस्रसंयुतम् ।\nचतुर्लक्षं जपेन्मंत्रं अष्टद्रव्यैर्दशांशतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001682018, "chapter_id": 21682, "verse_number": "१-६८-१९", "content_sanskrit": "जुहुयाद्विधिवन्मंत्री संस्कृते हव्यवाहने ।\nइक्षवः सक्तवो मोचाफलानि चिपिटास्तिलाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001682019, "chapter_id": 21682, "verse_number": "१-६८-२०", "content_sanskrit": "मोदका नारिकेलानि लाजा द्रव्याष्टकं स्मृतम् ।\nपीठमाधारशक्त्यादिपरतत्वांतमर्चयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001682020, "chapter_id": 21682, "verse_number": "१-६८-२१", "content_sanskrit": "षट्कोणांतस्त्रिकोणं च बहिरष्टदलं लिखेत् ।\nभूपुरं तद्बहिः कृत्वा गमेशं तत्र पूजयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001682021, "chapter_id": 21682, "verse_number": "१-६८-२२", "content_sanskrit": "तीव्राख्या ज्वालिनी नंदा भोगदा कामरूपाणी ।\nअग्रा तेजोवती सत्या नवमी विध्ननाशिनी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001682022, "chapter_id": 21682, "verse_number": "१-६८-२३", "content_sanskrit": "सर्वादिशक्तिकमलासनाय हृदयांतिकः ।\nपीठमंत्रोऽयमेतेन दद्यादासनमुत्तमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001682023, "chapter_id": 21682, "verse_number": "१-६८-२४", "content_sanskrit": "तत्रावाह्य गणाधीशं मध्ये सम्पूज्य यत्नतः ।\nविकोणबाह्ये पूर्वादिचतुर्दिक्ष्वर्चयेत्क्रमात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001682024, "chapter_id": 21682, "verse_number": "१-६८-२५", "content_sanskrit": "श्रियं श्रियः पतिं चैव गौरीं गौरी पतिं तथा ।\nरतिं रतिपतिं पाश्चान्महीपूर्व च पोत्रिणम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001682025, "chapter_id": 21682, "verse_number": "१-६८-२६", "content_sanskrit": "क्रमादिल्ववटाश्वत्थप्रियगूनामधोऽर्चयेत् ।\nरमा पद्मद्वयकरा शंखचक्रधरो हरिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001682026, "chapter_id": 21682, "verse_number": "१-६८-२७", "content_sanskrit": "गौरी पाशांकुशधरा टंकशूलधरो हरः ।\nरतिः पद्मकरा पुष्पबाणचापधरः स्मरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001682027, "chapter_id": 21682, "verse_number": "१-६८-२८", "content_sanskrit": "शूकव्रीह्यग्रहस्ता भूः पोत्री चक्रगदाधरः ।\nदेवाग्रे पूजयेल्लक्ष्मीसहितं तु विनायकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001682028, "chapter_id": 21682, "verse_number": "१-६८-२९", "content_sanskrit": "पूजयेत्षट्सु कोणेषु ह्यामोदाद्यान्प्रियायुतान् ।\nआमोदं सिद्धिसंयुक्तमग्रतः परिपूजयेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001682029, "chapter_id": 21682, "verse_number": "१-६८-३०", "content_sanskrit": "प्रमोदं चाग्निकोणे तु समृद्धिसहितं यजेत् ।\nईशकोणे यजेत्कीर्तिसंयुतं सुमुखं तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001682030, "chapter_id": 21682, "verse_number": "१-६८-३१", "content_sanskrit": "वारुणे मदनावत्या संयुतं दुर्मुखं यजेत् ।\nयजेन्नैर्ऋत्यकोणे तु विघ्नं मदद्रवायुतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001682031, "chapter_id": 21682, "verse_number": "१-६८-३२", "content_sanskrit": "द्राविण्या विघ्नकर्तारं वायुकोणे समर्चयेत् ।\nपाशांकुशाभयकरांस्तरुणार्कसमप्रभान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001682032, "chapter_id": 21682, "verse_number": "१-६८-३३", "content_sanskrit": "कपोलविगलद्दानगंधलुब्धा लिशोभितान् ।\nषट्कोणोभयपार्श्वे तु शंखपद्मनिभौ क्रमात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001682033, "chapter_id": 21682, "verse_number": "१-६८-३४", "content_sanskrit": "सहितौ निजशक्तिभ्यां ध्यात्वा पूर्ववदर्चयेत् ।\nकेशरेषु षडंगानि पत्रेष्वष्टौ तु मातरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001682034, "chapter_id": 21682, "verse_number": "१-६८-३५", "content_sanskrit": "इन्द्राद्यानपि वज्ज्रादीन्पूजयेद्धरणीगृहे ।\nएवमाराध्य विघ्नेशं साधयेत्स्वमनोरथान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001682035, "chapter_id": 21682, "verse_number": "१-६८-३६", "content_sanskrit": "चतुश्चत्वारिंशताढ्यं चतुः शतमतंद्रितः ।\nतर्पयेदंबुभिः शुद्धैर्गजास्यं दिनशः सुधीः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001682036, "chapter_id": 21682, "verse_number": "१-६८-३७", "content_sanskrit": "पद्मैस्तु वशयेद्भूपांस्तत्पत्नीश्चोत्पलैस्तथा ।\nकुमुदैर्मंत्रिणोऽश्वत्थसमिद्भिर्वाडवाञ्शुभैः ॥। ६८-॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001682037, "chapter_id": 21682, "verse_number": "१-६८-३८", "content_sanskrit": "उदुंम्बरोत्थैर्नृपतीन्वैश्यान्प्लक्षसमुद्भवैः ।\nवटोद्भवैः समिद्भिश्च वशयेदंतिमान्बुधः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001682038, "chapter_id": 21682, "verse_number": "१-६८-३९", "content_sanskrit": "आज्येन श्रियमाप्नोति स्वर्णाप्तिर्मधुना भवेत् ।\nगोदुग्धेन गवां लाभो दध्ना सर्वसमृद्धिमान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001682039, "chapter_id": 21682, "verse_number": "१-६८-४०", "content_sanskrit": "अन्नाप्तिरन्नहोमेन समिद्भिर्वेतसां जलम् ।\nवासांसि लभते हुत्वा कुसुंभकुसुमैः शुभैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001682040, "chapter_id": 21682, "verse_number": "१-६८-४१", "content_sanskrit": "अथ सर्वेष्टदं वक्ष्ये चतुरावृत्तितर्पणम् ।\nमूलेनादौ चतुर्वारं प्रत्येकं च प्रतर्पयेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001682041, "chapter_id": 21682, "verse_number": "१-६८-४२", "content_sanskrit": "पूर्वमंत्राक्षरैर्मंत्रैः स्वाहांतैश्च चतुश्चतुः ।\nमूलमंत्रैश्चतुर्वारपूर्वकं संप्रतर्प्य च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001682042, "chapter_id": 21682, "verse_number": "१-६८-४३", "content_sanskrit": "मिथुनादींस्ततः पश्चात्पूर्ववत्संप्रतर्पयेत् ।\nदेवेन सहितां शक्तिं शक्त्या च सहितं तु तम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001682043, "chapter_id": 21682, "verse_number": "१-६८-४४", "content_sanskrit": "एवंच षड्विंशतिधा मिथुनानि भवंति हि ।\nस्वनामाद्यर्णबीजानि तानि सन्तर्पयेत्क्रमात् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001682044, "chapter_id": 21682, "verse_number": "१-६८-४५", "content_sanskrit": "भवेत्संभूय सचतुश्चत्वारिंशञ्चतुः शतम् ।\nएवं संतप्य तत्पश्चात्पूर्ववत्सोपचारकैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001682045, "chapter_id": 21682, "verse_number": "१-६८-४६", "content_sanskrit": "सर्वाभीष्टं च संप्रार्थ्य प्रणम्योद्वासयेत्सुधीः ।\nभाद्रकृष्णचतुर्थ्यादिप्रतिमासमतंद्रितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001682046, "chapter_id": 21682, "verse_number": "१-६८-४७", "content_sanskrit": "आरभ्यार्कोदयं मंत्री यावच्चंद्रोदयो भवेत् ।\nतावन्नोपविशेद्भूमौ जितवाविस्थरमानसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001682047, "chapter_id": 21682, "verse_number": "१-६८-४८", "content_sanskrit": "ततश्चंद्रोदये मन्त्री पूजयेद्गणनायकम् ।\nपूर्वोक्तविधिना सम्यङ्नानापुष्पोपहारकैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001682048, "chapter_id": 21682, "verse_number": "१-६८-४९", "content_sanskrit": "एकविंशतिसंख्याकान्मोदकांश्च निवेदयेत् ।\nतदग्रे प्रजपेन्मन्त्रमष्टोत्तरसहस्रकम् ॥। ६९-॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001682049, "chapter_id": 21682, "verse_number": "१-६८-५०", "content_sanskrit": "ततः कर्पूरकाश्मीररक्तपुष्पैः सचन्दनैः ।\nअर्ध्यं दद्यात्तु मूलांते ङेते गणपतिं ततः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001682050, "chapter_id": 21682, "verse_number": "१-६८-५१", "content_sanskrit": "इदमर्ध्यं कल्पयामि हृदंतोऽर्ध्यमनुर्मतः ।\nस्तुत्वा नत्वा विसृज्याथ यजेच्चंद्रमसं पुनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001682051, "chapter_id": 21682, "verse_number": "१-६८-५२", "content_sanskrit": "अर्ध्यं दद्याञ्चतुर्वारं पूजयित्वा गुरुं ततः ।\nनिवेदितेषु विप्राय दद्यादर्धांश्च मोदकान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001682052, "chapter_id": 21682, "verse_number": "१-६८-५३", "content_sanskrit": "स्वयमर्द्धान्प्रभुंजीत ब्रह्मचारी जितेंद्रियः ।\nएवं व्रतं यः कुरुते सम्यक्संवत्सरावधि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001682053, "chapter_id": 21682, "verse_number": "१-६८-५४", "content_sanskrit": "पुत्रान्पौत्रान्सुखं वित्तमारोग्यं लभते नरः ।\nसूर्योदयादशक्तश्चेदस्तमारभ्य मंत्रवित् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001682054, "chapter_id": 21682, "verse_number": "१-६८-५५", "content_sanskrit": "चंद्रोदयांतं पूर्वोक्तविधिना व्रतमाचरेत् ।\nएवं कृतेऽपि पूर्वोक्तं फलमाप्नोति निश्चितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001682055, "chapter_id": 21682, "verse_number": "१-६८-५६", "content_sanskrit": "गणिशप्रतिमां दंतिदंतेन कपिनापि वा ।\nगजभग्रेन निंबेन सितार्केंणाथवा पुनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001682056, "chapter_id": 21682, "verse_number": "१-६८-५७", "content_sanskrit": "कृत्वा तस्यां समावाह्य प्राणस्थापनपूर्वकम् ।\nअभ्यर्च्य विधिवन्मन्त्री राहुग्रस्ते निशाकरे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001682057, "chapter_id": 21682, "verse_number": "१-६८-५८", "content_sanskrit": "स्पृष्ट्रा चैव निरहारस्तां शिखायां समुद्वहन् ।\nद्यूते विवादे समरे व्यवहारे जयं लभेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001682058, "chapter_id": 21682, "verse_number": "१-६८-५९", "content_sanskrit": "बीजं वराहो बिंद्धाढ्यौ मन्विंद्वान्नौ कलौ ततः ।\nस्मृतिर्मांसेंदुमन्वाग्रा कर्णोच्छिष्टगणे वदेत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001682059, "chapter_id": 21682, "verse_number": "१-६८-६०", "content_sanskrit": "बकः सदीर्घपवनो महायक्षाय यं बलिः ।\nबलिमंत्रोऽयमाख्यातो न चेद्वर्णोऽखिलेष्टदः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001682060, "chapter_id": 21682, "verse_number": "१-६८-६१", "content_sanskrit": "प्रणवो भुवनेशानीस्वबीजांते नवार्णकः ।\nहस्तीति च पिशाचीति लिखेञ्चैवाग्रिंसुंदरी ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001682061, "chapter_id": 21682, "verse_number": "१-६८-६२", "content_sanskrit": "नवार्णोऽयं समुद्दिष्टो भजतां सर्वसिद्धिदः ।\nपदैः सर्वेण मंत्रेण पञ्चांगानि प्रकल्पयेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001682062, "chapter_id": 21682, "verse_number": "१-६८-६३", "content_sanskrit": "अन्यत्सर्वं समानं स्यात्पूर्वमंत्रेण नारद ।\nअथाभिधास्ये विधिवद्वक्रतुंडमनुत्तमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001682063, "chapter_id": 21682, "verse_number": "१-६८-६४", "content_sanskrit": "तोयं विधिर्वह्नियुक्तकर्णेंद्वाढ्यो हरिस्तथा ।\nसदीर्घो दारको वायुर्वर्मांतोऽयं रसार्णकः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001682064, "chapter_id": 21682, "verse_number": "१-६८-६५", "content_sanskrit": "भार्गवोऽस्य मुनिश्छन्दोऽनुष्टुब्देवो गणाधिपः ।\nवक्रतुण्डाभिधो बीजं वं शक्तिः कवचं पुनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001682065, "chapter_id": 21682, "verse_number": "१-६८-६६", "content_sanskrit": "तारदृन्मध्यगैर्मंत्रवर्णैश्चंद्रविभूषितैः ।\nकृत्वा षडंगमन्त्रार्णान्भ्रूमध्ये च गले हृदि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001682066, "chapter_id": 21682, "verse_number": "१-६८-६७", "content_sanskrit": "नामौ लिंगे पदे न्यस्याखिलेन व्यापकं चरेत् ।\nउद्यदर्कद्युतिं हस्तैः पाशांकुशवराभयान् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001682067, "chapter_id": 21682, "verse_number": "१-६८-६८", "content_sanskrit": "दधतं गजवक्त्रं च रक्तभूषांबरं भजेत् ।\nध्यात्वैवं प्रजपेत्तर्कलक्षं द्रव्यैर्दशांशतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001682068, "chapter_id": 21682, "verse_number": "१-६८-६९", "content_sanskrit": "अष्टभिर्जुहुयात्पीठे तीव्रादिसहितेऽर्चयेत् ।\nमूर्तिं मूर्तेन संकल्प्य तस्यामावाह्य पूजयेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001682069, "chapter_id": 21682, "verse_number": "१-६८-७०", "content_sanskrit": "षट्कोणेषु षडंगानि पत्रेष्वष्टौ तु शक्तयः ।\nयजेद्विद्यां विधात्रीं च भोगदां विप्रघातिनीम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001682070, "chapter_id": 21682, "verse_number": "१-६८-७१", "content_sanskrit": "निधिप्रदीपां पापघ्नीं पुण्यां पश्चाच्छशिप्रभाम् ।\nदलाग्रेषु वक्रतुंड एकदंष्ट्रमहोदरौ ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001682071, "chapter_id": 21682, "verse_number": "१-६८-७२", "content_sanskrit": "गजास्यलंबोदरकौ विकटौ विध्नराट् तथा ।\nधूम्रवर्णस्ततो बाह्ये लोकेशान्हेतिसंयुतान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001682072, "chapter_id": 21682, "verse_number": "१-६८-७३", "content_sanskrit": "एवमावरणैरिष्ट्वा पञ्चभिर्गणनायकम् ।\nसाधंयेदखिलान्कामान्वक्रतुंड प्रंसादतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001682073, "chapter_id": 21682, "verse_number": "१-६८-७४", "content_sanskrit": "लब्ध्वा गुरुमुखान्मंत्रं दीक्षासंस्कारपूर्वकम् ।\nब्रह्मचारी हविष्याशी सत्यवाक् च जितेंद्रियः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001682074, "chapter_id": 21682, "verse_number": "१-६८-७५", "content_sanskrit": "जपेदर्कसहस्रं तु षण्मासं होमसंयुतम् ।\nदारिद्य्रं तु पराभूय जायते धनदोपमः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001682075, "chapter_id": 21682, "verse_number": "१-६८-७६", "content_sanskrit": "चतुर्थ्यादि चतुर्थ्यंतं जपेदयुतमादरात् ।\nअष्टोत्तरशतं नित्यं हुत्वा प्राग्वत्फलं लभेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001682076, "chapter_id": 21682, "verse_number": "१-६८-७७", "content_sanskrit": "पक्षयोरुभयोर्मंत्री चतुर्थ्यां जुहुयाच्छतम् ।\nअपूपैर्वत्सरे स स्यात्समृद्धेः परमं पदम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001682077, "chapter_id": 21682, "verse_number": "१-६८-७८", "content_sanskrit": "अङ्गारकचतुर्थ्यां तु देवमिष्ट्वा विधानतः ।\nहविषा पा यसान्नेन नैवेद्यं परिकल्पयेत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001682078, "chapter_id": 21682, "verse_number": "१-६८-७९", "content_sanskrit": "ततो गुरुं समभ्यंर्त्य भोजयेद्विधिवत्सुधीः ।\nनिवेदितेन जुहुयात्सहरस्रं विधिवद्वसौ ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001682079, "chapter_id": 21682, "verse_number": "१-६८-८०", "content_sanskrit": "एवं संवत्सरं कृत्वा महतीं श्रियमाप्नुयात् ।\nअथान्यत्साधनं वक्ष्ये लोकानां हितकाम्यया ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001682080, "chapter_id": 21682, "verse_number": "१-६८-८१", "content_sanskrit": "इष्ट्वा गणेशं पृथुकैः पायसापूपमोदकः ।\nनानाफलैस्ततोमंत्री हरिद्रामथ सैन्धवम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001682081, "chapter_id": 21682, "verse_number": "१-६८-८२", "content_sanskrit": "वचां निष्कार्द्धभागं च तदर्द्धं वा मनुं जपेत् ।\nविशोध्य चूर्णं प्रसृतौ गवां मूत्रे विनिक्षिपेत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001682082, "chapter_id": 21682, "verse_number": "१-६८-८३", "content_sanskrit": "सहस्रकृत्वो मनुना मंत्रयित्वा प्रयत्नतः ।\nस्नातामृतुदिने शुद्धां शुक्लांबरधरां शुभाम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001682083, "chapter_id": 21682, "verse_number": "१-६८-८४", "content_sanskrit": "देवस्य पुरतः स्थाप्य पाययेदौषधं सुधीः ।\nसर्वलक्षणसंपन्नं वंध्यापि लभते सुतम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001682084, "chapter_id": 21682, "verse_number": "१-६८-८५", "content_sanskrit": "अथान्यत्संप्रवक्ष्यामि रहस्यं परमाद्भुतम् ।\nगोचर्ममात्रां धरणीमुपलिप्य प्रयत्नतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001682085, "chapter_id": 21682, "verse_number": "१-६८-८६", "content_sanskrit": "विकीर्य धान्यप्रकरैस्तत्र संस्थापयेद्धटम् ।\nशुद्धोदकेन संपूर्य तस्योपरि निधापयेत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001682086, "chapter_id": 21682, "verse_number": "१-६८-८७", "content_sanskrit": "कपिलाज्येन संपूर्णं शरावं नूतनं शुभम् ।\nषडष्टाक्षरमंत्राभ्यां दीपमारोपयेच्छुभम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001682087, "chapter_id": 21682, "verse_number": "१-६८-८८", "content_sanskrit": "दीपे देवं समावाह्य गंधपुष्पादिभिर्यजेत् ।\nस्नातां कुमारीमथवा कुमारं पूजयेत्सुधीः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001682088, "chapter_id": 21682, "verse_number": "१-६८-८९", "content_sanskrit": "दीपस्य पुरतः स्थाप्यध्यात्वा देवं जपेन्मनुम् ।\nप्रदीपे स्थापिते पश्येद्द्विजरूपं गणेश्वरम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001682089, "chapter_id": 21682, "verse_number": "१-६८-९०", "content_sanskrit": "पृष्टस्ततः संपदि वा नष्टं चैवाप्यनागतम् ।\nसकलं प्रवदेदेवं कुमारी वा कुमारकः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001682090, "chapter_id": 21682, "verse_number": "१-६८-९१", "content_sanskrit": "षडक्षरो हृदंतश्चेद्भवेदष्टाक्षरो मनुः ।\nअन्येऽपि मंत्रा देवर्षे सन्ति तंत्रे गणेशितुः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001682091, "chapter_id": 21682, "verse_number": "१-६८-९२", "content_sanskrit": "किंत्वत्र यन्न साध्यं स्यात्र्रिषु लोकेषु साधकैः ।\nअष्टविंशरसार्णाभ्यां तन्न पश्येदपि क्वचित् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001682092, "chapter_id": 21682, "verse_number": "१-६८-९३", "content_sanskrit": "एतद्गणेशमंत्राणां विधानं ते मयोदितम् ।\nशठेभ्यः परशिष्येभ्यो वंचकेभ्योऽपि मा वद ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001682093, "chapter_id": 21682, "verse_number": "१-६८-९४", "content_sanskrit": "एवं यो भजते देवं गणेशंसर्वसिद्धिदम् ।\nप्राप्येह सकलान्भोगनिंते मुक्तिपदं व्रजेत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]