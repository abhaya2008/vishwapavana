[{"id": 2199829, "chapter_id": 5251, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2199830, "chapter_id": 5251, "verse_number": "१", "content_sanskrit": "उक्तं वै गोप्रदानं ते नाचिकेतमृषिं प्रति ।\nमाहात्म्यमपि चैवोक्तमुद्देशेन गवां प्रभो\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2199831, "chapter_id": 5251, "verse_number": "२", "content_sanskrit": "नृगेण च यथा दुःखमनुभूतं महात्मना ।\nएकापराधादज्ञानात् पितामह महामते\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2199832, "chapter_id": 5251, "verse_number": "३", "content_sanskrit": "द्वारवत्यां यथा चासौ निविशन्त्यां समुद्धृतः ।\nमोक्षहेतुरभूत् कृष्णस्तदप्यवधृतं मया\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2199833, "chapter_id": 5251, "verse_number": "४", "content_sanskrit": "किं त्वस्ति मम सन्देहो गवां लोकं प्रति प्रभो ।\nतत्त्वतः श्रोतुमिच्छामि गोदा यत्र विशन्त्युत\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2199834, "chapter_id": 5251, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2199835, "chapter_id": 5251, "verse_number": "५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nयथाऽपृच्छत् पद्मयोनिमेतदेव शतक्रतुः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2199836, "chapter_id": 5251, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2199837, "chapter_id": 5251, "verse_number": "६", "content_sanskrit": "स्वर्लोकवासिनां लक्ष्मीमभिभूय स्वया त्विषा ।\nगोलोकवासिनः पश्ये व्रजतः संशयोऽत्र मे\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2199838, "chapter_id": 5251, "verse_number": "७", "content_sanskrit": "कीदृशा भगवँल्लोका गवां तद् ब्रूहि मेऽनघ ।\nयानावसन्ति दातार एतदिच्छामि वेदितुम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2199839, "chapter_id": 5251, "verse_number": "८", "content_sanskrit": "कीदृशाः किम्फलाः कःस्वित् परमस्तत्र वै गुणः ।\nकथं च पुरुषास्तत्र गच्छन्ति विगतज्वराः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2199840, "chapter_id": 5251, "verse_number": "९", "content_sanskrit": "कियत्कालं प्रदानस्य दाता च फलमश्नुते ।\nकथं बहुविधं दानं स्यादल्पमपि वा कथम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2199841, "chapter_id": 5251, "verse_number": "१०", "content_sanskrit": "बह्वीनां कीदृशं दानमल्पानां वापि कीदृशम् ।\nअदत्त्वा गोप्रदाः सन्ति केन वा तच्च शंस मे\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2199842, "chapter_id": 5251, "verse_number": "११", "content_sanskrit": "कथं च बहुदाता स्यादल्पदात्रा समः प्रभो ।\nअल्पप्रदाता बहुदः कथं च स्यादिहेश्वर\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2199843, "chapter_id": 5251, "verse_number": "१२", "content_sanskrit": "कीदृशी दक्षिणा चैव गोप्रदाने विशिष्यते ।\nएतत् तथ्येन भगवन् मम शंसितुमर्हसि\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2199844, "chapter_id": 5251, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे ब्रह्मेन्द्रसंवादे इन्द्रपश्नोनाम द्व्यधिकशततमोऽध्यायः ॥१०२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]