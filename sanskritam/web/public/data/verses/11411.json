[{"id": 50008891, "chapter_id": 11411, "verse_number": "1", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50008892, "chapter_id": 11411, "verse_number": "2", "content_sanskrit": "निर्वेदवादिनीमेवं मनोर्दुहितरं मुनिः। दयाळुः शालिनीमाह शुक्लभिव्याहृतं स्मरन्॥ ३/२५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50008893, "chapter_id": 11411, "verse_number": "3", "content_sanskrit": "ऋषिरुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50008894, "chapter_id": 11411, "verse_number": "4", "content_sanskrit": "मा खिदो राजपुत्रीत्थमात्मानं प्रत्यनिन्दिते। भगवांस्तेऽक्षरो गर्भमदूरात् सम्प्रपत्स्यते॥ ३/२५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50008895, "chapter_id": 11411, "verse_number": "5", "content_sanskrit": "धृतव्रता सुभद्रं ते दमेन नियमेन च। तपोद्रविणदानैश्च श्रद्धया चेश्वरं भज॥ ३/२५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50008896, "chapter_id": 11411, "verse_number": "6", "content_sanskrit": "स त्वयाऽऽराधितः शुक्ले वितन्वन् मामकं यशः। छेत्ता ते हृदयग्रन्थिमौदर्यो ब्रह्मभावनः॥ ३/२५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50008897, "chapter_id": 11411, "verse_number": "7", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50008898, "chapter_id": 11411, "verse_number": "8", "content_sanskrit": "देवहूत्यपि सन्देशं गौरवेण प्रजापतेः। सम्यक् श्रद्धाय पुरुषं कूटस्थमभजद् गुरुम्॥ ३/२५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50008899, "chapter_id": 11411, "verse_number": "9", "content_sanskrit": "तस्यां बहुतिथे काले भगवान् मधुसूदनः। कार्दमं वीर्यमापन्नो जज्ञेऽग्निरिव दारुणि॥ ३/२५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50008900, "chapter_id": 11411, "verse_number": "10", "content_sanskrit": "अवादयंस्तदा व्योम्नि वादित्राणि घनाघनाः। गायन्ति तस्मिन् गन्धर्वा नृत्यन्त्यप्सरसो मुदा॥ ३/२५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50008901, "chapter_id": 11411, "verse_number": "11", "content_sanskrit": "पेतुः सुमनसो दिव्याः खेचरैरपवर्जिताः। प्रसेदुश्च दिशः सर्वा अम्भांसि च मनांसि च॥ ३/२५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50008902, "chapter_id": 11411, "verse_number": "12", "content_sanskrit": "तत् कर्दमाश्रमपदं सरस्वत्या परिप्लुतम्। स्वयम्भूः साकमृषिभिर्मरीच्यादिभिरभ्यगात्॥ ३/२५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50008903, "chapter_id": 11411, "verse_number": "13", "content_sanskrit": "भगवन्तं परं ब्रह्म सत्त्वेनांशेन शत्रुहन्। तत्त्वसङ्ख्यानविज्ञप्त्यै जातं विद्वानजः स्वराट्॥ ३/२५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50008904, "chapter_id": 11411, "verse_number": "14", "content_sanskrit": "सभाजयन् विशुद्धेन चेतसा तच्चिकार्षितम्। प्रहृष्यमाणैरसुभिः कर्दमं चेदमभ्यधात्॥ ३/२५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50008905, "chapter_id": 11411, "verse_number": "15", "content_sanskrit": "ब्रह्मोवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50008906, "chapter_id": 11411, "verse_number": "16", "content_sanskrit": "त्वया मेऽपचितिस्तात कल्पिता निर्व्यळीकतः। यन्मे सञ्जगृहे वाक्यं भवान् मानद मानयन्॥ ३/२५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50008907, "chapter_id": 11411, "verse_number": "17", "content_sanskrit": "एतावत्येव शुश्रूषा कार्या पितरि पुत्रकैः। बाढमित्यनुमन्येत गौरवेण गुरोर्वचः॥ ३/२५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50008908, "chapter_id": 11411, "verse_number": "18", "content_sanskrit": "इमा दुहितरः सत्यस्तव वत्स सुमध्यमाः। सर्गमेताः प्रभावैः स्वैर्बृंहयिष्यन्ति नैकधा॥ ३/२५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50008909, "chapter_id": 11411, "verse_number": "19", "content_sanskrit": "अतस्त्वमृषिमुख्येभ्यो यथाशीलं यथारुचि। आत्मजाः परिदेह्यङ्ग विस्तृणीहि यशो भुवि॥ ३/२५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50008910, "chapter_id": 11411, "verse_number": "20", "content_sanskrit": "वेदाहमाद्यं पुरुषमवतीर्णं स्वमायया। भूतानां शेवधिं देहं बिभ्राणं कपिलं मुने॥ ३/२५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50008911, "chapter_id": 11411, "verse_number": "21", "content_sanskrit": "ज्ञानविज्ञानयोगेन कर्मणामुद्धरंश्च यः। हिरण्यकेशः पद्माक्षः पद्ममुद्रापदाम्बुजः॥ ३/२५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50008912, "chapter_id": 11411, "verse_number": "22", "content_sanskrit": "एष मानवि ते गर्भं प्रविष्टः कैटभार्दनः। अविद्यासंशयग्रन्थिं च्छित्त्वा गां विचरिष्यति॥ ३/२५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50008913, "chapter_id": 11411, "verse_number": "23", "content_sanskrit": "अयं सिद्धगणाधीशः साङ्ख्याचार्यैः सुसम्मतः। लोके कपिल इत्याख्यां गन्ता ते कार्तिवर्धनः॥ ३/२५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50008914, "chapter_id": 11411, "verse_number": "24", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50008915, "chapter_id": 11411, "verse_number": "25", "content_sanskrit": "अथाश्वास्य जगत्स्रष्टा कुमारैः सहनारदः। हंसो हंसेन यानेन स्वधाम प्रत्यपद्यत॥ ३/२५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50008916, "chapter_id": 11411, "verse_number": "26", "content_sanskrit": "गते शतधृतौ क्षत्तः कर्दमस्तेन चोदितः। यथोदितं स्वदुहितृः प्रादाद् विश्वसृजां ततः॥ ३/२५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50008917, "chapter_id": 11411, "verse_number": "27", "content_sanskrit": "मरीचये कलां प्रादादनसूयामथात्रये। श्रद्धामङ्गिरसेऽयच्छत् पुलस्त्याय हविर्भुवम्॥ ३/२५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50008918, "chapter_id": 11411, "verse_number": "28", "content_sanskrit": "पुलहाय गतिं युक्तां क्रतवे च क्रियां सतीम्। ख्यातिं च भृगवेऽयच्छद् वसिष्ठायाप्यरुन्धतीम्॥ ३/२५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50008919, "chapter_id": 11411, "verse_number": "29", "content_sanskrit": "अथर्वणेऽददाच्छान्तिं यया यज्ञो वितन्यते। विप्रर्षभान् कृतोद्वाहान् सदारान् समलाळयत्॥ ३/२५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50008920, "chapter_id": 11411, "verse_number": "30", "content_sanskrit": "ततस्त ऋषयः क्षत्तः कृतदारा निमन्त्र्य तम्। प्रातिष्ठन् नन्दमापन्नाः स्वंस्वमाश्रममण्डलम्॥ ३/२५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50008921, "chapter_id": 11411, "verse_number": "31", "content_sanskrit": "स चावतीर्णं त्रियुगमाज्ञाय विबुधर्षभम्। विविक्त उपसङ्गम्य प्रणम्य समभाषत॥ ३/२५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50008922, "chapter_id": 11411, "verse_number": "32", "content_sanskrit": "अहो पापच्यमानानां निरये स्वैरमङ्गळैः। कालेन भूयसा नूनं प्रसीदन्तीह देवताः॥ ३/२५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50008923, "chapter_id": 11411, "verse_number": "33", "content_sanskrit": "बहुजन्मविपाकेन सम्यग् योगसमाधिना। द्रष्टुं यतन्ते यतयः शून्यागारेषु यत्पदम्॥ ३/२५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50008924, "chapter_id": 11411, "verse_number": "34", "content_sanskrit": "स एव भगवानद्य हेळनं नगणय्य नः। गृहेषु जातो ग्राम्याणां यः स्वानां पक्षपोषणः॥ ३/२५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50008925, "chapter_id": 11411, "verse_number": "35", "content_sanskrit": "स्वीयं वाक्यमृतं कर्तुमवतीर्णोऽसि मे गृहे। चिकार्षुर्भगवञ्छर्म भक्तानामभिवर्धनः॥ ३/२५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50008926, "chapter_id": 11411, "verse_number": "36", "content_sanskrit": "तान्येव तेऽभिरूपाणि रूपाणि भगवंस्तव। यानियानीह रोचन्ते स्वजनानामरूपिणः॥ ३/२५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50008927, "chapter_id": 11411, "verse_number": "37", "content_sanskrit": "त्वां सूरिभिस्तत्त्वबुभुत्सयाऽद्धा सदाऽभिवादार्हणपादपीठम्। ऐश्वर्यवैराग्ययशोविबोध- वीर्यश्रिया पूर्णमहं प्रपद्ये॥ ३/२५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50008928, "chapter_id": 11411, "verse_number": "38", "content_sanskrit": "परं प्रधानं पुरुषं महान्तं कालं कविं त्रिवृतं लोकपालम्। आत्मानुभूत्याऽनुगतप्रपञ्चं स्वच्छन्दशक्तिं कपिलं प्रपद्ये॥ ३/२५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50008929, "chapter_id": 11411, "verse_number": "39", "content_sanskrit": "तं त्वाऽनुपृच्छेऽद्य पतिं प्रजानां त्वयाऽवतीर्णेन उताप्तकामः। परिव्राजां पदवीमास्थितोऽहं चरिष्ये त्वां हृदि युञ्जन् विशोकः॥ ३/२५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50008930, "chapter_id": 11411, "verse_number": "40", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50008931, "chapter_id": 11411, "verse_number": "41", "content_sanskrit": "मया प्रोक्तं हि लोकस्य प्रमाणं सत्यलौकिके। अथाजनि मया तुभ्यं यदवोचमृतं मुने॥ ३/२५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50008932, "chapter_id": 11411, "verse_number": "42", "content_sanskrit": "एतन्मे जन्म लोकेऽस्मिन् मुमुक्षूणां दुराशयात्। प्रसङ्ख्यानाय तत्त्वानां समत्वायात्मदर्शिनाम्॥ ३/२५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50008933, "chapter_id": 11411, "verse_number": "43", "content_sanskrit": "एष आत्मपथोऽव्यक्तो नष्टः कालेन भूयसा। तं प्रवर्तयितुं देहमिमं विद्धि मया भृतम्॥ ३/२५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50008934, "chapter_id": 11411, "verse_number": "44", "content_sanskrit": "गच्छ कामं मयाऽऽपृष्टो मयि सन्न्यस्तकर्मणा। जित्वा सुदुर्जयं मृत्युममृतत्वाय मां भज॥ ३/२५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50008935, "chapter_id": 11411, "verse_number": "45", "content_sanskrit": "मामात्मानं स्वयञ्ज्योतिः सर्वभूतगुहाशयम्। आत्मन्येवात्मनाऽन्वीक्ष्य विशोकोऽभयमृच्छसि॥ ३/२५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50008936, "chapter_id": 11411, "verse_number": "46", "content_sanskrit": "विश्वमेतद्धि शास्त्रेण विज्ञायात्मानमीश्वरम्। मुनिः शान्तमनोवाक्यस्तर्हि न ख्यात्युपप्लवः॥ ३/२५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50008937, "chapter_id": 11411, "verse_number": "47", "content_sanskrit": "मात्र आध्यात्मिकां विद्यां शमनीं सर्वकर्मणाम्। वितरिष्ये यया चासौ भयं चातितरिष्यति॥ ३/२५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50008938, "chapter_id": 11411, "verse_number": "48", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50008939, "chapter_id": 11411, "verse_number": "49", "content_sanskrit": "एवं समुदितस्तेन कपिलेन प्रजापतिः। दक्षिणीकृत्य तं प्रीतो वनमेव जगाम ह॥ ३/२५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50008940, "chapter_id": 11411, "verse_number": "50", "content_sanskrit": "व्रतं स आस्थितो मौनमात्मैकशरणो मुनिः। निःसङ्गो व्यचरत् क्षोणीमनग्निरनिकेतनः॥ ३/२५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50008941, "chapter_id": 11411, "verse_number": "51", "content_sanskrit": "मनो ब्रह्मणि युञ्जानो यत् तत् सदसतः परम्। गुणावभासे विगुण एकभक्त्याऽनुभाविते॥ ३/२५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50008942, "chapter_id": 11411, "verse_number": "52", "content_sanskrit": "निरहङ्कृतिर्निर्ममश्च निर्द्वन्द्वः समदृक् स्वदृक्। प्रत्यग्रः शान्तधीर्धीरः प्रशान्तोर्मिरिवोदधिः॥ ३/२५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50008943, "chapter_id": 11411, "verse_number": "53", "content_sanskrit": "वासुदेवे भगवति सर्वज्ञे प्रत्यगात्मनि। परेण भक्तिभावेन लब्धात्मा मुक्तबन्धनः॥ ३/२५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50008944, "chapter_id": 11411, "verse_number": "54", "content_sanskrit": "आत्मानं सर्वभूतेषु भगवन्तमवस्थितम्। अपश्यत् सर्वभूतानि भगवत्यपि चात्मनि॥ ३/२५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50008945, "chapter_id": 11411, "verse_number": "55", "content_sanskrit": "इच्छाद्वेषविहीनेन सर्वत्र समचेतसा। भगवद्भक्तियोगेन प्राप्तो भागवतीं गतिम्॥ ३/२५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50008946, "chapter_id": 11411, "verse_number": "56", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्धे पञ्चविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]