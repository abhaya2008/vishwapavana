[{"id": 2075622, "chapter_id": 2600, "verse_number": "१२-१०५-०x", "content_sanskrit": "मुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075623, "chapter_id": 2600, "verse_number": "१२-१०५-१", "content_sanskrit": "अथ चेत्पौरुषं किंचित्क्षत्रियात्मनि पश्यसि।\nब्रवीम्यहं तु ते नीतिं राज्यस्य प्रतिपत्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075624, "chapter_id": 2600, "verse_number": "१२-१०५-२", "content_sanskrit": "तां चच्छक्ष्यस्यनुष्ठातुं कर्म चैव करिष्यसि।\nशृणु सर्वमशेषेण यत्ते वक्ष्यामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075625, "chapter_id": 2600, "verse_number": "१२-१०५-३", "content_sanskrit": "आचरिष्यसि चेत्कर्म महतोऽर्थानवाप्स्यसि।\nराज्यं वा राज्यमन्त्रं वा महतीं वा पुनः श्रियम्।\nयद्येतद्रोचते राजन्पुनर्ब्रूहि ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075626, "chapter_id": 2600, "verse_number": "१२-१०५-४x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075627, "chapter_id": 2600, "verse_number": "१२-१०५-४", "content_sanskrit": "ब्रवीतु भगवान्नीतिमभिपन्नोऽस्म्यधीहि भो।\nअमोघ एव मेऽद्यास्तु त्वया सह समागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075628, "chapter_id": 2600, "verse_number": "१२-१०५-५x", "content_sanskrit": "मुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075629, "chapter_id": 2600, "verse_number": "१२-१०५-५", "content_sanskrit": "हित्वा मानं च दम्भं च क्रोधं हर्ष भयं तथा।\nप्रत्यमित्राणि सेवस्व प्रणिपत्य कृताञ्जलिः।\nतमुत्तमेन शौचेन कर्मणा चावधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075630, "chapter_id": 2600, "verse_number": "१२-१०५-६", "content_sanskrit": "दातुमर्हति ते वित्तं वैदेहः सत्यविक्रमः।\nप्रमाणं सर्वभूतेषु प्रग्रहं च गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075631, "chapter_id": 2600, "verse_number": "१२-१०५-७", "content_sanskrit": "ततः सहायान्सोत्साहाँल्लप्स्यसेऽव्यसनाञ्शुचीन्।\nवर्तमानः स्वशास्त्रे वै संयतात्मा जितेन्द्रियः।\nअभ्युद्धरति चात्मानं प्रसादयति च प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075632, "chapter_id": 2600, "verse_number": "१२-१०५-८", "content_sanskrit": "तेनैव त्वं धृतिमता श्रीमता चापि सत्कृतः।\nप्रमाणं सर्वभूतेषु गत्वा च ग्रहणं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075633, "chapter_id": 2600, "verse_number": "१२-१०५-९", "content_sanskrit": "ततः सुहृद्बलं लब्ध्वा मन्त्रयित्वा सुमन्त्रितम्।\nसान्त्वेन भेदयित्वाऽरीन्बिल्वं बिल्वेन शातय।\nपरैर्वा संविदं कृत्वा बलमप्यस्य घातय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075634, "chapter_id": 2600, "verse_number": "१२-१०५-१०", "content_sanskrit": "अलभ्या ये शुभा भावाः स्त्रियश्चाच्छादनानि च।\nशय्यासनानि यानानि महार्हाणि गृहाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075635, "chapter_id": 2600, "verse_number": "१२-१०५-११", "content_sanskrit": "पक्षिणो मृगजातानि रसगन्धाः फलानि च।\nतेष्वेव सज्जयेथास्त्वं यथा नश्येत्स्वयं परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075636, "chapter_id": 2600, "verse_number": "१२-१०५-१२", "content_sanskrit": "यद्येवं प्रतिषेद्धव्यो यद्युपेक्षणमर्हति।\n`सदैव राजशार्दूल विदुषा हितमिच्छता।\nन जातु विवृतः कार्यः शत्रुः सुनयमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075637, "chapter_id": 2600, "verse_number": "१२-१०५-१३", "content_sanskrit": "वसस्व पुरमामित्रं विषये मित्रसंमतः।\nभजस्व श्वेतकाकीयैर्मित्रधर्ममनथैकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075638, "chapter_id": 2600, "verse_number": "१२-१०५-१४", "content_sanskrit": "आरम्भांश्चास्य महतो दुष्करान्संप्रयोजय।\nनदीबन्धविभेदांश्च बलवद्भिर्विरुध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075639, "chapter_id": 2600, "verse_number": "१२-१०५-१५", "content_sanskrit": "उद्यानानि महार्हाणि शयनान्यासनानि च।\nप्रीतिभोगमुखेनैव कोशमस्य विरोचय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075640, "chapter_id": 2600, "verse_number": "१२-१०५-१६", "content_sanskrit": "यज्ञदाने प्रशंसास्मै ब्राह्मणाननुवर्तय।\nते त्वा प्रियं करिष्यन्ति तच्छेत्स्यन्ति वृका इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075641, "chapter_id": 2600, "verse_number": "१२-१०५-१७", "content_sanskrit": "असंशयं पुण्यशीलाः प्राप्नोति परमां गतिम्।\nत्रिविष्टपे पुण्यतमं स्थानं प्राप्नोति शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075642, "chapter_id": 2600, "verse_number": "१२-१०५-१८", "content_sanskrit": "कोशक्षये त्वमित्राणां वशं कौसल्य गच्छति।\nउभयत्र प्रयुक्तस्य धर्मे चाधर्म एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075643, "chapter_id": 2600, "verse_number": "१२-१०५-१९", "content_sanskrit": "फलार्थमूलमुच्छिद्यात्तेन नन्दन्ति शत्रवः।\nन चास्मै मानुषं कर्म दैवप्रस्योपवर्णय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075644, "chapter_id": 2600, "verse_number": "१२-१०५-२०", "content_sanskrit": "असंशयं दैवपरः क्षिप्रमेव विनश्यति।\nयाजयैनं विश्वजिता सर्वस्वेन वियुज्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075645, "chapter_id": 2600, "verse_number": "१२-१०५-२१", "content_sanskrit": "ततो गच्छत्यसिद्धार्थः पीडयानो महाजनम्।\nत्यागधर्मविदं पुण्यं कंचिदस्योपवर्णय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075646, "chapter_id": 2600, "verse_number": "१२-१०५-२२", "content_sanskrit": "अपि त्यागं बुभूषेत कच्चिद्गच्छेदनामयम्।\nसिद्धेनौषधियोगेन सर्वशत्रुविनाशिना।\nगजानश्वान्मनुष्यांश्च कृतकैरुपघातय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075647, "chapter_id": 2600, "verse_number": "१२-१०५-२३", "content_sanskrit": "एते चान्ये च बहवो दम्भयोगाः सुचिन्तिताः।\nशक्या विपहता कर्तुं न क्लीबेन नृपात्मज॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075648, "chapter_id": 2600, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चाधिकशततमोऽध्यायः॥ १०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]