[{"id": 7000561000, "chapter_id": 20561, "verse_number": "५-२०-१", "content_sanskrit": "सुमतिरुवाच ।\nअथ प्रयाते भूपाले सर्वलोकसमन्विते ।\nमहाभागैर्वैष्णवैश्च गायकैः कृष्णकीर्तनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000561001, "chapter_id": 20561, "verse_number": "५-२०-२", "content_sanskrit": "शुश्रावासौ महाराजो मार्गे गोविंदकीर्तनम् ।\nजय माधव भक्तानां शरण्य पुरुषोत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000561002, "chapter_id": 20561, "verse_number": "५-२०-३", "content_sanskrit": "मार्गे तीर्थान्यनेकानि कुर्वन्पश्यन्महोदयम् ।\nतापसब्राह्मणात्तेषां महिमानमथा शृणोत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000561003, "chapter_id": 20561, "verse_number": "५-२०-४", "content_sanskrit": "विचित्रविष्णुवार्ताभिर्विनोदितमना नृपः ।\nमार्गेमार्गे महाविष्णुं गापयामास गायकान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000561004, "chapter_id": 20561, "verse_number": "५-२०-५", "content_sanskrit": "दीनांधकृपणानां च पंगूनां वासनोचितम् ।\nदानं ददौ महाराजो बुद्धिमान्विजितेंद्रियः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000561005, "chapter_id": 20561, "verse_number": "५-२०-६", "content_sanskrit": "अनेकतीर्थविरजमात्मानं भव्यतां गतम् ।\nकुर्वन्ययौ स्वीयलोकैर्हरिध्यानपरायणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000561006, "chapter_id": 20561, "verse_number": "५-२०-७", "content_sanskrit": "नृपो गच्छन्ददर्शाग्रे नदीं पापप्रणाशिनीम् ।\nचक्रांकितग्रावयुतां मुनिमानस निर्मलाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000561007, "chapter_id": 20561, "verse_number": "५-२०-८", "content_sanskrit": "अनेकमुनिवृंदानां बहुश्रेणिविराजिताम् ।\nसारसादिपतत्रीणां कूजितैरुपशोभिताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000561008, "chapter_id": 20561, "verse_number": "५-२०-९", "content_sanskrit": "दृष्ट्वा पप्रच्छ विप्राग्र्यं तापसं धर्मकोविदम् ।\nअनेकतीर्थमाहात्म्य विशेषज्ञानजृंभितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000561009, "chapter_id": 20561, "verse_number": "५-२०-१०", "content_sanskrit": "स्वामिन्केयं नदी पुण्या मुनिवृन्दनिषेविता ।\nकरोति मम चित्तस्य प्रमोदभरनिर्भरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000561010, "chapter_id": 20561, "verse_number": "५-२०-११", "content_sanskrit": "इति श्रुत्वा वचस्तस्य राजराजस्य धीमतः ।\nवक्तुं प्रचक्रमे विद्वांस्तीर्थमाहात्म्यमुत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000561011, "chapter_id": 20561, "verse_number": "५-२०-१२", "content_sanskrit": "ब्राह्मण उवाच ।\nगंडकीयं नदी राजन्सुरासुरनिषेविता ।\nपुण्योदकपरीवाह हतपातकसंचया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000561012, "chapter_id": 20561, "verse_number": "५-२०-१३", "content_sanskrit": "दर्शनान्मानसं पापं स्पर्शनात्कर्मजं दहेत् ।\nवाचिकं स्वीय तोयस्य पानतः पापसंचयम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000561013, "chapter_id": 20561, "verse_number": "५-२०-१४", "content_sanskrit": "पुरा दृष्ट्वा प्रजानाथः प्रजाः सर्वा विपावनीः ।\nस्वगंडविप्रुषोनेक पापघ्नीं सृष्टवानिमाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000561014, "chapter_id": 20561, "verse_number": "५-२०-१५", "content_sanskrit": "एनां नदीं ये पुण्योदां स्पृशंति सुतरंगिणीम् ।\nते गर्भभाजो नैव स्युरपि पापकृतो नराः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000561015, "chapter_id": 20561, "verse_number": "५-२०-१६", "content_sanskrit": "अस्यां भवा ये चाश्मानश्चक्रचिह्नैरलंकृताः ।\nते साक्षाद्भगवंतो हि स्वस्वरूपधराः पराः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000561016, "chapter_id": 20561, "verse_number": "५-२०-१७", "content_sanskrit": "शिलां संपूजयेद्यस्तु नित्यं चक्रयुतां नरः ।\nन जातु स जनन्या वै जठरं समुपाविशेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000561017, "chapter_id": 20561, "verse_number": "५-२०-१८", "content_sanskrit": "पूजयेद्यो नरो धीमाञ्छालग्रामशिलां वराम् ।\nतेनाचारवता भाव्यं दंभलोभवियोगिना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000561018, "chapter_id": 20561, "verse_number": "५-२०-१९", "content_sanskrit": "परदार परद्रव्यविमुखेन नरेण हि ।\nपूजनीयः प्रयत्नेन शालग्रामः सचक्रकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000561019, "chapter_id": 20561, "verse_number": "५-२०-२०", "content_sanskrit": "द्वारवत्यां भवं चक्रं शिला वै गंडकीभवा ।\nपुंसां क्षणाद्धरत्येव पापं जन्मशतार्जितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000561020, "chapter_id": 20561, "verse_number": "५-२०-२१", "content_sanskrit": "अपि पापसहस्राणां कर्ता तावन्नरो भवेत् ।\nशालग्रामशिलातोयं पीत्वा पूतो भवेत्क्षणात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000561021, "chapter_id": 20561, "verse_number": "५-२०-२२", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यः शूद्रो वेदपथि स्थितः ।\nशालग्रामं पूजयित्वा गृहस्थो मोक्षमाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000561022, "chapter_id": 20561, "verse_number": "५-२०-२३", "content_sanskrit": "न जातु चित्स्त्रिया कार्यं शालग्रामस्य पूजनम् ।\nभर्तृहीनाथ सुभगा स्वर्गलोकहितैषिणी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000561023, "chapter_id": 20561, "verse_number": "५-२०-२४", "content_sanskrit": "मोहात्स्पृष्ट्वापि महिला जन्मशीलगुणान्विता ।\nहित्वा पुण्यसमूहं सा सत्वरं नरकं व्रजेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000561024, "chapter_id": 20561, "verse_number": "५-२०-२५", "content_sanskrit": "स्त्रीपाणिमुक्तपुष्पाणि शालग्रामशिलोपरि ।\nपवेरधिकपातानि वदंति ब्राह्मणोत्तमाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000561025, "chapter_id": 20561, "verse_number": "५-२०-२६", "content_sanskrit": "चंदनं विषसंकाशं कुसुमं वज्रसंनिभम् ।\nनैवेद्यं कालकूटाभं भवेद्भगवतः कृतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000561026, "chapter_id": 20561, "verse_number": "५-२०-२७", "content_sanskrit": "तस्मात्सर्वात्मना त्याज्यं स्त्रिया स्पर्शः शिलोपरि ।\nकुर्वती याति नरकं यावदिंद्राश्चतुर्दश ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000561027, "chapter_id": 20561, "verse_number": "५-२०-२८", "content_sanskrit": "अपि पापसमाचारो ब्रह्महत्यायुतोऽपि वा ।\nशालग्रामशिलातोयं पीत्वा याति परां गतिम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000561028, "chapter_id": 20561, "verse_number": "५-२०-२९", "content_sanskrit": "तुलसीचंदनं वारि शंखो घंटाथ चक्रकम् ।\nशिला ताम्रस्य पात्रं तु विष्णोर्नामपदामृतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000561029, "chapter_id": 20561, "verse_number": "५-२०-३०", "content_sanskrit": "पदामृतं तु नवभिः पापराशिप्रदाहकम् ।\nवदंति मुनयः शांताः सर्वशास्त्रार्थकोविदाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000561030, "chapter_id": 20561, "verse_number": "५-२०-३१", "content_sanskrit": "सर्वतीर्थपरिस्नानात्सर्वक्रतुसमर्चनात् ।\nपुण्यं भवति यद्राजन्बिंदौ बिंदौ तदद्भुतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000561031, "chapter_id": 20561, "verse_number": "५-२०-३२", "content_sanskrit": "शालग्रामशिला यत्र पूज्यते पुरुषोत्तमैः ।\nतत्र योजनमात्रं तु तीर्थकोटिसमन्वितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000561032, "chapter_id": 20561, "verse_number": "५-२०-३३", "content_sanskrit": "शालग्रामाः समाः पूज्याः समेषु द्वितयं नहि ।\nविषमा एव संपूज्या विषमेषु त्रयं नहि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000561033, "chapter_id": 20561, "verse_number": "५-२०-३४", "content_sanskrit": "द्वारावती भवं चक्रं तथा वै गंडकीभवम् ।\nउभयोः संगमो यत्र तत्र गंगा समुद्रगा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000561034, "chapter_id": 20561, "verse_number": "५-२०-३५", "content_sanskrit": "रूक्षाः कुर्वंति पुरुषा नायुः श्रीबलवर्जितान् ।\nतस्मात्स्निग्धा मनोहारि रूपिण्यो ददति श्रियम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000561035, "chapter_id": 20561, "verse_number": "५-२०-३६", "content_sanskrit": "आयुष्कामो नरो यस्तु धनकामो हि यः पुमान् ।\nपूजयन्सर्वमाप्नोति पारलौकिकमैहिकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000561036, "chapter_id": 20561, "verse_number": "५-२०-३७", "content_sanskrit": "प्राणांतकाले पुंसस्तु भवेद्भाग्यवतो नृप ।\nवाचि नाम हरेः पुण्यं शिला हृदि तदंतिके ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000561037, "chapter_id": 20561, "verse_number": "५-२०-३८", "content_sanskrit": "गच्छत्सु प्राणमार्गेषु यस्य विश्रंभतोऽपि चेत् ।\nशालग्रामशिला स्फूर्तिस्तस्य मुक्तिर्न संशयः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000561038, "chapter_id": 20561, "verse_number": "५-२०-३९", "content_sanskrit": "पुरा भगवता प्रोक्तमंबरीषाय धीमते ।\nब्राह्मणा न्यासिनः स्निग्धाः शालग्रामशिलास्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000561039, "chapter_id": 20561, "verse_number": "५-२०-४०", "content_sanskrit": "स्वरूपत्रितयं मह्यमेतद्धि क्षितिमंडले ।\nपापिनां पापनिर्हारं कर्तुं धृतमुदं च ता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000561040, "chapter_id": 20561, "verse_number": "५-२०-४१", "content_sanskrit": "निंदंति पापिनो ये वा शालग्रामशिलां सकृत् ।\nकुंभीपाके पचंत्याशु यावदाभूतसंप्लवम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000561041, "chapter_id": 20561, "verse_number": "५-२०-४२", "content_sanskrit": "पूजां समुद्यतं कर्तुं यो वारयति मूढधीः ।\nतस्य मातापिताबंधुवर्गा नरकभागिनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000561042, "chapter_id": 20561, "verse_number": "५-२०-४३", "content_sanskrit": "यो वा कथयति प्रेष्ठं शालग्रामार्चनं कुरु ।\nसकृतार्थो नयत्याशु वैकुंठं स्वस्य पूर्वजान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000561043, "chapter_id": 20561, "verse_number": "५-२०-४४", "content_sanskrit": "अत्रैवोदाहरंतीममितिहासं पुरातनम् ।\nमुनयो वीतरागाश्च कामक्रोधविवर्जिताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000561044, "chapter_id": 20561, "verse_number": "५-२०-४५", "content_sanskrit": "पुरा कीकटसंज्ञे वै देशे धर्मविवर्जिते ।\nआसीत्पुल्कसजातीयो नरः शबरसंज्ञितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000561045, "chapter_id": 20561, "verse_number": "५-२०-४६", "content_sanskrit": "नित्यं जंतुवधोद्युक्तः शरासनधरो मुहुः ।\nतीर्थं प्रति यियासूनां बलाद्धरति जीवितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000561046, "chapter_id": 20561, "verse_number": "५-२०-४७", "content_sanskrit": "अनेकप्राणिहत्याकृत्परस्वे निरतः सदा ।\nसदा रागादिसंयुक्तः कामक्रोधादिसंयुतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000561047, "chapter_id": 20561, "verse_number": "५-२०-४८", "content_sanskrit": "विचरत्यनिशं भीमे वने प्राणिवधंकरः ।\nविषसंसक्तबाणाग्र रूढचापगुणोद्धुरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000561048, "chapter_id": 20561, "verse_number": "५-२०-४९", "content_sanskrit": "सैकदा पर्यटन्व्याधः प्राणिमात्रभयंकरः ।\nकालं प्राप्तं न जानाति समीपेऽप्युग्रमानसः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000561049, "chapter_id": 20561, "verse_number": "५-२०-५०", "content_sanskrit": "यमदूतास्तु संप्राप्ताः पाशमुद्गरपाणयः ।\nताम्रकेशा दीर्घनखा लंबदंष्ट्रा भयानकाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000561050, "chapter_id": 20561, "verse_number": "५-२०-५१", "content_sanskrit": "श्यामा लोहस्यनिगडान्बिभ्रतो मोहकारकाः ।\nबध्नंतु पापिनं ह्येनं प्राणिमात्रभयंकरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000561051, "chapter_id": 20561, "verse_number": "५-२०-५२", "content_sanskrit": "कदाचिन्मनसा नायं प्राणिमात्रोपकारकः ।\nपरदार परद्रव्य परद्रोहपरायणः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000561052, "chapter_id": 20561, "verse_number": "५-२०-५३", "content_sanskrit": "एतस्य जिह्वां महतीमहं निष्कासयाम्यतः ।\nएको वदति चैतस्य चक्षुरुत्पाटयाम्यहम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000561053, "chapter_id": 20561, "verse_number": "५-२०-५४", "content_sanskrit": "एको वदति चैतस्य करौ कृंतामि पापिनः ।\nअन्यो वदत्यहं कर्णौ कर्तयामि दुरात्मनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000561054, "chapter_id": 20561, "verse_number": "५-२०-५५", "content_sanskrit": "एवं वदंतः सुभृशं दन्तैर्दन्तनिपीडकाः ।\nआगत्य तं दुरात्मानं सायुधास्तस्थुरुन्मदाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000561055, "chapter_id": 20561, "verse_number": "५-२०-५६", "content_sanskrit": "एको दूतस्तदा सर्परूपं धृत्वादशत्पदे ।\nस दष्टमात्रः सहसा गतासुः पर्यजायत ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000561056, "chapter_id": 20561, "verse_number": "५-२०-५७", "content_sanskrit": "तदा तं लोहपाशेन बद्ध्वा ते यमकिंकराः ।\nकशाभिस्ताडयामासुर्मुद्गरैः प्राहरन्क्रुधा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000561057, "chapter_id": 20561, "verse_number": "५-२०-५८", "content_sanskrit": "अहो दुष्ट दुरात्मंस्त्वं कदाचिन्नाचरः शुभम् ।\nमनसापि यतस्त्वां वै क्षेप्स्यामो रौरवेषु च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000561058, "chapter_id": 20561, "verse_number": "५-२०-५९", "content_sanskrit": "त्वङ्मांसं वायसा रौद्रा भक्षयिष्यंति वै क्रुधा ।\nआजन्मतस्तु भवता न कृतं हरिसेवनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000561059, "chapter_id": 20561, "verse_number": "५-२०-६०", "content_sanskrit": "त्वया कलत्रपुत्राद्या द्रोहं कृत्वा सुपोषिताः ।\nन कदाचित्स्मृतो देवः पापहारी जनार्दनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000561060, "chapter_id": 20561, "verse_number": "५-२०-६१", "content_sanskrit": "तस्मात्त्वां लोहशंकौ वा कुंभीपाके च रौरवे ।\nधर्मराजाज्ञया सर्वे नेष्यामो बहुताडनैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000561061, "chapter_id": 20561, "verse_number": "५-२०-६२", "content_sanskrit": "एवमुक्त्वा यदानेतुं समैच्छन्यमकिंकराः ।\nतावत्प्राप्तो महाविष्णुचरणाब्जपरायणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000561062, "chapter_id": 20561, "verse_number": "५-२०-६३", "content_sanskrit": "यमदूतास्तदा दृष्टा वैष्णवेन महात्मना ।\nपाशमुद्गरदंडादिदुष्टायुधधरा गणाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000561063, "chapter_id": 20561, "verse_number": "५-२०-६४", "content_sanskrit": "पुल्कसं लोहनिगडैर्बद्ध्वा यातुं समुद्यताः ।\nबन्ध बन्ध ग्रसच्छिन्धि भिन्धि भिन्धीति वादिनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000561064, "chapter_id": 20561, "verse_number": "५-२०-६५", "content_sanskrit": "तदा कृपालुस्तं प्रेक्ष्य पद्मनाभपरायणः ।\nअत्यंतकृपयायुक्तं चेतस्तत्र तदाकरोत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000561065, "chapter_id": 20561, "verse_number": "५-२०-६६", "content_sanskrit": "असौ महादुष्ट पीडां मा यातु मम सन्निधौ ।\nमोचयाम्यहमद्यैव यमदूतेभ्य एव च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000561066, "chapter_id": 20561, "verse_number": "५-२०-६७", "content_sanskrit": "इति कृत्वा मतिं तस्मिन्कृपायुक्तो मुनीश्वरः ।\nशालग्रामशिलां हस्ते गृहीत्वास्य गतोंऽतिके ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000561067, "chapter_id": 20561, "verse_number": "५-२०-६८", "content_sanskrit": "तस्य पादोदकं पुण्यं तुलसीदलमिश्रितम् ।\nमुखे विनिक्षिपन्कर्णे रामनाम जजाप ह ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000561068, "chapter_id": 20561, "verse_number": "५-२०-६९", "content_sanskrit": "तुलसीं मस्तके तस्य धारयामास वैष्णवः ।\nशिलां हृदि महाविष्णोर्धृत्वा प्राह स वैष्णवः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000561069, "chapter_id": 20561, "verse_number": "५-२०-७०", "content_sanskrit": "गच्छंतु यमदूता वै यातनासु परायणाः ।\nशालग्रामशिलास्पर्शो दहतात्पातकं महत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000561070, "chapter_id": 20561, "verse_number": "५-२०-७१", "content_sanskrit": "इत्युक्तवति तस्मिन्वै गणा विष्णोर्महाद्भुताः ।\nआययुस्तस्य सविधे शिलास्पर्शाद्गतांहसः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000561071, "chapter_id": 20561, "verse_number": "५-२०-७२", "content_sanskrit": "पीतवस्त्राः शंखचक्रगदापद्मविराजिताः ।\nआगत्य मोचयामासुर्लोहपाशाद्दुरासदात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000561072, "chapter_id": 20561, "verse_number": "५-२०-७३", "content_sanskrit": "मोचयित्वा महापापकारकं पुल्कसं नरम् ।\nऊचुः किमर्थं बद्धोऽयं वैष्णवः पूज्यदेहभृत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000561073, "chapter_id": 20561, "verse_number": "५-२०-७४", "content_sanskrit": "कस्याज्ञाकारका यूयं यदधर्मप्रकारकाः ।\nमुंचंतु वैष्णवं त्वेनं किमर्थं विधृतो ह्ययम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000561074, "chapter_id": 20561, "verse_number": "५-२०-७५", "content_sanskrit": "इति वाक्यं समाकर्ण्य जगदुर्यमकिंकराः ।\nधर्मराजाज्ञया प्राप्ता नेतुं पापिनमुद्यताः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000561075, "chapter_id": 20561, "verse_number": "५-२०-७६", "content_sanskrit": "नासौ कदाचिन्मनसा प्राणिमात्रोपकारकः ।\nप्राणिहत्या महापापकारी दुष्टशरीरभृत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000561076, "chapter_id": 20561, "verse_number": "५-२०-७७", "content_sanskrit": "नॄन्बहूंस्तीर्थयात्रायां गच्छतोऽसौ व्यलुंठयत् ।\nपरदाररतो नित्यं सर्वपापाधिकारकः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000561077, "chapter_id": 20561, "verse_number": "५-२०-७८", "content_sanskrit": "तस्मान्नेतुं वयं प्राप्ताः पापिनं पुल्कसं नरम् ।\nभवद्भिर्मोचितः कस्मादकस्मादागतैर्भटैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000561078, "chapter_id": 20561, "verse_number": "५-२०-७९", "content_sanskrit": "विष्णुदूता ऊचुः ।\nब्रह्महत्यादिकं पापं प्राणिकोटिवधोद्भवम् ।\nशालग्रामशिलास्पर्शः सर्वं दहति तत्क्षणात् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000561079, "chapter_id": 20561, "verse_number": "५-२०-८०", "content_sanskrit": "रामेति नाम यच्छ्रोत्रे विश्रंभादागतं यदि ।\nकरोति पापसंदाहं तूलं वह्निकणो यथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000561080, "chapter_id": 20561, "verse_number": "५-२०-८१", "content_sanskrit": "तुलसी मस्तके यस्य शिला हृदि मनोहरा ।\nमुखे कर्णेऽथवा राम नाम मुक्तस्तदैव सः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000561081, "chapter_id": 20561, "verse_number": "५-२०-८२", "content_sanskrit": "तस्मादनेन तुलसी मस्तके विधृता पुरा ।\nश्रावितं रामनामाशु शिला हृदि सुधारिता ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000561082, "chapter_id": 20561, "verse_number": "५-२०-८३", "content_sanskrit": "तस्मात्पापसमूहोऽस्य दग्धः पुण्यकलेवरः ।\nयास्यते परमं स्थानं पापिनां यत्सुदुर्ल्लभम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000561083, "chapter_id": 20561, "verse_number": "५-२०-८४", "content_sanskrit": "वर्षायुतं तत्र भुक्त्वा भोगान्सर्वमनोहरान् ।\nभारते जन्म संप्राप्य समाराध्य जगद्गुरुम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000561084, "chapter_id": 20561, "verse_number": "५-२०-८५", "content_sanskrit": "प्राप्स्यते परमं स्थानं सुरासुरसुदुर्ल्लभम् ।\nन ज्ञातो महिमा सम्यक्छिलायाः परमेष्ठिनः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000561085, "chapter_id": 20561, "verse_number": "५-२०-८६", "content_sanskrit": "दृष्टा स्पृष्टार्चिता वापि सर्वपापहरा क्षणात् ।\nइत्युक्त्वा विरताः सर्वे महाविष्णोर्गणा मुदा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000561086, "chapter_id": 20561, "verse_number": "५-२०-८७", "content_sanskrit": "याम्यास्ते किंकरा राज्ञे कथयामासुरद्भुतम् ।\nवैष्णवो हर्षमापेदे रघुनाथपरायणः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000561087, "chapter_id": 20561, "verse_number": "५-२०-८८", "content_sanskrit": "मुक्तोऽसौ यमपाशाच्च गमिष्यति परं पदम् ।\nतदाजगाम विमलं किंकिणीजालमंडितम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000561088, "chapter_id": 20561, "verse_number": "५-२०-८९", "content_sanskrit": "विमानं देवलोकात्तु मनोहारि महाद्भुतम् ।\nतत्रारुह्य गतः स्वर्गं महापुण्यैर्निषेवितम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000561089, "chapter_id": 20561, "verse_number": "५-२०-९०", "content_sanskrit": "भोगान्भुक्त्वा स विपुलानाजगाम महीतलम् ।\nकाश्यां जन्म समासाद्य शुचिवाडवसत्कुले ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000561090, "chapter_id": 20561, "verse_number": "५-२०-९१", "content_sanskrit": "आराध्य जगतामीशं गतवान्परमं पदम् ।\nस पापी साधुसंगत्या शालग्रामशिलां स्पृशन् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000561091, "chapter_id": 20561, "verse_number": "५-२०-९२", "content_sanskrit": "महापीडाविनिर्मुक्तो गतवान्परमं पदम् ।\nमया तेऽभिहितं राजन्गंडकीचरितं महत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000561092, "chapter_id": 20561, "verse_number": "५-२०-९३", "content_sanskrit": "श्रुत्वा विमुच्यते पापैर्भुक्तिं मुक्तिं च विंदति ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]