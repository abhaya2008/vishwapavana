[{"id": 50015814, "chapter_id": 11563, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50015815, "chapter_id": 11563, "verse_number": "2", "content_sanskrit": "स्वसुर्वधान्निववृते कंसस्तद्वाक्यसारवित्। वसुदेवोऽपि तं प्रीतः प्रशस्य प्राविशद् गृहम्॥ १०/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50015816, "chapter_id": 11563, "verse_number": "3", "content_sanskrit": "अथ काल उपावृत्ते देवका सर्वदेवता। पुत्रान् प्रसुषुवे चाष्टौ कन्यां चैवानुवत्सरम्॥ १०/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50015817, "chapter_id": 11563, "verse_number": "4", "content_sanskrit": "कार्तिमन्तं प्रथमजं कंसायानकदुन्दुभिः। अर्पयामास कृच्छ्रेण सोऽनृतादतिविह्वलः॥ १०/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50015818, "chapter_id": 11563, "verse_number": "5", "content_sanskrit": "किं दुस्सहं नु साधूनां विदुषां किमपेक्षितम्। किमकार्यं कदर्याणां दुस्त्यजं किम् ऋतात्मनाम्॥ १०/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50015819, "chapter_id": 11563, "verse_number": "6", "content_sanskrit": "दृष्ट्वा समत्वं तच्छौरेः सत्ये चैव व्यवस्थितिम्। कंसस्तुष्टमना राजन् प्रहसन्निदमब्रवीत्॥ १०/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50015820, "chapter_id": 11563, "verse_number": "7", "content_sanskrit": "प्रतियातु कुमारोऽयं न ह्यस्मादस्ति मे भयम्। अष्टमाद् युवयोः पुत्रान्मृत्युर्मे विहितः किल॥ १०/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50015821, "chapter_id": 11563, "verse_number": "8", "content_sanskrit": "तथेति सुतमादाय ययावानकदुन्दुभिः। नाभ्यनन्दत तद्वाक्यमसतोऽविजितात्मनः॥ १०/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50015822, "chapter_id": 11563, "verse_number": "9", "content_sanskrit": "नन्दाद्या ये व्रजे गोपा याश्चामीषां च योषितः। वृष्णयो वसुदेवाद्या देवक्याद्या यदुस्त्रियः॥ १०/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50015823, "chapter_id": 11563, "verse_number": "10", "content_sanskrit": "सर्वे वै देवताप्राया उभयोरपि भारत। ज्ञातयो बन्धुसुहृदो ये च कंसमनुव्रताः॥ १०/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50015824, "chapter_id": 11563, "verse_number": "11", "content_sanskrit": "असुराः सर्व एवैते लोकोपद्रवकारिणः। गतेऽथ वसुदेवे तु देवकार्यार्थमुद्यतः॥ १०/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50015825, "chapter_id": 11563, "verse_number": "12", "content_sanskrit": "एतत् कंसाय भगवान् शशंसाभ्येत्य नारदः। भूमेर्भारावतरणं दैत्यानां च वधोद्यमम्॥ १०/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50015826, "chapter_id": 11563, "verse_number": "13", "content_sanskrit": "ऋषेर्विनिर्गमे कंसो यदून् मत्वा सुरानिति। देवक्या गर्भसम्भूतं विष्ण्वंशं स्ववधं प्रति॥ १०/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50015827, "chapter_id": 11563, "verse_number": "14", "content_sanskrit": "देवकां वसुदेवं च निगृह्य निगळेऽग्रहीत्। जातंजातमहन् पुत्रं तयोरजनशङ्कया॥ १०/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50015828, "chapter_id": 11563, "verse_number": "15", "content_sanskrit": "मातरं पितरं भ्रातृÈन् पुत्रांश्च सुहृदः सखीन्। घ्नान्त ह्यसुतृपो लुब्धा राजानः प्रायशो भुवि॥ १०/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50015829, "chapter_id": 11563, "verse_number": "16", "content_sanskrit": "आत्मानमिह सञ्जातं जानन् प्राग् विष्णुना हतम्। महासुरं कालनेमिं यदुभिः स व्यरुध्यत॥ १०/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50015830, "chapter_id": 11563, "verse_number": "17", "content_sanskrit": "उग्रसेनं च पितरं यदुभोजान्धकाधिपम्। स्वयं निगृह्य बुभुजे शूरसेनान् महाबलः॥ १०/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50015831, "chapter_id": 11563, "verse_number": "18", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे द्वितीयोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]