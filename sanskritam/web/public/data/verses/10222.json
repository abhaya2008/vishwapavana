[{"id": 6000222000, "chapter_id": 10222, "verse_number": null, "content_sanskrit": "अथ षड्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000222001, "chapter_id": 10222, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.001.m4a", "display_order": 2}, {"id": 6000222002, "chapter_id": 10222, "verse_number": "१०-२६-१", "content_sanskrit": "एकादश्यां निराहारः समभ्यर्च्य जनार्दनम्।\nस्नातुं नन्दस्तु कालिन्द्या द्वादश्यां जलमाविशत्॥ १०/२६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.002.m4a", "display_order": 3, "topics": [{"text": "वरुणभृत्यानीतस्य नन्दस्य श्रीकृष्णेनानयनम्", "range": "१–९"}]}, {"id": 6000222003, "chapter_id": 10222, "verse_number": "१०-२६-२", "content_sanskrit": "तं गृहीत्वाऽनयद् भृत्यो वरुणस्यासुरोऽन्तिकम्।\nअविज्ञायासुरीं वेलां प्रविष्टमुदकं निशि॥ १०/२६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.003.m4a", "display_order": 4}, {"id": 6000222004, "chapter_id": 10222, "verse_number": "१०-२६-३", "content_sanskrit": "गोपालास्तमपश्यन्तः कृष्ण रामेति चुक्रुशुः।\nभगवांस्तदुपश्रुत्य पितरं वरुणाहृतम्॥ १०/२६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.004.m4a", "display_order": 5}, {"id": 6000222005, "chapter_id": 10222, "verse_number": "१०-२६-४", "content_sanskrit": "तदन्तिकं गतो राजन् स्वानामभयदो विभुः। प्राप्तं वीक्ष्य हृषीकेशं लोकपालः सपर्यया।\nमहत्या पूजयित्वाऽऽह तद्दर्शनमहोत्सवः॥ १०/२६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.005.m4a", "display_order": 6}, {"id": 6000222006, "chapter_id": 10222, "verse_number": null, "content_sanskrit": "वरुण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.006.m4a", "display_order": 7}, {"id": 6000222007, "chapter_id": 10222, "verse_number": "१०-२६-५", "content_sanskrit": "अद्य मे विभृतो देह अद्यार्थोऽधिगतः प्रभो।\nयत्पादभाजो भगवन्नवापुः पारमध्वनः॥ १०/२६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.007.m4a", "display_order": 8}, {"id": 6000222008, "chapter_id": 10222, "verse_number": "१०-२६-६", "content_sanskrit": "नमस्तुभ्यं भगवते ब्रह्मणे परमात्मने।\nन यत्र श्रूयते माया लोकदृष्टिविकल्पना॥ १०/२६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.008.m4a", "display_order": 9}, {"id": 6000222009, "chapter_id": 10222, "verse_number": "१०-२६-७", "content_sanskrit": "अजानता मामकेन मूढेनाकार्यवेदिना।\nआनीतोऽयं तव पिता तत् प्रभो क्षन्तुमर्हसि॥ १०/२६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.009.m4a", "display_order": 10}, {"id": 6000222010, "chapter_id": 10222, "verse_number": "१०-२६-८", "content_sanskrit": "गोविन्द नीयतामेष पिता ते मामकाहृतः।\nममाप्यनुग्रहं कृष्ण कर्तुमर्हस्यशेषदृक्॥ १०/२६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.010.m4a", "display_order": 11}, {"id": 6000222011, "chapter_id": 10222, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.011.m4a", "display_order": 12}, {"id": 6000222012, "chapter_id": 10222, "verse_number": "१०-२६-९", "content_sanskrit": "एवं प्रसादितः कृष्णो भगवानखिलेश्वरः।\nआदायागात् स्वपितरं बन्धूनां चावहन्मुदम्॥ १०/२६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.012.m4a", "display_order": 13}, {"id": 6000222013, "chapter_id": 10222, "verse_number": "१०-२६-१०", "content_sanskrit": "नन्दस्त्वतीन्द्रियं दृष्ट्वा लोकपालमहोदयम्।\nकृष्णे च सन्नतिं तेषां ज्ञातिभ्यो विस्मितोऽब्रवीत्॥ १०/२६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.013.m4a", "display_order": 14, "topics": [{"text": "भगवता गोपेभ्यो वैकुण्ठलोकप्रदर्शनम्", "range": "१०–१७"}]}, {"id": 6000222014, "chapter_id": 10222, "verse_number": "१०-२६-११", "content_sanskrit": "ते त्वौत्सुक्यधियो राजन् मत्वा गोपास्त्वधीश्वरम्।\nअपि नः स्वगतिं सूक्ष्मामुपाधास्यदधीश्वरः॥ १०/२६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.014.m4a", "display_order": 15}, {"id": 6000222015, "chapter_id": 10222, "verse_number": "१०-२६-१२", "content_sanskrit": "इति स्वानां स भगवान् विज्ञायाखिलदृक् स्वयम्।\nसङ्कल्पसिद्धये तेषां कृपयेदमचिन्तयत्॥ १०/२६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.015.m4a", "display_order": 16}, {"id": 6000222016, "chapter_id": 10222, "verse_number": "१०-२६-१३", "content_sanskrit": "जनो वै लोक एतस्मिन्नविद्याकामकर्मभिः।\nउच्चावचासु गतिषु न वेद स्वगतिं भ्रमन्॥ १०/२६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.016.m4a", "display_order": 17}, {"id": 6000222017, "chapter_id": 10222, "verse_number": "१०-२६-१४", "content_sanskrit": "इति सञ्चिन्त्य भगवान् महाकारुणिको विभुः।\nदर्शयामास लोकं स्वं गोपानां तमसः परम्॥ १०/२६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.017.m4a", "display_order": 18}, {"id": 6000222018, "chapter_id": 10222, "verse_number": "१०-२६-१५", "content_sanskrit": "सत्यं ज्ञानमनन्तं यद् ब्रह्म ज्योतिः सनातनम्।\nयद्धि पश्यन्ति मुनयो गुणापाये समाहितम्॥ १०/२६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.018.m4a", "display_order": 19}, {"id": 6000222019, "chapter_id": 10222, "verse_number": "१०-२६-१६", "content_sanskrit": "ते तु ब्रह्मह्रदं नीताः मग्नाः कृष्णमचक्षत।\nददृशुर्ब्रह्मणो लोकं यत्राक्रूरोऽध्यगात् पुरा॥ १०/२६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.019.m4a", "display_order": 20}, {"id": 6000222020, "chapter_id": 10222, "verse_number": "१०-२६-१७", "content_sanskrit": "नन्दादयस्तु तं दृष्ट्वा परमानन्दनिर्वृताः।\nकृष्णं च तत्र छन्दोभिः स्तूयमानं सुविस्मिताः॥ १०/२६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_026/BhP_10.026.020.m4a", "display_order": 21}, {"id": 6000222021, "chapter_id": 10222, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे षड्विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]