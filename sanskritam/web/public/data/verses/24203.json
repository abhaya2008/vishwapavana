[{"id": 7004203000, "chapter_id": 24203, "verse_number": "५-१-५२-१", "content_sanskrit": "सनत्कुमार उवाच॥  ।\nभूयः शृणु महाभाग शिप्रामाहात्म्यमुत्तमम् ।\nयस्य श्रवणमात्रेण हयमेधफलं भवेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004203001, "chapter_id": 24203, "verse_number": "५-१-५२-२", "content_sanskrit": "शिप्रा च सर्वतः पुण्या पवित्रा पापहारिणी ।\nअवंत्यां च विशेषेण शिप्रा चोत्तरवाहिनी॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004203002, "chapter_id": 24203, "verse_number": "५-१-५२-३", "content_sanskrit": "तथापि तत्समुत्पत्तिं विस्तराद्गदतो मम ।\nयथा वाराहतनया विष्णुदेहोद्भवा शिवा ।\nशृणु व्यास महापुण्यां कथां पौराणिकीं शुभाम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004203003, "chapter_id": 24203, "verse_number": "५-१-५२-४", "content_sanskrit": "पुरा महासुरो जातो हिरण्याक्षो महाबलः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004203004, "chapter_id": 24203, "verse_number": "५-१-५२-५", "content_sanskrit": "स चेमां सकलां पृथ्वीं वशीकृत्वा चकार ह ।\nराज्यं च सार्वभौमानां दानवैश्च दुरात्मभिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004203005, "chapter_id": 24203, "verse_number": "५-१-५२-६", "content_sanskrit": "जित्वा च सकलांल्लोकान्सुरानिंद्रपुरोगमान् ।\nदिक्पालान्वसुपालांश्च तिरस्कृत्यसुरा धिपः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004203006, "chapter_id": 24203, "verse_number": "५-१-५२-७", "content_sanskrit": "स सर्वान्सर्वलोकेभ्यः स्वयमेवाधितिष्ठति ।\nस्वर्गान्निराकृताः सर्वे तेन देवगणा भुवि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004203007, "chapter_id": 24203, "verse_number": "५-१-५२-८", "content_sanskrit": "विचरंति यथा मर्त्या भ्रष्टराज्याः पराजिताः ।\nअलब्धशरणाः सर्वे ब्रह्माणं शरणं ययुः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004203008, "chapter_id": 24203, "verse_number": "५-१-५२-९", "content_sanskrit": "तत्र गत्वा नमस्कृत्य दैत्यकृत्यं न्यवेदयन् ।\nभगवन्किमिदं कार्यं भवता परमेष्ठिना॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004203009, "chapter_id": 24203, "verse_number": "५-१-५२-१०", "content_sanskrit": "येन देवगणाः सर्वे नष्टप्रायाश्च तत्क्षणात् ।\nहिरण्याक्षेण दैत्येन हृतं स्वर्गमकण्टकम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004203010, "chapter_id": 24203, "verse_number": "५-१-५२-११", "content_sanskrit": "यज्ञभागांश्च वै सर्वानुपाश्नाति पृथक्पृथक् ।\nकेनोपायेन जीवाम कथं तिष्ठाम भूतले॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004203011, "chapter_id": 24203, "verse_number": "५-१-५२-१२", "content_sanskrit": "इति विक्लवितं तेषां देवानां स पितामहः ।\nउवाच वचनं रम्यं तत्कालसमयोचितम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004203012, "chapter_id": 24203, "verse_number": "५-१-५२-१३", "content_sanskrit": "ब्रह्मोवाच ।\nशृणुध्वं भोः सुरश्रेष्ठा यूयं सर्वे समाहिताः ।\nपुरायं पार्षदश्रेष्ठो द्वारपालः समाहितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004203013, "chapter_id": 24203, "verse_number": "५-१-५२-१४", "content_sanskrit": "वैकुण्ठभवने रम्ये विष्णोरतुलतेजसः ।\nजयोनाम महाबाहुर्विजयेन समन्वितत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004203014, "chapter_id": 24203, "verse_number": "५-१-५२-१५", "content_sanskrit": "द्वावेव सचिवौ दांतौ विष्णुवेषधरावुभौ ।\nआत्तयष्टी च विक्रांतौ द्वारे संतिष्ठतः सदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004203015, "chapter_id": 24203, "verse_number": "५-१-५२-१६", "content_sanskrit": "एकदा वै मुनिश्रेष्ठ ब्रह्मणो मानसात्मजाः ।\nस्वैरं चरंतो लोकानां विष्णोर्भवनमागताः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004203016, "chapter_id": 24203, "verse_number": "५-१-५२-१७", "content_sanskrit": "सनकादयो महाभागा भगवद्दर्शनलालसाः ।\nताभ्यां निवारिताः सर्वे पेतुर्वै धरणीतले॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004203017, "chapter_id": 24203, "verse_number": "५-१-५२-१८", "content_sanskrit": "मुमुहुश्च तदा व्यास कुमारा भृशदुःखिताः ।\nततोऽगात्स महाबाहुर्भगवान्कमलेक्षणः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004203018, "chapter_id": 24203, "verse_number": "५-१-५२-१९", "content_sanskrit": "ददर्श सहसा विष्णुः कुमारान्भुवि दुःखितान् ।\nउत्थाप्यांकं समारोप्य सस्वजे मधुसूदनः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004203019, "chapter_id": 24203, "verse_number": "५-१-५२-२०", "content_sanskrit": "मूर्ध्नि चाघ्राय बाहुभ्यां परिष्वज्य ह्युवाच ह ।\nकस्माद्वः कश्मलमिदं केनापि दुःखिता भृशम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004203020, "chapter_id": 24203, "verse_number": "५-१-५२-२१", "content_sanskrit": "सर्वं तत्कारणं बाला ब्रूत नो धर्मवित्तमाः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004203021, "chapter_id": 24203, "verse_number": "५-१-५२-२२", "content_sanskrit": "कुमारा ऊचुः ।\nश्रूयतां भो महाराज अस्माकं दुःखमीदृशम् ।\nयेन प्राप्ता वयं ब्रह्मन्दशामेतां शृणुष्व ह॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004203022, "chapter_id": 24203, "verse_number": "५-१-५२-२३", "content_sanskrit": "आयाता भ्रातरो ह्येते चत्वारो लोकपर्यटाः ।\nदर्शनार्थं रमानाथ साभिलाषाः शुचार्दिताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004203023, "chapter_id": 24203, "verse_number": "५-१-५२-२४", "content_sanskrit": "निवारिताश्च सहसा ताभ्यां वै द्वारपालनात् ।\nतेनैवेयं दशा प्राप्ता भवता परिपालिताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004203024, "chapter_id": 24203, "verse_number": "५-१-५२-२५", "content_sanskrit": "भगवानुवाच ।\nअतः प्रभृति स्थानेस्मिन्स्थितिर्नास्ति च शाश्वती ।\nएतयोरासुरी योनिः प्राप्स्यते यन्ममाहितौ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004203025, "chapter_id": 24203, "verse_number": "५-१-५२-२६", "content_sanskrit": "सद्यः प्राप्तौ तदा व्यास आसुरीं योनिमेव तौ ।\nजयविजयनामाख्यौ दुष्टभावसमाश्रितौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004203026, "chapter_id": 24203, "verse_number": "५-१-५२-२७", "content_sanskrit": "जन्मांतरसहस्रेण तपोदानसमाधिभिः ।\nनराणां क्षीणपापानां कृष्णे भक्तिः प्रजायते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004203027, "chapter_id": 24203, "verse_number": "५-१-५२-२८", "content_sanskrit": "दुष्टभावेन सद्यो वै जन्मभिर्जायते त्रिभिः ।\nभविष्यति च तस्माद्वो विष्णुभक्तिः परा स्मृता॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004203028, "chapter_id": 24203, "verse_number": "५-१-५२-२९", "content_sanskrit": "जन्मजन्मांतरे जातौ तामसीं योनिमुद्धतौ ।\nहिरण्यकशिपुश्चैव हिरण्याक्षो महाबलः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004203029, "chapter_id": 24203, "verse_number": "५-१-५२-३०", "content_sanskrit": "तथैव कुंभकर्णाख्यो रावणो लोकरावणः ।\nदंत वक्त्रः शिशुपालश्च जन्मत्रयमिति स्मृतम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004203030, "chapter_id": 24203, "verse_number": "५-१-५२-३१", "content_sanskrit": "योऽसौ महाबली दैत्यो हिरण्याक्ष इति स्मृतः ।\nदुष्टभावसमापन्नो देवब्राह्मणनिंदकः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004203031, "chapter_id": 24203, "verse_number": "५-१-५२-३२", "content_sanskrit": "जित्वा च सकलान्देवान्स्वयमेवाधितिष्ठति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004203032, "chapter_id": 24203, "verse_number": "५-१-५२-३३", "content_sanskrit": "स्वर्गान्निराकृताः सर्वे भ्रष्टराज्याः पराजिताः ।\nविचरंति यथा मर्त्यास्तेन देव गणा भुवि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004203033, "chapter_id": 24203, "verse_number": "५-१-५२-३४", "content_sanskrit": "स्वधाकारो वषट्कारः स्वाहाकारो न दृश्यते ।\nदेवपूजार्चनं नास्ति ब्राह्मणानां विशेषतः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004203034, "chapter_id": 24203, "verse_number": "५-१-५२-३५", "content_sanskrit": "नैव तीर्थं प्रकाशेत पुण्यान्यायतनानि च ।\nआश्रमेषु च सर्वेषु ऋषीणां च महात्मनाम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004203035, "chapter_id": 24203, "verse_number": "५-१-५२-३६", "content_sanskrit": "उद्वृत्तं च प्रकुर्वंति दुष्टदैत्याः प्रहारिणः ।\nवर्णाश्रमवतां धर्माः स्त्रीणां चैव सुशीलता॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004203036, "chapter_id": 24203, "verse_number": "५-१-५२-३७", "content_sanskrit": "उच्छिन्ना हि तदा जातास्तस्मिन्राज्ञि दुरात्मनि ।\nदुष्टाचारा दुरात्मानो मायिनो बहुमानिनः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004203037, "chapter_id": 24203, "verse_number": "५-१-५२-३८", "content_sanskrit": "पाखंडिनोऽपरा क्रांताः सर्वे धर्मबहिर्मुखाः ।\nपशुधर्मरताः सर्वे सर्वे ब्रह्मेतिशंसिनः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004203038, "chapter_id": 24203, "verse_number": "५-१-५२-३९", "content_sanskrit": "बहुम्लेच्छा बहुक्लेशा बह्वाबाधावनी कृता ।\nको वेदः का स्मृतिः को यज्ञः का च दक्षिणा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004203039, "chapter_id": 24203, "verse_number": "५-१-५२-४०", "content_sanskrit": "तमीभूतं जगत्सर्वं दृश्यते वसुधातले ।\nएवं व्यास यदा जातं दुष्टं सर्वं जगत्त्रयम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004203040, "chapter_id": 24203, "verse_number": "५-१-५२-४१", "content_sanskrit": "यदा यदा हि धर्मस्य ग्लानिर्भवति भारत ।\nअभ्युत्थानमधर्मस्य तदात्मानं सृजाम्यहम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004203041, "chapter_id": 24203, "verse_number": "५-१-५२-४२", "content_sanskrit": "इति ज्ञात्वा महाविष्णुर्वाराहं वपुरात्मवान् ।\nदधार लीलया दिव्यं श्वेतद्वीपोपमं शुभम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004203042, "chapter_id": 24203, "verse_number": "५-१-५२-४३", "content_sanskrit": "यूपदंष्ट्रो हविर्गंधो बीजौषधितनूरुहः ।\nवेदपादः शुचिर्दंडी जिह्वाग्निस्तालुकाहुतिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004203043, "chapter_id": 24203, "verse_number": "५-१-५२-४४", "content_sanskrit": "अंतरास्यरुचादार्ढो यज्ञकायः सुदक्षिणः ।\nउद्गानघुर्घुरोन्नादो विहार ऋत्विजाकृतिः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004203044, "chapter_id": 24203, "verse_number": "५-१-५२-४५", "content_sanskrit": "हौत्रश्वासपरो दक्षसदस्यावयवः स्मृतः ।\nपुच्छ कर्माशनो नित्यं यजमानसुमानदः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004203045, "chapter_id": 24203, "verse_number": "५-१-५२-४६", "content_sanskrit": "वेदिपल्वलसंस्तारो ब्रह्माध्वर्युर्वनाकरः ।\nलोककल्पो लोकसाक्षी परावरवहः शुचिः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004203046, "chapter_id": 24203, "verse_number": "५-१-५२-४७", "content_sanskrit": "आद्यः पुरुष ईशानः पुरुहूतः पुरुष्टुतः ।\nतेनासौ निहतो दैत्यो हिरण्याक्षो दुरासदः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004203047, "chapter_id": 24203, "verse_number": "५-१-५२-४८", "content_sanskrit": "संग्रामान्सुबहून्कृत्वा बहुकष्टेन विष्णुना ।\nदैत्येन पीडिता पृथ्वी रसातलतलंगता॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004203048, "chapter_id": 24203, "verse_number": "५-१-५२-४९", "content_sanskrit": "उद्धृता च वराहेण दंष्ट्रया चंद्ररेखया ।\nहतास्ते दानवाः सर्वे शेषाः पातालमाययुः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004203049, "chapter_id": 24203, "verse_number": "५-१-५२-५०", "content_sanskrit": "ववुः पुण्यास्तथा वाताः सुप्रभोऽभूद्दिवाकरः ।\nजज्वलुश्चाग्नयः शांताः शांता दिग्जनितस्वनाः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004203050, "chapter_id": 24203, "verse_number": "५-१-५२-५१", "content_sanskrit": "सरितो मार्गवाहिन्यः सागराः प्रकृतिं गतः ।\nदृष्ट्वा देवोऽखिलं व्यास प्रसन्नात्मा बभूव ह॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004203051, "chapter_id": 24203, "verse_number": "५-१-५२-५२", "content_sanskrit": "वाराहमूर्तिर्भगवान्सर्वकामफलप्रदः ।\nआनंदनिर्भरो देवो हतदैत्यो वरप्रदः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004203052, "chapter_id": 24203, "verse_number": "५-१-५२-५३", "content_sanskrit": "तस्यापि हृदयाज्जाता नदी ह्येषा सनातनी ।\nआनंदजलसंपूर्णा सर्वानंदवरप्रदा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004203053, "chapter_id": 24203, "verse_number": "५-१-५२-५४", "content_sanskrit": "बहुयोजनविस्तारा बहुला कामचारिणी ।\nपद्माकरसमाकीर्णा हंसकारण्डसंकुला॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004203054, "chapter_id": 24203, "verse_number": "५-१-५२-५५", "content_sanskrit": "सरला तरलच्छाया यक्षगंधर्वसेविता ।\nकिन्नरीगीयमाना च गीयमाना खगालिभिः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004203055, "chapter_id": 24203, "verse_number": "५-१-५२-५६", "content_sanskrit": "अप्सरोभिर्नृत्यमाना स्तूयमाना महर्षिभिः ।\nहूयमाना हुताग्निभी राजर्षिभिः समाश्रिता॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004203056, "chapter_id": 24203, "verse_number": "५-१-५२-५७", "content_sanskrit": "तुंगस्तनभराक्रांतयोषिद्भिः क्रीडितान्तरा ।\nक्वचित्कीरवरांदोलै रम्यमाणा विराजिता॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004203057, "chapter_id": 24203, "verse_number": "५-१-५२-५८", "content_sanskrit": "वेदविद्भिर्द्विजैः सेव्या ऋषिभिस्संशितात्मभिः ।\nसर्वदा सर्वकाले च सिद्धैः सिद्धिप्रदा नृणाम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004203058, "chapter_id": 24203, "verse_number": "५-१-५२-५९", "content_sanskrit": "महाकालवने रम्ये रम्या पद्मावती पुरी ।\nसुन्दरं कुण्डमपरं रम्यं प्राचीनकं शुभम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004203059, "chapter_id": 24203, "verse_number": "५-१-५२-६०", "content_sanskrit": "यत्र स्नात्वा नरा यांति शिवलोकं सनातनम् ।\nयत्र नीला परा व्यास शिप्रा वै लोकपावनी॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004203060, "chapter_id": 24203, "verse_number": "५-१-५२-६१", "content_sanskrit": "वाराहेण कृतं सर्वं दुष्टदैत्यनिबर्हणम् ।\nतेन देवा निरातंकाः कृता वाराहमूर्तिना॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004203061, "chapter_id": 24203, "verse_number": "५-१-५२-६२", "content_sanskrit": "कृतप्रांजलयः सर्वे देवा इंद्रपुरोगमाः ।\nस्तुतिं कृत्वा महाविष्णोः सततं पुरतः स्थिताः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004203062, "chapter_id": 24203, "verse_number": "५-१-५२-६३", "content_sanskrit": "देवदेव जगन्नाथ पुण्यश्रवणकीर्तन ।\nकिं दानं किं तपः पुण्यं किं तीर्थं का च देवता॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004203063, "chapter_id": 24203, "verse_number": "५-१-५२-६४", "content_sanskrit": "येन पुण्यप्रभावेन पुनः स्वर्गो ह्यवाप्स्यते ।\nएतन्निश्चित्य नो ब्रूहि सर्वं गुह्यतरं विभो॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004203064, "chapter_id": 24203, "verse_number": "५-१-५२-६५", "content_sanskrit": "विष्णुरुवाच ।\nशृणुध्वं भोः सुराः सर्वे युष्माकं सिद्धिकारणम् ।\nगुह्याद्गुह्यतरं पुण्यं महाकालवनं शुभम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004203065, "chapter_id": 24203, "verse_number": "५-१-५२-६६", "content_sanskrit": "मम देहोद्भवा शिप्रा यत्र लीना पयस्विनी ।\nनीलगंगा सरिच्छ्रेष्ठा यत्र प्राची सरस्वती॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004203066, "chapter_id": 24203, "verse_number": "५-१-५२-६७", "content_sanskrit": "पुष्करं च गयातीर्थं पुरुषोत्तमसरः शुभम् ।\nतत्रैव गच्छत क्षिप्र पुनर्लोकानवाप्स्यथ॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004203067, "chapter_id": 24203, "verse_number": "५-१-५२-६८", "content_sanskrit": "इति श्रुत्वा परं वाक्यं देवदेवजगद्गुरोः ।\nतत्र देवगणाः सर्वे ब्रह्मशक्रपुरोगमाः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004203068, "chapter_id": 24203, "verse_number": "५-१-५२-६९", "content_sanskrit": "महाकालवने रम्ये यत्र शिप्रा सरिद्वरा ।\nस्नानदानादिकं कृत्वा श्राद्धं कृत्वा यथोचितम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004203069, "chapter_id": 24203, "verse_number": "५-१-५२-७०", "content_sanskrit": "तेन पुण्यप्रभावेन स्वकांल्लोकान्गताः सुराः ।\nएवं व्यास समाख्याता शिप्रा वै लोकपावनी॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004203070, "chapter_id": 24203, "verse_number": "५-१-५२-७१", "content_sanskrit": "जातं सरो वराहस्य विष्णोरतुलतेजसः ।\nयस्य दर्शनमात्रेण ब्रह्महत्यां व्यपोहति॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004203071, "chapter_id": 24203, "verse_number": "५-१-५२-७२", "content_sanskrit": "अत्र स्नात्वा पयः पीत्वा श्राद्धं कृत्वा यथोचितम् ।\nपयस्विनीं च गां दत्त्वा विष्णुलोके महीयते॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]