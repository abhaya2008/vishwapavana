[{"id": 7002425000, "chapter_id": 22425, "verse_number": "१-८७-१", "content_sanskrit": "ब्रह्मोवाच ।\nजयन्तो ह्युत्तरे ज्ञेयश्चायने गणनायक ।\nवारो देवस्य यः स्याद्वै तत्र पूज्यो दिवाकरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002425001, "chapter_id": 22425, "verse_number": "१-८७-२", "content_sanskrit": "पूजितस्तत्र देवेशः सहस्रगुणितं फलम् ।\nददाति देवशार्दूल स्नानदानादिकर्मणाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002425002, "chapter_id": 22425, "verse_number": "१-८७-३", "content_sanskrit": "घृतेन पयसा यत्र स्नानमिक्षुरसेन तु ।\nविलेपनं कुङ्कुमं तु प्रशस्तं भास्करे प्रियम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002425003, "chapter_id": 22425, "verse_number": "१-८७-४", "content_sanskrit": "धूपक्रिया गुग्गुलेन नैवेद्ये मोदकः स्मृतः ।\nइत्थं सम्पूज्य देवेशं कुर्याद्धोमं ततस्तिलैः ।\nब्राह्मणान्भोजयेत्पश्चान्मोदकांस्तिलशष्कुलीः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002425004, "chapter_id": 22425, "verse_number": "१-८७-५", "content_sanskrit": "इत्थं यः पूजयेद्भानुं मन्त्रेणैव गणाधिप ।\nसहस्रगुणितं तस्य फलं देवो ददाति वै ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002425005, "chapter_id": 22425, "verse_number": "१-८७-६", "content_sanskrit": "स्नानदानजपादीनामुपवासस्य वै विभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]