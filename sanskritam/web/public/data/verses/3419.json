[{"id": 2112102, "chapter_id": 3419, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112103, "chapter_id": 3419, "verse_number": "१", "content_sanskrit": "एवं स शन्तनुर्धीमान् देवराजर्षिसत्कृतः ।\nधर्मात्मा सर्वलोकेषु सत्यवागिति विश्रुतः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112104, "chapter_id": 3419, "verse_number": "२", "content_sanskrit": "शन्तनोः कीर्तयिष्यामि सर्वानेव गुणानहम् ।\nदमो दानं क्षमा बुद्धिः ह्रीर्धृतिस्तेज उत्तमम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112105, "chapter_id": 3419, "verse_number": "३", "content_sanskrit": "नित्यान्यासन् महासत्वे शन्तनौ भरतर्षभ ।\nआमात्यगुणसम्पन्नः क्षत्रधर्मविशेषवित्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112106, "chapter_id": 3419, "verse_number": "४", "content_sanskrit": "आसीद् भरतवंशस्य गोप्ता साधुजनस्य च ।\nकम्बुग्रीवः पृथुव्यंसो मत्तवारणविक्रमः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112107, "chapter_id": 3419, "verse_number": "५", "content_sanskrit": "धर्म एव परः कामादर्थाच्चेति व्यवस्थितः ।\nअन्वितः परिपूर्णार्थैः सर्वैर्नृपतिलक्षणैः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112108, "chapter_id": 3419, "verse_number": "६", "content_sanskrit": "तस्य कीर्तिमथो वृत्तमवेक्ष्य सततं नृपाः ।\nयज्ञदानतपःशीलाः समपद्यन्त वै प्रजाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112109, "chapter_id": 3419, "verse_number": "७", "content_sanskrit": "एवमासीन्महासत्वः शन्तनुर्भरतर्षभ ।\nन चास्य सदृशः कश्चित् क्षत्रियो धर्मतोऽभवत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112110, "chapter_id": 3419, "verse_number": "८", "content_sanskrit": "वर्तमानं च सद्धर्मे सर्वशास्त्रविदांवरम् ।\nतं महीपा महेष्वासं राजराजमकुर्वत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112111, "chapter_id": 3419, "verse_number": "९", "content_sanskrit": "तेन कीर्तिमता शिष्टाः शक्रप्रतिमतेजसा ।\nयज्ञदानतपःशीलाः समपद्यन्त पार्थिवाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112112, "chapter_id": 3419, "verse_number": "१०", "content_sanskrit": "शन्तनुप्रमुखैर्गुप्तं राष्ट्राधिपतिभिर्जगत् ।\nनियमात् सर्ववर्णानां ब्रह्मोत्तरमवर्धत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112113, "chapter_id": 3419, "verse_number": "११", "content_sanskrit": "ब्रह्म पर्यचरत् क्षत्रं विशः क्षत्रमनुव्रताः ।\nब्रह्मक्षत्रानुलोमाश्च शूद्राः पर्यचरन् विशः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112114, "chapter_id": 3419, "verse_number": "१२", "content_sanskrit": "स हस्तिनपुरे रम्ये कुरूणां पुटभेदने ।\nवसन् सागरपर्यन्तामन्वशासद् वसुन्धराम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112115, "chapter_id": 3419, "verse_number": "१३", "content_sanskrit": "स देवराजसदृशो धर्मज्ञः सत्यवागृजुः ।\nदानधर्मतपोयोगात् श्रिया परमया युतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112116, "chapter_id": 3419, "verse_number": "१४", "content_sanskrit": "अरागद्वेषसंयुक्तः सोमवत् प्रियदर्शनः ।\nतेजसा सूर्यसङ्काशो वायुवेगसमो बले \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112117, "chapter_id": 3419, "verse_number": "१५", "content_sanskrit": "अन्तकप्रतिमः कोपे क्षमया पृथिवीसमः ।\nवधः पशुवराहाणां तथैव मृगपक्षिणाम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112118, "chapter_id": 3419, "verse_number": "१६", "content_sanskrit": "शन्तनौ पृथिवीपाले नावर्तत वृथा तदा ।\nधर्मब्रह्मोत्तरे राज्ये शन्तनुर्विनयाश्रयः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112119, "chapter_id": 3419, "verse_number": "१७", "content_sanskrit": "समं शशास भूतानि लोभरागविवर्जितः ।\nचकोरनेत्रस्ताम्रास्यः सिंहर्षभगतिर्युवा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112120, "chapter_id": 3419, "verse_number": "१८", "content_sanskrit": "गुणैरनुपमैर्युक्तः समस्तैरभिगामिकैः ।\nगम्भीरः सत्वसम्पन्नः पूर्णचन्द्रनिभाननः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112121, "chapter_id": 3419, "verse_number": "१९", "content_sanskrit": "देवर्षिपितृयज्ञार्थं बभूवुः पशवो नृणाम् ।\nन ह्मधर्मेण केषां चित् प्राणिनामभवद् वधः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112122, "chapter_id": 3419, "verse_number": "२०", "content_sanskrit": "असुखानामनाथानां तिर्यम्योनिपु वर्तताम् ।\nस एव राजा भूतानां सर्वेषामभवत् पिता \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112123, "chapter_id": 3419, "verse_number": "२१", "content_sanskrit": "वीतशोकभयाबाधाः सुखस्वपप्रबोधनाः ।\nश्रिता भारतभर्तारं समपद्यन्त भूमिपाः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112124, "chapter_id": 3419, "verse_number": "२२", "content_sanskrit": "तस्मिन् नरवरश्रेष्ठे राजराजेश्वरे सति ।\nनृणां वागभवत् सत्यं दानार्थमभवद् धनम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112125, "chapter_id": 3419, "verse_number": "२३", "content_sanskrit": "यज्ञार्थं पशवश्चासन् सन्तानार्थं च मैथुनम् ।\nस समाः षोडशाष्टौ च चतस्रोऽष्टौ तथाऽपराः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112126, "chapter_id": 3419, "verse_number": "२४", "content_sanskrit": "रतिमप्राप्नुवन् काञ्चित् बभूव वनगोचरः ।\nतपसा कर्शितोग्य्रेण जपध्यानपरः सदा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112127, "chapter_id": 3419, "verse_number": "२५", "content_sanskrit": "तथारूपस्तथाचारः तथावृत्तस्तथाश्रुतः ।\nगाङ्गेयस्तस्य पुत्रोऽभूद् आदावेवाष्टमो वसुः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112128, "chapter_id": 3419, "verse_number": "२६", "content_sanskrit": "सर्वशास्त्रेषु निष्णातः पार्थिवेष्वितरेषु च ।\nमहाबलो महावीर्यो महोत्साहो महायशाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112129, "chapter_id": 3419, "verse_number": "२७", "content_sanskrit": "स कदाचिन्मृगान् निघ्नन् गङ्गामनुससार ह ।\nभागीरथीमल्पजलां ददर्श सरितां वराम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112130, "chapter_id": 3419, "verse_number": "२८", "content_sanskrit": "तां दृष्ट्वा चिन्तयामास शन्तनुर्भरतर्षभः ।\nस्यन्दते किन्न्वियं नाद्य सरिच्छ्रेष्ठा यथा पुरा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112131, "chapter_id": 3419, "verse_number": "२९", "content_sanskrit": "ततो निमित्तमन्विच्छन् ददर्श सुमहामनाः ।\nकुमारं रूपसम्पन्नं बृहन्तं प्रियदर्शनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112132, "chapter_id": 3419, "verse_number": "३०", "content_sanskrit": "दिव्यमस्त्रं विकुर्वाणं यथा देवं पुरन्दरम् ।\nकृत्स्नां गङ्गां समावृत्य शरैस्तीक्ष्णैरवस्थितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112133, "chapter_id": 3419, "verse_number": "३१", "content_sanskrit": "तां शरैरावृतां दृष्ट्वा नदीं गङ्गां समन्ततः ।\nविस्मितः प्रेक्षते राजा कर्म तस्यातिमानुषम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112134, "chapter_id": 3419, "verse_number": "३२", "content_sanskrit": "जातमात्रं पुरा दृष्टं तं पुत्रं शन्तनुस्तदा ।\nन ज्ञातवान् महाभागमयं पुत्रो ममेति वै \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112135, "chapter_id": 3419, "verse_number": "३३", "content_sanskrit": "स तु तं पितरं दृष्ट्वा मोहयामास मायया ।\nप्रमोह्य च ततः क्षिप्रं तत्रैवान्तरधीयत \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112136, "chapter_id": 3419, "verse_number": "३४", "content_sanskrit": "तदद्भुतं तदा दृष्ट्वा तत्र राजा स शन्तनुः ।\nशङ्कमानः सुतं गङ्गामब्रवीद् दर्शयेति ताम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112137, "chapter_id": 3419, "verse_number": "३५", "content_sanskrit": "दर्शयामास तं गङ्गा विभ्रती रूपमुत्तमम् ।\nगृहीत्वा दक्षिणे पाणौ तं कुमारमलङ्कृतम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112138, "chapter_id": 3419, "verse_number": "३६", "content_sanskrit": "अलङ्कृतामाभरणैररजोवस्त्रवासिनीम् ।\nदृष्टपुर्वां सतीं गङ्गामभ्यजानात् स शन्तनुः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112139, "chapter_id": 3419, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112140, "chapter_id": 3419, "verse_number": "३७", "content_sanskrit": "यं पुत्रमष्टमं राजंस्त्वं पुरा मय्यविन्दथाः ।\nस तेऽयं पुरुषव्याघ्र वज्रसंहननो युवा \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112141, "chapter_id": 3419, "verse_number": "३८", "content_sanskrit": "वेदानधिजगे पूर्वं वसिष्ठाच्चरितव्रतः ।\nअखिलान् सोपनिषदान् साङ्गोपाङ्गान् यथाविधि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112142, "chapter_id": 3419, "verse_number": "३९", "content_sanskrit": "कृतास्त्रः परमेष्वासो देवराजसमो युघि ।\nसुराणां सम्मतो नित्यमसुराणां च भारत \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112143, "chapter_id": 3419, "verse_number": "४०", "content_sanskrit": "उशना वेद यच्छास्त्रमयं तद् वेद कृत्स्नशः ।\nमहेष्वासमिमं राजन् राजधर्मार्थकोविदम् ।\nमया दत्तमिमं पुत्रं वीरं वीर गृहं नय \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112144, "chapter_id": 3419, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112145, "chapter_id": 3419, "verse_number": "४१", "content_sanskrit": "इत्युक्त्वा सा महाभागा तत्रैवान्तरधीयत ।\nगङ्गया समनुज्ञातः पुत्रमादाय शन्तनुः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112146, "chapter_id": 3419, "verse_number": "४२", "content_sanskrit": "भ्राजमानं यथाऽदित्यं प्रययौ स्वपुरं प्रति ।\nपौरवेषु ततः पुत्रं यौवराज्येऽभ्यषेचयत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112147, "chapter_id": 3419, "verse_number": "४३", "content_sanskrit": "पौरवः स्वपुरं गत्वा पुरन्दरपुरोपमाम् ।\nसर्वकामसमृद्धार्थं मेने चात्मानमात्मना \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112148, "chapter_id": 3419, "verse_number": "४४", "content_sanskrit": "पौरवान् शन्तनोः पुत्रः पितरं च महायशाः ।\nराष्ट्रं च रञ्जयामास वृत्तेन भरतर्षभ \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112149, "chapter_id": 3419, "verse_number": "४५", "content_sanskrit": "तथावृत्तसमाचारस्तथाधर्मस्तथाश्रुतः ।\nपुत्रो देवव्रतो नाम शन्तनोरधिको गुणैः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112150, "chapter_id": 3419, "verse_number": "४६", "content_sanskrit": "सर्वास्त्रेष्वप्यभिरतः पार्थिवेष्वितरेषु च ।\nगुणैर्विशिष्टो बहुभिः पुत्रो देवव्रतोऽभवत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112151, "chapter_id": 3419, "verse_number": "९८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टनवतितमोऽध्यायः॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112152, "chapter_id": 3419, "verse_number": "४६", "content_sanskrit": "॥ इति सम्भवपर्वणि षट्चत्वारिंशोऽध्यायः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112153, "chapter_id": 3419, "verse_number": "", "content_sanskrit": "* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]