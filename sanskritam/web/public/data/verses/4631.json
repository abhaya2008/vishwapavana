[{"id": 2169883, "chapter_id": 4631, "verse_number": "", "content_sanskrit": "कृपेण शिखण्डिनो पराभवः, सुकेतोर्वधश्च । धृष्टद्युम्नेन कृतवर्मणः पराभवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169884, "chapter_id": 4631, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169885, "chapter_id": 4631, "verse_number": "१", "content_sanskrit": "कृतवर्मा कृपो द्रौणिः सूतपुत्रश्च मारिष ।\nउलूकः सौबलश्चैव राजा च सह सोदरैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169886, "chapter_id": 4631, "verse_number": "२", "content_sanskrit": "सीदमानां चमूं दृष्ट्वा पाण्डुपुत्रभयार्दिताम् ।\nअभिसस्रुः स्म वेगेन भिन्नां नावमिवार्णवे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169887, "chapter_id": 4631, "verse_number": "३", "content_sanskrit": "ततो युद्धमतीवासीन्मुहूर्तमिव भारत ।\nभीरूणां त्रासजननं शूराणां हर्षवर्धनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169888, "chapter_id": 4631, "verse_number": "४", "content_sanskrit": "कृपेण शरवर्षाणि विप्रमुक्तानि संयुगे ।\nसृञ्जयांश्छादयामासुः शलभानां व्रजा इव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169889, "chapter_id": 4631, "verse_number": "५", "content_sanskrit": "शिखण्डी तु ततः क्रुद्धो गौतमं त्वरितो ययौ ।\nववर्ष शरवर्षाणि समन्तादेव ब्राह्मणे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169890, "chapter_id": 4631, "verse_number": "६", "content_sanskrit": "कृपस्तु शरवर्षं तद् विनिहत्य महास्त्रवित् ।\nशिखण्डिनं रणे क्रुद्धो विव्याध दशभिः शरैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169891, "chapter_id": 4631, "verse_number": "७", "content_sanskrit": "ततः शिखण्डी कुपितः शरैः सप्तभिराहवे ।\nकृपं विव्याध सुभृशं कङ्कपत्रैरजिह्मगैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169892, "chapter_id": 4631, "verse_number": "८", "content_sanskrit": "ततः कृपः शरैस्तीक्ष्णैः सोऽतिविद्धो महारथः ।\nव्यश्वसूतरथं चक्रे शिखण्डिनमथो द्विजः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169893, "chapter_id": 4631, "verse_number": "९", "content_sanskrit": "हताश्वात्तु ततो यानादवप्लुत्य महारथः ।\nखड्गं चर्म तथा गृह्य सत्वरं ब्राह्मणं ययौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169894, "chapter_id": 4631, "verse_number": "१०", "content_sanskrit": "तमापतन्तं सहसा शरैः सन्नतपर्वभिः ।\nछादयामास समरे तदद्भुतमिवाभवत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169895, "chapter_id": 4631, "verse_number": "११", "content_sanskrit": "तत्राद्भुतमपश्याम शिलानां प्लवनं यथा ।\nनिश्चेष्टो यद् रणे राजन् शिखण्डी समतिष्ठत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169896, "chapter_id": 4631, "verse_number": "१२", "content_sanskrit": "कृपेण छादितं दृष्ट्वा नृपोत्तम शिखण्डिनम् ।\nप्रत्युद्ययौ कृपं तूर्णं धृष्टद्युम्नो महारथः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169897, "chapter_id": 4631, "verse_number": "१३", "content_sanskrit": "धृष्टद्युम्नं ततो यान्तं शारद्वतरथं प्रति ।\nप्रतिजग्राह वेगेन कृतवर्मा महारथः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169898, "chapter_id": 4631, "verse_number": "१४", "content_sanskrit": "युधिष्ठिरमथायान्तं शारद्वतरथं प्रति ।\nसपुत्रं सहसेनं च द्रोणपुत्रो न्यवारयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169899, "chapter_id": 4631, "verse_number": "१५", "content_sanskrit": "नकुलं सहदेवं च त्वरमाणौ महारथौ ।\nप्रतिजग्राह ते पुत्रः शरवर्षेण वारयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169900, "chapter_id": 4631, "verse_number": "१६", "content_sanskrit": "भीमसेनं करूषांश्च केकयान् सहसृञ्जयान् ।\nकर्णो वैकर्तनो युद्धे वारयामास भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169901, "chapter_id": 4631, "verse_number": "१७", "content_sanskrit": "शिखण्डिने ततो बाणान् कृपः शारद्वतो युधि ।\nप्राहिणोत् त्वरया युक्तो दिधक्षुरिव मारिष\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169902, "chapter_id": 4631, "verse_number": "१८", "content_sanskrit": "तान् शरान् प्रेषितांस्तेन समन्ताद् स्वर्णभूषितान् ।\nचिच्छेद खड्गमाविध्य भ्रामयंश्च पुनः पुनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169903, "chapter_id": 4631, "verse_number": "१९", "content_sanskrit": "शतचन्द्रं ततश्चर्म गौतमः पार्षतस्य ह ।\nव्यधमत् सायकैस्तूर्णं तत उच्चक्रुशुर्जनाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169904, "chapter_id": 4631, "verse_number": "२०", "content_sanskrit": "स विचर्मा महाराज खड्गपाणिरुपाद्रवत् ।\nकृपस्य वशमापन्नो मृत्योरास्यमिवातुरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169905, "chapter_id": 4631, "verse_number": "२१", "content_sanskrit": "शारद्वतशरैर्ग्रस्तं क्लिश्यमानं महाबलम् ।\nचित्रकेतुसुतो दृष्ट्वा सुकेतुस्त्वरितो ययौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169906, "chapter_id": 4631, "verse_number": "२२", "content_sanskrit": "विकिरन् ब्राह्मणं युद्धे बहुभिर्निशितैः शरैः ।\nअभ्यापतदमेयात्मा गौतमस्य रथं प्रति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169907, "chapter_id": 4631, "verse_number": "२३", "content_sanskrit": "दृष्ट्वाविषह्यं तं युद्धे ब्राह्मणं चरितव्रतम् ।\nअपयातस्ततस्तूर्णं शिखण्डी राजसत्तम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169908, "chapter_id": 4631, "verse_number": "२४", "content_sanskrit": "सुकेतुस्तु ततो राजन् गौतमं नवभिः शरैः ।\nविद्ध्वा विव्याध सप्तत्या पुनश्चैनं त्रिभिः शरैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169909, "chapter_id": 4631, "verse_number": "२५", "content_sanskrit": "अथास्य सशरं चापं पुनश्चिच्छेद मारिष ।\nसारथिं च शरेणास्य भृशं मर्मण्यताडयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169910, "chapter_id": 4631, "verse_number": "२६", "content_sanskrit": "गौतमस्तु ततः क्रुद्धो धनुर्गृह्य नवं दृढम् ।\nसुकेतुं त्रिंशता बाणैः सर्वमर्मस्वताडयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169911, "chapter_id": 4631, "verse_number": "२७", "content_sanskrit": "स विह्वलितसर्वाङ्गः प्रचचाल रथोत्तमे ।\nभूमिचाले यथा वृक्षः कम्पते वै समन्ततः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169912, "chapter_id": 4631, "verse_number": "२८", "content_sanskrit": "चलतस्तस्य कायात्तु शिरो ज्वलितकुण्डलम् ।\nसोष्णीषं सशिरस्त्राणं क्षुरप्रेणान्वपातयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169913, "chapter_id": 4631, "verse_number": "२९", "content_sanskrit": "तच्छिरः प्रापतद् भूमौ श्येनाहृतमिवामिषम् ।\nततोऽस्य कायो वसुधां पश्चात् प्राप तदा च्युतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169914, "chapter_id": 4631, "verse_number": "३०", "content_sanskrit": "तस्मिन् हते महाराज त्रस्तास्तस्य पदानुगाः ।\nगौतमं समरे त्यक्त्वा दुद्रुवुस्ते दिशो दश\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169915, "chapter_id": 4631, "verse_number": "३१", "content_sanskrit": "धृष्टद्युम्नं तु समरे सन्निवार्य महाबलः ।\nकृतवर्माब्रवीद्धृष्टस्तिष्ठ तिष्ठेति पार्षतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169916, "chapter_id": 4631, "verse_number": "३२", "content_sanskrit": "तदभूत् तुमुलं युद्धं वृष्णिपार्षतयो रणे ।\nआमिषार्थे यथा युद्धं क्रुद्धयोर्गृद्धयोर्यथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169917, "chapter_id": 4631, "verse_number": "३३", "content_sanskrit": "धृष्टद्युम्नस्तु समरे हार्दिक्यं नवभिः शरैः ।\nआजघानोरसि क्रुद्धः पीडयन् हृदिकात्मजम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169918, "chapter_id": 4631, "verse_number": "३४", "content_sanskrit": "कृतवर्मा तु समरे पार्षतेन दृढाहतः ।\nपार्षतं सरथं साश्वं छादयामास सायकैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169919, "chapter_id": 4631, "verse_number": "३५", "content_sanskrit": "सरथश्छादितो राजन् धृष्टद्युम्नो न दृश्यते ।\nमेघैरिव परिच्छन्नो भास्करो जलधारिभिः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169920, "chapter_id": 4631, "verse_number": "३६", "content_sanskrit": "विधूय तं बाणगणं शरैः कनकभूषणैः ।\nव्यरोचत रणे राजन् धृष्टद्युम्नः कृतव्रणः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169921, "chapter_id": 4631, "verse_number": "३७", "content_sanskrit": "ततस्तु पार्षतः क्रुद्धः शस्त्रवृष्टिं सुदारुणाम् ।\nकृतवर्माणमासाद्य व्यसृजत् पृतनापतिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169922, "chapter_id": 4631, "verse_number": "३८", "content_sanskrit": "तामापतन्तीं सहसा शस्त्रवृष्टिं सुदारुणाम् ।\nशरैरनेकसाहस्रैर्हार्दिक्यो व्यधमद् युधि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169923, "chapter_id": 4631, "verse_number": "३९", "content_sanskrit": "दृष्ट्वा तु दारितां युद्धे शरवृष्टिं सुदारुणाम् ।\nकृतवर्माणमभ्येत्य वारयामास पार्षतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169924, "chapter_id": 4631, "verse_number": "४०", "content_sanskrit": "सारथिं चास्य तरसा प्राहिणोद् यमसादनम् ।\nभल्लेन शितधारेण स हतः प्रापतद् रथात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169925, "chapter_id": 4631, "verse_number": "४१", "content_sanskrit": "गदां गृह्य पुनर्वेगात् कृतवर्माणमाहनत् ।\nसोऽतिविद्धो बलवता न्यपतन् मूर्च्छया हतः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169926, "chapter_id": 4631, "verse_number": "४२", "content_sanskrit": "ततो राजन् महेष्वासं कृतवर्माणमाशु वै ।\nसुपर्वा रथमारोप्य अपोवाह रणाजिरात्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169927, "chapter_id": 4631, "verse_number": "४३", "content_sanskrit": "धृष्टद्युम्नस्तु बलवान् जित्वा शत्रुं महारथम् ।\nकौरवान् समरे तूर्णं वारयामास पत्रिभिः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169928, "chapter_id": 4631, "verse_number": "४४", "content_sanskrit": "ततस्ते तावका योधा धृष्टद्युम्नमुपाद्रवन् ।\nसिंहनादरवं कृत्वा ततो युद्धमवर्तत\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169929, "chapter_id": 4631, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nकृतवर्मपराजयो नाम एकपञ्चाशोऽध्यायः ॥५१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]