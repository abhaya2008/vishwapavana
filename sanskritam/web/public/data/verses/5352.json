[{"id": 2204181, "chapter_id": 5352, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश मानुषेष्वेव केचन ।\nज्ञानविज्ञानसम्पन्ना बुद्धिमन्तो विचक्षणाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204182, "chapter_id": 5352, "verse_number": "२", "content_sanskrit": "दुर्गतास्तु प्रदृश्यन्ते यतमाना यथाविधि ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204183, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204184, "chapter_id": 5352, "verse_number": "३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204185, "chapter_id": 5352, "verse_number": "४", "content_sanskrit": "ये पुरा मनुजा देवि श्रुतवन्तोऽपि केवलम् ।\nनिराश्रया निरन्नाद्या भृशमात्मपरायणाः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204186, "chapter_id": 5352, "verse_number": "५", "content_sanskrit": "ते पुनर्जन्मनि शुभे ज्ञानबुद्धियुता अपि ।\nनिष्किञ्चना भवन्त्येव अनुप्तं हि न रोहति\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204187, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204188, "chapter_id": 5352, "verse_number": "६", "content_sanskrit": "मूर्खा लोके प्रदृश्यन्ते वृथा मूढा विचेतसः ।\nज्ञानविज्ञानरहिताः समृद्धाश्च समन्ततः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204189, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204190, "chapter_id": 5352, "verse_number": "७", "content_sanskrit": "ये पुरा मनुजा देवि बालिशा अपि सर्वतः ।\nसमाचरन्ति दानानि दीनानुग्रहकारणात्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204191, "chapter_id": 5352, "verse_number": "८", "content_sanskrit": "अबुद्धिपूर्वं वा दानं ददत्येव यतस्ततः ।\nते पुनर्जन्मनि शुभे प्राप्नुवन्त्येव तत्तथा\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204192, "chapter_id": 5352, "verse_number": "९", "content_sanskrit": "पण्डितोऽपण्डितो वाऽपि भुङ्क्ते दानफलं नरः ।\nबुद्ध्याऽनपेक्षितं दानं सर्वथा तत्फलत्युत\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204193, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204194, "chapter_id": 5352, "verse_number": "१०", "content_sanskrit": "भगवन् देवदेवेश मानुषेष्वेव केचन ।\nमेधाविनः श्रुतधरा भवन्ति विशदाक्षराः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204195, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204196, "chapter_id": 5352, "verse_number": "११", "content_sanskrit": "ये पुरा मनुजा देवि गुरुशुश्रूषका भृशम् ।\nज्ञानार्थं ते तु सङ्गृह्य तीर्थतो विधिपूर्वकम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204197, "chapter_id": 5352, "verse_number": "१२", "content_sanskrit": "विधिनैव परांश्चैव ग्राहयन्ति च नान्यथा ।\nअश्लाघमाना ज्ञानेन प्रशान्ता यतवाचकाः ।\nविद्यास्थानानि ये लोके स्थापयन्ति च यत्नतः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204198, "chapter_id": 5352, "verse_number": "१३", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने ।\nमेधाविनः श्रुतधरा भवन्ति विशदाक्षराः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204199, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204200, "chapter_id": 5352, "verse_number": "१४", "content_sanskrit": "अपरे मानुषा देव यतन्तोऽपि यतस्ततः ।\nबहिष्कृताः प्रदृश्यन्ते श्रुतविज्ञानबुद्धिभिः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204201, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204202, "chapter_id": 5352, "verse_number": "१५", "content_sanskrit": "ये पुरा मनुजा देवि ज्ञानदर्पसमन्विताः ।\nश्लाघमानाश्च तत् प्राप्य ज्ञानाहङ्कारमोहिताः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204203, "chapter_id": 5352, "verse_number": "१६", "content_sanskrit": "तपन्ति ये परान् नित्यं ज्ञानाधिक्येन दर्पिताः ।\nज्ञानादसूयां कुर्वन्ति न सहन्त्येव चापरान्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204204, "chapter_id": 5352, "verse_number": "१७", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने ।\nमानुष्यं सुचिरात् प्राप्य तत्र बोधविवर्जिताः ।\nभवन्ति सततं देवि विवर्णवचनास्तथा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204205, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204206, "chapter_id": 5352, "verse_number": "१८", "content_sanskrit": "भगवन् मानुषाः केचित् सर्वकल्याणसंयुताः ।\nपुत्रैर्दारैर्गुणयुतैर्दासीदासपरिच्छदैः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204207, "chapter_id": 5352, "verse_number": "१९", "content_sanskrit": "परस्परर्द्धिसंयुक्ताः स्थानैश्वर्यपरिग्रहैः ।\nव्याधिहीना निराबाधा रूपारोग्यबलैर्युताः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204208, "chapter_id": 5352, "verse_number": "२०", "content_sanskrit": "धनधान्येन सम्पन्नाः प्रासादैर्यानवाहनैः ।\nसर्वोपभोगसंयुक्ता नानाचित्रैर्मनोहरैः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204209, "chapter_id": 5352, "verse_number": "२१", "content_sanskrit": "ज्ञातिभिः सह मोदन्ते अविघ्नं तु दिनेदिने ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204210, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204211, "chapter_id": 5352, "verse_number": "२२", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु सर्वं समाहिता\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204212, "chapter_id": 5352, "verse_number": "२३", "content_sanskrit": "ये पुरा मनुजा देवि आढ्या वा इतरेऽपि वा ।\nश्रुतवृत्तसमायुक्ता दानधर्मगताश्च ये\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204213, "chapter_id": 5352, "verse_number": "२४", "content_sanskrit": "परेङ्गितपरा नित्यं दातव्यमिति निश्चिताः ।\nसत्यसन्धाः क्षमाशीला लोभमोहविवर्जिताः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204214, "chapter_id": 5352, "verse_number": "२५", "content_sanskrit": "दातारः पात्रतो दानं व्रतैर्नियमसंयुताः ।\nस्वदुःखमिव संस्मृत्य परदुःखं महात्मनः ।\nसौम्यशीलाः शुभाचारा देवब्राह्मणपूजकाः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204215, "chapter_id": 5352, "verse_number": "२६", "content_sanskrit": "एवं युक्तसमाचाराः पुनर्जन्मनि शोभने ।\nदिवि वा भुवि वा देवि जायन्ते कर्मभोगिनः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204216, "chapter_id": 5352, "verse_number": "२७", "content_sanskrit": "मानुषेष्वपि ये जातास्तादृशाः सम्भवन्ति ते ।\nयादृशास्तु तथा प्रोक्ताः सर्वे कल्याणसंयुताः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204217, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "रूपं द्रव्यं बलं चायुर्भोगैश्वर्यं कुलं श्रुतम् ।\nइत्येतत्सर्वसाद्गुण्यं दानाद् भवति नान्यथा ।\nतपोदानमयं सर्वमिति विद्धि शुभानने\t ॥२८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204218, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204219, "chapter_id": 5352, "verse_number": "२९", "content_sanskrit": "अथ केचित्प्रदृश्यन्ते मानुषेष्वेव मानुषाः ।\nदुर्गताः क्लेशभूयिष्ठा दानभोगविवर्जिताः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204220, "chapter_id": 5352, "verse_number": "३०", "content_sanskrit": "भयैस्त्रिभिः समाजुष्टा व्याधिक्षुद्भयपीडिताः ।\nदुष्कळत्राभिभूताश्च सततं विघ्नदर्शकाः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204221, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204222, "chapter_id": 5352, "verse_number": "३१", "content_sanskrit": "ये पुरा मनुजा देवि आसुरं भावमाश्रिताः ।\nक्रोधलोभरता नित्यं दानधर्मगताश्च ये\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204223, "chapter_id": 5352, "verse_number": "३२", "content_sanskrit": "नास्तिकाश्चैव धूर्ताश्च मूर्खाश्चात्मपरायणाः ।\nपरोपतापिनो देवि प्रायशः प्राणिनिर्दयाः\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204224, "chapter_id": 5352, "verse_number": "३३", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nकथञ्चित् प्राप्य मानुष्यं तत्र ते दुःखपीडिताः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204225, "chapter_id": 5352, "verse_number": "३४", "content_sanskrit": "सर्वतः सम्भवन्त्येव पूर्वमात्मप्रमादतः ।\nयथा ते पूर्वकथितं तया ते सम्भवन्त्युत\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204226, "chapter_id": 5352, "verse_number": "३५", "content_sanskrit": "शुभाशुभं कृतं कर्म सुखदुःखफलोदयम् ।\nइति ते कथितं देवि किं भूयः श्रोतुमिच्छसि\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204227, "chapter_id": 5352, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे मानुषवैचित्र्यकथनं नाम त्र्यधिकद्विशततमोऽध्यायः ॥२०३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]