[{"id": 7003621000, "chapter_id": 23621, "verse_number": "१-२-८-१", "content_sanskrit": "नारद उवाच ।\nनाडीजंघबकेनोक्तां वाचमाकर्ण्यभूपतिः ।\nमार्कंडेयेन संयुक्तो बभूवातीव दुःखितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003621001, "chapter_id": 23621, "verse_number": "१-२-८-२", "content_sanskrit": "तं निशम्य मुनिर्भूपं दुःखितं साश्रुलोचनम् ।\nसमानव्यसनः प्राह तदर्थं स पुनर्बकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003621002, "chapter_id": 23621, "verse_number": "१-२-८-३", "content_sanskrit": "विधायाशां महाभाग त्वदंतिकमुपागतौ ।\nआवां चिरायुर्ज्ञातांशाविन्द्रद्युम्नमिति द्विज ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003621003, "chapter_id": 23621, "verse_number": "१-२-८-४", "content_sanskrit": "निष्पन्नं नास्य तत्कार्यं प्राणानेष मुमुक्षति ।\nवह्निप्रवेशेन परं वैराग्यं समुपागतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003621004, "chapter_id": 23621, "verse_number": "१-२-८-५", "content_sanskrit": "तन्मामुपागतोऽहं च त्वां सिद्धं नास्य वांछितम् ।\nतदेनमनुयास्यामि मरणेन त्वया शपे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003621005, "chapter_id": 23621, "verse_number": "१-२-८-६", "content_sanskrit": "आशां कृत्वाभ्युपायातं निराशं नेक्षितुं क्षमाः ।\nभवंति साधवस्तस्माज्जीवितान्मरणं वरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003621006, "chapter_id": 23621, "verse_number": "१-२-८-७", "content_sanskrit": "प्रार्थितं चामुना हृत्स्थं मया चास्मै प्रतिश्रुतम् ।\nत्वां मित्रं तत्परिज्ञाने धृत्वा हृदि चिरायुषम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003621007, "chapter_id": 23621, "verse_number": "१-२-८-८", "content_sanskrit": "असंपादयतो नार्थं प्रतिज्ञातं ममायुषा ।\nकलुषेणार्थिना माशापूरकेण सखेधुना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003621008, "chapter_id": 23621, "verse_number": "१-२-८-९", "content_sanskrit": "प्रतिश्रुतं कृतं श्लाघ्या दासतांत्यजपक्वणे ।\nहरिश्चंद्रस्येव नृणां न श्लाघ्या सत्यसंधता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003621009, "chapter_id": 23621, "verse_number": "१-२-८-१०", "content_sanskrit": "मित्रस्नेहस्य पर्यायस्तच्च साप्तपदं स्मृतम् ।\nस्नेहः स कीदृशो मित्रे दुःखितो यो न दृश्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003621010, "chapter_id": 23621, "verse_number": "१-२-८-११", "content_sanskrit": "तदवश्यमहं साकमधुना वह्निसाधनम् ।\nकरिष्ये कीर्तिवपुषः कृते सत्यमिदं सखे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003621011, "chapter_id": 23621, "verse_number": "१-२-८-१२", "content_sanskrit": "अनुजानीहि मामेतद्दर्शनं तव पश्चिमम् ।\nत्वया सह महाभाग नाडीजंघ द्विजोत्तम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003621012, "chapter_id": 23621, "verse_number": "१-२-८-१३", "content_sanskrit": "नारद उवाच ।\nवज्रवद्दुःसहां वाचं मार्कंडेयसमीरिताम् ।\nशुश्रुवान्स क्षणं ध्यात्वा प्रतीतः प्राह तावुभौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003621013, "chapter_id": 23621, "verse_number": "१-२-८-१४", "content_sanskrit": "नाडीजंघ उवाच ।\nयद्येवं तदिदं मित्रं विशंतं ज्वलनेऽधुना ।\nनिवारय मुनिश्रेष्ठ मत्तोऽस्ति चिरजीवितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003621014, "chapter_id": 23621, "verse_number": "१-२-८-१५", "content_sanskrit": "प्राकारकर्णनामासावुलूकः शिवपर्वते ।\nस ज्ञास्यति महीपालमिंद्रद्युम्नं न संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003621015, "chapter_id": 23621, "verse_number": "१-२-८-१६", "content_sanskrit": "तस्मादहं त्वया सार्धममुना च शिवालयम् ।\nव्रजामि तं शिखरिणं मित्रकार्यप्रसिद्धये ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003621016, "chapter_id": 23621, "verse_number": "१-२-८-१७", "content_sanskrit": "इत्येव मुक्त्वा ते जग्मुस्त्रयोऽपि द्विजपुंगवाः ।\nकैलासं ददृशुस्तत्र तमुलूकं स्वनीडगम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003621017, "chapter_id": 23621, "verse_number": "१-२-८-१८", "content_sanskrit": "कृतसंविदसौ तेन बकः स्वागतपूजया ।\nपृष्टश्च तावुभौ प्राह तत्सर्वमभिवांछितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003621018, "chapter_id": 23621, "verse_number": "१-२-८-१९", "content_sanskrit": "चिरायुरसि जानीषे यदीन्द्रद्युम्नभूपतिम् ।\nतद्ब्रूहि तेन ज्ञानेन कार्यं जीवामहे वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003621019, "chapter_id": 23621, "verse_number": "१-२-८-२०", "content_sanskrit": "इति पृष्टः स विमना मित्रकार्यप्रसाधनात् ।\nकौशिकः प्राह जानामि नेन्द्रद्युम्नमहं नृपम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003621020, "chapter_id": 23621, "verse_number": "१-२-८-२१", "content_sanskrit": "अष्टाविंशत्प्रमाणा मे कल्पा जातस्य भूतले ।\nन दृष्टो न श्रुतो वासाविंद्रद्युम्नो नृपः क्षितौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003621021, "chapter_id": 23621, "verse_number": "१-२-८-२२", "content_sanskrit": "तच्छ्रुत्वा विस्मितो भूपस्तस्यायुरतिमात्रतः ।\nदुःखितोऽपि तदा हेतुं पप्रच्छासौ तदायुषः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003621022, "chapter_id": 23621, "verse_number": "१-२-८-२३", "content_sanskrit": "एवमायुर्यदि तव कथं प्राप्तं ब्रवीहि तत् ।\nउलूकत्वं कथमिदं जुगुप्सितमतीव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003621023, "chapter_id": 23621, "verse_number": "१-२-८-२४", "content_sanskrit": "प्राकारकर्ण उवाच ।\nश्रृणु भद्र यथा दीर्घमायुर्मेशिवपूजनात् ।\nजुगुप्सितमुलूकत्वं शापेन च महामुनेः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003621024, "chapter_id": 23621, "verse_number": "१-२-८-२५", "content_sanskrit": "वसिष्ठकुलसंभूतः पुराहमभवं द्विजः ।\nघंट इत्यभिविख्यातो वाराणस्यां शिवेरतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003621025, "chapter_id": 23621, "verse_number": "१-२-८-२६", "content_sanskrit": "धर्मश्रवणनिष्ठस्य साधूनां संसदि स्वयम् ।\nश्रुत्वास्मि पूजयामीशं बिल्वपत्रैरखंडितैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003621026, "chapter_id": 23621, "verse_number": "१-२-८-२७", "content_sanskrit": "न मालती न मंदारः शतपत्रं न मल्लिका ।\nतथा प्रियाणि श्रीवृक्षो यथा मदनविद्विषः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003621027, "chapter_id": 23621, "verse_number": "१-२-८-२८", "content_sanskrit": "अखंडबिल्वपत्रेण एकेन शिवमूर्धनि ।\nनिहितेन नरैः पुण्यं प्राप्यते लक्षपुष्पजम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003621028, "chapter_id": 23621, "verse_number": "१-२-८-२९", "content_sanskrit": "अखंडितैर्बिल्वपत्रैः श्रद्धया स्वयमाहृतैः ।\nलिंगप्रपूजनं कृत्वा वर्षलक्षं वसेद्दिवि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003621029, "chapter_id": 23621, "verse_number": "१-२-८-३०", "content_sanskrit": "सच्छास्त्रेभ्य इति श्रुत्वा पूजयाम्यहमीश्वरम् ।\nत्रिकालं श्रद्धया पत्रैः श्रीवृक्षस्य त्रिभिस्त्रिभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003621030, "chapter_id": 23621, "verse_number": "१-२-८-३१", "content_sanskrit": "ततो वर्षशतस्यांते तुतोष शशिशेखरः ।\nप्रत्यक्षीभूय मामाह मेघगंभीरया गिरा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003621031, "chapter_id": 23621, "verse_number": "१-२-८-३२", "content_sanskrit": "ईश्वर उवाच ।\nतुष्टोस्मि तव विप्रेंद्राखंडबिल्वदलार्चनात् ।\nवृणीष्वाभिमतं यत्ते दास्यम्यपि च दुर्लभम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003621032, "chapter_id": 23621, "verse_number": "१-२-८-३३", "content_sanskrit": "अखंडबिल्वपत्रेण महातुष्टिः प्रजायते ।\nएकनापि यथान्येषां तथा न मम कोटिभिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003621033, "chapter_id": 23621, "verse_number": "१-२-८-३४", "content_sanskrit": "इत्युक्तोऽहं भगवता शंभुना स्वमनः स्थितम् ।\nवृणोमि स्म वरं देव कुरु मामजरामरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003621034, "chapter_id": 23621, "verse_number": "१-२-८-३५", "content_sanskrit": "अथ लीलाविलासो मां तथेत्युक्त्वाऽविचारितम् ।\nययावदर्शनं प्रीतिमहं च महतीं गतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003621035, "chapter_id": 23621, "verse_number": "१-२-८-३६", "content_sanskrit": "कृतकृत्यं तदात्मानमज्ञासिपमहं क्षितौ ।\nएतस्मिन्नेव काले तु भृगुवंश्योऽभवद्द्विजः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003621036, "chapter_id": 23621, "verse_number": "१-२-८-३७", "content_sanskrit": "अवदातत्रिजन्मासवक्षविच्चाक्षरार्थवित् ।\nसुदर्शनेति प्रथिता प्रिया तस्याभवत्सती ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003621037, "chapter_id": 23621, "verse_number": "१-२-८-३८", "content_sanskrit": "अतीव मुदिता पत्युर्मुखं प्रेक्ष्यास्य दर्शनात् ।\nतनया देवलस्यैपा रूपेणाप्रतिमा भुवि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003621038, "chapter_id": 23621, "verse_number": "१-२-८-३९", "content_sanskrit": "तस्यां तस्मादभूत्कन्या निर्विशेषा निजारणेः ।\nनिवृत्तबालभावाभूत्कुमारी यौवनोन्मुखी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003621039, "chapter_id": 23621, "verse_number": "१-२-८-४०", "content_sanskrit": "नालं बभूव तां दातुं तनयां गुणशालिनीम् ।\nकस्यापि जनकः सा च वयःसंधौ मयेक्षिता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003621040, "chapter_id": 23621, "verse_number": "१-२-८-४१", "content_sanskrit": "प्रविश्द्यौवनाभोगभावैरतिमनोहरा ।\nनिर्वास्यमानैरपरैस्तिलतंदुलिताकृतिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003621041, "chapter_id": 23621, "verse_number": "१-२-८-४२", "content_sanskrit": "क्रीडमाना वयस्याभिर्लावण्यप्रतिमेव सा ।\nव्यचिंतयमहं विप्र तां निरीक्ष्य सुमध्यमाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003621042, "chapter_id": 23621, "verse_number": "१-२-८-४३", "content_sanskrit": "अनन्याकृतिमन्योऽसौ विधिर्येनेति निर्मिता ।\nततः सात्त्विकभावानां तत्क्षणादस्मि गोचरम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003621043, "chapter_id": 23621, "verse_number": "१-२-८-४४", "content_sanskrit": "प्रापितो लीलयाहत्य बाणैः कुसुमधन्विना ।\nततो मया स्खलद्वालं पृष्टा कस्येति तत्सखी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003621044, "chapter_id": 23621, "verse_number": "१-२-८-४५", "content_sanskrit": "प्राहेति भृगुवंश्यस्य कन्येयं द्विजजन्मनः ।\nअनूढाद्यापि केनापि समायातात्र खेलितुम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003621045, "chapter_id": 23621, "verse_number": "१-२-८-४६", "content_sanskrit": "ततः कुसुमबाणेन शरव्रातैर्भृशं हतः ।\nपितरं प्रणतो गत्वा ययाचे तां भृगूद्वहम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003621046, "chapter_id": 23621, "verse_number": "१-२-८-४७", "content_sanskrit": "स च मां सदृशं ज्ञात्वा शीलेन च कुलेन च ।\nअतीव चार्थिनं मह्यं ददौ वाचा पुरः क्रमात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003621047, "chapter_id": 23621, "verse_number": "१-२-८-४८", "content_sanskrit": "ततः सा तनया तस्य भार्गवस्या श्रृणोदिति ।\nदत्तास्मि तस्मै विप्राय विरूपायेति जल्पताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003621048, "chapter_id": 23621, "verse_number": "१-२-८-४९", "content_sanskrit": "रोरूयमाणा जननीमाह पश्य यथा कृतम् ।\nअतीवानुचितं दत्त्वा जनकेन तथा वरे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003621049, "chapter_id": 23621, "verse_number": "१-२-८-५०", "content_sanskrit": "विषमालोड्य पास्यामि प्रवेक्ष्यामि हुताशनम् ।\nवरं न तु विरूपस्योद्वोढुर्भार्या कथंचन ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003621050, "chapter_id": 23621, "verse_number": "१-२-८-५१", "content_sanskrit": "ततः संबोध्य जननी तां सुतामाह भार्गवम् ।\nन देयास्मै त्वया कन्या विरूपायेति चाग्रहात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003621051, "chapter_id": 23621, "verse_number": "१-२-८-५२", "content_sanskrit": "स वल्लभावचः श्रुत्वा धर्मशास्त्राण्यवेक्ष्य च ।\nदत्तामपि हरेत्पूर्वां श्रेयांश्चेद्वर आव्रजेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003621052, "chapter_id": 23621, "verse_number": "१-२-८-५३", "content_sanskrit": "अर्वाक्छिलाक्रमणतो निष्ठा स्यात्सप्तमे पदे ।\nइति व्यवस्य प्रददावन्यस्मै तां द्विजः सुताम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003621053, "chapter_id": 23621, "verse_number": "१-२-८-५४", "content_sanskrit": "श्वोभाविनि विवाहे तु तच्च सर्वं मया श्रुतम् ।\nततोतीव विलक्ष्योहं वयस्यानां पुरस्तदा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003621054, "chapter_id": 23621, "verse_number": "१-२-८-५५", "content_sanskrit": "नाशकं वदनं भद्र तथा दर्शयितुं निजम् ।\nकामार्तोतीव तां सुप्तामर्वाग्निशि तदाहरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003621055, "chapter_id": 23621, "verse_number": "१-२-८-५६", "content_sanskrit": "नीत्वा दुर्गतमैकांतेऽकार्षमौद्वाहिकं विधिम् ।\nगांधर्वेण विवाहेन ततोऽकार्षं हृदीप्सितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003621056, "chapter_id": 23621, "verse_number": "१-२-८-५७", "content_sanskrit": "अनिच्छंतीं तदा बालां बलात्सुरतसेवनम् ।\nअथानुपदमागत्य तत्पिता प्रातरेव माम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003621057, "chapter_id": 23621, "verse_number": "१-२-८-५८", "content_sanskrit": "निश्वस्य संवृतो विप्रास्तां वीक्ष्योद्वाहितां सुताम् ।\nशशाप कुपितो भद्र मां तदानीं स भार्गवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003621058, "chapter_id": 23621, "verse_number": "१-२-८-५९", "content_sanskrit": "भार्गव उवाच ।\nनिशाचरस्य धर्मेण यत्त्वयोद्वाहिता सुता ।\nतस्मान्निशाचरः पाप भव त्वमविलंबितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003621059, "chapter_id": 23621, "verse_number": "१-२-८-६०", "content_sanskrit": "इति शप्तः प्रण्म्यैनं पादोपग्रहपूर्वकम् ।\nहाहेति च ब्रुवन्गाढं साश्रुनेत्रं सगद्गदम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003621060, "chapter_id": 23621, "verse_number": "१-२-८-६१", "content_sanskrit": "ततोहमब्रवं कस्माददोषं मां भवानिति ।\nशपते भवता दत्ता मम वाचा पुरा सुता ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003621061, "chapter_id": 23621, "verse_number": "१-२-८-६२", "content_sanskrit": "सोद्वाहिता मया कन्या दानं सकृदिति स्मृतिः ।\nसकृज्जल्पंति राजानः सकृज्जल्पंति पण्डिताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003621062, "chapter_id": 23621, "verse_number": "१-२-८-६३", "content_sanskrit": "सकृत्कन्याः प्रदीयंते त्रीण्येतानि सकृत्सकृत् ।\nकिं च प्रतिश्रुतार्थस्य निर्वाहस्तत्सतां व्रतम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003621063, "chapter_id": 23621, "verse_number": "१-२-८-६४", "content_sanskrit": "भवादृशानां साधूनां साधूनां तस्य त्यागो विगर्हितः ।\nप्रतिश्रुता त्वया लब्धा तदा कालमियं मया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003621064, "chapter_id": 23621, "verse_number": "१-२-८-६५", "content_sanskrit": "उद्वोढा चाधुना नाहमुचितः शापभाजनम् ।\nवृथा शपन्ति मह्यं च भवंतस्तद्विचार्यताम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003621065, "chapter_id": 23621, "verse_number": "१-२-८-६६", "content_sanskrit": "यो दत्त्वा कन्यकां वाचा पश्चाद्धरति दुर्मतिः ।\nस याति नरकं चेति धर्मशास्त्रेषु निश्चितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003621066, "chapter_id": 23621, "verse_number": "१-२-८-६७", "content_sanskrit": "तदाकर्ण्य व्यवस्यासौ तथ्यं मद्वचनं हृदा ।\nपश्चात्तापसमोपेतो मुनिर्मामित्यथाब्रवीत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003621067, "chapter_id": 23621, "verse_number": "१-२-८-६८", "content_sanskrit": "न मे स्यादन्यथा वाणी उलूकस्त्वं भविष्यति ।\nनिशाचरो ह्युलूकोऽपि प्रोच्यते द्विजसत्तम ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003621068, "chapter_id": 23621, "verse_number": "१-२-८-६९", "content_sanskrit": "यदेंद्रद्युम्नविज्ञाने सहायस्तंव भविष्यसि ।\nतदा त्वं प्रकृतिं विप्र प्राप्स्यसीत्यब्रवीत्स माम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003621069, "chapter_id": 23621, "verse_number": "१-२-८-७०", "content_sanskrit": "तद्वाक्यसमकालं च कौशिकत्वमिदं मम ।\nएतावंति दिनान्यासीदष्टाविंशद्दिनं विधेः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003621070, "chapter_id": 23621, "verse_number": "१-२-८-७१", "content_sanskrit": "बिल्वीदलौरिति पुरा शशिशेखरस्य संपूजनेन मम दीर्घतरं किलायुः ।\nसंजातमत्र च जुगुप्सितमस्य शापात्कैलासरोधसि निशाचररूपमासीत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]