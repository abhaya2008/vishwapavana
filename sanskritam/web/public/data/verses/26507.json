[{"id": 7006507000, "chapter_id": 26507, "verse_number": "३-४६-१", "content_sanskrit": "दैत्यानां विनाशसूचकाः महान्ति उत्पातानि, हिरण्यकशिपुना गदामादाय आक्रमणम्, तस्य पादानां धमनात् पृथ्वी, पर्वत, नदी एवं देशानां कम्पनम् वैशम्पायन उवाच ततः सर्वासु मायासु हतासु दितिनन्दनाः ।\nहिरण्यकशिपुं सर्वे विषण्णाः शरणं गताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006507001, "chapter_id": 26507, "verse_number": "३-४६-२", "content_sanskrit": "ततः प्रज्वलितः क्रोधात् प्रदहन्निव तेजसा ।\nहिरण्यकशिपुर्दैत्यश्चालयामास मेदिनीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006507002, "chapter_id": 26507, "verse_number": "३-४६-३", "content_sanskrit": "ततः प्रक्षुभिताः सर्वे सागराः सलिलाकराः ।\nचलिता गिरयः सर्वे सकाननवनद्रुमाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006507003, "chapter_id": 26507, "verse_number": "३-४६-४", "content_sanskrit": "तस्मिन् क्रुद्धे तु दैत्येन्द्रे तमोभूतमभूज्जगत् ।\nतमसा समभूच्छन्नं न प्राज्ञायत किंचन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006507004, "chapter_id": 26507, "verse_number": "३-४६-५", "content_sanskrit": "आवहः प्रवहश्चैव विवहश्च समीरणः ।\nपरावहः संवहश्च उद्वहश्च महाबलः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006507005, "chapter_id": 26507, "verse_number": "३-४६-६", "content_sanskrit": "तथा परिवहः श्रीमान् मारुता भयशंसिनः ।\nइत्येते क्षुभिताः सप्त मारुता गगनेचराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006507006, "chapter_id": 26507, "verse_number": "३-४६-७", "content_sanskrit": "ये ग्रहाः सर्वलोकस्य क्षये प्रादुर्भवन्ति वै ।\nते ग्रहा गगने हृष्टा विचरन्ति यथासुखम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006507007, "chapter_id": 26507, "verse_number": "३-४६-८", "content_sanskrit": "अयोगतश्चात्यचरद् योगं दिवि निशाकरः ।\nसग्रहं सहनक्षत्रं प्रजज्वाल नभो नृप ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006507008, "chapter_id": 26507, "verse_number": "३-४६-९", "content_sanskrit": "विवर्णत्वं च भगवान् गतो दिवि दिवाकरः ।\nकृष्णः कबन्धश्च महाँल्लक्ष्यते च नभस्तले ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006507009, "chapter_id": 26507, "verse_number": "३-४६-१०", "content_sanskrit": "अमुञ्चच्चासितां सूर्यो धूमवर्तिं भयावहाम् ।\nगगनस्थश्च भगवानभीक्ष्णं परितप्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006507010, "chapter_id": 26507, "verse_number": "३-४६-११", "content_sanskrit": "सप्तधूमनिभा घोराः सूर्या दिवि समुत्थिताः ।\nसोमस्य गगनस्थस्य ग्रहास्तिष्ठन्ति शृङ्गगाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006507011, "chapter_id": 26507, "verse_number": "३-४६-१२", "content_sanskrit": "वामे च दक्षिणे चैव स्थितौ शुक्रबृहस्पती ।\nशनैश्चरो लोहिताङ्गो लोहितार्कसमद्युतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006507012, "chapter_id": 26507, "verse_number": "३-४६-१३", "content_sanskrit": "समं समभिरोहन्ति दुर्गाणि गगनेचराः ।\nशृङ्गाणि कनकैर्घोरा युगान्तावर्तका ग्रहाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006507013, "chapter_id": 26507, "verse_number": "३-४६-१४", "content_sanskrit": "चन्द्रमाः सह नक्षत्रैर्ग्रहैः सप्तभिरावृतः ।\nचराचरविनाशार्थं रोहिणीं नाभ्यनन्दत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006507014, "chapter_id": 26507, "verse_number": "३-४६-१५", "content_sanskrit": "गृहीतो राहुणा चन्द्र उल्काभिरभिहन्यते ।\nउल्काः प्रज्वलिताश्चन्द्रे प्रचेलुर्घोरदर्शनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006507015, "chapter_id": 26507, "verse_number": "३-४६-१६", "content_sanskrit": "देवानामपि यो देवः सोऽभ्यवर्षत शोणितम् ।\nअपतन् गगनादुल्का विद्युद्रूपाः सनिःस्वनाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006507016, "chapter_id": 26507, "verse_number": "३-४६-१७", "content_sanskrit": "अकाले पादपाः सर्वे पुष्यन्ति च फलन्ति च ।\nलताश्च सफलाः सर्वा याः प्राहुर्दैत्यनाशनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006507017, "chapter_id": 26507, "verse_number": "३-४६-१८", "content_sanskrit": "फले फलान्यजायन्त पुष्पे पुष्पं तथैव च ।\nउन्मीलन्ति निमीलन्ति हसन्ति च रुदन्ति च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006507018, "chapter_id": 26507, "verse_number": "३-४६-१९", "content_sanskrit": "विक्रोशन्ति च गम्भीरं धूमयन्ति ज्वलन्ति च ।\nप्रतिमाः सर्वदेवानां कथयन्ति युगक्षयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006507019, "chapter_id": 26507, "verse_number": "३-४६-२०", "content_sanskrit": "आरण्यैः सह संसृष्टा ग्राम्याश्च मृगपक्षिणः ।\nचुक्रुशुर्भैरवं तत्र मृगेन्द्रे समुपस्थिते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006507020, "chapter_id": 26507, "verse_number": "३-४६-२१", "content_sanskrit": "नद्यश्च प्रतिलोमा हि वहन्ति कलुषोदकाः ।\nअपराह्णगते सूर्ये लोकानां क्षयकारके ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006507021, "chapter_id": 26507, "verse_number": "३-४६-२२", "content_sanskrit": "न प्रकाशन्ति च दिशो रक्तरेणुसमाकुलाः ।\nवानस्पत्या न पूज्यन्ते पूजनार्हाः कथंचन ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006507022, "chapter_id": 26507, "verse_number": "३-४६-२३", "content_sanskrit": "वायुवेगेन हन्यन्ते भिद्यन्ते प्रणुदन्ति च ।\nतदा च सर्वभूतानां छाया न परिवर्तते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006507023, "chapter_id": 26507, "verse_number": "३-४६-२४", "content_sanskrit": "अपराह्णगते सूर्ये लोकानां च युगक्षये ।\nतदा हिरण्यकशिपोर्दैत्यस्योपरिवेश्मनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006507024, "chapter_id": 26507, "verse_number": "३-४६-२५", "content_sanskrit": "भाण्डागारायुधागारे निविष्टमभवन्मधु ।\nतथैव चायुधागारे धूमराजिरदृश्यत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006507025, "chapter_id": 26507, "verse_number": "३-४६-२६", "content_sanskrit": "स च दृष्ट्वा महोत्पातान् हिरण्यकशिपुस्तदा ।\nपुरोहितं तदा शुक्रं वचनं चेदमब्रवीत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006507026, "chapter_id": 26507, "verse_number": "३-४६-२७", "content_sanskrit": "किमर्थं भगवन्नेते महोत्पाताः समुत्थिताः ।\nश्रोतुमिच्छामि तत्त्वेन परं कौतूहलं हि मे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006507027, "chapter_id": 26507, "verse_number": "३-४६-२८", "content_sanskrit": "शुक्र उवाच शृणु राजन्नवहितो वचनं मे महासुर ।\nयदर्थमिह दृश्यन्ते महोत्पाता महाभयाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006507028, "chapter_id": 26507, "verse_number": "३-४६-२९", "content_sanskrit": "यस्यैते सम्प्रदृश्यन्ते राज्ञो राष्ट्रे महासुर ।\nदेशो वा ह्रियते तस्य राजा वा वधमर्हति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006507029, "chapter_id": 26507, "verse_number": "३-४६-३०", "content_sanskrit": "अतो बुद्धया समीक्षस्व यथा सर्वं प्रणश्यति ।\nवृहद्भयं हि नचिराद् भविष्यति न संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006507030, "chapter_id": 26507, "verse_number": "३-४६-३१", "content_sanskrit": "एतावदुक्त्वा शुक्रस्तु हिरण्यकशिपुं तदा ।\nस्वस्तीत्युक्त्वा तु दैन्येन्द्रं जगाम स्वं निवेशनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006507031, "chapter_id": 26507, "verse_number": "३-४६-३२", "content_sanskrit": "तस्मिन्गते स दैत्येन्द्रो ध्यातवान् सुचिरं तदा ।\nआसांचक्रे सुदीनात्मा ब्रह्मवाक्यमनुस्मरन् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006507032, "chapter_id": 26507, "verse_number": "३-४६-३३", "content_sanskrit": "असुराणां विनाशाय सुराणां विजयाय च ।\nदृश्यन्ते विविधोत्पाता घोरा घोरनिदर्शनाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006507033, "chapter_id": 26507, "verse_number": "३-४६-३४", "content_sanskrit": "एते चान्ये च बहवो घोरा ह्युत्पातदर्शनाः ।\nदैत्येन्द्राणां विनाशाय दृश्यन्ते कालनिर्मिताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006507034, "chapter_id": 26507, "verse_number": "३-४६-३५", "content_sanskrit": "ततो हिरण्यकशिपुर्गदामादाय सत्वरम् ।\nअभ्यद्रवत वेगेन धरणीमनुकम्पयन् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006507035, "chapter_id": 26507, "verse_number": "३-४६-३६", "content_sanskrit": "हिरण्यकशिपुर्दैत्यो पदा सस्पृष्टवान् महीम् ।\nसंदष्टौष्ठपुटः क्रोधाद् वराह इव पूर्वजः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006507036, "chapter_id": 26507, "verse_number": "३-४६-३७", "content_sanskrit": "मेदिन्यां कम्प्यमानायां दैत्येन्द्रेण महात्मना ।\nमहीधरेभ्यो नागेन्द्रा निपेतुर्भयविक्लवाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006507037, "chapter_id": 26507, "verse_number": "३-४६-३८", "content_sanskrit": "विषज्वालाकुलैर्वक्त्रैविंमुञ्चन्तो हुताशनम् ।\nचतुःशीर्षाः पञ्चशीर्षाः सप्तशीर्षाश्च पन्नगाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006507038, "chapter_id": 26507, "verse_number": "३-४६-३९", "content_sanskrit": "वासुकिस्तक्षकश्चैव कर्कोटकधनंजयौ ।\nएलापत्रश्च कालीयो महापद्मश्च वीर्यवान् ।\nसहस्रशीर्षधृङ्नागो हेमतालध्वजः प्रभुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006507039, "chapter_id": 26507, "verse_number": "३-४६-४०", "content_sanskrit": "शेषोऽनन्तो महीपालो दुष्प्रकम्पः प्रकम्पितः ।\nदीप्तान्यन्तर्जलस्थानि पृथिवीधरणानि च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006507040, "chapter_id": 26507, "verse_number": "३-४६-४१", "content_sanskrit": "तदा क्रुद्धेन दैत्येन कम्पितानि समन्ततः ।\nपातालतलचारिण्यो नागतेजोधराः शिवाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006507041, "chapter_id": 26507, "verse_number": "३-४६-४२", "content_sanskrit": "आपश्च सहसा क्रुद्धा दुष्प्रकम्प्यरसाः शुभाः ।\nनदी भागीरथी चैव सरयूः कौशिकी तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006507042, "chapter_id": 26507, "verse_number": "३-४६-४३", "content_sanskrit": "यमुना चैव कावेरी कृष्णा वेणा तथैव च ।\nसुवेणा च महाभागा नदी गोदावरी तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006507043, "chapter_id": 26507, "verse_number": "३-४६-४४", "content_sanskrit": "चर्मण्वती च सिन्धुश्च तथा नदनदीपतिः ।\nमेकलप्रभवश्चैव शोणो मणिनिभोदकः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006507044, "chapter_id": 26507, "verse_number": "३-४६-४५", "content_sanskrit": "सुस्रोता नर्मदा चैव तथा वेत्रवती नदी ।\nगोमती गोकुलाकीर्णा तथापूर्णा सरस्वती ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006507045, "chapter_id": 26507, "verse_number": "३-४६-४६", "content_sanskrit": "मही कालनदी चैव तमसा पुण्यवाहिनी ।\nसीता चेक्षुमती चैव देविका च महानदी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006507046, "chapter_id": 26507, "verse_number": "३-४६-४७", "content_sanskrit": "जम्बूद्वीपं रत्नवन्तं सर्वरत्नोपशोभितम् ।\nसुवर्णकूटकं चैव सुवर्णाकरमण्डितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006507047, "chapter_id": 26507, "verse_number": "३-४६-४८", "content_sanskrit": "महानदश्च लौहित्यः शैलकाननशोभितः ।\nपत्तनं कौशिकारण्यं द्रविडं रजताकरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006507048, "chapter_id": 26507, "verse_number": "३-४६-४९", "content_sanskrit": "मागधांश्च महाग्रामानङ्गान् वङ्गांस्तथैव च ।\nसुह्यान् मल्लान् विदेहांश्च मालवान् काशिकोसलान्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006507049, "chapter_id": 26507, "verse_number": "३-४६-५०", "content_sanskrit": "भवनं वैनतेयस्य सुवर्णस्य च कम्पितम् ।\nकैलासशिखराकारं यत् कृतं विश्वकर्मणा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006507050, "chapter_id": 26507, "verse_number": "३-४६-५१", "content_sanskrit": "रक्ततोयो भीमवेगो लौहित्यो नाम सागरः ।\nशुभः पाण्डुरमेघाभः क्षीरोदश्चैव सागरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006507051, "chapter_id": 26507, "verse_number": "३-४६-५२", "content_sanskrit": "उदयश्चैव राजेन्द्र उच्छ्रितः शतयोजनम् ।\nसुपर्णवेदिकः श्रीमान् नागपक्षिनिषेवितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006507052, "chapter_id": 26507, "verse_number": "३-४६-५३", "content_sanskrit": "भ्राजमानोऽर्कसहृशैर्जातरूपमयैर्दुमैः ।\nशालैस्तालैस्तमालैश्च कर्णिकाभिश्च पुष्पितैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006507053, "chapter_id": 26507, "verse_number": "३-४६-५४", "content_sanskrit": "अयोमुखश्च विपुलः सर्वतो धातुमण्डितः ।\nतमालवनगन्धश्च पर्वतो मलयः शुभः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006507054, "chapter_id": 26507, "verse_number": "३-४६-५५", "content_sanskrit": "सुराष्ट्राश्च सुबाह्लीकाः शूराभीरास्तथैव च ।\nभोजाः पाण्ड्याश्च वङ्गाश्च कलिङ्गास्ताम्रलिप्तकाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006507055, "chapter_id": 26507, "verse_number": "३-४६-५६", "content_sanskrit": "तथैवान्ध्राश्च पुण्ड्राश्च वामचूडाः सकेरलाः ।\nक्षोभितास्तेन दैत्येन सदेवाः साप्सरोगणाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006507056, "chapter_id": 26507, "verse_number": "३-४६-५७", "content_sanskrit": "अगस्तिभुवनं चैव यदगम्यं पुरा कृतम् ।\nसिद्धचारणसङ्घैश्च सेवितं सुमनोहरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006507057, "chapter_id": 26507, "verse_number": "३-४६-५८", "content_sanskrit": "विचित्रनागविहगं सुपुष्पितलताद्रुमम् ।\nजातरूपमयैः शृङ्गैरप्सरोगणसेवितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006507058, "chapter_id": 26507, "verse_number": "३-४६-५९", "content_sanskrit": "गिरिः पुष्पितकश्चैव लक्ष्मीवान् प्रियदर्शनः ।\nउत्थितः सागरं भित्त्वा वयस्यश्चन्द्रसूर्ययोः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006507059, "chapter_id": 26507, "verse_number": "३-४६-६०", "content_sanskrit": "रराज सुमहाशृङ्गैर्गगनं विलिखन्निव ।\nसूर्यचन्द्रांशुसंकाशैः सागराम्बुसमावृतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006507060, "chapter_id": 26507, "verse_number": "३-४६-६१", "content_sanskrit": "विद्युत्वान् पर्वतः श्रीमानायतः शतयोजनम् ।\nविद्युतां यत्र सम्पाता निपात्यन्ते नगोत्तमे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006507061, "chapter_id": 26507, "verse_number": "३-४६-६२", "content_sanskrit": "ऋषभः पर्वतश्चैव श्रीमानृषभसंस्थितः ।\nकुञ्जरः पर्वतश्चैव यत्रागस्त्यगृहं महत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006507062, "chapter_id": 26507, "verse_number": "३-४६-६३", "content_sanskrit": "विशाखरथ्या दुर्धर्षा सर्पाणामालया पुरी ।\nतथा भोगवती चापि दैत्येन्द्रेणाभिकम्पिता ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006507063, "chapter_id": 26507, "verse_number": "३-४६-६४", "content_sanskrit": "महामेघगिरिश्चैव पारियात्रश्च पर्वतः ।\nचक्रवांस्तु गिरिः श्रेष्ठो वाराहश्चैव पर्वतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006507064, "chapter_id": 26507, "verse_number": "३-४६-६५", "content_sanskrit": "प्राग्ज्योतिषपुरं चैव जातरूपमयं शुभम् ।\nयस्मिन् वसति दुष्टात्मा नरको नाम दानवः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006507065, "chapter_id": 26507, "verse_number": "३-४६-६६", "content_sanskrit": "मेरुश्च पर्वतश्रेष्ठो मेघगम्भीरनिःस्वनः ।\nषष्टिं तत्र सहस्राणि पर्वतानां विशाम्पते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006507066, "chapter_id": 26507, "verse_number": "३-४६-६७", "content_sanskrit": "तरुणादित्यसंकाशो महेन्द्रश्च महागिरिः ।\nदेवावासः शुभः पुण्यो गिरिराजो दिवं गतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006507067, "chapter_id": 26507, "verse_number": "३-४६-६८", "content_sanskrit": "हेमशृङ्गो महाशैलस्तथा मेघसखो गिरिः ।\nकैलासश्चापि दुष्कम्पो दानवेन्द्रेण कम्पितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006507068, "chapter_id": 26507, "verse_number": "३-४६-६९", "content_sanskrit": "यक्षराक्षसगन्धर्वैर्नित्यं सेवितकन्दरः ।\nश्रीमान् मन्दरश्चैव नित्यं पुष्पितपादपः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006507069, "chapter_id": 26507, "verse_number": "३-४६-७०", "content_sanskrit": "हेमपुष्करसंछन्नं तेन वैखानसं सरः ।\nकम्पितं मानसं चैव राजहंसैर्निषेवितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006507070, "chapter_id": 26507, "verse_number": "३-४६-७१", "content_sanskrit": "विशृङ्गः पर्वतश्चैव कुमारी च सरिद्वरा ।\nतुषारचयसंकाशो मन्दरश्चैव पर्वतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006507071, "chapter_id": 26507, "verse_number": "३-४६-७२", "content_sanskrit": "उशीरबीजश्च गिरी रुद्रोपस्थस्तथाद्रिराट् ।\nप्रजापतेश्च निलयस्तथा पुष्करपर्वतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006507072, "chapter_id": 26507, "verse_number": "३-४६-७३", "content_sanskrit": "देवावृत् पर्वतश्चैव तथा वै वालुको गिरिः ।\nक्रौञ्चः सप्तर्षिशैलश्च धूमवर्णश्च पर्वतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006507073, "chapter_id": 26507, "verse_number": "३-४६-७४", "content_sanskrit": "एते चान्ये च गिरयो देशा जनपदास्तथा ।\nनद्यश्च सागराश्चैव दानवेन्द्रेण कम्पिताः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006507074, "chapter_id": 26507, "verse_number": "३-४६-७५", "content_sanskrit": "कपिलश्च महीपुत्रो व्याघ्राक्षः क्षितिकम्पनः ।\nखेचराश्च निशापुत्राः पातालतलवासिनः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006507075, "chapter_id": 26507, "verse_number": "३-४६-७६", "content_sanskrit": "गणस्तथापरो रौद्रो मेघनादोऽङ्कुशायुधः ।\nऊर्ध्वगो भीमवेगश्च सर्व एवाभिकम्पिताः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]