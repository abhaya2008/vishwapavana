[{"id": 2136051, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136052, "chapter_id": 3951, "verse_number": "१", "content_sanskrit": "मारीचस्त्वथ सम्भ्रान्तो दृष्ट्वा रावणमागतम् ।\nपूजयामास सत्कारैः फलमूलादिभिस्ततः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136053, "chapter_id": 3951, "verse_number": "२", "content_sanskrit": "विश्रान्तं चैनमासीनमन्वासीनः स राक्षसः ।\nउवाच प्रश्रितं वाक्यं वाक्यज्ञो वाक्यकोविदम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136054, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मारीचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136055, "chapter_id": 3951, "verse_number": "३", "content_sanskrit": "न ते प्रकृतिमान् वर्णः कच्चित् क्षेमं पुरे तव ।\nकच्चित् प्रकृतयः सर्वा भजन्ते त्वां यथा पुरा \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136056, "chapter_id": 3951, "verse_number": "४", "content_sanskrit": "किमिहागमने चापि कार्यं ते राक्षसेश्वर ।\nकृतमित्येव तद्विद्धि यद्यपि स्यात् सुदुष्करम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136057, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136058, "chapter_id": 3951, "verse_number": "५", "content_sanskrit": "शशंस रावणस्तस्मै तत्सर्वं रामचेष्टितम् ।\nसमासेनैव कार्याणि क्रोधामर्षसमन्वितः ।\nमारीचस्त्वब्रवीच्छ्रुत्वा समासेनैव रावणम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136059, "chapter_id": 3951, "verse_number": "६", "content_sanskrit": "अलं ते राममासाद्य वीर्यज्ञो ह्यस्मि तस्य वै ।\nबाणवेगं हि कस्तस्य शक्तः सोढुं महात्मनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136060, "chapter_id": 3951, "verse_number": "७", "content_sanskrit": "प्रव्रज्यायां हि मे हेतुः स एव पुरुषर्षभः ।\nविनाशमुखमेतत् ते केनाख्यातं दुरात्मना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136061, "chapter_id": 3951, "verse_number": "८", "content_sanskrit": "तमुवाचाथ सक्रोधो रावणः परिभर्त्सयन् ।\nअकुर्वतोऽस्मद्वचनं स्यान्मृत्युरपि ते ध्रुवम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136062, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136063, "chapter_id": 3951, "verse_number": "९", "content_sanskrit": "मारीचश्चिन्तयामास विशिष्टान्मरणं वरम् ।\nअवश्यं मरणे प्राप्ते करिष्याम्यस्य यन्मतम् ।\nततस्तं प्रत्युवाचाथ मारीचो राक्षसेश्वरम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136064, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मारीचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136065, "chapter_id": 3951, "verse_number": "१०", "content_sanskrit": "किं ते साह्यं मया कार्यं करिष्याम्यवशोऽपि तत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136066, "chapter_id": 3951, "verse_number": "११", "content_sanskrit": "तमब्रवीद् दशग्रीवो गच्छ सीतां प्रलोभय ।\nरत्नशृङ्गो मृगो भूत्वा रत्नचित्रतनूरुहः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136067, "chapter_id": 3951, "verse_number": "१२", "content_sanskrit": "ध्रुवं सीता समालक्ष्य त्वां रामं चोदयिष्यति ।\nअपक्रान्ते च काकुत्स्थे सीता वश्या भविष्यति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136068, "chapter_id": 3951, "verse_number": "१३", "content_sanskrit": "तामादायापनेष्यामि ततः स न भविष्यति ।\nभार्यावियोगाद् दुर्बुद्धिरेतत् साह्यं कुरुष्व मे \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136069, "chapter_id": 3951, "verse_number": "१४", "content_sanskrit": "इत्येवमुक्तो मारीचः कृत्वोदकमथात्मनः ।\nरावणं पुरतो यान्तमन्वगच्छत् सुदुःखितः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136070, "chapter_id": 3951, "verse_number": "१५", "content_sanskrit": "ततस्तस्याश्रमं गत्वा रामस्याक्लिष्टकर्मणः ।\nचक्रतुस्तत् तथा सर्वमुभौ यत् पूर्वमन्त्रितम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136071, "chapter_id": 3951, "verse_number": "१६", "content_sanskrit": "रावणस्तु यतिर्भूत्वा मुण्डः कुण्डी त्रिदण्डधृत् ।\nमृगश्च भूत्वा मारीचस्तं देशमुपजग्मतुः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136072, "chapter_id": 3951, "verse_number": "१७", "content_sanskrit": "दर्शयामास मारीचो वैदेहीं मृगरूपधृक् ।\nचोदयामास तस्यार्थे सा रामं विधिचोदिता \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136073, "chapter_id": 3951, "verse_number": "१८", "content_sanskrit": "रामस्तस्याः प्रियं कुर्वन् धनुरादाय सत्वरः ।\nरक्षार्थे लक्ष्मणं न्यस्य प्रययौ मृगलिप्सया \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136074, "chapter_id": 3951, "verse_number": "१९", "content_sanskrit": "स धन्वी बद्धतूणीरः खड्गगोधाङ्गुलित्रवान् ।\nअन्वधावन्मृगं रामो रुद्रस्तारामृगं यथा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136075, "chapter_id": 3951, "verse_number": "२०", "content_sanskrit": "सोऽन्तर्हितः पुनस्तस्य दर्शनं राक्षसो व्रजन् ।\nचकर्ष च महा(हद)ध्वानं रामस्तं बुबुधे ततः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136076, "chapter_id": 3951, "verse_number": "२१", "content_sanskrit": "निशाचरं विदित्वा तं राघवः प्रतिभानवान् ।\nअमोघं शरमादाय जघान मृगरूपिणम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136077, "chapter_id": 3951, "verse_number": "२२", "content_sanskrit": "स रामबाणाभिहतः कृत्वा रामस्वरं तदा ।\nहा सीते लक्ष्मणेत्येवं चुक्रोशार्तस्वरेण ह \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136078, "chapter_id": 3951, "verse_number": "२३", "content_sanskrit": "शुश्राव तस्य वैदेही ततस्तां करुणां गिरम् ।\nसा प्राद्रवद् यतः शब्दस्तामुवाचाथ लक्ष्मणः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136079, "chapter_id": 3951, "verse_number": "२४", "content_sanskrit": "अलं ते शङ्कया भीरु को रामं प्रहरिष्यति ।\nमुहूर्ताद् द्रक्ष्यसे रामं भर्तारं त्वं शुचिस्मिते \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136080, "chapter_id": 3951, "verse_number": "२५", "content_sanskrit": "इत्युक्ता सा प्ररुदती पर्यशङ्कत लक्ष्मणम् ।\nहता वै स्त्रीस्वभावेन शुक्लचारित्रभूषणा ।\nसा तं परुषमारब्धा वक्तुं साध्वी पतिव्रता \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136081, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "सीता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136082, "chapter_id": 3951, "verse_number": "२६", "content_sanskrit": "नैष कामो भवेन्मूढ यं त्वं प्रार्थयसे हृदा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136083, "chapter_id": 3951, "verse_number": "२७", "content_sanskrit": "अप्यहं शस्त्रमादाय हन्यामात्मानमात्मना ।\nपतेयं गिरिशृङ्गाद् वा विशेयं वा हुताशनम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136084, "chapter_id": 3951, "verse_number": "२८", "content_sanskrit": "रामं भर्तारमुत्सृज्य न त्वहं त्वां कथञ्चन ।\nनिहीनमुपतिष्ठेयं शार्दूली क्रोष्टुकं यथा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136085, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136086, "chapter_id": 3951, "verse_number": "२९", "content_sanskrit": "एतादृशं वचः श्रुत्वा लक्ष्मणः प्रियराघवः ।\nपिधाय कर्णौ सद्वृत्तः प्रस्थितो येन राघवः।\nस रामस्य पदं गृह्य प्रससार धनुर्धरः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136087, "chapter_id": 3951, "verse_number": "३०", "content_sanskrit": "अवीक्षमाणो बिम्बोष्ठीं प्रययौ लक्ष्मणस्तदा ।\nएतस्मिन्नन्तरे रक्षो रावणः प्रत्यदृश्यत ।\nअभव्यो भव्यरूपेण भस्मच्छन्न इवानलः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136088, "chapter_id": 3951, "verse_number": "३१", "content_sanskrit": "यतिवेषप्रतिच्छन्नो जिहीर्षुस्तामनिन्दिताम् ।\nउपागच्छत् स वैदेहीं रावणः पापनिश्चयः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136089, "chapter_id": 3951, "verse_number": "३२", "content_sanskrit": "सा तमालक्ष्य सम्प्राप्तं धर्मज्ञा जनकात्मजा ।\nनिमन्त्रयामास तदा फलमूलाशनादिभिः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136090, "chapter_id": 3951, "verse_number": "३३", "content_sanskrit": "अवमन्य ततः सर्वं स्वरूपं प्रत्यपद्यत ।\nसान्त्वयामास वैदेहीमिति राक्षसपुङ्गवः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136091, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "रावणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136092, "chapter_id": 3951, "verse_number": "३४", "content_sanskrit": "सीते राक्षसराजोऽहं रावणो नाम विश्रुतः ।\nमम लङ्का पुरी नाम्ना रम्या पारे महोदधेः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136093, "chapter_id": 3951, "verse_number": "३५", "content_sanskrit": "तत्र त्वं नरनारीषु शोभिष्यसि मया सह ।\nभार्या मे भव सुश्रोणि तापसं त्यज राघवम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136094, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136095, "chapter_id": 3951, "verse_number": "३६", "content_sanskrit": "एवमादीनि वाक्यानि श्रुत्वा तस्याथ जानकी ।\nपिधाय कर्णौ सुश्रोणी मैवमित्यब्रवीद् वचः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136096, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "जानकी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136097, "chapter_id": 3951, "verse_number": "३७", "content_sanskrit": "प्रपतेद् द्यौः सनक्षत्रा पृथिवी शकलीभवेत् ।\nशुष्येत् तोयनिधौ तोयं चन्द्रः शीतांशुतां त्यजेत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136098, "chapter_id": 3951, "verse_number": "३८", "content_sanskrit": "उष्णांशुत्वमथो जह्यादादित्यो वह्निरुष्णताम् ।\nशैत्यमग्निरियान्नाहं त्यजेयं रघुनन्दनम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136099, "chapter_id": 3951, "verse_number": "३९", "content_sanskrit": "कथं हि भिन्नकरटं हस्तिनं(पद्मिनं) वनगोचरम् ।\nउपस्थाय महानागं करेणुः सूकरं स्पृशेत् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136100, "chapter_id": 3951, "verse_number": "४०", "content_sanskrit": "कथं हि पीत्वा माध्वीकं पीत्वा च मधुमाधवीम् ।\nलोभं सौवीरके कुर्यान्नारी काचिदिति स्मरेत् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136101, "chapter_id": 3951, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2136102, "chapter_id": 3951, "verse_number": "समाप्तिः", "content_sanskrit": "इति ता तं समाभाष्य प्रविवेशाश्रमं ततः ।\nक्रोधात् प्रस्फुरमाणौष्ठी विधुन्वाना करौ मुहुः ।\nतामभिद्रुत्य सुश्रोणीं रावणः प्रत्यषेधयत् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2136103, "chapter_id": 3951, "verse_number": "४२", "content_sanskrit": "भर्त्सयित्वा तु रूक्षेण स्वरेण गतचेतनाम् ।\nमूर्धजेषु निजग्राह ऊर्ध्वमाचक्रमे ततः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2136104, "chapter_id": 3951, "verse_number": "४३", "content_sanskrit": "तां ददर्श ततो गृध्रो जटायुर्गिरिगोचरः ।\nरुदतीं राम रामेति ह्रियमाणां तपस्विनीम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2136105, "chapter_id": 3951, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तषष्ट्यधिकद्विशततमोऽध्यायः ॥२६७॥\nरामोपाख्यानपर्वणि मारीचवधे सीताहरणे च सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]