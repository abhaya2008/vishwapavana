[{"id": 2148224, "chapter_id": 4207, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148225, "chapter_id": 4207, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तु विमनाः तिर्यग् दृष्टिरधोमुखः ।\nसंहत्य च भ्रुवोर्मध्यं न किञ्चिद् व्याजहार ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148226, "chapter_id": 4207, "verse_number": "२", "content_sanskrit": "तं वै विमनसं दृष्ट्वा सम्प्रेक्ष्यान्योन्यमन्तिकात् ।\nपुनरेवोचतुर्वाक्यमुक्तवन्तौ नरर्षभौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148227, "chapter_id": 4207, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148228, "chapter_id": 4207, "verse_number": "३", "content_sanskrit": "शुश्रूषुमनसूयुं च ब्रह्मण्यं सत्यसङ्गरम् ।\nप्रतियोत्स्यामहे पार्थमतो दुःखतरं नु किम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148229, "chapter_id": 4207, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148230, "chapter_id": 4207, "verse_number": "४", "content_sanskrit": "अश्वत्थाम्नि यथा पुत्रे भूयो मम धनञ्जये ।\nबहुमानः परो राजन् सन्नतिश्च कपिध्वजे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148231, "chapter_id": 4207, "verse_number": "५", "content_sanskrit": "तं चेत् पुत्रात् प्रियतरं प्रतियोत्स्ये धनञ्जयम् ।\nक्षत्रधर्ममनुष्ठाय धिगस्तु क्षत्रजीविकाम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148232, "chapter_id": 4207, "verse_number": "६", "content_sanskrit": "यस्य लोके समो नास्ति कश्चिदन्यो धनुर्धरः ।\nमत्प्रसादात् स बीभत्सुः श्रेयानन्यैर्धनुर्धरैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148233, "chapter_id": 4207, "verse_number": "७", "content_sanskrit": "मित्रध्रुग् दुष्टभावश्च नास्तिकोऽथानृजुः शठः ।\nन सत्सु लभते पूजां यज्ञे मूर्ख इवागतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148234, "chapter_id": 4207, "verse_number": "८", "content_sanskrit": "वार्यमाणोऽपि पापेभ्यः पापात्मा पापमिच्छति ।\nचोद्यमानोऽपि पापेन शुभात्मा शुभमिच्छति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148235, "chapter_id": 4207, "verse_number": "९", "content_sanskrit": "मिथ्योपचरिता ह्येते वर्तमाना अपि प्रिये ।\nअहितत्वाय कल्पन्ते दोषाद् भरतसत्तम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148236, "chapter_id": 4207, "verse_number": "१०", "content_sanskrit": "त्वमुक्तः कुरुवृद्धेन मया च विदुरेण च ।\nवासुदेवेन च तथा श्रेयो नैवाभिपद्यसे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148237, "chapter_id": 4207, "verse_number": "११", "content_sanskrit": "अस्ति मे बलमित्येवं सहसा त्वं तितीर्षसि ।\nसग्राहनक्रमकरं गङ्गाजलमिवोष्णगे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148238, "chapter_id": 4207, "verse_number": "१२", "content_sanskrit": "वाससैव यथा हि त्वं प्रावृण्वानोऽद्य मन्यसे ।\nस्रजं त्यक्तामिव प्राप्य लोभाद् यौधिष्ठिरीं श्रियम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148239, "chapter_id": 4207, "verse_number": "१३", "content_sanskrit": "द्रौपदीसहितं पार्थं सायुधैर्भ्रातृभिर्वृतम् ।\nवनस्थमपि राज्यस्थः पाण्डवं को विजेष्यति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148240, "chapter_id": 4207, "verse_number": "१४", "content_sanskrit": "निदेशे यस्य राजानः सर्वे तिष्ठन्ति किङ्कराः ।\nतमैलबिलमासाद्य धर्मराजो व्यराजत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148241, "chapter_id": 4207, "verse_number": "१५", "content_sanskrit": "कुबेरसदनं प्राप्य ततो रत्नान्यवाप्य च ।\nस्फीतमाक्रम्य ते राष्ट्रं राज्यमिच्छन्ति पाण्डवाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148242, "chapter_id": 4207, "verse_number": "१६", "content_sanskrit": "इष्टं हुतमधीतं च ब्राह्मणास्तर्पिता धनैः ।\nआवयोर्गतमायुश्च कृतकृत्यौ च विद्धि नौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148243, "chapter_id": 4207, "verse_number": "१७", "content_sanskrit": "त्वं तु हित्वा सुखं राज्यं मित्राणि च धनानि च ।\nविग्रहं पाण्डवैः कृत्वा महद् व्यसनमाप्स्यसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148244, "chapter_id": 4207, "verse_number": "१८", "content_sanskrit": "द्रौपदी यस्य चाशास्ते विजयं सत्यवादिनी ।\nतपोघोरव्रता देवी न त्वं जेष्यसि पाण्डवम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148245, "chapter_id": 4207, "verse_number": "१९", "content_sanskrit": "मन्त्री जनार्दनो यस्य भ्राता यस्य धनञ्जयः ।\nसर्वधर्मभृतां श्रेष्ठं न त्वं जेष्यसि पाण्डवम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148246, "chapter_id": 4207, "verse_number": "२०", "content_sanskrit": "सहाया ब्राह्मणा यस्य धृतिमन्तो जितेन्द्रियाः ।\nतमुग्रतपसं वीरं कथं जेष्यसि पाण्डवम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148247, "chapter_id": 4207, "verse_number": "२१", "content_sanskrit": "पुनरुक्तं च वक्ष्यामि यत् कार्यं भूतिमिच्छता ।\nसुहृदा मज्जमानेषु सुहृत्सु व्यसनार्णवे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148248, "chapter_id": 4207, "verse_number": "२२", "content_sanskrit": "अलं युद्धेन तैर्वीरैः शाम्य त्वं कुरुवृद्धये ।\nमा गमः ससुतामात्यः समित्रश्च यमक्षयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148249, "chapter_id": 4207, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टत्रिंशोत्तरशततमोऽध्यायः ॥१३८॥\nभगवद्यानपर्वणि अष्टषष्टितमोऽध्यायः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148250, "chapter_id": 4207, "verse_number": "", "content_sanskrit": "॥ समाप्तं भगवद्यानपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]