[{"id": 5000167000, "chapter_id": 9167, "verse_number": "२-९०-१", "content_sanskrit": "भरद्वाजाश्रमं दृष्ट्वा क्रोशादेव नरर्षभ: ।\nबलं सर्वमवस्थाप्य जगाम सह मन्त्रिभि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000167001, "chapter_id": 9167, "verse_number": "२-९०-२", "content_sanskrit": "पद्भ्यामेव हि धर्मज्ञो न्यस्तशस्त्रपरिच्छद: ।\nवसानो वाससी क्षौमे पुरोधाय पुरोधसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000167002, "chapter_id": 9167, "verse_number": "२-९०-३", "content_sanskrit": "तत: सन्दर्शने तस्य भरद्वाजस्य राघव: ।\nमन्त्रिणस्तानवस्थाप्य जगामानुपुरोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000167003, "chapter_id": 9167, "verse_number": "२-९०-४", "content_sanskrit": "वसिष्ठमथ दृष्ट्वैव भरद्वाजो महातपा: ।\nसञ्चचालासनात्तूर्णं शिष्यानर्घ्यमिति ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000167004, "chapter_id": 9167, "verse_number": "२-९०-५", "content_sanskrit": "वसिष्ठसाहचर्य्यादिति भाव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000167005, "chapter_id": 9167, "verse_number": "२-९०-६", "content_sanskrit": "ताभ्यामर्घ्यं च पाद्यं च दत्त्वा पश्चात् फलानि च ।\nआनुपूर्व्याच्च धर्मज्ञ: पप्रच्छ कुशलं कुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000167006, "chapter_id": 9167, "verse_number": "२-९०-७", "content_sanskrit": "अयोध्यायां बले कोशे मित्रेष्वपि च मन्त्रिषु ।\nजानन् दशरथं वृत्तं न राजानमुदाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000167007, "chapter_id": 9167, "verse_number": "२-९०-८", "content_sanskrit": "वसिष्ठो भरतश्चैनं पप्रच्छतुरनामयम् ।\nशरीरे ऽग्निषु वृक्षेषु शिष्येषु मृगपक्षिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000167008, "chapter_id": 9167, "verse_number": "२-९०-९", "content_sanskrit": "तथेति तत्प्रतिज्ञाय भरद्वाजो महातपा: ।\nभरतं प्रत्युवाचेदं राघवस्नेहबन्धनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000167009, "chapter_id": 9167, "verse_number": "२-९०-१०", "content_sanskrit": "किमिहागमने कार्य्यं तव राज्यं प्रशासत: ।\nएतदाचक्ष्व मे सर्वं नहि मे शुद्ध्यते मन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000167010, "chapter_id": 9167, "verse_number": "२-९०-११", "content_sanskrit": "सुषुवे यममित्रघ्नं कौसल्या नन्दवर्द्धनम् ।\nभ्रात्रा सह सभार्यो यश्चिरं प्रव्राजितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000167011, "chapter_id": 9167, "verse_number": "२-९०-१२", "content_sanskrit": "नियुक्त: स्त्रीनियुक्तेन पित्रा यो ऽसौ महायशा: ।\nवनवासी भवेतीह समा: किल चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000167012, "chapter_id": 9167, "verse_number": "२-९०-१३", "content_sanskrit": "कच्चिन्न तस्यापापस्य पापं कर्तुमिहेच्छसि ।\nअकण्टकं भोक्तुमना राज्यं तस्यानुजस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000167013, "chapter_id": 9167, "verse_number": "२-९०-१४", "content_sanskrit": "एवमुक्तो भरद्वाजं भरत: प्रत्युवाच ह ।\nपर्य्यश्रुनयनो दु:खाद्वाचा संसज्जमानया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000167014, "chapter_id": 9167, "verse_number": "२-९०-१५", "content_sanskrit": "हतो ऽस्मि यदि मामेवं भगवानपि मन्यते ।\nमत्तो न दोषमाशङ्के नैवं मामनुशाधि हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000167015, "chapter_id": 9167, "verse_number": "२-९०-१६", "content_sanskrit": "न चैतदिष्टं माता मे यदवोचन्मदन्तरे ।\nनाहमेतेन तुष्टश्च न तद्वचनमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000167016, "chapter_id": 9167, "verse_number": "२-९०-१७", "content_sanskrit": "अहं तु तं नरव्याघ्रमुपयात: प्रसादक: ।\nप्रतिनेतुमयोध्यां च पादौ तस्याभिवन्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000167017, "chapter_id": 9167, "verse_number": "२-९०-१८", "content_sanskrit": "त्वं मामेवङ्गतं मत्वा प्रसादं कर्तुमर्हसि ।\nशंस मे भगवन् राम: क्व सम्प्रति महीपति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000167018, "chapter_id": 9167, "verse_number": "२-९०-१९", "content_sanskrit": "वसिष्ठादिभिर्ऋत्विग्भिर्याचितो भगवांस्तत: ।\nउवाच तं भरद्वाज: प्रसादाद्भरतं वच: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000167019, "chapter_id": 9167, "verse_number": "२-९०-२०", "content_sanskrit": "त्वय्येतत्पुरुषव्याघ्र युक्तं राघववंशजे ।\nगुरुवृत्तिर्दमश्चैव साधूनां चानुयायिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000167020, "chapter_id": 9167, "verse_number": "२-९०-२१", "content_sanskrit": "जाने चैतन्मन:स्थं ते दृढीकरणमस्त्विति ।\nअपृच्छं त्वां तथात्यर्थं कीर्त्तिं समभिवर्द्धयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000167021, "chapter_id": 9167, "verse_number": "२-९०-२२", "content_sanskrit": "जाने च रामं धर्म्मज्ञं ससीतं सहलक्ष्मणम् ।\nअसौ वसति ते भ्राता चित्रकूटे महागिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000167022, "chapter_id": 9167, "verse_number": "२-९०-२३", "content_sanskrit": "श्वस्तु गन्तासि तं देशं वसाद्य सह मन्त्रिभि: ।\nएतं मे कुरु सुप्राज्ञ कामं कामार्थकोविद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000167023, "chapter_id": 9167, "verse_number": "२-९०-२४", "content_sanskrit": "ततस्तथेत्येवमुदारदर्शन: प्रतीतरूपो भरतो ऽब्रवीद्वच: ।\nचकार बुद्धिं च तदा तदाश्रमे निशानिवासाय नराधिपात्मज: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000167024, "chapter_id": 9167, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे नवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]