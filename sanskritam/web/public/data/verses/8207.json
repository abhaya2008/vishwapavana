[{"id": 900001055, "chapter_id": 8207, "verse_number": "6.1", "content_sanskrit": "आविः सन्निहितं गुहाचरं नाम महत् पदम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001056, "chapter_id": 8207, "verse_number": "6.2", "content_sanskrit": "प्रणवो धनुः शरो ह्यात्मा ब्रह्म तलक्ष्यमुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001057, "chapter_id": 8207, "verse_number": "6.3", "content_sanskrit": "यस्मिन् द्यौः पृथिवी चान्तरिक्ष- मतं मनः सह प्राणैश्च सर्वैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001058, "chapter_id": 8207, "verse_number": "6.4", "content_sanskrit": "अरा इव रथनाभौ संहता यत्र नाड्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001059, "chapter_id": 8207, "verse_number": "6.5", "content_sanskrit": "ओमित्येव ध्यायत आत्मानं स्वस्ति वः पराय तमसः परस्तात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001060, "chapter_id": 8207, "verse_number": "6.6", "content_sanskrit": "यः सर्वज्ञः सर्वविद् यस्यैष महिमा भुवि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001061, "chapter_id": 8207, "verse_number": "6.7", "content_sanskrit": "मनोमयः प्राणशरीरनेता प्रतिष्ठितोsन्ने हृदयं सन्निधाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001062, "chapter_id": 8207, "verse_number": "6.8", "content_sanskrit": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001063, "chapter_id": 8207, "verse_number": "6.9", "content_sanskrit": "हिरण्मये परे कोशे विरजं ब्रह्म निष्कलम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001064, "chapter_id": 8207, "verse_number": "6.10", "content_sanskrit": "न तत्र सूर्यो भाति न चन्द्रतारकं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001065, "chapter_id": 8207, "verse_number": "6.11", "content_sanskrit": "ब्रह्मैवेदममृतं पुरस्तात् ब्रह्म पश्चाद्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]