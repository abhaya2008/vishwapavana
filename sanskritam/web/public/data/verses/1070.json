[{"id": 2003616, "chapter_id": 1070, "verse_number": "१-७१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003617, "chapter_id": 1070, "verse_number": "१-७१-१", "content_sanskrit": "समावृतव्रतं तं तु विसृष्टं गुरुणा कचम्।\nप्रस्थितं त्रिदशावासं देवयान्यब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003618, "chapter_id": 1070, "verse_number": "१-७१-२", "content_sanskrit": "ऋषेरङ्गिरसः पौत्र वृत्तेनाभिजनेन च।\nभ्राजसे विद्यया चैव तपसा च दमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003619, "chapter_id": 1070, "verse_number": "१-७१-३", "content_sanskrit": "ऋषिर्यथाङ्गिरा मान्यः पितुर्मम महायशाः।\nतथा प्रान्यश्च पूज्यश्च मम भूयो बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003620, "chapter_id": 1070, "verse_number": "१-७१-४", "content_sanskrit": "एवं ज्ञात्वा विजानीहि यद्ब्रवीमि तपोधन।\nव्रतस्थे नियमोपेते यथा वर्ताम्यहं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003621, "chapter_id": 1070, "verse_number": "१-७१-५", "content_sanskrit": "स समावृतविद्यो मां भक्तां भजितुमर्हसि।\nगृहाण पाणिं विधिवन्मम मन्त्रपुरस्कृतम्॥\nकच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003622, "chapter_id": 1070, "verse_number": "१-७१-६", "content_sanskrit": "पूज्यो मान्यश्च भगवान्यथा तव पिता मम।\nतथा त्वमनवद्याङ्गि पूजनीयतरा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003623, "chapter_id": 1070, "verse_number": "१-७१-७", "content_sanskrit": "प्राणेभ्योऽपि प्रियतरा भार्गवस्य महात्मनः।\nत्वं भत्रे धर्मतः पूज्या गुरुपुत्री सदा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003624, "chapter_id": 1070, "verse_number": "१-७१-८", "content_sanskrit": "यथा मम गुरुर्नित्यं मान्यः शुक्रः पिता तव।\nदेवयानि तथैव त्वं नैवं मां वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003625, "chapter_id": 1070, "verse_number": "१-७१-९x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003626, "chapter_id": 1070, "verse_number": "१-७१-९", "content_sanskrit": "गुरुपुत्रस्य पुत्रो वै न त्वं पुत्रश्च मे पितुः।\nतस्मात्पूज्यश्च मान्यश्च ममापि त्वं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003627, "chapter_id": 1070, "verse_number": "१-७१-१०", "content_sanskrit": "असुरैर्हन्यमाने च कच त्वयि पुनःपुनः।\nतदाप्रभृति या प्रीतिस्तां त्वमद्य स्मरस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003628, "chapter_id": 1070, "verse_number": "१-७१-११", "content_sanskrit": "सौहार्दे चानुरागे च वेत्थ मे भक्तिमुत्तमाम्।\nन मामर्हसि धर्मज्ञ त्यक्तुं भक्तामनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003629, "chapter_id": 1070, "verse_number": "१-७१-१२x", "content_sanskrit": "कच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003630, "chapter_id": 1070, "verse_number": "१-७१-१२", "content_sanskrit": "अनियोज्ये नियोक्तुं मां देवयानि न चार्हसि।\nप्रसीद सुभ्रु त्वं मह्यं गुरोर्गुरुतरा शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003631, "chapter_id": 1070, "verse_number": "१-७१-१३", "content_sanskrit": "यत्रोषितं विशालाक्षि त्वया चन्द्रनिभानने।\nतत्राहमुषितो भद्रे कुक्षौ काव्यस्य भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003632, "chapter_id": 1070, "verse_number": "१-७१-१४", "content_sanskrit": "भगिनी धर्मतो मे त्वं मैवं वोचः सुमध्यमे।\nसुखमस्म्युषितो भद्रे न मन्युर्विद्यते मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003633, "chapter_id": 1070, "verse_number": "१-७१-१५", "content_sanskrit": "आपृच्छे त्वां गमिष्यामि शिवमाशंस मे पथि।\nअविरोधेन धर्मस्य स्मर्तव्योऽस्मि कथान्तरे।\nअप्रमत्तोत्थिता नित्यमाराधय गुरुं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003634, "chapter_id": 1070, "verse_number": "१-७१-१६x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003635, "chapter_id": 1070, "verse_number": "१-७१-१६", "content_sanskrit": "यदि मां धर्मकामार्थे प्रत्याख्यास्यसि याचितः।\nततः कच न ते विद्या सिद्धिमेषा गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003636, "chapter_id": 1070, "verse_number": "१-७१-१७x", "content_sanskrit": "कच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003637, "chapter_id": 1070, "verse_number": "१-७१-१७", "content_sanskrit": "गुरुपुत्रीति कृत्वाऽहं प्रत्याचक्षे न दोषतः।\nगुरुणा चाननुज्ञातः काममेवं शपस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003638, "chapter_id": 1070, "verse_number": "१-७१-१८", "content_sanskrit": "आर्षं धर्मं ब्रुवाणोऽहं देवयानि यथा त्वया।\nशप्तो ह्यनर्हः शापस्य कामतोऽद्य न धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003639, "chapter_id": 1070, "verse_number": "१-७१-१९", "content_sanskrit": "तस्माद्भवत्या यः कामो न तथा स भविष्यति।\nऋषिपुत्रो न ते कश्चिज्जातु पाणिं ग्रहीष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003640, "chapter_id": 1070, "verse_number": "१-७१-२०", "content_sanskrit": "फलिष्यति न ते विद्या यत्त्वं मामात्थ तत्तथा।\nअध्यापयिष्यामि तु यं तस्य विद्या फलिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003641, "chapter_id": 1070, "verse_number": "१-७१-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003642, "chapter_id": 1070, "verse_number": "१-७१-२१", "content_sanskrit": "एवमुक्त्वा द्विजश्रेष्ठो देवयानीं कचस्तदा।\nत्रिदशेशालयं शीघ्रं जगाम द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003643, "chapter_id": 1070, "verse_number": "१-७१-२२", "content_sanskrit": "तमागतमभिप्रेक्ष्य देवा इन्द्रपुरोगमाः।\nबृहस्पतिं सभाज्येदं कचं वचनमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003644, "chapter_id": 1070, "verse_number": "१-७१-२३x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003645, "chapter_id": 1070, "verse_number": "१-७१-२३", "content_sanskrit": "यत्त्वयास्मद्धितं कर्म कृतं वै परमाद्भुतम्।\nन ते यशः प्रणशिता भागभाक्व भविष्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003646, "chapter_id": 1070, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकसप्ततितमोऽध्यायः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]