[{"id": 7004088000, "chapter_id": 24088, "verse_number": "४-३७-१", "content_sanskrit": "स्कंद उवाच ।\nसदा गृही सुखं भुंक्ते स्त्री लक्षणवती यदि ।\nअतः सुखसमृद्ध्यर्थमादौ लक्षणमीक्षयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004088001, "chapter_id": 24088, "verse_number": "४-३७-२", "content_sanskrit": "वपुरावर्तगंधाश्चच्छाया सत्वं स्वरो गतिः ।\nवर्णश्चेत्यष्टधा प्रोक्ता बुधैर्लक्षणभूमिका ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004088002, "chapter_id": 24088, "verse_number": "४-३७-३", "content_sanskrit": "आपादतलमारभ्य यावन्मौलिरुहं क्रमात् ।\nशुभाशुभानि वक्ष्यामि लक्षणानि मुने शृणु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004088003, "chapter_id": 24088, "verse_number": "४-३७-४", "content_sanskrit": "आदौ पादतलं रेखास्ततोंगुष्ठांगुली नखाः ।\nपृष्ठगुल्फद्वयं पार्ष्णी जंघे रोमाणि जानुनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004088004, "chapter_id": 24088, "verse_number": "४-३७-५", "content_sanskrit": "ऊरू कटी नितंबस्फिग्भगो जघन बस्तिके ।\nनाभिः कुक्षिद्वयं पार्श्वोदरमध्य वलित्रयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004088005, "chapter_id": 24088, "verse_number": "४-३७-६", "content_sanskrit": "रोमाली हृदयं वक्षो वक्षोजद्वयचूचुकम् ।\nजत्रुस्कंधां सकक्षादोर्मणिबंध करद्वयम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004088006, "chapter_id": 24088, "verse_number": "४-३७-७", "content_sanskrit": "पाणिपृष्ठं पाणितलं रेखांगुष्ठांगुली नखाः ।\nपृष्ठिः कृकाटिका कंठे चिबुकं च हनुद्वयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004088007, "chapter_id": 24088, "verse_number": "४-३७-८", "content_sanskrit": "कपोलौ वक्त्रमधरोत्तरोष्ठौ द्विजजिह्विकाः ।\nघंटिका तालुहसितं नासिकाक्षुतमक्षिणी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004088008, "chapter_id": 24088, "verse_number": "४-३७-९", "content_sanskrit": "पक्ष्म भ्रूकर्णभालानि मौलि सीमंतमौलिजाः ।\nषष्टिः षडुत्तरायोषिदंगलक्षणसत्खनिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004088009, "chapter_id": 24088, "verse_number": "४-३७-१०", "content_sanskrit": "स्त्रीणां पादतलं स्निग्धं मांसलं मृदुलं समम् ।\nअस्वेदमुष्णमरुणं बहुभोगोचितं स्मृतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004088010, "chapter_id": 24088, "verse_number": "४-३७-११", "content_sanskrit": "रूक्षं विवर्णं परुषं खंडितप्रतिबिंबकम् ।\nशूर्पाकारं विशुष्कं च दुःखदौर्भाग्यसूचकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004088011, "chapter_id": 24088, "verse_number": "४-३७-१२", "content_sanskrit": "चक्र स्वस्तिक शंखाब्ज ध्वजमीनातपत्रवत् ।\nयस्याः पादतले रेखा सा भवेत्क्षितिपांगना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004088012, "chapter_id": 24088, "verse_number": "४-३७-१३", "content_sanskrit": "भवेदखंडभोगायोर्द्ध्वामध्यांगुलिसंगता ।\nरेखाखु सर्पकाकाभा दुःखदारिद्र्यसूचिका ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004088013, "chapter_id": 24088, "verse_number": "४-३७-१४", "content_sanskrit": "उन्नतो मांसलोंगुष्ठो वर्तुलोतुलभोगदः ।\nवक्रो ह्रस्वश्च चिपिटः सुखसौभाग्यभंजकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004088014, "chapter_id": 24088, "verse_number": "४-३७-१५", "content_sanskrit": "विधवा विपुलेन स्याद्दीर्घांगुष्ठेन दुर्भगा ।\nमृदवोंगुलयः शस्ता घनावृत्ताः समुन्नताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004088015, "chapter_id": 24088, "verse_number": "४-३७-१६", "content_sanskrit": "दीर्घांगुलीभिः कुलटा कृशाभिरतिनिर्धना ।\nह्रस्वायुष्या च ह्रस्वाभिर्भुग्नाभिर्भुग्नवर्तिनी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004088016, "chapter_id": 24088, "verse_number": "४-३७-१७", "content_sanskrit": "चिपिटाभिर्भवेद्दासी विरलाभिर्दरिद्रिणी ।\nपरस्परं समारूढाः पादांगुल्यो भवंति हि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004088017, "chapter_id": 24088, "verse_number": "४-३७-१८", "content_sanskrit": "हत्वा बहूनपि पतीन्परप्रेष्या तदा भवेत् ।\nयस्याः पथि समायांत्या रजोभूमेः समुच्छलेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004088018, "chapter_id": 24088, "verse_number": "४-३७-१९", "content_sanskrit": "सा पांसुला प्रजायेत कुलत्रयविनाशिनी ।\nयस्याः कनिष्ठिका भूमिं न गच्छंत्याः परिस्पृशेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004088019, "chapter_id": 24088, "verse_number": "४-३७-२०", "content_sanskrit": "सा निहत्य पतिं योषा द्वितीयं कुरुते पतिम् ।\nअनामिका च मध्या च यस्या भूमिं न संस्पृशेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004088020, "chapter_id": 24088, "verse_number": "४-३७-२१", "content_sanskrit": "पतिद्वयं निहंत्याद्या द्वितीया च पतित्रयम् ।\nपतिहीनत्वकारिण्यौ हीने ते द्वे इमे यदि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004088021, "chapter_id": 24088, "verse_number": "४-३७-२२", "content_sanskrit": "प्रदेशिनी भवेद्यस्या अंगुष्ठाव्यतिरेकिणी ।\nकन्यैव कुलटा सा स्यादेष एव विनिश्चयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004088022, "chapter_id": 24088, "verse_number": "४-३७-२३", "content_sanskrit": "स्निग्धाः समुन्नतास्ताम्रा वृत्ताः पादनखाः शुभाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004088023, "chapter_id": 24088, "verse_number": "४-३७-२४", "content_sanskrit": "राज्ञीत्वसूचकं स्त्रीणां पादपृष्ठं समुन्नतम् ।\nअस्वेदमशिराढ्यं च मसृणं मृदुमांसलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004088024, "chapter_id": 24088, "verse_number": "४-३७-२५", "content_sanskrit": "दरिद्रा मध्यनम्रेण शिरालेन सदाध्वगा ।\nरोमाढ्येन भवेद्दासी निर्मांसेन च दुर्भगा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004088025, "chapter_id": 24088, "verse_number": "४-३७-२६", "content_sanskrit": "गूढौ गुल्फौ शिवायोक्तावशिरालौ सुवर्तुलौ ।\nस्थपुटौ शिथिलौ दृश्यौ स्यातां दौर्भाग्यसूचकौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004088026, "chapter_id": 24088, "verse_number": "४-३७-२७", "content_sanskrit": "समपार्ष्णिः शुभा नारी पृथुपार्ष्णिश्च दुर्भगा ।\nकुलटोन्नतपार्ष्णि स्याद्दीर्घपार्ष्णिश्च दुःखभाक् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004088027, "chapter_id": 24088, "verse_number": "४-३७-२८", "content_sanskrit": "रोमहीने समे स्निग्धे यज्जंघे क्रमवर्तुले ।\nसा राजपत्नी भवति विशिरेसुमनोहरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004088028, "chapter_id": 24088, "verse_number": "४-३७-२९", "content_sanskrit": "एकरोमा राजपत्नी द्विरोमा च सुखावहा ।\nत्रिरोमा रोमकूपेषु भवेद्वैधव्यदुःखभाक् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004088029, "chapter_id": 24088, "verse_number": "४-३७-३०", "content_sanskrit": "वृत्तं पिशितसंलग्नं जानुयुग्मं प्रशस्यते ।\nनिर्मांसं स्वैरचारिण्या दरिद्रा याश्च विश्लथम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004088030, "chapter_id": 24088, "verse_number": "४-३७-३१", "content_sanskrit": "विशिरैः करभाकारैरूरुभिर्मसृणैर्घनैः ।\nसुवृत्तैरोमरहितैर्भवेयुर्भूपवल्लभाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004088031, "chapter_id": 24088, "verse_number": "४-३७-३२", "content_sanskrit": "वैधव्यं रोमशैरुक्तं दौर्भाग्यं चिपिटैरपि ।\nमध्यच्छिद्रैर्महादुःखं दारिद्र्यं कठिनत्वचैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004088032, "chapter_id": 24088, "verse_number": "४-३७-३३", "content_sanskrit": "चतुर्भिरंगुलैः शस्ता कटिर्विंशतिसंयुतैः ।\nसमुन्नतनितंबाढ्या चतुरस्रा मृगीदृशाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004088033, "chapter_id": 24088, "verse_number": "४-३७-३४", "content_sanskrit": "विनता चिपिटा दीर्घा निर्मांसासंकटाकटिः ।\nह्रस्वा रोमयुता नार्या दुःखवैधव्यसूचिका ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004088034, "chapter_id": 24088, "verse_number": "४-३७-३५", "content_sanskrit": "नितंबबिंबो नारीणामुन्नतो मांसलः पृथुः ।\nमहाभोगाय संप्रोक्तस्तदन्योऽशर्मणे मतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004088035, "chapter_id": 24088, "verse_number": "४-३७-३६", "content_sanskrit": "कपित्थफलवद्वृत्तौ मृदुलौ मांसलौ घनौ ।\nस्फिचौ वलिविनिर्मुक्तौ रतिसौख्यविवर्धनौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004088036, "chapter_id": 24088, "verse_number": "४-३७-३७", "content_sanskrit": "शुभः कमठपृष्ठाभो गजस्कंधोपमो भगः ।\nवामोन्नतस्तु कन्याजः पुत्रजो दक्षिणोन्नतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004088037, "chapter_id": 24088, "verse_number": "४-३७-३८", "content_sanskrit": "आखुरोमा गूढमणिः सुश्लिष्टः संहतः पृथुः ।\nतुंगः कमलपर्णाभः शुभोश्वत्थदलाकृतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004088038, "chapter_id": 24088, "verse_number": "४-३७-३९", "content_sanskrit": "कुरंगखुररूपोयश्चुल्लिकोदरसन्निभः ।\nरोमशो विवृतास्यश्च दृश्यनासोतिदुर्भगः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004088039, "chapter_id": 24088, "verse_number": "४-३७-४०", "content_sanskrit": "शंखावर्तो भगो यस्याः सा गर्भमिह नेच्छति ।\nचिपिटः खर्पराकारः किंकरी पददो भगः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004088040, "chapter_id": 24088, "verse_number": "४-३७-४१", "content_sanskrit": "वंशवेतसपत्राभो गजरोमोच्चनासिकः ।\nविकटः कुटिलाकारो लंबगल्लस्तथाऽशुभः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004088041, "chapter_id": 24088, "verse_number": "४-३७-४२", "content_sanskrit": "भगस्य भालं जघनं विस्तीर्णं तुंगमांसलम् ।\nमृदुलं मृदुलोमाढ्यं दक्षिणावर्तमीडितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004088042, "chapter_id": 24088, "verse_number": "४-३७-४३", "content_sanskrit": "वामावर्तं च निर्मांसं भुग्नवैधव्यसूचकम् ।\nसंकटस्थपुटं रूक्षं जघनं दुःखदं सदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004088043, "chapter_id": 24088, "verse_number": "४-३७-४४", "content_sanskrit": "बस्तिः प्रशस्ता विपुला मृद्वीस्तोकसमुन्नता ।\nरोमशा च शिराला च रेखांका नैव शोभना ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004088044, "chapter_id": 24088, "verse_number": "४-३७-४५", "content_sanskrit": "गंभीरा दक्षिणावर्ता नाभी स्यात्सुखसंपदे ।\nवामावर्ता समुत्ताना व्यक्तग्रंथिर्न शोभना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004088045, "chapter_id": 24088, "verse_number": "४-३७-४६", "content_sanskrit": "सूते सुतान्बहून्नारी पृथुकुक्षिः सुखास्पदम् ।\nक्षितीशं जनयेत्पुत्रं मंडूकाभेन कुक्षिणा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004088046, "chapter_id": 24088, "verse_number": "४-३७-४७", "content_sanskrit": "उन्नतेन वलीभाजा सावर्तेनापि कुक्षिणा ।\nवंध्या प्रव्रजिता दासी क्रमाद्योषा भवेदिह ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004088047, "chapter_id": 24088, "verse_number": "४-३७-४८", "content_sanskrit": "समैः समांसैर्मृदुभिर्योषिन्मग्नास्थिभिः शुभैः ।\nपार्श्वेः सौभाग्यसुखयोर्निधानं स्यादसंशयम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004088048, "chapter_id": 24088, "verse_number": "४-३७-४९", "content_sanskrit": "यस्यादृश्य शिरे पार्श्वे उन्नते रोमसंयुते ।\nनिरपत्या च दुःशीला सा भवेद्दुःखशेवधिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004088049, "chapter_id": 24088, "verse_number": "४-३७-५०", "content_sanskrit": "उदरेणातितुच्छेन विशिरेण मृदुत्वचा ।\nयोषिद्भवति भोगाढ्या नित्यं मिष्टान्नसेविनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004088050, "chapter_id": 24088, "verse_number": "४-३७-५१", "content_sanskrit": "कुंभाकारं दरिद्राया जठरं च मृदंगवत् ।\nकूष्मांडाभं यवाभं च दुष्पूरं जायते स्त्रियाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004088051, "chapter_id": 24088, "verse_number": "४-३७-५२", "content_sanskrit": "सुविशालोदरी नारी निरपत्या च दुर्भगा ।\nप्रलंबजठरा हंति श्वशुरं चापि देवरम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004088052, "chapter_id": 24088, "verse_number": "४-३७-५३", "content_sanskrit": "मध्यक्षामा च सुभगा भोगाढ्या सवलित्रया ।\nऋज्वी तन्वी च रोमाली यस्याः सा शर्मनर्मभूः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004088053, "chapter_id": 24088, "verse_number": "४-३७-५४", "content_sanskrit": "कपिला कुटिला स्थूला विच्छिन्ना रोमराजिका ।\nचौर वैधव्य दौर्भाग्यं विदध्यादिह योषिताम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004088054, "chapter_id": 24088, "verse_number": "४-३७-५५", "content_sanskrit": "निर्लोमहृदयं यस्याः समं निम्नत्व वर्जितम् ।\nऐश्वर्यं चाप्यवैधव्यं प्रियप्रेम च सा लभेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004088055, "chapter_id": 24088, "verse_number": "४-३७-५६", "content_sanskrit": "विस्तीर्णहृदया योषा पुंश्चली निर्दया तथा ।\nउद्भिन्नरोमहृदया पतिं हंति विनिश्चितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004088056, "chapter_id": 24088, "verse_number": "४-३७-५७", "content_sanskrit": "अष्टादशांगुलततमुरः पीवरमुन्नतम् ।\nसुखाय दुःखाय भवेद्रोमशं विषमं पृथु ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004088057, "chapter_id": 24088, "verse_number": "४-३७-५८", "content_sanskrit": "घनौ वृत्तौ दृढौ पीनौ समौ शस्तौ पयोधरौ ।\nस्थूलाग्रौ विरलौ शुष्कौ वामोरूणां न शर्मदौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004088058, "chapter_id": 24088, "verse_number": "४-३७-५९", "content_sanskrit": "दक्षिणोन्नत वक्षोजा पुत्रिणी त्वग्रणीर्मता ।\nवामोन्नतकुचा सूते कन्यां सौभाग्यसुंदरीम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004088059, "chapter_id": 24088, "verse_number": "४-३७-६०", "content_sanskrit": "अरघट्टघटीतुल्यौ कुचौ दौःशील्यसूचकौ ।\nपीवरास्यौ सांतरालौ पृथूपांतौ न शोभनौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004088060, "chapter_id": 24088, "verse_number": "४-३७-६१", "content_sanskrit": "मूले स्थूलौ क्रमकृशावग्रे तीक्ष्णौ पयोधरौ ।\nसुखदौ पूर्वकाले तु पश्चादत्यंत दुःखदौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004088061, "chapter_id": 24088, "verse_number": "४-३७-६२", "content_sanskrit": "सुदृढं चूचुकयुगं शस्तं श्यामं सुवर्तुलम् ।\nअंतर्मग्नं च दीर्घं च कृशं क्लेशाय जायते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004088062, "chapter_id": 24088, "verse_number": "४-३७-६३", "content_sanskrit": "पीवराभ्यां च जत्रुभ्यां धनधान्यनिधिर्वधूः ।\nश्लथास्थिभ्यां च निम्नाभ्यां विषमाभ्यां दरिद्रिणी ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004088063, "chapter_id": 24088, "verse_number": "४-३७-६४", "content_sanskrit": "अबद्धावनतौ स्कंधावदीर्घावकृशौ शुभौ ।\nवक्रौ स्थूलौ च रोमाढ्यौ प्रेष्य वैधव्यसूचकौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004088064, "chapter_id": 24088, "verse_number": "४-३७-६५", "content_sanskrit": "निगूढसंधी स्रस्ताग्रौ शुभावंसौ सुसंहतौ ।\nवैधव्यदौ समुच्चाग्रौ निर्मांसावतिदुःखदौ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004088065, "chapter_id": 24088, "verse_number": "४-३७-६६", "content_sanskrit": "कक्षेसु सूक्ष्मरोमे तु तुंगे स्निग्धे च मांसले ।\nशस्तेन शस्ते गंभीरे शिराले स्वेदमेदुरे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004088066, "chapter_id": 24088, "verse_number": "४-३७-६७", "content_sanskrit": "स्यातां दोषौ सुनिर्दोषौ गूढास्थि ग्रंथिकोमलौ ।\nविशिरौ च विरोमाणौ सरलौ हरिणीदृशाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004088067, "chapter_id": 24088, "verse_number": "४-३७-६८", "content_sanskrit": "वैधव्यं स्थूलरोमाणौ ह्रस्वौ दौर्भाग्यसूचकौ ।\nपरिक्लेशाय नारीणां परिदृश्यशिरौ भुजौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004088068, "chapter_id": 24088, "verse_number": "४-३७-६९", "content_sanskrit": "अंभोज मुकुलाकारमंगुष्ठांगुलिसंमुखम् ।\nहस्तद्वयं मृगाक्षीणां बहुभोगाय जायते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004088069, "chapter_id": 24088, "verse_number": "४-३७-७०", "content_sanskrit": "मृदुमध्योन्नतं रक्तं तलं पाण्योररंध्रकम् ।\nप्रशस्तं शस्तरेखाढ्यमल्परेखं शुभश्रियम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004088070, "chapter_id": 24088, "verse_number": "४-३७-७१", "content_sanskrit": "विधवा बहुरेखेण विरेखेण दरिद्रिणी ।\nभिक्षुकी सुशिराढ्येन नारी करतलेन वै ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004088071, "chapter_id": 24088, "verse_number": "४-३७-७२", "content_sanskrit": "विरोम विशिरं शस्तं पाणिपृष्ठंसमुन्नतम् ।\nवैधव्यहेतुरोमाढ्यं निर्मांसं स्नायुमत्त्यजेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004088072, "chapter_id": 24088, "verse_number": "४-३७-७३", "content_sanskrit": "रक्ता व्यक्ता गभीरा च स्निग्धा पूर्णा च वर्तुला ।\nकररेखांगना याः स्याच्छुभा भाग्यानुसारतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004088073, "chapter_id": 24088, "verse_number": "४-३७-७४", "content_sanskrit": "मत्स्येन सुभगा नारी स्वस्तिकेन वसुप्रदा ।\nपद्मेन भूपतेः पत्नी जनयेद्भूपतिं सुतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004088074, "chapter_id": 24088, "verse_number": "४-३७-७५", "content_sanskrit": "चक्रवर्तिस्त्रियाः पाणौ नंद्यावर्तः प्रदक्षिणः ।\nशंखातपत्रक मठा नृपमातृत्वसूचकाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004088075, "chapter_id": 24088, "verse_number": "४-३७-७६", "content_sanskrit": "तुलामानाकृतीरेखे वणिक्पत्नीत्वहेतुके ।\nगजवाजिवृषाकाराः करे वामे मृगीदृशाम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004088076, "chapter_id": 24088, "verse_number": "४-३७-७७", "content_sanskrit": "रेखा प्रासादवज्राभा ब्रूयुस्तीर्थकरं सुतम् ।\nकृषीवलस्य पत्नी स्याच्छकटेन युगेन वा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004088077, "chapter_id": 24088, "verse_number": "४-३७-७८", "content_sanskrit": "चामरांकुशकोदंडै राजपत्नी भवेद्ध्रुवम् ।\nअंगुष्ठमूलान्निर्गत्य रेखा याति कनिष्ठिकाम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004088078, "chapter_id": 24088, "verse_number": "४-३७-७९", "content_sanskrit": "यदि सा पतिहंत्री स्याद्दूरतस्तां त्यजेत्सुधीः ।\nत्रिशूलासिगदाशक्ति दुंदुभ्याकृति रेखया ।\nनितंबिनी कीर्तिमती त्यागेन पृथिवीतले ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004088079, "chapter_id": 24088, "verse_number": "४-३७-८०", "content_sanskrit": "कंक जंबूक मंडूक वृक वृश्चिक भोगिनः ।\nरासभोष्ट्र बिडालाः स्युः करस्था दुःखदाः स्त्रियाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004088080, "chapter_id": 24088, "verse_number": "४-३७-८१", "content_sanskrit": "शुभदः सरलोंगुष्ठो वृत्तो वृत्तनखो मृदुः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004088081, "chapter_id": 24088, "verse_number": "४-३७-८२", "content_sanskrit": "अंगुल्यश्च सुपर्वाणो दीर्घावृत्ताः क्रमात्कृशाः ।\nचिपिटाःस्थपुटा रूक्षाः पृष्ठरोमयुजोऽशुभाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004088082, "chapter_id": 24088, "verse_number": "४-३७-८३", "content_sanskrit": "अतिह्रस्वाः कृशा वक्रा विरला रोगहेतुकाः ।\nदुःखायांगुलयः स्त्रीणां बहुपर्वसमन्विताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004088083, "chapter_id": 24088, "verse_number": "४-३७-८४", "content_sanskrit": "अरुणाः सशिखास्तुंगाः करजाः सुदृशांशुभाः ।\nनिम्ना विवर्णाः शुक्त्याभाः पीता दारिद्र्यदायकाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004088084, "chapter_id": 24088, "verse_number": "४-३७-८५", "content_sanskrit": "नखेषु बिंदवः श्वेताः प्रायः स्युः स्वैरिणी स्त्रियाः ।\nपुरुषा अपि जायंते दुःखिनः पुष्पितैर्नखैः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004088085, "chapter_id": 24088, "verse_number": "४-३७-८६", "content_sanskrit": "अंतर्निमग्नवंशास्थिः पृष्ठिः स्यान्मांसला शुभा ।\nपृष्ठेन रोमयुक्तेन वैधव्यं लभते ध्रुवम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004088086, "chapter_id": 24088, "verse_number": "४-३७-८७", "content_sanskrit": "भुग्नेन विनतेनापि सशिरेणापि दुःखिता ।\nऋज्वी कृकाटिका श्रेष्ठा समांसा च समुन्नता ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004088087, "chapter_id": 24088, "verse_number": "४-३७-८८", "content_sanskrit": "शुष्का शिराला रोमाढ्या विशाला कुटिलाशुभा ।\nमांसलो वर्तुलः कंठः प्रशस्तश्चतुरंगुलः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004088088, "chapter_id": 24088, "verse_number": "४-३७-८९", "content_sanskrit": "शस्ता ग्रीवा त्रिरेखांका त्वव्यक्तास्थिः सुसंहता ।\nनिर्मांसा चिपिटा दीर्घास्थपुटा न शुभप्रदा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004088089, "chapter_id": 24088, "verse_number": "४-३७-९०", "content_sanskrit": "स्थूलग्रीवा च विधवा वक्रग्रीवा च किंकरी ।\nवंध्या द्विचिपिटग्रीवा ह्रस्वग्रीवा च निःसुता ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004088090, "chapter_id": 24088, "verse_number": "४-३७-९१", "content_sanskrit": "चिबुकंद्वयंगुलं शस्तं वृत्तं पीनं सुकोमलम् ।\nस्थूलं द्विधा संविभक्तमायतं रोमशं त्यजेत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004088091, "chapter_id": 24088, "verse_number": "४-३७-९२", "content_sanskrit": "हनुश्चिबुकसंलग्ना निर्लोमा सुघनाशुभा ।\nवक्रा स्थूला कृशा ह्रस्वा रोमशा न शुभप्रदा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004088092, "chapter_id": 24088, "verse_number": "४-३७-९३", "content_sanskrit": "शस्तौ कपोलौ वामाक्ष्याः पीनौ वृत्तौ समुन्नतौ ।\nरोमशौ परुषौ निम्नौ निर्मांसौ परिवर्जयेत् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004088093, "chapter_id": 24088, "verse_number": "४-३७-९४", "content_sanskrit": "समं समांसं सुस्निग्धं स्वामोदं वर्तुलं मुखम् ।\nजनेतृवदनच्छायं धन्यानामिह जायते ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004088094, "chapter_id": 24088, "verse_number": "४-३७-९५", "content_sanskrit": "पाटलो वर्तुलः स्निग्धो लेखाभूषितमध्यभूः ।\nसीमंतिनी नामधरो धराजानि प्रियो भवेत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004088095, "chapter_id": 24088, "verse_number": "४-३७-९६", "content_sanskrit": "कृशः प्रलंबः स्फुटितो रूक्षो दौर्भाग्यसूचकः ।\nश्यावः स्थूलोऽधरोष्ठः स्याद्वैधव्य कलहप्रदः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004088096, "chapter_id": 24088, "verse_number": "४-३७-९७", "content_sanskrit": "मसृणो मत्तकाशिन्याश्चोत्तरोष्ठः सुभोगदः ।\nकिंचिन्मध्योन्नतोऽरोमा विपरीतो विरुद्धकृत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004088097, "chapter_id": 24088, "verse_number": "४-३७-९८", "content_sanskrit": "गोक्षीरसन्निभाः स्निग्धा द्वात्रिंशद्दशनाः शुभाः ।\nअधस्तादुपरिष्टाच्च समाः स्तोकसमुन्नताः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004088098, "chapter_id": 24088, "verse_number": "४-३७-९९", "content_sanskrit": "पीताः श्यावाश्च दशनाः स्थूलादीर्घाद्विपंक्तयः ।\nशुक्त्याकाराश्च विरला दुःखदौर्भाग्यकारणम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004088099, "chapter_id": 24088, "verse_number": "४-३७-१००", "content_sanskrit": "अधस्तादधिकैर्दंतैर्मातरं भक्षयेत्स्फुटम् ।\nपतिहीना च विकटैः कुलटा विरलैर्भवेत् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004088100, "chapter_id": 24088, "verse_number": "४-३७-१०१", "content_sanskrit": "जिह्वेष्टमिष्टभोक्त्री स्याच्छोणामृद्वी तथासिता ।\nदुःखाय मध्यसंकीर्णा पुरोभागसविस्तरा ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004088101, "chapter_id": 24088, "verse_number": "४-३७-१०२", "content_sanskrit": "सितया तोयमरणं श्यामया कलहप्रिया ।\nदरिद्रिणी मांसलया लंबयाऽभक्ष्यभक्षिणी ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004088102, "chapter_id": 24088, "verse_number": "४-३७-१०३", "content_sanskrit": "विशालया रसनया प्रमदातिप्रमादभाक् ।\nस्निग्धं कोकनदाभासं प्रशस्तं तालुकोमलम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004088103, "chapter_id": 24088, "verse_number": "४-३७-१०४", "content_sanskrit": "सिते तालुनि वैधव्यं पीते प्रव्रजिता भवेत् ।\nकृष्णेऽपत्यवियोगार्ता रूक्षे भूरिकुटुंबिनी ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004088104, "chapter_id": 24088, "verse_number": "४-३७-१०५", "content_sanskrit": "कंठे स्थूला सुवृत्ता च क्रमतीक्ष्णा सुलोहिता ।\nअप्रलंबा शुभा घंटी स्थूला कृष्णा च दुःखदा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004088105, "chapter_id": 24088, "verse_number": "४-३७-१०६", "content_sanskrit": "अलक्षितद्विजं किंचित्किंचित्फुल्ल कपोलकम् ।\nस्मितं प्रशस्तं सुदृशामनिमीलितलोचनम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004088106, "chapter_id": 24088, "verse_number": "४-३७-१०७", "content_sanskrit": "समवृत्तपुटानासा लघुच्छिद्रा शुभावहा ।\nस्थूलाग्रा मध्यनम्रा च न प्रशस्ता समुन्नता ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004088107, "chapter_id": 24088, "verse_number": "४-३७-१०८", "content_sanskrit": "आकुंचितारुणाग्रा च वैधव्यक्लेशदायिनी ।\nपरप्रेष्या च चिपिटा ह्रस्वा दीर्घा कलिप्रिया ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004088108, "chapter_id": 24088, "verse_number": "४-३७-१०९", "content_sanskrit": "दीर्घायुः कृत्क्षुतं दीर्घं युगपद्द्वित्रिपिंडितम् ।\nललना लोचने शस्ते रक्तांते कृष्णतारके ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004088109, "chapter_id": 24088, "verse_number": "४-३७-११०", "content_sanskrit": "गोक्षीरवर्णविशदे सुस्निग्धे कृष्णपक्ष्मणी ।\nउन्नताक्षी न दीर्घायुर्वृत्ताक्षी कुलटा भवेत् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004088110, "chapter_id": 24088, "verse_number": "४-३७-१११", "content_sanskrit": "मेषाक्षीमहिषाक्षी च केकराक्षी न शोभना ।\nकामगृहीला नितरां गोपिंगाक्षी सुदुर्वृता ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004088111, "chapter_id": 24088, "verse_number": "४-३७-११२", "content_sanskrit": "पारावताक्षी दुःशीला रक्ताक्षी भर्तृघातिनी ।\nकोटरा नयना दुष्टा गजनेत्रा न शोभना ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004088112, "chapter_id": 24088, "verse_number": "४-३७-११३", "content_sanskrit": "पुंश्चली वामकाणाक्षी वंध्या दक्षिणकाणिका ।\nमधुपिंगाक्षी रमणी धनधान्यसमृद्धिभाक् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004088113, "chapter_id": 24088, "verse_number": "४-३७-११४", "content_sanskrit": "पक्ष्मभिः सुघनैः स्निग्धैः कृष्णैः सूक्ष्मैः सुभाग्यभाक् ।\nकपिलैर्विरलैः स्थूलैर्निंद्या भवति भामिनी ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004088114, "chapter_id": 24088, "verse_number": "४-३७-११५", "content_sanskrit": "भ्रुवौ सुवर्तुले तन्व्याः स्निग्धे कृष्णे असंहते ।\nप्रशस्ते मृदुरोमाणौ सुभ्रुवः कार्मुकाकृती ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004088115, "chapter_id": 24088, "verse_number": "४-३७-११६", "content_sanskrit": "खररोमा च पृथुला विकीर्णा सरला स्त्रियाः ।\nन भ्रूः प्रशस्ता मिलिता दीर्घरोमा च पिंगला ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004088116, "chapter_id": 24088, "verse_number": "४-३७-११७", "content_sanskrit": "लंबौ कर्णौ शुभावर्तौ सुखदौ च शुभप्रदौ ।\nशष्कुलीरहितौ निंद्यौ शिरालौ कुटिलौ कृशौ ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004088117, "chapter_id": 24088, "verse_number": "४-३७-११८", "content_sanskrit": "भालः शिराविरहितो निर्लोमार्धेंदु सन्निभः ।\nअनिम्नस्त्र्यंगुलो नार्याः सौभाग्यारोग्यकारणम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004088118, "chapter_id": 24088, "verse_number": "४-३७-११९", "content_sanskrit": "व्यक्त स्वस्तिकरेखं च ललाटं राज्यसंपदे ।\nप्रलंबं मस्तकं यस्या देवरं हन्ति सा ध्रुवम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004088119, "chapter_id": 24088, "verse_number": "४-३७-१२०", "content_sanskrit": "रोमशेन शिरालेन प्रांशुना रोगिणी मता ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004088120, "chapter_id": 24088, "verse_number": "४-३७-१२१", "content_sanskrit": "सीमन्तः सरलः शस्तो मौलिः शस्तः समुन्नतः ।\nगजकुंभनिभावृत्तैः सौभाग्यैश्वर्यसूचकैः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004088121, "chapter_id": 24088, "verse_number": "४-३७-१२२", "content_sanskrit": "स्थूलमूर्धा च विधवा दीर्घशीर्षा च बंधकी ।\nविशालेनापि शिरसा भवेद्दौर्भाग्यभाजनम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004088122, "chapter_id": 24088, "verse_number": "४-३७-१२३", "content_sanskrit": "केशा अलिकुलच्छायाः सूक्ष्माः स्निग्धाः सुकोमलाः ।\nकिंचिदाकुंचिताग्राश्च कुटिलाश्चातिशोभनाः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004088123, "chapter_id": 24088, "verse_number": "४-३७-१२४", "content_sanskrit": "परुषाः स्फुटिताग्राश्च विरलाश्च शिरोरुहाः ।\nपिंगला लघवो रूक्षा दुःखदारिद्र्यबंधदाः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004088124, "chapter_id": 24088, "verse_number": "४-३७-१२५", "content_sanskrit": "भ्रुवोरन्तर्ललाटे वा मशको राज्यसूचकः ।\nवामे कपोले मशकः शोणो मिष्टान्नदः स्त्रियाः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004088125, "chapter_id": 24088, "verse_number": "४-३७-१२६", "content_sanskrit": "तिलकं लांछनं वापि हृदि सौभाग्यकारणम् ।\nयस्या दक्षिणवक्षोजे शोणे तिलकलांछने ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004088126, "chapter_id": 24088, "verse_number": "४-३७-१२७", "content_sanskrit": "कन्या चतुष्टयं सूते सूते सा च सुतत्रयम् ।\nतिलकं लांछनं शोणं यस्या वामे कुचे भवेत् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004088127, "chapter_id": 24088, "verse_number": "४-३७-१२८", "content_sanskrit": "एकं पुत्रं प्रसूयादौ ततः सा विधवा भवेत् ।\nगुह्यस्य दक्षिणे भागे तिलकं यदि योषितः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004088128, "chapter_id": 24088, "verse_number": "४-३७-१२९", "content_sanskrit": "तदा क्षितिपतेः पत्नी सूते वा क्षितिपं सुतम् ।\nनासाग्रे मशकः शोणो महिष्या एव जायते ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004088129, "chapter_id": 24088, "verse_number": "४-३७-१३०", "content_sanskrit": "कृष्णः स एव भर्तृघ्न्याः पुंश्चल्याश्च प्रकीर्तितः ।\nनाभेरधस्तात्तिलकं मशको लांछनं शुभम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004088130, "chapter_id": 24088, "verse_number": "४-३७-१३१", "content_sanskrit": "मशकस्तिलकं चिह्नं गुल्फदेशे दरिद्रकृत ।\nकरे कर्णे कपोले वा कण्ठे वामे भवेद्यदि ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004088131, "chapter_id": 24088, "verse_number": "४-३७-१३२", "content_sanskrit": "एषां त्रयाणामेकं तु प्राग्गर्भे पुत्रदं भवेत् ।\nभालगेन त्रिशूलेन निर्मितेन स्वयंभुवा ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004088132, "chapter_id": 24088, "verse_number": "४-३७-१३३", "content_sanskrit": "नितंबिनी सहस्राणां स्वामित्वं योषिदाप्नुयात् ।\nसुप्ता परस्परं यातु दंतान्किटिकिटायते ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004088133, "chapter_id": 24088, "verse_number": "४-३७-१३४", "content_sanskrit": "सुलक्ष्मापि न सा शस्ता या किंचित्प्रलपेत्तथा ।\nपाणौ प्रदक्षिणावर्तो धर्म्यो वामो न शोभनः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004088134, "chapter_id": 24088, "verse_number": "४-३७-१३५", "content_sanskrit": "नाभौ श्रुतावुरसि वा दक्षिणावर्त ईडितः ।\nसुखाय दक्षिणावर्तः पृष्ठवंशस्य दक्षिणे ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004088135, "chapter_id": 24088, "verse_number": "४-३७-१३६", "content_sanskrit": "अन्तःपृष्ठं नाभिसमो बह्वायुः पुत्रवर्धनः ।\nराजपत्न्याः प्रदृश्येत भगमौलौ प्रदक्षिणः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004088136, "chapter_id": 24088, "verse_number": "४-३७-१३७", "content_sanskrit": "सचेच्छकटभंगःस्याद्बह्वपत्यसुखप्रदः ।\nकटिगो गुह्यवेधेन पत्यपत्यनिपातनः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004088137, "chapter_id": 24088, "verse_number": "४-३७-१३८", "content_sanskrit": "स्यातामुदरवेधेन पृष्ठावर्तौ न शोभनौ ।\nएकेन हंति भर्तारं भवेदन्येन पुं श्चली ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004088138, "chapter_id": 24088, "verse_number": "४-३७-१३९", "content_sanskrit": "कण्ठगो दक्षिणावर्तो दुःखवैधव्यहेतुकः ।\nसीमन्तेथ ललाटे वा त्याज्यो दूरात्प्रयत्नतः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004088139, "chapter_id": 24088, "verse_number": "४-३७-१४०", "content_sanskrit": "सा पतिं हंति वर्षेण यस्या मध्ये कृकाटिकम् ।\nप्रदक्षिणो वा वामो वा रोम्णामावर्त्तकः स्त्रियाः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004088140, "chapter_id": 24088, "verse_number": "४-३७-१४१", "content_sanskrit": "एको वा मूर्धनि द्वौ वा वामे वामगती यदि ।\nआदशाहं पतिघ्नौ तौ त्याज्यौ दूरात्सुबुद्धिना ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004088141, "chapter_id": 24088, "verse_number": "४-३७-१४२", "content_sanskrit": "कट्यावर्ता च कुलटा नाभ्यावर्ता पतिव्रता ।\nपृष्ठावर्ता च भर्तृघ्नी कुलटा वाथ जायते ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004088142, "chapter_id": 24088, "verse_number": "४-३७-१४३", "content_sanskrit": "स्कंद उवाच ।\nसुलक्षणापि दुःशीला कुलक्षण शिरोमणिः ।\nअलक्षणापि सा साध्वी सर्वलक्षणभूस्तु सा ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004088143, "chapter_id": 24088, "verse_number": "४-३७-१४४", "content_sanskrit": "सुलक्षणा सुचारित्रा स्वाधीना पतिदेवता ।\nविश्वेशानुग्रहादेव गृहे योषिदवाप्यते ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004088144, "chapter_id": 24088, "verse_number": "४-३७-१४५", "content_sanskrit": "अलकृताः स्ववासिन्यो याभिः प्राक्तनजन्मनि ।\nनानाविधैरलंकारैस्ताः सुरूपा भवंति हि ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004088145, "chapter_id": 24088, "verse_number": "४-३७-१४६", "content_sanskrit": "सुतीर्थेषु वपुर्याभिः क्षयितं वा विहायितम् ।\nता लावण्यतरंगिण्यो भवंतीह सुलक्षणाः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004088146, "chapter_id": 24088, "verse_number": "४-३७-१४७", "content_sanskrit": "अर्चिता जगतां माता याभिर्मृडवधूरिव ।\nता भवंति सुचारित्रा योषाः स्वाधीनभ र्तृकाः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004088147, "chapter_id": 24088, "verse_number": "४-३७-१४८", "content_sanskrit": "स्वाधीन पतिकानां च सुशीलानां मृगीदृशाम् ।\nस्वर्गापवर्गावत्रैव सुलक्षण फलं हि तत् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004088148, "chapter_id": 24088, "verse_number": "४-३७-१४९", "content_sanskrit": "सुलक्षणैः सुचरितैरपि मंदायुषं पतिम् ।\nदीर्घायुषं प्रकुर्वंति प्रमदाः प्रमदास्पदम् ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004088149, "chapter_id": 24088, "verse_number": "४-३७-१५०", "content_sanskrit": "अतः सुलक्षणा योषा परिणेया विचक्षणैः ।\nलक्षणानि परीक्ष्यादौ हित्वा दुर्लक्षणान्यपि ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7004088150, "chapter_id": 24088, "verse_number": "४-३७-१५१", "content_sanskrit": "लक्षणानि मयोक्तानि सुखाय गृहमेधिनाम् ।\nविवाहानपि वक्ष्यामि तन्निबोध घटोद्भव ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}]