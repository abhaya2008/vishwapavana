[{"id": 7003148000, "chapter_id": 23148, "verse_number": "४-८४-१", "content_sanskrit": "अथ चतुरशीतितमोऽध्यायः ।\nश्रीभगवानुवाच ।\nद्विजदेवार्चनं चैव करोति सततं गृही ।\nस्वधर्माचरणं चैव चातुर्वर्ण्यं च नित्यणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003148001, "chapter_id": 23148, "verse_number": "४-८४-२", "content_sanskrit": "कुर्वन्ति गृहिणामाशां सर्वे देवादयस्तथा ।\nअकृत्वाऽतिथिपूजां च गृहस्थश्च सदाऽशुचिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003148002, "chapter_id": 23148, "verse_number": "४-८४-३", "content_sanskrit": "पितरः कर्मकाले चातिथिकाले च देवताः ।\nसर्वे गृहस्थमायान्ति निपानमिव धेनवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003148003, "chapter_id": 23148, "verse_number": "४-८४-४", "content_sanskrit": "समायाति प्रयत्नेन सयाह्ने क्षुधितोऽतिथिः ।\nपूजां लब्ध्वाऽऽशिषं कृत्वा प्रयाति गृहिणो गृहात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003148004, "chapter_id": 23148, "verse_number": "४-८४-५", "content_sanskrit": "अकृत्वाऽतिथिपूजां च गृही भवति पातकी ।\nत्रैलोक्यजनितं पापं लभते नात्र संशयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003148005, "chapter_id": 23148, "verse_number": "४-८४-६", "content_sanskrit": "अतिथिर्यस्य भग्नाशो गृहात्प्रतिनिर्वते ।\nपितरस्तस्य देवाश्च वह्नयश्च तथैव च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003148006, "chapter_id": 23148, "verse_number": "४-८४-७", "content_sanskrit": "निराशाः प्रतिगच्छन्ति गृहिणोऽतिथयो गृहात् ।\nस्त्रीध्नैर्गोघ्नैः कृतघ्नैश्च ब्राह्मणैर्गुरुतल्पगैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003148007, "chapter_id": 23148, "verse_number": "४-८४-८", "content_sanskrit": "तुल्यदोषो भवत्येव येनातिथिरनर्चितः ।\nस्वात्मनः पातकं दत्त्वा पुण्यमादाय गच्छति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003148008, "chapter_id": 23148, "verse_number": "४-८४-९", "content_sanskrit": "तस्मात्कृत्वा सर्वसेवां देवादींश्च शुभाशयः ।\nपोष्याणां भरणं कृत्वा पश्चाद्भुङ्क्ते स धर्मवित् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003148009, "chapter_id": 23148, "verse_number": "४-८४-१०", "content_sanskrit": "यस्य माता गृहे नास्ति भार्या च पुंश्चली तथा ।\nअरण्यं तेन गन्तव्यमरण्याद्दुःखदं गृहम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003148010, "chapter_id": 23148, "verse_number": "४-८४-११", "content_sanskrit": "पतीं द्वेष्टि सदा दुष्टा विषतुन्यं च पश्यति ।\nददाति तस्मै नाऽऽहारं भर्त्सनं कुरुते सदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003148011, "chapter_id": 23148, "verse_number": "४-८४-१२", "content_sanskrit": "पूजितं मुनितुल्यं च सा च पापीयसी परम् ।\nसंततं तृणवन्मत्वा न्यक्कारं कुरुते सदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003148012, "chapter_id": 23148, "verse_number": "४-८४-१३", "content_sanskrit": "दुर्वाक्यावह्निना दग्धो मृततुल्यश्च जीवति ।\nयावज्जीवनपर्यन्तं संप्राप्य दुष्टवंशजाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003148013, "chapter_id": 23148, "verse_number": "४-८४-१४", "content_sanskrit": "गृहिणीनां सदाचारं श्रूयतां तच्छ्रु तौ श्रुतम् ।\nगृहिणी पतिभक्ता च देवब्राह्मणबूजिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003148014, "chapter_id": 23148, "verse_number": "४-८४-१५", "content_sanskrit": "सा शुद्धा प्रातरुत्थाय नमस्कृत्य पतिं सुरम् ।\nप्राङ्गणे मङ्गलं दद्याद्गोमयेन जलेन च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003148015, "chapter_id": 23148, "verse_number": "४-८४-१६", "content_sanskrit": "गृहकृत्यं च कृत्वा च स्नात्वाऽऽगत्य गृहं सती ।\nसुरं विप्रं पतिं नत्वा पूजयेद्गृहदेवताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003148016, "chapter_id": 23148, "verse_number": "४-८४-१७", "content_sanskrit": "गृहकृत्यं सुनिर्वृत्य भोजयित्वा पतिं सती ।\nअतिथिं पूजयित्वा च स्वयं भुङ्कते सुखंसती ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003148017, "chapter_id": 23148, "verse_number": "४-८४-१८", "content_sanskrit": "पुत्रैश्च पूजितस्तातः शिष्यैश्च पूजितो गुरुः ।\nआज्ञया कुरुते कर्म पुत्रः शिष्यश्च भृत्यवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003148018, "chapter_id": 23148, "verse_number": "४-८४-१९", "content_sanskrit": "न प्रेरयेद्गुरुं तातं पुत्रः शिष्यश्च कर्मसु ।\nपित्रे च गुरवे नित्यं सर्वस्वं च समर्पयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003148019, "chapter_id": 23148, "verse_number": "४-८४-२०", "content_sanskrit": "न कुर्यान्नरबुद्धिं च गुरौ पितरि संततम् ।\nकृत्वा च नरबुद्धिं च ब्रह्महत्यां लभेद्ध्रुवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003148020, "chapter_id": 23148, "verse_number": "४-८४-२१", "content_sanskrit": "मातरं पूजयेद्भक्त्या पितुश्चाप्यधिकां तथा ।\nमातुः परं गुरुं चैव पूजयेद्भक्तियोगतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003148021, "chapter_id": 23148, "verse_number": "४-८४-२२", "content_sanskrit": "पिता माता गुरुर्भार्या शिष्यः पुत्रः सदाऽक्षमः ।\nअनाथा भगिनी कन्या नित्यं पोष्या गुरुप्रिया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003148022, "chapter_id": 23148, "verse_number": "४-८४-२३", "content_sanskrit": "एवं च कथितं तात सर्वेषां धर्ममुत्तमम् ।\nश्त्रीजातिर्वास्तपीशुद्धा ताश्च सर्वाः पतिव्रताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003148023, "chapter_id": 23148, "verse_number": "४-८४-२४", "content_sanskrit": "सर्वा जातिरेकविधा चाऽऽदौ सृष्टा च ब्रह्मणा ।\nताः सर्वाः प्रकृतेरंशाः पवित्राः पण्डिताधिकाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003148024, "chapter_id": 23148, "verse_number": "४-८४-२५", "content_sanskrit": "केदारकन्याशापेन स हि धर्मः क्षयं गतः ।\nतदा कोपेन धात्रा च कृत्या स्त्री च विनिर्मिता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003148025, "chapter_id": 23148, "verse_number": "४-८४-२६", "content_sanskrit": "कृत्या स्त्री त्रिविधा जातिर्ब्रह्मणा निर्मिता पुरा ।\nउत्तमा प्रथमा सा च मध्यमा चाधमा व्रज ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003148026, "chapter_id": 23148, "verse_number": "४-८४-२७", "content_sanskrit": "उत्तमा पतिभक्ता सा किंचिद्धर्मसमन्विता ।\nप्राणान्तेऽपि न कुरुते तं जारमयशकरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003148027, "chapter_id": 23148, "verse_number": "४-८४-२८", "content_sanskrit": "पूजयेत्सा यथा कान्तं तथा देवद्विजातिथीन् ।\nव्रतानि चोपवासांश्च कुरुते सर्वपूजनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003148028, "chapter_id": 23148, "verse_number": "४-८४-२९", "content_sanskrit": "गुरुणा रक्षिता यत्नाज्जारं च न भजेद्भयात् ।\nस कृत्रिमा मध्यमा च यथाकिंचित्पतिं भजेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003148029, "chapter_id": 23148, "verse_number": "४-८४-३०", "content_sanskrit": "स्थानं नास्तिक्षणं नास्ति नास्ति प्रार्थयिता नरः ।\nतेन हे नन्द तासां च सतीत्वमुपजायते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003148030, "chapter_id": 23148, "verse_number": "४-८४-३१", "content_sanskrit": "अधमा परमा दुष्टाऽत्यन्तासद्वंशजा तथा ।\nअधर्मशीला दुःशीला दुर्मुखा कलहान्विता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003148031, "chapter_id": 23148, "verse_number": "४-८४-३२", "content_sanskrit": "पतिं भर्त्सयते नित्यं जारं च सेवते सदा ।\nदुःशं ददाति कान्ताय विषतुल्यं च पश्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003148032, "chapter_id": 23148, "verse_number": "४-८४-३३", "content_sanskrit": "जारद्वारमुपायेन हन्ति कान्तं मनोहरम् ।\nधर्मिष्ठं च वरिष्ठं च गरिष्ठं च महीतले ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003148033, "chapter_id": 23148, "verse_number": "४-८४-३४", "content_sanskrit": "कामदेवसमं चापि जारं पश्यति कामतः ।\nशुभदृष्ट्या कटाक्षेण शरवत्पापीयसी मुदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003148034, "chapter_id": 23148, "verse_number": "४-८४-३५", "content_sanskrit": "सुवेषं पुरुषं द्रष्ट्वा युवानं रतिशूकरम् ।\nयोनिः क्लिद्यति नारीणां कामिनीनां निरन्तरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003148035, "chapter_id": 23148, "verse_number": "४-८४-३६", "content_sanskrit": "ददाति भर्त्रे नाऽऽहारं विषोक्तिं वक्ति संततम् ।\nअधर्मं चिन्तयेच्छश्वज्जारं च परमं मुदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003148036, "chapter_id": 23148, "verse_number": "४-८४-३७", "content_sanskrit": "गुरुभिर्भर्त्सिता सा च रक्षिता च शतेन च ।\nतथाऽपि जारं कुरुते नापि साध्या नृपेरपि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003148037, "chapter_id": 23148, "verse_number": "४-८४-३८", "content_sanskrit": "नास्ति तस्याः प्रियं किंचित्सर्वं कार्यवशेन च ।\nगावस्तृणमिवारण्ये प्रार्थयन्ती नवं नवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003148038, "chapter_id": 23148, "verse_number": "४-८४-३९", "content_sanskrit": "विद्युदाभा जले रेखा तस्या प्रीतिस्तथैव च ।\nअधर्मयुक्ता सततं कपटं वक्ति निश्चितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003148039, "chapter_id": 23148, "verse_number": "४-८४-४०", "content_sanskrit": "व्रते तपसि धर्मे च न मनो गृहकर्मणि ।\nन गुरौ न च देवेषु जारे स्निग्धं च चञ्चलम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003148040, "chapter_id": 23148, "verse_number": "४-८४-४१", "content_sanskrit": "स्त्रीजातित्रिविधानां च कथा च कथिता मया ।\nभक्तानां त्रिविधानां च लक्षणं श्रूयतामिति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003148041, "chapter_id": 23148, "verse_number": "४-८४-४२", "content_sanskrit": "तृणशय्यारतो भक्तो मन्नामगुणकीर्तिषु ।\nमनो निवेशयेत्त्यक्त्वा संसारसुखकारणम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003148042, "chapter_id": 23148, "verse_number": "४-८४-४३", "content_sanskrit": "व्यायते मत्पदाब्जं च पूजयेद्भक्तिभावतः ।\nअहैतुकीं तस्य देवाः संकल्परहितस्य च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003148043, "chapter_id": 23148, "verse_number": "४-८४-४४", "content_sanskrit": "सर्वसिद्धिंन वाञ्छन्ति तेऽणिमादिकमीप्सितम् ।\nब्रह्मत्वममरत्वं वा सुरत्वं सुखकारणम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003148044, "chapter_id": 23148, "verse_number": "४-८४-४५", "content_sanskrit": "दास्यं विना नहीच्छन्ति सालोक्यादिचतुष्टयम् ।\nनैव निर्वाणमुक्तिं च सुधापानमभीप्सितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003148045, "chapter_id": 23148, "verse_number": "४-८४-४६", "content_sanskrit": "वाञ्छन्ति निश्चिलां भक्तिं मदीयामतुलामपि ।\nस्त्रीपुंविभेदो नास्त्येव सर्वजीवेषु भिन्नता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003148046, "chapter_id": 23148, "verse_number": "४-८४-४७", "content_sanskrit": "तेषां सिद्धेश्वराणां च प्रवराणां व्रजेश्वर ।\nक्षुत्पिपासादिकं निद्रालोभमोहादिकं रिपुम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003148047, "chapter_id": 23148, "verse_number": "४-८४-४८", "content_sanskrit": "त्पक्त्वा दिवानिशं मां च ध्यायन्ते च दिगम्बराः ।\nसमद्भक्तोत्तमो नन्द श्रूयतां मध्यमादिकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003148048, "chapter_id": 23148, "verse_number": "४-८४-४९", "content_sanskrit": "नाऽऽसक्तः कर्मसु गृही पूर्वप्राक्तनतः शुचिः ।\nकरोति सततं चैव पूर्वकर्मनिकृन्तनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003148049, "chapter_id": 23148, "verse_number": "४-८४-५०", "content_sanskrit": "न करोत्यपरं वत्नात्संकल्परहितः स च ।\nसर्वं कृष्णस्य यत्किंचिन्नाहं कर्ता च कर्मणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003148050, "chapter_id": 23148, "verse_number": "४-८४-५१", "content_sanskrit": "कर्मणा मनसा वाचा सततं चिन्तयेदिति ।\nन्यूनभक्तश्च तन्न्यूनः स च प्राकृतिकः श्रुतौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003148051, "chapter_id": 23148, "verse_number": "४-८४-५२", "content_sanskrit": "यमं वा यमदूतं वा स्वप्नेऽपि न च पश्यति ।\nपुरुषाणां सहस्रं च पूर्वभक्तः सुद्धरेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003148052, "chapter_id": 23148, "verse_number": "४-८४-५३", "content_sanskrit": "पुंसां शतं मध्यमश्च तच्चतुर्थं च प्राकृतः ।\nभक्तश्च त्रिविधस्तात कथितश्च तवाऽऽज्ञया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003148053, "chapter_id": 23148, "verse_number": "४-८४-५४", "content_sanskrit": "ब्रह्माण्डरचनाख्यानं श्रूयतां सावधानतः ।\nब्रह्माण्डरचनार्थं च भक्ता जानन्ति यत्नतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003148054, "chapter_id": 23148, "verse_number": "४-८४-५५", "content_sanskrit": "मुनयश्च सुराः सन्तः किंचिज्जानन्ति दुःखतः ।\nजानामि विश्वं सर्वार्थ ब्रह्माऽऽनन्तो ।\nमहेश्वरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003148055, "chapter_id": 23148, "verse_number": "४-८४-५६", "content_sanskrit": "धर्मः सनत्कुमारश्च नरनारायणावृषी ।\nकपिलश्च गणेशश्च दुर्गा लक्ष्मीः सरस्वती ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003148056, "chapter_id": 23148, "verse_number": "४-८४-५७", "content_sanskrit": "वेदाश्च वेदमाता च सर्वज्ञा राधिका स्वयम् ।\nएते जानन्ति विश्वार्थ नान्यो जानाति कश्चन ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003148057, "chapter_id": 23148, "verse_number": "४-८४-५८", "content_sanskrit": "वैषम्यार्थ च सुधियः सर्वे विज्ञातुमक्षमाः ।\nनित्याकाशो यथाऽऽत्मा च तथा नित्या दिशो दश ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003148058, "chapter_id": 23148, "verse_number": "४-८४-५९", "content_sanskrit": "यथा नित्या च प्रकृतिस्तथैव विश्वगोलकः ।\nगोलोकश्च यथा नित्यस्तथा वैकुण्ठ एव च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003148059, "chapter_id": 23148, "verse_number": "४-८४-६०", "content_sanskrit": "एकदा मयि गोलोके रासे नित्यं प्रकुर्वति ।\nआविर्भूता च वामाङ्गाद्बाला षोढशवार्षिकी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003148060, "chapter_id": 23148, "verse_number": "४-८४-६१", "content_sanskrit": "श्वेतचम्पकवर्णाभा शरच्चन्द्रसमप्रभा ।\nअतीव सुन्दरी रामा रमणीनां परावरा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003148061, "chapter_id": 23148, "verse_number": "४-८४-६२", "content_sanskrit": "ईषद्धास्यप्रसन्नास्या कौमलाङ्गी मनोहरा ।\nवह्निशुद्धांशुकाधाना रत्नाभरणभूषिता ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003148062, "chapter_id": 23148, "verse_number": "४-८४-६३", "content_sanskrit": "यथा जलदपङ्क्तिश्च बलाकाभिर्तिभूषिता ।\nसिन्दूरबिन्दूना चारुचन्द्रचन्दनबिन्दुभिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003148063, "chapter_id": 23148, "verse_number": "४-८४-६४", "content_sanskrit": "कस्तूरीबिन्दुभिः सार्धं सीमन्तान्धःस्यलोज्ज्वला ।\nअमूल्यरत्ननिर्माणसुस्निग्धकिरणोज्ज्वला ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003148064, "chapter_id": 23148, "verse_number": "४-८४-६५", "content_sanskrit": "विचित्रैश्च सुचित्रैश्च सुकपोलस्थलोज्ज्वला ।\nखमेन्द्रचञ्चुविजितनासामौक्तिकशोभिता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003148065, "chapter_id": 23148, "verse_number": "४-८४-६६", "content_sanskrit": "गजेन्द्रगण़्डनिर्मुक्तमुक्ताभूषणभूषिता ।\nशुक्त्या विमुक्तमुक्ताभदन्तपङ्क्तिमनोहरा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003148066, "chapter_id": 23148, "verse_number": "४-८४-६७", "content_sanskrit": "वलिताकलिताऽतीव पक्वबिम्बाधरा वरा ।\nशश्वत्पूर्णेन्दुनिन्दास्या पद्मनिन्दितलोचना ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003148067, "chapter_id": 23148, "verse_number": "४-८४-६८", "content_sanskrit": "कृष्णसारनिभोद्भिन्नसुचारुकज्जलोज्ज्वला ।\nअमूल्यरत्ननिर्माणकेयूरकङ्कणोज्ज्वला ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003148068, "chapter_id": 23148, "verse_number": "४-८४-६९", "content_sanskrit": "मणीन्द्रराजराजीभिः शङ्खयुग्मकरोज्जवला ।\nरत्नाङ्गुलीयकैरेभिरमृताङ्गुलिभूषिता ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003148069, "chapter_id": 23148, "verse_number": "४-८४-७०", "content_sanskrit": "रत्नेन्द्रराजराजेन क्वणन्मञ्जीररञ्जिता ।\nरत्नपाशकराजीभिः पादाङ्गुलिविराजिता ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003148070, "chapter_id": 23148, "verse_number": "४-८४-७१", "content_sanskrit": "सुन्दरालक्तरागेण चरणाधःस्थलोज्ज्वला ।\nगजेन्द्रगामिनी रामा कामिनी वामलोचना ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003148071, "chapter_id": 23148, "verse_number": "४-८४-७२", "content_sanskrit": "मां ददर्श कटाक्षेण रमणी रमणोत्सुका ।\nरासे संभूय रामा सा दधार पुरतो मम ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003148072, "chapter_id": 23148, "verse_number": "४-८४-७३", "content_sanskrit": "तेन राधा समाख्याता बुराविद्भिः प्रपूजिता ।\nप्रहृष्टा प्रकृतिश्चास्यास्तेन प्रकृतिरीश्वरी ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003148073, "chapter_id": 23148, "verse_number": "४-८४-७४", "content_sanskrit": "शक्ता स्यात्सर्वकार्येषु तेन शक्तिः प्रकीर्तिता ।\nसर्वाधारा सर्वरूपा मङ्गलार्हा च सर्वतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003148074, "chapter_id": 23148, "verse_number": "४-८४-७५", "content_sanskrit": "सर्वमङ्गलदक्षा सा तेन स्यात्सर्वमङ्गला ।\nवैकुण्ठे सा महालक्ष्मीर्मूर्तिभेदे सरस्वती ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003148075, "chapter_id": 23148, "verse_number": "४-८४-७६", "content_sanskrit": "प्रसूय वेदान्विदिता वेदमाता च सा सदा ।\nसावित्री स च गायत्री धात्री त्रिजगतामपि ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003148076, "chapter_id": 23148, "verse_number": "४-८४-७७", "content_sanskrit": "पुरा संहृत्य दुर्गं च सा दुर्गा च प्रकीर्तिता ।\nतेजसः सर्वदेवानामाविर्भूता पुरा सती ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003148077, "chapter_id": 23148, "verse_number": "४-८४-७८", "content_sanskrit": "तेनाऽऽद्या प्रकृतिर्ज्ञेया सर्वासुरविमर्दिती ।\nसर्वानन्दा च सानन्दा दुःखदारिद्रयनाशिनी ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003148078, "chapter_id": 23148, "verse_number": "४-८४-७९", "content_sanskrit": "शत्रुणां भयदात्रौ च भक्तानां भयहारिणौ ।\nदक्षकन्या सती का च शैलजातेति पार्वती ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003148079, "chapter_id": 23148, "verse_number": "४-८४-८०", "content_sanskrit": "सर्वाधारस्वरूपा सा कलया सा वसुंधरा ।\nकलया तुलसी गङ्गा कलया सर्वयोषितः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003148080, "chapter_id": 23148, "verse_number": "४-८४-८१", "content_sanskrit": "सृष्टिं करोमि च यया तात शक्त्या पुनः पुनः ।\nदृष्ट्वा तां रासमध्यस्थां मम क्रीडा ।\nतया सह ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003148081, "chapter_id": 23148, "verse_number": "४-८४-८२", "content_sanskrit": "बभूव सुचिरं तात यावद्वै ब्रह्मणः शतम् ।\nअत्यद्भुतं कौतुकं च महाश्रृङ्गारमीप्सितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003148082, "chapter_id": 23148, "verse_number": "४-८४-८३", "content_sanskrit": "तयोर्द्वयोर्धर्मराशिः सुस्राव रासमण़्डले ।\nतस्मान्मनोहरं जज्ञे नामनाकारसरोवरम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003148083, "chapter_id": 23148, "verse_number": "४-८४-८४", "content_sanskrit": "पपात धर्मधाराऽधो वेगेन विश्वगोलके ।\nबभूव जलबूर्णं च ब्रह्माण्डानां च गोलकम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003148084, "chapter_id": 23148, "verse_number": "४-८४-८५", "content_sanskrit": "जलपूर्ण पुरा सर्व शृष्टिशून्यं व्रजेश्वर ।\nश्रुङ्गारान्ते च तस्यां च वीर्याधानं मया कृतम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003148085, "chapter_id": 23148, "verse_number": "४-८४-८६", "content_sanskrit": "दधार गर्भ सा राधा यावद्वै ब्रह्मणाः शतम् ।\nसुस्राव सा तदन्ते च डिम्भं च परमाद्भुतम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003148086, "chapter_id": 23148, "verse_number": "४-८४-८७", "content_sanskrit": "चुकोप देवी तं दृष्ट्वा रुरोद विषसाद सा ।\nपादेन प्रेरयामास तमधो विश्वगोलके ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003148087, "chapter_id": 23148, "verse_number": "४-८४-८८", "content_sanskrit": "स पपात जले तात सर्वाधारो महान्विराट् ।\nदृष्ट्वाऽपत्यं जलस्थं च मया शप्ता च सा पुरा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003148088, "chapter_id": 23148, "verse_number": "४-८४-८९", "content_sanskrit": "अनपत्या च सा राथा मच्छापेन पुरा विभो ।\nतेन प्रसूताः क्रमतो दुर्गा लक्ष्मीः सरस्वती ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003148089, "chapter_id": 23148, "verse_number": "४-८४-९०", "content_sanskrit": "चतस्रः परिबूर्णास्ताः प्रसूताश्च सुनिश्चितम् ।\nदेव्योऽन्याश्चापि कामिन्यस्ताः प्रसूता व्रजेश्वर ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003148090, "chapter_id": 23148, "verse_number": "४-८४-९१", "content_sanskrit": "कलया प्रभवो यासां कलांशांशेन वा व्रज ।\nजज्ञे महान्विराड्येन डिम्भेन कलयाऽऽश्रयः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003148091, "chapter_id": 23148, "verse_number": "४-८४-९२", "content_sanskrit": "अमृताङ्गुष्ठपीयूषं मया दत्तं पपौ च सः ।\nजले स्थावररूपश्च शेते च निजकर्मणः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003148092, "chapter_id": 23148, "verse_number": "४-८४-९३", "content_sanskrit": "उपधानं जलं तल्पं तस्य योगबलेन च ।\nतस्य लोम्नां च कूपानि जलपूर्णानि संततम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003148093, "chapter_id": 23148, "verse_number": "४-८४-९४", "content_sanskrit": "प्रत्येकं क्रमतस्तेषु शेते क्षुद्रविराट् पुनः ।\nसहस्रपत्रं कमलं जज्ञे क्षुद्रस्य नाभितः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003148094, "chapter_id": 23148, "verse_number": "४-८४-९५", "content_sanskrit": "तत्र जज्ञे वरो ब्रह्मा तेनायं कमलोद्भवः ।\nतत्राऽऽविर्भूय स विधिश्चिन्ताग्रस्तो बभूव सः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003148095, "chapter_id": 23148, "verse_number": "४-८४-९६", "content_sanskrit": "कस्माद्देहःक्वा माता मे पिता वा क्व च बान्धवः ।\nदिव्यं त्रिलक्षवर्षञ्च बभ्राम कमलान्तरे ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003148096, "chapter_id": 23148, "verse_number": "४-८४-९७", "content_sanskrit": "ततो दिव्यं पञ्चलक्षं सस्मार तपसा च माम् ।\nतदा मया दत्तमन्त्रं जजाप कमलान्तरे ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003148097, "chapter_id": 23148, "verse_number": "४-८४-९८", "content_sanskrit": "दिव्यवर्षसप्तलक्षं नियतं संयतः शुचिः ।\nतदा मत्तो वरं लब्ध्वा स्रष्टा सृष्टिं चकार सः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003148098, "chapter_id": 23148, "verse_number": "४-८४-९९", "content_sanskrit": "मायया प्रति ब्रह्माण्डे ब्रह्मविष्णुशिवात्मकाः ।\nदिक्पाला द्वादशादित्या रुद्राश्चैकादशापि च ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003148099, "chapter_id": 23148, "verse_number": "४-८४-१००", "content_sanskrit": "नवग्रहाष्टौ वसवो देवाः कोटित्रयं तथा ।\nब्राह्मणाक्षत्रविट्शूद्रा यक्षगन्धर्वकिन्नराः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003148100, "chapter_id": 23148, "verse_number": "४-८४-१०१", "content_sanskrit": "भूतादयो राङसाश्चाप्येवं सर्वं चराचरम् ।\nविश्वे विश्वे विनिर्माणाः स्वर्गाः सप्त क्रमेण च ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003148101, "chapter_id": 23148, "verse_number": "४-८४-१०२", "content_sanskrit": "सप्तसागरसंयुक्ता सप्तद्वीपा वसुंधरा ।\nकाञ्चनीभूमिसंयुक्ता तमोयुक्तं स्थलं तथा ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003148102, "chapter_id": 23148, "verse_number": "४-८४-१०३", "content_sanskrit": "पातालाश्च तथा सप्त ब्रह्माण्डमेभिरेव च ।\nविश्वे विश्वे चन्द्रसूयो पुण्यक्षेत्रं च भारतम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003148103, "chapter_id": 23148, "verse_number": "४-८४-१०४", "content_sanskrit": "तीर्थान्येतानि सर्वत्र गङ्गादीति व्रजेश्वर ।\nयावन्ति लोमकूपानि महाविष्णोः क्रमेण च ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003148104, "chapter_id": 23148, "verse_number": "४-८४-१०५", "content_sanskrit": "विश्वान्येव ही तावन्ति ह्यमंख्यातानि च ध्रुवम् ।\nविश्वेषासूर्ध्वाभामे च वैकुण्ठश्च निराश्रयः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003148105, "chapter_id": 23148, "verse_number": "४-८४-१०६", "content_sanskrit": "मदिच्छया विनिर्माणा वेदाः कथितुमक्षमाः ।\nकुयोगिनाम दृष्टश्चामभक्तानां विनिश्चितम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003148106, "chapter_id": 23148, "verse_number": "४-८४-१०७", "content_sanskrit": "तस्मादुपरि गोलोकः पञ्चाशत्कोटियोजनः ।\nवायुना धार्यमाणश्च विचित्रः परमाश्रमः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003148107, "chapter_id": 23148, "verse_number": "४-८४-१०८", "content_sanskrit": "अतीव रम्यनिर्माणो नित्यरूपो मदिच्छया ।\nशतश्रृङ्गेण शैलेन पुण्यवृन्दावनेन च ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003148108, "chapter_id": 23148, "verse_number": "४-८४-१०९", "content_sanskrit": "सुरासमण्डलेनापि नद्या विरजया युतः ।\nकोटियोजनविस्तीर्णा प्रस्थेन विरजा व्रज ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003148109, "chapter_id": 23148, "verse_number": "४-८४-११०", "content_sanskrit": "दैर्ध्यं तस्याः शतगुणं परितः परमा शुभा ।\nअमूल्यरत्ननिकरैर्हीरमाणिक्ययोस्तथा ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003148110, "chapter_id": 23148, "verse_number": "४-८४-१११", "content_sanskrit": "मणीनां कौस्तुभादीनामसंख्यानां मनोहरा ।\nअमूल्यरत्ननिर्माणं तत्रावि प्रतिमन्दिरम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003148111, "chapter_id": 23148, "verse_number": "४-८४-११२", "content_sanskrit": "मनोहरं च प्राकारमदृष्टं विश्वकर्मणा ।\nगोपीभिर्गोपनिकरैर्वैष्टितं कामधेनुभिः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003148112, "chapter_id": 23148, "verse_number": "४-८४-११३", "content_sanskrit": "कल्पवृक्षैः पारिजातैरसंख्यैश्च सरोवरैः ।\nपुष्पोद्यानैःकोटिभिश्च संवृतं रासमण्डलम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003148113, "chapter_id": 23148, "verse_number": "४-८४-११४", "content_sanskrit": "वेष्टितं वेष्टितैर्गोपैर्मन्दिरैः शतकोटिभिः ।\nरत्नप्रदीपयुक्तैश्च पुष्पतल्पसमन्वितैः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003148114, "chapter_id": 23148, "verse_number": "४-८४-११५", "content_sanskrit": "सुगन्धिचन्दनामोदैः कस्तूरीकुङ्कुमान्वितैः ।\nक्रीडोपयुक्तैर्भोगेश्च ताम्बूलैर्वासितैर्जलैः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003148115, "chapter_id": 23148, "verse_number": "४-८४-११६", "content_sanskrit": "धूपैः सुरभिरम्यैश्च माल्यैश्च रत्नदर्पणैः ।\nरक्षकै रक्षितं शश्वद्राधादासीत्रिकोटिभिः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003148116, "chapter_id": 23148, "verse_number": "४-८४-११७", "content_sanskrit": "अमूल्यरत्नाभरणैर्वह्निशुद्धांशुकैरपि ।\nलक्षणत्तगजेन्द्राणां वेष्टितं च बलैः क्रमात् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003148117, "chapter_id": 23148, "verse_number": "४-८४-११८", "content_sanskrit": "नवयौवनसंपन्नै रूपैर्निरुपमैरपि ।\nरम्यं च वर्तुलाकारं चन्द्रबिम्बं यथा व्रज ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003148118, "chapter_id": 23148, "verse_number": "४-८४-११९", "content_sanskrit": "अमूल्यरत्नरचितं दशयोजनविस्तृतम् ।\nकस्तूरीकुङ्कुमै रभ्यैः सुगन्धिचन्दनार्चितम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003148119, "chapter_id": 23148, "verse_number": "४-८४-१२०", "content_sanskrit": "आवृतं मङ्गलघटैः फलपल्लवसंयुतैः ।\nदधिलाजैश्च पर्णैश्च स्निग्धदूर्वाङ्कुरैः फलैः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003148120, "chapter_id": 23148, "verse_number": "४-८४-१२१", "content_sanskrit": "श्रीरामकदलीस्तम्भैरसंख्यैश्च मनोहरैः ।\nपट्टसूत्रनिबद्धैश्च स्निग्धैश्चन्दनपल्लवैः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003148121, "chapter_id": 23148, "verse_number": "४-८४-१२२", "content_sanskrit": "चन्दनासक्तमाल्यैश्च भूषणैश्च विभूषितम् ।\nअमूल्यरत्नरचितं शतशृङ्गमनोहरम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003148122, "chapter_id": 23148, "verse_number": "४-८४-१२३", "content_sanskrit": "कोटियोजनमूर्ध्वं च दैर्ध्यं शतगुणोत्तरम् ।\nशैलप्रस्थपरिमितं पञ्चाशत्कोटियोजनम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003148123, "chapter_id": 23148, "verse_number": "४-८४-१२४", "content_sanskrit": "अतीव कमनीयं य वेदानिर्वचनीयकम् ।\nप्राकारमिव तस्यापि गोललोकस्य मनोहरम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003148124, "chapter_id": 23148, "verse_number": "४-८४-१२५", "content_sanskrit": "परितो वेष्टितं रम्यं हीरहारसमन्वितम् ।\nतत्र वृन्दावनं रम्यं युक्तं चन्दनपादपैः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003148125, "chapter_id": 23148, "verse_number": "४-८४-१२६", "content_sanskrit": "कल्पवृक्षैश्च नम्यैश्च मन्दारैः कामधेनुभिः ।\nशोभितं शोभनाढ्यैश्च पुष्पोद्यानैर्मनोहरैः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003148126, "chapter_id": 23148, "verse_number": "४-८४-१२७", "content_sanskrit": "क्रीडासरोवरै रम्यैः सुरम्यै रतिमन्दिरैः ।\nअतीव रम्यं रहसि रासयोग्यस्थलान्वितम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003148127, "chapter_id": 23148, "verse_number": "४-८४-१२८", "content_sanskrit": "रक्षितं रक्षकै रम्यैरसंख्यैर्गोपिकागणैः ।\nपरितो वर्तुलाकारं त्रिलक्षयोजनं वनम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003148128, "chapter_id": 23148, "verse_number": "४-८४-१२९", "content_sanskrit": "षट्पदध्वनिसंयुक्तं पुंस्कोकिलरुतान्वितम् ।\nतत्राक्षयो वटो रम्यो रहस्ये बहृविस्तृतः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003148129, "chapter_id": 23148, "verse_number": "४-८४-१३०", "content_sanskrit": "सहस्रयोजनोर्ध्वश्च परितश्च चतुर्गुणः ।\nगोपीनां कल्पवृक्षश्च सर्ववाञ्छाफलप्रदः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003148130, "chapter_id": 23148, "verse_number": "४-८४-१३१", "content_sanskrit": "क्रीडान्वितैरावृतश्च राधादासीत्रिलक्षकैः ।\nविरजातीरनिराणां वायुना शीतलेन च ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003148131, "chapter_id": 23148, "verse_number": "४-८४-१३२", "content_sanskrit": "पुष्पान्वितेन मन्देन पवित्रश्च सुगन्धिना ।\nदासीगणैरसंख्यैश्च वृन्दावनविनोदिनी ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003148132, "chapter_id": 23148, "verse_number": "४-८४-१३३", "content_sanskrit": "तत्र क्रीडति राधा सा मम प्राणाधिदेवता ।\nसेयं श्रीदामशापेन वृषभानसुताऽधुना ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003148133, "chapter_id": 23148, "verse_number": "४-८४-१३४", "content_sanskrit": "ब्रह्मादिदेवैः सिद्धेन्द्रैर्मुनीन्द्रैः पूजिता व्रज ।\nसिद्धैर्गुणैर्बलैर्बुद्ध्या ज्ञानयोगैश्च विद्यया ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003148134, "chapter_id": 23148, "verse_number": "४-८४-१३५", "content_sanskrit": "तात सर्वप्रकारेण वन्द्या सत्सदृशी प्रिया ।\nइत्येवं कथितं नन्द ब्रह्माण्डानां च वर्णनम् ।\nयथोचितं परिमितं किं भूयः श्रोतुमिच्छसि ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}]