[{"id": 5000352000, "chapter_id": 9352, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000352001, "chapter_id": 9352, "verse_number": "५-१३-१", "content_sanskrit": "विमानात् तु स संक्रम्य प्राकारं हरियूथपः।\nहनूमान् वेगवानासीद् यथा विद्युद् घनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000352002, "chapter_id": 9352, "verse_number": "५-१३-२", "content_sanskrit": "सम्परिक्रम्य हनुमान् रावणस्य निवेशनान्।\nअदृष्ट्वा जानकीं सीतामब्रवीद् वचनं कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000352003, "chapter_id": 9352, "verse_number": "५-१३-३", "content_sanskrit": "भूयिष्ठं लोलिता लंका रामस्य चरता प्रियम्।\nन हि पश्यामि वैदेहीं सीतां सर्वांगशोभनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000352004, "chapter_id": 9352, "verse_number": "५-१३-४", "content_sanskrit": "पल्वलानि तटाकानि सरांसि सरितस्तथा।\nनद्योऽनूपवनान्ताश्च दुर्गाश्च धरणीधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000352005, "chapter_id": 9352, "verse_number": "५-१३-५", "content_sanskrit": "लोलिता वसुधा सर्वा न च पश्यामि जानकीम्।\nइह सम्पातिना सीता रावणस्य निवेशने।\nआख्याता गृध्रराजेन न च सा दृश्यते न किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000352006, "chapter_id": 9352, "verse_number": "५-१३-६", "content_sanskrit": "किं नु सीताथ वैदेही मैथिली जनकात्मजा।\nउपतिष्ठेत विवशा रावणेन हृता बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000352007, "chapter_id": 9352, "verse_number": "५-१३-७", "content_sanskrit": "क्षिप्रमुत्पततो मन्ये सीतामादाय रक्षसः।\nबिभ्यतो रामबाणानामन्तरा पतिता भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000352008, "chapter_id": 9352, "verse_number": "५-१३-८", "content_sanskrit": "अथवा ह्रियमाणायाः पथि सिद्धनिषेविते।\nमन्ये पतितमार्याया हृदयं प्रेक्ष्य सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000352009, "chapter_id": 9352, "verse_number": "५-१३-९", "content_sanskrit": "रावणस्योरुवेगेन भुजाभ्यां पीडितेन च।\nतया मन्ये विशालाक्ष्या त्यक्तं जीवितमार्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000352010, "chapter_id": 9352, "verse_number": "५-१३-१०", "content_sanskrit": "उपर्युपरि सा नूनं सागरं क्रमतस्तदा।\nविचेष्टमाना पतिता समुद्रे जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000352011, "chapter_id": 9352, "verse_number": "५-१३-११", "content_sanskrit": "आहो क्षुद्रेण चानेन रक्षन्ती शीलमात्मनः।\nअबन्धुर्भक्षिता सीता रावणेन तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000352012, "chapter_id": 9352, "verse_number": "५-१३-१२", "content_sanskrit": "अथवा राक्षसेन्द्रस्य पत्नीभिरसितेक्षणा।\nअदुष्टा दुष्टभावाभिर्भक्षिता सा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000352013, "chapter_id": 9352, "verse_number": "५-१३-१३", "content_sanskrit": "सम्पूर्णचन्द्रप्रतिमं पद्मपत्रनिभेक्षणम्।\nरामस्य ध्यायती वक्त्रं पञ्चत्वं कृपणा गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000352014, "chapter_id": 9352, "verse_number": "५-१३-१४", "content_sanskrit": "हा राम लक्ष्मणेत्येवं हायोध्ये चेति मैथिली।\nविलप्य बहु वैदेही न्यस्तदेहा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000352015, "chapter_id": 9352, "verse_number": "५-१३-१५", "content_sanskrit": "अथवा निहिता मन्ये रावणस्य निवेशने।\nभृशं लालप्यते बाला पञ्जरस्थेव सारिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000352016, "chapter_id": 9352, "verse_number": "५-१३-१६", "content_sanskrit": "जनकस्य कुले जाता रामपत्नी सुमध्यमा।\nकथमुत्पलपत्राक्षी रावणस्य वशं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000352017, "chapter_id": 9352, "verse_number": "५-१३-१७", "content_sanskrit": "विनष्टा वा प्रणष्टा वा मृता वा जनकात्मजा।\nरामस्य प्रियभार्यस्य न निवेदयितुं क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000352018, "chapter_id": 9352, "verse_number": "५-१३-१८", "content_sanskrit": "निवेद्यमाने दोषः स्याद् दोषः स्यादनिवेदने।\nकथं नु खलु कर्तव्यं विषमं प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000352019, "chapter_id": 9352, "verse_number": "५-१३-१९", "content_sanskrit": "अस्मिन् नेवंगते कार्ये प्राप्तकालं क्षमं च किम्।\nभवेदिति मतिं भूयो हनुमान् प्रविचारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000352020, "chapter_id": 9352, "verse_number": "५-१३-२०", "content_sanskrit": "यदि सीतामदृष्ट्वाहं वानरेन्द्रपुरीमितः।\nगमिष्यामि ततः को मे पुरुषार्थो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000352021, "chapter_id": 9352, "verse_number": "५-१३-२१", "content_sanskrit": "ममेदं लङ्घनं व्यर्थं सागरस्य भविष्यति।\nप्रवेशश्चैव लंकायां राक्षसानां च दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000352022, "chapter_id": 9352, "verse_number": "५-१३-२२", "content_sanskrit": "किं वा वक्ष्यति सुग्रीवो हरयो वापि संगताः।\nकिष्किन्धामनुसम्प्राप्तं तौ वा दशरथात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000352023, "chapter_id": 9352, "verse_number": "५-१३-२३", "content_sanskrit": "गत्वा तु यदि काकुत्स्थं वक्ष्यामि परुषं वचः।\nन दृष्टेति मया सीता ततस्त्यक्ष्यति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000352024, "chapter_id": 9352, "verse_number": "५-१३-२४", "content_sanskrit": "परुषं दारुणं तीक्ष्णं क्रूरमिन्द्रियतापनम्।\nसीतानिमित्तं दुर्वाक्यं श्रुत्वा स न भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000352025, "chapter_id": 9352, "verse_number": "५-१३-२५", "content_sanskrit": "तं तु कृच्छ्रगतं दृष्ट्वा पञ्चत्वगतमानसम्।\nभृशानुरक्तमेधावी न भविष्यति लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000352026, "chapter_id": 9352, "verse_number": "५-१३-२६", "content_sanskrit": "विनष्टौ भ्रातरौ श्रुत्वा भरतोऽपि मरिष्यति।\nभरतं च मृतं दृष्ट्वा शत्रुघ्नो न भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000352027, "chapter_id": 9352, "verse_number": "५-१३-२७", "content_sanskrit": "पुत्रान् मृतान् समीक्ष्याथ न भविष्यन्ति मातरः।\nकौसल्या च सुमित्रा च कैकेयी च न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000352028, "chapter_id": 9352, "verse_number": "५-१३-२८", "content_sanskrit": "कृतज्ञः सत्यसंधश्च सुग्रीवः प्लवगाधिपः।\nरामं तथागतं दृष्ट्वा ततस्त्यक्ष्यति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000352029, "chapter_id": 9352, "verse_number": "५-१३-२९", "content_sanskrit": "दुर्मना व्यथिता दीना निरानन्दा तपस्विनी।\nपीडिता भर्तृशोकेन रुमा त्यक्ष्यति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000352030, "chapter_id": 9352, "verse_number": "५-१३-३०", "content_sanskrit": "वालिजेन तु दुःखेन पीडिता शोककर्शिता।\nपञ्चत्वमागता राज्ञी तारापि न भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000352031, "chapter_id": 9352, "verse_number": "५-१३-३१", "content_sanskrit": "मातापित्रोर्विनाशेन सुग्रीवव्यसनेन च।\nकुमारोऽप्यंगदस्तस्माद् विजहिष्यति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000352032, "chapter_id": 9352, "verse_number": "५-१३-३२", "content_sanskrit": "भर्तृजेन तु दुःखेन अभिभूता वनौकसः।\nशिरांस्यभिहनिष्यन्ति तलैर्मुष्टिभिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000352033, "chapter_id": 9352, "verse_number": "५-१३-३३", "content_sanskrit": "सान्त्वेनानुप्रदानेन मानेन च यशस्विना।\nलालिताः कपिनाथेन प्राणांस्त्यक्ष्यन्ति वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000352034, "chapter_id": 9352, "verse_number": "५-१३-३४", "content_sanskrit": "न वनेषु न शैलेषु न निरोधेषु वा पुनः।\nक्रीडामनुभविष्यन्ति समेत्य कपिकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000352035, "chapter_id": 9352, "verse_number": "५-१३-३५", "content_sanskrit": "सपुत्रदाराः सामात्या भर्तृव्यसनपीडिताः।\nशैलाग्रेभ्यः पतिष्यन्ति समेषु विषमेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000352036, "chapter_id": 9352, "verse_number": "५-१३-३६", "content_sanskrit": "विषमुद‍्बन्धनं वापि प्रवेशं ज्वलनस्य वा।\nउपवासमथो शस्त्रं प्रचरिष्यन्ति वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000352037, "chapter_id": 9352, "verse_number": "५-१३-३७", "content_sanskrit": "घोरमारोदनं मन्ये गते मयि भविष्यति।\nइक्ष्वाकुकुलनाशश्च नाशश्चैव वनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000352038, "chapter_id": 9352, "verse_number": "५-१३-३८", "content_sanskrit": "सोऽहं नैव गमिष्यामि किष्किन्धां नगरीमितः।\nनहि शक्ष्याम्यहं द्रष्टुं सुग्रीवं मैथिलीं विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000352039, "chapter_id": 9352, "verse_number": "५-१३-३९", "content_sanskrit": "मय्यगच्छति चेहस्थे धर्मात्मानौ महारथौ।\nआशया तौ धरिष्येते वानराश्च तरस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000352040, "chapter_id": 9352, "verse_number": "५-१३-४०", "content_sanskrit": "हस्तादानो मुखादानो नियतो वृक्षमूलिकः।\nवानप्रस्थो भविष्यामि ह्यदृष्ट्वा जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000352041, "chapter_id": 9352, "verse_number": "५-१३-४१", "content_sanskrit": "सागरानूपजे देशे बहुमूलफलोदके।\nचितिं कृत्वा प्रवेक्ष्यामि समिद्धमरणीसुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000352042, "chapter_id": 9352, "verse_number": "५-१३-४२", "content_sanskrit": "उपविष्टस्य वा सम्यग् लिंगिनं साधयिष्यतः।\nशरीरं भक्षयिष्यन्ति वायसाः श्वापदानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000352043, "chapter_id": 9352, "verse_number": "५-१३-४३", "content_sanskrit": "इदमप्यृषिभिर्दृष्टं निर्याणमिति मे मतिः।\nसम्यगापः प्रवेक्ष्यामि न चेत् पश्यामि जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000352044, "chapter_id": 9352, "verse_number": "५-१३-४४", "content_sanskrit": "सुजातमूला सुभगा कीर्तिमाला यशस्विनी।\nप्रभग्ना चिररात्राय मम सीतामपश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000352045, "chapter_id": 9352, "verse_number": "५-१३-४५", "content_sanskrit": "तापसो वा भविष्यामि नियतो वृक्षमूलिकः।\nनेतः प्रतिगमिष्यामि तामदृष्ट्वासितेक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000352046, "chapter_id": 9352, "verse_number": "५-१३-४६", "content_sanskrit": "यदि तु प्रतिगच्छामि सीतामनधिगम्य ताम्।\nअंगदः सहितः सर्वैर्वानरैर्न भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000352047, "chapter_id": 9352, "verse_number": "५-१३-४७", "content_sanskrit": "विनाशे बहवो दोषा जीवन् प्राप्नोति भद्रकम्।\nतस्मात् प्राणान् धरिष्यामि ध्रुवो जीवति संगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000352048, "chapter_id": 9352, "verse_number": "५-१३-४८", "content_sanskrit": "एवं बहुविधं दुःखं मनसा धारयन् बहु।\nनाध्यगच्छत् तदा पारं शोकस्य कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000352049, "chapter_id": 9352, "verse_number": "५-१३-४९", "content_sanskrit": "ततो विक्रममासाद्य धैर्यवान् कपिकुञ्जरः।\nरावणं वा वधिष्यामि दशग्रीवं महाबलम्।\nकाममस्तु हृता सीता प्रत्याचीर्णं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000352050, "chapter_id": 9352, "verse_number": "५-१३-५०", "content_sanskrit": "अथवैनं समुत्क्षिप्य उपर्युपरि सागरम्।\nरामायोपहरिष्यामि पशुं पशुपतेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000352051, "chapter_id": 9352, "verse_number": "५-१३-५१", "content_sanskrit": "इति चिन्तासमापन्नः सीतामनधिगम्य ताम्।\nध्यानशोकपरीतात्मा चिन्तयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000352052, "chapter_id": 9352, "verse_number": "५-१३-५२", "content_sanskrit": "यावत् सीतां न पश्यामि रामपत्नीं यशस्विनीम्।\nतावदेतां पुरीं लंकां विचिनोमि पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000352053, "chapter_id": 9352, "verse_number": "५-१३-५३", "content_sanskrit": "सम्पातिवचनाच्चापि रामं यद्यानयाम्यहम्।\nअपश्यन् राघवो भार्यां निर्दहेत् सर्ववानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000352054, "chapter_id": 9352, "verse_number": "५-१३-५४", "content_sanskrit": "इहैव नियताहारो वत्स्यामि नियतेन्द्रियः।\nन मत्कृते विनश्येयुः सर्वे ते नरवानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000352055, "chapter_id": 9352, "verse_number": "५-१३-५५", "content_sanskrit": "अशोकवनिका चापि महतीयं महाद्रुमा।\nइमामधिगमिष्यामि नहीयं विचिता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000352056, "chapter_id": 9352, "verse_number": "५-१३-५६", "content_sanskrit": "वसून् रुद्रांस्तथाऽऽदित्यानश्विनौ मरुतोऽपि च।\nनमस्कृत्वा गमिष्यामि रक्षसां शोकवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000352057, "chapter_id": 9352, "verse_number": "५-१३-५७", "content_sanskrit": "जित्वा तु राक्षसान् देवीमिक्ष्वाकुकुलनन्दिनीम्।\nसम्प्रदास्यामि रामाय सिद्धीमिव तपस्विने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000352058, "chapter_id": 9352, "verse_number": "५-१३-५८", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा चिन्ताविग्रथितेन्द्रियः।\nउदतिष्ठन् महाबाहुर्हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000352059, "chapter_id": 9352, "verse_number": "५-१३-५९", "content_sanskrit": "नमोऽस्तु रामाय सलक्ष्मणाय\nदेव्यै च तस्यै जनकात्मजायै।\nनमोऽस्तु रुद्रेन्द्रयमानिलेभ्यो\nनमोऽस्तु चन्द्राग्निमरुद‍्गणेभ्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000352060, "chapter_id": 9352, "verse_number": "५-१३-६०", "content_sanskrit": "स तेभ्यस्तु नमस्कृत्वा सुग्रीवाय च मारुतिः।\nदिशः सर्वाः समालोक्य सोऽशोकवनिकां प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000352061, "chapter_id": 9352, "verse_number": "५-१३-६१", "content_sanskrit": "स गत्वा मनसा पूर्वमशोकवनिकां शुभाम्।\nउत्तरं चिन्तयामास वानरो मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000352062, "chapter_id": 9352, "verse_number": "५-१३-६२", "content_sanskrit": "ध्रुवं तु रक्षोबहुला भविष्यति वनाकुला।\nअशोकवनिका पुण्या सर्वसंस्कारसंस्कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000352063, "chapter_id": 9352, "verse_number": "५-१३-६३", "content_sanskrit": "रक्षिणश्चात्र विहिता नूनं रक्षन्ति पादपान्।\nभगवानपि विश्वात्मा नातिक्षोभं प्रवायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000352064, "chapter_id": 9352, "verse_number": "५-१३-६४", "content_sanskrit": "संक्षिप्तोऽयं मयाऽऽत्मा च रामार्थे रावणस्य च।\nसिद्धिं दिशन्तु मे सर्वे देवाः सर्षिगणास्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000352065, "chapter_id": 9352, "verse_number": "५-१३-६५", "content_sanskrit": "ब्रह्मा स्वयम्भूर्भगवान् देवाश्चैव तपस्विनः।\nसिद्धिमग्निश्च वायुश्च पुरुहूतश्च वज्रभृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000352066, "chapter_id": 9352, "verse_number": "५-१३-६६", "content_sanskrit": "वरुणः पाशहस्तश्च सोमादित्यौ तथैव च।\nअश्विनौ च महात्मानौ मरुतः सर्व एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000352067, "chapter_id": 9352, "verse_number": "५-१३-६७", "content_sanskrit": "सिद्धिं सर्वाणि भूतानि भूतानां चैव यः प्रभुः।\nदास्यन्ति मम ये चान्येऽप्यदृष्टाः पथि गोचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000352068, "chapter_id": 9352, "verse_number": "५-१३-६८", "content_sanskrit": "तदुन्नसं पाण्डुरदन्तमव्रणं\nशुचिस्मितं पद्मपलाशलोचनम्।\nद्रक्ष्ये तदार्यावदनं कदा न्वहं\nप्रसन्नताराधिपतुल्यवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000352069, "chapter_id": 9352, "verse_number": "५-१३-६९", "content_sanskrit": "क्षुद्रेण हीनेन नृशंसमूर्तिना\nसुदारुणालंकृतवेषधारिणा।\nबलाभिभूता ह्यबला तपस्विनी\nकथं नु मे दृष्टिपथेऽद्य सा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000352070, "chapter_id": 9352, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]