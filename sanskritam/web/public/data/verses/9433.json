[{"id": 5000433000, "chapter_id": 9433, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000433001, "chapter_id": 9433, "verse_number": "६-२६-१", "content_sanskrit": "तद्वचः सत्यमक्लीबं सारणेनाभिभाषितम्।\nनिशम्य रावणो राजा प्रत्यभाषत सारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000433002, "chapter_id": 9433, "verse_number": "६-२६-२", "content_sanskrit": "यदि मामभियुञ्जीरन् देवगन्धर्वदानवाः।\nनैव सीतामहं दद्यां सर्वलोकभयादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000433003, "chapter_id": 9433, "verse_number": "६-२६-३", "content_sanskrit": "त्वं तु सौम्य परित्रस्तो हरिभिः पीडितो भृशम्।\nप्रतिप्रदानमद्यैव सीतायाः साधु मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000433004, "chapter_id": 9433, "verse_number": "६-२६-४", "content_sanskrit": "को हि नाम सपत्नो मां समरे जेतुमर्हति।\nइत्युक्त्वा परुषं वाक्यं रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000433005, "chapter_id": 9433, "verse_number": "६-२६-५", "content_sanskrit": "आरुरोह ततः श्रीमान् प्रासादं हिमपाण्डुरम्।\nबहुतालसमुत्सेधं रावणोऽथ दिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000433006, "chapter_id": 9433, "verse_number": "६-२६-६", "content_sanskrit": "ताभ्यां चराभ्यां सहितो रावणः क्रोधमूर्च्छितः।\nपश्यमानः समुद्रं तं पर्वतांश्च वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000433007, "chapter_id": 9433, "verse_number": "६-२६-७", "content_sanskrit": "ददर्श पृथिवीदेशं सुसम्पूर्णं प्लवंगमैः।\nतदपारमसह्यं च वानराणां महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000433008, "chapter_id": 9433, "verse_number": "६-२६-८", "content_sanskrit": "आलोक्य रावणो राजा परिपप्रच्छ सारणम्।\nएषां के वानरा मुख्याः के शूराः के महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000433009, "chapter_id": 9433, "verse_number": "६-२६-९", "content_sanskrit": "के पूर्वमभिवर्तन्ते महोत्साहाः समन्ततः।\nकेषां शृणोति सुग्रीवः के वा यूथपयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000433010, "chapter_id": 9433, "verse_number": "६-२६-१०", "content_sanskrit": "सारणाचक्ष्व मे सर्वं किंप्रभावाः प्लवंगमाः।\nसारणो राक्षसेन्द्रस्य वचनं परिपृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000433011, "chapter_id": 9433, "verse_number": "६-२६-११", "content_sanskrit": "आबभाषेऽथ मुख्यज्ञो मुख्यांस्तत्र वनौकसः।\nएष योऽभिमुखो लङ्कां नर्दंस्तिष्ठति वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000433012, "chapter_id": 9433, "verse_number": "६-२६-१२", "content_sanskrit": "यूथपानां सहस्राणां शतेन परिवारितः।\nयस्य घोषेण महता सप्राकारा सतोरणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000433013, "chapter_id": 9433, "verse_number": "६-२६-१३", "content_sanskrit": "लङ्का प्रतिहता सर्वा सशैलवनकानना।\nसर्वशाखामृगेन्द्रस्य सुग्रीवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000433014, "chapter_id": 9433, "verse_number": "६-२६-१४", "content_sanskrit": "बलाग्रे तिष्ठते वीरो नीलो नामैष यूथपः।\nबाहू प्रगृह्य यः पद‍्भ्यां महीं गच्छति वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000433015, "chapter_id": 9433, "verse_number": "६-२६-१५", "content_sanskrit": "लङ्कामभिमुखः कोपादभीक्ष्णं च विजृम्भते।\nगिरिशृङ्गप्रतीकाशः पद्मकिंजल्कसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000433016, "chapter_id": 9433, "verse_number": "६-२६-१६", "content_sanskrit": "स्फोटयत्यतिसंरब्धो लाङ्गूलं च पुनः पुनः।\nयस्य लाङ्गूलशब्देन स्वनन्ति प्रदिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000433017, "chapter_id": 9433, "verse_number": "६-२६-१७", "content_sanskrit": "एष वानरराजेन सुग्रीवेणाभिषेचितः।\nयुवराजोऽङ्गदो नाम त्वामाह्वयति संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000433018, "chapter_id": 9433, "verse_number": "६-२६-१८", "content_sanskrit": "वालिनः सदृशः पुत्रः सुग्रीवस्य सदा प्रियः।\nराघवार्थे पराक्रान्तः शक्रार्थे वरुणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000433019, "chapter_id": 9433, "verse_number": "६-२६-१९", "content_sanskrit": "एतस्य सा मतिः सर्वा यद् दृष्टा जनकात्मजा।\nहनूमता वेगवता राघवस्य हितैषिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000433020, "chapter_id": 9433, "verse_number": "६-२६-२०", "content_sanskrit": "बहूनि वानरेन्द्राणामेष यूथानि वीर्यवान्।\nपरिगृह्याभियाति त्वां स्वेनानीकेन मर्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000433021, "chapter_id": 9433, "verse_number": "६-२६-२१", "content_sanskrit": "अनुवालिसुतस्यापि बलेन महता वृतः।\nवीरस्तिष्ठति संग्रामे सेतुहेतुरयं नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000433022, "chapter_id": 9433, "verse_number": "६-२६-२२", "content_sanskrit": "ये तु विष्टभ्य गात्राणि क्ष्वेडयन्ति नदन्ति च।\nउत्थाय च विजृम्भन्ते क्रोधेन हरिपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000433023, "chapter_id": 9433, "verse_number": "६-२६-२३", "content_sanskrit": "एते दुष्प्रसहा घोराश्चण्डाश्चण्डपराक्रमाः।\nअष्टौ शतसहस्राणि दशकोटिशतानि च।\nय एनमनुगच्छन्ति वीराश्चन्दनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000433024, "chapter_id": 9433, "verse_number": "६-२६-२४", "content_sanskrit": "एषैवाशंसते लङ्कां स्वेनानीकेन मर्दितुम्।\nश्वेतो रजतसंकाशश्चपलो भीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000433025, "chapter_id": 9433, "verse_number": "६-२६-२५", "content_sanskrit": "बुद्धिमान् वानरः शूरस्त्रिषु लोकेषु विश्रुतः।\nतूर्णं सुग्रीवमागम्य पुनर्गच्छति वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000433026, "chapter_id": 9433, "verse_number": "६-२६-२६", "content_sanskrit": "विभजन् वानरीं सेनामनीकानि प्रहर्षयन्।\nयः पुरा गोमतीतीरे रम्यं पर्येति पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000433027, "chapter_id": 9433, "verse_number": "६-२६-२७", "content_sanskrit": "नाम्ना संरोचनो नाम नानानगयुतो गिरिः।\nतत्र राज्यं प्रशास्त्येष कुमुदो नाम यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000433028, "chapter_id": 9433, "verse_number": "६-२६-२८", "content_sanskrit": "योऽसौ शतसहस्राणि सहर्षं परिकर्षति।\nयस्य वाला बहुव्यामा दीर्घलाङ्गूलमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000433029, "chapter_id": 9433, "verse_number": "६-२६-२९", "content_sanskrit": "ताम्राः पीताः सिताः श्वेताः प्रकीर्णा घोरदर्शनाः।\nअदीनो वानरश्चण्डः संग्राममभिकाङ्क्षति।\nएषोऽप्याशंसते लङ्कां स्वेनानीकेन मर्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000433030, "chapter_id": 9433, "verse_number": "६-२६-३०", "content_sanskrit": "यस्त्वेष सिंहसंकाशः कपिलो दीर्घकेसरः।\nनिभृतः प्रेक्षते लङ्कां दिधक्षन्निव चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000433031, "chapter_id": 9433, "verse_number": "६-२६-३१", "content_sanskrit": "विन्ध्यं कृष्णगिरिं सह्यं पर्वतं च सुदर्शनम्।\nराजन् सततमध्यास्ते स रम्भो नाम यूथपः।\nशतं शतसहस्राणां त्रिंशच्च हरिपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000433032, "chapter_id": 9433, "verse_number": "६-२६-३२", "content_sanskrit": "यं यान्तं वानरा घोराश्चण्डाश्चण्डपराक्रमाः।\nपरिवार्यानुगच्छन्ति लङ्कां मर्दितुमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000433033, "chapter_id": 9433, "verse_number": "६-२६-३३", "content_sanskrit": "यस्तु कर्णौ विवृणुते जृम्भते च पुनः पुनः।\nन तु संविजते मृत्योर्न च सेनां प्रधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000433034, "chapter_id": 9433, "verse_number": "६-२६-३४", "content_sanskrit": "प्रकम्पते च रोषेण तिर्यक् च पुनरीक्षते।\nपश्य लाङ्गूलविक्षेपं क्ष्वेडत्येष महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000433035, "chapter_id": 9433, "verse_number": "६-२६-३५", "content_sanskrit": "महाजवो वीतभयो रम्यं साल्वेयपर्वतम्।\nराजन् सततमध्यास्ते शरभो नाम यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000433036, "chapter_id": 9433, "verse_number": "६-२६-३६", "content_sanskrit": "एतस्य बलिनः सर्वे विहारा नाम यूथपाः।\nराजन् शतसहस्राणि चत्वारिंशत्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000433037, "chapter_id": 9433, "verse_number": "६-२६-३७", "content_sanskrit": "यस्तु मेघ इवाकाशं महानावृत्य तिष्ठति।\nमध्ये वानरवीराणां सुराणामिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000433038, "chapter_id": 9433, "verse_number": "६-२६-३८", "content_sanskrit": "भेरीणामिव संनादो यस्यैष श्रूयते महान्।\nघोषः शाखामृगेन्द्राणां संग्राममभिकाङ्क्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000433039, "chapter_id": 9433, "verse_number": "६-२६-३९", "content_sanskrit": "एष पर्वतमध्यास्ते पारियात्रमनुत्तमम्।\nयुद्धे दुष्प्रसहो नित्यं पनसो नाम यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000433040, "chapter_id": 9433, "verse_number": "६-२६-४०", "content_sanskrit": "एनं शतसहस्राणां शतार्धं पर्युपासते।\nयूथपा यूथपश्रेष्ठं येषां यूथानि भागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000433041, "chapter_id": 9433, "verse_number": "६-२६-४१", "content_sanskrit": "यस्तु भीमां प्रवल्गन्तीं चमूं तिष्ठति शोभयन्।\nस्थितां तीरे समुद्रस्य द्वितीय इव सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000433042, "chapter_id": 9433, "verse_number": "६-२६-४२", "content_sanskrit": "एष दर्दुरसंकाशो विनतो नाम यूथपः।\nपिबंश्चरति यो वेणां नदीनामुत्तमां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000433043, "chapter_id": 9433, "verse_number": "६-२६-४३", "content_sanskrit": "षष्टिः शतसहस्राणि बलमस्य प्लवंगमाः।\nत्वामाह्वयति युद्धाय क्रोधनो नाम वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000433044, "chapter_id": 9433, "verse_number": "६-२६-४४", "content_sanskrit": "विक्रान्ता बलवन्तश्च यथा यूथानि भागशः।\nयस्तु गैरिकवर्णाभं वपुः पुष्यति वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000433045, "chapter_id": 9433, "verse_number": "६-२६-४५", "content_sanskrit": "अवमत्य सदा सर्वान् वानरान् बलदर्पितः।\nगवयो नाम तेजस्वी त्वां क्रोधादभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000433046, "chapter_id": 9433, "verse_number": "६-२६-४६", "content_sanskrit": "एनं शतसहस्राणि सप्ततिः पर्युपासते।\nएषैवाशंसते लङ्कां स्वेनानीकेन मर्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000433047, "chapter_id": 9433, "verse_number": "६-२६-४७", "content_sanskrit": "एते दुष्प्रसहा वीरा येषां संख्या न विद्यते।\nयूथपा यूथपश्रेष्ठास्तेषां यूथानि भागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000433048, "chapter_id": 9433, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]