[{"id": 2079017, "chapter_id": 2680, "verse_number": "१२-१८५-०x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079018, "chapter_id": 2680, "verse_number": "१२-१८५-१", "content_sanskrit": "न प्रणाशोऽस्ति जीवानां दत्तस्य च कृतस्य च।\nयाति देहान्तरं प्राणी शरीरं तु विशीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079019, "chapter_id": 2680, "verse_number": "१२-१८५-२", "content_sanskrit": "न शरीराश्रितो जीवस्तस्मिन्नष्टे प्रणश्यति।\nयथा समित्सु दग्धासु न प्रणश्यति पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079020, "chapter_id": 2680, "verse_number": "१२-१८५-३x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079021, "chapter_id": 2680, "verse_number": "१२-१८५-३", "content_sanskrit": "अग्नेर्यथा समिद्धस्य यदि नाशो न विद्यते।\nइन्धनस्योपयोगान्ते स चाग्निर्नोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079022, "chapter_id": 2680, "verse_number": "१२-१८५-४", "content_sanskrit": "नश्यतीत्येव जानामि शान्तमग्निमनिन्धनम्।\nमतिर्यस्य प्रमाणं वा संस्थानं वा न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079023, "chapter_id": 2680, "verse_number": "१२-१८५-५x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079024, "chapter_id": 2680, "verse_number": "१२-१८५-५", "content_sanskrit": "`जीवस्य चेन्धनाग्नेश्च सदा नाशो न विद्यते।\nसमिधामुपयोगान्ते सन्नेवाग्निर्न दृश्यते।\nआकाशानुगतत्वाद्धि दुर्ग्रहः स निराश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079025, "chapter_id": 2680, "verse_number": "१२-१८५-६", "content_sanskrit": "तथा शरीरसंत्यागे जीवो ह्याकाशमाश्रितः।\nन गृह्यते तु सूक्ष्मत्वाद्यथा ज्योतिरनिन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079026, "chapter_id": 2680, "verse_number": "१२-१८५-७", "content_sanskrit": "प्राणान्धारयते योऽग्निः स जीव उपधार्यताम्।\nवायुसंधारणो ह्यग्निर्नश्यत्युच्छ्वासनिग्रहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079027, "chapter_id": 2680, "verse_number": "१२-१८५-८", "content_sanskrit": "तस्मिन्नष्टे शरीराग्नौ शरीरं तदचेतनम्।\nपतितं याति भूमित्वमयनं तस्य हि क्षितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079028, "chapter_id": 2680, "verse_number": "१२-१८५-९", "content_sanskrit": "जङ्गमानां हि सर्वेषां स्थावराणां तथैव च।\nआकाशं पवनोऽन्वेति ज्योतिस्तमनुगच्छति।\nतेषां त्रयाणामेकत्वं द्वयं भूमौ प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079029, "chapter_id": 2680, "verse_number": "१२-१८५-१०", "content_sanskrit": "यत्र खं तत्र पवनस्तत्राग्निर्यत्र मारुतः।\nअमूर्तयस्ते विज्ञेया आपो मूर्तास्तथा क्षितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079030, "chapter_id": 2680, "verse_number": "१२-१८५-११x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079031, "chapter_id": 2680, "verse_number": "१२-१८५-११", "content_sanskrit": "यद्यग्निमारुतौ भूमिः खमापश्च शरीरिषु।\nजीवः किंलक्षणस्तत्रेत्येतदाचक्ष्व मेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079032, "chapter_id": 2680, "verse_number": "१२-१८५-१२", "content_sanskrit": "पञ्चात्मके पञ्चरतौ पञ्चविज्ञानसंयुते।\nशरीरे प्राणिनां जीवं वेत्तुमिच्छामि यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079033, "chapter_id": 2680, "verse_number": "१२-१८५-१३", "content_sanskrit": "मांसशोणितसंघाते मेदः स्नाय्वस्थिसंचये।\nभिद्यमाने शरीरे तु जीवो नैवोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079034, "chapter_id": 2680, "verse_number": "१२-१८५-१४", "content_sanskrit": "यद्यजीवं शरीरं तु पञ्चभूतसमन्वितम्।\nशारीरे मानसे दुःखे कस्तां वेदयते रुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079035, "chapter_id": 2680, "verse_number": "१२-१८५-१५", "content_sanskrit": "शृणोति कथितं जीवः कर्णाभ्यां न शृणोति तत्।\nमहर्षे मनसि व्यग्रे तस्माज्जीवो निरर्थकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079036, "chapter_id": 2680, "verse_number": "१२-१८५-१६", "content_sanskrit": "सर्वं पश्यति यद्दृश्यं मनोयुक्तेन चक्षुषा।\nमनसि व्याकुले तस्मिन्पश्यन्नपि न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079037, "chapter_id": 2680, "verse_number": "१२-१८५-१७", "content_sanskrit": "न पश्यति न चाघ्राति न शृणोति न भाषते।\nन च स्पर्शरसौ वेत्ति निद्रावशगतः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079038, "chapter_id": 2680, "verse_number": "१२-१८५-१८", "content_sanskrit": "हृष्यति क्रुध्यते कोऽत्र शोचत्युद्विजते च कः।\nइच्छति ध्यायति द्वेष्टि वाचमीरयते च कः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079039, "chapter_id": 2680, "verse_number": "१२-१८५-१९x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079040, "chapter_id": 2680, "verse_number": "१२-१८५-१९", "content_sanskrit": "न पञ्चसाधारणमत्र किंचि\nच्छरीरमेकी वहतेऽन्तरात्मा।\nस वेत्ति गन्धांश्च रसाञ्श्रुतीश्च\nस्पर्शं च रूपं च गुणाश्च येऽन्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079041, "chapter_id": 2680, "verse_number": "१२-१८५-२०", "content_sanskrit": "पञ्चात्मके पञ्चगुणप्रदर्शी\nस सर्वगात्रानुगतोऽन्तरात्मा।\nस वेत्ति दुःखानि सुखानि चात्र\nतद्विप्रयोगात्तु न वेत्ति देही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079042, "chapter_id": 2680, "verse_number": "१२-१८५-२१", "content_sanskrit": "यदा न रूपं न स्पर्शो नोष्मभावश्च पञ्चके।\nतदा शान्ते शरीराग्नौ देहं त्यक्त्वा न नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079043, "chapter_id": 2680, "verse_number": "१२-१८५-२२", "content_sanskrit": "अम्मयं सर्वमेवेदमापो मूर्तिः शरीरिणाम्।\nतत्रात्मा मानसो ब्रह्मा सर्व भूतेषु लोककृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079044, "chapter_id": 2680, "verse_number": "१२-१८५-२३", "content_sanskrit": "[आत्मा क्षेत्रज्ञ इत्युक्तः संयुक्तः प्राकृतैर्गुणैः।\nतैरेव तु विनिर्मुक्तः परमात्मेत्युदाहृतः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079045, "chapter_id": 2680, "verse_number": "१२-१८५-२४", "content_sanskrit": "आत्मानं तं विजानीहि सर्वलोकविपाचकम्।\nस तस्मिन्संश्रितो देहे ह्यब्बिन्दुरिव पुष्करे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079046, "chapter_id": 2680, "verse_number": "१२-१८५-२५", "content_sanskrit": "क्षेत्रज्ञं तं विजानीहि नित्यं लोकहितात्मकम्।\nतमो रजश्च सत्त्वं च विद्धि जीवगुणानिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079047, "chapter_id": 2680, "verse_number": "१२-१८५-२६", "content_sanskrit": "सचेतनं जीवगुणं वदन्ति\nस चेष्टते चेष्टयते च सर्वम्।\nततः परं क्षेत्रविदो वदन्ति\nप्रावर्तयद्यो भुवनानि सप्त॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2079048, "chapter_id": 2680, "verse_number": "१२-१८५-२७", "content_sanskrit": "न जीवनाशोऽस्ति हि देहभेदे\nमिथ्यैतदाहुर्मुत इत्यबुद्धाः।\nजीवस्तु देहान्तरितः प्रयाति\nदशार्धतैवास्य शरीरभेदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2079049, "chapter_id": 2680, "verse_number": "१२-१८५-२८", "content_sanskrit": "एवं सर्वेषु भूतेषु गूढश्चरति संवृतः।\nदृश्यते त्वग्र्यया बुद्ध्या सूक्ष्मया तत्त्वदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2079050, "chapter_id": 2680, "verse_number": "१२-१८५-२९", "content_sanskrit": "तं पूर्वापररात्रेषु युञ्जानः सततं बुधः।\nलध्वाहारो विशुद्धात्मा पश्यत्यात्मानंमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2079051, "chapter_id": 2680, "verse_number": "१२-१८५-३०", "content_sanskrit": "चित्तस्य हि प्रसादेन हित्वा कर्म शुभाशुभम्।\nप्रसन्नात्माऽत्मनि स्थित्वा सुखमव्ययमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2079052, "chapter_id": 2680, "verse_number": "१२-१८५-३१", "content_sanskrit": "मानसोऽग्निः शरीरेषु जीव इत्यभिधीयते।\nसृष्टिः प्रजापतेरेषा भूताध्यात्मविनिश्चया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2079053, "chapter_id": 2680, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चाशीत्यधिकशततमोऽध्यायः॥ १८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]