[{"id": 2070376, "chapter_id": 2475, "verse_number": "११-८-०x", "content_sanskrit": "[जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070377, "chapter_id": 2475, "verse_number": "११-८-१", "content_sanskrit": "गते भगवति व्यासे धृतराष्ट्रो महीपतिः।\nकिमचेष्टत विप्रर्षे तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070378, "chapter_id": 2475, "verse_number": "११-८-२", "content_sanskrit": "तथैव कौरवो राजा धर्मपुत्रो महामनाः।\nकृपप्रभृतयश्चैव किमकुर्वत ते त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070379, "chapter_id": 2475, "verse_number": "११-८-३", "content_sanskrit": "अश्वत्थाम्नः श्रुतं कर्म शापश्चान्योन्यकारितः।\nवृत्तान्तमुत्तरं ब्रूहि यदभाषत सञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070380, "chapter_id": 2475, "verse_number": "११-८-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070381, "chapter_id": 2475, "verse_number": "११-८-४", "content_sanskrit": "हते दुर्योधने चैव हते सैन्ये च सर्वशः।\nसञ्जयो विगतप्रज्ञो धृतराष्ट्रमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070382, "chapter_id": 2475, "verse_number": "११-८-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070383, "chapter_id": 2475, "verse_number": "११-८-५", "content_sanskrit": "आगम्य नानादेशेभ्यो नानाजनपदेश्वराः।\nपितृलोकं गता राजन्सर्वे तव सुतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070384, "chapter_id": 2475, "verse_number": "११-८-६", "content_sanskrit": "याच्यमानेन सततं तव पुत्रेण भारत।\nघातिता पृथिवी सर्वा वैरस्यान्तं विधित्सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070385, "chapter_id": 2475, "verse_number": "११-८-७", "content_sanskrit": "पुत्राणामथ पौत्राणां पितॄणां च महीपते।\nआनुपूर्व्येण सर्वेषां प्रेतकार्याणि कारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070386, "chapter_id": 2475, "verse_number": "११-८-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070387, "chapter_id": 2475, "verse_number": "११-८-८", "content_sanskrit": "तच्छ्रुत्वा वचनं घोरं सञ्जयस्य महीपतिः।\nगतासुरिव निश्चेष्टो न्यपतत्पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070388, "chapter_id": 2475, "verse_number": "११-८-९", "content_sanskrit": "तं शयानमुपागम्य पृथिव्यां पृथिवीपतिम्।\nविदुरः सर्वधर्मज्ञ इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070389, "chapter_id": 2475, "verse_number": "११-८-१०", "content_sanskrit": "उत्तिष्ठ राजन्किं शेषे मा शुचो भरतर्षभ।\nएषा वै सर्वसत्वानां लोकेश्वर परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070390, "chapter_id": 2475, "verse_number": "११-८-११", "content_sanskrit": "अभावादीनि भूतानि भावमध्यानि भारत।\nअभावनिधनान्येव तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070391, "chapter_id": 2475, "verse_number": "११-८-१२", "content_sanskrit": "न शोचन्मृतमन्वेति न शोचन्म्रियते नरः।\nएवं सांसिद्धिके लोके किमर्थमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070392, "chapter_id": 2475, "verse_number": "११-८-१३", "content_sanskrit": "अयुध्यमानो म्रियते युध्यमानस्तु जीवति।\nकालं प्राप्य महाराज न कश्चिदतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070393, "chapter_id": 2475, "verse_number": "११-८-१४", "content_sanskrit": "कालः कर्षति भूतानि सर्वाणि विविधानि च।\nन कालस्य प्रियः कश्चिन्न द्वेष्यः कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070394, "chapter_id": 2475, "verse_number": "११-८-१५", "content_sanskrit": "यथा वायुस्तृणाग्राणि संवर्तपति सर्वतः।\nतथा कालवशं यान्ति भूतानि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070395, "chapter_id": 2475, "verse_number": "११-८-१६", "content_sanskrit": "एकसार्थप्रयातानां सर्वेषां तत्र गामिनाम्।\nयस्य कालः प्रयात्यग्रे तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070396, "chapter_id": 2475, "verse_number": "११-८-१७", "content_sanskrit": "यांश्चापि निहतान्युद्धे राजंस्त्वमनुशोचसि।\nन शोच्या हि माहत्मानः सर्वे ते त्रिदिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070397, "chapter_id": 2475, "verse_number": "११-८-१८", "content_sanskrit": "न यज्ञैर्दक्षिणावद्भिर्न तपोभिर्न विद्यया।\nतथा स्वर्गमुपायान्ति यथा शूरास्तनुत्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070398, "chapter_id": 2475, "verse_number": "११-८-१९", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे सुचरितव्रताः।\nसर्वे चाभिमुखाः क्षीणास्तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070399, "chapter_id": 2475, "verse_number": "११-८-२०", "content_sanskrit": "शरीराग्निषु शूराणां जुहुवुस्ते शराहुतीः।\nहूयमानाञ्शरांश्चैव सेहुरुत्तमपूरषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070400, "chapter_id": 2475, "verse_number": "११-८-२१", "content_sanskrit": "एवं राजंस्तवाचक्षे स्वर्ग्यं पन्थानमुत्तमम्।\nन युद्धादधिकं किञ्चित्क्षत्रियस्येह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070401, "chapter_id": 2475, "verse_number": "११-८-२२", "content_sanskrit": "क्षत्रियास्ते महात्मानः शूराः समितिशोभनाः।\nआशिषं परमां प्राप्ता न शोच्याः सर्व एव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070402, "chapter_id": 2475, "verse_number": "११-८-२३", "content_sanskrit": "आत्मनाऽऽत्मानमाश्वास्य मा शुचः पुरुषर्षभ।\nनाद्य शोकाभिभूतस्त्वं कार्यमुत्स्नष्टुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070403, "chapter_id": 2475, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि अध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]