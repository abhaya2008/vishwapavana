[{"id": 7004245000, "chapter_id": 24245, "verse_number": "५-२-२३-१", "content_sanskrit": "श्रीहर उवाच ।\nमेघनादेश्वरं देवि त्रयोविंशतिमं शृणु ।\nयस्य दर्शनमात्रेण प्राप्यते सर्वसिद्धयः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004245001, "chapter_id": 24245, "verse_number": "५-२-२३-२", "content_sanskrit": "राजमूला महादेवि योगक्षेमाः सुवृष्टयः ।\nप्रजाश्च व्याधयश्चैव मरणं च भयानि च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004245002, "chapter_id": 24245, "verse_number": "५-२-२३-३", "content_sanskrit": "राजा कृतं तथा त्रेता द्वापरश्च तथा कलिः ।\nराजमूलानि सर्वाणि राजाधर्मस्य कारणम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004245003, "chapter_id": 24245, "verse_number": "५-२-२३-४", "content_sanskrit": "राजा बभूव लोकेऽस्मिन्मदांधोनाम पार्वति ।\nअहंकारावृतो दुष्टो देवब्राह्मणकंटकः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004245004, "chapter_id": 24245, "verse_number": "५-२-२३-५", "content_sanskrit": "कलि द्वापरयोः संधौ तस्य दोषाच्च भामिनि ।\nअनावृष्टिरभूद्धोरा लोके द्वादशवार्षिकी॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004245005, "chapter_id": 24245, "verse_number": "५-२-२३-६", "content_sanskrit": "न ववर्ष सहस्राक्षः प्रतिलोमोऽभवत्प्रभुः ।\nनादृश्यन्तापि रात्र्यंते कुत एवाभ्रजातयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004245006, "chapter_id": 24245, "verse_number": "५-२-२३-७", "content_sanskrit": "नद्यः संक्षिप्ततोयौघाः क्वचिदंतर्हितास्तदा ।\nनिवृत्तयज्ञस्वाध्याया निर्वषट्कारमंगलाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004245007, "chapter_id": 24245, "verse_number": "५-२-२३-८", "content_sanskrit": "उच्छिन्नकृषि गोरक्षा निवृत्तविपणास्तथा ।\nअस्थिकंकालसंकीर्णा हाहाभूतनराकुलाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004245008, "chapter_id": 24245, "verse_number": "५-२-२३-९", "content_sanskrit": "शून्यभूयिष्ठनगरा दग्धग्रामनिवेशिनः ।\nगोजाश्वमहिषैर्हीना भक्ष्यमाणाः परस्परम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004245009, "chapter_id": 24245, "verse_number": "५-२-२३-१०", "content_sanskrit": "आश्रमान्संपरित्यज्य पर्यधावन्नितस्ततः ।\nब्राह्मणा दुःखबहुला मृता नष्टाश्च पार्वति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004245010, "chapter_id": 24245, "verse_number": "५-२-२३-११", "content_sanskrit": "सूष्टिरुन्मूलिता सर्वा जंगमा स्थावराखिला ।\nएतस्मिन्नंतरे देवाः शक्राद्या भयविह्वलाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004245011, "chapter_id": 24245, "verse_number": "५-२-२३-१२", "content_sanskrit": "शरण्यं शरणं जग्मुर्देवदेवं जनार्दनम् ।\nक्षीरोदस्योत्तरे कूले श्वेतद्वीपं मनोरमम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004245012, "chapter_id": 24245, "verse_number": "५-२-२३-१३", "content_sanskrit": "ब्रह्मलोकादिभिर्लोकैरनौपम्यगुणं शुभम् ।\nसदानंदकरं शांतं सूर्यकोटिसमप्रभम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004245013, "chapter_id": 24245, "verse_number": "५-२-२३-१४", "content_sanskrit": "स्वेच्छाकल्पितवि न्यासप्रासादशयनासनम् ।\nवज्रेंद्रनीलवैडूर्यचंद्रकांतादिदीपितम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004245014, "chapter_id": 24245, "verse_number": "५-२-२३-१५", "content_sanskrit": "जरामृत्युभयोपेतसर्वव्याधिविवर्जितम् ।\nतस्मिन्द्वीपे ततो देवि सूर्य कोटिसमप्रभम् ।\nसाष्टांगां प्रणतिं कृत्वा ते देवाः स्तुतिमब्रुवन्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004245015, "chapter_id": 24245, "verse_number": "५-२-२३-१६", "content_sanskrit": "भवान्ब्रह्मा च रुद्रश्च महेंद्रो देवसत्तमः ।\nभवान्कर्त्ता विकर्त्ता च लोकानां प्रभवोऽव्ययः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004245016, "chapter_id": 24245, "verse_number": "५-२-२३-१७", "content_sanskrit": "एवं च सत्यं परमं तपश्च परमं तथा ।\nपवित्रं परममार्गं यज्ञस्त्वं परमः प्रभो॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004245017, "chapter_id": 24245, "verse_number": "५-२-२३-१८", "content_sanskrit": "परं हौत्रं परं धाम त्वामाहुः पुरुषं परम् ।\nएवं स्तुतस्तदा तैस्तु देवदेवो वरानने॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004245018, "chapter_id": 24245, "verse_number": "५-२-२३-१९", "content_sanskrit": "प्राह देवांस्ततः कृष्णः किं करोम्यद्य वः सुराः ।\nविज्ञप्तस्तैर्हरिर्देवो ह्यनावृष्ट्या प्रपीडितैः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004245019, "chapter_id": 24245, "verse_number": "५-२-२३-२०", "content_sanskrit": "उपायः कथ्यतां देव तुष्टिः धुष्टिर्यथा भवेत् ।\nध्यानेन चिंतयित्वा च कथयामास केशवः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004245020, "chapter_id": 24245, "verse_number": "५-२-२३-२१", "content_sanskrit": "गच्छध्वं त्रिदशाः सर्वे महाकालवने शुभे ।\nलिंगं वृष्टिकरं तत्र पुरा मेघैः प्रतिष्ठितम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004245021, "chapter_id": 24245, "verse_number": "५-२-२३-२२", "content_sanskrit": "मेघा वृष्टिकराः सर्वे तस्मिंल्लिंगे च संति वै ।\nतस्य लिंगस्य माहात्म्याद्वृष्टिरेव भविष्यति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004245022, "chapter_id": 24245, "verse_number": "५-२-२३-२३", "content_sanskrit": "प्रतीहारेश्वराद्देवादीशाने विद्यते सुराः ।\nतस्य तद्वचनं श्रुत्वा वासुदेवस्य पार्वति॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004245023, "chapter_id": 24245, "verse_number": "५-२-२३-२४", "content_sanskrit": "महाकालवने प्राप्ता यत्रास्ते लिंगमुत्तमम् ।\nतुष्टुवुः परया भक्त्या दृष्ट्वा देवं मनोरमम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004245024, "chapter_id": 24245, "verse_number": "५-२-२३-२५", "content_sanskrit": "नमस्तेऽस्तु महेशाय नमोऽनंताय मालिने ।\nनमस्तैजसमूर्त्ताय नमः सौंदर्यशालिने॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004245025, "chapter_id": 24245, "verse_number": "५-२-२३-२६", "content_sanskrit": "नमो योगाय वेदाय नमः पिंगजटाय ते ।\nअनंतज्ञानदेहाय नम ईश्वरमूर्त्तये॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004245026, "chapter_id": 24245, "verse_number": "५-२-२३-२७", "content_sanskrit": "नमः शुभ्राट्टहासाय नमस्तेऽस्तु शिखंडिने ।\nशंकराय नमस्तेऽस्तु नमस्तेस्तु पिनाकिने॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004245027, "chapter_id": 24245, "verse_number": "५-२-२३-२८", "content_sanskrit": "नमोंऽतकाय भव्याय त्र्यंबकायास्तु ते नमः ।\nनमस्ते बहुरूपाय नमस्तेऽचिंत्यमूर्त्तये॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004245028, "chapter_id": 24245, "verse_number": "५-२-२३-२९", "content_sanskrit": "नमो योगशरीराय नमस्ते सर्व सर्वदा ।\nनष्टं देव जगत्सर्वमनावृष्ट्या प्रपीडितम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004245029, "chapter_id": 24245, "verse_number": "५-२-२३-३०", "content_sanskrit": "सुवृष्ट्या देवदेवेश पाहि नः शरणागतान् ।\nएतस्मिन्नंतरे मेघा पार्वणांगारवर्चसः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004245030, "chapter_id": 24245, "verse_number": "५-२-२३-३१", "content_sanskrit": "लिंगमध्यात्समुत्तस्थुर्वादयंतो नभस्तलम् ।\nअन्योन्यवेगाभिहता ववृषुर्भूतले तदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004245031, "chapter_id": 24245, "verse_number": "५-२-२३-३२", "content_sanskrit": "जातं विनिष्प्रभं सर्वं न प्राज्ञायत किंचन ।\nतिमिरौघपरिक्षिप्ता रेजुश्चाथ दिशो दश॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004245032, "chapter_id": 24245, "verse_number": "५-२-२३-३३", "content_sanskrit": "ते तस्य देवदेवस्य माहात्म्येन प्रतोषिताः ।\nदेवाः प्रीतिं परां जग्मुः सर्वेऽमृतमिवोत्तमाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004245033, "chapter_id": 24245, "verse_number": "५-२-२३-३४", "content_sanskrit": "ततस्तमः संहरतो विनेशुश्च बलाहका ।\nप्रववुः शीतला वाताः प्रशांताश्च दिशो दश॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004245034, "chapter_id": 24245, "verse_number": "५-२-२३-३५", "content_sanskrit": "शुद्धप्रभाणि ज्योतींषि सोमं चक्रुः प्रदक्षिणाम् ।\nअविग्रहं ग्रहाश्चक्रुः प्रशांताश्चापि सिन्धवः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004245035, "chapter_id": 24245, "verse_number": "५-२-२३-३६", "content_sanskrit": "महर्षयो विशोकाश्च गंधर्वाश्च कलं जगुः ।\nअभूत्सृष्टिः पुनः सर्वा लिंगस्यास्य प्रभावतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004245036, "chapter_id": 24245, "verse_number": "५-२-२३-३७", "content_sanskrit": "सुरैः संपूज्य भक्त्या ते चक्रुर्नाम यथार्थतः ।\nअस्य लिंगस्य माहात्म्यं दृष्ट्वा प्रीताः सुरा बहु॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004245037, "chapter_id": 24245, "verse_number": "५-२-२३-३८", "content_sanskrit": "मेघनादेश्वरं नाम भविष्यत्यस्य सर्वतः ।\nमेघनादेश्वराख्यानं मया ते कथितं प्रिये॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004245038, "chapter_id": 24245, "verse_number": "५-२-२३-३९", "content_sanskrit": "भविष्यंति नरा भूमौ कृतार्थास्तत्प्रभावतः ।\nदर्शनादस्य लिंगस्य कामवृष्टिर्भविष्यति॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004245039, "chapter_id": 24245, "verse_number": "५-२-२३-४०", "content_sanskrit": "कल्पकोटिसहस्राणि कल्पकोटिशतानि च ।\nकुर्वंल्लिंगस्य स्नपनं रुद्रलोके महीयते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004245040, "chapter_id": 24245, "verse_number": "५-२-२३-४१", "content_sanskrit": "प्रभावः पठ्यते यत्र मेघनादस्य पार्वति ।\nअतिवृष्टिश्चैव ततो भविष्यति च भूतले॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]