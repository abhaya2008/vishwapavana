[{"id": 5000226000, "chapter_id": 9226, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000226001, "chapter_id": 9226, "verse_number": "३-३०-१", "content_sanskrit": "भित्त्वा तु तां गदां बाणै राघवो धर्मवत्सलः।\nस्मयमान इदं वाक्यं संरब्धमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000226002, "chapter_id": 9226, "verse_number": "३-३०-२", "content_sanskrit": "एतत् ते बलसर्वस्वं दर्शितं राक्षसाधम।\nशक्तिहीनतरो मत्तो वृथा त्वमुपगर्जसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000226003, "chapter_id": 9226, "verse_number": "३-३०-३", "content_sanskrit": "एषा बाणविनिर्भिन्ना गदा भूमितलं गता।\nअभिधानप्रगल्भस्य तव प्रत्ययघातिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000226004, "chapter_id": 9226, "verse_number": "३-३०-४", "content_sanskrit": "यत् त्वयोक्तं विनष्टानामिदमश्रुप्रमार्जनम्।\nराक्षसानां करोमीति मिथ्या तदपि ते वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000226005, "chapter_id": 9226, "verse_number": "३-३०-५", "content_sanskrit": "नीचस्य क्षुद्रशीलस्य मिथ्यावृत्तस्य रक्षसः।\nप्राणानपहरिष्यामि गरुत्मानमृतं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000226006, "chapter_id": 9226, "verse_number": "३-३०-६", "content_sanskrit": "अद्य ते भिन्नकण्ठस्य फेनबुद‍्बुदभूषितम्।\nविदारितस्य मद‍्बाणैर्मही पास्यति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000226007, "chapter_id": 9226, "verse_number": "३-३०-७", "content_sanskrit": "पांसुरूषितसर्वाङ्गः स्रस्तन्यस्तभुजद्वयः।\nस्वप्स्यसे गां समाश्लिष्य दुर्लभां प्रमदामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000226008, "chapter_id": 9226, "verse_number": "३-३०-८", "content_sanskrit": "प्रवृद्धनिद्रे शयिते त्वयि राक्षसपांसने।\nभविष्यन्ति शरण्यानां शरण्या दण्डका इमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000226009, "chapter_id": 9226, "verse_number": "३-३०-९", "content_sanskrit": "जनस्थाने हतस्थाने तव राक्षस मच्छरैः।\nनिर्भया विचरिष्यन्ति सर्वतो मुनयो वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000226010, "chapter_id": 9226, "verse_number": "३-३०-१०", "content_sanskrit": "अद्य विप्रसरिष्यन्ति राक्षस्यो हतबान्धवाः।\nबाष्पार्द्रवदना दीना भयादन्यभयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000226011, "chapter_id": 9226, "verse_number": "३-३०-११", "content_sanskrit": "अद्य शोकरसज्ञास्ता भविष्यन्ति निरर्थिकाः।\nअनुरूपकुलाः पत्न्यो यासां त्वं पतिरीदृशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000226012, "chapter_id": 9226, "verse_number": "३-३०-१२", "content_sanskrit": "नृशंसशील क्षुद्रात्मन् नित्यं ब्राह्मणकण्टक।\nत्वत्कृते शङ्कितैरग्नौ मुनिभिः पात्यते हविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000226013, "chapter_id": 9226, "verse_number": "३-३०-१३", "content_sanskrit": "तमेवमभिसंरब्धं ब्रुवाणं राघवं वने।\nखरो निर्भर्त्सयामास रोषात् खरतरस्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000226014, "chapter_id": 9226, "verse_number": "३-३०-१४", "content_sanskrit": "दृढं खल्ववलिप्तोऽसि भयेष्वपि च निर्भयः।\nवाच्यावाच्यं ततो हि त्वं मृत्योर्वश्यो न बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000226015, "chapter_id": 9226, "verse_number": "३-३०-१५", "content_sanskrit": "कालपाशपरिक्षिप्ता भवन्ति पुरुषा हि ये।\nकार्याकार्यं न जानन्ति ते निरस्तषडिन्द्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000226016, "chapter_id": 9226, "verse_number": "३-३०-१६", "content_sanskrit": "एवमुक्त्वा ततो रामं संरुध्य भृकुटिं ततः।\nस ददर्श महासालमविदूरे निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000226017, "chapter_id": 9226, "verse_number": "३-३०-१७", "content_sanskrit": "रणे प्रहरणस्यार्थे सर्वतो ह्यवलोकयन्।\nस तमुत्पाटयामास संदष्टदशनच्छदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000226018, "chapter_id": 9226, "verse_number": "३-३०-१८", "content_sanskrit": "तं समुत्क्षिप्य बाहुभ्यां विनर्दित्वा महाबलः।\nराममुद्दिश्य चिक्षेप हतस्त्वमिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000226019, "chapter_id": 9226, "verse_number": "३-३०-१९", "content_sanskrit": "तमापतन्तं बाणौघैश्छित्त्वा रामः प्रतापवान्।\nरोषमाहारयत् तीव्रं निहन्तुं समरे खरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000226020, "chapter_id": 9226, "verse_number": "३-३०-२०", "content_sanskrit": "जातस्वेदस्ततो रामो रोषरक्तान्तलोचनः।\nनिर्बिभेद सहस्रेण बाणानां समरे खरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000226021, "chapter_id": 9226, "verse_number": "३-३०-२१", "content_sanskrit": "तस्य बाणान्तराद् रक्तं बहु सुस्राव फेनिलम्।\nगिरेः प्रस्रवणस्येव धाराणां च परिस्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000226022, "chapter_id": 9226, "verse_number": "३-३०-२२", "content_sanskrit": "विकलः स कृतो बाणैः खरो रामेण संयुगे।\nमत्तो रुधिरगन्धेन तमेवाभ्यद्रवद् द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000226023, "chapter_id": 9226, "verse_number": "३-३०-२३", "content_sanskrit": "तमापतन्तं संक्रुद्धं कृतास्त्रो रुधिराप्लुतम्।\nअपासर्पद् द्वित्रिपदं किंचित्त्वरितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000226024, "chapter_id": 9226, "verse_number": "३-३०-२४", "content_sanskrit": "ततः पावकसंकाशं वधाय समरे शरम्।\nखरस्य रामो जग्राह ब्रह्मदण्डमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000226025, "chapter_id": 9226, "verse_number": "३-३०-२५", "content_sanskrit": "स तद् दत्तं मघवता सुरराजेन धीमता।\nसंदधे च स धर्मात्मा मुमोच च खरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000226026, "chapter_id": 9226, "verse_number": "३-३०-२६", "content_sanskrit": "स विमुक्तो महाबाणो निर्घातसमनिःस्वनः।\nरामेण धनुरायम्य खरस्योरसि चापतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000226027, "chapter_id": 9226, "verse_number": "३-३०-२७", "content_sanskrit": "स पपात खरो भूमौ दह्यमानः शराग्निना।\nरुद्रेणेव विनिर्दग्धः श्वेतारण्ये यथान्धकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000226028, "chapter_id": 9226, "verse_number": "३-३०-२८", "content_sanskrit": "स वृत्र इव वज्रेण फेनेन नमुचिर्यथा।\nबलो वेन्द्राशनिहतो निपपात हतः खरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000226029, "chapter_id": 9226, "verse_number": "३-३०-२९", "content_sanskrit": "एतस्मिन्नन्तरे देवाश्चारणैः सह संगताः।\nदुन्दुभींश्चाभिनिघ्नन्तः पुष्पवर्षं समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000226030, "chapter_id": 9226, "verse_number": "३-३०-३०", "content_sanskrit": "रामस्योपरि संहृष्टा ववर्षुर्विस्मितास्तदा।\nअर्धाधिकमुहूर्तेन रामेण निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000226031, "chapter_id": 9226, "verse_number": "३-३०-३१", "content_sanskrit": "चतुर्दश सहस्राणि रक्षसां कामरूपिणाम्।\nखरदूषणमुख्यानां निहतानि महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000226032, "chapter_id": 9226, "verse_number": "३-३०-३२", "content_sanskrit": "अहो बत महत्कर्म रामस्य विदितात्मनः।\nअहो वीर्यमहो दार्ढ्यं विष्णोरिव हि दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000226033, "chapter_id": 9226, "verse_number": "३-३०-३३", "content_sanskrit": "इत्येवमुक्त्वा ते सर्वे ययुर्देवा यथागतम्।\nततो राजर्षयः सर्वे संगताः परमर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000226034, "chapter_id": 9226, "verse_number": "३-३०-३४", "content_sanskrit": "सभाज्य मुदिता रामं सागस्त्या इदमब्रुवन्।\nएतदर्थं महातेजा महेन्द्रः पाकशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000226035, "chapter_id": 9226, "verse_number": "३-३०-३५", "content_sanskrit": "शरभङ्गाश्रमं पुण्यमाजगाम पुरंदरः।\nआनीतस्त्वमिमं देशमुपायेन महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000226036, "chapter_id": 9226, "verse_number": "३-३०-३६", "content_sanskrit": "एषां वधार्थं शत्रूणां रक्षसां पापकर्मणाम्।\nतदिदं नः कृतं कार्यं त्वया दशरथात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000226037, "chapter_id": 9226, "verse_number": "३-३०-३७", "content_sanskrit": "स्वधर्मं प्रचरिष्यन्ति दण्डकेषु महर्षयः।\nएतस्मिन्नन्तरे वीरो लक्ष्मणः सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000226038, "chapter_id": 9226, "verse_number": "३-३०-३८", "content_sanskrit": "गिरिदुर्गाद् विनिष्क्रम्य संविवेशाश्रमे सुखी\nततो रामस्तु विजयी पूज्यमानो महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000226039, "chapter_id": 9226, "verse_number": "३-३०-३९", "content_sanskrit": "प्रविवेशाश्रमं वीरो लक्ष्मणेनाभिपूजितः।\nतं दृष्ट्वा शत्रुहन्तारं महर्षीणां सुखावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000226040, "chapter_id": 9226, "verse_number": "३-३०-४०", "content_sanskrit": "बभूव हृष्टा वैदेही भर्तारं परिषस्वजे।\nमुदा परमया युक्ता दृष्ट्वा रक्षोगणान् हतान्।\nरामं चैवाव्ययं दृष्ट्वा तुतोष जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000226041, "chapter_id": 9226, "verse_number": "३-३०-४१", "content_sanskrit": "ततस्तु तं राक्षससङ्घमर्दनं\nसम्पूज्यमानं मुदितैर्महात्मभिः।\nपुनः परिष्वज्य मुदान्वितानना\nबभूव हृष्टा जनकात्मजा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000226042, "chapter_id": 9226, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]