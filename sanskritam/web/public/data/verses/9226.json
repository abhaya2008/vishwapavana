[{"id": 40015484, "chapter_id": 9226, "verse_number": "1", "content_sanskrit": "सतुकृत्वासुवेलस्यमतिमारोहणंप्रति । लक्ष्मणानुगतोरामःसुग्रीवमिदमब्रवीत् ॥ विभीषणंचधर्मज्ञमनुरक्तंनिशाचरम् । मन्त्रज्ञंचविधिज्ञंचश्लक्क्ष्णयापरयागिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015485, "chapter_id": 9226, "verse_number": "2", "content_sanskrit": "सतुकृत्वासुवेलस्यमतिमारोहणंप्रति । लक्ष्मणानुगतोरामःसुग्रीवमिदमब्रवीत् ॥ विभीषणंचधर्मज्ञमनुरक्तंनिशाचरम् । मन्त्रज्ञंचविधिज्ञंचश्लक्क्ष्णयापरयागिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015486, "chapter_id": 9226, "verse_number": "3", "content_sanskrit": "सुवेलंसाधुशैलेन्द्रमिमंधातुशतैश्चितम् । अध्यारोहामहेसर्वेवत्स्यामोऽत्रनिशामिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015487, "chapter_id": 9226, "verse_number": "4", "content_sanskrit": "लङ्कांचालोकयिष्यामोनिलयंतस्यरक्षसः । येनमेमरणान्तायहृताभार्यादुरात्मना ॥ येनधर्मोनविज्ञातोनतद्वृत्तंनकुलंतथा । राक्षस्यानीचयाबुद् ध्यायेनतद्गर्हितंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015488, "chapter_id": 9226, "verse_number": "5", "content_sanskrit": "लङ्कांचालोकयिष्यामोनिलयंतस्यरक्षसः । येनमेमरणान्तायहृताभार्यादुरात्मना ॥ येनधर्मोनविज्ञातोनतद्वृत्तंनकुलंतथा । राक्षस्यानीचयाबुद् ध्यायेनतद्गर्हितंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015489, "chapter_id": 9226, "verse_number": "6", "content_sanskrit": "तस्मिन्मेवर्ततेरोषःकीर्तितेराक्षसाधमे । यस्यापराधाननीचस्यवधंद्रक्ष्यामिरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015490, "chapter_id": 9226, "verse_number": "7", "content_sanskrit": "एकोहिकुरुतेपापंकालपाशवशंगतः । नीचेनात्मापचारेणकुलंतेनविनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015491, "chapter_id": 9226, "verse_number": "8", "content_sanskrit": "एवंसम्मन्त्रयन्नेवसक्रोधोरावणंप्रति । रामःसुवेलमासाद्यचित्रसानुमुपारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015492, "chapter_id": 9226, "verse_number": "9", "content_sanskrit": "पृष्ठतोलक्ष्मणश्चैवमन्वगच्छत्समाहितः । सशरंचापमुद्यम्यसुमहद्विक्रमेरतः ॥ अन्वारोहत्सुग्रीवस्सामात्यस्सविभीषणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015493, "chapter_id": 9226, "verse_number": "10", "content_sanskrit": "हनुमानङ्गदोनीलोमैन्दोद्विविदएवच ॥ गजोगवाक्षोगवयश्शरभोगन्धमादनः । पनसःकुमुदश्चैवहरोरम्भश्चयूथपः ॥ जाम्बवांश्चसुषेणश्चऋषभश्चमहामतिः । दुर्मुखश्चमहातेजास्तथाशतवलिःकपिः ॥ एतेचान्येचबहवोवानराशशीघ्रगामिनः । तेवायुवेगप्रवणास्तंगिरिगिरिचारिणः ॥ अध्यारोहन्तशतशस्सुवेलंयत्रराघवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015494, "chapter_id": 9226, "verse_number": "11", "content_sanskrit": "हनुमानङ्गदोनीलोमैन्दोद्विविदएवच ॥ गजोगवाक्षोगवयश्शरभोगन्धमादनः । पनसःकुमुदश्चैवहरोरम्भश्चयूथपः ॥ जाम्बवांश्चसुषेणश्चऋषभश्चमहामतिः । दुर्मुखश्चमहातेजास्तथाशतवलिःकपिः ॥ एतेचान्येचबहवोवानराशशीघ्रगामिनः । तेवायुवेगप्रवणास्तंगिरिगिरिचारिणः ॥ अध्यारोहन्तशतशस्सुवेलंयत्रराघवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015495, "chapter_id": 9226, "verse_number": "12", "content_sanskrit": "हनुमानङ्गदोनीलोमैन्दोद्विविदएवच ॥ गजोगवाक्षोगवयश्शरभोगन्धमादनः । पनसःकुमुदश्चैवहरोरम्भश्चयूथपः ॥ जाम्बवांश्चसुषेणश्चऋषभश्चमहामतिः । दुर्मुखश्चमहाते