[{"id": 2024291, "chapter_id": 1521, "verse_number": "३-१५९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024292, "chapter_id": 1521, "verse_number": "३-१५९-१", "content_sanskrit": "निहते राक्षसे तस्मिन्पुनर्नारायणाश्रमम्।\nअभ्येत्य राजा कौन्तेयो निवासमकरोत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024293, "chapter_id": 1521, "verse_number": "३-१५९-२", "content_sanskrit": "स समानीय तान्सर्वान्भ्रातॄनित्यब्रवीद्वचः।\nद्रौपद्या सहितः काले संस्मरन्भ्रातरं जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024294, "chapter_id": 1521, "verse_number": "३-१५९-३", "content_sanskrit": "समाश्चतस्रोऽभिगताः शिवेन चरतां वने।\nकृतोद्देशः स बीभत्सुऋ पञ्चमीमभितः समाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024295, "chapter_id": 1521, "verse_number": "३-१५९-४", "content_sanskrit": "प्राप्य पर्वतराजानं श्वेतं शिखरिणांवरम्।\n[पुष्पितैर्द्रुमषण्डैश्च मत्तकोकिलाषट्पदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024296, "chapter_id": 1521, "verse_number": "३-१५९-५", "content_sanskrit": "मयूरैश्चातकैश्चापि नित्योत्सवविभूषितम्।\nव्याघ्रैर्वरहैर्महिषैर्गवयैर्हरिणैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024297, "chapter_id": 1521, "verse_number": "३-१५९-६", "content_sanskrit": "श्वापदैर्व्यालरूपैश्च रुरुभिश्च निषेवितम्।\nफुल्लैः सहस्रपत्रैश्च शतपत्रैस्तथोत्पलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024298, "chapter_id": 1521, "verse_number": "३-१५९-७", "content_sanskrit": "प्रफुल्लैः कमलैश्चैव तथा नीलोत्पलैरपि।\nमहापुणअयं पवित्रं च सुरासुरनिषेवितम्।]\nतत्रापि च कृतोद्देशः समागमदिदृक्षुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024299, "chapter_id": 1521, "verse_number": "३-१५९-८", "content_sanskrit": "कृतश्च समयस्तेन पार्थेनामिततेजसा।\nपञ्चवर्षाणि वत्स्याभि विद्यार्थीति पुरा मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024300, "chapter_id": 1521, "verse_number": "३-१५९-९", "content_sanskrit": "अत्रगाण्डीवधन्वानमवाप्तास्त्रमरिंदमम्।\nदेवलोकादिमं लोकं द्रक्ष्यामः पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024301, "chapter_id": 1521, "verse_number": "३-१५९-१०", "content_sanskrit": "इत्युक्त्वा ब्राह्मणान्सर्वानामन्त्रयत पाण्डवः।\nकारणं चैव तत्तेवामाचचक्षे तपस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024302, "chapter_id": 1521, "verse_number": "३-१५९-११", "content_sanskrit": "तमुग्रतपसः प्रीताः कुत्वापार्थं प्रदक्षिणम्।\nब्राह्मणास्तेऽन्वमोदन्त शिवेन कुशलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024303, "chapter_id": 1521, "verse_number": "३-१५९-१२", "content_sanskrit": "सुखोदर्कमिमं क्लेशमचिराद्भरतर्षभ।\nक्षत्रधर्मेण धर्मज्ञ तीर्त्वा गां पालयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024304, "chapter_id": 1521, "verse_number": "३-१५९-१३", "content_sanskrit": "तत्तु राजा वचस्तेषां प्रतिगृह्य तपस्विनाम्।\nप्रतस्थे सह विप्रैस्तैर्भ्रातृभिश्च परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024305, "chapter_id": 1521, "verse_number": "३-१५९-१४", "content_sanskrit": "`द्रौपद्या सहितः श्रीमान्हैडिम्बेयादिभिस्तदा।\nराक्षसैरनुयातो वै लोमशेनाभिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024306, "chapter_id": 1521, "verse_number": "३-१५९-१५", "content_sanskrit": "क्वचित्पद्भ्यां ततोऽगच्छद्राक्षसैरुदह्यते क्वचित्।\nतत्रतत्र महातेजा भ्रातृभिः सह सुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024307, "chapter_id": 1521, "verse_number": "३-१५९-१६", "content_sanskrit": "ततो युधिष्ठिरो राजा बहुन्क्लेशान्विचिन्तयन्।\nसिंहव्याघ्रगजाकीर्णामुदीचीं प्रययौ दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024308, "chapter_id": 1521, "verse_number": "३-१५९-१७", "content_sanskrit": "अवेमाण कैलासं मैनाकं चैव पर्वतम्।\nगन्धमादनपादांश्च मेरुं चापि शिलोच्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024309, "chapter_id": 1521, "verse_number": "३-१५९-१८", "content_sanskrit": "उपर्युपरि शैलस्य बहीश्च सरितः शिवाः।\nपृष्ठं हिमवतः पुण्यं ययौ सप्तदशेऽहनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024310, "chapter_id": 1521, "verse_number": "३-१५९-१९", "content_sanskrit": "ददृशुः पाण्डवा राजन्गन्धमादनमन्तिकम्।\nपृष्ठे हिमवतः पुण्ये नानाद्रुमलतावृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024311, "chapter_id": 1521, "verse_number": "३-१५९-२०", "content_sanskrit": "सलिलावर्तसंजातैः पुष्पितैश्च महीरुहैः।\nसमावृतं पुण्यतममाश्रमं वृषपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024312, "chapter_id": 1521, "verse_number": "३-१५९-२१", "content_sanskrit": "तमुपक्रम्य राजर्षिं धर्मात्मानमरिंदमाः।\nपाण्डवा वृषपर्वाणमवदन्त गतक्लमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024313, "chapter_id": 1521, "verse_number": "३-१५९-२२", "content_sanskrit": "अभ्यनन्दत्स राजर्षिः पुत्रवद्भरतर्षभान्।\nपूजिताश्चावसंस्तत्रसप्तरात्रमरिंदमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024314, "chapter_id": 1521, "verse_number": "३-१५९-२३", "content_sanskrit": "अष्टमेऽहनि संप्राप्ते तमृषिं लोकविश्रुतम्।\nआमन्त्र्य वृषपर्वाणं प्रस्थानं प्रत्यरोचयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024315, "chapter_id": 1521, "verse_number": "३-१५९-२४", "content_sanskrit": "एकैकशश्च तान्विप्रान्निवेद्य वृषपर्वणि।\nन्यासभूतान्यथाकालं बन्धूनिव सुसत्कृतान्।\nपारिबर्हं चतं शेषं परिदाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024316, "chapter_id": 1521, "verse_number": "३-१५९-२५", "content_sanskrit": "ततस्ते यज्ञपात्राणि रत्नान्याभरणानि च।\nन्यदधुःपाण्डवा राजन्नाश्रमे वृषपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024317, "chapter_id": 1521, "verse_number": "३-१५९-२६", "content_sanskrit": "अतीतानागते विद्वान्कुशलः सर्वधर्मवित्।\nअन्वशासत्स धर्मज्ञः पुत्रवद्भरतर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024318, "chapter_id": 1521, "verse_number": "३-१५९-२७", "content_sanskrit": "तेऽनुज्ञाता महात्मानः प्रययुर्दिशमुत्तराम्।\n`कुष्णया सहिता वीरा ब्राह्मणैश्च महात्मभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024319, "chapter_id": 1521, "verse_number": "३-१५९-२८", "content_sanskrit": "तान्प्रस्थितानन्वगच्छद्वृषपर्वा महीपतीन्।\nउपन्यस् महातेजा विप्रेभ्यः पाण्डवांस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024320, "chapter_id": 1521, "verse_number": "३-१५९-२९", "content_sanskrit": "अनुसंसार्य कौन्तेयानाशीर्भिरभिनन्द्य च।\nवृषपर्वा निववृतेपन्थानमुपदिश्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024321, "chapter_id": 1521, "verse_number": "३-१५९-३०", "content_sanskrit": "नानामृगगणैर्जुष्टं कौन्तेयः सत्यविक्रमः।\nपदातिर्भ्रातृभिः सार्धं प्रातिष्ठत युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024322, "chapter_id": 1521, "verse_number": "३-१५९-३१", "content_sanskrit": "नानाद्रुमनिरोधेषु वसन्तः शैलसानुषु।\nपर्वतं विविशुस्ते तं चतुर्थेऽहनि पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024323, "chapter_id": 1521, "verse_number": "३-१५९-३२", "content_sanskrit": "महाभ्रघनसंकाशं सलिलोपहितं शुभम्।\nमणिकाञ्चनरम्यं च शैलं नानासमुच्छ्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024324, "chapter_id": 1521, "verse_number": "३-१५९-३३", "content_sanskrit": "`रम्यं हिमवतः प्रस्थं बहुकन्दरनिर्झरम्।\nशिलाविभङ्गविकटं लतापादपसङ्कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024325, "chapter_id": 1521, "verse_number": "३-१५९-३४", "content_sanskrit": "ते समासाद्यपन्थानं यतोक्तं वृषपर्वणा।\nअनुसस्रुर्यथोद्देशं पश्यन्तो विविधान्नगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024326, "chapter_id": 1521, "verse_number": "३-१५९-३५", "content_sanskrit": "उपर्युपरि शैलस्य गुहाः परमदुर्गमाः।\nसुदुर्गमांस्ते सुबहून्सुखेनैवाभिचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024327, "chapter_id": 1521, "verse_number": "३-१५९-३६", "content_sanskrit": "धौम्यः कृष्णा च पार्ताश्च लोमशश्च महानृषिः।\nआगच्छन्सहितास्तत्रन कश्चिदपि हीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024328, "chapter_id": 1521, "verse_number": "३-१५९-३७", "content_sanskrit": "ते मृगद्विजसंघुष्टं नानाद्रुमलतायुतम्।\nशाखामृगगणैश्चैव सेवितं सुमनोरमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024329, "chapter_id": 1521, "verse_number": "३-१५९-३८", "content_sanskrit": "पुण्यं पद्मसरोपेतं सपल्वलमहावनम्।\nउपतस्थुर्महाभागा माल्यवतं महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024330, "chapter_id": 1521, "verse_number": "३-१५९-३९", "content_sanskrit": "ततः किंपुरुषावासं सिद्धचारणसेवितम्।\nददृशुर्हृषरोमाणाः पर्वतं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024331, "chapter_id": 1521, "verse_number": "३-१५९-४०", "content_sanskrit": "विद्याधरानुचरितं किन्नरीभिस्तथैव च।\nगजसङ्घसमावासं सिंहव्याघ्रगणायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024332, "chapter_id": 1521, "verse_number": "३-१५९-४१", "content_sanskrit": "शरभोन्नादसंघुष्टं नानमृगनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024333, "chapter_id": 1521, "verse_number": "३-१५९-४२", "content_sanskrit": "ते गन्धमादनवनं तन्नन्दनवनोपमम्।\nमुदिताः पाण्डुतनया मनोनयननन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024334, "chapter_id": 1521, "verse_number": "३-१५९-४३", "content_sanskrit": "विविशुः क्रमशो वीरा अरण्यं शुभकाननम्।\nद्रौपदीसहिता वीरास्तैश्च विप्रैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024335, "chapter_id": 1521, "verse_number": "३-१५९-४४", "content_sanskrit": "शृण्वन्तः प्रीतिजननान्वल्गून्मन्दकलाञ्शुभान्।\nश्रोत्ररम्यान्सुमधुराञ्शब्दान्खगमुखेरितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2024336, "chapter_id": 1521, "verse_number": "३-१५९-४५", "content_sanskrit": "सर्वर्तुफलभाराञ्यान्सर्वर्तुकुसुमोज्ज्वलाम्।\nपश्यन्तः पादपांस्चापि फलभारावनामितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2024337, "chapter_id": 1521, "verse_number": "३-१५९-४६", "content_sanskrit": "आम्रानाम्रातकान्फुल्लान्नारिकेलान्सतिन्दुकान्।\nमुञ्जातकांस्तथाञ्जीरान्दाडिमान्बीजपूरकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2024338, "chapter_id": 1521, "verse_number": "३-१५९-४७", "content_sanskrit": "पनसाँल्लिकुचान्मोचाः खर्जूरानम्लवेतसान्।\nपरावतांस्तथा क्षौद्रानीपांश्चापि मनोरमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2024339, "chapter_id": 1521, "verse_number": "३-१५९-४८", "content_sanskrit": "बेल्वान्कपित्थाञ्जम्बूश्च काश्मरीर्ब्रदरीस्तथा।\nपुक्षानुदुम्बरवटानश्वत्थान्क्षीरिकास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2024340, "chapter_id": 1521, "verse_number": "३-१५९-४९", "content_sanskrit": "मल्लातकानामलकीर्हरीतकबिभीतकान्।\nइङ्गुदान्करमर्दांश्च तिन्दुकांश् महाफलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2024341, "chapter_id": 1521, "verse_number": "३-१५९-५०", "content_sanskrit": "एतानन्यांश्च विविधान्गन्धमादनसानुषु।\nफलैरमृतकल्पैस्तानाचितान्स्वादुभिस्तरूपन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2024342, "chapter_id": 1521, "verse_number": "३-१५९-५१", "content_sanskrit": "तथैव चम्पकाशोकान्केतकान्बकुलांस्तथा।\nपुन्नागान्सप्तपर्णांश्च कर्णिकारान्सकेतकान्।\nपाटलान्कुटजान्रम्यान्मन्दारेन्दीवरांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2024343, "chapter_id": 1521, "verse_number": "३-१५९-५२", "content_sanskrit": "पारिजातान्कोविदारान्देवदारुद्रुमांस्तथा।\nपारिजातान्कोविदारान्देवदारुद्रुमांस्तथा।\nशालांस्तालांस्तमालांश्च पिप्पलान्हिङ्गुकांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2024344, "chapter_id": 1521, "verse_number": "३-१५९-५३", "content_sanskrit": "चकोरैः शतपत्रैश् भृङ्गराजैस्तथा शुकैः।\nकोकिलैः कलविङ्कैश्च हारितैर्जीवजीवकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2024345, "chapter_id": 1521, "verse_number": "३-१५९-५४", "content_sanskrit": "प्रियकैश्चातकैश्चैव तथाऽन्यैर्विविधैः खगैः।\nश्रोत्ररम्यं सुमधुरं कूजद्भिश्चाप्यधिष्ठितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2024346, "chapter_id": 1521, "verse_number": "३-१५९-५५", "content_sanskrit": "सरांसि च मनोज्ञानि समन्ताज्जलचारिभिः।\nकुमुदैः पुण्डरीकैश्च तृथा कोकनदोत्पलैः।\nकहारैः कमलैश्चैव आचितानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2024347, "chapter_id": 1521, "verse_number": "३-१५९-५६", "content_sanskrit": "कादम्बैश्चक्रवाकैश्च कुररैर्जलकुक्कुटैः।\nकारण्डवैः प्लवैर्हंसैर्बकैर्मद्गुभिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2024348, "chapter_id": 1521, "verse_number": "३-१५९-५७", "content_sanskrit": "एतैश्चान्यैश्च कीर्णानि समन्ताज्जलचारिभिः।\nहृष्टैस्तथा तामरसरसासवमदालसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2024349, "chapter_id": 1521, "verse_number": "३-१५९-५८", "content_sanskrit": "पद्मोदरच्युतरजःकिञ्जल्कारुणरञ्जितैः।\nमञ्जुस्वरैर्मधुकरैर्विरुतान्कमलाकरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2024350, "chapter_id": 1521, "verse_number": "३-१५९-५९", "content_sanskrit": "अपश्यंस्ते नरव्याघ्रा गन्धमादनसानुषु।\nतथैव पद्मषण्डैश्च मण्डितांश्च समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2024351, "chapter_id": 1521, "verse_number": "३-१५९-६०", "content_sanskrit": "शिखण्डिनीभिः सहिताँल्लतामण्डलकेषु च।\nमेघतूर्यरवोद्दाममदनाकुलितान्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2024352, "chapter_id": 1521, "verse_number": "३-१५९-६१", "content_sanskrit": "कृत्वैव केकामधुरं संगीतं मधुरस्वरम्।\nचित्रान्कलापान्विस्तीर्य सविलासान्मदालसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2024353, "chapter_id": 1521, "verse_number": "३-१५९-६२", "content_sanskrit": "मयूरान्ददृशुर्हृष्टान्नृत्यतो वनलालसान्।\nकांश्चित्प्रियाभिः सहितान्रममाणान्कलापिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2024354, "chapter_id": 1521, "verse_number": "३-१५९-६३", "content_sanskrit": "वल्लीलतासंकटेषु कुटजेषु स्थितांस्तथा।\nकांश्चिच्च कुटजानां तु विटपेषूत्कटानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2024355, "chapter_id": 1521, "verse_number": "३-१५९-६४", "content_sanskrit": "कलापरुचिराटोपनिचितान्मुकुटानिव।\nविवरेषु तरूणां च रुचिरान्ददृशुश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2024356, "chapter_id": 1521, "verse_number": "३-१५९-६५", "content_sanskrit": "सिन्धुवारांस्तथोदारान्मन्मथस्येव तोमरान्।\nसुवर्णवर्णकुसुमान्गिरीणां सिखरेषु च।\nकर्णिकारान्विकसितान्कर्णपूरानिवोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2024357, "chapter_id": 1521, "verse_number": "३-१५९-६६", "content_sanskrit": "तथाऽपश्यन्कुरबकान्वनराजिषु पुष्पितान्।\nकामवश्यौत्सुक्यकरान्कामस्येव शरोत्करान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2024358, "chapter_id": 1521, "verse_number": "३-१५९-६७", "content_sanskrit": "तथैव वनराजीनामुदारान्रचितानिव।\nविराजमानांस्तेऽपश्यंस्तिलकांस्तिलकानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2024359, "chapter_id": 1521, "verse_number": "३-१५९-६८", "content_sanskrit": "तथानङ्गशराकारान्सहकारान्मनोरमान्।\nअपश्यन्भ्रामरान्राजन्मञ्जरीभिर्विराजितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2024360, "chapter_id": 1521, "verse_number": "३-१५९-६९", "content_sanskrit": "हिरण्यसदृशैः पुष्यैर्दावाग्निसदृशैरपि।\nलोहितैरञ्जनाभैश्च वैदूर्यसदृशैरपि।\nअतीव वृक्षा राजन्ते पुष्पिताः शैलसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2024361, "chapter_id": 1521, "verse_number": "३-१५९-७०", "content_sanskrit": "तथा सालांस्तमालांश्च पाटलाबकुलानपि।\nमाला इव समासक्ताः शैलानां शिखरेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2024362, "chapter_id": 1521, "verse_number": "३-१५९-७१", "content_sanskrit": "विमलस्फाटिकाभानि पाण्डुरच्छदनैर्द्विजैः।\nकलहंसैरुपेतानि सारसाभिरुतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2024363, "chapter_id": 1521, "verse_number": "३-१५९-७२", "content_sanskrit": "सरांसि बहुशः पार्था पश्यन्तः शैलसानुषु।\nपद्मोत्पलविमिश्राणि सुखशीतजलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2024364, "chapter_id": 1521, "verse_number": "३-१५९-७३", "content_sanskrit": "एवं क्रमेण ते वीरा वीक्षमाणाः समन्ततः।\nगन्वन्त्यथ माल्यानि रसवन्ति फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2024365, "chapter_id": 1521, "verse_number": "३-१५९-७४", "content_sanskrit": "सरांसि च मनोज्ञानि वृक्षांश्चातिमनोरमान्।\nविविशुः पाण्डवाः सर्वेविस्मयोत्फुल्ललोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2024366, "chapter_id": 1521, "verse_number": "३-१५९-७५", "content_sanskrit": "कमलोत्पलकह्लारपुण्डरीकसुगन्धिना।\nसेव्यमाना वने तस्मन्सुखस्पर्शेन वायुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2024367, "chapter_id": 1521, "verse_number": "३-१५९-७६", "content_sanskrit": "ततो युधिष्ठिरो भीममाहेदं प्रीतिमद्वचः।\nअहो श्रीमदिदं भीम गन्धमादनकाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2024368, "chapter_id": 1521, "verse_number": "३-१५९-७७", "content_sanskrit": "वने ह्मस्मिन्मनोरम्ये दिव्या काननजा द्रुमाः।\nलताश्च विविधाकाराः पत्रपुष्पफलोपगाः।\nभान्त्येते पुष्पविकचाः पुंस्कोकिलकुलाकुलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2024369, "chapter_id": 1521, "verse_number": "३-१५९-७८", "content_sanskrit": "नात्र कण्टकिनः केचिन्न च विद्यन्त्यपुष्पिताः।\nस्निग्धपत्रफला वृक्षा गन्धमादनसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2024370, "chapter_id": 1521, "verse_number": "३-१५९-७९", "content_sanskrit": "भ्रमरारावमधुरा नलिनीः फुल्लपङ्कजाः।\nविलोड्यमाना पश्येमाः करिभिः सकरेणुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2024371, "chapter_id": 1521, "verse_number": "३-१५९-८०", "content_sanskrit": "पश्येमां नलिनीं चान्यां कमलोत्पलमालिनीम्।\nस्रग्धरां विग्रहवतीं साक्षाच्छ्रियमिवापराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2024372, "chapter_id": 1521, "verse_number": "३-१५९-८१", "content_sanskrit": "नानाकुसुमगन्धाढ्यास्तस्येमाः काननोत्तमे।\nउपगीयमाना भ्रमरै राजन्ते वनराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2024373, "chapter_id": 1521, "verse_number": "३-१५९-८२", "content_sanskrit": "पश्य भीम शुभान्देशान्देवाक्रीडान्समन्ततः।\nअमानुषगतिं प्राप्ताः संसिद्धाः स्म वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2024374, "chapter_id": 1521, "verse_number": "३-१५९-८३", "content_sanskrit": "लताभिः पुष्पिताग्राभिः पुष्पिताः पादपोत्तमाः।\nसंश्लिष्टाः पार्थ शोभन्ते गन्धमादनसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2024375, "chapter_id": 1521, "verse_number": "३-१५९-८४", "content_sanskrit": "शिखण्डिनीभिश्चरतां सहितानां शिखण्डिनाम्।\nनदतां शृणु निर्घोषं भीम पर्वतसानुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2024376, "chapter_id": 1521, "verse_number": "३-१५९-८५", "content_sanskrit": "चकोराः शतपत्राश्च मत्तकोकिलशारिकाः।\nपत्रिणः पुष्पितानेतान्संपतन्ति महाद्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2024377, "chapter_id": 1521, "verse_number": "३-१५९-८६", "content_sanskrit": "रक्तपीतारुणाः पार्थ पादपाग्रगताः खगाः।\nपरस्परमुदीन्ते बहवो जीवजीवकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2024378, "chapter_id": 1521, "verse_number": "३-१५९-८७", "content_sanskrit": "हरितारुणवर्णानां शाड्वलानां समीपतः।\nसारसाः प्रतिदृश्यन्ते शैलप्रस्रवणेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2024379, "chapter_id": 1521, "verse_number": "३-१५९-८८", "content_sanskrit": "वदन्ति मधुरा वाचः सर्वभूतमनोरमाः।\nभृङ्गराजोपचक्राश्च लोहपृष्ठाः पतत्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2024380, "chapter_id": 1521, "verse_number": "३-१५९-८९", "content_sanskrit": "चतुर्विषाणाः पद्माभाः कुञ्जराः सकरेणवः।\nएते वैडूर्यवर्णाभं क्षोभयन्ति महत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2024381, "chapter_id": 1521, "verse_number": "३-१५९-९०", "content_sanskrit": "बहुतालसमुत्सेघाः शैलशृङ्गपरिच्युताः।\nनानाप्रस्रवणेभ्यश्च वारिधाराः पतन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2024382, "chapter_id": 1521, "verse_number": "३-१५९-९१", "content_sanskrit": "भास्कराभप्रभा भीमाः शारदाभ्रघनोपमाः।\nशोभयन्ति महाशैलं नानारजतधातवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2024383, "chapter_id": 1521, "verse_number": "३-१५९-९२", "content_sanskrit": "क्वचिदञ्जनवर्णाभाः क्वचित्काञ्चनसन्निभाः।\nधातवो हरितालस्य क्वचिद्धिङ्गुलकस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2024384, "chapter_id": 1521, "verse_number": "३-१५९-९३", "content_sanskrit": "मनःशिलागुहाश्चैव संध्याभ्रनिकरोपमाः।\nशशलोहितवर्णाभाः क्वचिद्गैरिकधातवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2024385, "chapter_id": 1521, "verse_number": "३-१५९-९४", "content_sanskrit": "सितासिताभ्रप्रतिमा बालसूर्यसमप्रभाः।\nएते बहुविधाः शैलं शोभयन्ति महाप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2024386, "chapter_id": 1521, "verse_number": "३-१५९-९५", "content_sanskrit": "गन्धर्वाः सह कान्ताभिर्यथेष्टं भीमविक्रमाः।\nदृश्यन्ते शैलशृङ्गेषु पार्थ किंपुरुषैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2024387, "chapter_id": 1521, "verse_number": "३-१५९-९६", "content_sanskrit": "गीतानां समतालानां तथासाम्नां च निःखनः।\nश्रूयते बहुधा भीम सर्वभूतमनोहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2024388, "chapter_id": 1521, "verse_number": "३-१५९-९७", "content_sanskrit": "महागङ्गामुदीक्षख पुण्यां देवनदीं शुभाम्।\nकलहंसगणैर्जुष्टामृषिकिन्नरसेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2024389, "chapter_id": 1521, "verse_number": "३-१५९-९८", "content_sanskrit": "धातुभिश्च सरिद्भिश्च किन्नरैर्मृगपक्षिभिः।\nगन्धर्वैरप्सरोभिश्च काननैश्च मनोरमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2024390, "chapter_id": 1521, "verse_number": "३-१५९-९९", "content_sanskrit": "व्यालैश्च विविधाकारैः शतशीर्षैः समन्ततः।\nउपेतं पश्य कौन्तेय शैलराजमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2024391, "chapter_id": 1521, "verse_number": "३-१५९-१००x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2024392, "chapter_id": 1521, "verse_number": "३-१५९-१००", "content_sanskrit": "ते प्रीतमनसः शूराः प्राप्ता गतिमनुत्तमाम्।\nनातृप्यन्पर्वतेन्द्रस्य दर्शनेन परंतपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2024393, "chapter_id": 1521, "verse_number": "३-१५९-१०१", "content_sanskrit": "उपेतमथ माल्यैश्च फलवद्भिश्च पादपैः।\nआर्ष्टिपेणस् राजर्षेराश्रमं ददृशुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2024394, "chapter_id": 1521, "verse_number": "३-१५९-१०२", "content_sanskrit": "ततस्ते तिग्मतपसं कृशं धमनिसंततम्।\nपारगं सर्वविद्यानामार्ष्टिषेणमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2024395, "chapter_id": 1521, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि यक्षयुद्धपर्वणि एकोनषष्ट्यधिकशततमोऽध्यायः ॥ १५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]