[{"id": 7006020000, "chapter_id": 26020, "verse_number": "१-२०३-१", "content_sanskrit": "हरिरुवाच ।\nया गौर्द्वेष्टिं स्वकं वत्सं तस्या देयं स्वकंपयः ।\nलवणेन समायुक्तं तस्या वत्सः प्रियो भवेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006020001, "chapter_id": 26020, "verse_number": "१-२०३-२", "content_sanskrit": "शुनोऽस्थि कण्ठबद्धं हि महिषाणां गवातथा ।\nकृमिजालं पातयति सकलं नात्र संशयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006020002, "chapter_id": 26020, "verse_number": "१-२०३-३", "content_sanskrit": "गोजङ्गनाभिपातः स्याद्गुञ्जामूलस्य भक्षणात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006020003, "chapter_id": 26020, "verse_number": "१-२०३-४", "content_sanskrit": "वरुणफलस्यरसं करेण मथितं शिव ।\nचतुष्पादद्विपदयोः कृमिजालं निपातयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006020004, "chapter_id": 26020, "verse_number": "१-२०३-५", "content_sanskrit": "व्रणञ्च शमयेद्रुद्र जयायाः पूरणात्तथा ।\nगजमूत्रस्य वै पानं गोमहिष्युपसर्गनुत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006020005, "chapter_id": 26020, "verse_number": "१-२०३-६", "content_sanskrit": "समसूर शालिबीजं पीतं तक्रेण घर्षितम् ।\nक्षीरे गोमहीषस्यैव गोः पुंसश्च हितं भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006020006, "chapter_id": 26020, "verse_number": "१-२०३-७", "content_sanskrit": "पत्रञ्च शरपुङ्खाया दत्तं सलवणं शि ।\nवारिस्फोटं हयानाञ्च केसराणां विनाशयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006020007, "chapter_id": 26020, "verse_number": "१-२०३-८", "content_sanskrit": "घृतकुमारीपत्रमेव दत्तं सलक्षणं ह ।\nतुरगमकेसराणां कण्डूनंश्येन्न संशयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]