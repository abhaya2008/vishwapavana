[{"id": 2131430, "chapter_id": 3838, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131431, "chapter_id": 3838, "verse_number": "१", "content_sanskrit": "अदृश्यमानास्ते दैत्या योधयन्ति स्म मायया ।\nअदृश्येनास्त्रवीर्येण तानप्यहमयोधयम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131432, "chapter_id": 3838, "verse_number": "२", "content_sanskrit": "गाण्डीवमुक्ता विशिखाः सम्यगस्त्रप्रयोजितैः(चोदिताः)।\nअच्छिन्दन्नुत्तमाङ्गानि यत्र यत्र स्म तेऽभवन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131433, "chapter_id": 3838, "verse_number": "३", "content_sanskrit": "ततो निवातकवचा वध्यमाना मया युधि।\nसंहृत्य मायां तर(सह)सा प्राविशन् पुरमात्मनः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131434, "chapter_id": 3838, "verse_number": "४", "content_sanskrit": "व्यपयातेषु दैत्येषु प्रादुर्भूते च दर्शने ।\nअपश्यं दानवांस्तत्र हतान् शतसहस्रशः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131435, "chapter_id": 3838, "verse_number": "५", "content_sanskrit": "विनिष्पिष्टानि तत्रैषां शस्त्राण्याभरणानि च ।\nशतशः स्म प्रदृश्यन्ते गात्राणि कवचानि च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131436, "chapter_id": 3838, "verse_number": "६", "content_sanskrit": "हयानां नान्तरं ह्यासीत् पदाद् विचलितुं पदम् ।\nउत्पत्य सहसा तस्थुरन्तरिक्षगमास्ततः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131437, "chapter_id": 3838, "verse_number": "७", "content_sanskrit": "ततो निवातकवचा व्योम सञ्छाद्य केवलम् ।\nअदृश्या ह्यत्यवर्तन्त विसृजन्तः शिलोच्चयान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131438, "chapter_id": 3838, "verse_number": "८", "content_sanskrit": "अन्तर्भूमिगताश्चान्ये हयानां चरणानथ ।\nन्यगृह्णन् दानवा घोरा रथचक्रे च भारत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131439, "chapter_id": 3838, "verse_number": "९", "content_sanskrit": "विनिगृह्य हरीनश्वान् रथं च मम युध्यतः ।\nसर्वतो मामविध्यन्त सरथं धरणीधरैः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131440, "chapter_id": 3838, "verse_number": "१०", "content_sanskrit": "पर्वतैरुपचीयद्भिः पतद्भिश्च तथापरैः ।\nस देशो यत्र वर्ताम गुहेव समपद्यत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131441, "chapter_id": 3838, "verse_number": "११", "content_sanskrit": "पर्वतैश्छाद्यमानोऽहं निगृहीतैश्च वाजिभिः ।\nअगच्छं परमामार्तिं मातलिस्तदलक्षयत् ।\nलक्षयित्वा च मां भीतमिदं वचनमब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131442, "chapter_id": 3838, "verse_number": "१२", "content_sanskrit": "अर्जुनार्जुन मा भैस्त्वं वज्रमस्त्रमुदीरय\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131443, "chapter_id": 3838, "verse_number": "१३", "content_sanskrit": "ततोऽहं तस्य तद्वाक्यं श्रुत्वा वज्रमुदीरयम् ।\nदेवराजस्य दयितं वज्र(भीम)मस्त्रं नराधिप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131444, "chapter_id": 3838, "verse_number": "१४", "content_sanskrit": "अचलं स्थानमासाद्य गाण्डीवमनुमन्त्र्य च ।\nअमुञ्चं वज्रसंस्पर्शानायसान् निशितान् शरान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131445, "chapter_id": 3838, "verse_number": "१५", "content_sanskrit": "ततो मायाश्च ताः सर्वा निवातकवचांश्च तान् ।\nते वज्रचोदिता बाणा वज्रभूताः समाविशन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131446, "chapter_id": 3838, "verse_number": "१६", "content_sanskrit": "ते वज्रवेगविहता दानवाः पर्वतोपमाः ।\nइतरेतरमाश्लिष्य न्यपतन् पृथिवीतळे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131447, "chapter_id": 3838, "verse_number": "१७", "content_sanskrit": "अन्तर्भूमौ च येऽगृह्णन् दानवा रथवाजिनः ।\nअनुप्रविश्य तान् बाणाः प्राहिण्वन् यमसादनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131448, "chapter_id": 3838, "verse_number": "१८", "content_sanskrit": "तदा नि(हतैर्नि)वातकवचैर्निरस्तैः पर्वतोपमैः ।\nसमाच्छाद्यत देशः स विकीर्णैरिव पर्वतैः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131449, "chapter_id": 3838, "verse_number": "१९", "content_sanskrit": "न हयानां क्षतिः क(का)चिन्न रथस्य न मातलेः ।\nमम चादृश्यत तदा तदद्भुतमिवाभवत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131450, "chapter_id": 3838, "verse_number": "२०", "content_sanskrit": "ततो मां प्रहसन् राजन् मातलिः प्रत्यभाषत ।\nनैतदर्जुन देवेषु त्वयि वीर्यं यदीक्ष्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131451, "chapter_id": 3838, "verse_number": "२१", "content_sanskrit": "हतेष्वसुरसङ्घेषु दारास्तेषां तु सर्वशः ।\nप्राक्रोशन् नगरे दारा(तस्मिन्) यथा शरदि लक्षणाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131452, "chapter_id": 3838, "verse_number": "२२", "content_sanskrit": "ततो मातलिना सार्धमहं तत्पुरमभ्ययाम् ।\nत्रासयन् रथघोषेण निवातकवचस्त्रियः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131453, "chapter_id": 3838, "verse_number": "२३", "content_sanskrit": "तान् दृष्ट्वा दशसाहस्रान् मयूरसदृशान् हयान् ।\nरथं च रविसङ्काशं पर्जन्यनिनदं तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131454, "chapter_id": 3838, "verse_number": "२४", "content_sanskrit": "ताभिराभरणैः शब्दस्त्रासिताभिः समीरितः ।\nशिलानामिव शैलेषु पतन्तीनामभूत् तदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131455, "chapter_id": 3838, "verse_number": "२५", "content_sanskrit": "वित्रस्ता दैत्यनार्यस्ताः स्वानि वेश्मान्यथाविशन् ।\nबहुरत्नविचित्राणि शातकुम्भमयानि च \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131456, "chapter_id": 3838, "verse_number": "२६", "content_sanskrit": "तदद्भुताकारमहं दृष्ट्वा नगरमुत्तमम् ।\nविशिष्टं देवनगरादपृच्छं मातलिं ततः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131457, "chapter_id": 3838, "verse_number": "२७", "content_sanskrit": "इदमेवंविधं कस्माद् देवा नावासयन्त्युत।\nपुरन्दरपुराद्धीदं विशिष्टमिति लक्षये\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131458, "chapter_id": 3838, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131459, "chapter_id": 3838, "verse_number": "२८", "content_sanskrit": "आसीदिदं पुरा पार्थ देवराजस्य नः पुरम् ।\nततो निवातकवचैरितः प्रच्याविताः सुराः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131460, "chapter_id": 3838, "verse_number": "२९", "content_sanskrit": "तपस्तप्त्वा महत् तीव्रं प्रसाद्य च पितामहम् ।\nप्राप्ताः पुरं निवासाय देवेभ्यश्चाभयं युधि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131461, "chapter_id": 3838, "verse_number": "", "content_sanskrit": "तथा देवैरवध्यत्वं पुरस्याभेद्यत्वमेव तु ।\nमनुष्याणां दुर्बलत्वादुपेक्ष्यैव महासुरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131462, "chapter_id": 3838, "verse_number": "३०", "content_sanskrit": "ततः शक्रेण भगवान् स्वयम्भूरिति चोदितः ।\nविधत्तां भगवानन्तमात्मनो हितकाम्यया \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131463, "chapter_id": 3838, "verse_number": "३१", "content_sanskrit": "तत उक्तो भगवता दिष्टमत्रेति वासवः।\nभवितान्तस्त्वमेवैषां देहेनान्येन वृत्रहन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131464, "chapter_id": 3838, "verse_number": "३२", "content_sanskrit": "तत एषां वधार्थाय शक्रोऽस्त्राणि ददौ तव ।\nन हि शक्याः सुरैर्हन्तुं य एते निहतास्त्वया\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131465, "chapter_id": 3838, "verse_number": "३३", "content_sanskrit": "कालस्य परिणामेन ततस्त्वमिह भारत ।\nएषामन्तकरः प्राप्तस्तत् त्वया च कृतं तथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131466, "chapter_id": 3838, "verse_number": "३४", "content_sanskrit": "दानवानां विनाशाय अस्त्राणां परमं बलम् ।\nग्राहितस्त्वं महेन्द्रेण पुरुषेन्द्र तदुत्तमम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131467, "chapter_id": 3838, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131468, "chapter_id": 3838, "verse_number": "३५", "content_sanskrit": "ततः प्रशाम्य नगरं दानवांश्च निहत्य तान् ।\nपुनर्मातलिना सार्धमगमं(च्छं) देवसद्म तत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131469, "chapter_id": 3838, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nसप्तषष्ट्यधिकशततमोऽध्यायः ॥ १६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131470, "chapter_id": 3838, "verse_number": "", "content_sanskrit": "यक्षयुद्धपर्वणि चतुर्दशोऽध्यायः ॥१४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]