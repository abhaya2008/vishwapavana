[{"id": 2073908, "chapter_id": 2561, "verse_number": "१२-६६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073909, "chapter_id": 2561, "verse_number": "१२-६६-१", "content_sanskrit": "चातुराश्रम्यमुक्तं ते चातुर्वण्यं तथैव च।\nराष्ट्रस्य यत्कृत्यतमं तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073910, "chapter_id": 2561, "verse_number": "१२-६६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073911, "chapter_id": 2561, "verse_number": "१२-६६-२", "content_sanskrit": "राष्ट्रस्य यत्कृत्यतमं राज्ञ एवाभिषेचनम्।\nअनिन्द्रमबलं राष्ट्रं दस्यवोऽभिभवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073912, "chapter_id": 2561, "verse_number": "१२-६६-३", "content_sanskrit": "अराजकेषु राष्ट्रेषु धर्मो न व्यवतिष्ठते।\nपरस्परं च खादन्ति सर्वथा धिगराजकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073913, "chapter_id": 2561, "verse_number": "१२-६६-४", "content_sanskrit": "इन्द्रमेव प्रणमते यद्राजानमिति श्रुतिः।\nयथैवेन्द्रस्तथा राजा संपूज्यो भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073914, "chapter_id": 2561, "verse_number": "१२-६६-५", "content_sanskrit": "नाराजकेषु राष्ट्रेषु वस्तव्यमिति वैदिकम्।\nनाराजकेषु राष्ट्रेषु हव्यं वहति पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073915, "chapter_id": 2561, "verse_number": "१२-६६-६", "content_sanskrit": "अथ चेदधिवेर्तेत राज्यार्थी बलवत्तरः।\nअराजकाणि राष्ट्राणि हतवीराणि वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073916, "chapter_id": 2561, "verse_number": "१२-६६-७", "content_sanskrit": "प्रत्युद्गम्याभिपूज्यः स्यादेतदत्र सुमन्त्रितम्।\nन हि राज्यात्पापतरमस्ति किंचिदराजकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073917, "chapter_id": 2561, "verse_number": "१२-६६-८", "content_sanskrit": "स चेत्समनुपश्येत समग्रं कुशलं भवेत्।\nबलवान्हि प्रकुपितः कुर्यान्निः शेषतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073918, "chapter_id": 2561, "verse_number": "१२-६६-९", "content_sanskrit": "भूयांसं लभते क्लेशं या गौर्भवति दुर्दुहा।\nअथ या सुदुहा राजन्नैव तां वितुदन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073919, "chapter_id": 2561, "verse_number": "१२-६६-१०", "content_sanskrit": "यदतप्तं प्रणमते न तत्संतापयन्त्युत।\nयत्स्वयं नमते दारु न तत्संनामयन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073920, "chapter_id": 2561, "verse_number": "१२-६६-११", "content_sanskrit": "एतयोपमया धीरः सन्नमेत बलीयसे।\nइन्द्राय स प्रणमते नमते यो बलीयसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073921, "chapter_id": 2561, "verse_number": "१२-६६-१२", "content_sanskrit": "तस्माद्राजैव कर्तव्यः सततं भूतिमिच्छता।\nन धनार्थो न दारार्थस्तेषां येषामराजकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073922, "chapter_id": 2561, "verse_number": "१२-६६-१३", "content_sanskrit": "प्रीयते हि हरन्पापः परवित्तमराजके।\nयदाऽस्य तद्धरन्त्यन्ये तदा राजानमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073923, "chapter_id": 2561, "verse_number": "१२-६६-१४", "content_sanskrit": "पापा ह्यपि तदा क्षेमं न लभन्ते कदाचन।\nएकस्य हि द्वौ हरतो द्वयोश्च बहवोऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073924, "chapter_id": 2561, "verse_number": "१२-६६-१५", "content_sanskrit": "अदासः क्रियते दासो ह्रियन्ते च बलात्स्त्रियः।\nएतस्मात्कारणाद्देवाः प्रजापालान्प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073925, "chapter_id": 2561, "verse_number": "१२-६६-१६", "content_sanskrit": "राजा चेन्न भवेल्लोके पृथिव्या दण्डधारकः।\nजले मत्स्यानिवाभक्ष्यन्दुर्बलं बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073926, "chapter_id": 2561, "verse_number": "१२-६६-१७", "content_sanskrit": "अराजकाः प्रजाः पूर्वं विनेशुरिति नः श्रुतम्।\nपरस्परं भक्षयन्तो मत्स्या इव जले कृशान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073927, "chapter_id": 2561, "verse_number": "१२-६६-१८", "content_sanskrit": "समेत्य तास्ततश्चक्रुः समयानिति नः श्रुतम्।\nवाक्शूरो दण्डपरुषो यश्च स्यात्पारदारिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073928, "chapter_id": 2561, "verse_number": "१२-६६-१९", "content_sanskrit": "यश्च नः समयं भिन्द्यात्त्याज्या नस्तादृशा इति।\nविश्वासार्थं च सर्वेषां वर्णानामविशेषतः।\nतास्तथा समयं कृत्वा समयेनावतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073929, "chapter_id": 2561, "verse_number": "१२-६६-२०", "content_sanskrit": "सहितास्तास्तदा जग्मुरसुखार्ताः पितामहम्।\nअनीश्वरा विनश्यामो भगवन्नीश्वरं दिश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073930, "chapter_id": 2561, "verse_number": "१२-६६-२१", "content_sanskrit": "यं पूजयेम संभूय यश्च नः प्रतिपालयेत्।\nताभ्यो मनुं व्यादिदेश मनुर्नाभिननन्द ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073931, "chapter_id": 2561, "verse_number": "१२-६६-२२x", "content_sanskrit": "मनुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073932, "chapter_id": 2561, "verse_number": "१२-६६-२२", "content_sanskrit": "बिभेमि कर्मणः पापाद्राज्यं हि भृशदुष्करम्।\nविशेषतो मनुष्येषु मिथ्यावृत्तेषु नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073933, "chapter_id": 2561, "verse_number": "१२-६६-२३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073934, "chapter_id": 2561, "verse_number": "१२-६६-२३", "content_sanskrit": "तमब्रुवन्प्रजा मा भैर्विधास्यामो धनं तव।\nपशूनामथ पञ्चांशं धरण्यस्य तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073935, "chapter_id": 2561, "verse_number": "१२-६६-२४", "content_sanskrit": "धान्यस्य दशमं भागं दास्यामः कोशवर्धनम्।\nकन्यां शुल्के चारुरूपां विवाहेषूद्यतासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073936, "chapter_id": 2561, "verse_number": "१२-६६-२५", "content_sanskrit": "मुख्येन शस्त्रपत्रेण ये मनुष्याः प्रधानतः।\nभवन्तं तेऽनुयास्यन्ति महेन्द्रमिव देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073937, "chapter_id": 2561, "verse_number": "१२-६६-२६", "content_sanskrit": "स त्वं जातबलो राजन्दुष्प्रधर्षः प्रतापवान्।\nसुखे धास्यसि नः सर्वान्कुबेर इव नैर्ऋतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073938, "chapter_id": 2561, "verse_number": "१२-६६-२७", "content_sanskrit": "यं च धर्मं चरिष्यन्ति प्रजा राज्ञा सुरक्षिताः।\nचतुर्थं तस्य धर्मस्य त्वत्संस्थं नो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073939, "chapter_id": 2561, "verse_number": "१२-६६-२८", "content_sanskrit": "तेन धर्मेण महता सुखं लब्धेन भावितः।\nपाह्यस्मान्सर्वतो राजन्देवानिव शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073940, "chapter_id": 2561, "verse_number": "१२-६६-२९", "content_sanskrit": "विजयाय हि निर्याहि प्रतपत्रश्मिवानिव।\nमानं विधम शत्रूणां धर्मं जनय नः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073941, "chapter_id": 2561, "verse_number": "१२-६६-३०", "content_sanskrit": "स निर्ययौ महातेजा बलेन महता वृतः।\nमहाभिजनसंपन्नस्तेजसा प्रज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073942, "chapter_id": 2561, "verse_number": "१२-६६-३१", "content_sanskrit": "तस्य दृष्ट्वा महत्वं ते महेन्द्रस्येव देवताः।\nअपतत्रसिरे सर्वे स्वधर्मे च ददुर्मनः।\n`वर्णिनश्चाश्रमाश्चैव म्लेच्छाः सर्वे च दस्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073943, "chapter_id": 2561, "verse_number": "१२-६६-३२", "content_sanskrit": "ततो महीं परिययौ पर्जन्य इव वृष्टिमान्।\nशमयन्सर्वतः पापान्स्वकर्मसु च योजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073944, "chapter_id": 2561, "verse_number": "१२-६६-३३", "content_sanskrit": "एवं ये भूतिमिच्छेयुः पृथिव्यां मानवाः क्वचित्।\nकुर्यू राजानमेवाग्रे प्रजानुग्रहकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073945, "chapter_id": 2561, "verse_number": "१२-६६-३४", "content_sanskrit": "नमस्येरंश्च तं भक्त्या शिष्या इव गुरुं सदा।\nदेवा इव च देवेन्द्रं नरा राजानमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073946, "chapter_id": 2561, "verse_number": "१२-६६-३५", "content_sanskrit": "सत्कृतं स्वजनेनेह परोऽपि बहुमन्यते।\nस्वजनेन त्ववज्ञातं परे परिभवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073947, "chapter_id": 2561, "verse_number": "१२-६६-३६", "content_sanskrit": "राज्ञः परैः परिभवः सर्वेषामसुखावहः।\nतस्माच्छत्रं च पत्रं च वासांस्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073948, "chapter_id": 2561, "verse_number": "१२-६६-३७", "content_sanskrit": "भोजनान्यथ पानानि राज्ञे दद्युर्गृहाणि च।\nआसनानि च शय्याश्च सर्वोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073949, "chapter_id": 2561, "verse_number": "१२-६६-३८", "content_sanskrit": "गोप्ता चास्य दुराधर्षः स्मितपूर्वाभिभाषिता।\nआभाषितश्च मधुरं प्रत्याभाषेत मानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073950, "chapter_id": 2561, "verse_number": "१२-६६-३९", "content_sanskrit": "कृतज्ञो दृढभक्तिः स्यात्संविभागी जितेन्द्रियः।\nईक्षितः प्रतिवीक्षेत मृदु वल्गु च चर्जु च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073951, "chapter_id": 2561, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षट्षष्टिमोऽध्यायः॥ ६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]