[{"id": 2204880, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204881, "chapter_id": 5366, "verse_number": "१", "content_sanskrit": "विधानं सुकृतस्यापि भूयः शृणु शुचिस्मिते ।\nप्रोच्यते तत् त्रिधा देवि सुकृतं च समासतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204882, "chapter_id": 5366, "verse_number": "२", "content_sanskrit": "यदौपरमितं चैव सुकृतं निरुपद्रवम् ।\nतथैव सोपकरणं तावता सुकृतं विदुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204883, "chapter_id": 5366, "verse_number": "३", "content_sanskrit": "निवृत्तिः पापकर्मभ्यस्तदौपरमितं प्रिये ।\nमनोवाक्कायजा दोषाः शृणु मे वर्जनाच्छुभम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204884, "chapter_id": 5366, "verse_number": "४", "content_sanskrit": "त्रैविध्यदोषोपरमे यस्तु दोषव्यपेक्षया ।\nस हि प्राप्नोति सकलं सर्वदुष्कृतवर्जनात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204885, "chapter_id": 5366, "verse_number": "५", "content_sanskrit": "प्रथमं वर्जयेद् दोषान् युगपत् पृथगेव वा ।\nतथा धर्ममवाप्नोति दोषत्यागो हि दुष्करः ।\nदोषसाकल्यसन्त्यागान्मुनिर्भवति मानवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204886, "chapter_id": 5366, "verse_number": "६", "content_sanskrit": "सौकर्यं पश्य धर्मस्य कार्यारम्भादृतेऽपि च ।\nआत्मना स्थापनामात्राल्लभन्ते सुकृतं परम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204887, "chapter_id": 5366, "verse_number": "७", "content_sanskrit": "अहो नृशंसाः पच्यन्ते मानुषाः स्वल्पबुद्धयः ।\nये तादृशं न बुध्यन्ते आत्माधीनं न निर्व्ययम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204888, "chapter_id": 5366, "verse_number": "८", "content_sanskrit": "दुष्कृतत्यागमात्रेण पदमूर्ध्वं हि लभ्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204889, "chapter_id": 5366, "verse_number": "९", "content_sanskrit": "पापभीरुत्वमात्रेण दोषाणां परिवर्जनात् ।\nसुशोभनं भवेद् देवि किमु धर्मव्यपेक्षया ।\nइत्यौपरमितं(कं) देवि सुकृतं कथितं तव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204890, "chapter_id": 5366, "verse_number": "१०", "content_sanskrit": "श्रुताच्च वृद्धसंयोगादिन्द्रियाणां च निग्रहात् ।\nसन्तोषाच्च धृतेश्चैव शक्यते दोषवर्जनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204891, "chapter_id": 5366, "verse_number": "११", "content_sanskrit": "तदेव यम इत्याहुर्दोषसंयमनं प्रिये ।\nयमधर्मेण धर्मोऽस्ति नान्यः शुभतरः प्रिये ।\nयमधर्मेण यतयः प्राप्नुवन्त्युत्तमां गतिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204892, "chapter_id": 5366, "verse_number": "१२", "content_sanskrit": "ईश्वराणां प्रभवतां दरिद्राणां च वै नृणाम् ।\nसफलो दोषसन्त्यागो दानादपि शुभादपि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204893, "chapter_id": 5366, "verse_number": "१३", "content_sanskrit": "तपो दानं महादेवि दोषमल्पं विनिर्दहेत् ।\nसुकृतं यामिकं प्रोक्तं वक्ष्ये निरुपसाधनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204894, "chapter_id": 5366, "verse_number": "१४", "content_sanskrit": "सुखाभिसन्धिर्लोकानां सत्यं शौचमथार्जवम् ।\nव्रतोपवासः प्रीतिश्च ब्रह्मचर्यं दमः शमः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204895, "chapter_id": 5366, "verse_number": "१५", "content_sanskrit": "एवमादि शुभं कर्म सुकृतं नियमाश्रितम् ।\nशृणु तेषां विशेषांश्च कीर्तयिष्यामि भामिनि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204896, "chapter_id": 5366, "verse_number": "१६", "content_sanskrit": "सत्यं स्वर्गस्य सोपानं पारावारस्य नौरिव ।\nनास्ति सत्यात् परं दानं नास्ति सत्यात् परं तपः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204897, "chapter_id": 5366, "verse_number": "१७", "content_sanskrit": "यथा श्रुतं यथा दृष्टमात्मना यद्यथा कृतम् ।\nतथा सत्योपकारेण वचनं सत्यलक्षणम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204898, "chapter_id": 5366, "verse_number": "१८", "content_sanskrit": "यच्छलेनाभिसंयुक्तं सत्यरूपं मृषैव तत् ।\nनित्यमेव प्रवक्तव्यं पारावर्यं विजानता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204899, "chapter_id": 5366, "verse_number": "१९", "content_sanskrit": "दीर्घायुश्च भवेत् सत्यात् कुलसन्तानपालकः ।\nलोकसंस्थितिपालश्च भवेत् सत्येन मानवः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204900, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204901, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "कथं सन्धारयन् मर्त्यो व्रतं शुभमवाप्नुयात्\t॥२०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204902, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204903, "chapter_id": 5366, "verse_number": "२१", "content_sanskrit": "पूर्वमुक्तं तु यत् पापं मनोवाक्कायकर्मभिः ।\nव्रतवत् तस्य सन्त्यागस्तदौपरमितं स्मृतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204904, "chapter_id": 5366, "verse_number": "२२", "content_sanskrit": "तेन धर्ममवाप्नोति व्रतवत् परिपालयन् ।\nमङ्गलं शुभकर्माणि व्रतेनैव समाचरेत् ।\nनरो धर्ममवाप्नोति शुभसञ्जोषणं व्रतम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204905, "chapter_id": 5366, "verse_number": "२३", "content_sanskrit": "यद्यदात्मप्रियं नित्यं मनोवाक्कायकर्मभिः ।\nव्रतवत् तस्य सन्त्यागस्तपोव्रतमिति स्थितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204906, "chapter_id": 5366, "verse_number": "२४", "content_sanskrit": "त्याज्यं वा यदि वा जोष्यमव्रतेन वृथा चरन् ।\nतथा फलं न लभते तस्माद् धर्मं व्रताच्चरेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204907, "chapter_id": 5366, "verse_number": "२५", "content_sanskrit": "शुद्धकायो नरो भूत्वा स्नात्वा तीर्थे यथाविधि ।\nपञ्चभूतानि चन्द्रार्कौ सन्ध्ये धर्मं यमं पितॄन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204908, "chapter_id": 5366, "verse_number": "२६", "content_sanskrit": "आत्मन्येव रतान् मत्वा निर्बन्धव्रतमाचरेत् ।\nव्रतमामरणाद् वाऽपि कालच्छेदेन वा हरेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204909, "chapter_id": 5366, "verse_number": "२७", "content_sanskrit": "शाकादिषु व्रतं कुर्यात् तथा पुष्पफलादिषु ।\nब्रह्मचर्यं व्रतं कुर्यादुपवासं तथा व्रतम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204910, "chapter_id": 5366, "verse_number": "२८", "content_sanskrit": "एवमन्येषु बहुषु व्रतं कार्यं हितैषिणा ।\nव्रतभङ्गो यथा न स्याद् रक्षितव्यं तथा बुधैः ।\nव्रतभङ्गो महत्पापमिति विद्धि शुभेक्षणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204911, "chapter_id": 5366, "verse_number": "२९", "content_sanskrit": "औषधार्थं यथाज्ञानाद् गुरूणां वचनादपि ।\nअनुग्रहार्थं बन्धूनां व्रतभङ्गो न दुष्यते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204912, "chapter_id": 5366, "verse_number": "३०", "content_sanskrit": "व्रतापवर्गकालेषु दैवब्राह्मणपूजनम् ।\nनरेण तु यथाशक्ति कार्यं सिद्धिं तथाऽऽप्तुयात्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204913, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204914, "chapter_id": 5366, "verse_number": "३१", "content_sanskrit": "कथं शौचविधिस्तत्र तन्मे शंसितुमर्हसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204915, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204916, "chapter_id": 5366, "verse_number": "३२", "content_sanskrit": "बाह्ममाभ्यन्तरं चेति द्विविधं शौचमिष्यते ।\nमानसं सुकृतं यत् तच्छौचमाभ्यन्तरं स्मृतम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204917, "chapter_id": 5366, "verse_number": "३३", "content_sanskrit": "सदाऽऽहारविशुद्धिश्च कायप्रक्षालनं च यत् ।\nबाह्यशौचं भवेदेतत् तथैवाचमनादिना\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204918, "chapter_id": 5366, "verse_number": "३४", "content_sanskrit": "मृच्चैव शुद्धदेशस्था गोशकृन्मूत्रमेव च ।\nद्रव्याणि गन्धयुक्तानि यानि पुष्टिकराणि च ।\nएतैः सम्मार्जयेत् कायमम्भसा च पुनः पुनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204919, "chapter_id": 5366, "verse_number": "३५", "content_sanskrit": "अक्षोभ्यं यत् प्रकीर्णं च नित्यस्रोतश्च यज्जलम् ।\nप्रायशस्तादृशे मज्जेदन्यथा चापि वर्जयेत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204920, "chapter_id": 5366, "verse_number": "३६", "content_sanskrit": "त्रिस्त्रिराचमनं श्रेष्ठं निष्फेनैर्निर्मलैर्जलैः ।\nतथा विण्मूत्रयोः शुद्धिरद्भिर्बहुमृदा भवेत् ।\nतथैव जलसंशुद्धिर्यत् संशुद्धं तु संस्पृशेत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204921, "chapter_id": 5366, "verse_number": "३७", "content_sanskrit": "शकृता भूमिशुद्धिः स्याल्लौहानां भस्मना स्मृतम् ।\nतक्षणं घर्षणं चैव दारवाणां विशोधनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204922, "chapter_id": 5366, "verse_number": "३८", "content_sanskrit": "दहनं मृन्मयानां च मर्त्यानां कृच्छ्रधारणम् ।\nशेषाणां देवि सर्वेषामातपेन जलेन च ।\nब्राह्मणानां च वाक्येन सदा संशोधनं भवेत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204923, "chapter_id": 5366, "verse_number": "३९", "content_sanskrit": "आमृष्टमद्भिर्निर्णिक्तं यच्च वाचा प्रशस्यते ।\nएवमापदि संशुद्धिरेवं शौचं विधीयते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204924, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204925, "chapter_id": 5366, "verse_number": "४०", "content_sanskrit": "आहारशुद्धिस्तु कथं देवदेव महेश्वर\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204926, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204927, "chapter_id": 5366, "verse_number": "४१", "content_sanskrit": "अमांसमद्यमक्लेद्यमपर्युषितमेव च ।\nअतिकट्वाम्ललवणैर्हीनं च शुभगन्धि च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204928, "chapter_id": 5366, "verse_number": "४२", "content_sanskrit": "कृमिकीटमलैर्हीनं सम्भृतं शुद्धभाजने ।\nएवंविधं सदाहारं देवब्राह्मणसत्कृतम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204929, "chapter_id": 5366, "verse_number": "४३", "content_sanskrit": "शुभमित्येव विज्ञेयमन्यथा त्वशुभं भवेत् ।\nग्राम्यादारण्यकैः सिद्धं शुद्धमित्यवधारय\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204930, "chapter_id": 5366, "verse_number": "४४", "content_sanskrit": "अतिमात्रगृहीतात्तु अल्पदत्तं भवेच्छुचि ।\nयज्ञशेषं हविःशेषं पितृशेषं च निर्मलम् ।\nइति ते कथितं देवि भूयः किं श्रोतुमिच्छसि॥\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204931, "chapter_id": 5366, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे सुकृतविभागकथनं नाम सप्तदशोत्तरद्विशततमोऽध्यायः ॥२१७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]