[{"id": 2149774, "chapter_id": 4245, "verse_number": "", "content_sanskrit": "होत्रवाहनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149775, "chapter_id": 4245, "verse_number": "१", "content_sanskrit": "रामं द्रक्ष्यसि वत्से त्वं जामदग्न्यं महावने ।\nउग्रे तपसि वर्तन्तं सत्यसन्धं महाबलम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149776, "chapter_id": 4245, "verse_number": "२", "content_sanskrit": "माहेन्द्रं वै गिरिश्रेष्ठं रामो नित्यमुपासते ।\nऋषयो वेदविदुषो गन्धर्वाप्सरसस्तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149777, "chapter_id": 4245, "verse_number": "३", "content_sanskrit": "तत्र गच्छस्व भद्रं ते ब्रूयाश्चैनं वचो मम ।\nअभिवाद्य च तं मूर्ध्ना तपोवृद्धं दृढव्रतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149778, "chapter_id": 4245, "verse_number": "४", "content_sanskrit": "ब्रूयाश्चैनं पुनर्भद्रे यत् ते कार्यं मनीषितम् ।\nमयि सङ्कीर्तिते रामः सर्वं तत् ते करिष्यति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149779, "chapter_id": 4245, "verse_number": "५", "content_sanskrit": "मम रामः सखा वत्से प्रीतियुक्तः सुहृच्च मे ।\nजमदग्निसुतो वीरः सर्वशस्त्रभृतां वरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149780, "chapter_id": 4245, "verse_number": "६", "content_sanskrit": "एवं ब्रुवति कन्यां तु पार्थिवे होत्रवाहने ।\nअकृतव्रणः प्रादुरासीद् रामस्यानुचरः प्रियः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149781, "chapter_id": 4245, "verse_number": "७", "content_sanskrit": "ततस्ते मुनयः सर्वे समुत्तस्थुः सहस्रशः ।\nस च राजा वयोवृद्धः सृञ्जयो होत्रवाहनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149782, "chapter_id": 4245, "verse_number": "८", "content_sanskrit": "ततः पृष्ट्वा यथान्यायमन्योन्यं ते वनौकसः ।\nसहिता भरतश्रेष्ठ निषेदुः परिवार्य तम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149783, "chapter_id": 4245, "verse_number": "९", "content_sanskrit": "ततस्ते कथयामासुः कथास्तास्ता मनोरमाः ।\nधन्या दिव्याश्च राजेन्द्र प्रीतिहर्षमुदा युताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149784, "chapter_id": 4245, "verse_number": "१०", "content_sanskrit": "ततः कथान्ते राजर्षिर्महात्मा होत्रवाहनः ।\nरामं श्रेष्ठं महर्षीणामपृच्छदकृतव्रणम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149785, "chapter_id": 4245, "verse_number": "११", "content_sanskrit": "क्व सम्प्रति महाबाहो जामदग्न्यः प्रतापवान् ।\nअकृतव्रण शक्यो वै द्रष्टुं वेदविदां वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149786, "chapter_id": 4245, "verse_number": "", "content_sanskrit": "अकृतव्रणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149787, "chapter_id": 4245, "verse_number": "१२", "content_sanskrit": "भवन्तमेव सततं रामः कीर्तयति प्रभो ।\nसृञ्जयो मे प्रियसखो राजर्षिरिति पार्थिव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149788, "chapter_id": 4245, "verse_number": "१३", "content_sanskrit": "इह रामः प्रभाते श्वो भवितेति मतिर्मम ।\nद्रष्टास्येनमिहायान्तं तव दर्शनकाङ्क्षया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149789, "chapter_id": 4245, "verse_number": "१४", "content_sanskrit": "इयं च कन्या राजर्षे किमर्थं वनमागता ।\nकस्य चेयं भवति का भवतेच्छामि वेदितुम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149790, "chapter_id": 4245, "verse_number": "", "content_sanskrit": "होत्रवाहनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149791, "chapter_id": 4245, "verse_number": "१५", "content_sanskrit": "दौहित्रीयं मम विभो काशिराजसुता प्रिया ।\nज्येष्ठा स्वयंवरे तस्थौ भगिनीनां तथाऽनघ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149792, "chapter_id": 4245, "verse_number": "१६", "content_sanskrit": "इयमम्बेति विख्याता ज्येष्ठा काशिपतेः सुता ।\nअम्बिकाम्बालिके त्वन्ये कनीयस्यौ तपोधन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149793, "chapter_id": 4245, "verse_number": "१७", "content_sanskrit": "समेतं पार्थिवं क्षत्रं काशिपुर्यां तदाऽभवत् ।\nकन्यानिमित्तं विप्रर्षे तत्रासीदुत्सवो महान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149794, "chapter_id": 4245, "verse_number": "१८", "content_sanskrit": "ततः किल महावीर्यो भीष्मः शान्तनवो नृपान् ।\nअधिक्षिप्य महातेजास्तिस्रः कन्या जहार ताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149795, "chapter_id": 4245, "verse_number": "१९", "content_sanskrit": "निर्जित्य पृथिवीपालानथ भीष्मो गजाह्वयम् ।\nआजगाम विशुद्धात्मा कन्याभिः सह भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149796, "chapter_id": 4245, "verse_number": "२०", "content_sanskrit": "सत्यवत्यै निवेद्याथ विवाहार्थमनन्तरम् ।\nभ्रातुर्विचित्रवीर्यस्य समाज्ञापयत प्रभुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149797, "chapter_id": 4245, "verse_number": "२१", "content_sanskrit": "तं तु वैवाहिकं दृष्ट्वा कन्येयं समुपार्जितम् ।\nअब्रवीत् तत्र गाङ्गेयं मन्त्रिमध्ये द्विजर्षभ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149798, "chapter_id": 4245, "verse_number": "२२", "content_sanskrit": "मया साल्वपतिर्वीर मनसाऽभिवृतः पतिः ।\nन मामर्हसि धर्मज्ञ दातुं भ्रात्रेऽन्यकामुकाम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149799, "chapter_id": 4245, "verse_number": "२३", "content_sanskrit": "तच्छ्रुत्वा वचनं भीष्मः सम्मन्त्र्य सह मन्त्रिभिः ।\nनिश्चित्य विससर्जेमां सत्यवत्या मते स्थितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149800, "chapter_id": 4245, "verse_number": "२४", "content_sanskrit": "अनुज्ञाता तु भीष्मेण साल्वं सौभपतिं ततः ।\nकन्येयं मुदिता तत्र काले वचनमब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149801, "chapter_id": 4245, "verse_number": "२५", "content_sanskrit": "विसर्जिताऽस्मि भीष्मेण धर्मं मां प्रतिपादय ।\nमनसाऽभिवृतः पूर्वं मया त्वं पार्थिवर्षभ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149802, "chapter_id": 4245, "verse_number": "२६", "content_sanskrit": "प्रत्याचख्यौ च साल्वोऽस्याश्चारित्रस्याभिशङ्कितः ।\nसेयं तपोवनं प्राप्ता तपस्यभिरता भृशम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149803, "chapter_id": 4245, "verse_number": "२७", "content_sanskrit": "मया च प्रत्यभिज्ञाता वंशस्य परिकीर्तनात् ।\nअस्य दुःखस्य चोत्पत्तिर्भीष्म एवेति मन्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149804, "chapter_id": 4245, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149805, "chapter_id": 4245, "verse_number": "२८", "content_sanskrit": "भगवन्नेवमेवैतद् यदाह पृथिवीपतिः ।\nशरीरकर्ता मातुर्मे सृञ्जयो होत्रवाहनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149806, "chapter_id": 4245, "verse_number": "२९", "content_sanskrit": "न ह्युत्सहे स्वनगरं प्रतियातुं तपोधन ।\nअवमानभयाच्चैव व्रीडया च महामुने\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149807, "chapter_id": 4245, "verse_number": "३०", "content_sanskrit": "यत्तु मां भगवान् रामो वक्ष्यति द्विजसत्तम ।\nतन्मे कार्यतमं कार्यमिति मे भगवन् मतिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149808, "chapter_id": 4245, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षट्सप्तत्युत्तरशततमोऽध्यायः ॥१७६॥\nअम्बोपाख्यानपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]