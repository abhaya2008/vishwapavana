[{"id": 2146249, "chapter_id": 4155, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146250, "chapter_id": 4155, "verse_number": "१", "content_sanskrit": "यदाह विदुरः कृष्णे सर्वं तत् सत्यमुच्यते ।\nअनुरक्तोऽप्यसंहार्यः पार्थान् प्रति जनार्दनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146251, "chapter_id": 4155, "verse_number": "२", "content_sanskrit": "यत्तत् सत्कारसंयुक्तं देयं वसु जनार्दने ।\nअनेकरूपं राजेन्द्र तन्न देयं कदाचन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146252, "chapter_id": 4155, "verse_number": "३", "content_sanskrit": "देशः कालस्तथा युक्तो न हि नार्हति केशवः ।\nमंस्यत्यधोक्षजो राजन् भयादर्चति मामिति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146253, "chapter_id": 4155, "verse_number": "४", "content_sanskrit": "अवमानश्च यत्र स्यात् क्षत्रियस्य विशाम्पते ।\nन तत् कुर्याद् बुधः कार्यमिति मे निश्चिता मतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146254, "chapter_id": 4155, "verse_number": "५", "content_sanskrit": "स हि पूज्यतमो देवः कृष्णः कमललोचनः ।\nत्रयाणामपि लोकानां विदितं मम सर्वथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146255, "chapter_id": 4155, "verse_number": "६", "content_sanskrit": "न तु तस्मै प्रदेयं स्यात् तथा कार्यगतिः प्रभो ।\nविग्रहः समुपारब्धो न हि शाम्यति विग्रहात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146256, "chapter_id": 4155, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146257, "chapter_id": 4155, "verse_number": "७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा भीष्मः कुरुपितामहः ।\nवैचित्रवीर्यं राजानमिदं वचनमब्रवीत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146258, "chapter_id": 4155, "verse_number": "८", "content_sanskrit": "सत्कृतोऽसत्कृतो वाऽपि न क्रुद्ध्येत जनार्दनः ।\nनावमंस्यत्यवज्ञातॄन् अवज्ञातोऽपि केशवः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146259, "chapter_id": 4155, "verse_number": "९", "content_sanskrit": "यत्तु कार्यं महाबाहो मनसा कार्यतां गतम् ।\nसर्वोपायैर्न तच्छक्यं केनचित् कर्तुमन्यथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146260, "chapter_id": 4155, "verse_number": "१०", "content_sanskrit": "स यद् ब्रूयान्महाबाहुस्तत् कार्यमविशङ्कया ।\nवासुदेवेन तीर्थेन क्षिप्रं संशाम्य पाण्डवैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146261, "chapter_id": 4155, "verse_number": "११", "content_sanskrit": "धर्म्यमर्थ्यं च धर्मात्मा ध्रुवं वक्ता जनार्दनः ।\nतस्मिन् वाच्याः प्रिया वाचो भवता बान्धवैः सह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146262, "chapter_id": 4155, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146263, "chapter_id": 4155, "verse_number": "१२", "content_sanskrit": "न पर्याप्तोऽस्मि यद् राजन् श्रियं निष्केवलामहम् ।\nतैः सहेमामुपाश्नीयां यावज्जीवं पितामह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146264, "chapter_id": 4155, "verse_number": "१३", "content_sanskrit": "इदं तु सुमहत् कार्यं शृणु मे यत् समर्थितम् ।\nपरायणं पाण्डवानां नियंस्यामि जनार्दनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146265, "chapter_id": 4155, "verse_number": "१४", "content_sanskrit": "तस्मिन् बद्धे भविष्यन्ति वृष्णयः पृथिवी तथा ।\nपाण्डवाश्च विधेया मे स च प्रातरिहैष्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146266, "chapter_id": 4155, "verse_number": "१५", "content_sanskrit": "अत्रोपायान् यथा सम्यङ् न बुद्ध्येत जनार्दनः ।\nय उपायो भवेत् कश्चित् तद् भवान् प्रब्रवीतु मे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146267, "chapter_id": 4155, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146268, "chapter_id": 4155, "verse_number": "१६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा घोरं कृष्णेऽभिसंहितम् ।\nधृतराष्ट्रः सहामात्यो व्यथितो विमना भवत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146269, "chapter_id": 4155, "verse_number": "१७", "content_sanskrit": "ततो दुर्योधनमिदं धृतराष्ट्रोऽब्रवीद् वचः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146270, "chapter_id": 4155, "verse_number": "१८", "content_sanskrit": "मैवं वोचः प्रजापाल नैष धर्मः सनातनः ।\nदूतश्च हि हृषीकेशः सम्बन्धी च प्रियश्च नः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146271, "chapter_id": 4155, "verse_number": "१९", "content_sanskrit": "अपापः कौरवेयेषु स कथं बन्धमर्हति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146272, "chapter_id": 4155, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146273, "chapter_id": 4155, "verse_number": "२०", "content_sanskrit": "परीतस्तव पुत्रोऽयं धृतराष्ट्र सुमन्दधीः ।\nवृणोत्यनर्थं नैवार्थं याच्यमानः सुहृज्जनैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146274, "chapter_id": 4155, "verse_number": "२१", "content_sanskrit": "कृष्णमक्लिष्टकर्माणमासाद्यायं सुदुर्मतिः ।\nतव पुत्रः सहामात्यः क्षणेन न भविष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146275, "chapter_id": 4155, "verse_number": "२२", "content_sanskrit": "पापस्यास्य नृशंसस्य त्यक्तधर्मस्य दुर्मतेः ।\nनोत्सहेऽनर्थसंयुक्ताः श्रोतुं वाचः कथञ्चन\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146276, "chapter_id": 4155, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146277, "chapter_id": 4155, "verse_number": "२३", "content_sanskrit": "इत्युक्त्वा भरतश्रेष्ठो वृद्धः परममन्युमान् ।\nउत्थाय तस्मात् प्रातिष्ठद् भीष्मः सत्यपराक्रमः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146278, "chapter_id": 4155, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षडशीतितमोऽध्यायः ॥८६॥\nभगवद्यानपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]