[{"id": 2018181, "chapter_id": 1376, "verse_number": "३-१४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018182, "chapter_id": 1376, "verse_number": "३-१४-१", "content_sanskrit": "असान्निध्यं कथं कृष्ण तवासीद्वृष्णिनन्दन।\nक्व चासीद्विप्रवासस्ते किंचाकार्षीः प्रवासतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018183, "chapter_id": 1376, "verse_number": "३-१४-२x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018184, "chapter_id": 1376, "verse_number": "३-१४-२", "content_sanskrit": "साल्वस्य नगरं सौभं गतोऽहं भरतर्षभ।\nनिहन्तुं कौरवश्रेष्ठ तत्र मे शृणु कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018185, "chapter_id": 1376, "verse_number": "३-१४-३", "content_sanskrit": "महातेजा महांवाहुर्यः स राजा महायशाः।\nदमघोषात्मजो वीरः शिशुपालो मया हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018186, "chapter_id": 1376, "verse_number": "३-१४-४", "content_sanskrit": "यज्ञे ते भरतश्रेष्ठ राजसूयेऽर्हणां प्रति।\nस रोषवशमापन्नो नामृष्यत दुरात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018187, "chapter_id": 1376, "verse_number": "३-१४-५", "content_sanskrit": "श्रुत्वा तं निहतं साल्वस्तीव्ररोषसमन्वितः।\nउपायाद्द्वारकां शून्यामिहस्थे मयि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018188, "chapter_id": 1376, "verse_number": "३-१४-६", "content_sanskrit": "स तत्र युद्धमकरोद्बालकैर्वृष्णिपुङ्गवैः।\nनिवृत्तः कामगं सौभमारुह्यैव नृशंसवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018189, "chapter_id": 1376, "verse_number": "३-१४-७", "content_sanskrit": "`चिरजीवी नृपः सोऽपि प्रसादात्पद्मजन्मनः।\nततो वृष्णिप्रवीरांस्तान्बालान्हत्वा बहूंस्तदा।\nपुरोद्यानानि सर्वाणि भेदयामास दुर्भतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018190, "chapter_id": 1376, "verse_number": "३-१४-८", "content_sanskrit": "उक्तवांश्च महाबाहो क्वासौ वृष्णिकुलाधमः।\nवासुदेवः स मन्दात्मा वसुदेवसुतो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018191, "chapter_id": 1376, "verse_number": "३-१४-९", "content_sanskrit": "तस्य युद्धार्थिनो दर्पं युद्धेनाशयिताऽस्म्यहम्।\nआनर्ताः सत्यमाख्यात तत्र गन्ताऽस्मि यत्र सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018192, "chapter_id": 1376, "verse_number": "३-१४-१०", "content_sanskrit": "तं हत्वा विनिवर्तिष्ये कंसकेशिनिषूदनम्।\nअहत्वा न निवर्तिष्ये सत्येनायुधमालभे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018193, "chapter_id": 1376, "verse_number": "३-१४-११", "content_sanskrit": "क्वासौ क्वासाविति पुनस्तत्रतत्र प्रधावति।\nमया सह रणे योद्धुं काङ्क्षमाणः स सौभराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018194, "chapter_id": 1376, "verse_number": "३-१४-१२", "content_sanskrit": "अद्यतं पापकर्माणं क्षुद्रं विश्वासघातिनम्।\nशिशुपालवधामर्षाद्गमयिष्ये यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018195, "chapter_id": 1376, "verse_number": "३-१४-१३", "content_sanskrit": "मम पापस्वभावेन भ्राता येन निपातितः।\nशिशुपालो महीपालस्तं वधिष्ये महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018196, "chapter_id": 1376, "verse_number": "३-१४-१४", "content_sanskrit": "भ्राता बालश्च राजा च न च संग्रामकोविदः।\nप्रमत्तश्च हतो वीरस्तं हनिष्ये जनार्दनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018197, "chapter_id": 1376, "verse_number": "३-१४-१५", "content_sanskrit": "एकमादि महाराज विलप्यदिवमास्थितः।\nकामगेन स सौभेन क्षिप्त्वा मां कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018198, "chapter_id": 1376, "verse_number": "३-१४-१६", "content_sanskrit": "तमश्रौषमहं गत्वा यथा वृत्तः स दुर्मतिः।\nमयि कौरव्य दुष्टात्मा मार्तिकावतको नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018199, "chapter_id": 1376, "verse_number": "३-१४-१७", "content_sanskrit": "ततोऽहमपि कौरव्य रोषव्याकुललोचनः।\nनिश्चित्य मनसा राजन्वधायास्य मनो दधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018200, "chapter_id": 1376, "verse_number": "३-१४-१८", "content_sanskrit": "आनर्तेषु विमर्दं च क्षेपं चात्मनि कौरव।\nप्रवृद्धमवलेपं च तस्य दुष्कृतकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018201, "chapter_id": 1376, "verse_number": "३-१४-१९", "content_sanskrit": "ततः सौभवधायाहं प्रतस्थे पृथिवीपते।\nस मया सागरावर्ते दृष्ट आसीत्परीप्सता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018202, "chapter_id": 1376, "verse_number": "३-१४-२०", "content_sanskrit": "ततः प्रध्माप्य जलजं पाञ्चजन्यमहे नृप।\nआहूय साल्वं समरे युद्धाय समवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018203, "chapter_id": 1376, "verse_number": "३-१४-२१", "content_sanskrit": "तन्मुहूर्तमभूद्युद्धं तत्र मे दानवैः सह।\nशवीभूताश्च मे सर्वे भूतले च निपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018204, "chapter_id": 1376, "verse_number": "३-१४-२२", "content_sanskrit": "एतत्कार्यं महाबाहो येनाहं नागमं तदा।\nश्रुत्वैव हास्तिनपुरे द्यूतं चाविनयोत्थितम्।\nद्रुतमागतवान्युष्मान्द्रष्टुकामः सुदुःखितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018205, "chapter_id": 1376, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि चतुर्दशोऽष्यायः ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]