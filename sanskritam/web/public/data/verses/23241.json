[{"id": 7003241000, "chapter_id": 23241, "verse_number": "१-४४-१", "content_sanskrit": "शैलादिरुवाच  ।\nस्मरणादेव रुद्रस्य संप्राप्ताश्च गणेश्वराः  ।\nसर्वे सहस्रहस्ताश्च सहस्रायुधपाणयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003241001, "chapter_id": 23241, "verse_number": "१-४४-२", "content_sanskrit": "त्रिनेत्राश्च महात्मानस्त्रिदशैरपि वंदिताः  ।\nकोटिकालाग्निसंकाशा जटामुकुटधारिणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003241002, "chapter_id": 23241, "verse_number": "१-४४-३", "content_sanskrit": "दंष्ट्राकरालवदना नित्या बुद्धाश्च निर्मलाः  ।\nकोटिकोटि गणैस्तुल्यैरात्मना च गणेश्वराः ।\nअसंख्याता महात्मानस्तत्राजग्मुर्मुदायुताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003241003, "chapter_id": 23241, "verse_number": "१-४४-४", "content_sanskrit": "गायंतश्च द्रवंतश्च नृत्यंतश्च महाबलाः  ।\nमुखाडंबरवाद्यानि वादयंतस्तथैव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003241004, "chapter_id": 23241, "verse_number": "१-४४-५", "content_sanskrit": "रथैर्नागैर्हयैश्चैव सिंहमर्कटवाहनाः  ।\nविमानेषु तथारूढा हेमचित्रेषु वै गणाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003241005, "chapter_id": 23241, "verse_number": "१-४४-६", "content_sanskrit": "भेरीमृदंगकाद्यैश्च पणवानकगोमुखैः  ।\nवादित्रैर्विविधैश्चान्यैः पटहैरेकपुष्करैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003241006, "chapter_id": 23241, "verse_number": "१-४४-७", "content_sanskrit": "भेरीमुरजसंनादैराडंबरकडिंडिमैः  ।\nमर्दलैर्वेणुवीणाभिर्विविधैस्तालनिःस्वनैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003241007, "chapter_id": 23241, "verse_number": "१-४४-८", "content_sanskrit": "दर्दुरैस्तलघातैश्च कच्छपैः पणवैरपि  ।\nवाद्यमानैर्महायोगा आजग्मुर्देवसंसदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003241008, "chapter_id": 23241, "verse_number": "१-४४-९", "content_sanskrit": "ते गणेशा महासत्त्वाः सर्वदेवेश्वरेश्वराः  ।\nप्रणम्य देवं देवीं च इदं वचनमबुवन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003241009, "chapter_id": 23241, "verse_number": "१-४४-१०", "content_sanskrit": "भगवन्देवदेवेश त्रियंबक वृषध्वज  ।\nकिमर्थं च स्मृता देव आज्ञापय महाद्युते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003241010, "chapter_id": 23241, "verse_number": "१-४४-११", "content_sanskrit": "किं सागराञ्शोषयामो यमं वा सह किंकरैः  ।\nहन्मो मृत्युसुतां मृत्युं पशुवद्धन्म पद्मजम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003241011, "chapter_id": 23241, "verse_number": "१-४४-१२", "content_sanskrit": "बद्ध्वेन्द्रं सह देवैश्च सह विष्णुं च वायुना  ।\nआनयामः सुसंक्रुद्धा दैत्यान्वा सह दानवैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003241012, "chapter_id": 23241, "verse_number": "१-४४-१३", "content_sanskrit": "कस्याद्य व्यसनं घोरं करिष्यामस्तवाज्ञया  ।\nकस्य वाद्योत्सवो देव सर्वकामसमृद्धये ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003241013, "chapter_id": 23241, "verse_number": "१-४४-१४", "content_sanskrit": "तांस्तथावादिनः सर्वान् गणेशान् सर्वसंमतान्  ।\nउवाच देवः संपूज्य कोटिकोटिशतान्प्रभुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003241014, "chapter_id": 23241, "verse_number": "१-४४-१५", "content_sanskrit": "श्रृणुध्वं यत्कृते यूयमिहाहूता जगद्धिताः  ।\nश्रुत्वा च प्रयतात्मानः कुरुध्वं तदशंकिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003241015, "chapter_id": 23241, "verse_number": "१-४४-१६", "content_sanskrit": "नंदीश्वरोऽयं पुत्रो नः सर्वेषामीश्वरेश्वरः  ।\nविप्रोयं नायकश्चैव सेनानीर्वः समृद्धिमान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003241016, "chapter_id": 23241, "verse_number": "१-४४-१७", "content_sanskrit": "तमिमं मम संदेशाद्यूयं सर्वेपि संमताः  ।\nसेनान्यमभिषिंचध्वं महायोगपतिं पतिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003241017, "chapter_id": 23241, "verse_number": "१-४४-१८", "content_sanskrit": "एवमुक्ता भगवता गणपाः सर्व एव ते  ।\nएवमस्त्विति संमंत्र्य संभारानाहरंस्ततः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003241018, "chapter_id": 23241, "verse_number": "१-४४-१९", "content_sanskrit": "तस्य सर्वाश्रयं दिव्यं जांबूनदमयं शुभम्  ।\nआसनं मेरुसंकाशं मनोहरमुपाहरन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003241019, "chapter_id": 23241, "verse_number": "१-४४-२०", "content_sanskrit": "नैकस्तंभमयं चापि चामीकरवरप्रभम्  ।\nमुक्तादामावलंबं च मणिरत्नावभासितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003241020, "chapter_id": 23241, "verse_number": "१-४४-२१", "content_sanskrit": "स्तंभैश्च वैडुर्यमयैः किंकिणी जालसंवृतम्  ।\nचारुरत्नकसंयुक्तं मंडपं विश्वतोमुखम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003241021, "chapter_id": 23241, "verse_number": "१-४४-२२", "content_sanskrit": "कृत्वा विन्यस्य तन्मध्ये तदासनवरं शुभम्  ।\nतस्याग्रतः पादपीठं नीलवज्रावभासितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003241022, "chapter_id": 23241, "verse_number": "१-४४-२३", "content_sanskrit": "चक्रुः पादप्रतिष्ठार्थं कलशौ चास्य पार्श्वगौ  ।\nसंपूर्णौ परमाम्भोभिररविंदावृताननौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003241023, "chapter_id": 23241, "verse_number": "१-४४-२४", "content_sanskrit": "कलशानां सहस्रं तु सौवर्णं राजतं तथा  ।\nताम्रजं मृन्मयं चैव सर्वतीर्थाबुपूरितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003241024, "chapter_id": 23241, "verse_number": "१-४४-२५", "content_sanskrit": "वासोयुगं तथा दिव्यं गंधं दिव्यं तथैव च  ।\nकेयूरे कुंडले चैव मुकुटं हारमेव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003241025, "chapter_id": 23241, "verse_number": "१-४४-२६", "content_sanskrit": "छत्रं शतशलाकं च वालव्यजनमेव च  ।\nदत्तं महात्मना तेन ब्रह्मणा परमेष्ठिना ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003241026, "chapter_id": 23241, "verse_number": "१-४४-२७", "content_sanskrit": "शंखहारांगगौरेण पृष्ठेनापि विराजितम्  ।\nव्यजनं चंद्रशुभ्रं च हेमदंडं सुचामरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003241027, "chapter_id": 23241, "verse_number": "१-४४-२८", "content_sanskrit": "ऐरावतः सुप्रतीको गजावेतौ सुपूजितौ  ।\nमुकुटं कांचनं चैव निर्मितं विश्वकर्मणा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003241028, "chapter_id": 23241, "verse_number": "१-४४-२९", "content_sanskrit": "कुंडले चामले दिव्ये वज्रं चैव वरायुधम्  ।\nजांबूनदमयं सूत्रं केयूरद्वयमेव च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003241029, "chapter_id": 23241, "verse_number": "१-४४-३०", "content_sanskrit": "संभाराणि तथान्यानि विविधानि बहून्यपि  ।\nसमंतान्निन्युव्यग्रा गणपा देवसंमताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003241030, "chapter_id": 23241, "verse_number": "१-४४-३१", "content_sanskrit": "ततो देवाश्च सेंद्राश्च नारायणमुखास्तथा  ।\nमुनयो भगवान्ब्रह्मा नवब्रह्माण एव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003241031, "chapter_id": 23241, "verse_number": "१-४४-३२", "content_sanskrit": "देवैश्च लोकाः सर्वे ते ततो जग्मुर्मुदा युताः  ।\nतेष्वागतेषु सर्वेषु भगवान्परमेश्वरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003241032, "chapter_id": 23241, "verse_number": "१-४४-३३", "content_sanskrit": "सर्वकार्यविधिं कर्तुमादिदेश पितामहम्  ।\nपितामहोपि भगवान् नियोगादेव तस्य तु ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003241033, "chapter_id": 23241, "verse_number": "१-४४-३४", "content_sanskrit": "चकार सर्वं भगवानभिषेकं समाहितः  ।\nअर्चयित्वा ततो ब्रह्मा स्वयमेवाभ्यषेचयत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003241034, "chapter_id": 23241, "verse_number": "१-४४-३५", "content_sanskrit": "ततो विष्णुस्ततः शक्रो लोकपालास्तथैव च  ।\nअभ्यषिंचंत विधिवद्गणेन्द्रं शिवशासनात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003241035, "chapter_id": 23241, "verse_number": "१-४४-३६", "content_sanskrit": "ऋषयस्तुष्टुवुश्चैव पितामहपुरोगमाः  ।\nस्तुतवत्सु ततस्तेषु विष्णुः सर्वजगत्पतिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003241036, "chapter_id": 23241, "verse_number": "१-४४-३७", "content_sanskrit": "शिरस्यंजलिमादाय तुष्टाव च समाहितः  ।\nप्रांजलिः प्रणतो भूत्वा जयशब्दं चकार च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003241037, "chapter_id": 23241, "verse_number": "१-४४-३८", "content_sanskrit": "ततो गणाधिपाः सर्वे ततो देवास्ततोऽसुराः  ।\nएवं स्तुतश्चाभिषिक्तो देवैः सब्रह्मकैस्तदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003241038, "chapter_id": 23241, "verse_number": "१-४४-३९", "content_sanskrit": "उद्वाहश्च कृतस्तत्र नियोगात्परमेष्ठिनः  ।\nमरुतां च सुता देवी सुयशाख्या बभूव या ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003241039, "chapter_id": 23241, "verse_number": "१-४४-४०", "content_sanskrit": "लब्धं शशिप्रभं छत्रं तया तत्र विभूषितम्  ।\nचामरे चामरासक्तहस्ताग्रैः स्त्रीगणैर्युता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003241040, "chapter_id": 23241, "verse_number": "१-४४-४१", "content_sanskrit": "सिंहासनं च परमं तया चाधिष्ठितं मया  ।\nअलंकृता महालक्ष्म्या मुकुटाद्यैः सुभूषणैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003241041, "chapter_id": 23241, "verse_number": "१-४४-४२", "content_sanskrit": "लब्धो हारश्च परमो देव्याः कंठगतस्तथा  ।\nवृषेन्द्रश्च सितो नागः सिंहः सिंहध्वजस्तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003241042, "chapter_id": 23241, "verse_number": "१-४४-४३", "content_sanskrit": "रथश्च हेमच्छत्रं च चंद्रबिंबसमप्रभम्  ।\nअद्यापि सदृशः कश्चिन्मया नास्ति विभुः क्वचित् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003241043, "chapter_id": 23241, "verse_number": "१-४४-४४", "content_sanskrit": "सान्वयं च गृहीत्वेशस्तथा संबंधिबांधवैः  ।\nआरुह्य वृषमीशानो मया देव्या गतः शिवः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003241044, "chapter_id": 23241, "verse_number": "१-४४-४५", "content_sanskrit": "तदा देवीं भवं दृष्ट्वा मया च प्रार्थयन् गणैः  ।\nमुनिदेवर्षयः सिद्धा आज्ञां पाशुपतीं द्विजाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003241045, "chapter_id": 23241, "verse_number": "१-४४-४६", "content_sanskrit": "अथाज्ञां प्रददौ तेषामर्हाणामज्ञया विभोः  ।\nनंदिको नगजाभर्तुस्तेषां पाशुपतीं शुभाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003241046, "chapter_id": 23241, "verse_number": "१-४४-४७", "content_sanskrit": "तस्माद्धि मुनयो लब्ध्वा तदाज्ञां मुनिपुंगवात्  ।\nभवभक्तास्तदा चासंस्तस्मादेवं समर्चयेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003241047, "chapter_id": 23241, "verse_number": "१-४४-४८", "content_sanskrit": "नमस्कारविहीनस्तु नाम उद्गिरयेद्भवे  ।\nब्रह्मघ्नदशसंतुल्यं तस्य पापं गरीयसम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003241048, "chapter_id": 23241, "verse_number": "१-४४-४९", "content_sanskrit": "तस्मात्सर्वप्रकारेण नमस्कारादिमुच्चरेत्  ।\nआदौ कुर्यान्नमस्कारं तदंते शिवतां व्रजेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]