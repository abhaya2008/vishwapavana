[{"id": 2050858, "chapter_id": 2115, "verse_number": "७-४२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050859, "chapter_id": 2115, "verse_number": "७-४२-१", "content_sanskrit": "बालमत्यन्तसुखिनं स्वबाहुबलदर्पितम्।\nयुद्धेष्वकुशलं वीरं कुलपुत्रं तनुत्यजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050860, "chapter_id": 2115, "verse_number": "७-४२-२", "content_sanskrit": "गाहमानमनीकानि सदश्वैश्च त्रिहायनैः।\nअपि यौधिष्ठिरात्सैन्यात्कश्चिदन्वपतद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050861, "chapter_id": 2115, "verse_number": "७-४२-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050862, "chapter_id": 2115, "verse_number": "७-४२-३", "content_sanskrit": "युधिष्ठिरो भीमसेनः शिखण्डी सात्यकिर्यमौ।\nधृष्टद्युम्नो विराटश्च द्रुपदश्च सङ्केकयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050863, "chapter_id": 2115, "verse_number": "७-४२-४", "content_sanskrit": "धृष्टकेतुश्च संरब्धो मात्स्याश्चाभ्यपतन्रणे।\nतेनैव तु पथा यान्तः पितरो मातुलैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050864, "chapter_id": 2115, "verse_number": "७-४२-५", "content_sanskrit": "अभ्यद्रवन्परीप्सन्तो व्यूढानीकाः प्रहारिणः।\nतान्दृष्ट्वा द्रवतः शूरांस्त्वदीया विमुखाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050865, "chapter_id": 2115, "verse_number": "७-४२-६", "content_sanskrit": "ततस्तद्विमुखं दृष्ट्वा तव सूनोर्महद्बलम्।\nजामाता तव तेजस्वी संस्तम्भयिषुराद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050866, "chapter_id": 2115, "verse_number": "७-४२-७", "content_sanskrit": "सैन्धवस्य महाराज पुत्रो राजा जयद्रथः।\nस पुत्रगृद्धिनः पार्थान्सहसैन्यानवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050867, "chapter_id": 2115, "verse_number": "७-४२-८", "content_sanskrit": "उग्रधन्वा महेष्वासो दिव्यमस्त्रमुदीरयन्।\nवार्धक्षत्रिरुपासेधत्प्रवणादिव कुञ्जरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050868, "chapter_id": 2115, "verse_number": "७-४२-९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050869, "chapter_id": 2115, "verse_number": "७-४२-९", "content_sanskrit": "कतिभारमहं मन्ये सैन्धवे सञ्जयाहितम्।\nयदेकः पाण्डवान्क्रुद्धान्पुप्रेप्सूनवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050870, "chapter_id": 2115, "verse_number": "७-४२-१०", "content_sanskrit": "अत्यद्भुतमहं मन्ये बलं शौर्यं च सैन्धवे।\nतस्य प्रब्रूहि मे वीर्यं कर्म चाग्र्यं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050871, "chapter_id": 2115, "verse_number": "७-४२-११", "content_sanskrit": "किं जप्तं हुतमिष्टं वा किं सुतप्तमथो तपः।\n`दमो वा ब्रह्मचर्यं वा सूत यच्चास्य सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050872, "chapter_id": 2115, "verse_number": "७-४२-१२", "content_sanskrit": "देवं कतममाराध्य विष्णुमीशानमब्जजम्।\nसिन्धुराट् तनये सक्तान्क्रुद्धान्पार्थानवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050873, "chapter_id": 2115, "verse_number": "७-४२-१३", "content_sanskrit": "नैवं कृतं महत्कर्म भीष्मेणाज्ञासिषं तथा।\nसिन्धुराजो हि येनैकः पाण्डवान्समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050874, "chapter_id": 2115, "verse_number": "७-४२-१४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050875, "chapter_id": 2115, "verse_number": "७-४२-१४", "content_sanskrit": "द्वीपदीहरणे यत्तद्भीमसेनेन निर्जितः।\nमानात्स तप्तवान्राजा वरार्थी सुमहत्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050876, "chapter_id": 2115, "verse_number": "७-४२-१५", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थेभ्यः प्रियेभ्यः सन्निवर्त्य सः।\nक्षुत्पिपासातकपसहः कृशो धमनिसन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050877, "chapter_id": 2115, "verse_number": "७-४२-१६", "content_sanskrit": "देवमाराधयच्छर्वं गृणन्ब्रह्म सनातनम्।\nभक्तानुकम्पी भगवांस्तस्य चक्रे ततो दयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050878, "chapter_id": 2115, "verse_number": "७-४२-१७", "content_sanskrit": "स्वप्नान्तेऽप्यथ चैवाह हरः सिन्धुपतेः सुतम्।\nवरं वृणीष्व प्रीतोऽस्मि जयद्रथ किमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050879, "chapter_id": 2115, "verse_number": "७-४२-१८", "content_sanskrit": "एवमुक्तस्तु शर्वेण सिन्धुराजो जयद्रथः।\nउवाच प्रणतो रुद्रं प्राञ्जलिर्नियतात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050880, "chapter_id": 2115, "verse_number": "७-४२-१९", "content_sanskrit": "पाण्डवेयानहं सङ्ख्ये भीमवीर्यपराक्रमान्।\nवारयेयं रथेनैकः समस्तानिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050881, "chapter_id": 2115, "verse_number": "७-४२-२०", "content_sanskrit": "एवमुक्तस्तु देवेशो जयद्रथमथाब्रवीत्।\nददामि ते वरं सौम्य विना पार्थं धनञ्जयम्।\nवारयिष्यसि सङ्ग्रामे चतुरः पाण्डुनन्दनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050882, "chapter_id": 2115, "verse_number": "७-४२-२१", "content_sanskrit": "`एकाहमिति राजेन्द्र तत्रैवान्तरधीयत।\nएवमस्त्विति देवेशमुक्त्वाबुद्ध्यत पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050883, "chapter_id": 2115, "verse_number": "७-४२-२२", "content_sanskrit": "स तेन वरदानेन दिव्येनास्त्बलेन च।\nएकः संवारयामास पाण्डवानामनीकिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050884, "chapter_id": 2115, "verse_number": "७-४२-२३", "content_sanskrit": "तस्य ज्यातलघोषेण क्षत्रियान्भयमाविशत्।\nपरांस्तु तव सैन्यस्य हर्षः परमकोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050885, "chapter_id": 2115, "verse_number": "७-४२-२४", "content_sanskrit": "दृष्ट्वा तु क्षत्रिया भारं सैन्धवे सर्वमाहितम्।\nउत्क्रुश्याभ्यद्रवन्राजन्येन यौधिष्ठिरं बलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050886, "chapter_id": 2115, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे द्विचत्वारिंशोऽध्यायः॥ ४२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-४२-८ प्रवणान्निम्नप्रदेशं प्नाप्य॥ ५-४२-१० बलं सामर्थ्यम्। शौर्यमुत्साहः वीर्यं प्रभावम्॥ ५-४२-४२ द्विचत्वारिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]