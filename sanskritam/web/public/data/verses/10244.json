[{"id": 6000244000, "chapter_id": 10244, "verse_number": null, "content_sanskrit": "अथ अष्टचत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000244001, "chapter_id": 10244, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.001.m4a", "display_order": 2}, {"id": 6000244002, "chapter_id": 10244, "verse_number": "१०-४८-१", "content_sanskrit": "स गत्वा हस्तिनपुरं पौरवेन्द्रयशोऽङ्कितम्।\nददर्श तत्राम्बिकेयं सभीष्मं विदुरं पृथाम्॥ १०/४८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.002.m4a", "display_order": 3, "topics": [{"text": "हास्तिनपुरं प्राप्तवताऽक्रूरेण धृतराष्ट्रस्य पाण्डवेषु विषमां बुद्धिं ज्ञात्वा मधुरागमनम्", "range": "१–३१"}]}, {"id": 6000244003, "chapter_id": 10244, "verse_number": "१०-४८-२", "content_sanskrit": "सहपुत्रं च बाह्लीकं भारद्वाजं सगौतमम्।\nकर्णं सुयोधनं द्रौणिं पाण्डवान् सुहृदोऽपरान्॥ १०/४८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.003.m4a", "display_order": 4}, {"id": 6000244004, "chapter_id": 10244, "verse_number": "१०-४८-३", "content_sanskrit": "यथावदुपसङ्गम्य बन्धुभिर्गान्दिनीसुतः।\nसम्पृष्टस्तैः सुहृद्वार्तां स्वयं चापृच्छदव्ययम्॥ १०/४८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.004.m4a", "display_order": 5}, {"id": 6000244005, "chapter_id": 10244, "verse_number": "१०-४८-४", "content_sanskrit": "उवास कतिचिन्मासान् राज्ञो वृत्तविवित्सया।\nदुष्प्रज्ञस्याल्पसारस्य खलच्छन्दानुवर्तिनः॥ १०/४८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.005.m4a", "display_order": 6}, {"id": 6000244006, "chapter_id": 10244, "verse_number": "१०-४८-५", "content_sanskrit": "तेज ओजो बलं वीर्यं प्रश्रयादींश्च सद्गुणान्।\nप्रजानुरागं पार्थेषु न सहद्भिश्चिकीर्षितम्॥ १०/४८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.006.m4a", "display_order": 7}, {"id": 6000244007, "chapter_id": 10244, "verse_number": "१०-४८-६", "content_sanskrit": "कृतं च धार्तराष्ट्रैर्यद् गरदानाद्यकौशलम्।\nआचख्यौ सर्वमेतस्मै पृथा विदुर एव च॥ १०/४८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.007.m4a", "display_order": 8}, {"id": 6000244008, "chapter_id": 10244, "verse_number": "१०-४८-७", "content_sanskrit": "पृथा तु भ्रातरं प्राप्तमक्रूरमुपसृत्य तम्।\nउवाच जन्मनिलयं स्मरन्त्यश्रुकुलेक्षणा॥ १०/४८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.008.m4a", "display_order": 9}, {"id": 6000244009, "chapter_id": 10244, "verse_number": "१०-४८-८", "content_sanskrit": "अपि स्मरन्ति नः सौम्य पितरौ भ्रातरश्च मे।\nभगिन्यो भ्रातृपुत्राश्च जामयः सख्य एव च॥ १०/४८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.009.m4a", "display_order": 10}, {"id": 6000244010, "chapter_id": 10244, "verse_number": "१०-४८-९", "content_sanskrit": "भ्रात्रीयो भगवान् कृष्णः शरण्यो भक्तवत्सलः।\nपैतृष्वस्रीयान् स्मरति रामश्चाम्बुरुहेक्षणः॥ १०/४८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.010.m4a", "display_order": 11}, {"id": 6000244011, "chapter_id": 10244, "verse_number": "१०-४८-१०", "content_sanskrit": "सपत्नमध्ये शोचन्तीं वृकाणां हरिणीमिव।\nसान्त्वयिष्यति मां वाक्यैः पितृहीनांश्च बालकान्॥ १०/४८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.011.m4a", "display_order": 12}, {"id": 6000244012, "chapter_id": 10244, "verse_number": "१०-४८-११", "content_sanskrit": "कृष्ण कृष्ण महायोगिन् सर्वात्मन् विश्वपालक।\nप्रपन्नां पाहि गोविन्द शिशुभिश्चावसीदतीम्॥ १०/४८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.012.m4a", "display_order": 13}, {"id": 6000244013, "chapter_id": 10244, "verse_number": "१०-४८-१२", "content_sanskrit": "नान्यत् तव पदाम्भोजात् पश्यामि शरणं नृणाम्।\nबिभ्यतां मृत्युसंसारादीश्वरस्यापवर्गिकात्॥ १०/४८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.013.m4a", "display_order": 14}, {"id": 6000244014, "chapter_id": 10244, "verse_number": "१०-४८-१३", "content_sanskrit": "नमः कृष्णाय शुद्धाय ब्रह्मणे परमात्मने।\nयोगेश्वराय योगाय त्वामहं शरणं गता॥ १०/४८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.014.m4a", "display_order": 15}, {"id": 6000244015, "chapter_id": 10244, "verse_number": "१०-४८-१४", "content_sanskrit": "इत्यनुस्मृत्य स्वजनं कृष्णं च जगदीश्वरम्।\nप्रारुदद् दुःखिता राजन् भवतां प्रपितामही॥ १०/४८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.015.m4a", "display_order": 16}, {"id": 6000244016, "chapter_id": 10244, "verse_number": "१०-४८-१५", "content_sanskrit": "समदुःखसुखोऽक्रूरो विदुरश्च महायशाः।\nसान्त्वयामासतुः कुन्तीं तत्पुत्रोत्पत्तिहेतुभिः॥ १०/४८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.016.m4a", "display_order": 17}, {"id": 6000244017, "chapter_id": 10244, "verse_number": "१०-४८-१६", "content_sanskrit": "यास्यन् राजानमभ्येत्य विषमं पुत्रलालसम्।\nप्रावदत् सुहृदां मध्ये बन्धुभिः सौहृदोदितम्॥ १०/४८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.017.m4a", "display_order": 18}, {"id": 6000244018, "chapter_id": 10244, "verse_number": null, "content_sanskrit": "अक्रूर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.018.m4a", "display_order": 19}, {"id": 6000244019, "chapter_id": 10244, "verse_number": "१०-४८-१७", "content_sanskrit": "भो भो वैचित्रवीर्य त्वं कुरूणां कीर्तिवर्धन।\nभ्रातर्युपरते पाण्डौ बन्धूनां सममास्थितः॥ १०/४८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.019.m4a", "display_order": 20}, {"id": 6000244020, "chapter_id": 10244, "verse_number": "१०-४८-१८", "content_sanskrit": "धर्मेण पालयन्नुर्वीं प्रजाः शीलेन रञ्जयन्।\nवर्तमानः समः स्वेषु श्रेयः कीर्तिमवाप्स्यसि॥ १०/४८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.020.m4a", "display_order": 21}, {"id": 6000244021, "chapter_id": 10244, "verse_number": "१०-४८-१९", "content_sanskrit": "अन्यथा त्वाचरल्लोके गर्हितो यास्यसे तमः।\nतस्मात् समस्त्वं वर्तस्व पाण्डवेष्वात्मजेषु च॥ १०/४८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.021.m4a", "display_order": 22}, {"id": 6000244022, "chapter_id": 10244, "verse_number": "१०-४८-२०", "content_sanskrit": "नेह चात्यन्तसंवासः कस्यचित् केनचित् सह।\nराजन् स्वेनापि देहेन किमु जायात्मजादिभिः॥ १०/४८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.022.m4a", "display_order": 23}, {"id": 6000244023, "chapter_id": 10244, "verse_number": "१०-४८-२१", "content_sanskrit": "एकः प्रसूयते जन्तुरेक एव प्रलीयते।\nएकोऽनुभुङ्क्ते सुकृतमेक एव च दुष्कृतम्॥ १०/४८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.023.m4a", "display_order": 24}, {"id": 6000244024, "chapter_id": 10244, "verse_number": "१०-४८-२२", "content_sanskrit": "अधर्मोपचितं वित्तं हरन्त्यन्येऽल्पचेतसः।\nसम्भोजनीयापदेशैर्जलानीव जलौकसः॥ १०/४८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.024.m4a", "display_order": 25}, {"id": 6000244025, "chapter_id": 10244, "verse_number": "१०-४८-२३", "content_sanskrit": "पुष्णाति यानधर्मेण स्वबुद्ध्या तमपण्डितम्।\nअन्तेऽकृतार्था हिन्वन्ति प्राणा रायः सुतादयः॥ १०/४८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.025.m4a", "display_order": 26}, {"id": 6000244026, "chapter_id": 10244, "verse_number": "१०-४८-२४", "content_sanskrit": "स्वयं किल्बिषमादाय तैस्त्यक्तो नार्थकोविदः।\nअसिद्धार्थो विशत्यन्धं स्वधर्मविमुखस्तमः॥ १०/४८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.026.m4a", "display_order": 27}, {"id": 6000244027, "chapter_id": 10244, "verse_number": "१०-४८-२५", "content_sanskrit": "तस्माल्लोकमिमं राजन् स्वप्नमायामनोरथम्।\nसम्भजन्नात्मनाऽऽत्मानं समः शान्तो भव प्रभो॥ १०/४८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.027.m4a", "display_order": 28}, {"id": 6000244028, "chapter_id": 10244, "verse_number": null, "content_sanskrit": "धृतराष्ट्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.028.m4a", "display_order": 29}, {"id": 6000244029, "chapter_id": 10244, "verse_number": "१०-४८-२६", "content_sanskrit": "यथा वदति कल्याणीं वाचं दानपते भवान्।\nतथाऽनया न तृप्यामि मर्त्यः प्राप्य यथाऽमृतम्॥ १०/४८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.029.m4a", "display_order": 30}, {"id": 6000244030, "chapter_id": 10244, "verse_number": "१०-४८-२७", "content_sanskrit": "तथापि सूनृता सौम्य हृदि न स्थीयते जले।\nपुत्रानुरागविषमे विद्युत् सौदामनी यथा॥ १०/४८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.030.m4a", "display_order": 31}, {"id": 6000244031, "chapter_id": 10244, "verse_number": "१०-४८-२८", "content_sanskrit": "ईश्वरस्य विधिं को नु विधुनोत्यन्यथा पुमान्।\nभूमेर्भारावताराय योऽवतीर्णो यदोः कुले॥ १०/४८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.031.m4a", "display_order": 32}, {"id": 6000244032, "chapter_id": 10244, "verse_number": "१०-४८-२९", "content_sanskrit": "यो दुर्विमर्शपथया निजमाययेदं सृष्ट्वा गुणान् विभजते तदनुप्रविष्टः।\nतस्मै नमो दुरवबोधविहारतन्त्रसंसारचक्रगतये परमेश्वराय॥ १०/४८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.032.m4a", "display_order": 33}, {"id": 6000244033, "chapter_id": 10244, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.033.m4a", "display_order": 34}, {"id": 6000244034, "chapter_id": 10244, "verse_number": "१०-४८-३०", "content_sanskrit": "इत्यभिप्रेत्य नृपतेरभिप्रायं स यादवः।\nसुहृद्भिः समनुज्ञातः पुनर्यदुपुरीमगात्॥ १०/४८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.034.m4a", "display_order": 35}, {"id": 6000244035, "chapter_id": 10244, "verse_number": "१०-४८-३१", "content_sanskrit": "शशंस रामकृष्णाभ्यां धृतराष्ट्रविचेष्टितम्।\nपाण्डवान् प्रति कौरव्य यदर्थं प्रेषितः स्वयम्॥ १०/४८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_048/BhP_10.048.035.m4a", "display_order": 36}, {"id": 6000244036, "chapter_id": 10244, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे अष्टचत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]