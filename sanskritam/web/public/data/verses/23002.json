[{"id": 7003002000, "chapter_id": 23002, "verse_number": "२-४९-१", "content_sanskrit": "पार्वत्युवाच ।\nकथं सुदामशापञ्च सा देवी ललाभ ह ।\nकथं शशाप भृत्यो हि स्वाभीष्टां देवकामिनीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003002001, "chapter_id": 23002, "verse_number": "२-४९-२", "content_sanskrit": "श्रीभगवानुवाच ।\nशृणु देवी प्रवक्ष्यामि रहस्यं परमाद्भुतम् ।\nगोप्यं सर्वपुराणेषु शुभदं भक्तिमुक्तिदम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003002002, "chapter_id": 23002, "verse_number": "२-४९-३", "content_sanskrit": "एकदा राधिकेशश्च गोलोके रासमण्डले ।\nशतशृंगाख्यगिर्येकदेशे वृन्दावने वने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003002003, "chapter_id": 23002, "verse_number": "२-४९-४", "content_sanskrit": "गृहीत्वा विरजां गोपीं सुभाग्यां राधिकासमाम् ।\nक्रीडां चकार भगवान्रत्नभूषणभूषितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003002004, "chapter_id": 23002, "verse_number": "२-४९-५", "content_sanskrit": "रत्नप्रदीपसंयुक्ते रत्ननिर्माणमण्डले ।\nअमूल्यरत्नखचितमञ्चके पुष्पतल्पके ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003002005, "chapter_id": 23002, "verse_number": "२-४९-६", "content_sanskrit": "कस्तूरीकुंकुमारक्ते सुचन्दनसुधूपिते ।\nसुगन्धिमालतीमालासमूहपरिमण्डिते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003002006, "chapter_id": 23002, "verse_number": "२-४९-७", "content_sanskrit": "सुरताद्विरतिर्नास्ति दम्पती रतिपण्डितौ ।\nतौ द्वौ परस्पराक्तौ सुखसम्भोगतन्त्रितौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003002007, "chapter_id": 23002, "verse_number": "२-४९-८", "content_sanskrit": "मन्वन्तराणां लक्षश्च कालः परिमितो गतः ।\nगोलोकस्य स्वल्पकाले जन्मादिरहितस्य च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003002008, "chapter_id": 23002, "verse_number": "२-४९-९", "content_sanskrit": "दूत्यश्चतस्रो ज्ञात्वाऽथ जगदुस्तां तु राधिकम् ।\nश्रुत्वा परमरुष्टा सा तत्याज हरिमीश्वरी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003002009, "chapter_id": 23002, "verse_number": "२-४९-१०", "content_sanskrit": "प्रबोधिता च सखिभिः कोपरक्तास्यलोचना ।\nविहाय रत्नालङ्कारं वह्निशुद्धांशुके शुभे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003002010, "chapter_id": 23002, "verse_number": "२-४९-११", "content_sanskrit": "क्रीडापद्मं च सद्रत्नामूल्यदर्पणमुज्ज्वलम् ।\nनिर्मार्जयामास सती सिन्दूरं चित्रपत्रकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003002011, "chapter_id": 23002, "verse_number": "२-४९-१२", "content_sanskrit": "प्रक्षाल्य तोयाञ्जलिभिर्मुखरागमलक्तकम् ।\nविस्रस्तकबरीभारा मुक्तकेशी प्रकम्पिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003002012, "chapter_id": 23002, "verse_number": "२-४९-१३", "content_sanskrit": "शुक्लवस्त्रपरीधाना रूक्षा वेषादिवर्जिता ।\nययौ यानान्तिकं तूर्णं प्रियालीभिर्निवारिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003002013, "chapter_id": 23002, "verse_number": "२-४९-१४", "content_sanskrit": "आजुहाव सखीसंघं रोषविस्फुरिताधरा ।\nशश्वत्कम्पान्वितांगी सा गोपीभिः परिवारिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003002014, "chapter_id": 23002, "verse_number": "२-४९-१५", "content_sanskrit": "ताभिर्भक्त्या युताभिश्च कातराभिश्च संस्तुता ।\nआरुरोह रथं दिव्यममूल्यं रत्ननिर्मितम् ।\nदशयोजनविस्तीर्णं दैर्घ्ये तच्छतयोजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003002015, "chapter_id": 23002, "verse_number": "२-४९-१६", "content_sanskrit": "सहस्रचक्रयुक्तं च नानाचित्रसमन्वितम् ।\nनानाविचित्रवसनैः सूक्ष्मैः क्षौमैर्विराजितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003002016, "chapter_id": 23002, "verse_number": "२-४९-१७", "content_sanskrit": "अमूल्यरत्ननिर्माणदर्पणैः परिशोभितम् ।\nमणीन्द्रजालमालाभैः पुष्पमालासहस्रकैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003002017, "chapter_id": 23002, "verse_number": "२-४९-१८", "content_sanskrit": "सद्रत्न कलशैर्युक्तं रम्यैर्मन्दिरकोटिभिः ।\nत्रिलक्षकोटिभिः सार्द्ध गोपीभिश्च प्रियालिभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003002018, "chapter_id": 23002, "verse_number": "२-४९-१९", "content_sanskrit": "ययौ रथेन तेनैव सुमनोमालिना प्रिये ।\nश्रुत्वा कोलाहलं गोपः सुदामा कृष्णपार्षदः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003002019, "chapter_id": 23002, "verse_number": "२-४९-२०", "content_sanskrit": "कृष्णं कृत्वा सावधानं गोपैः सार्द्धं पलायितः ।\nभयेन कृष्णः सन्त्रस्तो विहाय विरजां सतीम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003002020, "chapter_id": 23002, "verse_number": "२-४९-२१", "content_sanskrit": "स्वप्रेममग्नः कृष्णोऽपि तिरोधानं चकार सः ।\nसा सती समयं ज्ञात्वा विचार्य्य स्वहृदि क्रुधा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003002021, "chapter_id": 23002, "verse_number": "२-४९-२२", "content_sanskrit": "राधाप्रकोपभीता च प्राणांस्तत्याज तत्क्षणम् ।\nविरजालिगणास्तत्र भयविह्वलकातराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003002022, "chapter_id": 23002, "verse_number": "२-४९-२३", "content_sanskrit": "प्रययुः शरणं साध्वीं विरजां तत्क्षणं भिया ।\nगोलोके सा सरिद्रूपा जाता वै शैलकन्यके ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003002023, "chapter_id": 23002, "verse_number": "२-४९-२४", "content_sanskrit": "कोटियोजनविस्तीर्णा दीर्घे शतगुणा तथा ।\nगोलोकं वेष्टयामास परिखेव मनोहरा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003002024, "chapter_id": 23002, "verse_number": "२-४९-२५", "content_sanskrit": "बभूवुः क्षुद्रनद्यश्च तदाऽन्या गोप्य एव च ।\nसर्वा नद्यस्तदंशाश्च प्रतिविश्वेषु सुन्दरि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003002025, "chapter_id": 23002, "verse_number": "२-४९-२६", "content_sanskrit": "इमे सप्त समुद्राश्च विरजानन्दना भुवि ।\nअथागत्य महाभागा राधा रासेश्वरी परा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003002026, "chapter_id": 23002, "verse_number": "२-४९-२७", "content_sanskrit": "न दृष्ट्वा विरजां कृष्णं स्वगृहं च पुनर्ययौ ।\nजगाम कृष्णस्तां राधां गोपालैरष्टभिः सह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003002027, "chapter_id": 23002, "verse_number": "२-४९-२८", "content_sanskrit": "गोपीभिर्द्वारि युक्ताभिर्वारितोऽपि पुनः पुनः ।\nदृष्ट्वा कृष्णं च सा देवी भर्त्सयामास तं तदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003002028, "chapter_id": 23002, "verse_number": "२-४९-२९", "content_sanskrit": "सुदामा भर्त्सयामास तां तथा कृष्णसन्निधौ ।\nक्रुद्धा शशाप सा देवी सुदामानं सुरेश्वरी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003002029, "chapter_id": 23002, "verse_number": "२-४९-३०", "content_sanskrit": "गच्छ त्वमासुरीं योनिं गच्छ दूरमतो द्रुतम् ।\nशशाप तां सुदामा च त्वमितो गच्छ भारतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003002030, "chapter_id": 23002, "verse_number": "२-४९-३१", "content_sanskrit": "भव गोपी गोपकन्यामुख्याभिः स्वाभिरेव च ।\nतत्र ते कृष्णविच्छेदो भविष्यति शतं समाः॥ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003002031, "chapter_id": 23002, "verse_number": "२-४९-३२", "content_sanskrit": "तत्र भारावतरणं भगवांश्च करिष्यति ।\nइति शप्त्वा सुदामाऽसौ प्रणम्य जननीं हरिम् ।\nसाश्रुनेत्रो मोहयुक्तस्ततो गन्तुं समुद्यतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003002032, "chapter_id": 23002, "verse_number": "२-४९-३३", "content_sanskrit": "राधा जगाम तत्पश्चात्साश्रुनेत्राऽतिविह्वला ।\nवत्स क्व यासीत्युच्चार्य्य पुत्रविच्छेदकातरा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003002033, "chapter_id": 23002, "verse_number": "२-४९-३४", "content_sanskrit": "कृष्णस्तां बोधयामास विद्यया च कृपानिधिः ।\nशीघ्रं संप्राप्स्यसि सुतं मा रुदस्त्वं वरानने ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003002034, "chapter_id": 23002, "verse_number": "२-४९-३५", "content_sanskrit": "स चासुरः शङ्खचूडो बभूव तुलसीपतिः ।\nमच्छूलभिन्नकायेन गोलोकं वै जगाम सः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003002035, "chapter_id": 23002, "verse_number": "२-४९-३६", "content_sanskrit": "राधा जगाम वाराहे गोकुलं भारतं सती ।\nवृषभानोश्च वैश्यस्य सा च कन्या बभूव ह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003002036, "chapter_id": 23002, "verse_number": "२-४९-३७", "content_sanskrit": "अयोनिसम्भवा देवी वायुगर्भा कलावती ।\nसुषुवे मायया वायुं सा तत्राविर्बभूव ह ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003002037, "chapter_id": 23002, "verse_number": "२-४९-३८", "content_sanskrit": "अतीते द्वादशाब्दे तु दृष्ट्वा तां नवयौवनाम् ।\nसार्धं रायाणवैश्येन तत्सम्बन्धं चकार सः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003002038, "chapter_id": 23002, "verse_number": "२-४९-३९", "content_sanskrit": "छायां संस्थाप्य तद्गेहे साऽन्तर्द्धानमवाप ह ।\nबभूव तस्य वैश्यस्य विवाहश्छायया सह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003002039, "chapter_id": 23002, "verse_number": "२-४९-४०", "content_sanskrit": "गते चतुर्दशाब्दे तु कंसभीतेश्छलेन च ।\nजगाम गोकुलं कृष्णः शिशुरूपी जगत्पतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003002040, "chapter_id": 23002, "verse_number": "२-४९-४१", "content_sanskrit": "कृष्णमाता यशोदा या रायाणस्तत्सहोदरः ।\nगोलोके गोपकृष्णांशः सम्बन्धात्कृष्णमातुलः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003002041, "chapter_id": 23002, "verse_number": "२-४९-४२", "content_sanskrit": "कृष्णेन सह राधायाः पुण्ये वृन्दावने वने ।\nविवाहं कारयामास विधिना जगतां विधिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003002042, "chapter_id": 23002, "verse_number": "२-४९-४३", "content_sanskrit": "स्वप्ने राधापदाम्भोजं नहि पश्यन्ति बल्लवाः ।\nस्वयं राधा हरेः क्रोडे छाया रायाणमन्दिरे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003002043, "chapter_id": 23002, "verse_number": "२-४९-४४", "content_sanskrit": "षष्टिवर्षसहस्राणि तपस्तेपे पुरा विधिः ।\nराधिकाचरणाम्भोजदर्शनार्थी च पुष्करे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003002044, "chapter_id": 23002, "verse_number": "२-४९-४५", "content_sanskrit": "भारावतरणे भूमेर्भारते नन्दगोकुले ।\nददर्श तत्पदाम्भोजं तपसस्तत्फलेन  च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003002045, "chapter_id": 23002, "verse_number": "२-४९-४६", "content_sanskrit": "किञ्चित्कालं स वै कृष्णः पुण्ये वृन्दावने वने ।\nरेमे गोलोकनाथश्च राधया सह भारते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003002046, "chapter_id": 23002, "verse_number": "२-४९-४७", "content_sanskrit": "ततः सुदामशापेन विच्छेदश्च बभूव ह ।\nतत्र भारावतरणं भूमेः कृष्णश्चकार सः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003002047, "chapter_id": 23002, "verse_number": "२-४९-४८", "content_sanskrit": "शताब्दे समतीते तु तीर्थयात्राप्रसंगतः ।\nददर्श कृष्णं सा राधा स च तां च परस्परम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003002048, "chapter_id": 23002, "verse_number": "२-४९-४९", "content_sanskrit": "ततो जगाम गोलोकं राधया सह तत्त्ववित् ।\nकलावती यशोदा च पर्यगाद्राधया सह ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003002049, "chapter_id": 23002, "verse_number": "२-४९-५०", "content_sanskrit": "वृषभानुश्च नन्दश्च ययौ गोलोकमुत्तमम् ।\nसर्वे गोपाश्च गोप्यश्च ययुस्ता याः समागताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003002050, "chapter_id": 23002, "verse_number": "२-४९-५१", "content_sanskrit": "छाया गोपाश्च गोप्यश्च प्रापुर्मुक्तिं च सन्निधौ ।\nरेमिरे ताश्च तत्रैव सार्द्धं कृष्णेन पार्वति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003002051, "chapter_id": 23002, "verse_number": "२-४९-५२", "content_sanskrit": "षट्त्रिंशल्लक्षकोट्यश्च गोप्यो गोपाश्च तत्समाः ।\nगोलोकं प्रययुर्मुक्ताः सार्धं कृष्णेन राधया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003002052, "chapter_id": 23002, "verse_number": "२-४९-५३", "content_sanskrit": "द्रोणः प्रजापतिर्नन्दो यशोदा तत्प्रिया धरा ।\nसंप्राप पूर्वतपसा परमात्मानमीश्वरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003002053, "chapter_id": 23002, "verse_number": "२-४९-५४", "content_sanskrit": "वसुदेवः कश्यपश्च देवकी चादितिः सती ।\nदेवमाता देवपिता प्रतिकल्पे स्वभावतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003002054, "chapter_id": 23002, "verse_number": "२-४९-५५", "content_sanskrit": "पितॄणां मानसी कन्या राधामाता कलावती ।\nवसुदामापि गोलोकाद् वृषभानुः समाययौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003002055, "chapter_id": 23002, "verse_number": "२-४९-५६", "content_sanskrit": "इत्येवं कथितं दुर्गे राधिकाख्यानमुत्तमम् ।\nसम्पत्करं पापहरं पुत्रपौत्रविवर्धनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003002056, "chapter_id": 23002, "verse_number": "२-४९-५७", "content_sanskrit": "श्रीकृष्णश्च द्विधारूपो द्विभुजश्च चतुर्भुजः ।\nचतुर्भुजश्च वैकुण्ठे गोलोके द्विभुजः स्वयम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003002057, "chapter_id": 23002, "verse_number": "२-४९-५८", "content_sanskrit": "चतुर्भुजस्य पत्नी च महालक्ष्मीः सरस्वती ।\nगंगा च तुलसी चैव देव्यो नारायणप्रियाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003002058, "chapter_id": 23002, "verse_number": "२-४९-५९", "content_sanskrit": "श्रीकृष्णपत्नी सा राधा तदर्द्धाङ्गसमुद्भवा ।\nतेजसा वयसा साध्वी रूपेण च गुणेन च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003002059, "chapter_id": 23002, "verse_number": "२-४९-६०", "content_sanskrit": "आदौ राधां समुच्चार्य पश्चात्कृष्णं वदेद्बुधः ।\nव्यतिक्रमे ब्रह्महत्यां लभते नात्र संशयः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003002060, "chapter_id": 23002, "verse_number": "२-४९-६१", "content_sanskrit": "कार्त्तिकीपूर्णिमायां च गोलोके रासमण्डले ।\nचकार पूजां राधायास्तत्सम्बन्धिमहोत्सवम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003002061, "chapter_id": 23002, "verse_number": "२-४९-६२", "content_sanskrit": "सद्रत्नघुटिकायाश्च कृत्वा तत्कवचं हरिः ।\nदधार कण्ठे बाहौ च दक्षिणे सह गोपकैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003002062, "chapter_id": 23002, "verse_number": "२-४९-६३", "content_sanskrit": "कृत्वा ध्यानं च भक्त्या च स्तोत्रमेतच्चकार सः ।\nराधाचर्वितताम्बूलं चखाद मधुसूदनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003002063, "chapter_id": 23002, "verse_number": "२-४९-६४", "content_sanskrit": "राधा पूज्या च कृष्णस्य तत्पूज्यो भगवान्प्रभुः ।\nपरस्पराभीष्टदेवे भेदकृन्नरकं व्रजेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003002064, "chapter_id": 23002, "verse_number": "२-४९-६५", "content_sanskrit": "द्वितीये पूजिता सा च धर्मेण ब्रह्मणा मया ।\nअनन्तवासुकिभ्यां च रविणा शशिना पुरा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003002065, "chapter_id": 23002, "verse_number": "२-४९-६६", "content_sanskrit": "महेन्द्रेण च रुद्रैश्च मनुना मानवेन च ।\nसुरेन्द्रैश्च मुनीन्द्रैश्च सर्वविश्वैश्च पूजिता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003002066, "chapter_id": 23002, "verse_number": "२-४९-६७", "content_sanskrit": "तृतीये पूजिता सा च सप्तद्वीपेश्वरेण च ।\nभारते च सुयज्ञेन पुत्रैर्मित्रैर्मुदाऽन्वितैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003002067, "chapter_id": 23002, "verse_number": "२-४९-६८", "content_sanskrit": "ब्राह्मणेनाभिशप्तेन देवदोषेण भूभृता ।\nव्याधिग्रस्तेन हस्तेन दुःखिना च विदूयता ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003002068, "chapter_id": 23002, "verse_number": "२-४९-६९", "content_sanskrit": "संप्राप राज्यं भ्रष्टश्रीः स च राधावरेण च ।\nस्तोत्रेण ब्रह्मदत्तेन स्तुत्वा च परमेश्वरीम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003002069, "chapter_id": 23002, "verse_number": "२-४९-७०", "content_sanskrit": "अभेद्यं कवचं तस्याः कण्ठे बाहौ दधार सः ।\nध्यात्वा चकार पूजां च पुष्करे शतवत्सरान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003002070, "chapter_id": 23002, "verse_number": "२-४९-७१", "content_sanskrit": "अन्ते जगाम गोलोकं रत्नयानेन भूमिपः ।\nइति ते कथितं सर्वं किं भूयः श्रोतुमिच्छसि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]