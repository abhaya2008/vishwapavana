[{"id": 50009079, "chapter_id": 11414, "verse_number": "1", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50009080, "chapter_id": 11414, "verse_number": "2", "content_sanskrit": "प्रकृतिस्थोऽपि पुरुषो नाज्यते प्रकृतेर्गुणैः। अविकारादकर्तृत्वान्निर्गुणत्वाज्जलार्कवत्॥ ३/२८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50009081, "chapter_id": 11414, "verse_number": "3", "content_sanskrit": "स एष यर्हि प्रकृतेर्गुणेष्वभिविषज्जते। अहङ्कारविमूढात्मा कर्तास्मीत्यभिमन्यते॥ ३/२८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50009082, "chapter_id": 11414, "verse_number": "4", "content_sanskrit": "तेन संसारपदवीं मनसाऽभ्येत्यनिर्वृतः। प्रासङ्गिकैः कर्मदोषैः सदसन्मिश्रयोनिषु॥ ३/२८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50009083, "chapter_id": 11414, "verse_number": "5", "content_sanskrit": "अर्थे ह्यविद्यमानेऽपि संसृतिर्न निवर्तते। ध्यायतो विषयानस्य स्वप्नेऽनर्थागमो यथा॥ ३/२८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50009084, "chapter_id": 11414, "verse_number": "6", "content_sanskrit": "प्रबुद्ध्य स्वप्नसुप्तिभ्यां संस्मरन्नात्मवैशसम्। वैतथ्यं व्यभिचारं च नासौ ध्यायेद् यतो भयम्॥ ३/२८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50009085, "chapter_id": 11414, "verse_number": "7", "content_sanskrit": "अत एव शनैश्चित्तं प्रसक्तमसतां पथि। भक्तियोगेन तीव्रेण विरक्त्याऽऽत्मवशं नयेत्॥ ३/२८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50009086, "chapter_id": 11414, "verse_number": "8", "content_sanskrit": "यमादिभिर्योगपथैरभ्यसञ्छ्रद्धयाऽन्वितः। मयि भावेन सत्येन मत्कथाश्रवणेन च॥ ३/२८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50009087, "chapter_id": 11414, "verse_number": "9", "content_sanskrit": "सर्वभूतसमत्वेन निर्वैरेणाप्रसङ्गतः। ब्रह्मचर्येण मौनेन स्वधर्मेण महीयसा॥ ३/२८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50009088, "chapter_id": 11414, "verse_number": "10", "content_sanskrit": "यदृच्छयोपलब्धेन सन्तुष्टो मितभुङ् मुनिः। विविक्तशरणः शान्तो मैत्रः करुण आत्मवान्॥ ३/२८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50009089, "chapter_id": 11414, "verse_number": "11", "content_sanskrit": "सानुबन्धे च देहेऽस्मिन्नकुर्वन्नसदाग्रहम्। ज्ञानेन दृष्टतत्त्वेन प्रकृतेः पुरुषस्य च॥ ३/२८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50009090, "chapter_id": 11414, "verse_number": "12", "content_sanskrit": "निवृत्तबुद्ध्यवाक्स्थानो दूरीभूतान्यदर्शनः। उपलभ्यात्मनाऽऽत्मानं चक्षुषेवार्कमेकदृक्॥ ३/२८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50009091, "chapter_id": 11414, "verse_number": "13", "content_sanskrit": "मुक्तलिङ्गः सदाभासमसति प्रतिपद्यते। सतो बन्धुं समं चक्षुः सर्वानुस्यूतमद्वयम्॥३/२८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50009092, "chapter_id": 11414, "verse_number": "14", "content_sanskrit": "यथा जलस्थ आभासः स्थलस्थेनाथ दृश्यते। स्वाभासेन यथा सूर्यो जलस्थेन दिवि स्थितः॥ ३/२८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50009093, "chapter_id": 11414, "verse_number": "15", "content_sanskrit": "एवं त्रिवृदहङ्कारो भूतेन्द्रियमनोगुणैः। स्वाभासैर्लक्षितोऽनेन सदाभासेन सत्यदृक्॥ ३/२८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50009094, "chapter_id": 11414, "verse_number": "16", "content_sanskrit": "भूतसूक्ष्मेन्द्रियमनोबुद्ध्यादिष्विह निद्रया। लीनेषु सत्सु यस्तत्र विनिद्रो निरहङ्क्रियः॥ ३/२८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50009095, "chapter_id": 11414, "verse_number": "17", "content_sanskrit": "मन्यमानस्तदाऽऽत्मानमनष्टो नष्टवन्मृषा। नष्टेऽहङ्करणे द्रष्टा नष्टवित्त इवातुरः॥ ३/२८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50009096, "chapter_id": 11414, "verse_number": "18", "content_sanskrit": "एवं प्रत्यवमृश्यासावात्मानं प्रतिपद्यते। साहङ्कारस्य द्रव्यस्य योऽवस्थानमनुग्रहः॥ ३/२८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50009097, "chapter_id": 11414, "verse_number": "19", "content_sanskrit": "देवहूतिरुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50009098, "chapter_id": 11414, "verse_number": "20", "content_sanskrit": "पुरुषं प्रकृतिर्ब्रह्मन् न विमुञ्चति कर्हिचित्। अन्योन्यापाश्रयत्वाच्च नित्यत्वादनयोः प्रभो॥ ३/२८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50009099, "chapter_id": 11414, "verse_number": "21", "content_sanskrit": "यथा गन्धस्य भूमेश्च न भावो व्यतिरेकतः। अपां रसस्य च यथा तथा बुद्धेः परस्य च॥ ३/२८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50009100, "chapter_id": 11414, "verse_number": "22", "content_sanskrit": "अकर्तुः कर्मबन्धोऽयं पुरुषस्य यदाश्रयः। गुणेषु सत्सु प्रकृतेः कैवल्यं तेष्वतः कथम्॥ ३/२८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50009101, "chapter_id": 11414, "verse_number": "23", "content_sanskrit": "सकृत् तत्त्वावमर्शेन निवृत्तं भयमुद्बणम्। अनिवृत्तनिमित्तत्त्वात् पुनः प्रत्यवतिष्ठते॥ ३/२८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50009102, "chapter_id": 11414, "verse_number": "24", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50009103, "chapter_id": 11414, "verse_number": "25", "content_sanskrit": "अनिमित्तप्रवृत्तेन स्वधर्मेणामलात्मना। तीव्रया मयि भक्त्या च श्रुतिसम्भृतया चिरम्॥ ३/२८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50009104, "chapter_id": 11414, "verse_number": "26", "content_sanskrit": "दृष्टतत्त्वेन ज्ञानेन वैराग्येण बलीयसा। तपोयुक्तेन योगेन तीव्रेणात्मसमाधिना॥ ३/२८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50009105, "chapter_id": 11414, "verse_number": "27", "content_sanskrit": "प्रकृतिः पुरुषस्यैवं दह्यमाना त्वहर्निशम्। तिरोभवित्री शनकैरग्नेर्योनिरिवारणिः॥ ३/२८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50009106, "chapter_id": 11414, "verse_number": "28", "content_sanskrit": "भुक्तभोगा परित्यक्ता दृष्टदोषा च नित्यशः। नेश्वरस्याशुभं धत्ते स्वे महिम्नि स्थितस्य च॥ ३/२८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50009107, "chapter_id": 11414, "verse_number": "29", "content_sanskrit": "यथा ह्यप्रतिबुद्धस्य प्रस्वापो बह्वनर्थकृत्। स एव प्रतिबुद्धस्य न वै मोहाय कल्पते॥ ३/२८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50009108, "chapter_id": 11414, "verse_number": "30", "content_sanskrit": "एवं विदिततत्त्वस्य प्रकृतिर्मयि मानसम्। युञ्जतो नापकुरुते आत्मारामस्य कर्हिचित्॥ ३/२८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50009109, "chapter_id": 11414, "verse_number": "31", "content_sanskrit": "यदैवमध्यात्मरतः कालेन बहुजन्मना। सर्वत्र जातवैराग्य आब्रह्मभवनान्मुनिः॥ ३/२८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50009110, "chapter_id": 11414, "verse_number": "32", "content_sanskrit": "मद्भक्तः प्रतिबुद्धार्थो मत्प्रसादेन भूयसा। निःश्रेयसं स्वसंस्थानं कैवल्याख्यं मदाश्रयम्॥ ३/२८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50009111, "chapter_id": 11414, "verse_number": "33", "content_sanskrit": "प्राप्नोतीहाञ्जसा धीरः स्वदृशा च्छिन्नसंशयः। यद् गत्वा न निवर्तेत योगी लिङ्गविनिर्गमे॥ ३/२८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50009112, "chapter_id": 11414, "verse_number": "34", "content_sanskrit": "यदा न योगोपचितासु चेतो मायासु सिद्धस्य विषज्जते च। अनन्यहेतुष्वथ मे गतिः स्यादात्यन्तिका यत्र न मृत्युहासः॥ ३/२८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50009113, "chapter_id": 11414, "verse_number": "35", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्धे अष्टाविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]