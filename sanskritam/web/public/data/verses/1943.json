[{"id": 2042309, "chapter_id": 1943, "verse_number": "५-१८८-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042310, "chapter_id": 1943, "verse_number": "५-१८८-१", "content_sanskrit": "कथं शिखण्डी गाङ्गेय कन्यां भूत्वा पुरा तदा।\nपुरुषोऽभूद्युधिश्रेष्ठ तन्मे ब्रूहि पितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042311, "chapter_id": 1943, "verse_number": "५-१८८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042312, "chapter_id": 1943, "verse_number": "५-१८८-२", "content_sanskrit": "भार्या तु तस्य राजेन्द्र द्रुपदस्य महीपतेः।\nमहिषी दयिता ह्यासीदपुत्रा च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042313, "chapter_id": 1943, "verse_number": "५-१८८-३", "content_sanskrit": "एतस्मिन्नेव काले तु द्रुपदो वै महीपतिः।\nअपत्यार्थे महाराज तोषयामास शङ्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042314, "chapter_id": 1943, "verse_number": "५-१८८-४", "content_sanskrit": "अस्माद्वधार्थं निश्चित्य तपो घोरं समास्थितः।\nऋते कन्यां महादेव पुत्रो मेस्यादिति ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042315, "chapter_id": 1943, "verse_number": "५-१८८-५", "content_sanskrit": "भगवन्पुत्रमिच्छामि भीष्मं प्रतिचिकीर्षया ।\nइत्युक्तो देवदेवेन स्त्रीपुमांस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042316, "chapter_id": 1943, "verse_number": "५-१८८-६", "content_sanskrit": "निवर्तस्व महीपाल नैतञ्जात्वन्यथा भवेत् ।\nस तु गत्वा च नगरं भार्यामिदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042317, "chapter_id": 1943, "verse_number": "५-१८८-७", "content_sanskrit": "कृतो यत्नो महादेवस्तपसाऽऽराधितो मया ।\nकन्या भूत्वा पुमान्भावी इति चोक्तोस्मि शंभुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042318, "chapter_id": 1943, "verse_number": "५-१८८-८", "content_sanskrit": "पुनः पुनर्याच्यमानो दिष्टमित्यब्रवीच्छिवः ।\nनतदन्यच्च भविता भवितव्यं हि तत्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042319, "chapter_id": 1943, "verse_number": "५-१८८-९", "content_sanskrit": "ततः सा नियता भूत्वा ऋतुकाले मनस्विनी ।\nपत्नी द्रुपदराजस्य द्रुपदं प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042320, "chapter_id": 1943, "verse_number": "५-१८८-१०", "content_sanskrit": "लेभे गर्भं यथाकालं विधिदृष्टेन कर्मणा ।\nपार्षतस्य महीपाल यथा मां नारदोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042321, "chapter_id": 1943, "verse_number": "५-१८८-११", "content_sanskrit": "ततो दधार सा देवी गर्भं राजीवलोचना ।\nतां स राजा प्रियां भार्यां द्रुपदः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042322, "chapter_id": 1943, "verse_number": "५-१८८-१२", "content_sanskrit": "पुत्रस्नेहान्महाबाहुः मुखं पर्यचरत्तदा ।\nसर्वानभिप्रायकृतान्भार्याऽलभत कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042323, "chapter_id": 1943, "verse_number": "५-१८८-१३", "content_sanskrit": "अपुत्रस्य सतो राज्ञो द्रुपदस्य महीपतेः ।\nयथाकालं तु सा देवी महिषी द्रुपदस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042324, "chapter_id": 1943, "verse_number": "५-१८८-१४", "content_sanskrit": "कन्यां प्रवररूपां तु प्राजायत नराधिप ।\nअपुत्रस्य तु राज्ञः सा द्रुपदस्य मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042325, "chapter_id": 1943, "verse_number": "५-१८८-१५", "content_sanskrit": "ख्यापयामास राजेन्द्र पुत्रो ह्येष ममेति वै।\nततः स राजा द्रुपद प्रच्छन्नाया नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042326, "chapter_id": 1943, "verse_number": "५-१८८-१६", "content_sanskrit": "पुत्रवत्पुत्रकार्याणि सर्वाणि समकारयत् ।\nरक्षणं चैव मन्त्रस्य महिषी द्रुपदस्य सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042327, "chapter_id": 1943, "verse_number": "५-१८८-१७", "content_sanskrit": "चकार सर्वयत्नेन ब्रुवणा पुत्र इत्युत ।\nन च तां वेदक नगरे कश्चिदन्यत्र पार्षतात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042328, "chapter_id": 1943, "verse_number": "५-१८८-१८", "content_sanskrit": "श्रद्दधानो हि तद्वाक्यं देवस्याच्युततेजसः।\nछादयामास तां कन्यां पुमानिति च सोब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042329, "chapter_id": 1943, "verse_number": "५-१८८-१९", "content_sanskrit": "जातकर्माणि सर्वाणि कारयामास पार्थिवः।\nपुंवद्विधानयुक्तानि शिखण्डीति च तां विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042330, "chapter_id": 1943, "verse_number": "५-१८८-२०", "content_sanskrit": "अहमेकस्तु चारेण वचनान्नारदस्य च।\nज्ञातवान्देववाक्येन अम्बायास्तपसा तथा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042331, "chapter_id": 1943, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि अष्टाशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]