[{"id": 7001150000, "chapter_id": 21150, "verse_number": "२-२-४१-१", "content_sanskrit": "विष्ण्वादय ऊचुः ।\nदेवदेव महादेव लौकिकाचारकृत्प्रभो ।\nब्रह्म त्वामीश्वरं शंभुं जानीमः कृपया तव॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001150001, "chapter_id": 21150, "verse_number": "२-२-४१-२", "content_sanskrit": "किं मोहयसि नस्तात मायया परया तव ।\nदुर्ज्ञेयया सदा पुंसां मोहिन्या परमेश्वर॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001150002, "chapter_id": 21150, "verse_number": "२-२-४१-३", "content_sanskrit": "प्रकृतः पुरुषस्यापि जगतो योनिबीजयोः ।\nपरब्रह्म परस्त्वं च मनोवाचामगोचरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001150003, "chapter_id": 21150, "verse_number": "२-२-४१-४", "content_sanskrit": "त्वमेव विश्वं सृजसि पास्यत्सि निजतंत्रतः ।\nस्वरूपां शिवशक्तिं हि क्रीडन्नूर्णपटो यथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001150004, "chapter_id": 21150, "verse_number": "२-२-४१-५", "content_sanskrit": "त्वमेव क्रतुमीशान ससर्जिथ दयापरः ।\nदक्षेण सूत्रेण विभो सदा त्रय्यभिपत्तये॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001150005, "chapter_id": 21150, "verse_number": "२-२-४१-६", "content_sanskrit": "त्वयैव लोकेवसितास्सेतवो यान् धृतव्रताः ।\nशुद्धान् श्रद्दधते विप्रा वेदमार्गविचक्षणाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001150006, "chapter_id": 21150, "verse_number": "२-२-४१-७", "content_sanskrit": "कर्तुस्त्वं मंगलानां हि स्वपरं तु मुखे विभो ।\nअमंगलानां च हितं मिश्रं वाथ विपर्ययम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001150007, "chapter_id": 21150, "verse_number": "२-२-४१-८", "content_sanskrit": "सर्वकर्मफलानां हि सदा दाता त्वमेव हि ।\nसर्वे हि प्रोक्ता हि यशस्तत्पतिस्त्वं श्रुतिश्रुतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001150008, "chapter_id": 21150, "verse_number": "२-२-४१-९", "content_sanskrit": "पृथग्धियः कर्मदृशोऽरुंतुदाश्च दुराशयाः ।\nवितुदंति परान्मूढा दुरुक्तैर्मत्सरान्विताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001150009, "chapter_id": 21150, "verse_number": "२-२-४१-१०", "content_sanskrit": "तेषां दैववधानां भो भूयात्त्वच्च वधो विभो ।\nभगवन्परमेशान कृपां कुरु परप्रभो॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001150010, "chapter_id": 21150, "verse_number": "२-२-४१-११", "content_sanskrit": "नमो रुद्राय शांताय ब्रह्मणे परमात्मने ।\nकपर्दिने महेशाय ज्योत्स्नाय महते नमः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001150011, "chapter_id": 21150, "verse_number": "२-२-४१-१२", "content_sanskrit": "त्वं हि विश्वसृजां स्रष्टा धाता त्वं प्रपितामहः ।\nत्रिगुणात्मा निर्गुणश्च प्रकृतेः पुरुषात्परः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001150012, "chapter_id": 21150, "verse_number": "२-२-४१-१३", "content_sanskrit": "नमस्ते नीलकंठाय वेधसे परमात्मने ।\nविश्वाय विश्वबीजाय जगदानंदहेतवे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001150013, "chapter_id": 21150, "verse_number": "२-२-४१-१४", "content_sanskrit": "ओंकारस्त्वं वषट्कारस्सर्वारंभप्रवर्तकः ।\nहंतकास्स्वधाकारो हव्यकव्यान्नभुक् सदा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001150014, "chapter_id": 21150, "verse_number": "२-२-४१-१५", "content_sanskrit": "कृतः कथं यज्ञभंगस्त्वया धर्मपरायण ।\nब्रह्मण्यस्त्वं महादेव कथं यज्ञहनो विभो॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001150015, "chapter_id": 21150, "verse_number": "२-२-४१-१६", "content_sanskrit": "ब्राह्मणानां गवां चैव धर्मस्य प्रतिपालकः ।\nशरण्योसि सदानंत्यः सर्वेषां प्राणिनां प्रभो॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001150016, "chapter_id": 21150, "verse_number": "२-२-४१-१७", "content_sanskrit": "नमस्ते भगवन् रुद्र भास्करामिततेजसे ।\nनमो भवाय देवाय रसायांबुमयाय ते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001150017, "chapter_id": 21150, "verse_number": "२-२-४१-१८", "content_sanskrit": "शर्वाय क्षितिरूपाय सदा सुरभिणे नमः ।\nरुद्रायाग्निस्वरूपाय महातेजस्विने नमः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001150018, "chapter_id": 21150, "verse_number": "२-२-४१-१९", "content_sanskrit": "ईशाय वायवे तुभ्यं संस्पर्शाय नमोनमः ।\nपशूनांपतये तुभ्यं यजमानाय वेधसे॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001150019, "chapter_id": 21150, "verse_number": "२-२-४१-२०", "content_sanskrit": "भीमाय व्योमरूपाय शब्दमात्राय ते नमः ।\nमहादेवाय सोमाय प्रवृत्ताय नमोस्तु ते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001150020, "chapter_id": 21150, "verse_number": "२-२-४१-२१", "content_sanskrit": "उग्राय सूर्यरूपाय नमस्ते कर्मयोगिने ।\nनमस्ते कालकालाय नमस्ते रुद्र मन्यवे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001150021, "chapter_id": 21150, "verse_number": "२-२-४१-२२", "content_sanskrit": "नमश्शिवाय भीमाय शंकराय शिवाय ते ।\nउग्रोसि सर्व भूतानां नियंता यच्छिवोसि नः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001150022, "chapter_id": 21150, "verse_number": "२-२-४१-२३", "content_sanskrit": "मयस्कराय विश्वाय ब्रह्मणे ह्यार्तिनाशिने ।\nअम्बिकापतये तुभ्यमुमायाः पतये नमः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001150023, "chapter_id": 21150, "verse_number": "२-२-४१-२४", "content_sanskrit": "शर्वाय सर्वरूपाय पुरुषाय परात्मने ।\nसदसद्व्यक्तिहीनाय महतः कारणाय ते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001150024, "chapter_id": 21150, "verse_number": "२-२-४१-२५", "content_sanskrit": "जाताय बहुधा लोके प्रभूताय नमोनमः ।\nनीलाय नीलरुद्राय कद्रुद्राय प्रचेतसे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001150025, "chapter_id": 21150, "verse_number": "२-२-४१-२६", "content_sanskrit": "मीढुष्टमाय देवाय शिपिविष्टाय ते नमः ।\nमहीयसे नमस्तुभ्यं हंत्रे देवारिणां सदा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001150026, "chapter_id": 21150, "verse_number": "२-२-४१-२७", "content_sanskrit": "ताराय च सुताराय तरुणाय सुतेजसे ।\nहरिकेशाय देवाय महेशाय नमोनमः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001150027, "chapter_id": 21150, "verse_number": "२-२-४१-२८", "content_sanskrit": "देवानां शंभवे तुभ्यं विभवे परमात्मने ।\nपरमाय नमस्तुभ्यं कालकंठाय ते नमः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001150028, "chapter_id": 21150, "verse_number": "२-२-४१-२९", "content_sanskrit": "हिरण्याय परेशाय हिरण्यवपुषे नमः ।\nभीमाय भीमरूपाय भीमकर्मरताय च॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001150029, "chapter_id": 21150, "verse_number": "२-२-४१-३०", "content_sanskrit": "भस्मदिग्धशरीराय रुद्राक्षाभरणाय च ।\nनमो ह्रस्वाय दीर्घाय वामनाय नमोस्तु ते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001150030, "chapter_id": 21150, "verse_number": "२-२-४१-३१", "content_sanskrit": "दूरेवधाय ते देवा ग्रेवधाय नमोनमः ।\nधन्विने शूलिने तुभ्यं गदिने हलिने नमः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001150031, "chapter_id": 21150, "verse_number": "२-२-४१-३२", "content_sanskrit": "नानायुधधरायैव दैत्यदानवनाशिने ।\nसद्याय सद्यरूपाय सद्योजाताय वै नमः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001150032, "chapter_id": 21150, "verse_number": "२-२-४१-३३", "content_sanskrit": "वामाय वामरूपाय वामनेत्राय ते नमः ।\nअघोराय परेशाय विकटाय नमोनमः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001150033, "chapter_id": 21150, "verse_number": "२-२-४१-३४", "content_sanskrit": "तत्पुरुषाय नाथाय पुराणपुरुषाय च ।\nपुरुषार्थप्रदानाय व्रतिने परमेष्ठिने॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001150034, "chapter_id": 21150, "verse_number": "२-२-४१-३५", "content_sanskrit": "ईशानाय नमस्तुभ्यमीश्वराय नमो नमः ।\nब्रह्मणे ब्रह्मरूपाय नमस्साक्षात्परात्मने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001150035, "chapter_id": 21150, "verse_number": "२-२-४१-३६", "content_sanskrit": "उग्रोसि सर्वदुष्टानां नियंतासि शिवोसि नः ।\nकालकूटाशिने तुभ्यं देवाद्यवन कारिणे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001150036, "chapter_id": 21150, "verse_number": "२-२-४१-३७", "content_sanskrit": "वीराय वीरभद्राय रक्षद्वीराय शूलिने ।\nमहादेवाय महते पशूनां पतये नमः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001150037, "chapter_id": 21150, "verse_number": "२-२-४१-३८", "content_sanskrit": "वीरात्मने सुविद्याय श्रीकंठाय पिनाकिने ।\nनमोनंताय सूक्ष्माय नमस्ते मृत्युमन्यवे॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001150038, "chapter_id": 21150, "verse_number": "२-२-४१-३९", "content_sanskrit": "पराय परमेशाय परात्परतराय ते ।\nपरात्पराय विभवे नमस्ते विश्वमूर्तये॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001150039, "chapter_id": 21150, "verse_number": "२-२-४१-४०", "content_sanskrit": "नमो विष्णुकलत्राय विष्णुक्षेत्राय भानवे ।\nभैरवाय शरण्याय त्र्यंबकाय विहारिणे॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001150040, "chapter_id": 21150, "verse_number": "२-२-४१-४१", "content_sanskrit": "मृत्युंजयाय शोकाय त्रिगुणाय गुणात्मने ।\nचन्द्रसूर्याग्निनेत्राय सर्वकारणसेतवे॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001150041, "chapter_id": 21150, "verse_number": "२-२-४१-४२", "content_sanskrit": "भवता हि जगत्सर्वं व्याप्तं स्वेनैव तेजसा ।\nपरब्रह्म निर्विकारी चिदानंदःप्रकाशवान्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001150042, "chapter_id": 21150, "verse_number": "२-२-४१-४३", "content_sanskrit": "ब्रह्मविष्ण्विंद्रचन्द्रादिप्रमुखास्सकलास्सुराः ।\nमुनयश्चापरे त्वत्तस्संप्रसूता महेश्वर॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001150043, "chapter_id": 21150, "verse_number": "२-२-४१-४४", "content_sanskrit": "यतो बिभर्षि सकलं विभज्य तनुमष्टधा ।\nअष्टमूर्तिरितीशश्च त्वमाद्यः करुणामयः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001150044, "chapter_id": 21150, "verse_number": "२-२-४१-४५", "content_sanskrit": "त्वद्भयाद्वाति वातोयं दहत्यग्निर्भयात्तव ।\nसूर्यस्तपति ते भीत्या मृत्युर्धावति सर्वतः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001150045, "chapter_id": 21150, "verse_number": "२-२-४१-४६", "content_sanskrit": "दयासिन्धो महेशान प्रसीद परमेश्वर ।\nरक्ष रक्ष सदैवास्मान् यस्मान्नष्टान् विचेतसः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001150046, "chapter_id": 21150, "verse_number": "२-२-४१-४७", "content_sanskrit": "रक्षिताः सततं नाथ त्वयैव करुणानिधे ।\nनानापद्भ्यो वयं शंभो तथैवाद्य प्रपाहि नः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001150047, "chapter_id": 21150, "verse_number": "२-२-४१-४८", "content_sanskrit": "यज्ञस्योद्धरणं नाथ कुरु शीघ्रं प्रसादकृत् ।\nअसमाप्तस्य दुर्गेश दक्षस्य च प्रजापतेः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001150048, "chapter_id": 21150, "verse_number": "२-२-४१-४९", "content_sanskrit": "भगोक्षिणी प्रपद्येत यजमानश्च जीवतु ।\nपूष्णो दंताश्च रोहंतु भृगोः श्मश्रूणि पूर्ववत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001150049, "chapter_id": 21150, "verse_number": "२-२-४१-५०", "content_sanskrit": "भवतानुग्रहीतानां देवादीनांश्च सर्वशः ।\nआरोग्यं भग्नगात्राणां शंकर त्वायुधाश्मभिः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001150050, "chapter_id": 21150, "verse_number": "२-२-४१-५१", "content_sanskrit": "पूर्णभागोस्तु ते नाथावशिष्टेऽध्वरकर्मणि ।\nरुद्रभागेन यज्ञस्ते कल्पितो नान्यथा क्वचित्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001150051, "chapter_id": 21150, "verse_number": "२-२-४१-५२", "content_sanskrit": "इत्युक्त्वा सप्रजेशश्च रमेशश्च कृतांजलिः ।\nदंडवत्पतितो भूमौ क्षमापयितुमुद्यतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]