[{"id": 7003253000, "chapter_id": 23253, "verse_number": "१-५६-१", "content_sanskrit": "सूत उवाच  ।\nवीथ्याश्रयाणि चरति नक्षत्राणि निशाकरः  ।\nत्रिचक्रोभयतोश्वश्च विज्ञेयस्तस्य वै रथः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003253001, "chapter_id": 23253, "verse_number": "१-५६-२", "content_sanskrit": "शतारैश्च त्रिभिश्चक्रैर्युक्तः शुक्लैर्हयोत्तमैः  ।\nदशभिस्त्वकृशैर्दिवव्यैरसंगैस्तैर्मनोजवैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003253002, "chapter_id": 23253, "verse_number": "१-५६-३", "content_sanskrit": "रथेनानेन देवैस्च पितृभिश्चैव गच्छति  ।\nसोमो ह्यम्बुमयै र्गौभिः शुक्लैः शुक्लगभस्तिमान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003253003, "chapter_id": 23253, "verse_number": "१-५६-४", "content_sanskrit": "क्रमते शुक्लपक्षादौ भास्करात्परमास्थितः  ।\nआपूर्यते परस्यांतः सततं दिवसक्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003253004, "chapter_id": 23253, "verse_number": "१-५६-५", "content_sanskrit": "देवैः पीतं क्षये सोममाप्याययति नित्यशः  ।\nपीतं पञ्चदशाहं तु रश्मिनैकेन भास्करः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003253005, "chapter_id": 23253, "verse_number": "१-५६-६", "content_sanskrit": "आपूरयन् सुषुम्नेन भागंभागमनुक्रमात्  ।\nइत्येषा सूर्यवीर्येण चंद्रस्याप्यायिता तनुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003253006, "chapter_id": 23253, "verse_number": "१-५६-७", "content_sanskrit": "स पौर्ममास्यां दृश्येत शुक्लः संपूर्णमंडलः  ।\nएवमाप्यायितं सोमं शुक्लपक्षे दिनक्रमात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003253007, "chapter_id": 23253, "verse_number": "१-५६-८", "content_sanskrit": "ततो द्वितीयाप्रभृति बहुलस्य चतुर्दशीम्  ।\nपिबंत्यम्बुमयं देवा मधु सौम्यं सुधामृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003253008, "chapter_id": 23253, "verse_number": "१-५६-९", "content_sanskrit": "संभृतं त्वर्धमासेन ह्यमृतं सूर्यतेजसा  ।\nपानार्थममृतं सोमं पौर्णमास्यामुपासते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003253009, "chapter_id": 23253, "verse_number": "१-५६-१०", "content_sanskrit": "एकरात्रिं सुराः सर्वे पितृभिस्त्वृषिभिः सह  ।\nसोमस्य कृष्णपक्षादौ भास्कराभिमुखस्य च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003253010, "chapter_id": 23253, "verse_number": "१-५६-११", "content_sanskrit": "प्रक्षीयंते परस्यांतः पीयमानाः कलाः क्रमात्  ।\nत्रयस्त्रिंशच्छताश्चैव त्रयस्त्रिंशत्तथैव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003253011, "chapter_id": 23253, "verse_number": "१-५६-१२", "content_sanskrit": "त्रयस्त्रिंशत्सहस्राणि देवाः सोमं पिबंति वै  ।\nएवं दिनक्रमात्पीते विबुधैस्तु निशाकरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003253012, "chapter_id": 23253, "verse_number": "१-५६-१३", "content_sanskrit": "पीत्वार्धमासं गच्छन्ति अमावास्यां सुरोत्तमाः  ।\nपितरश्चोपतिष्ठंति अमावास्यां निशाकरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003253013, "chapter_id": 23253, "verse_number": "१-५६-१४", "content_sanskrit": "ततः पंचदशे भागे किंचिच्चिष्टे कलात्मके  ।\nअपराह्णे पितृगणा जघन्यं पर्युपासते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003253014, "chapter_id": 23253, "verse_number": "१-५६-१५", "content_sanskrit": "पिबंति द्विकलं कालं शिष्टा तस्य कला तु या  ।\nनिस्सृतं तदमावास्यां गभस्तिभ्यः स्वधामृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003253015, "chapter_id": 23253, "verse_number": "१-५६-१६", "content_sanskrit": "मासतृप्तिमवाप्याग्र्यां पीत्वा गच्छंति तेऽमृतम्  ।\nपितृभिः पीयमानस्य पंचदश्यां कला तु या ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003253016, "chapter_id": 23253, "verse_number": "१-५६-१७", "content_sanskrit": "यावत्तु क्षीयते तस्य भागः पंचदशस्तु सः  ।\nअमावास्यां ततस्तस्या अंतरा पूर्यते पुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003253017, "chapter_id": 23253, "verse_number": "१-५६-१८", "content_sanskrit": "वृद्धिक्षयौ वै पक्षादौ षोडश्यां शशिनः स्मृतौ  ।\nएवं सूर्यनिमित्तैषा पक्षवृद्धिर्निशाकरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]