[{"id": 2035580, "chapter_id": 1770, "verse_number": "५-१५-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035581, "chapter_id": 1770, "verse_number": "५-१५-१", "content_sanskrit": "एवमुक्तः स भगवाञ्शच्या तां पुनरब्रवीत्।\nविक्रमस्य न कालोऽयं नहुषो बलवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035582, "chapter_id": 1770, "verse_number": "५-१५-२", "content_sanskrit": "विवर्द्धितश्च ऋषिभिर्हव्यकव्यैश्च भामिनि ।\nनीतिमत्र विधास्यामि देवि तां कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035583, "chapter_id": 1770, "verse_number": "५-१५-३", "content_sanskrit": "गुह्यं चैतत्त्वया कार्यं नाख्यातव्यं शुभे क्वचित् ।\nगत्वा नहुषमेकान्ते ब्रवीहि च सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035584, "chapter_id": 1770, "verse_number": "५-१५-४", "content_sanskrit": "ऋषियानेन दिव्येन मामुपैहि जगत्पते ।\nएवं तव वशे प्रीता भविष्यामीति तं वद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035585, "chapter_id": 1770, "verse_number": "५-१५-५", "content_sanskrit": "इत्युक्ता देवराजेन पत्नी सा कमलेक्षणा ।\nएवमस्त्वित्यथोक्त्वा तु जगाम नहुषं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035586, "chapter_id": 1770, "verse_number": "५-१५-६", "content_sanskrit": "नहुषस्तां ततो दृष्ट्वा सस्मितो वाक्यमब्रवीत् ।\nस्वागतं ते वरारोहे किं करोमि शुचिस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035587, "chapter_id": 1770, "verse_number": "५-१५-७", "content_sanskrit": "भक्तं मां भज कल्याणि किमिच्छसि मनस्विनि ।\nतव कल्याणि यत्कार्यं तत्करिष्ये सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035588, "chapter_id": 1770, "verse_number": "५-१५-८", "content_sanskrit": "न च व्रीडा त्वया कार्या सुश्रोणि मयि विश्वसेः।\nसत्येन वै पशे देवि करिष्ये वचनं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035589, "chapter_id": 1770, "verse_number": "५-१५-९x", "content_sanskrit": "इन्द्राण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035590, "chapter_id": 1770, "verse_number": "५-१५-९", "content_sanskrit": "यो मे कृतस्त्वया कालस्तमाकाङ्क्षे जगत्पते।\nततस्त्वमेव भर्ता मे भविष्यसि सुराधिम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035591, "chapter_id": 1770, "verse_number": "५-१५-१०", "content_sanskrit": "कार्यं च हृदि मे यत्तद्देवराजावधारय।\nवक्ष्यामि यदि मे राजन्प्रियमेतत्करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035592, "chapter_id": 1770, "verse_number": "५-१५-११", "content_sanskrit": "वाक्यं प्रणयसंयुक्तं ततः स्यां वशगा तव।\nइन्द्रस्य वाजिनो वाहा हस्तिनोऽथ रथास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035593, "chapter_id": 1770, "verse_number": "५-१५-१२", "content_sanskrit": "इच्छाम्यहमथापूर्वं वाहनं ते सुराधिप ।\nयन्न विष्णोर्न रुद्रस्य न सुराणां न रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035594, "chapter_id": 1770, "verse_number": "५-१५-१३", "content_sanskrit": "वहन्तु त्वां महाभागा ऋषयः सङ्गता विभो।\nसर्वे शिबिकया राजन्नेतद्धि मम रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035595, "chapter_id": 1770, "verse_number": "५-१५-१४", "content_sanskrit": "नासुरेषु न देवेषु तुल्यो भवितुमर्हसि ।\nसर्वेषां तेज आदत्से स्वेन वीर्येण दर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035596, "chapter_id": 1770, "verse_number": "५-१५-१५", "content_sanskrit": "न ते प्रमुखतः स्थातुं कश्चिच्छक्नोति वीर्यवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035597, "chapter_id": 1770, "verse_number": "५-१५-१५x", "content_sanskrit": "शल्य उवाच।\nएवमुक्तस्तु नहुषः प्राहृष्यत तदा किल।\nउवाच वचनं चापि सुरेन्द्रस्तामनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035598, "chapter_id": 1770, "verse_number": "५-१५-१६x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035599, "chapter_id": 1770, "verse_number": "५-१५-१६", "content_sanskrit": "अपूर्वं वाहनमिदं त्वयोक्तं वरवर्णिनि।\nदृढं मे रुचिरं देवि त्वद्वशोऽस्मि वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035600, "chapter_id": 1770, "verse_number": "५-१५-१७", "content_sanskrit": "न ह्यल्पवीर्यो भवति यो वाहान्कुरुते मुनीन् ।\nअहं तपस्वी बलवान्भूतभव्यभवत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035601, "chapter_id": 1770, "verse_number": "५-१५-१८", "content_sanskrit": "मयि क्रुद्धे जगन्न स्यान्मयि सर्वं प्रतिष्ठितम्।\nदेवदानवगन्धर्वाः किन्नरोरगराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035602, "chapter_id": 1770, "verse_number": "५-१५-१९", "content_sanskrit": "न मे क्रुद्धस्य पर्याप्ताः सर्वे लोकाः शुचिस्मिते।\nचक्षुषा यं प्रपश्यामि तस्य तेजो हराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035603, "chapter_id": 1770, "verse_number": "५-१५-२०", "content_sanskrit": "` अहमिन्द्रोऽस्मि देवानां लोकानां च महेश्वरः।\nमयि हव्यं च कव्यं च लोकाश्चैव सनातनाः ।\nतस्मात्ते वचनं देवि करिष्यामि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035604, "chapter_id": 1770, "verse_number": "५-१५-२१", "content_sanskrit": "सप्तर्षयो मां वक्ष्यन्ति सर्वे ब्रह्मर्षयस्तथा ।\nपश्य माहात्म्ययोगं मे ऋद्धिं च वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035605, "chapter_id": 1770, "verse_number": "५-१५-२२x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035606, "chapter_id": 1770, "verse_number": "५-१५-२२", "content_sanskrit": "एवमुक्त्वा तु तां देवीं विसृज्य च वराननाम् । ५-१५-२२b` अथ संचिन्त्य नहुषो बलवीर्येण भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035607, "chapter_id": 1770, "verse_number": "५-१५-२३", "content_sanskrit": "विसृज्य सुप्रतीकं च नागमैरावतं तथा।\nहंसयुक्तं विमानं च हरियुक्तं तथा रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035608, "chapter_id": 1770, "verse_number": "५-१५-२४", "content_sanskrit": "स तु दर्पेण महता परिभूय महामुनीन्।\nविमाने योजयित्वा च ऋषीन्नियमामास्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035609, "chapter_id": 1770, "verse_number": "५-१५-२५", "content_sanskrit": "अब्रह्मण्यो बलोपेतो मत्तो मदबलेन च।\nकामवृत्तः स दुष्टात्मा वाहयामास तानृषीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035610, "chapter_id": 1770, "verse_number": "५-१५-२६", "content_sanskrit": "नहुषेण विसृष्टा च बृहस्पतिमथाब्रवीत्।\nसमयोऽल्पावशेषो मे नहुषेणेह यः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035611, "chapter_id": 1770, "verse_number": "५-१५-२७", "content_sanskrit": "शक्रं मृगय शीघ्रं त्वं भक्तायाः कुरु मे दयाम्।\nबाढमित्येव भगवान्बृहस्पतिरुवाच ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035612, "chapter_id": 1770, "verse_number": "५-१५-२८", "content_sanskrit": "न भेतव्यं त्वया देवि नहुषाद्दुष्टचेतसः ।\nन ह्येष स्थास्यति चिरं गत एष नराधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035613, "chapter_id": 1770, "verse_number": "५-१५-२९", "content_sanskrit": "अधर्मज्ञो महर्षीणां वाहनाच्च हतः शुभे ।\nइष्टिं चाहं करिष्यामि विनाशायास्य दुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035614, "chapter_id": 1770, "verse_number": "५-१५-३०", "content_sanskrit": "शक्रं चाधिगमिष्यामि माभैस्त्वं भद्रमस्तु ते।\nततः प्रज्वाल्य विधिवज्जुहाव परमं हविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035615, "chapter_id": 1770, "verse_number": "५-१५-३१", "content_sanskrit": "बृहस्पतिर्महातेजा देवराजोपलब्धये।\nहुत्वाऽग्निं सोब्रवीद्राजञ्छक्र अन्विष्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035616, "chapter_id": 1770, "verse_number": "५-१५-३२", "content_sanskrit": "तस्माच्च भगवान्देवः स्वयमेव हुताशनः ।\nस्त्रीवेषमद्भुतं कृत्वा तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035617, "chapter_id": 1770, "verse_number": "५-१५-३३", "content_sanskrit": "स दिशः प्रदिशश्चैव पर्वतांश्च वनानि च।\nपृथिवीं चान्तरिक्षं च विचित्याथ मनोगतिः।\nनिमेषान्तरमात्रेण बृहस्पतिमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035618, "chapter_id": 1770, "verse_number": "५-१५-३४x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035619, "chapter_id": 1770, "verse_number": "५-१५-३४", "content_sanskrit": "बृहस्पते न पश्यामि देवराजमिह क्वचित्।\nआपः शेषाः सदा चापः प्रवेष्टुं नोत्सहाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035620, "chapter_id": 1770, "verse_number": "५-१५-३५", "content_sanskrit": "न मे तत्र गतिर्ब्रह्मन्किमन्यत्करवाणि ते।\nतमब्रवीद्देवगुरुरपो विश महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2035621, "chapter_id": 1770, "verse_number": "५-१५-३६x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2035622, "chapter_id": 1770, "verse_number": "५-१५-३६", "content_sanskrit": "नापः प्रवेष्टुं शक्ष्यामि क्षयो मेऽत्र भविष्यति।\nशरणं त्वां प्रपन्नोऽस्मि स्वस्ति तेस्तु महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2035623, "chapter_id": 1770, "verse_number": "५-१५-३७", "content_sanskrit": "अद्य्भोऽग्निर्ब्रह्मतः क्षत्रमश्मनो लोहमुत्थितम् ।\nतेषां सर्वत्रगं तेजः स्वासु योनिषु शाम्यति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2035624, "chapter_id": 1770, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि पञ्चदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]