[{"id": 7002381000, "chapter_id": 22381, "verse_number": "१-४३-१", "content_sanskrit": "ब्रह्मोवाच ।\nकिं चान्यदपरं यूयं वेदमन्त्रविदो जनाः ।\nप्रष्टव्याः कस्य संस्कारे विशेषमुपगच्छत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002381001, "chapter_id": 22381, "verse_number": "१-४३-२", "content_sanskrit": "किं देहस्योत येनासौ निसर्गमलिनः स्थितः ।\nशुक्रशोणितसम्भूतः शमलोद्भवकीटवत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002381002, "chapter_id": 22381, "verse_number": "१-४३-३", "content_sanskrit": "निषेकादिश्मशानान्तैर्विविधैर्विधिविस्तरैः ।\nदेहिनोऽतिशयं केचिदुपगच्छन्ति मानवाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002381003, "chapter_id": 22381, "verse_number": "१-४३-४", "content_sanskrit": "तेषां गूढमनः कायवाग्विदुष्टैः सुचेष्टितैः ।\nअसंयतमनुष्याणां पक्षोऽयं दूष्यते मया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002381004, "chapter_id": 22381, "verse_number": "१-४३-५", "content_sanskrit": "वैदिकाखिलसंस्कारसारभूता द्विजातयः ।\nसर्वकार्यकरान्सर्वान्वृषलानतिशेरते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002381005, "chapter_id": 22381, "verse_number": "१-४३-६", "content_sanskrit": "चण्डकर्मा विकर्मस्थो ब्रह्महा गुरुतल्पगः ।\nस्तेनो गोघ्नः सुरापाणः परस्त्रीरमणप्रियः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002381006, "chapter_id": 22381, "verse_number": "१-४३-७", "content_sanskrit": "मिथ्यावादी मदोन्मत्तो नास्तिको वेदनिन्दकः ।\nग्रामयाजकनिर्ग्रन्थौ बहुदोषो दुरासदः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002381007, "chapter_id": 22381, "verse_number": "१-४३-८", "content_sanskrit": "नि१ षिद्धाचारसंसेवी चोरश्चाटो मदोद्धतः ।\nधूर्तो नटः शठः पापी सर्वाशी सर्वविक्रयी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002381008, "chapter_id": 22381, "verse_number": "१-४३-९", "content_sanskrit": "वाङ्मनः कायजैर्दुष्टैर्हता ये ब्राह्मणाधमाः ।\nते न शुद्धिं व्रजन्तीह अपि यज्ञशतैरपि२ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002381009, "chapter_id": 22381, "verse_number": "१-४३-१०", "content_sanskrit": "शूद्राणां यान्यनिष्टानि सम्पद्यन्ते स्वभावतः ।\nविप्राणामपि तान्येव निर्विघ्नानि भवन्ति न ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002381010, "chapter_id": 22381, "verse_number": "१-४३-११", "content_sanskrit": "तस्मान्मन्त्रोग्निहोत्रं वा वेद्यां पशुवधोऽपि वा ।\nहेतवो न हि विप्रत्वे शूद्रैः शक्या क्रिया यथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002381011, "chapter_id": 22381, "verse_number": "१-४३-१२", "content_sanskrit": "ये चापि कर्मबन्धेन बद्धाः सीदन्ति जन्तवः ।\nसंसारानलसन्तापविक्लवीकृतमानसाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002381012, "chapter_id": 22381, "verse_number": "१-४३-१३", "content_sanskrit": "ते जन्ममरणाटव्यां सुखामृतपिपासवः ।\nकृपणस्याश्रयेऽटन्तो लभन्ते नैव निर्वृतिम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002381013, "chapter_id": 22381, "verse_number": "१-४३-१४", "content_sanskrit": "चतुर्वर्णा नरा ये तु तत्तद्वीर्ये नराधमाः ।\nतेषां सर्वात्मना सर्वैर्धर्मैः साङ्कर्यमीक्ष्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002381014, "chapter_id": 22381, "verse_number": "१-४३-१५", "content_sanskrit": "शूद्रविप्रादयो योनौ न भिद्यन्ते परस्परम् ।\nसर्वधर्मसमानत्वात्संस्कारादि निरर्थकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002381015, "chapter_id": 22381, "verse_number": "१-४३-१६", "content_sanskrit": "तदनुष्ठानवैधर्म्यवियोगमरणादिभिः ।\nअसेव्यसेवनैरन्यैः शूद्रविप्रादयः समाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002381016, "chapter_id": 22381, "verse_number": "१-४३-१७", "content_sanskrit": "बुद्ध्या शक्त्या स्वभावेन धर्मैर्जात्या१ दिभिः श्रिया ।\nकर्तव्यैः पुण्यपापाभ्यां शनैः२ सर्वशरीरगैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002381017, "chapter_id": 22381, "verse_number": "१-४३-१८", "content_sanskrit": "बन्धनै रोधनैर्नानायातनोपायपीडनैः ।\nदण्डैरदण्डकरणैर्विषादपरिवेदनैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002381018, "chapter_id": 22381, "verse_number": "१-४३-१९", "content_sanskrit": "सात्त्विकः प्रतिधर्माद्यै राजसैश्चित्रवेष्टितैः ।\nतामसैस्तापमोहाद्यैर्दूयमानाः पुनः१ पुनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002381019, "chapter_id": 22381, "verse_number": "१-४३-२०", "content_sanskrit": "श्लेश्ममारुतपित्ताद्यैर्महाबीभत्सदर्शनैः ।\nक्वचिद्वृत्तिनिवृत्तिभ्याममृतानृतहिताहितैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002381020, "chapter_id": 22381, "verse_number": "१-४३-२१", "content_sanskrit": "अलङ्कारोपयोगेन मन्मथाद्यैर्विचेष्टितैः ।\nधनलाभाशयानैकजन्तुसङ्घातपातनैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002381021, "chapter_id": 22381, "verse_number": "१-४३-२२", "content_sanskrit": "अधिसिद्धिगतिं याति नानाविधमनोरथैः ।\nआत्मस्नेहपरद्वेषस्वीकृतद्रवरक्षणैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002381022, "chapter_id": 22381, "verse_number": "१-४३-२३", "content_sanskrit": "अतिक्षीबत्वसंक्षोभक्षुतक्षामक्षमामयैः ।\nयातनोपायपैशुन्यशून्यत्वोपशमैस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002381023, "chapter_id": 22381, "verse_number": "१-४३-२४", "content_sanskrit": "अप्रशस्तैरनुष्ठानैः समीपस्थापदः समाः ।\nहिंसकाः प्राणिनः पापवितथालापभाषिणः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002381024, "chapter_id": 22381, "verse_number": "१-४३-२५", "content_sanskrit": "साधूनांभाषकाः स्तेना निर्दयाः पारदारिकाः ।\nनीचकर्मसमाचाराः सर्वभक्षाः पिशाचवत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002381025, "chapter_id": 22381, "verse_number": "१-४३-२६", "content_sanskrit": "दुष्कुलीना दुराचारा नृपाणामुपजीविनः ।\nविप्रकार्या विकर्मस्था धनिनो दुष्टचेतसः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002381026, "chapter_id": 22381, "verse_number": "१-४३-२७", "content_sanskrit": "लुब्धका हरिणान्हत्वा वासं कृत्वा यथा वने ।\nतथा खादन्ति पिशुना बहवश्च३ क्रियावशात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002381027, "chapter_id": 22381, "verse_number": "१-४३-२८", "content_sanskrit": "वेदवादमधीयानाः१ प्राणिघाताभिशंसिनः ।\nपुष्णन्ति कपटैरर्थान्वेदविक्रयिणोऽधमाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002381028, "chapter_id": 22381, "verse_number": "१-४३-२९", "content_sanskrit": "मायिनो मत्सरग्रस्ता लुब्धा मुग्धा मदोद्धताः ।\nचाटाः कार्पटिकाः कूराः कदर्याः कलहप्रियाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002381029, "chapter_id": 22381, "verse_number": "१-४३-३०", "content_sanskrit": "वाचाटदुष्टकुलटा अटन्तो भाटकैः सह ।\nभण्डमान्या भटाटोपैः संक्रुद्धाः सुविलुण्ठकाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002381030, "chapter_id": 22381, "verse_number": "१-४३-३१", "content_sanskrit": "पर्यटा भाटका जीवाः कण्ठकश्लोकभाषिणः ।\nविक्रीणते ह्यविक्रेयमभक्ष्यद्रव्यभक्षिणः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002381031, "chapter_id": 22381, "verse_number": "१-४३-३२", "content_sanskrit": "शूद्रकर्मानुतिष्ठन्तो निस्तपास्ते नराधमाः ।\nसेवाध्यापनवाणिज्यकृष्याद्यारम्भलम्भिताः ।\nगृह्णन्तः सम्पदो बाहयाद्द्रव्यधान्यधनादिकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002381032, "chapter_id": 22381, "verse_number": "१-४३-३३", "content_sanskrit": "क्रोधादाभ्यन्तरान्दोषांस्तथा दुष्टमनोरथान् ।\nअत्यजन्तो विशिष्टानां श्रेष्ठास्ते कचमर्दिनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002381033, "chapter_id": 22381, "verse_number": "१-४३-३४", "content_sanskrit": "नोपदेयानि वस्त्राणि नित्यमाददते द्विजाः ।\nहापयन्ति न हेयानि कथं ते गुरवः क्षितौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002381034, "chapter_id": 22381, "verse_number": "१-४३-३५", "content_sanskrit": "दन्तिका दिण्डिका भण्डाश्चण्डाश्चण्डालचेष्टिता ।\nवैतण्डकास्ते निघ्नन्ति यथा सिंहो मृगान्पशून् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002381035, "chapter_id": 22381, "verse_number": "१-४३-३६", "content_sanskrit": "निर्ग्रन्थं मुनिमालोक्य मन्यमानाः समुन्नतम् ।\nपरिभूयावतिष्ठन्ते धिक्तान्रिक्तान्सवैरिणः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002381036, "chapter_id": 22381, "verse_number": "१-४३-३७", "content_sanskrit": "तस्मात्संसारिकाः सत्त्वाश्चित्तक्लेशकलङ्किताः ।\nदौःशील्यदौर्मनस्याद्यैस्तुल्यजातीयबन्धनात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002381037, "chapter_id": 22381, "verse_number": "१-४३-३८", "content_sanskrit": "शूद्रां प्ररोचते विप्रो रागिणीं मैथुनं प्रति ।\nसा कामदुःखविगमे गर्भं धत्ते समागमे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002381038, "chapter_id": 22381, "verse_number": "१-४३-३९", "content_sanskrit": "कामकामातुराभ्यस्तु रोचन्ते शूद्रमानवाः ।\nमैथुनं प्रति ब्राह्मण्ये तेऽपि तासां सुखावहाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002381039, "chapter_id": 22381, "verse_number": "१-४३-४०", "content_sanskrit": "ये तु जात्यादिभिर्भिन्ना गवाश्वोष्ट्मतङ्गजाः ।\nते विजातिषु नो गर्भं कुर्वतेऽपि सुखार्थिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002381040, "chapter_id": 22381, "verse_number": "१-४३-४१", "content_sanskrit": "अनड्वानेव गोरेव कामं पुष्णाति सङ्गमे ।\nघोटकाश्च रतिं सम्यक्कुर्वते वडवासु च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002381041, "chapter_id": 22381, "verse_number": "१-४३-४२", "content_sanskrit": "पतिं करभमेवाप्य करभी रमते मुदा ।\nगजमेव पतिं लब्ध्वा सुखं तिष्ठति हस्तिनी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002381042, "chapter_id": 22381, "verse_number": "१-४३-४३", "content_sanskrit": "तिर्यग्जातिः स्त्रिया साकं कुर्वाणाऽपि हि मैथुनम् ।\nन तस्याः कुरुते गर्भं नरो नापि सुखासिकाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002381043, "chapter_id": 22381, "verse_number": "१-४३-४४", "content_sanskrit": "तिरश्चा सह कुर्वाणा मैथुनं मनुजाङ्गना ।\nनाधत्ते तत्कृतं गर्भं न युक्तं मैथुनं तयोः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002381044, "chapter_id": 22381, "verse_number": "१-४३-४५", "content_sanskrit": "नैवं कश्चिद्विभागोस्ति मैथुने स्त्रीमनुष्ययोः ।\nयेन संक्षीयते भेदः प्रस्फुटं द्विजशूद्रयोः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002381045, "chapter_id": 22381, "verse_number": "१-४३-४६", "content_sanskrit": "वेदपाठच्छलेनायं न क्रियाभिः प्रपद्यते ।\nबहुभिर्जडसङ्घातैरविशिष्टे पदेऽहनि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002381046, "chapter_id": 22381, "verse_number": "१-४३-४७", "content_sanskrit": "देहे देहिनि चामुष्मिन्नशुचावनवस्थिते ।\nरागद्वेषादिभिर्दोषैरधिकं परिपीडिते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002381047, "chapter_id": 22381, "verse_number": "१-४३-४८", "content_sanskrit": "कुलालचक्रवद्भ्रान्तमानसे विषयार्णवे ।\nघोरदुःखभयाक्रान्ते समाजेऽनीश्वरात्मनि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002381048, "chapter_id": 22381, "verse_number": "१-४३-४९", "content_sanskrit": "जन्ममृत्युजराशोकानिष्टयोगाग्निपीडिते ।\nहीनसत्त्वशरीरादौ न विशेषो विभाव्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002381049, "chapter_id": 22381, "verse_number": "१-४३-५०", "content_sanskrit": "तस्मान्मनुष्यभेदोऽयं सङ्केतबलनिर्मितः ।\nब्राह्मण्यं ब्राह्मणासङ्गाद्ब्राह्मणी चोपसेवते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002381050, "chapter_id": 22381, "verse_number": "१-४३-५१", "content_sanskrit": "पतिं त्यक्त्वा मुखस्वादलालसैर्मदलालसैः ।\nआसेव्यते विटं गत्वा बन्धकी चेटकैरपि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002381051, "chapter_id": 22381, "verse_number": "१-४३-५२", "content_sanskrit": "ब्राह्मण्यात्प्रच्यवन्तेऽन्ये महापातकसेविताः ।\nव्यलीककल्पनैवैषा तस्माज्जात्यादिकल्पना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]