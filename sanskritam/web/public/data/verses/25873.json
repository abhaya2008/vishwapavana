[{"id": 7005873000, "chapter_id": 25873, "verse_number": "१-५६-१", "content_sanskrit": "हरिरुवाच ।\nसप्त मेधातिथेः पुत्राः प्लक्षद्वीपेश्वरस् च।\nज्येष्ठः शान्तभवो नाम शिशिरस्तदन्तरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005873001, "chapter_id": 25873, "verse_number": "१-५६-२", "content_sanskrit": "सुखोदयस्तथा नन्दः शिवः क्षेमक एव च ।\nध्रुवश्च सप्तमस्तेषां प्लक्षद्वीपेश्वरा हि ते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005873002, "chapter_id": 25873, "verse_number": "१-५६-३", "content_sanskrit": "गोमेदश्चैव चन्द्रश्च नारदो दुन्दुभिस्तथा।\nसोमकः सुमनाः शैलो वैभ्राजश्चात्र सप्तमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005873003, "chapter_id": 25873, "verse_number": "१-५६-४", "content_sanskrit": "अनुतप्ता शिखी चैव विपाशा त्रिदिवा क्रमुः ।\nअमृता सुकृता चैव सप्तैतास्तत्र निम्नगाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005873004, "chapter_id": 25873, "verse_number": "१-५६-५", "content_sanskrit": "वपुष्मान्शाल्मलस्येशस्तत्सुता वर्षनामकाः।\nश्वेतोऽथ हरितश्चैव जीमूतो रोहितस्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005873005, "chapter_id": 25873, "verse_number": "१-५६-६", "content_sanskrit": "वैद्युतो मानसश्चैव सप्रभशाचपि सप्तमः।\nकुमुदश्चोन्नतो द्रोणो महिषोऽथ बलाहकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005873006, "chapter_id": 25873, "verse_number": "१-५६-७", "content_sanskrit": "क्रौञ्चः ककुद्मान्ह्येते वै गिरयः सरितस्त्विमा।\nयोनितोया वितृष्णा च चन्द्रा शुक्ल विमोचनी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005873007, "chapter_id": 25873, "verse_number": "१-५६-८", "content_sanskrit": "विधृतिः सप्तमी तासां स्मृताः पापप्रशान्तिदाः ।\nज्योतिष्मतः कुशद्वीपे सप्त पुत्राः श्रृणुष्वतान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005873008, "chapter_id": 25873, "verse_number": "१-५६-९", "content_sanskrit": "उद्भिदो वेणुमांश्चैव द्वैरथो लम्बनो धृतिः ।\nप्रभाकरोऽथ कपिलस्तन्नामा वर्षपद्धतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005873009, "chapter_id": 25873, "verse_number": "१-५६-१०", "content_sanskrit": "विद्रुमो हेमशैलश्च द्युतिमान्पुष्पवांस्तथ।\nकुशेशयो हरिश्चैव सप्तमो मन्दराचलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005873010, "chapter_id": 25873, "verse_number": "१-५६-११", "content_sanskrit": "धूतपापा शिवा चैव पवित्रा सन्मतिस्तथा ।\nविद्युदभ्रा मही चान्या सर्वपापहरास्त्विमाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005873011, "chapter_id": 25873, "verse_number": "१-५६-१२", "content_sanskrit": "क्रौञ्चद्वीपे द्युतिमतः पुत्राः सप्त महातनः।\nकुशलो मन्दगश्चोष्णः पीवरोऽथोन्धकारकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005873012, "chapter_id": 25873, "verse_number": "१-५६-१३", "content_sanskrit": "मुनिश्च दुन्दुभिश्चैव सप्तैते तत्सुता हर ।\nक्रौञ्चश्च वामनश्चैव तृतीयश्चान्ध (थ) कारकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005873013, "chapter_id": 25873, "verse_number": "१-५६-१४", "content_sanskrit": "दिवावृत्पञ्चमश्चान्यो दुन्दुभिः पुण्डरीकवान् ।\nगौरी कुमुद्वती चैव सन्ध्या रात्रिर्मनोजवा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005873014, "chapter_id": 25873, "verse_number": "१-५६-१५", "content_sanskrit": "ख्यातिश्च पुण्डरीका च सप्तैता वर्षनिम्नगाः ।\nशाकद्वीपेश्वराद्भव्यात्सप्त पुत्राः प्रजज्ञिरे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005873015, "chapter_id": 25873, "verse_number": "१-५६-१६", "content_sanskrit": "जलद्श्च कुमारश्च सुकुमारोरुणी बकः ।\nकुसुमोदः समोदार्किः सप्तमश्च महाद्रुमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005873016, "chapter_id": 25873, "verse_number": "१-५६-१७", "content_sanskrit": "सुकुमारी कुमारी च नलिनी धेनुका च या ।\nइक्षुश्च वेणुका चैव गभस्ती सप्तमी तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005873017, "chapter_id": 25873, "verse_number": "१-५६-१८", "content_sanskrit": "शबलात्पुष्करेशाच्च महावीरश्च धातकिः ।\nअभूद्वर्षद्वयं चैव मानसोत्तरपर्वतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005873018, "chapter_id": 25873, "verse_number": "१-५६-१९", "content_sanskrit": "योजनानां सहस्त्राणि ऊर्द्ध्वं पञ्चाशदुच्छ्रित।\nतावच्चैव च विस्तीर्णः सर्वतः परिमण्डलः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005873019, "chapter_id": 25873, "verse_number": "१-५६-२०", "content_sanskrit": "स्वादूदकेनोदधिना पुष्करः परिवेष्टितः ।\nस्वादूदकस्य पुरतो दृश्यते लोकसंस्थितिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005873020, "chapter_id": 25873, "verse_number": "१-५६-२१", "content_sanskrit": "द्विगुणा काञ्चनी भूमिः सर्वजन्तुविवर्जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005873021, "chapter_id": 25873, "verse_number": "१-५६-२२", "content_sanskrit": "लोकालोकस्ततः शैलो योजनायुताविस्तृतः।\nतमसा पर्वतो व्याप्तस्तमोऽप्यण्डकटाहतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]