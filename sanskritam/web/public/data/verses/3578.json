[{"id": 2119970, "chapter_id": 3578, "verse_number": "", "content_sanskrit": "राक्षसी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119971, "chapter_id": 3578, "verse_number": "१", "content_sanskrit": "जरा नामास्मि भद्रं ते राक्षसी कामरूपिणी ।\nतव वेश्मनि राजेन्द्र भक्ष्यैर्भोज्यैः सुपूजिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119972, "chapter_id": 3578, "verse_number": "२", "content_sanskrit": "साऽहं प्रत्युपकारार्थं चिन्तयन्त्यनिशं नृप ।\nतवेमे पुत्रशकले दृष्टवत्यस्मि धार्मिकी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119973, "chapter_id": 3578, "verse_number": "३", "content_sanskrit": "संश्लेषिते मया दैवात् कुमारः समपद्यत ।\nतव भाग्यैर्महाभाग हेतुमात्रं त्वहं त्विह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119974, "chapter_id": 3578, "verse_number": "४", "content_sanskrit": "मेरुं वा खादितुं शक्ता किं पुनस्तव बालकम् ।\nगृहसम्पूजनात् तुष्ट्या मया प्रत्यर्पितस्तव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119975, "chapter_id": 3578, "verse_number": "५", "content_sanskrit": "तस्य बालस्य यत् कृत्यं तत् कुरुष्व नराधिप ।\nमम नाम्ना च लोकेऽस्मिन् ख्यात एव भविष्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119976, "chapter_id": 3578, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119977, "chapter_id": 3578, "verse_number": "६", "content_sanskrit": "एवमुक्त्वा जरा राजन् तत्रैवान्तरधीयत ।\nसोऽपि गृह्य कुमारं तं प्राविशत् स्वपुरं नृपः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119978, "chapter_id": 3578, "verse_number": "७", "content_sanskrit": "तस्य बालस्य यत् कृत्यं तच्चकार नृपस्तदा ।\nआज्ञापयच्च राक्षस्या मगधेषु महोत्सवम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119979, "chapter_id": 3578, "verse_number": "८", "content_sanskrit": "तस्य नामाकरोत् तत्र प्रजापतिसमः पिता ।\nजरया सन्धितो यस्माज्जरासन्धस्ततोऽभवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119980, "chapter_id": 3578, "verse_number": "९", "content_sanskrit": "सोऽवर्धत महातेजा मगधाधिपतेः सुतः ।\nप्रमाणबलसम्पन्नो हुताहुतिरिवानलः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119981, "chapter_id": 3578, "verse_number": "१०", "content_sanskrit": "एवं स ववृधे राजन् कुमारः पुष्करेक्षणः ।\nकालेन महता चापि यौवनस्थो बभूव ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119982, "chapter_id": 3578, "verse_number": "११", "content_sanskrit": "कस्यचित्त्वथ कालस्य पुनरेव महातपाः ।\nमगधानुपचक्राम भगवांश्चण्डकौशिकः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119983, "chapter_id": 3578, "verse_number": "१२", "content_sanskrit": "तस्यागमनसंहृष्टः सामात्यः सपुरोहितः ।\nसभार्यः सह पुत्रेण निर्जगाम बृहद्रथः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119984, "chapter_id": 3578, "verse_number": "१३", "content_sanskrit": "पाद्यार्घ्याचमनीयैस्तमर्चयामास भारत ।\nस नृपो राज्यसहितं पुत्रं चास्मै न्यवेदयत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119985, "chapter_id": 3578, "verse_number": "१४", "content_sanskrit": "प्रतिगृह्य च तां पूजां पार्थिवाद् भगवानृषिः ।\nउवाच मागधं तत्र प्रहृष्टेनान्तरात्मना\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119986, "chapter_id": 3578, "verse_number": "", "content_sanskrit": "चण्डकौशिकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119987, "chapter_id": 3578, "verse_number": "१५", "content_sanskrit": "सर्वमेतन्मया राजन् विज्ञातं ज्ञानचक्षुषा ।\nपुत्रस्तु शृणु राजेन्द्र यादृशो वै भविष्यति\nअस्य प्रभावं च सत्त्वं च बलमूर्जितमेव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119988, "chapter_id": 3578, "verse_number": "१६", "content_sanskrit": "एष श्रिया समुदितः पुत्रस्तव न संशयः ।\nप्रापयिष्यति तत्सर्वं विक्रमेण समन्वितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119989, "chapter_id": 3578, "verse_number": "१७", "content_sanskrit": "अस्य वीर्यवतो वीर्यं नानुयास्यन्ति पार्थिवाः ।\nपततो वैनतेयस्य गतिमन्ये यथा खगाः ।\nविनाशमुपयास्यन्ति ये चास्य परिपन्थिनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119990, "chapter_id": 3578, "verse_number": "१८", "content_sanskrit": "देवैरपि विसृष्टानि शस्त्राण्यस्य महीपते ।\nन रुजं जनयिष्यन्ति गिरेरिव नदीरयाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119991, "chapter_id": 3578, "verse_number": "१९", "content_sanskrit": "सर्वमूर्धावसिक्तानामेष मूर्ध्नि ज्वलिष्यति ।\nसर्वेषां निष्प्रभकरो ज्योतिषामिव भास्करः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119992, "chapter_id": 3578, "verse_number": "२०", "content_sanskrit": "एनमासाद्य राजानः समृद्धबलवाहनाः ।\nविनाशमुपयास्यन्ति शलभा इव पावकात्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119993, "chapter_id": 3578, "verse_number": "२१", "content_sanskrit": "एष श्रियं सुमुदितां सर्वराज्ञां ग्रहीष्यति ।\nवर्षास्विवोद्धतजला नदीरिव नदीपतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119994, "chapter_id": 3578, "verse_number": "२२", "content_sanskrit": "एष धारयिता सम्यक् चातुर्वर्ण्यं महाबलः ।\nशुभां शुभवतीं स्फीतां सर्वसस्यधरां धराम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119995, "chapter_id": 3578, "verse_number": "२३", "content_sanskrit": "अस्याज्ञावशगाः सर्वे भविष्यन्ति नराधिपाः ।\nसर्वभूतात्मभूतस्य वायोरिव शरीरिणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119996, "chapter_id": 3578, "verse_number": "२४", "content_sanskrit": "एष रुद्रं महादेवं त्रिपुरान्तकरं हरम् ।\nसर्वलोकेष्वतिबलः स्वयं द्रक्ष्यति मागधः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119997, "chapter_id": 3578, "verse_number": "२५", "content_sanskrit": "एवं ब्रुवन्नेव मुनिः स्वकार्यार्थं विचिन्तयन् ।\nविसर्जयामास नृपं बृहद्रथमथारिहन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119998, "chapter_id": 3578, "verse_number": "२६", "content_sanskrit": "प्रविश्य नगरीं चैव ज्ञातिसम्बन्धिभिर्वृतः ।\nअभिषिच्य जरासन्धं मगधाधिपतिं तदा ।\nबृहद्रथो नरपतिः परां निर्वृतिमाययौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119999, "chapter_id": 3578, "verse_number": "२७", "content_sanskrit": "अभिषिक्ते जरासन्धे तदा राजा बृहद्रथः ।\nपत्नीद्वयेनानुगतस्तपोवनमुपागमत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120000, "chapter_id": 3578, "verse_number": "२८", "content_sanskrit": "तपोवनस्थे पितरि मातृभ्यां सह भारत ।\nजरासन्धस्तु वीर्येण पार्थिवानकरोद् वशे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120001, "chapter_id": 3578, "verse_number": "२९", "content_sanskrit": "अथ दीर्घस्य कालस्य तपोवनगतो नृपः ।\nसभार्यः स्वर्गमगमत् तपस्तप्त्वा बृहद्रथः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120002, "chapter_id": 3578, "verse_number": "३०", "content_sanskrit": "जरासन्धोऽपि नृपतिर्यथोक्तं कौशिकेन तत् ।\nवरप्रदानमखिलं प्राप्य राज्यमकारयत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120003, "chapter_id": 3578, "verse_number": "३१", "content_sanskrit": "तस्यास्तां हंसडिभकावशस्त्रनिधनावुभौ ।\nमन्त्रे मतिमतां श्रेष्ठौ युद्धनीतिविशारदौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120004, "chapter_id": 3578, "verse_number": "३२", "content_sanskrit": "हते चैव मया कंसे सहंसडिभके तदा ।\nजरासन्धस्य दुहिता रोदते पार्श्वतः पितुः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120005, "chapter_id": 3578, "verse_number": "३३", "content_sanskrit": "ततो वैरं विनिर्बद्धं मम तस्य च भारत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120006, "chapter_id": 3578, "verse_number": "३४", "content_sanskrit": "भ्रामयित्वा शतगुणमेकपातेन भारत ।\nगदा क्षिप्ता बलवता मागधेन गिरिव्रजात्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120007, "chapter_id": 3578, "verse_number": "३५", "content_sanskrit": "तिष्ठतो मधुरायां वै मम चाद्भुतकर्मणः ।\nएकोनयोजनशते सा पपात गदा शुभा ।\nनहि योधैस्तदा तस्य सम्यगध्वा निवेदितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120008, "chapter_id": 3578, "verse_number": "३६", "content_sanskrit": "दृष्ट्वा पौरैस्तदा सम्यग् गदा चैव निवेदिता ।\nगदावसानं तत् ख्यातं मधुरायाः समीपतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120009, "chapter_id": 3578, "verse_number": "३७", "content_sanskrit": "मया तौ कथितौ राजन् पूर्वमेव महाबलौ ।\nत्रयस्त्रयाणां लोकानां पर्याप्ता इति मे मतिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120010, "chapter_id": 3578, "verse_number": "३८", "content_sanskrit": "एवमेष तदा वीर बलिभिः कुकुरान्धकैः ।\nवृष्णिभिश्च महाराज नीतिहेतोरुपेक्षितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120011, "chapter_id": 3578, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि विंशोऽध्यायः ॥ २० ॥\nमन्त्रपर्वणि विंशोऽध्यायः ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120012, "chapter_id": 3578, "verse_number": "", "content_sanskrit": "॥ समाप्तं मन्त्रपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120013, "chapter_id": 3578, "verse_number": "", "content_sanskrit": "— ०  —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]