[{"id": 2148790, "chapter_id": 4220, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148791, "chapter_id": 4220, "verse_number": "१", "content_sanskrit": "युधिष्ठिरं सहानीकमुपायान्तं युयुत्सया ।\nसन्निविष्टं कुरुक्षेत्रे वासुदेवेन पालितम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148792, "chapter_id": 4220, "verse_number": "२", "content_sanskrit": "विराटद्रुपदाभ्यां च सपुत्राभ्यां समन्वितम् ।\nकेकयैर्वृष्णिभिश्चैव पार्थिवैः शतशो वृतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148793, "chapter_id": 4220, "verse_number": "३", "content_sanskrit": "महेन्द्रमिव चादित्यैरभिगुप्तं महारथैः ।\nश्रुत्वा दुर्योधनो राजा किं कार्यं प्रत्यपद्यत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148794, "chapter_id": 4220, "verse_number": "४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण महामते ।\nसम्भ्रमे तुमुले तस्मिन् यदासीत् कुरुजाङ्गले\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148795, "chapter_id": 4220, "verse_number": "५", "content_sanskrit": "व्यथयेयुरिमे देवान् सेन्द्रानपि समागमे ।\nपाण्डवा वासुदेवश्च विराटद्रुपदौ तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148796, "chapter_id": 4220, "verse_number": "६", "content_sanskrit": "धृष्टद्युम्नश्च पाञ्चाल्यः शिखण्डी च महारथः ।\nयुधामन्युश्च विक्रान्तो देवैरपि दुरासदः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148797, "chapter_id": 4220, "verse_number": "७", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण तपोधन ।\nकुरूणां पाण्डवानां च यद्यदासीद् विचेष्टितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148798, "chapter_id": 4220, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148799, "chapter_id": 4220, "verse_number": "८", "content_sanskrit": "प्रतियाते तु दाशार्हे राजा दुर्योधनस्तदा ।\nकर्णं दुःशासनं चैव शकुनिं चाब्रवीदिदम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148800, "chapter_id": 4220, "verse_number": "९", "content_sanskrit": "अकृतेनैव कार्येण गतः पार्थानधोक्षजः ।\nस एनान् मन्युनाऽऽविष्टो ध्रुवं धक्ष्यत्यसंशयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148801, "chapter_id": 4220, "verse_number": "१०", "content_sanskrit": "इष्टो हि वासुदेवस्य पाण्डवैर्मम विग्रहः ।\nभीमसेनार्जुनौ चैव दाशार्हस्य मते स्थितौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148802, "chapter_id": 4220, "verse_number": "११", "content_sanskrit": "अजातशत्रुरत्यर्थं भीमार्जुनवशानुगः ।\nनिकृतश्च मया पूर्वं सह सर्वैः सहोदरैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148803, "chapter_id": 4220, "verse_number": "१२", "content_sanskrit": "विराटद्रुपदौ चैव कृतवैरौ मया सह ।\nतौ च सेनाप्रणेतारौ वासुदेववशानुगौ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148804, "chapter_id": 4220, "verse_number": "१३", "content_sanskrit": "भविता विग्रहः सोऽयं तुमुलो रोमहर्षणः ।\nतस्मात् साङ्ग्रामिकं सर्वं कारयध्वमतन्द्रिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148805, "chapter_id": 4220, "verse_number": "१४", "content_sanskrit": "शिबिराणि कुरुक्षेत्रे क्रियन्तां वसुधाधिपाः ।\nसुपर्याप्तावकाशानि दुरादेयानि शत्रुभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148806, "chapter_id": 4220, "verse_number": "१५", "content_sanskrit": "आसन्नजलकोष्ठानि शतशोऽथ सहस्रशः ।\nअच्छेद्याहारमार्गाणि रत्नोच्छ्रयचितानि च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148807, "chapter_id": 4220, "verse_number": "१६", "content_sanskrit": "विविधायुधपूर्णानि पताकाध्वजवन्ति च ।\nसमाश्च तेषां पन्थानः क्रियन्तां नगराद् बहिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148808, "chapter_id": 4220, "verse_number": "१७", "content_sanskrit": "प्रयाणं घुष्यतामद्य श्वोभूत इति माचिरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148809, "chapter_id": 4220, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148810, "chapter_id": 4220, "verse_number": "१८", "content_sanskrit": "ते तथेति प्रतिज्ञाय श्वोभूते चक्रिरे तथा ।\nहृष्टरूपा महात्मानो निवासाय महीक्षिताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148811, "chapter_id": 4220, "verse_number": "१९", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे तच्छ्रुत्वा राजशासनम् ।\nआसनेभ्यो महार्हेभ्य उदतिष्ठन्नमर्षिताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148812, "chapter_id": 4220, "verse_number": "२०", "content_sanskrit": "बाहून् परिघसङ्काशान् संस्पृशन्तः शनैस्ततः ।\nकाञ्चनाङ्गददीप्तांश्च चन्दनागरुरूषितान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148813, "chapter_id": 4220, "verse_number": "२१", "content_sanskrit": "उष्णीषाणि नियच्छन्तः पुण्डरीकनिभैः करैः ।\nअन्तरीयोत्तरीयाणि भूषणानि च सर्वशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148814, "chapter_id": 4220, "verse_number": "२२", "content_sanskrit": "ते रथान् रथिनः श्रेष्ठा हयांश्च हयकोविदाः ।\nसज्जयन्ति स्म नागांश्च नागशिक्षास्वनुष्ठिताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148815, "chapter_id": 4220, "verse_number": "२३", "content_sanskrit": "अथ वर्माणि शस्त्राणि कवचानि बहूनि च ।\nविविधानि च तीक्ष्णानि चक्रुः सज्जानि सर्वशः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148816, "chapter_id": 4220, "verse_number": "२४", "content_sanskrit": "पदातयश्च पुरुषाः शस्त्राणि विविधानि च ।\nउपाजह्रुः शरीरेषु हेमचित्राण्यनेकशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148817, "chapter_id": 4220, "verse_number": "२५", "content_sanskrit": "तदुत्सव इवोदग्रं सम्प्रहृष्टनरावृतम् ।\nनगरं धार्तराष्ट्रस्य भारतासीत् समाकुलम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148818, "chapter_id": 4220, "verse_number": "२६", "content_sanskrit": "जनौघसलिलावर्तो रथनागाश्वमीनवान् ।\nशङ्खदुन्दुभिनिर्घोषः कोशसञ्चयरत्नवान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148819, "chapter_id": 4220, "verse_number": "२७", "content_sanskrit": "चित्राभरणवर्मोर्मिः शस्त्रनिर्मलफेनवान् ।\nप्रासादमालाद्रिवृतो रथ्यापणमहाग्रहः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148820, "chapter_id": 4220, "verse_number": "२८", "content_sanskrit": "योगचन्द्रोदयोद्धूतः कुरुराजबलार्णवः ।\nव्यदृश्यत तदा राजंश्चन्द्रोदय इवार्णवः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148821, "chapter_id": 4220, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकपञ्चाशोत्तरशततमोऽध्यायः ॥१५१॥\nसैन्यनिर्याणपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]