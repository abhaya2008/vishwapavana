[{"id": 2195226, "chapter_id": 5152, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195227, "chapter_id": 5152, "verse_number": "१", "content_sanskrit": "ब्राह्मण्यं यदि दुष्प्रापं त्रिभिर्वर्णैर्नराधिप ।\nकथं प्राप्तं महाराज क्षत्रियेण महात्मना\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195228, "chapter_id": 5152, "verse_number": "२", "content_sanskrit": "विश्वामित्रेण धर्मात्मन् ब्राह्मणत्वं नरर्षभ ।\nश्रोतुमिच्छामि तत्त्वेन तन्मे ब्रूहि पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195229, "chapter_id": 5152, "verse_number": "३", "content_sanskrit": "तेन ह्यमितवीर्येण वसिष्ठस्य महात्मनः ।\nहतं पुत्रशतं सद्यस्तपसा प्रपितामह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195230, "chapter_id": 5152, "verse_number": "४", "content_sanskrit": "यातुधानाश्च बहवो राक्षसास्तिग्मतेजसः ।\nमन्युनाऽऽविष्टदेहेन सृष्टाः कालान्तकोपमाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195231, "chapter_id": 5152, "verse_number": "५", "content_sanskrit": "महान् कुशिकवंशश्च ब्रह्मर्षिशतसङ्कुलः ।\nस्थापितो नरलोकेऽस्मिन् विद्वान् ब्राह्मणसत्कृतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195232, "chapter_id": 5152, "verse_number": "६", "content_sanskrit": "ऋचीकस्यात्मजश्चैव शुनःशेपो महातपाः ।\nविमोक्षितो महासत्रात् पशुतामभ्युपागतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195233, "chapter_id": 5152, "verse_number": "७", "content_sanskrit": "हरिश्चन्द्रक्रतौ देवांस्तोषयित्वाऽऽत्मतेजसा ।\nपुत्रतामनुसम्प्राप्तो विश्वामित्रस्य धीमतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195234, "chapter_id": 5152, "verse_number": "८", "content_sanskrit": "नाभिवादयतो ज्येष्ठं देवरातं नराधिप ।\nपुत्राः पञ्चाशतश्चापि शप्ताः श्वपचतां गताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195235, "chapter_id": 5152, "verse_number": "९", "content_sanskrit": "त्रिशङ्कुर्बन्धुसन्त्यक्त ऐक्ष्वाकः प्रीतिपूर्वकम् ।\nअवाक्शिरा दिवं नीतो दक्षिणामाश्रितो दिशम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195236, "chapter_id": 5152, "verse_number": "१०", "content_sanskrit": "विश्वामित्रस्य विपुला नदी राजर्षिसेविता ।\nकौशिकीति शिवा पुण्या ब्रह्मर्षिगणसेविता\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195237, "chapter_id": 5152, "verse_number": "११", "content_sanskrit": "तपोविघ्नकरी चैव पञ्चचूडा सुसम्मता ।\nरम्भा नामाप्सराः शापाद् यस्य शैलत्वमागता\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195238, "chapter_id": 5152, "verse_number": "१२", "content_sanskrit": "तथैवास्य भयाद् बद्ध्वा वसिष्ठः सलिले पुरा ।\nआत्मानं मज्जयामास विपाशः पुनरुत्थितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195239, "chapter_id": 5152, "verse_number": "१३", "content_sanskrit": "तदाप्रभृति पुण्या हि विपाशाऽभून्महानदी ।\nविख्याता कर्मणा तेन वसिष्ठस्य महात्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195240, "chapter_id": 5152, "verse_number": "१४", "content_sanskrit": "वाग्भिश्च भगवान् येन देवसेनाग्रगः प्रभुः ।\nस्तुतः प्रीतमनाश्चासीच्छापाच्चैनममोचयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195241, "chapter_id": 5152, "verse_number": "१५", "content_sanskrit": "ध्रुवस्यौत्तानपादस्य ब्रह्मर्षीणां तथैव च ।\nमध्ये ज्वलति यो नित्यमुदीचीमाश्रितो दिशम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195242, "chapter_id": 5152, "verse_number": "१६", "content_sanskrit": "तस्यैतानि च कर्माणि तथान्यानि च कौरव ।\nब्राह्मणत्वं कुतो जातमिदं कौतूहलं मम\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195243, "chapter_id": 5152, "verse_number": "१७", "content_sanskrit": "किमेतदिति तत्त्वेन प्रब्रूहि भरतर्षभ ।\nदेहान्तरमनासाद्य कथं स ब्राह्मणोऽभवत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195244, "chapter_id": 5152, "verse_number": "१८", "content_sanskrit": "एतत् तत्त्वेन मे राजन् सर्वमाख्यातुमर्हसि ।\nमतङ्गस्य यथा तत्त्वं तथैवैतद् ब्रवीहि मे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195245, "chapter_id": 5152, "verse_number": "१९", "content_sanskrit": "स्थाने मतङ्गो ब्राह्मण्यं नालभद् भरतर्षभ ।\nचण्डालयोनौ जातो हि कथं ब्राह्मण्यमाप्नुयात्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195246, "chapter_id": 5152, "verse_number": "३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nअनुशासनपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195247, "chapter_id": 5152, "verse_number": "", "content_sanskrit": "दानधर्मपर्वणि तृतीयोऽध्यायः ॥३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]