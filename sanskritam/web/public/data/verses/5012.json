[{"id": 2188823, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188824, "chapter_id": 5012, "verse_number": "१", "content_sanskrit": "शतक्रतुरथापश्यद् बलेर्दीप्तां महात्मनः ।\nस्वरूपिणीं शरीराद्धि तदा निष्क्रामतीं श्रियम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188825, "chapter_id": 5012, "verse_number": "२", "content_sanskrit": "तां दीप्तां प्रभया दृष्ट्वा भगवान् पाकशासनः ।\nविस्मयोत्फुल्लनयनो बलिं पप्रच्छ वासवः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188826, "chapter_id": 5012, "verse_number": "३", "content_sanskrit": "बले केयमपक्रान्ता रोचमाना शिखण्डिनी ।\nत्वत्तः स्थिता सकेयूरा दीप्यमाना स्वतेजसा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188827, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "बलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188828, "chapter_id": 5012, "verse_number": "४", "content_sanskrit": "न हीमामासुरीं वेद्मि न दैवीं न च मानुषीम् ।\nत्वमेवैनां पृच्छ मा वा यथेष्टं कुरु वासव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188829, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188830, "chapter_id": 5012, "verse_number": "५", "content_sanskrit": "का त्वं बलेरपक्रान्ता रोचमाना शिखण्डिनी ।\nअजानतो ममाचक्ष्व नामधेयं शुचिस्मिते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188831, "chapter_id": 5012, "verse_number": "६", "content_sanskrit": "का त्वं तिष्ठसि मायेव दीप्यमाना स्वतेजसा ।\nहित्वा दैत्येश्वरं सुभ्रु तन्ममाचक्ष्व तत्त्वतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188832, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188833, "chapter_id": 5012, "verse_number": "७", "content_sanskrit": "न मा विरोचनो वेद न मा वैरोचनो बलिः ।\nआहुर्मां दुःसहेत्येवं विधित्सेति च मां विदुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188834, "chapter_id": 5012, "verse_number": "८", "content_sanskrit": "भूतिर्लक्ष्मीति मामाहुः श्रीरित्येवं च वासव ।\nत्वं मां शक्र न जानीषे सर्वे देवा न मां विदुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188835, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188836, "chapter_id": 5012, "verse_number": "९", "content_sanskrit": "किमिदं त्वं मम कृते उताहो बलिनः कृते ।\nदुःसहे विजहास्येनं चिरसंवासिनी सती\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188837, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188838, "chapter_id": 5012, "verse_number": "१०", "content_sanskrit": "न धाता न विधाता मां विदधाति कथञ्चन ।\nकालस्तु शक्र पर्यायान्मैनं शक्रावमन्यथाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188839, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188840, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "कथं त्वया बलिस्त्यक्तः किमर्थं वा शिखण्डिनि ।\nकथं च मां न जह्यास्त्वं तन्मे ब्रूहि शुचिस्मिते\t॥११", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188841, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188842, "chapter_id": 5012, "verse_number": "१२", "content_sanskrit": "सत्ये स्थितास्मि दाने च व्रते तपसि चैव हि ।\nपराक्रमे च धर्मे च पराचीनस्ततो बलिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188843, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "ब्रह्मण्योऽयं सदा भूत्वा सत्यवादी जितेन्द्रियः ।\nअभ्यसूयद् ब्राह्मणान् वै उच्छिष्टश्चास्पृशद् धृतम्\t॥१३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188844, "chapter_id": 5012, "verse_number": "१४", "content_sanskrit": "यज्ञशीलः पुरा भूत्वा मामेव यजतेत्ययम् ।\nप्रोवाच लोकान् मूढात्मा कालेनोपनिपीडितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188845, "chapter_id": 5012, "verse_number": "१५", "content_sanskrit": "अपाकृता ततः शक्र त्वयि वत्स्यामि वासव ।\nअप्रमत्तेन धार्यास्मि तपसा विक्रमेण च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2188846, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2188847, "chapter_id": 5012, "verse_number": "१६", "content_sanskrit": "अस्ति देवमनुष्येषु सर्वभूतेषु वा पुमान् ।\nयस्त्वामेको विषहितुं शक्नुयात् कमलालये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2188848, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2188849, "chapter_id": 5012, "verse_number": "१७", "content_sanskrit": "नैव देवो न गन्धर्वो नासुरो न च राक्षसः ।\nयो मामेको विषहितुं शक्तः कश्चित् पुरंदर\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2188850, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2188851, "chapter_id": 5012, "verse_number": "१८", "content_sanskrit": "तिष्ठेथा मयि नित्यं त्वं यथा तद् ब्रूहि मे शुभे ।\nतत् करिष्यामि ते वाक्यमृतं त्वं वक्तुमर्हसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2188852, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2188853, "chapter_id": 5012, "verse_number": "१९", "content_sanskrit": "स्थास्यामि नित्यं देवेन्द्र यथा त्वयि निबोध तत् ।\nविधिना वेददृष्टेन चतुर्धा विभजस्व माम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2188854, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2188855, "chapter_id": 5012, "verse_number": "२०", "content_sanskrit": "अहं वै त्वा निधास्यामि यथाशक्ति यथाबलम् ।\nन तु मेऽतिक्रमः स्याद्वै सदा लक्ष्मि तवान्तिके\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2188856, "chapter_id": 5012, "verse_number": "२१", "content_sanskrit": "भूमिरेव मनुष्येषु धारणी भूतभाविनी ।\nसा ते पादं तितिक्षेत समर्था हीति मे मतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2188857, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2188858, "chapter_id": 5012, "verse_number": "२२", "content_sanskrit": "एष मे निहितः पादो योऽयं भूमौ प्रतिष्ठितः ।\nद्वितीयं शक्र पादं मे तस्मात् सुनिहितं कुरु\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2188859, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2188860, "chapter_id": 5012, "verse_number": "२३", "content_sanskrit": "आप एव मनुष्येषु द्रवन्त्यः परिचारिकाः ।\nतास्ते पादं तितिक्षन्तामलमापस्तितिक्षितुम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2188861, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2188862, "chapter_id": 5012, "verse_number": "२४", "content_sanskrit": "एष मे निहितः पादो योऽयमप्सु प्रतिष्ठितः ।\nतृतीयं शक्र पादं मे तस्मात् सुनिहितं कुरु\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2188863, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2188864, "chapter_id": 5012, "verse_number": "२५", "content_sanskrit": "यस्मिन् देवाश्च यज्ञाश्च यस्मिन् वेदाः प्रतिष्ठिताः ।\nतृतीयं पादमग्निस्ते सुधृतं धारयिष्यति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2188865, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2188866, "chapter_id": 5012, "verse_number": "२६", "content_sanskrit": "एष मे निहितः पादो योऽयमग्नौ प्रतिष्ठितः ।\nचतुर्थं शक्र पादं मे तस्मात् सुनिहितं कुरु\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2188867, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2188868, "chapter_id": 5012, "verse_number": "२७", "content_sanskrit": "ये वै सन्तो मनुष्येषु ब्रह्मण्याः सत्यवादिनः ।\nते ते पादं तितिक्षन्तामलं सन्तस्तितिक्षितुम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2188869, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2188870, "chapter_id": 5012, "verse_number": "२८", "content_sanskrit": "एष मे निहितः पादो योऽयं सत्सु प्रतिष्ठितः ।\nएवं विनिहितां शक्र भूतेषु परिधत्स्व माम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2188871, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2188872, "chapter_id": 5012, "verse_number": "२९", "content_sanskrit": "भूमिशुद्धिं ततः कृत्वा अद्भिः सन्तर्पयन्ति ये ।\nभूतानि च यजन्त्यग्नौ तेषां त्वमनपायिनी\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2188873, "chapter_id": 5012, "verse_number": "३०", "content_sanskrit": "ये क्रियाभिः सुरक्ताभिर्हेतुयुक्ताः समाहिताः ।\nज्ञानवन्तो विवत्सायां लब्धा माद्यन्ति योगिनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2188874, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "भूतानामिह वै यस्त्वा मया विनिहितां सतीम् ।\nउपहन्यात् स मे द्विष्यात्तथा शृण्वन्तु मे वचः\t॥३१।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2188875, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2188876, "chapter_id": 5012, "verse_number": "३२", "content_sanskrit": "तथेति चोक्त्वा सा वत्सा सर्वलोकनमस्कृता ।\nवासवं पालयामास सा देवी कमलालया \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2188877, "chapter_id": 5012, "verse_number": "३३", "content_sanskrit": "ततस्त्यक्तः श्रिया राजा दैत्यानां बलिरब्रवीत् ।\nयावत् पुरस्तात् प्रतपेत्तावद्वै दक्षिणां दिशम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2188878, "chapter_id": 5012, "verse_number": "३४", "content_sanskrit": "पश्चिमां तावदेवापि तथोदीचीं दिवाकरः ।\nतथा मध्यन्दिने सूर्यो अस्तमेति यदा तदा ।\nपुनर्देवासुरं युद्धं भावि जेतास्मि वस्तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2188879, "chapter_id": 5012, "verse_number": "३५", "content_sanskrit": "सर्वलोकान् यदादित्य एकस्थस्तापयिष्यति ।\nतदा देवासुरे युद्धे जेताहं त्वां शतक्रतो\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2188880, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2188881, "chapter_id": 5012, "verse_number": "३६", "content_sanskrit": "ब्रह्मणास्मि समादिष्टो न हन्तव्यो भवानिति ।\nतेन तेऽहं बले वज्रं न विमुञ्चामि मूर्धनि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2188882, "chapter_id": 5012, "verse_number": "३७", "content_sanskrit": "यथेष्टं गच्छ दैत्येन्द्र स्वस्ति तेऽस्तु महासुर ।\nआदित्यो नावतपिता कदाचिन्मध्यतः स्थितः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2188883, "chapter_id": 5012, "verse_number": "३८", "content_sanskrit": "स्थापितो ह्यस्य समयः पूर्वमेव स्वयम्भुवा ।\nअजस्रं परियात्येष सत्येनावतपन् प्रजाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2188884, "chapter_id": 5012, "verse_number": "३९", "content_sanskrit": "अयनं तस्य षण्मासा उत्तरं दक्षिणं तथा ।\nयेन संयाति लोकेषु शीतोष्णे विसृजन् रविः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2188885, "chapter_id": 5012, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2188886, "chapter_id": 5012, "verse_number": "३०", "content_sanskrit": "एवमुक्तस्तु दैत्येन्द्रो बलिरिन्द्रेण भारत ।\nजगाम दक्षिणामाशामुदीचीं तु पुरन्दरः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2188887, "chapter_id": 5012, "verse_number": "३१", "content_sanskrit": "इत्येतद् बलिना गीतमनहङ्कारसञ्ज्ञितम् ।\nवाक्यं श्रुत्वा सहस्राक्षः खमेवारुरुहे तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2188888, "chapter_id": 5012, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकषष्टितमोऽध्यायः ॥६१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]