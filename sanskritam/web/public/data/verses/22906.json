[{"id": 7002906000, "chapter_id": 22906, "verse_number": "९-१९१-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nप्रतिष्ठा शाश्वती केन दानेन मधुसूदन ।\nइह लोके परे चैव कीर्तिरत्यद्भुता तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002906001, "chapter_id": 22906, "verse_number": "९-१९१-२", "content_sanskrit": "सद्गतिं च तथा यांति सर्वे पितृपितामहाः ।\nसंततिश्चाक्षया लोके विभवश्चापि पुष्कलः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002906002, "chapter_id": 22906, "verse_number": "९-१९१-३", "content_sanskrit": "स्थापनात्सर्वदेवानां कथं स्याद्यदुनंदन ।\nतदाचक्ष्व महाभाग दानेन नियमेन वा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002906003, "chapter_id": 22906, "verse_number": "९-१९१-४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसाधु पृष्टं त्वया राजंल्लोकानामुपकारकम् ।\nशृणुष्वैकमना भूत्वा गुह्यं परममुत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002906004, "chapter_id": 22906, "verse_number": "९-१९१-५", "content_sanskrit": "भुवनानां समासेन प्रतिष्ठां कथयामि ते ।\nदेवासुरास्तथा नागा गंधर्वा यक्षराक्षसाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002906005, "chapter_id": 22906, "verse_number": "९-१९१-६", "content_sanskrit": "प्रेताः पिशाचा भूताश्च स्थापिताः स्युर्न संशयः ।\nकारकस्यानुकूले तु मुहूर्ते विजये शुभे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002906006, "chapter_id": 22906, "verse_number": "९-१९१-७", "content_sanskrit": "पुण्ये तिथौ शिवक्षेत्रे दिने सौम्यग्रहान्विते ।\nसप्त हस्तं पटं कृत्वा चतुरस्रं सुसंहतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002906007, "chapter_id": 22906, "verse_number": "९-१९१-८", "content_sanskrit": "अभिन्नांगं दृढं शुद्धं शुद्धस्फटिकवर्चसम् ।\nतस्मिन्सर्वाणि राजेंद्र भुवनानि च लेखयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002906008, "chapter_id": 22906, "verse_number": "९-१९१-९", "content_sanskrit": "चातुर्वर्ण्यकमानीय विचित्रं चित्रकर्मणि ।\nयुवानं व्याधिरहितं भव्यं चित्रकरं शुभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002906009, "chapter_id": 22906, "verse_number": "९-१९१-१०", "content_sanskrit": "संपूजयित्वा यत्नेन दिव्यवासोविभूषणैः ।\nतस्मिन्कर्मणि युंजीत पठ्यमानैर्द्विजोत्तमैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002906010, "chapter_id": 22906, "verse_number": "९-१९१-११", "content_sanskrit": "शंखभेरीनिनादैश्च गीतमंगलनिस्वनैः ।\nपुण्याहजयघोषैश्च ब्राह्मणान्पूज्येत्ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002906011, "chapter_id": 22906, "verse_number": "९-१९१-१२", "content_sanskrit": "आचार्यमपि संपूज्य वासोभिर्भूषणैस्तथा ।\nप्रारंभं कारयेद्राजन्पटे तस्मिन्यथोदितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002906012, "chapter_id": 22906, "verse_number": "९-१९१-१३", "content_sanskrit": "मध्ये च लेखयेद्राजञ्जंबूद्वीपं सविस्तरम् ।\nतस्य मध्ये स्थितो मेरुर्मेरोरुपरि देवताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002906013, "chapter_id": 22906, "verse_number": "९-१९१-१४", "content_sanskrit": "दिशासु लोकपालानां पुरोऽष्टौ सुरसंयुताः ।\nसप्तद्वीपवती पृथ्वी सप्त चैव कुलाचलाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002906014, "chapter_id": 22906, "verse_number": "९-१९१-१५", "content_sanskrit": "सागराः सप्त चात्रैव नद्यो ह्रदाः सरांसि च ।\nपातालाः सप्त चात्रैव सप्त स्वर्गविभूतयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002906015, "chapter_id": 22906, "verse_number": "९-१९१-१६", "content_sanskrit": "ब्रह्मविष्णुशिवादीनां भुवनानि यथाक्रमम् ।\nध्रुवमार्गस्तथादित्यो ग्रहतारागणैर्युतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002906016, "chapter_id": 22906, "verse_number": "९-१९१-१७", "content_sanskrit": "देवदानवगन्धर्वा यक्ष राक्षसपन्नगाः ।\nऋषयो मुनयो गावो देवमातर एव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002906017, "chapter_id": 22906, "verse_number": "९-१९१-१८", "content_sanskrit": "सुपर्णाद्याश्च विहगा नागाश्चैरावतादयः ।\nदिग्गजाष्टकमत्रैव लेखयेन्मदमंडितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002906018, "chapter_id": 22906, "verse_number": "९-१९१-१९", "content_sanskrit": "एवंविधं पटं राजन्कारयित्वा सुशोभनम् ।\nदशोत्तरेण पयसा एतत्सर्वसमावृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002906019, "chapter_id": 22906, "verse_number": "९-१९१-२०", "content_sanskrit": "तत्तेजसा वृतं भूयो महतोग्रेण सर्वतः ।\nतेजस्तद्वायुना वायुराकाशेन समावृतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002906020, "chapter_id": 22906, "verse_number": "९-१९१-२१", "content_sanskrit": "भूतादिना तथाकाशं भूतादिर्महता तथा ।\nअव्यक्तेन महांश्चैव व्याप्तो वै शुद्धिलक्षणः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002906021, "chapter_id": 22906, "verse_number": "९-१९१-२२", "content_sanskrit": "अव्यक्तं तमसा व्याप्तं तमश्च रजसा तथा ।\nरजः सत्त्वेन संव्याप्तं त्रिधा प्रकृतिरुच्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002906022, "chapter_id": 22906, "verse_number": "९-१९१-२३", "content_sanskrit": "एवमावरणोपेतं ब्रह्मांडमखिलं नृप ।\nपुरुषेणावृतं सर्वं सबाह्याभ्यंतरं तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002906023, "chapter_id": 22906, "verse_number": "९-१९१-२४", "content_sanskrit": "एतत्सर्वं पटस्थं तु कृत्वा चित्रमयं सुधीः ।\nकार्तिक्यामयने चैव विषुवे ग्रहणेऽपि वा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002906024, "chapter_id": 22906, "verse_number": "९-१९१-२५", "content_sanskrit": "पूजयेद्येन विधिना तत्समासेन मे शृणु ।\nपुरतो मंडपं तस्य विचित्रं कारयेद्बुधः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002906025, "chapter_id": 22906, "verse_number": "९-१९१-२६", "content_sanskrit": "तत्र कुण्डानि चत्वारि चतुरस्राणि कारयेत् ।\nद्वौद्वौ नियोजयेत्तेषु ब्राह्मणौ वेदपारगौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002906026, "chapter_id": 22906, "verse_number": "९-१९१-२७", "content_sanskrit": "यज्ञोपकरणोपेतौ वस्त्राभरणभूषितौ ।\nहोमं कुर्युर्जितात्मानो मौनिनः सर्व एव ते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002906027, "chapter_id": 22906, "verse_number": "९-१९१-२८", "content_sanskrit": "पटे स्थितानां देवानां मंत्रैरोंकारपूर्वकैः ।\nयजमानस्ततः स्नातः सर्वालंकारभूषितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002906028, "chapter_id": 22906, "verse_number": "९-१९१-२९", "content_sanskrit": "आचार्येणसमं कुर्यात्पूजामग्रे पटस्य तु ।\nपुष्पैर्वस्त्रैः समभ्यर्च्य मंत्रमेतमुदीरयेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002906029, "chapter_id": 22906, "verse_number": "९-१९१-३०", "content_sanskrit": "ब्रह्मांडोदरवर्तीनि भुवनानि चतुर्दश ।\nतानि संनिहितान्यत्र पूजितानि भवंतु मे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002906030, "chapter_id": 22906, "verse_number": "९-१९१-३१", "content_sanskrit": "ब्रह्मा विष्णुस्तथा रुद्रो ह्यादित्या वसवस्तथा ।\nपूजिताः सुप्रतिष्ठाश्च भवंतु सततं मम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002906031, "chapter_id": 22906, "verse_number": "९-१९१-३२", "content_sanskrit": "एवं पटं तं संपूज्य कृत्वा चैव प्रदक्षिणम् ।\nभक्ष्यान्नानाविधांश्चैव नैवेद्यं तत्र दापयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002906032, "chapter_id": 22906, "verse_number": "९-१९१-३३", "content_sanskrit": "शंखतूर्यनिनादैश्च जागरं कारयेत्ततः ।\nब्रह्मघोषैविचित्रैश्च गीतमंगलनिस्वनैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002906033, "chapter_id": 22906, "verse_number": "९-१९१-३४", "content_sanskrit": "पुनः प्रभाते विमले स्नात्वा शुचिरलंकृतः ।\nपूर्वोक्तविधिनानेन पुनः संपूज्य तं पटम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002906034, "chapter_id": 22906, "verse_number": "९-१९१-३५", "content_sanskrit": "ऋत्विक्पूजां ततः कृत्वा गोशतेन विचक्षणः ।\nअथवा गोयुगं दद्यादेकैक स्यात्यलंकृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002906035, "chapter_id": 22906, "verse_number": "९-१९१-३६", "content_sanskrit": "उपानहौ तथा छत्रं गृहोपकरणानि च ।\nयद्यदिष्टतमं किंचित्सर्वं दद्याद्विचक्षणः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002906036, "chapter_id": 22906, "verse_number": "९-१९१-३७", "content_sanskrit": "ततः प्रकल्पयेद्यानं नागयुक्तमलंकृतम् ।\nअलाभे वाजिसंयुक्तं पताकाध्वजशालिनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002906037, "chapter_id": 22906, "verse_number": "९-१९१-३८", "content_sanskrit": "सहस्रं दक्षिणां दत्त्वा ततस्त्वारोपयेत्पटम् ।\nब्राह्मणं वा रथेनाथ नयेद्देवालयं बुधः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002906038, "chapter_id": 22906, "verse_number": "९-१९१-३९", "content_sanskrit": "तत्रस्थं स्थापयेन्नीत्वा गन्धैः पुष्पैश्च धूपयेत् ।\nतत्रापि ददयान्नैवेद्यं कुर्याच्चापि महोत्सवम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002906039, "chapter_id": 22906, "verse_number": "९-१९१-४०", "content_sanskrit": "यस्मिन्नायतने तस्य प्रतिष्ठा क्रियते नृप ।\nपूजा तत्रापि महती कर्तव्या भूतिमिच्छता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002906040, "chapter_id": 22906, "verse_number": "९-१९१-४१", "content_sanskrit": "चंद्रातपत्रं घण्टां च ध्वजाद्यं दापयेत्सुधीः ।\nयथाशक्त्या च राजेन्द्र गुरुं गौरवयंत्रितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002906041, "chapter_id": 22906, "verse_number": "९-१९१-४२", "content_sanskrit": "अभ्यर्च्य दक्षिणाभिश्च ब्राह्मणांश्च विसर्जयेत्  ।\nदीनांधकृपणानां च भोजनं चाप्यवारितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002906042, "chapter_id": 22906, "verse_number": "९-१९१-४३", "content_sanskrit": "तस्मिन्नहनि दातव्यं मित्रस्वजनबंधुषु ।\nअनेन विधिना यस्तु श्रद्दधानो जितेन्द्रियः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002906043, "chapter_id": 22906, "verse_number": "९-१९१-४४", "content_sanskrit": "कुर्यान्नरो वा नारी वा प्रतिष्ठां सार्वलौकिकीम् ।\nस्थापितं तु भवेत्तेन त्रैलोक्यं सचराचरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002906044, "chapter_id": 22906, "verse_number": "९-१९१-४५", "content_sanskrit": "कुलं च तारितं तेन सत्पुत्रेण युधिष्ठिर ।\nयावच्च देवतागारे पटस्तिष्ठति पूजितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002906045, "chapter_id": 22906, "verse_number": "९-१९१-४६", "content_sanskrit": "तावदस्याक्षया कीर्तिस्त्रैलोक्ये संप्रसर्पति ।\nदानेन कीर्तिर्यावंति मर्त्यलोकेषु गीयते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002906046, "chapter_id": 22906, "verse_number": "९-१९१-४७", "content_sanskrit": "तावद्वर्षसहस्राणि स्वर्गलोके महीयते ।\nगन्धर्वैर्गीयमानस्तु अप्सरोगणसेवितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002906047, "chapter_id": 22906, "verse_number": "९-१९१-४८", "content_sanskrit": "वसेद्धृष्टमनाः स्वर्गे यावदिंद्राश्चतु र्दश ।\nपुण्यक्षयादिहाभ्येत्य राजा भवति धार्मिकः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002906048, "chapter_id": 22906, "verse_number": "९-१९१-४९", "content_sanskrit": "पुत्रपौत्रान्वितः श्रीमान्दीर्घायुरतिधार्मिकः ।\nदश जन्मानि राजेन्द्र जायमानः पुनः पुनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002906049, "chapter_id": 22906, "verse_number": "९-१९१-५०", "content_sanskrit": "श्रूयते च पुरा राजा रजिर्नाम महाबलः ।\nचक्रवर्ती दृढमतिर्जितारिर्विजितेंद्रियः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002906050, "chapter_id": 22906, "verse_number": "९-१९१-५१", "content_sanskrit": "मही येन पुरा दत्ता देवराजस्य संगरे ।\nजित्वा दैत्यबलं सर्वं दत्तवांस्त्रिदिवं पुनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002906051, "chapter_id": 22906, "verse_number": "९-१९१-५२", "content_sanskrit": "महेन्द्राय महाभाग सर्वं निहतकंटकम् ।\nस कदाचित्सभामध्ये यावदास्ते मही पतिः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002906052, "chapter_id": 22906, "verse_number": "९-१९१-५३", "content_sanskrit": "तावत्तत्राजगामाथ पुलस्त्यो ब्रह्मणः सुतः ।\nशिष्यैः परिवृतः श्रीमान्वेदवेदांगपारगैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002906053, "chapter_id": 22906, "verse_number": "९-१९१-५४", "content_sanskrit": "दत्तार्घस्तु तदा तेन उपविष्टो वरासने ।\nशुशुभे परया लक्ष्म्या पितामह इवापरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002906054, "chapter_id": 22906, "verse_number": "९-१९१-५५", "content_sanskrit": "अथ तं पूजयित्वाग्रे मधुपर्केण पार्थिवः ।\nपप्रच्छ विनयोपेतः कथामात्मोद्भवां नृपः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002906055, "chapter_id": 22906, "verse_number": "९-१९१-५६", "content_sanskrit": "भगवन्केन दानेन तपसा नियमेन वा ।\nश्रीरियं मम धर्मज्ञ तेजश्चाव्याहतं भुवि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002906056, "chapter_id": 22906, "verse_number": "९-१९१-५७", "content_sanskrit": "बलं पुष्टिं धनं धान्यं पुत्रपौत्रं तथोत्तमम् ।\nएतन्मे सर्वमाचक्ष्व सर्वज्ञोऽसि द्विजोत्तम ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002906057, "chapter_id": 22906, "verse_number": "९-१९१-५८", "content_sanskrit": "पुलस्त्य उवाच ।\nशृणु राजन्कथामेतामात्मीयां सुमनोहराम् ।\nकथ्यमानां मया सम्यक्सप्तमे तव जन्मनि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002906058, "chapter_id": 22906, "verse_number": "९-१९१-५९", "content_sanskrit": "कथेयमभिनिर्वृत्ता शृणुष्वैश्वर्यवर्द्धिनीम् ।\nआसीस्त्वं वैश्यजातीयो वाराणस्यां नरोत्तम ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002906059, "chapter_id": 22906, "verse_number": "९-१९१-६०", "content_sanskrit": "बहुभृत्यपरीवारो धनधान्यसमन्वितः ।\nधार्मिकः सत्यनिरतो वणिग्धर्मरतः सदा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002906060, "chapter_id": 22906, "verse_number": "९-१९१-६१", "content_sanskrit": "तत्र त्वया श्रुता धर्मा धर्माख्यानगतेन वै ।\nदानाश्रया बहुविधा व्रतानि विविधानि च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002906061, "chapter_id": 22906, "verse_number": "९-१९१-६२", "content_sanskrit": "प्रसंगेन कदाचिच्च प्रतिष्ठा भौवनी त्वया ।\nश्रुता राजेन्द्र विधिवत्कृता च बहुपुण्यदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002906062, "chapter_id": 22906, "verse_number": "९-१९१-६३", "content_sanskrit": "फलेन तेन जातोऽसि सप्त जन्मानि भूपतिः ।\nकीर्तिस्ते प्रथिता लोके वलं चापि महत्तव ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002906063, "chapter_id": 22906, "verse_number": "९-१९१-६४", "content_sanskrit": "अपराण्यपि जन्मानि सप्त राजा भविष्यसि ।\nपश्चाद्योगिकुले भूत्वा निर्वाणं समवाप्स्यसि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002906064, "chapter_id": 22906, "verse_number": "९-१९१-६५", "content_sanskrit": "एतत्ते सर्वमाख्यातं यन्मां परिपृच्छसि ।\nनारी वा पुरुषो वापि प्रतिष्ठां भौवनीं तु यः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002906065, "chapter_id": 22906, "verse_number": "९-१९१-६६", "content_sanskrit": "प्रकरोति विधानेन कृतकृत्यो भवेद्बुधः ।\nइत्युक्त्वा स मुनिस्तत्र राजानं शंसितव्रतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002906066, "chapter_id": 22906, "verse_number": "९-१९१-६७", "content_sanskrit": "ययावदर्शनं तत्र सूर्ये वैश्वानरोपमः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002906067, "chapter_id": 22906, "verse_number": "९-१९१-६८", "content_sanskrit": "धर्मं विवर्द्धयति कीर्तिं शतानि धत्ते कामं प्रसाधयति पापमपाकरोति ।\nख्याता मयेयमधुना तव दाननिष्ठा तन्नास्ति यन्न कुरुते भुवनप्रतिष्ठा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]