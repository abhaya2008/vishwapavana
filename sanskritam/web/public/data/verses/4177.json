[{"id": 2147107, "chapter_id": 4177, "verse_number": "", "content_sanskrit": "सुपर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147108, "chapter_id": 4177, "verse_number": "१", "content_sanskrit": "इयं विवस्वता पूर्वं श्रौतेन विधिना किल ।\nगुरवे दक्षिणा दत्ता दक्षिणेत्युच्यते च दिक्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147109, "chapter_id": 4177, "verse_number": "२", "content_sanskrit": "अत्र लोकत्रयस्यापि पितृपक्षः प्रतिष्ठितः ।\nअत्रोष्मपाणां देवानां निवासः श्रूयते द्विज\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147110, "chapter_id": 4177, "verse_number": "३", "content_sanskrit": "अत्र विश्वे सदा देवाः पितृभिः सार्धमासते ।\nइज्यमानाः स्म लोकेषु सम्प्राप्तास्तुल्यभागताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147111, "chapter_id": 4177, "verse_number": "४", "content_sanskrit": "एतद् द्वितीयं धर्मस्य द्वारमाचक्षते द्विज ।\nत्रुटिशो लवशश्चापि गण्यते कालनिश्चयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147112, "chapter_id": 4177, "verse_number": "५", "content_sanskrit": "अत्र देवर्षयो दिव्याः पितृलोकर्षयस्तथा ।\nतथा राजर्षयः सर्वे निवसन्ति गतव्यथाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147113, "chapter_id": 4177, "verse_number": "६", "content_sanskrit": "अत्र धर्मश्च सत्यं च कर्म चात्र नियम्यते ।\nगतिरेषा द्विजश्रेष्ठ कर्मणामवसायिनाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147114, "chapter_id": 4177, "verse_number": "७", "content_sanskrit": "एषा दिक् सा द्विजश्रेष्ठ यां सर्वः प्रतिपद्यते ।\nमृतात्माऽनवबोधेन सुखं तेन न गम्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147115, "chapter_id": 4177, "verse_number": "८", "content_sanskrit": "नैर्ऋतानां सहस्राणि बहून्यत्र द्विजर्षभ ।\nसृष्टानि प्रतिकूलानि द्रष्टव्यान्यकृतात्मभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147116, "chapter_id": 4177, "verse_number": "९", "content_sanskrit": "अत्र मन्दरकुञ्जेषु विप्रर्षिसदनेषु च ।\nगायन्ति गाथा गन्धर्वाः चित्तबुद्धिहरा द्विज\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147117, "chapter_id": 4177, "verse_number": "१०", "content_sanskrit": "अत्र सामानि गाथाभिः श्रुत्वा गीतानि रैवतः ।\nगतदारो गतामात्यो गतराज्यो वनं गतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147118, "chapter_id": 4177, "verse_number": "११", "content_sanskrit": "अत्र सावर्णिना चैव यवक्रीतात्मजेन च ।\nमर्यादा स्थापिता ब्रह्मन् यां सूर्यो नातिवर्तते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147119, "chapter_id": 4177, "verse_number": "१२", "content_sanskrit": "अत्र राक्षसराजेन पौलस्त्येन महात्मना ।\nरावणेन तपश्चर्त्वा सुरेभ्योऽमरता वृता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147120, "chapter_id": 4177, "verse_number": "१३", "content_sanskrit": "अत्र वृत्तेन वृत्रोऽपि शक्रशत्रुत्वमेयिवान् ।\nअत्र सर्वासवः प्राप्ता पुनर्गच्छन्ति पञ्चधा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147121, "chapter_id": 4177, "verse_number": "१४", "content_sanskrit": "अत्र दुष्कृतकर्माणो नराः पच्यन्ति गालव ।\nअत्र वैतरणी नाम नदी पितृगणैर्वृता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147122, "chapter_id": 4177, "verse_number": "१५", "content_sanskrit": "अत्र गत्वा सुखस्यान्तं दुःखस्यान्तं प्रपद्यते ।\nअत्र वृत्तो दिनकरः सुरसं क्षरते पयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147123, "chapter_id": 4177, "verse_number": "१६", "content_sanskrit": "काष्ठां चासाद्य वासिष्ठां हिममुत्सृजते पुनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147124, "chapter_id": 4177, "verse_number": "१७", "content_sanskrit": "अत्राहं गालव पुरा क्षुधार्तः परिचिन्तयन् ।\nलब्धवान् युध्यमानौ द्वौ बृहन्तौ गजकच्छपौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147125, "chapter_id": 4177, "verse_number": "१८", "content_sanskrit": "अत्र शक्रधनुर्नाम सूर्याज्जातो महानृषिः।\nविदुर्यं कपिलं देवं येनास्ताः सगरात्मजाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147126, "chapter_id": 4177, "verse_number": "१९", "content_sanskrit": "अत्र सिद्धाः शिवा नाम ब्राह्मणा वेदपारगाः ।\nअधीत्य सकलान् वेदान् नालभन्त यमक्षयम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147127, "chapter_id": 4177, "verse_number": "२०", "content_sanskrit": "अत्र भोगवती नाम पुरी वासुकिपालिता ।\nतक्षकेण च नागेन तथैवैरावतेन च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147128, "chapter_id": 4177, "verse_number": "२१", "content_sanskrit": "अत्र निर्याणकाले हि तमः सम्प्राप्यते महत् ।\nअभेद्यं भास्करेणापि स्वयं वा कृष्णवर्त्मना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147129, "chapter_id": 4177, "verse_number": "२२", "content_sanskrit": "एष ते ख्यापितो मार्गः परितापस्य गालव ।\nब्रूहि मे यदि गन्तव्यं प्रतीचीं शृणु वा मम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147130, "chapter_id": 4177, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टोत्तरशततमोऽध्यायः ॥१०८॥\nभगवद्यानपर्वणि एकोनचत्वारिंशोऽध्यायः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]