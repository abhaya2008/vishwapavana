[{"id": 2088766, "chapter_id": 2898, "verse_number": "१३-२८-१", "content_sanskrit": "`भीष्म उवाच।\nपितामहवचः श्रुत्वा गरुडः पततांवरः।\nजगाम गोकुलं किञ्चिन्नवनीतजिहीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088767, "chapter_id": 2898, "verse_number": "१३-२८-२", "content_sanskrit": "नवनीतं तथाऽपश्यन्मथितं कलशे स्थितम्।\nतदादाय ततोऽगच्छद्यतस्तद्रक्ष्यतेऽमृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088768, "chapter_id": 2898, "verse_number": "१३-२८-३", "content_sanskrit": "स तत्र गत्वा पतगस्तिर्यक्तोयं महाबलः।\nहुताशनमपक्रम्य नवनीतमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088769, "chapter_id": 2898, "verse_number": "१३-२८-४", "content_sanskrit": "सो र्चिष्मान्मन्दवेगोऽभूत्सर्पिषा तेन तर्पितः।\nधूमकेतुर्न जज्वाल धूममेव ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088770, "chapter_id": 2898, "verse_number": "१३-२८-५", "content_sanskrit": "तमतीत्याशु गरुडो हृष्टात्मा जातवेदसम्।\nरक्षांसि समतिक्रामत्पक्षवातेन पातयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088771, "chapter_id": 2898, "verse_number": "१३-२८-६", "content_sanskrit": "ते पतन्ति शिरोभिस्च जानुभिश्चरणैस्तथा।\nउत्सृज्य शस्त्रावरणं पक्षिपक्षसमाहताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088772, "chapter_id": 2898, "verse_number": "१३-२८-७", "content_sanskrit": "उत्प्लुत्य चावृतान्नागान्हत्वा चक्रं व्यतीत्य च।\nअरान्तरेण शिरसा भित्त्वा जालं समाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088773, "chapter_id": 2898, "verse_number": "१३-२८-८", "content_sanskrit": "स भित्त्वा शिरसा जालं वज्रवेगसमो बली।\nउज्जहार ततः शीघ्रममृतं भुजगाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088774, "chapter_id": 2898, "verse_number": "१३-२८-९", "content_sanskrit": "तदादायाद्रवच्छीघ्रं गरुडः श्वसनो यथा।\nअथ सन्नाहमकरोद्वृत्रहा विबुधैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088775, "chapter_id": 2898, "verse_number": "१३-२८-१०", "content_sanskrit": "ततो मातलिसंयुक्तं हरिभिः स्वर्णमालिभिः।\nआरुरोह रथं शीघ्रं सूर्याग्निसमतेजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088776, "chapter_id": 2898, "verse_number": "१३-२८-११", "content_sanskrit": "सोऽभ्यद्रवत्पक्षिराजं वृत्रहा पाकशासनः।\nउद्यम्य निशितं वज्रं वज्रहस्तो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088777, "chapter_id": 2898, "verse_number": "१३-२८-१२", "content_sanskrit": "तथैव गरुडो राजन्वज्रहस्तं समाद्रवत्।\nततो वै मातलिं प्राह शीघ्रं वाहय वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088778, "chapter_id": 2898, "verse_number": "१३-२८-१३", "content_sanskrit": "अथ दिव्यं महाघोरं गरुडाय ससर्ज ह।\nवज्रं सहस्रनयनस्तिग्मवेगपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088779, "chapter_id": 2898, "verse_number": "१३-२८-१४", "content_sanskrit": "उत्सिसृक्षन्तमाज्ञाय वज्रं वै त्रिदशेश्वरम्।\nतूर्णं वेगपरो भूत्वा जगाम पततांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088780, "chapter_id": 2898, "verse_number": "१३-२८-१५", "content_sanskrit": "पितामहनिसर्गेण ज्ञात्वा लब्धवरः खगः।\nआयुधानां वरं वज्रमथ शक्रमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088781, "chapter_id": 2898, "verse_number": "१३-२८-१६", "content_sanskrit": "वृत्रहन्नेष वज्रस्ते वरो लब्धः पितामहात्।\nअतः सम्मानमाकाङ्क्षन्मुञ्चाम्येकं तनूरुहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088782, "chapter_id": 2898, "verse_number": "१३-२८-१७", "content_sanskrit": "एतेनायुधराजेन यदि शक्तोसि वृत्रहन्।\nहन्यास्त्वं परया शक्तया गच्छाम्यहमनामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088783, "chapter_id": 2898, "verse_number": "१३-२८-१८", "content_sanskrit": "तत्तु तूर्णं तदा वज्रं स्वेन वेगेन भारत।\nजघान परया शक्त्या न चैनमदहद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088784, "chapter_id": 2898, "verse_number": "१३-२८-१९", "content_sanskrit": "ततो देवर्षयो राजन्गच्छन्तो वै विहायसा।\nदृष्ट्वा वज्रं विवक्तं तं पक्षइपर्णेऽब्रुवन्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088785, "chapter_id": 2898, "verse_number": "१३-२८-२०", "content_sanskrit": "सुपर्णः पक्षिगरुडो यस्य पर्णे वरायुधम्।\nविषक्तं देवराजस्य वृत्रहन्तुः सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088786, "chapter_id": 2898, "verse_number": "१३-२८-२१", "content_sanskrit": "एवं सुपर्णो विहगो वैनतेयः प्रतापवान्।\nऋषयस्तं विजानन्ति चाग्नेयं वैष्णवं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088787, "chapter_id": 2898, "verse_number": "१३-२८-२२", "content_sanskrit": "वेदाभिष्टुतमत्यर्थं स्वर्गमार्गफलप्रदम्।\nतनुपर्णं सुपर्णस्य जगृहुर्बर्हिणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088788, "chapter_id": 2898, "verse_number": "१३-२८-२३", "content_sanskrit": "मयूराविस्मिताः सर्वे आद्रवन्ति स्म वज्रिणम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088789, "chapter_id": 2898, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टाविंशोऽध्यायः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]