[{"id": 2096747, "chapter_id": 3075, "verse_number": "१३-२०५-१", "content_sanskrit": "नारद उवाच।\nभगवंस्तीर्थयात्रार्थं तथैव चरता मया।\nदिव्यमद्भुतसङ्काशं दृष्टं हैमवतं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096748, "chapter_id": 3075, "verse_number": "१३-२०५-२", "content_sanskrit": "नानावृक्षसमायुक्तं नानापक्षिगणैर्वृतम्।\nनानरत्नगणाकीर्णं नानाभावसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096749, "chapter_id": 3075, "verse_number": "१३-२०५-३", "content_sanskrit": "दिव्यचन्दनसंयुक्तं दिव्यधूपेन धूपितम्।\nदिव्यपुष्पसमाकीर्णं दिव्यगन्धेन वासितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096750, "chapter_id": 3075, "verse_number": "१३-२०५-४", "content_sanskrit": "सिद्धचारणसंघातैर्भूतसङ्घैर्निषेवितम्।\nवरिष्ठाप्सरसाकीर्णं नागगन्धर्वसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096751, "chapter_id": 3075, "verse_number": "१३-२०५-५", "content_sanskrit": "मृदङ्गमुरजोद्धुष्टं शङ्खवीणाभिनादितम्।\nनृत्यद्भिर्भूतसङ्घैश्च सर्वतस्त्वभिशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096752, "chapter_id": 3075, "verse_number": "१३-२०५-६", "content_sanskrit": "नानारूपैर्विरूपैश्च भीमरूपैर्भयानकैः।\nसिंहव्याघ्रोरगमृगैर्बिडालवदनैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096753, "chapter_id": 3075, "verse_number": "१३-२०५-७", "content_sanskrit": "स्वरोष्ट्रद्वीपिवदनैर्गजवक्त्रैस्तथैव च।\nउलूकश्येनवदनैः काकगृध्रमुखैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096754, "chapter_id": 3075, "verse_number": "१३-२०५-८", "content_sanskrit": "एवं बहुविधाकारैर्भूतसङ्घैर्भृशाकुलम्।\nनानद्यमानं बहुधा हरपारिषदैर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096755, "chapter_id": 3075, "verse_number": "१३-२०५-९", "content_sanskrit": "घोररूपं सुदुर्दर्शं रक्षोगणशतैर्वृतम्।\nसमाजं तद्वने दृष्टं मया भूतपतेः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096756, "chapter_id": 3075, "verse_number": "१३-२०५-१०", "content_sanskrit": "प्रनृत्ताप्सरसं दिव्यं देवगन्धर्वनादितम्।\nप्रथमे वर्षरात्रे तु मेघसङ्घनिनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096757, "chapter_id": 3075, "verse_number": "१३-२०५-११", "content_sanskrit": "नानाबर्हिणसंघुष्टं गजयूथसमाकुलम्।\nषट्पदैरुपगीतं च प्रथमे मासि माधवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096758, "chapter_id": 3075, "verse_number": "१३-२०५-१२", "content_sanskrit": "उत्क्रोशत्क्रौञ्चकुररैः सारसैर्जीवजीवकैः।\nमत्ताभिः परपुष्टाभिः कूजन्तीभिः समाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096759, "chapter_id": 3075, "verse_number": "१३-२०५-१३", "content_sanskrit": "उत्तमावाससङ्काशं भीमरूपतरं ततः।\nद्रष्टुं भवति धर्मस्य धर्मभागिजनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096760, "chapter_id": 3075, "verse_number": "१३-२०५-१४", "content_sanskrit": "ये चोध्वरेतसः सिद्धास्तत्रतत्र समागताः।\nमार्ताण्डरश्मिसञ्चारा विश्वेदेवगणास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096761, "chapter_id": 3075, "verse_number": "१३-२०५-१५", "content_sanskrit": "तथा नागास्तथा दिव्या लोकपाला हुताशनाः।\nवाताश्च सर्वे चायान्ति दिव्यपुष्पसमाकुलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096762, "chapter_id": 3075, "verse_number": "१३-२०५-१६", "content_sanskrit": "किरन्तः सर्वपुष्पाणि किरन्तोऽद्भुतदर्शनाः।\nओषध्यः प्रज्वलन्त्यश्च द्योतयन्त्यो दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096763, "chapter_id": 3075, "verse_number": "१३-२०५-१७", "content_sanskrit": "विहगाश्च मुदा युक्ता नृत्यन्ति च नदन्ति च।\nततः समन्ततस्तत्र दिव्या दिव्यजनप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096764, "chapter_id": 3075, "verse_number": "१३-२०५-१८", "content_sanskrit": "तत्र देवो गिरितटे हेमधातुविभूषिते।\nपर्यङ्क इव बभ्राज उपविष्टो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096765, "chapter_id": 3075, "verse_number": "१३-२०५-१९", "content_sanskrit": "व्याघ्रचर्मपरीधानो गजचर्मोत्तरच्छदः।\nव्यालयज्ञोपवीतश्च लोहितान्त्रविभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096766, "chapter_id": 3075, "verse_number": "१३-२०५-२०", "content_sanskrit": "हरिश्मश्रुजटो भीमो भयकर्ताऽमरद्विषाम्।\nभयहेतुरभक्तानां भक्तानामभयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096767, "chapter_id": 3075, "verse_number": "१३-२०५-२१", "content_sanskrit": "किन्नरैर्देवगन्धर्वैः स्तूयमानस्ततस्ततः।\nऋषिभिश्चाप्सरोभिश्च सर्वतश्चैव शोभितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096768, "chapter_id": 3075, "verse_number": "१३-२०५-२२", "content_sanskrit": "तत्र भूतपतेः स्थानं देवदानवसङ्कुलम्।\nसर्वतेजोमयं भूम्ना लोकपालनिषेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096769, "chapter_id": 3075, "verse_number": "१३-२०५-२३", "content_sanskrit": "महोरगसमाकीर्णं सर्वेषां रोमहर्षणम्।\nभीमरूपमनिर्देश्यमप्रधृष्यतमं विभोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096770, "chapter_id": 3075, "verse_number": "१३-२०५-२४", "content_sanskrit": "तत्र भूतपतिं देवमासीनं शिखरोत्तमे।\nऋषयो भूतसङ्घाश्च प्रणम्य शिरसा हरम्।\nगीर्भिः परमशुद्धाभिस्तुष्टुवुस्च मनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096771, "chapter_id": 3075, "verse_number": "१३-२०५-२५", "content_sanskrit": "विमुक्ताश्चैव पापेभ्यो बभूवुर्विगतज्वराः।\nऋषयो बालकिल्याश्च तथा विप्रर्षयश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096772, "chapter_id": 3075, "verse_number": "१३-२०५-२६", "content_sanskrit": "अयोनिजा योनिजाश्च तपःसिद्धा महर्षयः।\nततस्तं देवदेवेशं भगवन्तमुपासते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096773, "chapter_id": 3075, "verse_number": "१३-२०५-२७", "content_sanskrit": "ततस्तस्मिन्क्षणे देवी भूतस्त्रीगणसंवृता।\nहरतुल्याम्बरधरा समानव्रतचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096774, "chapter_id": 3075, "verse_number": "१३-२०५-२८", "content_sanskrit": "काञ्चनं कलशं गृह्य सर्वतीर्थाम्बुपूरितम्।\nपुष्पवृष्ट्याऽभिवर्षन्ती दिव्यगन्धसमावृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096775, "chapter_id": 3075, "verse_number": "१३-२०५-२९", "content_sanskrit": "सरिद्वराभिः सर्वाभिः पृष्ठतोऽनुगता वरा।\nसेवितुं भगवत्पार्श्वमाजगाम शुचिस्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096776, "chapter_id": 3075, "verse_number": "१३-२०५-३०", "content_sanskrit": "आगम्य तु गिरेः पुत्री देवदेवस्य चान्तिकम्।\nमनःप्रियं चिकीर्षन्ती क्रीडार्थं शङ्करान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096777, "chapter_id": 3075, "verse_number": "१३-२०५-३१", "content_sanskrit": "मनोहराभ्यां पाणिभ्यां हरनेत्रे पिधाय तु।\nअवेक्ष्य हृष्टा स्वगणान्स्मयन्ती पृष्ठतः स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096778, "chapter_id": 3075, "verse_number": "१३-२०५-३२", "content_sanskrit": "देव्या चान्धीकृते देवे कश्मलं समपद्यत।\nनिमीलिते भूतपतौ नष्टचन्द्रार्कतारकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096779, "chapter_id": 3075, "verse_number": "१३-२०५-३३", "content_sanskrit": "निःस्वाध्यायवषट्कारं तमसा चाभिसंवृतम्।\nविषण्णं भयवित्रस्तं जगदासीद्भयाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096780, "chapter_id": 3075, "verse_number": "१३-२०५-३४", "content_sanskrit": "हाहाकारमृषीणां च लोकानामभवत्तदा।\nतमोभिभूते सम्भ्रान्ते लोके जीवनसंक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096781, "chapter_id": 3075, "verse_number": "१३-२०५-३५", "content_sanskrit": "तृतीयं चास्य सम्भूतं ललाटे नेत्रमायतम्।\nद्वादशादित्यसङ्काशं लोकान्भासाऽवभासयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096782, "chapter_id": 3075, "verse_number": "१३-२०५-३६", "content_sanskrit": "तत्रक तेनाग्निना तेन युगान्ताग्निनिभेन वै।\nअदह्यत गिरिः सर्वो हिमवानग्रतः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096783, "chapter_id": 3075, "verse_number": "१३-२०५-३७", "content_sanskrit": "दह्यमाने गिरौ तस्मिन्मृगपक्षिसमाकुले।\nसविद्याधरगन्धर्वे दिव्यौषधसमाकुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096784, "chapter_id": 3075, "verse_number": "१३-२०५-३८", "content_sanskrit": "ततो गिरिसुता चापि विस्मयोत्फुल्ललोचना।\nबभूव च जगत्सर्वं तथा विस्मयसंयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096785, "chapter_id": 3075, "verse_number": "१३-२०५-३९", "content_sanskrit": "पश्यतामेव सर्वेषां देवदानवरक्षसाम्।\nनेत्रजेनाग्निना तेन दग्ध एव नगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096786, "chapter_id": 3075, "verse_number": "१३-२०५-४०", "content_sanskrit": "तं दृष्ट्वा मथितं शैलं शैलपुत्री सविक्लवा।\nपितुः सम्मानमिच्छन्ती पपात भुवि पादूयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096787, "chapter_id": 3075, "verse_number": "१३-२०५-४१", "content_sanskrit": "तं दृष्ट्वा देवदेवेशो देव्या दुःखमनुत्तमम्।\nहैमवत्याः प्रियार्थं च गिरिं पुनरवैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096788, "chapter_id": 3075, "verse_number": "१३-२०५-४२", "content_sanskrit": "दृष्टमात्रे भगवता सौम्ययुक्तेन चेतसा।\nक्षणेन हिमवाञ्शैलः प्रकृतिस्थोऽभवत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2096789, "chapter_id": 3075, "verse_number": "१३-२०५-४३", "content_sanskrit": "हृष्टपुष्टविहङ्गैश्च प्रफुल्लद्रुमकाननः।\nसिद्धचारणसङ्घैश्च प्रीतियुक्तैः समाकुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096790, "chapter_id": 3075, "verse_number": "१३-२०५-४४", "content_sanskrit": "पितरं प्रकृतिस्थं च दृष्ट्वा हैमवती भृशम्।\nअभवत्प्रीतिसंयुक्ता मुदितात्र पिनाकिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2096791, "chapter_id": 3075, "verse_number": "१३-२०५-४५", "content_sanskrit": "देवी विस्मयसंयुक्ता प्रष्टुकामा महेश्वरम्।\nहितार्तं सर्वलोकानां प्रजानां हितकाम्यया।\nदेवदेवं महादेवी बभाषेदं वचोऽर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2096792, "chapter_id": 3075, "verse_number": "१३-२०५-४६", "content_sanskrit": "भगवन्देवदेवेश शूलपाणे महाद्युते।\nविस्मयो मे महाञ्जातस्तस्मिन्नेत्राग्निसम्भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2096793, "chapter_id": 3075, "verse_number": "१३-२०५-४७", "content_sanskrit": "किमर्थं देवदेवेश ललाटेऽस्मिन्प्रकाशते।\nअतिसूर्याग्निसङ्काशं तृतीयं नेत्रमायतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2096794, "chapter_id": 3075, "verse_number": "१३-२०५-४८", "content_sanskrit": "नेत्राग्निना तु महता निर्दग्धो हिमवानसौ।\nपुनः संदृष्टमात्रस्तु प्रकृतिस्थः पिता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2096795, "chapter_id": 3075, "verse_number": "१३-२०५-४९", "content_sanskrit": "एष मे संशयो देव हृदि मे सम्प्रवर्तते।\nदेवदेव नमस्तुभ्यं तन्मे संसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2096796, "chapter_id": 3075, "verse_number": "१३-२०५-५०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2096797, "chapter_id": 3075, "verse_number": "१३-२०५-५०", "content_sanskrit": "एवमुक्तस्तया देव्या प्रीयमाणोऽब्रवीद्भवः।\nस्थाने संशयितुं देवि धर्मज्ञे प्रियभाषिणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2096798, "chapter_id": 3075, "verse_number": "१३-२०५-५१", "content_sanskrit": "त्वदृते मां हि वै प्रष्टुं न शक्यं केन चेत्प्रिये।\nप्रकाशं यदि वा गुह्यं प्रियार्थं प्रब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2096799, "chapter_id": 3075, "verse_number": "१३-२०५-५२", "content_sanskrit": "शृणु तत्सर्वमकिलमस्यां संसदि भामिनि।\nसर्वेषामेव लोकानां कूटस्थं विद्धि मां प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2096800, "chapter_id": 3075, "verse_number": "१३-२०५-५३", "content_sanskrit": "मदधीनास्त्रयो लोका यथा विष्णौ तथा मयि।\nस्रष्टा विष्णुरहं गोप्ता इत्येतद्विद्धि भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2096801, "chapter_id": 3075, "verse_number": "१३-२०५-५४", "content_sanskrit": "तस्माद्यदा मां स्पृशति शुभं वा यदि वेतरत्।\nतथैवेदं जगत्सर्वं तत्तद्भवति शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2096802, "chapter_id": 3075, "verse_number": "१३-२०५-५५", "content_sanskrit": "एतद्गुह्यमजानन्त्या त्वया बाल्यादनिन्दिते।\nमन्नेत्रे पिहिते देवि क्रीडनार्थं दृढव्रते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2096803, "chapter_id": 3075, "verse_number": "१३-२०५-५६", "content_sanskrit": "तत्कृते नष्टचन्द्रार्कं जगदासीद्भयाकुलम्।\nनष्टादित्ये तमोभूते लोके गिरिसुते प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2096804, "chapter_id": 3075, "verse_number": "१३-२०५-५७", "content_sanskrit": "तृतीयं लोचनं सृष्टं लोकं संरक्षितुं मया।\nकथितं संशयस्थानं निर्विशङ्का भव प्रिये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2096805, "chapter_id": 3075, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चाधिकद्विशततमोऽध्यायः॥ २०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]