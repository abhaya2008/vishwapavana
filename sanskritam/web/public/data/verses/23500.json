[{"id": 7003500000, "chapter_id": 23500, "verse_number": "१४०-१", "content_sanskrit": "अथ कोकामुख(बदरी) माहात्म्यम् ।\nधरण्युवाच ।\nश्रुतानि देवस्थानानि त्वया प्रोक्तानि यान्युत ।\nकस्मिंस्तिष्ठसि नित्यं त्वं तद्भवान्वक्तुमर्हति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003500001, "chapter_id": 23500, "verse_number": "१४०-२", "content_sanskrit": "किंच ते परमं स्थानं यत्र मूर्त्त्याकृतिर्भवान् ।\nकस्मिन्स्थाने कृतं कर्म येन यात्युत्तमां गतिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003500002, "chapter_id": 23500, "verse_number": "१४०-३", "content_sanskrit": "श्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि भक्तानां भक्तवत्सले ।\nयेषु स्थानेषु तिष्ठामि कथ्यमानानिमाञ्छृणु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003500003, "chapter_id": 23500, "verse_number": "१४०-४", "content_sanskrit": "तव कोकामुखं नाम यन्मया पूर्वभाषितम् ।\nबदरीति च विख्यातं गिरिराजशिलातलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003500004, "chapter_id": 23500, "verse_number": "१४०-५", "content_sanskrit": "स्थानं लोहार्गलं नाम म्लेच्छराजसमाश्रितम् ।\nक्षणं चापि न मुंचामि एवमेतन्न संशयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003500005, "chapter_id": 23500, "verse_number": "१४०-६", "content_sanskrit": "सचैत्यं पश्य मे स्थानं जगदेतच्चराचरम् ।\nसर्वत्राहं वरारोहे न मन्न्यूनं हि जानते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003500006, "chapter_id": 23500, "verse_number": "१४०-७", "content_sanskrit": "ये तु जानन्ति मां देवि गुह्यां कामगतिं मम ।\nशीघ्रं कोकामुखं यान्तु मम कर्मपरायणाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003500007, "chapter_id": 23500, "verse_number": "१४०-८", "content_sanskrit": "ततो देववचः श्रुत्वा पृथिवी वाक्यमब्रवीत् ।\nशिरस्यञ्जलिमाधाय निर्वृतेनान्तरात्मना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003500008, "chapter_id": 23500, "verse_number": "१४०-९", "content_sanskrit": "धरण्युवाच ।\nसर्वतो लोकनाथेश परं कौतूहलं हि मे ।\nकथं कोकामुखं श्रेष्ठं तद्भवान्वक्तुमर्हसि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003500009, "chapter_id": 23500, "verse_number": "१४०-१०", "content_sanskrit": "श्रीवराह उवाच ।\nनास्ति कोकामुखात्क्षेत्रं श्रेष्ठं कोकामुखाच्छुचि ।\nनास्ति कोकामुखात्स्थानं नास्ति कोकामुखात्प्रियम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003500010, "chapter_id": 23500, "verse_number": "१४०-११", "content_sanskrit": "यस्तु कोकामुखं गत्वा  भूयो विनिवर्त्तते ।\nकर्माणि तत्र कुर्वीत चेष्टं भवति चात्मनि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003500011, "chapter_id": 23500, "verse_number": "१४०-१२", "content_sanskrit": "यानि यानि च क्षेत्राणि त्वया पृष्टानि वै धरे।.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003500012, "chapter_id": 23500, "verse_number": "१४०-१३", "content_sanskrit": "कोकामुखसमं स्थानं न भूतं न भविष्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003500013, "chapter_id": 23500, "verse_number": "१४०-१४", "content_sanskrit": "मम सा परमा मूर्त्तिर्यां न जानन्ति गोपिताम् ।\nस्थितं कोकामुखं नाम एतत्ते कथितं मया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003500014, "chapter_id": 23500, "verse_number": "१४०-१५", "content_sanskrit": "श्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि यन्मां त्वं परिपृच्छसि ।\nतस्मिन् कोकामुखं रम्यं कथ्यमानं मयाऽनघे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003500015, "chapter_id": 23500, "verse_number": "१४०-१६", "content_sanskrit": "जलबिन्दुरिति ख्यातात्पर्वतात्पत्तनाद्भुवि ।\nतत्तु गुह्यतमं देवि कृत्वा कर्म महौजसम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003500016, "chapter_id": 23500, "verse_number": "१४०-१७", "content_sanskrit": "सर्वसङ्गान्परित्यज्य मम लोकं स गच्छति ।\nविष्णुधारेति विख्याता कोकायां मम मण्डले ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003500017, "chapter_id": 23500, "verse_number": "१४०-१८", "content_sanskrit": "पर्वतात्पतिता भूमौ धारा मुसलसन्निभा ।\nअहोरात्रोषितो भूत्वा स्नायात्तत्र प्रयत्नतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003500018, "chapter_id": 23500, "verse_number": "१४०-१९", "content_sanskrit": "अग्निष्टोमसहस्राणां फलं प्राप्नोति मानवः।.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003500019, "chapter_id": 23500, "verse_number": "१४०-२०", "content_sanskrit": "न मुह्यति स कर्त्तव्ये फलं प्राप्नोति चोत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003500020, "chapter_id": 23500, "verse_number": "१४०-२१", "content_sanskrit": "जायते विपुले शुद्धे मम मार्गानुसारिणि ।\nतत्राथ मुंचति प्राणान्विष्णुधारां समाश्रितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003500021, "chapter_id": 23500, "verse_number": "१४०-२२", "content_sanskrit": "पश्यते परमां मूर्त्तिमेतां मम न संशयः ।\nतत्र विष्णुपदं नाम स्थानं कोकामुकाश्रितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003500022, "chapter_id": 23500, "verse_number": "१४०-२३", "content_sanskrit": "एतत्कश्चिन्न जानाति धरे वाराहसंश्रितम् ।\nतस्मिन्कृतोदको देवि नरो रात्रावुपोषितः॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003500023, "chapter_id": 23500, "verse_number": "१४०-२४", "content_sanskrit": "क्रौंचद्वीपे प्रजायेत मम भक्तिपरायणः ।\nतत्राथ मुंचति प्राणान्गुह्यस्थाने परे मम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003500024, "chapter_id": 23500, "verse_number": "१४०-२५", "content_sanskrit": "सर्वसङ्गान्परित्यज्य मम लोके स गच्छति।\nअस्ति विष्णुसरो नाम क्रीडितं यत्त्वया सह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003500025, "chapter_id": 23500, "verse_number": "१४०-२६", "content_sanskrit": "यत्र दंष्ट्राप्रहारेण चाहृतासि वसुन्धरे ।\nतत्र स्नानं तु कुर्वीत प्रातःकाले वसुन्धरे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003500026, "chapter_id": 23500, "verse_number": "१४०-२७", "content_sanskrit": "सर्वपापविशुद्धात्मा मम लोकं स गच्छति ।\nसोमतीर्थमिति ख्यातं कोकायां मम मण्डले ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003500027, "chapter_id": 23500, "verse_number": "१४०-२८", "content_sanskrit": "यत्र पञ्चशिलाभूभिर्विष्णुनाम्ना तथाङ्किता ।\nयस्तत्र कुरुते स्नानं पञ्चरात्रोषितो नरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003500028, "chapter_id": 23500, "verse_number": "१४०-२९", "content_sanskrit": "गोमेदे जायते द्वीपे मम मार्गानुसारकः ।\nतत्राथ मुञ्चते प्राणन्गुह्यक्षेत्रे परे मम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003500029, "chapter_id": 23500, "verse_number": "१४०-३०", "content_sanskrit": "सर्वपापविनिर्मुक्तः शुद्धात्मा मां स पश्यति ।\nतुंगकूटेतिविख्यातं कोकायां मम मण्डले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003500030, "chapter_id": 23500, "verse_number": "१४०-३१", "content_sanskrit": "चतुर्धाराः पतन्त्यत्र पर्वतादुच्छ्रयं श्रिताः ।\nयस्तत्र कुरुते स्नानं पञ्चरात्रोषितो नरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003500031, "chapter_id": 23500, "verse_number": "१४०-३२", "content_sanskrit": "कुशद्वीपं समासाद्य मम लोकेषु तिष्ठति ।\nअनित्यमाश्रमं नाम क्षेत्रकर्मसुखावहम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003500032, "chapter_id": 23500, "verse_number": "१४०-३३", "content_sanskrit": "देवाश्च यं न जानन्ति किम्पुनर्मनुजादयः ।\nतत्र स्नात्वा वरारोहे अहोरात्रोषितो नरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003500033, "chapter_id": 23500, "verse_number": "१४०-३४", "content_sanskrit": "जायते पुष्करद्वीपे मम कर्मपरायणः ।\nअथ तत्र मृतो भूमे पुण्यक्षेत्रे महाशुचिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003500034, "chapter_id": 23500, "verse_number": "१४०-३५", "content_sanskrit": "सर्वपापविनिर्मुक्तो मम लोकं स गच्छति ।\nअस्त्यत्राग्निसरो नाम परं गुह्यं मम स्थितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003500035, "chapter_id": 23500, "verse_number": "१४०-३६", "content_sanskrit": "पंच धाराः पतन्त्यत्र गिरिकुञ्जसमाश्रिताः ।\nतत्र चापि कृतस्नानः पञ्चरात्रोषितो नरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003500036, "chapter_id": 23500, "verse_number": "१४०-३७", "content_sanskrit": "कुशद्वीपे च जायेत मम कर्मपरायणः ।\nतत्राथ मुञ्चते प्राणान् कृत्वा कर्म महौजसम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003500037, "chapter_id": 23500, "verse_number": "१४०-३८", "content_sanskrit": "कुशद्वीपात्परिभ्रष्टो ब्रह्मलोकं स गच्छति।\nअस्ति ब्रह्मसरो नाम गुह्यं क्षेत्रं परं मम ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003500038, "chapter_id": 23500, "verse_number": "१४०-३९", "content_sanskrit": "यत्र धारा पतत्येका पुण्या भूमिशिलातले।\nतत्र स्नानं प्रकुर्वीत पञ्चरात्रोषितो नरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003500039, "chapter_id": 23500, "verse_number": "१४०-४०", "content_sanskrit": "वसते सूर्यलोकेषु मम मार्गानुसारकः ।\nअथाऽत्र मुंचते प्राणान्सूर्यधारां समाश्रितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003500040, "chapter_id": 23500, "verse_number": "१४०-४१", "content_sanskrit": "सूर्यलोकमतिक्रम्य मम लोकं तु गच्छति ।\nअस्ति धेनुवटं नाम गुह्यं क्षेत्रं परं मम ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003500041, "chapter_id": 23500, "verse_number": "१४०-४२", "content_sanskrit": "एका धारा पतत्यत्र देवि पूर्णा शिलोच्चयात् ।\nतत्र स्नानं प्रकुर्वीत एकमेकं दिनं तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003500042, "chapter_id": 23500, "verse_number": "१४०-४३", "content_sanskrit": "सप्तरात्रोषितो भूत्वा मम कर्म समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003500043, "chapter_id": 23500, "verse_number": "१४०-४४", "content_sanskrit": "स्नात्वा सप्तसमुद्रेषु लब्धसंज्ञः समाहितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003500044, "chapter_id": 23500, "verse_number": "१४०-४५", "content_sanskrit": "सप्तद्वीपेषु विहरेन्मम कर्मपरायणः ।\nतत्राथ मुंचते प्राणान्मम भक्तिसमन्वितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003500045, "chapter_id": 23500, "verse_number": "१४०-४६", "content_sanskrit": "सप्तद्वीपमतिक्रम्य मम लोकं तु गच्छति ।\nअस्ति धर्मोद्भवं नाम तस्मिन्क्षेत्रे परे मम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003500046, "chapter_id": 23500, "verse_number": "१४०-४७", "content_sanskrit": "गिरिकुञ्जात्पतत्येका धारा भूमितले शुभा ।\nतत्र स्नानं प्रकुर्वीत एकरात्रोषितो नरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003500047, "chapter_id": 23500, "verse_number": "१४०-४८", "content_sanskrit": "स वैश्यो जायते शूद्रो मम कर्मपरायणः ।\nतत्राऽथ मुंचते प्राणान्गुह्ये देवि शिलोच्चये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003500048, "chapter_id": 23500, "verse_number": "१४०-४९", "content_sanskrit": "सांगयज्ञं सदक्षिण्यं भुक्त्वा मां प्रतिपद्यते ।\nअस्ति कोटिवटं नाम क्षेत्रं गुह्यं परं मम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003500049, "chapter_id": 23500, "verse_number": "१४०-५०", "content_sanskrit": "एका धारा पतत्यत्र वटमूलमुपाश्रिता ।\nतत्र स्नानं तु कुरुते नरो रात्रावुपोषितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003500050, "chapter_id": 23500, "verse_number": "१४०-५१", "content_sanskrit": "यावन्ति वटपत्राणि तस्मिञ्छृंगे परे मम ।\nतावद्वर्षसहस्राणि रूपसंपत्समन्वितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003500051, "chapter_id": 23500, "verse_number": "१४०-५२", "content_sanskrit": "तिष्ठते तु वरारोहे मम मार्गानुसारिणि ।\nतत्राऽथ मुंचते प्राणान्कृत्वा कर्म सुदुष्करम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003500052, "chapter_id": 23500, "verse_number": "१४०-५३", "content_sanskrit": "अग्निवर्णस्ततो भूत्वा मम लोकं स गच्छति।\nपापप्रमोचनं नाम गुह्यमस्मिन्परं मम ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003500053, "chapter_id": 23500, "verse_number": "१४०-५४", "content_sanskrit": "पतत्येकतमा धारा स्थूला कुंभसमा ततः।\nयस्तत्र कुरुते स्नानमहोरात्रोषितो नरः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003500054, "chapter_id": 23500, "verse_number": "१४०-५५", "content_sanskrit": "जायते च चतुर्वेदी मम कर्मपरायणः ।\nतत्राऽथ मुञ्चते प्राणान्कौशिकीमाश्रितो नदीम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003500055, "chapter_id": 23500, "verse_number": "१४०-५६", "content_sanskrit": "यस्तत्र कुरुते स्नानं पंचरात्रोषितो नरः ।\nमोदते वासवे लोके मम मार्गानुसारिणि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003500056, "chapter_id": 23500, "verse_number": "१४०-५७", "content_sanskrit": "तत्राथ मुंचते प्राणान्मम कर्मपरायणः ।\nवासवं लोकमुत्सृज्य मम लोक च गच्छति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003500057, "chapter_id": 23500, "verse_number": "१४०-५८", "content_sanskrit": "यमव्यसनकं नाम गुह्यमस्ति परं मम ।\nस्रोतो वहति तत्रैकं कौशिकीमाश्रितं नदीम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003500058, "chapter_id": 23500, "verse_number": "१४०-५९", "content_sanskrit": "यस्तत्र कुरुते स्नानमेकरात्रोषितो नरः ।\nन स गच्छति दुर्गाणि यमस्य व्यसनं महत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003500059, "chapter_id": 23500, "verse_number": "१४०-६०", "content_sanskrit": "अथ तत्र त्यजेत्प्राणान्मम कर्मपरायणः ।\nविशुद्धो मुक्तपापोऽसौ मम लोकं स गच्छति ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003500060, "chapter_id": 23500, "verse_number": "१४०-६१", "content_sanskrit": "मातंगं नाम विख्यातं तस्मिन्क्षेत्रे  परं मम ।\nस्रोतो वहति तत्रैव आश्रितं कौशिकीं नदीम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003500061, "chapter_id": 23500, "verse_number": "१४०-६२", "content_sanskrit": "स्नानं कुर्वंति ये तत्र एकरात्रोषिता नराः ।\nभेदं किम्पुरुषं प्राप्य जायते नात्र संशयः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003500062, "chapter_id": 23500, "verse_number": "१४०-६३", "content_sanskrit": "विद्वाञ्छुचिश्च जायेत ममकमार्नुसारकः ।\nतत्राऽथ मुंचते प्राणान्गुह्ये देवि परे मम ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003500063, "chapter_id": 23500, "verse_number": "१४०-६४", "content_sanskrit": "मुक्त्वा किम्पुरुषं भेदं  मम लोकं च गच्छति।\nअस्ति वज्रभवं नाम गुह्ये तस्मिन्परं मम ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003500064, "chapter_id": 23500, "verse_number": "१४०-६५", "content_sanskrit": "स्रोतो वहति तत्रैकमाश्रितं कौशिकीं नदीम् ।\nस्नानं करोति यस्तत्र एकरात्रोषितो नरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003500065, "chapter_id": 23500, "verse_number": "१४०-६६", "content_sanskrit": "जायते शक्रलोके तु मम कर्मानुसारकः ।\nशरीरचक्रसङ्घाते वज्रहस्तस्वरूपकः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003500066, "chapter_id": 23500, "verse_number": "१४०-६७", "content_sanskrit": "तत्र स्नानप्रभावेण जायते नात्र संशयः।\nअथाऽत्र मुच्यते प्राणान्मम चिन्तनतत्परः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003500067, "chapter_id": 23500, "verse_number": "१४०-६८", "content_sanskrit": "शक्रलोकमतिक्रम्य मम लोकं प्रपद्यते ।\nतत्र त्रिक्रोशमात्रेण गुह्यं क्षेत्रं परं मम ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003500068, "chapter_id": 23500, "verse_number": "१४०-६९", "content_sanskrit": "शक्ररुद्रेति विख्यातं तस्मिन्कोकाशिलातले ।\nस्नानं करोति यस्तत्र त्रिरात्रोपोषितो नरः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003500069, "chapter_id": 23500, "verse_number": "१४०-७०", "content_sanskrit": "जम्बू द्वीपे प्रजायेत जम्बूर्यत्र प्रतिष्ठिता ।\nजंबूद्वीपं परित्यज्य जायते मम पार्श्वगः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003500070, "chapter_id": 23500, "verse_number": "१४०-७१", "content_sanskrit": "अस्ति चान्यन्महद्भद्रे क्षेत्रे गुह्ये विशेषितम् ।\nमनुजा येन गच्छन्ति मुक्त्वा संसारसागरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003500071, "chapter_id": 23500, "verse_number": "१४०-७२", "content_sanskrit": "दंष्ट्रांकुरेति विख्यातं यत्र कोका विनिःसृता ।\nएतद्गुह्य न जानन्ति यतो मुंचंति जन्तवः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003500072, "chapter_id": 23500, "verse_number": "१४०-७३", "content_sanskrit": "कृतोदकस्तत्र भद्रे अहोरात्रोषितो नरः ।\nजायते शाल्मलिद्वीपे मम कर्मानुसारिणि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003500073, "chapter_id": 23500, "verse_number": "१४०-७४", "content_sanskrit": "तत्राथ मुंचते प्राणान्मम कर्मसु निष्ठितः।\nशाल्मलिद्वीपमुत्सृज्य मम पार्श्वे स तिष्ठति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003500074, "chapter_id": 23500, "verse_number": "१४०-७५", "content_sanskrit": "तस्मिन्क्षेत्रे महागुह्ये परमस्ति फलोदयम् ।\nविष्णुतीर्थमिति ख्यातं मम भक्तसुखावहम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003500075, "chapter_id": 23500, "verse_number": "१४०-७६", "content_sanskrit": "ततः पर्वतमध्यात्तु कोकायां पतते जलम् ।\nत्रिस्रोतसं महाभागे सर्वसंसारमोक्षणम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003500076, "chapter_id": 23500, "verse_number": "१४०-७७", "content_sanskrit": "तस्मिन् कृतोदको भूमे छित्त्वा संसारबन्धनम् ।\nवायोः स भवनं प्राप्य वायुभूतस्तु तिष्ठति॥ ७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003500077, "chapter_id": 23500, "verse_number": "१४०-७८", "content_sanskrit": "तत्राऽथ मुंचते प्राणान्मम कर्मसु निष्ठितः ।\nवायुलोकमतिक्रम्य मम लोकं स गच्छति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003500078, "chapter_id": 23500, "verse_number": "१४०-७९", "content_sanskrit": "अस्ति तत्र वरं स्थानं सङ्गमं कौशिकोकयोः ।\nसर्वकामिकेति विख्याता शिला तिष्ठति चोत्तरे ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003500079, "chapter_id": 23500, "verse_number": "१४०-८०", "content_sanskrit": "तत्र यः कुरुते स्नानमहोरात्रोषितो नरः ।\nविस्तीर्णे जायते वंशे जातिं स्मरति चात्मनः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003500080, "chapter_id": 23500, "verse_number": "१४०-८१", "content_sanskrit": "स्वर्गे वा यदि वा भूमौ यं यं कामयते नरः ।\nतं तं प्राप्नोति वै कामं स्नातमात्रः शिलातले ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003500081, "chapter_id": 23500, "verse_number": "१४०-८२", "content_sanskrit": "तत्राऽथ मुंचते प्राणान्मम कर्मण्यवस्थितः ।\nसर्वसंगं परित्यज्य मम लोकं स गच्छति ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003500082, "chapter_id": 23500, "verse_number": "१४०-८३", "content_sanskrit": "अस्ति मत्स्यशिला नाम गुह्यं कोकामुखे वरम् ।\nधाराः पतन्ति तिस्रो वै कौशिकीमाश्रिता नदीम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003500083, "chapter_id": 23500, "verse_number": "१४०-८४", "content_sanskrit": "तत्र च स्नायमानस्तु यदि मत्स्यं प्रपश्यति ।\nततो जानाम्यहं देवि प्राप्तो नारायणः स्वयम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003500084, "chapter_id": 23500, "verse_number": "१४०-८५", "content_sanskrit": "तत्र मत्स्यं पुनर्दृष्ट्वा यजमानस्तु सुन्दरि।\n&nbsp;दद्यादर्घ्यं ततो भद्रे मधुलाजसमन्वितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003500085, "chapter_id": 23500, "verse_number": "१४०-८६", "content_sanskrit": "यस्तत्र कुरुते स्नानं देवि गुह्ये ततः परे ।\nतिष्ठते पद्मपत्रे तु सोत्तरे मेरुसंश्रिते ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003500086, "chapter_id": 23500, "verse_number": "१४०-८७", "content_sanskrit": "अथ संप्राप्य मुच्येत मत्स्यं गुह्यं परं मम ।\nमेरुशृंगं समुल्लङ्घ्य गम लोकं च गच्छति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003500087, "chapter_id": 23500, "verse_number": "१४०-८८", "content_sanskrit": "पंचयोजनविस्तारं क्षेत्रं कोकामुखं मम ।\nयस्त्वेतत्तु विजानाति न स पापेन लिप्यते ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003500088, "chapter_id": 23500, "verse_number": "१४०-८९", "content_sanskrit": "अन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nतस्मिन्कोकामुखे रम्ये तिष्ठामि दक्षिणामुखः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003500089, "chapter_id": 23500, "verse_number": "१४०-९०", "content_sanskrit": "शिलाचन्दनसंकाशं देवानामपि दुर्लभम् ।\nवराहरूपमादाय तिष्ठामि पुरुषाकृतिः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003500090, "chapter_id": 23500, "verse_number": "१४०-९१", "content_sanskrit": "वामोन्नतमुखं कृत्वा वामदंष्ट्रासमुन्नतम् ।\nपश्यामि च जगत्सर्वं ये च भक्ता मम प्रियाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003500091, "chapter_id": 23500, "verse_number": "१४०-९२", "content_sanskrit": "ये मां स्मरन्ति वै भूमे पुरुषा मुक्तकिल्बिषाः ।\nतत्र कुर्वन्ति कर्माणि शुद्धाः संसारमोक्षणे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003500092, "chapter_id": 23500, "verse_number": "१४०-९३", "content_sanskrit": "यदि कोकामुखं गच्छेत् कदाचित्कालपर्यये ।\nमा ततो विनिवर्त्तेत यदीच्छेन्मम तुल्यताम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003500093, "chapter_id": 23500, "verse_number": "१४०-९४", "content_sanskrit": "गुह्यानां परमं गुह्यमेतत्स्थानं परं महत् ।\nसिद्धानां परमा सिद्धिर्गुह्यं कोकामुखं परम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003500094, "chapter_id": 23500, "verse_number": "१४०-९५", "content_sanskrit": "न च सांख्येन योगेन सिद्धिं यान्ति महापराम् ।\nयाति कोकामुखं गत्वा रहस्यं कथितं मया ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003500095, "chapter_id": 23500, "verse_number": "१४०-९६", "content_sanskrit": "एवं श्रेष्ठं महाभागे  यत्त्वया परिपृच्छिम् ।\nपरमं कथितं सर्वं किमन्यच्छ्रोतुमिच्छसे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003500096, "chapter_id": 23500, "verse_number": "१४०-९७", "content_sanskrit": "य एतत्कथितं भूमे कोकामुखमनुत्तमम् ।\nतारिताः पितरस्तेन दश पूर्वास्तथा पराः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003500097, "chapter_id": 23500, "verse_number": "१४०-९८", "content_sanskrit": "मृतो वा तत्र जायेत शुद्धे भागवते कुले ।\nअनन्यमानसो भूत्वा मम मार्गप्रदर्शकः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003500098, "chapter_id": 23500, "verse_number": "१४०-९९", "content_sanskrit": "यश्चेदं शृणुयान्नित्यं कल्य उत्थाय मानवः ।\nत्यक्त्वा पंचशतं जन्म मम भक्तश्च जायते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003500099, "chapter_id": 23500, "verse_number": "१४०-१००", "content_sanskrit": "य एतत्पठते नित्यं कोकाख्यानं तथोषसि ।\nगच्छते परमं स्थानमेवमेतन्न संशयः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]