[{"id": 2197540, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "भार्यापत्यादीनां शुद्ध्यशुद्धी ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197541, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197542, "chapter_id": 5201, "verse_number": "१", "content_sanskrit": "श्रुतं बलं प्रभावश्च योषितां मुनिसत्तम ।\nएकस्य बहुभार्यस्य धर्ममिच्छामि वेदितुम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197543, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197544, "chapter_id": 5201, "verse_number": "२", "content_sanskrit": "बहुभार्यासु सक्तस्य नारीभोगेषु गेहिनः ।\nऋतौ विमुच्यमानस्य सान्निध्ये भ्रूणहा स्मृतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197545, "chapter_id": 5201, "verse_number": "३", "content_sanskrit": "वृद्धां वन्ध्यां सुव्रतां च मृतापत्यामपुष्पिणीम् ।\nकन्यां च बहुपुत्रां च वर्जयन्मुच्यते भयात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197546, "chapter_id": 5201, "verse_number": "४", "content_sanskrit": "व्याधितां बन्धनस्थो वा प्रवासेष्वथ पर्वसु ।\nऋतुकालेषु नारीणां भ्रूणहत्यां प्रमुञ्चति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197547, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197548, "chapter_id": 5201, "verse_number": "५", "content_sanskrit": "वेश्यनारीषु वै जाताः परप्रेष्यासु वा सुताः ।\nकस्य ते बन्धुदायादा भवन्ति हि महामुने\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197549, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197550, "chapter_id": 5201, "verse_number": "६", "content_sanskrit": "पण्यस्त्रीषु प्रसूता ये यस्य स्त्री तस्य ते सुताः ।\nक्रयाच्च कृत्रिमाः पुत्राः प्रदानाच्चैव दत्रिमाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197551, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197552, "chapter_id": 5201, "verse_number": "७", "content_sanskrit": "पण्यनारीष्वनियतः पुंसोऽर्थो वर्तते ध्रुवम् ।\nअत्र चाहितगर्भायाः कस्य पुत्रं वदन्ति तम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197553, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197554, "chapter_id": 5201, "verse_number": "८", "content_sanskrit": "तीर्थभूतासु नारीषु ज्ञायते योऽभिगच्छति ।\nऋतौ तस्य भवेद् गर्भो यं वा नारी न शङ्कते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197555, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197556, "chapter_id": 5201, "verse_number": "९", "content_sanskrit": "नराणां त्यजतां भार्यां कामक्रोधाद् गुणान्विताम् ।\nअप्रसूतां प्रसूतां वा तेषां पृच्छामि निष्कृतिम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197557, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197558, "chapter_id": 5201, "verse_number": "१०", "content_sanskrit": "अपापां त्यजमानस्य साध्वीं मत्वैवमादितः ।\nआत्मवंशः स्वधर्मो वा त्यजतो निष्कृतिर्न तु\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197559, "chapter_id": 5201, "verse_number": "११", "content_sanskrit": "यो नरस्त्यजते भार्यां पुष्पिणीमप्रसूतिकाम् ।\nस नष्टवंशः पितृभिर्युक्तस्त्यज्येत दैवतैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197560, "chapter_id": 5201, "verse_number": "१२", "content_sanskrit": "भार्यामपत्यसञ्जातां प्रसूतां पुत्रपौत्रिणीम् ।\nपुत्रदारपरित्यागी न स प्राप्नोति निष्कृतिम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197561, "chapter_id": 5201, "verse_number": "१३", "content_sanskrit": "एवं हि भार्यां त्यजतां नराणां नास्ति निष्कृतिः ।\nनार्हन्ति प्रमदास्त्यक्तुं पुत्रपौत्रप्रतिष्ठिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197562, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197563, "chapter_id": 5201, "verse_number": "१४", "content_sanskrit": "कीदृशीं सन्त्यजन् भार्यां नरो दोषैर्न लिप्यते ।\nएतदिच्छामि तत्वेन विज्ञातुमृषिसत्तम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197564, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197565, "chapter_id": 5201, "verse_number": "१५", "content_sanskrit": "मोक्षधर्मस्थितानां तु अन्योन्यमनुजानताम् ।\nभार्यापतीनां मुक्तानामधर्मो न विधीयते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197566, "chapter_id": 5201, "verse_number": "१६", "content_sanskrit": "अन्यसङ्गां गतापत्यां शूद्रगां परभागिनीम् ।\nपरीक्ष्य त्यजमानानां नराणां नास्ति पातकम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197567, "chapter_id": 5201, "verse_number": "१७", "content_sanskrit": "पातकेऽपि तु भर्तव्यौ द्वौ तु माता पिता तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197568, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197569, "chapter_id": 5201, "verse_number": "१८", "content_sanskrit": "भार्यायां व्यभिचारिण्यां नरस्य त्यजतो रुषा ।\nकथं धर्मोऽप्यधर्मो वा भवतीह महामते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197570, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197571, "chapter_id": 5201, "verse_number": "१९", "content_sanskrit": "अनृतेऽपि हि सत्ये वा यो नारीं दूषितां त्यजेत् ।\nअरक्षमाणः स्वां भार्यां नरो भवति भ्रूणहा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2197572, "chapter_id": 5201, "verse_number": "२०", "content_sanskrit": "अपत्यहेतोर्या नारी भर्तारमतिलङ्घयेत् ।\nलोलेन्द्रियेति सा रक्ष्या न सन्त्याज्या कथञ्चन\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2197573, "chapter_id": 5201, "verse_number": "२१", "content_sanskrit": "नद्यश्च नार्यश्च समस्वभावा\nनैता न दुष्यन्ति नरावगाढाः ।\nस्रोतांसि नद्यो वहते निपातं\nनारी रजोभिः पुनरेति शौचम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2197574, "chapter_id": 5201, "verse_number": "२२", "content_sanskrit": "एवं नार्यो न दुष्यन्ति व्यभिचारेऽपि भर्तृणाम् ।\nमासिमासि भवेत् त्यागस्ततः शुद्धा भवन्त्युत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2197575, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2197576, "chapter_id": 5201, "verse_number": "२३", "content_sanskrit": "कानि तीर्थानि भगवन् नृणां देहाश्रितानि वै ।\nतानि वै शंस भगवन् याथातथ्येन पृच्छतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2197577, "chapter_id": 5201, "verse_number": "२४", "content_sanskrit": "सर्वतीर्थेषु तीर्थज्ञ किं तीर्थं परमं नृणाम् ।\nयत्रोपस्पृश्य पूतात्मा नरो भवति नित्यशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2197578, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2197579, "chapter_id": 5201, "verse_number": "२५", "content_sanskrit": "देवर्षिपितृतीर्थानि ब्राह्मं मध्येऽथ वैष्णवम् ।\nनृणां तीर्थानि पञ्चाहुः पाणौ सन्निहितानि वै\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2197580, "chapter_id": 5201, "verse_number": "२६", "content_sanskrit": "आद्यतीर्थं तु तीर्थानां वैष्णवो भाग उच्यते ।\nयत्रोपस्पृश्य वर्णानां चतुर्णां वर्धते कुलम् ।\nपितृदैवतकार्याणि वर्धन्ते प्रेत्य चेह च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2197581, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2197582, "chapter_id": 5201, "verse_number": "२७", "content_sanskrit": "नराणां कामवृत्तानां या नार्यो निरवग्रहाः ।\nयासामभिग्रहो नास्ति ता मे कथय नारद\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2197583, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2197584, "chapter_id": 5201, "verse_number": "२८", "content_sanskrit": "वागुर्वेश्या नटी गोपी तान्तुकी तुन्नवायिकी ।\nनारी किराती शबरी नर्तकी चानवग्रहा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2197585, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2197586, "chapter_id": 5201, "verse_number": "२९", "content_sanskrit": "एतासु जाता नारीषु सर्ववर्णेषु ये सुताः ।\nतेषु के बन्धुदायादा भवन्ति ऋषिसत्तम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2197587, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2197588, "chapter_id": 5201, "verse_number": "३०", "content_sanskrit": "य एताः परिगृह्णन्ति तेषामेव हि ते सुताः ।\nसर्वत्र तु प्रवृत्तासु बीजं नश्यति देहिनाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2197589, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2197590, "chapter_id": 5201, "verse_number": "३१", "content_sanskrit": "सर्वस्त्रीषु प्रवृत्तास्तु साधुवेदविवर्जिताः ।\nमानवाः काण्डपृष्ठाश्च वेदमन्त्रबहिष्कृताः ।\nनियुक्ता हव्यकव्येषु तेषां दत्तं कथं भवेत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2197591, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2197592, "chapter_id": 5201, "verse_number": "३२", "content_sanskrit": "नार्हन्ति हव्यकव्यानि सावित्रीवर्जिता द्विजाः ।\nव्रात्येष्वन्नप्रदानं तद् यथा शूद्रेषु वै तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2197593, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2197594, "chapter_id": 5201, "verse_number": "३३", "content_sanskrit": "धर्मेष्वधिकृतानां तु नराणां मुह्यते मनः ।\nकथं न विघ्नो भवति एतदिच्छामि वेदितुम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2197595, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2197596, "chapter_id": 5201, "verse_number": "३४", "content_sanskrit": "अर्थाश्च नार्यश्च समानमेतत्\nश्रेयांसि पुंसामिह मोहयन्ति ।\nरतिप्रमोदात् प्रमदा हरन्ति\nभोगैर्धनं चाप्युपहन्ति धर्मान् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2197597, "chapter_id": 5201, "verse_number": "३५", "content_sanskrit": "हव्यं कव्यं च धर्मात्मा सर्वं तच्छ्रोत्रियोऽर्हति ।\nदत्तं हि श्रोत्रिये साधौ ज्वलिताग्नाविवाहुतिः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2197598, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2197599, "chapter_id": 5201, "verse_number": "३६", "content_sanskrit": "श्रोत्रियाणां कुले जाता वेदार्थविदितात्मनाम् ।\nहित्वा कस्मात्त्रयीं विद्यां वार्तां वृत्तिमुपाश्रिताः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2197600, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2197601, "chapter_id": 5201, "verse_number": "३७", "content_sanskrit": "चातुर्वर्ण्यं पुरा न्यस्तं सुविद्वत्सु द्विजातिषु ।\nतस्माद् वर्णैः संविभज्या वृत्तिः सङ्करवर्जिता\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2197602, "chapter_id": 5201, "verse_number": "३८", "content_sanskrit": "ये चान्ये श्रोत्रिया जाताः संस्कृताः पुत्रगृध्नुभिः ।\nपूर्वनिर्वाणनिवृत्तां जातां वृत्तिमुपाश्रिताः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2197603, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2197604, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "असंस्कृताः श्रोत्रियजाः संस्कृता ज्ञानिजाः कथम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2197605, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2197606, "chapter_id": 5201, "verse_number": "३९", "content_sanskrit": "असंस्कारो वैदिकश्च स मान्यः श्रोत्रियात्मजः ।\nशुद्धान्वयः श्रोत्रियस्तु सविद्वद्भिः समोऽन्यथा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2197607, "chapter_id": 5201, "verse_number": "४०", "content_sanskrit": "अनधीयानपुत्राश्च वेदसंस्कारवर्जिताः ।\nतस्मात् ते वेदविज्ञाऽपि विप्राः श्रुतिनिकारिणः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2197608, "chapter_id": 5201, "verse_number": "४१", "content_sanskrit": "ब्रह्मराशौ पुरा सृष्टा वेदसंस्कारसंस्कृताः ।\nतस्मात् तेष्वेव ते जाताः साधवः कुलधारिणः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2197609, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2197610, "chapter_id": 5201, "verse_number": "४२", "content_sanskrit": "स्वयं क्रीतासु प्रेष्यासु प्रसूयन्ते तु ये नराः ।\nकस्य नार्यः सुताश्चैव भवन्ति ऋषिसत्तम\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2197611, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2197612, "chapter_id": 5201, "verse_number": "४३", "content_sanskrit": "स्वदास्यां यो नरो मोहात् प्रसूयेत स पापकृत् ।\nइहापि निन्दितः प्रेत्य अपत्यं प्रेष्यतां नयेत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2197613, "chapter_id": 5201, "verse_number": "४४", "content_sanskrit": "सा तस्य भार्या पुत्रा ये हव्यकव्यप्रदास्तु ते ।\nतस्या ये बान्धवाः केचिद्विषक्ताः प्रेष्यतां गताः ।\nसर्वे तस्यास्तु सम्बन्धा मुच्यन्ते प्रेष्यकर्मसु\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2197614, "chapter_id": 5201, "verse_number": "४५", "content_sanskrit": "एतत् ते कथितं सर्वं यदभिव्याहृतं त्वया ।\nअथवा संशयः कश्चिद् भूयः सम्प्रष्टुमर्हसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2197615, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2197616, "chapter_id": 5201, "verse_number": "४६", "content_sanskrit": "अमिथ्यादर्शनो लोके नारदः सर्वकोविदः ।\nप्रत्यक्षदर्शी लोकानां स्वयम्भूरिव सत्तमः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2197617, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2197618, "chapter_id": 5201, "verse_number": "समाप्तिः", "content_sanskrit": "इति सम्भाष्य ऋषिभिर्मार्कण्डेयो महातपाः ।\nनारदं चापि सत्कृत्य तेन चैवाभिसत्कृतः ।\nआमन्त्रयित्वा ऋषिभिः प्रययावाश्रमं मुनिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2197619, "chapter_id": 5201, "verse_number": "४८", "content_sanskrit": "ऋषयश्चापि तीर्थानां परिचर्यां प्रचक्रमुः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2197620, "chapter_id": 5201, "verse_number": "४९", "content_sanskrit": "सुक्षेत्रबीजसंस्कारविशुद्धो ब्रह्मचर्यया ।\nनित्यनैमित्तिकात् स्नातो मनःशुद्ध्या च शुद्ध्यति\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2197621, "chapter_id": 5201, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे नारदमार्कण्डेयसंवादो नाम द्विपञ्चाशोऽध्यायः ॥५२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]