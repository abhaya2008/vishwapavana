[{"id": 2066843, "chapter_id": 2409, "verse_number": "९-२७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066844, "chapter_id": 2409, "verse_number": "९-२७-१", "content_sanskrit": "तस्मिन्प्रवृत्ते सङ्ग्रामे गजवाजिनरश्रो\nशकुनिः सौबलो राजन्सहदेवं xxxxxxयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066845, "chapter_id": 2409, "verse_number": "९-२७-२", "content_sanskrit": "ततोऽस्यापततस्तूर्णं सहदेवः पतापवान्।\nशरौघान्प्रेषयामास पतङ्गानिव शीघ्रगान्।\nउलूकं च रणे राजन्विव्याध दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066846, "chapter_id": 2409, "verse_number": "९-२७-३", "content_sanskrit": "शकृनिश्च महाराज भीमं विद्ध्वा त्रिभिः शरैः।\nनवत्या निशितैर्बाणैः सहदेवमवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066847, "chapter_id": 2409, "verse_number": "९-२७-४", "content_sanskrit": "ते शूराः समरे राजन्समासाद्य परस्परम्।\nविव्यधुर्निशितैर्बाणैः कङ्कबर्हिणवाजितैः।\nस्वर्णपुङ्खैः शिलधौतैराकर्णप्रहितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066848, "chapter_id": 2409, "verse_number": "९-२७-५", "content_sanskrit": "तेषां चापगुणोत्सृष्टा शरवृष्टिर्विशाम्पते।\nआच्छादयद्दिशः सर्वा धाराभिरिव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066849, "chapter_id": 2409, "verse_number": "९-२७-६", "content_sanskrit": "ततः क्रुद्धो रणे भीमः सहदेवश्च भारत।\nचेरतुः कदनं सङ्ख्ये कुर्वन्तौ सुमहाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066850, "chapter_id": 2409, "verse_number": "९-२७-७", "content_sanskrit": "ताभ्यां शरशतैश्छनं तद्बलं तव भारत।\nसान्धकारमिवाकाशमभवत्तत्रतत्र ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066851, "chapter_id": 2409, "verse_number": "९-२७-८", "content_sanskrit": "अश्वैर्विपरिधावद्भिः शरच्छन्नैर्विशाम्पते।\nतत्रतत्र कृतो मार्गो विकर्षद्भिर्हतान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066852, "chapter_id": 2409, "verse_number": "९-२७-९", "content_sanskrit": "निहतानां हयानां च सहैव हयसादिभिः।\nवर्मभिर्विनिकृत्तैश्च प्रासैश्छिन्नैश्च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066853, "chapter_id": 2409, "verse_number": "९-२७-१०", "content_sanskrit": "ऋष्टिभिः शक्तिभिश्चैव सासिप्रासपरश्वथैः।\nसञ्छन्ना पृथिवी जज्ञे कुसुमैः शबला इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066854, "chapter_id": 2409, "verse_number": "९-२७-११", "content_sanskrit": "योधास्तत्र महाराज समासाद्य परस्परम्।\nव्यचरन्त रणे क्रुद्धा विनिघ्नन्तः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066855, "chapter_id": 2409, "verse_number": "९-२७-१२", "content_sanskrit": "उद्वृत्तनयनै रोषात्सन्दष्टौष्ठपुटैर्मुखैः।\nसकुण्डलैर्मही च्छन्ना पद्मकिञ्चल्कसन्निभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066856, "chapter_id": 2409, "verse_number": "९-२७-१३", "content_sanskrit": "भुजैश्छिन्नैर्महाराज नागराजकरोपमैः।\nसाङ्गदैः सतनुत्रैश्च सासिप्रासपरश्वथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066857, "chapter_id": 2409, "verse_number": "९-२७-१४", "content_sanskrit": "कबन्धैरुत्थितैश्छिन्नैर्नृत्यद्भिश्चापरैर्युधि।\nक्रव्यादगणसञ्छन्ना घोराऽभूत्पृथिवी विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066858, "chapter_id": 2409, "verse_number": "९-२७-१५", "content_sanskrit": "अल्पावशिष्टे सैन्ये तु कौरवेयान्महाहवे।\nप्रहृष्टाः पाण्डवा भूत्वा निन्यिरे यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066859, "chapter_id": 2409, "verse_number": "९-२७-१६", "content_sanskrit": "एतस्मिन्नन्तरे शूरः सौबलेयः प्रतापवान्।\nप्रासेन सहदेवस्य शिरसि प्राहरद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066860, "chapter_id": 2409, "verse_number": "९-२७-१७", "content_sanskrit": "स विह्वलो महाराज रथोपस्थ उपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066861, "chapter_id": 2409, "verse_number": "९-२७-१८", "content_sanskrit": "सहदेवं तथा दृष्ट्वा भीमसेनः प्रतापवान्।\nसर्वसैन्यानि सङ्क्रुद्धो वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066862, "chapter_id": 2409, "verse_number": "९-२७-१९", "content_sanskrit": "निर्बिभेद च नाराचैः शतशोऽथ सहस्रशः।\nस निर्भिद्याकरोच्चैव सिंहनादमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066863, "chapter_id": 2409, "verse_number": "९-२७-२०", "content_sanskrit": "तेन शभ्देन वित्रस्ताः सर्वे सहयवारणाः।\nप्राद्रवन्सहसा भीताः शकुनेश्च पदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066864, "chapter_id": 2409, "verse_number": "९-२७-२१", "content_sanskrit": "प्रभग्नानथ तान्दृष्ट्वा राजा दुर्योधनोऽब्रवीत्।\nनिवर्तध्वमधर्मज्ञा युध्यध्वं किं सृतेन वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066865, "chapter_id": 2409, "verse_number": "९-२७-२२", "content_sanskrit": "इह कीर्ति समाधाय प्रेत्य लोकान्समश्नुते।\nप्राणाञ्जहाति यो धीरो युद्धे पृष्ठमदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066866, "chapter_id": 2409, "verse_number": "९-२७-२३", "content_sanskrit": "एवमुक्तास्तु ते राज्ञा सौबलस्य पदानुगाः।\nपाण्डवानभ्यवर्तन्त मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066867, "chapter_id": 2409, "verse_number": "९-२७-२४", "content_sanskrit": "द्रवद्भिस्तत्र राजेन्द्र कृतः शब्दोऽतिदारुणः।\nक्षुब्धसागरसङ्काशः क्षुभितैः सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066868, "chapter_id": 2409, "verse_number": "९-२७-२५", "content_sanskrit": "तांस्ततः पुरतो दृष्ट्वा सौबलस्य पदानुगान्।\nप्रत्युद्ययुर्महाराज पाण्डवा विजयोद्यताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066869, "chapter_id": 2409, "verse_number": "९-२७-२६", "content_sanskrit": "प्रत्याश्वस्य च दुर्धर्षः सहदेवो विशाम्पते।\nशकुनिं दशभिर्विद्ध्वा हयांश्चास्य त्रिभिः शरैः।\nधनुश्चिच्छेद च शरैः सौबलस्य हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066870, "chapter_id": 2409, "verse_number": "९-२७-२७", "content_sanskrit": "अथान्यद्धनुरादाय शकुनिर्युद्धदुर्मदः।\nविव्याध नकुलं षष्ट्या भीमसेनं च सप्ताभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066871, "chapter_id": 2409, "verse_number": "९-२७-२८", "content_sanskrit": "उलूकोऽपि महाराज भीमं विव्याध सप्तभिः।\nसहदेवं च सप्तत्या परीप्सन्पितरं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066872, "chapter_id": 2409, "verse_number": "९-२७-२९", "content_sanskrit": "तं भीमसेनः समरे विव्याध नवभिः शरैः।\nशकुनिं च चतुःषष्ट्या पार्श्वस्थांश्च त्रिभिस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066873, "chapter_id": 2409, "verse_number": "९-२७-३०", "content_sanskrit": "ते हन्यमाना भीमेन नाराचैस्तैलपायितैः।\nसहदेवं रणे क्रुद्धाश्छादयञ्शरवृष्टिभिः।\nपर्वतं वारिधाराभिः सविद्युत इवाम्बुदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066874, "chapter_id": 2409, "verse_number": "९-२७-३१", "content_sanskrit": "ततोऽस्यापततः शूरः सहदेवः प्रतापवान्।\nउलूकस्य महाराज भल्लेनापाहरच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066875, "chapter_id": 2409, "verse_number": "९-२७-३२", "content_sanskrit": "स जगाम रथाद्भूमिं सहदेवेन पातितः।\nरुधिराप्लुतसर्वाङ्गो नन्दयन्पाण्डवान्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066876, "chapter_id": 2409, "verse_number": "९-२७-३३", "content_sanskrit": "पुत्रं तु निहतं दृष्ट्वा शकुनिस्तत्र भारत।\nसाश्रुकण्ठो विनिःश्वस्य क्षत्तुर्वाक्यमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066877, "chapter_id": 2409, "verse_number": "९-२७-३४", "content_sanskrit": "चिन्तयित्वा मुहूर्तं स बाष्पपूर्णेक्षणः श्वसन्।\nसहदेवं समासाद्य त्रिभिर्विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066878, "chapter_id": 2409, "verse_number": "९-२७-३५", "content_sanskrit": "तानपास्य शरान्मुक्ताञ्शरसङ्घैः प्रताम्पवान्।\nसहदेवो महाराज धनुश्चिच्छेद संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066879, "chapter_id": 2409, "verse_number": "९-२७-३६", "content_sanskrit": "छिन्ने धनुषि राजेन्द्र शकुनिः सौबलस्तदा।\nप्रगृह्य विपुलं खङ्गं सहदेवाय प्राहिणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066880, "chapter_id": 2409, "verse_number": "९-२७-३७", "content_sanskrit": "तमापतन्तं सहसा घोररूपं विशाम्पते।\nद्विधा चिच्छेद समरे सौबलस्य हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066881, "chapter_id": 2409, "verse_number": "९-२७-३८", "content_sanskrit": "असिं दृष्ट्वा द्विधा च्छिन्नं प्रगृह्य महतीं गदाम्।\nप्राहिणोत्सहदेवाय सा मोघा न्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066882, "chapter_id": 2409, "verse_number": "९-२७-३९", "content_sanskrit": "ततः शक्तिं महाघोरां कालरात्रीमिवोद्यताम्।\nप्रेषयामास सक्रुद्धः पाण्डवं प्रति सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066883, "chapter_id": 2409, "verse_number": "९-२७-४०", "content_sanskrit": "तामापतन्तीं सहसा शरैः कनकभूषणैः।\nत्रिधा चिच्छेद समरे सहदेवो हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066884, "chapter_id": 2409, "verse_number": "९-२७-४१", "content_sanskrit": "सा पपात त्रिधा च्छिन्ना भूमौ कनकभूषणा।\nशीर्यमाणा यथा दीप्ता गगनाद्वै शतहदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066885, "chapter_id": 2409, "verse_number": "९-२७-४२", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा सौबलं च भयार्दितम्।\nदुद्रुवुस्तावकाः सर्वे भये जाते ससौबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066886, "chapter_id": 2409, "verse_number": "९-२७-४३", "content_sanskrit": "अथोत्क्रुष्टं महच्चासीत्पाण्डवैर्जितकाशिभिः।\nधार्तराष्ट्रास्ततः सर्वे प्रायशो विमुखाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066887, "chapter_id": 2409, "verse_number": "९-२७-४४", "content_sanskrit": "तान्वै विमनसो दृष्ट्वा माद्रीपुत्रः प्रतापवान्।\nशरैरनेकसाहस्रैर्वारयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066888, "chapter_id": 2409, "verse_number": "९-२७-४५", "content_sanskrit": "ततो गान्धारकैर्गुप्तं पुष्टैरश्वैर्जये धृतम्।\nआससाद रमे यान्तं सहदेवोऽथ सौबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066889, "chapter_id": 2409, "verse_number": "९-२७-४६", "content_sanskrit": "स्वमंशमवशिष्टं तं संस्मृत्य शकुनिं नृप।\nरथेन काञ्चनाङ्गेन सहदेवः समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066890, "chapter_id": 2409, "verse_number": "९-२७-४७", "content_sanskrit": "अधिज्यं बलवत्कृत्वा व्याक्षिपन्सुमहद्धनुः।\nस सौबलमभिद्रुत्य गार्ध्रपत्रैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066891, "chapter_id": 2409, "verse_number": "९-२७-४८", "content_sanskrit": "भृशमभ्यहन्त्कुद्धस्तोत्रैरिव महाद्विपम्।\nउवाच चैनं मेधावी विगृह्य स्मारयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066892, "chapter_id": 2409, "verse_number": "९-२७-४९", "content_sanskrit": "क्षत्रधर्मे स्थिरो भूत्वा युध्यस्व पुरुषो भव।\nयत्तदा भाषसे मूढ गृह्णन्नक्षान्सभातले।\nफलमद्य प्रपद्यस्व कर्मणस्तस्य दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066893, "chapter_id": 2409, "verse_number": "९-२७-५०", "content_sanskrit": "निहतास्ते दुरात्मानो येऽस्मानवहसन्पुरा।\nदुर्योधनः कुलाङ्गारः शिष्टस्त्वं चास्य मातुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066894, "chapter_id": 2409, "verse_number": "९-२७-५१", "content_sanskrit": "अद्य ते निहनिष्यामि क्षुरेणोन्मथितं शिरः।\nवृक्षात्फलमिवाविद्वं लगुडेन प्रमाथिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066895, "chapter_id": 2409, "verse_number": "९-२७-५२", "content_sanskrit": "एवमुक्त्वा महाराज सहदेवो महाबलः।\nसङ्क्रुद्धो रणशार्दूलो वेगेनाभिजगाम तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066896, "chapter_id": 2409, "verse_number": "९-२७-५३", "content_sanskrit": "अभिगम्य सुदुर्धर्षः सहदेवो युधां पतिः।\nविकृष्य बलवच्चापं क्रोधेन प्रज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066897, "chapter_id": 2409, "verse_number": "९-२७-५४", "content_sanskrit": "शकुनिं दशभिर्विद्ध्वा चतुर्भिश्चास्य वाजिनः।\nछत्रं ध्वजं धनुश्चास्य च्छित्त्वा सिंह इवानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066898, "chapter_id": 2409, "verse_number": "९-२७-५५", "content_sanskrit": "छिन्नध्वजधनुश्छत्रः सहदेवेन सौबलः।\nकृतो विद्धश्च बहुभिः सर्वमर्मसु सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066899, "chapter_id": 2409, "verse_number": "९-२७-५६", "content_sanskrit": "ततो भूयो महाराज सहदेवः प्रतापवान्।\nशकुनेः प्रेषयान्मास शरवृष्टिं दुरासदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066900, "chapter_id": 2409, "verse_number": "९-२७-५७", "content_sanskrit": "ततस्तु क्रुद्धः सुबलस्य पुत्रो\nमाद्रीसुतं सहदेवं विमर्दे।\nप्रासेन जाम्बूनदभूषणेन\nजिघांसुरेकोऽभिपपात शीघ्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066901, "chapter_id": 2409, "verse_number": "९-२७-५८", "content_sanskrit": "माद्रीसुतस्तस्य समुद्यतं तं\nप्रासं सुवृत्तौ च भुजौ रणाग्रे।\nभल्लैस्त्रिभिर्युगपत्सञ्चकर्त\nननाद चोच्चैस्तरसाऽऽजिमध्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2066902, "chapter_id": 2409, "verse_number": "९-२७-५९", "content_sanskrit": "तस्याशुकारी सुसमाहितेन\nसुवर्णपुङ्खेन दृढायसेन।\nभल्लेन सर्वावरणातिगेन\nशिरः शरीरात्प्रममाथ भूयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2066903, "chapter_id": 2409, "verse_number": "९-२७-६०", "content_sanskrit": "शरेण कार्तस्वरभूषितेन\nदिवाकराभेण सुसंहितेन।\nहृतोत्तमाङ्गो युधि पाण्डवेन\nपपात भूमौ सुबलस्य पुत्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2066904, "chapter_id": 2409, "verse_number": "९-२७-६१", "content_sanskrit": "स तच्छिरो वेगवता शरेण\nसुवर्णपुङ्खेन शिलाशितेन।\nप्रावेरयत्कुपितः पाण्डुपुत्रो\nयत्तत्कुरूणामनयस्य मूलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2066905, "chapter_id": 2409, "verse_number": "९-२७-६२", "content_sanskrit": "भुजौ सुवृत्तौ प्रचकर्त वीरः\nपश्चात्कबन्धं रुधिरावसिक्तम्।\nविस्पन्दमानं निपपात घोरं\nरथोत्तमात्पार्थिव पार्थिवस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2066906, "chapter_id": 2409, "verse_number": "९-२७-६३", "content_sanskrit": "हृतोत्तमाङ्गं शकुनिं समीक्ष्य\nभूमौ शयानं रुधिरार्द्रगात्रम्।\nयोधास्त्वदीया भयनष्टसत्वा\nदिशः प्रजग्मुः प्रगृहीतशस्त्राः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2066907, "chapter_id": 2409, "verse_number": "९-२७-६४", "content_sanskrit": "प्रविद्रुताः शुष्कमुखा विसञ्ज्ञा\nगाण्डीवघोषेण समाहताश्च।\nभयार्दिता भग्नरथाश्वनागाः\nपदातयश्चैव सधार्तराष्ट्राः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2066908, "chapter_id": 2409, "verse_number": "९-२७-६५", "content_sanskrit": "ततो रथाच्छकुनिं पातयित्वा\nमुदान्विता भारत पाण्डवेयाः\nशङ्कान्प्रदध्युः समरेऽतिहृष्टाः\nसकेशवाः सैनिकान्हर्षयन्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2066909, "chapter_id": 2409, "verse_number": "९-२७-६६", "content_sanskrit": "तं चापि सर्वे प्रतिपूजयन्तो\nदृष्ट्वा ब्रुवाणाः सहदेवमाजौ।\nदिष्ट्या हतो नैकृतिको महात्मा\nसहात्मजो वीर रणे त्वयेति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2066910, "chapter_id": 2409, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे सप्तविंशोऽध्यायः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]