[{"id": 2001847, "chapter_id": 1035, "verse_number": "१-३६-०x", "content_sanskrit": "शौन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001848, "chapter_id": 1035, "verse_number": "१-३६-१", "content_sanskrit": "आख्याता भुजगास्तात वीर्यवन्तो दुरासदाः।\nशापं तं तेऽभिविज्ञाय कृतवन्तः किमुत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001849, "chapter_id": 1035, "verse_number": "१-३६-२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001850, "chapter_id": 1035, "verse_number": "१-३६-२", "content_sanskrit": "तेषां तु भगवाञ्छेषः कद्रूं त्यक्त्वा महायशाः।\nउग्रं तपः समातस्थे वायुभक्षो यतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001851, "chapter_id": 1035, "verse_number": "१-३६-३", "content_sanskrit": "गन्धमादनमासाद्य बदर्यां च तपोरतः।\nगोकर्णे पुष्करारण्ये तथा हिमवतस्तटे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001852, "chapter_id": 1035, "verse_number": "१-३६-४", "content_sanskrit": "तेषु तेषु च पुण्येषु तीर्थेष्वायतनेषु च।\nएकान्तशीलो नियतः सततं विजितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001853, "chapter_id": 1035, "verse_number": "१-३६-५", "content_sanskrit": "तप्यमानं तपो घोरं तं ददर्श पितामहः।\nसंशुष्कमांसत्वक्स्नायुं जटाचीरधरं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001854, "chapter_id": 1035, "verse_number": "१-३६-६", "content_sanskrit": "तमब्रवीत्सत्यधृतिं तप्यमानं पितामहः।\nकिमिदं कुरुषे शेष प्रजानां स्वस्ति वै कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001855, "chapter_id": 1035, "verse_number": "१-३६-७", "content_sanskrit": "त्वं हि तीव्रेण तपसा प्रजास्तापयसेऽनघ।\nब्रूहि कामं च मे शेष यस्ते हृदि व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001856, "chapter_id": 1035, "verse_number": "१-३६-८x", "content_sanskrit": "शेष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001857, "chapter_id": 1035, "verse_number": "१-३६-८", "content_sanskrit": "सोदर्या मम सर्वे हि भ्रातरो मन्दचेतसः।\nसह तैर्नोत्सहे वस्तुं तद्भवाननुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001858, "chapter_id": 1035, "verse_number": "१-३६-९", "content_sanskrit": "अभ्यसूयन्ति सततं परस्परममित्रवत्।\nततोऽहं तप आतिष्ठे नैतन्पश्येयमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001859, "chapter_id": 1035, "verse_number": "१-३६-१०", "content_sanskrit": "न मर्षयन्ति ससुतां सततं विनतां च ते।\nअस्माकं चापरो भ्राता वैनतेयोऽन्तरिक्षगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001860, "chapter_id": 1035, "verse_number": "१-३६-११", "content_sanskrit": "तं च द्विषन्ति सततं स चापि बलवत्तरः।\nवरप्रदानात्स पितुः कश्यपस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001861, "chapter_id": 1035, "verse_number": "१-३६-१२", "content_sanskrit": "सोऽहं तपः समास्थाय मोक्ष्यामीदं कलेवरम्।\nकथं मे प्रेत्यभावेऽपि न तैः स्यात्सह सङ्गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001862, "chapter_id": 1035, "verse_number": "१-३६-१३", "content_sanskrit": "तमेवं वादिनं शेषं पितामह उवाच ह।\nजानामि शेष सर्वेषां भ्रातॄणां ते विचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001863, "chapter_id": 1035, "verse_number": "१-३६-१४", "content_sanskrit": "मातुश्चाप्यपराधाद्वै भ्रातॄणां ते महद्भयम्।\nकृतोऽत्र परिहारश्च पूर्वमेव भुजङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001864, "chapter_id": 1035, "verse_number": "१-३६-१५", "content_sanskrit": "भ्रातॄणां तव सर्वेषां न शोकं कर्तुमर्हसि।\nवृणीष्व च वरं मत्तः शेष यत्तेऽभिकाङ्क्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001865, "chapter_id": 1035, "verse_number": "१-३६-१६", "content_sanskrit": "दास्यामि हि वरं तेऽद्य प्रीतिर्मे परमा त्वयि।\nदिष्ट्या बुद्धिश्च ते धर्मे निविष्टा पन्नगोत्तम।\nभूयो भूयश्च ते बुद्धिर्धर्मे भवतु सुस्थिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001866, "chapter_id": 1035, "verse_number": "१-३६-१६x", "content_sanskrit": "शेष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001867, "chapter_id": 1035, "verse_number": "१-३६-१७", "content_sanskrit": "एष एव वरो देव काङ्क्षितो मे पितामह।\nधर्मे मे रमतां बुद्धिः शमे तपसि चेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001868, "chapter_id": 1035, "verse_number": "१-३६-१८x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001869, "chapter_id": 1035, "verse_number": "१-३६-१८", "content_sanskrit": "प्रीतोऽस्म्यनेन ते शेष दमेन च शमेन च।\nत्वया त्विदं वचः कार्यं मन्नियोगात्प्रजाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001870, "chapter_id": 1035, "verse_number": "१-३६-१९", "content_sanskrit": "इमां महीं शैलवनोपपन्नां\nससागरग्रामविहारपत्तनाम्\nत्वं शेष सम्यक् चलितां यथाव-\nत्संगृह्य तिष्ठस्व यथाऽचला स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001871, "chapter_id": 1035, "verse_number": "१-३६-२०x", "content_sanskrit": "शेष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001872, "chapter_id": 1035, "verse_number": "१-३६-२०", "content_sanskrit": "यथाऽऽह देवो वरदः प्रजापति-\nर्महीपतिर्भूतपतिर्जगत्पतिः।\nतथा महीं धारयिताऽस्मि निश्चलां\nप्रयच्छतां मे विवरं प्रजापते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001873, "chapter_id": 1035, "verse_number": "१-३६-२१x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001874, "chapter_id": 1035, "verse_number": "१-३६-२१", "content_sanskrit": "अधो महीं गच्छ भुजङ्गमोत्तम\nस्वयं तवैषा विवरं प्रदास्यति।\nइमां धरां धारयता त्वया हि मे\nमहत्प्रियं शेष कृतं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001875, "chapter_id": 1035, "verse_number": "१-३६-२२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001876, "chapter_id": 1035, "verse_number": "१-३६-२२", "content_sanskrit": "तथैव कृत्वा विवरं प्रविश्य स\nप्रभुर्भुवो भुजगवराग्रजः स्थितः।\nबिभर्ति देवीं शिरसा महीमिमां\nसमुद्रनेमिं परिगृह्य सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001877, "chapter_id": 1035, "verse_number": "१-३६-२३x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001878, "chapter_id": 1035, "verse_number": "१-३६-२३", "content_sanskrit": "शेषोऽसि नागोत्तम धर्मदेवो\nमहीमिमां धारयसे यदेकः।\nअनन्तभोगैः परिगृह्य सर्वां\nयथाहमेवं बलभिद्यथा वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001879, "chapter_id": 1035, "verse_number": "१-३६-२४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001880, "chapter_id": 1035, "verse_number": "१-३६-२४", "content_sanskrit": "अधो भूमौ वसत्येवं नागोऽनन्तः प्रतापवान्।\nधास्यन्वसुधामेकः शासनाद्ब्रह्मणो विभोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001881, "chapter_id": 1035, "verse_number": "१-३६-२५", "content_sanskrit": "सुपर्णं च सहायं वै भगवानमरोत्तमः।\nप्रादादनन्ताय तदा वैनतेयं पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001882, "chapter_id": 1035, "verse_number": "१-३६-२६", "content_sanskrit": "अनन्तेऽभिप्रयाते तु वासुकिः स महाबलः।\nअभ्यषिच्यत नागैस्तु दैवतैरिव वासवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001883, "chapter_id": 1035, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि षट्त्रिंशोऽध्यायः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]