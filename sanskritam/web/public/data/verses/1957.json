[{"id": 2042824, "chapter_id": 1957, "verse_number": "६-६-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042825, "chapter_id": 1957, "verse_number": "६-६-१", "content_sanskrit": "उक्तो द्वीपस्य संक्षेपो विधिवद्बुद्धिमंस्त्वया।\nतत्त्वज्ञश्चासि सर्वस्य विस्तारं ब्रूहि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042826, "chapter_id": 1957, "verse_number": "६-६-२", "content_sanskrit": "यावान्भूम्यवकाशोऽयं दृश्यते शशलक्षणे।\nतस्य प्रमाणां प्रब्रूहि ततो वक्ष्यसि पिप्पलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042827, "chapter_id": 1957, "verse_number": "६-६-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042828, "chapter_id": 1957, "verse_number": "६-६-३", "content_sanskrit": "एवं राज्ञा स पृष्टस्तु संजयो वाक्यमब्रवीत्। ६-६-३xa संजय उवाच।\nप्रागायता महाराज षडेते वर्षपर्वताः ।\nअवगाढा ह्युभयतः समुद्रौ पूर्वपश्चिमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042829, "chapter_id": 1957, "verse_number": "६-६-४", "content_sanskrit": "हिमवान्हेमकूटश्च निषधश्च नगोत्तमः।\nनीलश्च वैदूर्यमयः श्वेतश्च शशिसन्निभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042830, "chapter_id": 1957, "verse_number": "६-६-५", "content_sanskrit": "सर्वधातुविचित्रश्च श्रृङ्गवान्नाम पर्वतः।\nएते वै पर्वता राजन्सिद्धचारणसेविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042831, "chapter_id": 1957, "verse_number": "६-६-६", "content_sanskrit": "एषामन्तरविष्कम्भा योजनानि सहस्रशः।\nतत्र पुण्या जनपदास्तानि वर्षाणि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042832, "chapter_id": 1957, "verse_number": "६-६-७", "content_sanskrit": "वसन्ति तेषु सत्वानि नानाजातीनि सर्वशः ।\nइदं तु भारतं वर्षं ततो हैमवतं परम् ॥ ६-६-८a` ततः किंपुरुषावासं वर्षं हिमवतः परम्।\nहेमकूटात्परं चैव हरिवर्षं प्रचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042833, "chapter_id": 1957, "verse_number": "६-६-९", "content_sanskrit": "दक्षिणेन तु नीलस्य निषधस्योत्तरेण तु।\nव्रागायतो महाभाग माल्यवान्नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042834, "chapter_id": 1957, "verse_number": "६-६-१०", "content_sanskrit": "ततः परं माल्यवतः पर्वतो गन्धमादनः ।\nपरिमण्डलस्तयोर्मध्ये मेरुः कनकपर्वतः ।\nतरुणादित्यसंकाशो विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042835, "chapter_id": 1957, "verse_number": "६-६-११", "content_sanskrit": "योजनानां सहस्राणि षोडशाधः किल स्मृतः ।\nऊर्ध्वं च चतुरशीतिर्द्वात्रिंशन्मूर्ध्नि विस्तृतः।\nअधस्ताच्चतुरशीतिर्योजनानां महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042836, "chapter_id": 1957, "verse_number": "६-६-१२", "content_sanskrit": "ऊर्ध्वंमधश्च तिर्यक्व मेरुरावृत्य तिष्ठति ।\nतस्य पार्श्वेष्वमी द्वीपाश्चत्वारः सस्थिता विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042837, "chapter_id": 1957, "verse_number": "६-६-१३", "content_sanskrit": "भद्राश्वः केतुमालश्च जम्बूद्वीपश्च भारत।\nउत्तराश्चैव कुरवः कृतपुण्यप्रतिश्रयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042838, "chapter_id": 1957, "verse_number": "६-६-१४", "content_sanskrit": "विहगः सुमुखो यस्तु सुपर्णस्यात्मजः किल।\nस वै विचिन्तयामास सौवर्णान्वीक्ष्य वायसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042839, "chapter_id": 1957, "verse_number": "६-६-१५", "content_sanskrit": "मेरुरुत्तममध्यानामधमानां च पक्षिणाम्।\nअविशेषकरो यस्मात्तस्मादेनं त्यजाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042840, "chapter_id": 1957, "verse_number": "६-६-१६", "content_sanskrit": "तमादित्योऽनुपर्येति सततं ज्योतिषां वरः।\nचन्द्रमाश्च सनक्षत्रो वायुश्चैव प्रदक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042841, "chapter_id": 1957, "verse_number": "६-६-१७", "content_sanskrit": "सपर्वतो महाराज दिव्यपुष्पफलान्वितः।\nभवनैरावृतः सर्वैर्जाम्बूनदपरिष्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042842, "chapter_id": 1957, "verse_number": "६-६-१८", "content_sanskrit": "तत्र देवगणा राजन्गन्धर्वासुरराक्षसाः।\nअप्सरोगणसंयुक्ताः शैले क्रीडन्ति सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042843, "chapter_id": 1957, "verse_number": "६-६-१९", "content_sanskrit": "तत्र ब्रह्मा च रुद्रश्च शक्रश्चापि सुरेश्वरः।\nसमेत्य विविधैर्यज्ञैर्यजन्तेऽनेकदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042844, "chapter_id": 1957, "verse_number": "६-६-२०", "content_sanskrit": "तुम्बुरुर्नारदश्चैव विश्वावसुर्हहाहुहूः ।\nअभिगम्यामरश्रेष्ठांस्तुष्टुवुर्विविधैः स्तवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042845, "chapter_id": 1957, "verse_number": "६-६-२१", "content_sanskrit": "सप्तर्षयो महात्मानः कश्यपश्च प्रजापतिः ।\nतत्र गच्छन्ति भद्रं ते सदा पर्वणि पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042846, "chapter_id": 1957, "verse_number": "६-६-२२", "content_sanskrit": "तस्यैव मूर्धन्युशनाः काव्यो दैत्यैर्महीपते ।\nइमानि तस्य रत्नानि तस्येमे रत्नपर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042847, "chapter_id": 1957, "verse_number": "६-६-२३", "content_sanskrit": "तस्मात्कुबेरो भगवांश्चतुर्थं भागमश्रुते ।\nततः कलांशं वित्तस्य मनुष्येभ्यः प्रयच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042848, "chapter_id": 1957, "verse_number": "६-६-२४", "content_sanskrit": "पार्श्वे तस्योत्तरे दिव्यं सर्वर्तुकुसुमैश्चितम्।\nकर्णिकारवनं रम्यं शिलाजालसमुद्गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042849, "chapter_id": 1957, "verse_number": "६-६-२५", "content_sanskrit": "तत्र साक्षात्पशुपतिर्दिव्यैर्भूतैः समावृतः ।\nउमासहायो भगवान्रमते भूतभावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042850, "chapter_id": 1957, "verse_number": "६-६-२६", "content_sanskrit": "कर्णिकारमयी मालां बिभ्रत्पादावलम्बिनीम् ।\nत्रिभिर्नेत्रैः कृतोद्योतस्त्रिभिः सूर्यैरिवोदितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042851, "chapter_id": 1957, "verse_number": "६-६-२७", "content_sanskrit": "तमुग्रतपसः सिद्धाः सुव्रताः सत्यवादिनः ।\nपश्यन्ति नहि दुर्वृत्तैः शक्यो द्रुष्टुं महेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042852, "chapter_id": 1957, "verse_number": "६-६-२८", "content_sanskrit": "तस्य शैलस्य शिखरात्क्षीरधारा नरेश्वर।\nविश्वरूपाऽपरिमिता भीमनिर्घातनिःस्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042853, "chapter_id": 1957, "verse_number": "६-६-२९", "content_sanskrit": "पुण्या पुण्यतमैर्जुष्टा गङ्गा भागीरथी शुभा ।\nप्लवन्तीव प्रवेगेन ह्रदे चन्द्रमसः शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042854, "chapter_id": 1957, "verse_number": "६-६-३०", "content_sanskrit": "तया ह्युत्पादितः पुण्यः स ह्रदः सागरोपमः ।\nतां धारयामास तदा दुर्धरां पर्वतैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042855, "chapter_id": 1957, "verse_number": "६-६-३१", "content_sanskrit": "शतं वर्षसहस्राणां शिरसैव महेश्वरः ।\nमेरोस्तु पश्चिमे पार्श्वे केतुमालो महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042856, "chapter_id": 1957, "verse_number": "६-६-३२", "content_sanskrit": "जम्बूखण्डे तु तत्रैव महाजनपदो नृप ।\nआयुर्दशसहस्राणि वर्षाणां तत्र भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042857, "chapter_id": 1957, "verse_number": "६-६-३३", "content_sanskrit": "सुवर्णवर्णाश्च नराः स्त्रियश्चाप्सरसोपमाः ।\nअनामया वीतशोका नित्यं मुदितमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042858, "chapter_id": 1957, "verse_number": "६-६-३४", "content_sanskrit": "जायन्ते मानवास्तत्र निष्टप्तकनकप्रभाः ।\nगन्धमादनश्रृङ्गेषु कुबेरः सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042859, "chapter_id": 1957, "verse_number": "६-६-३५", "content_sanskrit": "संवृतोऽप्सरसां सङ्घैर्मोदते गुह्यकाधिपः ।\nगन्धमादनपार्श्वे तु पर त्वपरगण्डिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042860, "chapter_id": 1957, "verse_number": "६-६-३६", "content_sanskrit": "एकादशसहस्राणि वर्षाणां परमायुषः ।\nतत्र कृष्णा नरा राजंस्तेजोयुक्ता महाबलाः ।\nस्त्रियश्चोत्पलवर्णाभाः सर्वाः सुप्रियदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042861, "chapter_id": 1957, "verse_number": "६-६-३७", "content_sanskrit": "नीलात्परतरं श्वेतं श्वेताद्धैरण्यकं परम्।\nवर्षमैरष्वतं राजन्नानाजनपदावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042862, "chapter_id": 1957, "verse_number": "६-६-३८", "content_sanskrit": "धनुःसंस्थे महाराज द्वे वर्षे दक्षिणोत्तरे।\nइलावृत्तं मध्यमं तु पञ्च दीर्घाणि चैव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042863, "chapter_id": 1957, "verse_number": "६-६-३९", "content_sanskrit": "उत्तरोत्तरमेतेभ्यो वर्षमुद्रिच्यते गुणैः ।\nआयुःप्रमाणमारोग्यं धर्मतः कामतोऽर्थतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042864, "chapter_id": 1957, "verse_number": "६-६-४०", "content_sanskrit": "समन्वितानि भूतानि तेषु वर्षेषु भारत।\nएवमेषा महाराज पर्वतैः पृथिवी चिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2042865, "chapter_id": 1957, "verse_number": "६-६-४१", "content_sanskrit": "हेमकूटस्तु सुमहान्कैलासो नाम पर्वतः । ६-६-४१bयत्र वैश्रवणो राजन्गुह्यकैः सह मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2042866, "chapter_id": 1957, "verse_number": "६-६-४२", "content_sanskrit": "तत्र देवो महादेवो नित्यमास्ते सहोमया।\nशीते शिलातले रम्ये देवर्षिगणपूजितःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2042867, "chapter_id": 1957, "verse_number": "६-६-४३", "content_sanskrit": "अस्त्युत्तरेण कैलासं मैनाकं पर्वतं प्रति।\nहिरण्यश्रृङ्गः सुमहान्दिव्यो मणिमयो गिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2042868, "chapter_id": 1957, "verse_number": "६-६-४४", "content_sanskrit": "तस्य पार्श्वे महद्दिव्यं शुभ्रं काञ्चनवालुकम् ।\nरम्यं बिन्दुसरो नाम यत्र राजा भगीरथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2042869, "chapter_id": 1957, "verse_number": "६-६-४५", "content_sanskrit": "दृष्ट्वा भागीरथीं गङ्गामुवास बहुलाः समाः।\nयूपा मणिमयास्तत्र चैत्याश्चापि हिरण्मयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2042870, "chapter_id": 1957, "verse_number": "६-६-४६", "content_sanskrit": "तत्रेष्ट्वा तु गतः सिद्धिं सहस्राक्षो महायशाः।\nस्रष्टा भूतपतिर्यत्र सर्वलोकान्सनातनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2042871, "chapter_id": 1957, "verse_number": "६-६-४७", "content_sanskrit": "उपास्यते तिग्मतेजा यत्र भूतैः समन्ततः ।\nनरनारायणौ ब्रह्मा मनुः स्थाणुश्च पञ्चमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2042872, "chapter_id": 1957, "verse_number": "६-६-४८", "content_sanskrit": "तत्र दिव्या त्रिपथगा प्रथमं तु प्रतिष्ठिता।\nब्रह्मलोकादपक्रान्ता सप्तधा प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2042873, "chapter_id": 1957, "verse_number": "६-६-४९", "content_sanskrit": "वस्वौकसारा नलिनी पावनी च सरस्वती ।\nजम्बूनदी च सीता च गङ्गा सिंधुश्च सप्तमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2042874, "chapter_id": 1957, "verse_number": "६-६-५०", "content_sanskrit": "अचिन्त्या दिव्यसंकाशा प्रभोरेषैव संविधिः ।\nउपासते यत्र सत्रं सहस्रयुगपर्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2042875, "chapter_id": 1957, "verse_number": "६-६-५१", "content_sanskrit": "दृश्याऽदृश्या च भवति तत्र तत्र सरस्वती ।\nएता दिव्याः सप्त गङ्गास्त्रिषु लोकेषु विश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2042876, "chapter_id": 1957, "verse_number": "६-६-५२", "content_sanskrit": "रक्षांसि वै हिमवति हेमकूटे तु गुह्यकाः ।\nसर्पा नागाश्च निषधे गोकर्णं च तपोवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2042877, "chapter_id": 1957, "verse_number": "६-६-५३", "content_sanskrit": "देवासुराणां सर्वेषां श्वेतपर्वत उच्यते।\nगन्धर्वा निषधे नित्यं नीले ब्रह्मर्षयस्तथा ।\nश्रृङ्गवांस्तु महाराज देवानां प्रतिसंचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2042878, "chapter_id": 1957, "verse_number": "६-६-५४", "content_sanskrit": "इत्येतानि महाराज सप्त वर्षाणि भागशः।\nभूतान्युपनिविष्टानि गतिमन्ति ध्रुवाणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2042879, "chapter_id": 1957, "verse_number": "६-६-५५", "content_sanskrit": "तेषामृद्धिर्बहुविधा दृश्यते दैवमानुषी।\nअशक्या परिसंख्यातुं श्रद्धेया तु बुभूषता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2042880, "chapter_id": 1957, "verse_number": "६-६-५६", "content_sanskrit": "यां तु पृच्छसि मां राजन्दिव्यामेतां शशाकृतिम्।\nपार्श्वे शशस्य द्वे वर्षे उक्ते ये दक्षिणोत्तरे ।\nकर्णौ तु शाकद्वीपश्च काश्यपद्वीप एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2042881, "chapter_id": 1957, "verse_number": "६-६-५७", "content_sanskrit": "ताम्रपर्णीशिरो राजञ्छ्रीमान्मलयपर्वतः ।\nएतद्द्वितीयं द्वीपस्य दृश्यते शशसंस्थितम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2042882, "chapter_id": 1957, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि षष्ठोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]