[{"id": 2082843, "chapter_id": 2767, "verse_number": "१२-२७२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082844, "chapter_id": 2767, "verse_number": "१२-२७२-१", "content_sanskrit": "कथं कार्यं परीक्षेत शीघ्रं वाऽथ चिरेण वा।\nसर्वथा कार्यदुर्गेऽस्मिन्भवान्नः परमो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082845, "chapter_id": 2767, "verse_number": "१२-२७२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082846, "chapter_id": 2767, "verse_number": "१२-२७२-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nचिरकारेस्तु यत्पूर्वं वृत्तमाङ्गिरसां कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082847, "chapter_id": 2767, "verse_number": "१२-२७२-३", "content_sanskrit": "`गौतमस्य सुता ह्यासन्वीयांश्चिरकारिकः।\nचिरकारिक भद्रं ते भद्रं ते चिरकारिक।\nचिरकारी हि मेधावी नापराध्यति कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082848, "chapter_id": 2767, "verse_number": "१२-२७२-४", "content_sanskrit": "चिरकारी महाप्राज्ञो गौतमस्याभवत्सुतः।\nचिरेण सर्वकार्याणि विमृश्यार्थान्प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082849, "chapter_id": 2767, "verse_number": "१२-२७२-५", "content_sanskrit": "चिरं स चिन्तयत्यर्थांश्चिरं जाग्रच्चिरं स्वपन्।\nचिरं कार्याभिषत्तिं च चिरकारी तथोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082850, "chapter_id": 2767, "verse_number": "१२-२७२-६", "content_sanskrit": "अलसग्रहणं प्राप्तो दुर्मेधावीति चोच्यते।\nबुद्धिलाघवयुक्तेन जनेनादीर्घदर्शिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082851, "chapter_id": 2767, "verse_number": "१२-२७२-७", "content_sanskrit": "व्यभिचारे तु कस्मिंश्चिद्व्यतिक्रम्यापरान्सुतान्।\nपित्रोक्तः कुपितेनाथ जहीमां जननीमिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082852, "chapter_id": 2767, "verse_number": "१२-२७२-८", "content_sanskrit": "इत्युक्त्वा स तदा विप्रो गौतमो जपतां वरः।\nअविमृश्य महाभागो वनमेव जगाम सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082853, "chapter_id": 2767, "verse_number": "१२-२७२-९", "content_sanskrit": "स तथेति चिरेणोक्त्वा स्वभावाच्चिरकारिकः।\nविमृश्य चिरकारित्वाच्चिन्तयामास वै चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082854, "chapter_id": 2767, "verse_number": "१२-२७२-१०", "content_sanskrit": "पितुराज्ञां कथं कुर्यां न हन्यां मातरं कथम्।\nकथं धर्मच्छले नास्मिन्निमज्जेयमसाधुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082855, "chapter_id": 2767, "verse_number": "१२-२७२-११", "content_sanskrit": "पितुराज्ञा परो धर्मः स्वधर्मो मातृरक्षणम्।\nअस्वतन्त्रं च पुत्रत्वं किंतु मां नानुपीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082856, "chapter_id": 2767, "verse_number": "१२-२७२-१२", "content_sanskrit": "स्त्रियं हत्वा मातरं च को हि जातु सुखी भवेत्।\nपितरं चाप्यवज्ञाय कः प्रतिष्ठामवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082857, "chapter_id": 2767, "verse_number": "१२-२७२-१३", "content_sanskrit": "अनवज्ञा पितुर्युक्ता स्वधर्मो मातृरक्षणम्।\nयुक्तक्षमावुभावेतौ नातिवर्तेतमां कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082858, "chapter_id": 2767, "verse_number": "१२-२७२-१४", "content_sanskrit": "पिता ह्यात्मानमाधत्ते जायायां जायतामिति।\nशीलचारित्रगोत्रस्य धारणार्थं कुलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082859, "chapter_id": 2767, "verse_number": "१२-२७२-१५", "content_sanskrit": "सोऽहं मात्रा स्वयं पित्रा पुत्रत्वे प्रकृतः पुनः।\nविज्ञानं मे कथं न स्याद्द्वौ बुद्ध्ये चात्मसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082860, "chapter_id": 2767, "verse_number": "१२-२७२-१६", "content_sanskrit": "जातकर्मणि यत्प्राह पिता यच्चोपकर्मणि।\nपर्याप्तः स दृढीकारः पितुर्गौरवनिश्चये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082861, "chapter_id": 2767, "verse_number": "१२-२७२-१७", "content_sanskrit": "गुरुरग्र्यः परो धर्मः पोषणाध्यापनान्वितः।\nपिता यदाह धर्मः स वेदेष्वपि सुनिश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082862, "chapter_id": 2767, "verse_number": "१२-२७२-१८", "content_sanskrit": "प्रीतिमात्रं पितुः पुत्रः सर्वं पुत्रस्य वै पिता।\nशरीरादीनि देयानि पिता त्वेकः प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082863, "chapter_id": 2767, "verse_number": "१२-२७२-१९", "content_sanskrit": "तस्मात्पितुर्वचः कार्यं न विचार्यं कदाचन।\nपातकान्यपि पूयन्ते पितुःर शासनकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082864, "chapter_id": 2767, "verse_number": "१२-२७२-२०", "content_sanskrit": "भाग्यभोगे प्रसवने सर्वलोकनिदर्शने।\nधात्र्याश्चैव समायोगे सीमन्तोन्नयने तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082865, "chapter_id": 2767, "verse_number": "१२-२७२-२१", "content_sanskrit": "पिता धर्मः पिता स्वर्गः पिता हि परमं तपः।\nपितरि प्रीतिमापन्ने सर्वाः प्रीणन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082866, "chapter_id": 2767, "verse_number": "१२-२७२-२२", "content_sanskrit": "आशिषस्ता भजन्त्यनं पुरुषं प्राह यत्पिता।\nनिष्कृतिः सर्वपापानां पिता यच्चाभिनन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082867, "chapter_id": 2767, "verse_number": "१२-२७२-२३", "content_sanskrit": "मुच्यते बन्धनात्पुरुषं फलं वृक्षान्प्रमुच्यते।\nक्लिश्यन्नपि सुतस्नेहैः पिता पुत्रं न मुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082868, "chapter_id": 2767, "verse_number": "१२-२७२-२४", "content_sanskrit": "एतद्विचिन्तितं तावत्पुत्रस्य पितृगौरवम्।\nपिता नाल्पतरं स्थानं चिन्तयिष्यामि मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082869, "chapter_id": 2767, "verse_number": "१२-२७२-२५", "content_sanskrit": "यो ह्ययं मयि संघातो मर्त्यत्वे पाञ्चभौतिकः।\nअस्य मे जननी हेतुः पावकस्य यथाऽरणिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082870, "chapter_id": 2767, "verse_number": "१२-२७२-२६", "content_sanskrit": "माता देहारणिः पुंसां सर्वस्यार्तस्य निर्वृतिः।\nमातृलाभे सनाथत्वमनाथत्वं विपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082871, "chapter_id": 2767, "verse_number": "१२-२७२-२७", "content_sanskrit": "न च शोचति नाप्येनं स्थाविर्यमपकर्षति।\nश्रिया हीनोऽपि यो गेहमम्बेति प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082872, "chapter_id": 2767, "verse_number": "१२-२७२-२८", "content_sanskrit": "पुत्रपौत्रोपपन्नोपि जननीं यः समाश्रितः।\nअपि वर्षशतस्यान्ते स द्विहायनवच्चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082873, "chapter_id": 2767, "verse_number": "१२-२७२-२९", "content_sanskrit": "समर्थं वाऽसमर्थं वा कृशं वाप्यकृशं तथा।\nरक्षत्येव सुतं माता नान्यः पोष्टा विधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082874, "chapter_id": 2767, "verse_number": "१२-२७२-३०", "content_sanskrit": "तदा स वृद्धो भवति तदा भवति दुःखितः।\nतदा शून्यं जगत्तस्य यदा मात्रा वियुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082875, "chapter_id": 2767, "verse_number": "१२-२७२-३१", "content_sanskrit": "नास्ति मातृसमा च्छाया नास्ति मातृसमा गतिः।\nनास्ति मातृसमं त्राणं नास्ति मातृसमा प्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082876, "chapter_id": 2767, "verse_number": "१२-२७२-३२", "content_sanskrit": "कुक्षौ संधारणाद्धात्री जननाज्जननी स्मृता।\nअङ्गानां वर्धनादम्बा वीरसूत्वेन वीरसूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082877, "chapter_id": 2767, "verse_number": "१२-२७२-३३", "content_sanskrit": "शिशोः शुश्रूषणाच्छुश्रूर्माता देहमनन्तरम्।\nचेतनावान्स को हन्याद्यस्य नासुषिरं शिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082878, "chapter_id": 2767, "verse_number": "१२-२७२-३४", "content_sanskrit": "दंपत्योः प्राणसंश्लेषे योऽभिसन्धिः कृतः किल।\nतं माता च पिता चेति भूतार्थो मातरि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082879, "chapter_id": 2767, "verse_number": "१२-२७२-३५", "content_sanskrit": "माता जानाति यद्गोत्रं माता जानाति यस्य सः।\nमातुर्भरणमात्रेण प्रीतिः स्नेहः पितुः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082880, "chapter_id": 2767, "verse_number": "१२-२७२-३६", "content_sanskrit": "पाणिबन्धं स्वयं कृत्वा सहधर्ममुपेत्य च।\nयदा यास्यन्ति पुरुषाः स्त्रियो नार्हन्ति याप्यतां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2082881, "chapter_id": 2767, "verse_number": "१२-२७२-३७", "content_sanskrit": "भरणाद्धि स्त्रियो भर्ता पालनाद्धि पतिस्तथा।\nगुणस्यास्य निवृत्तौ तु न भर्ता न पुनः पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2082882, "chapter_id": 2767, "verse_number": "१२-२७२-३८", "content_sanskrit": "एवं स्त्री नापराघ्नोति नर एवापराध्यति।\nव्युच्चरंश्च महादोषं नर एवापराध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2082883, "chapter_id": 2767, "verse_number": "१२-२७२-३९", "content_sanskrit": "स्त्रिया हि परमो भर्ता दैवतं परमं स्मृतम्।\nतस्मात्मना तु सदृशमात्मानं परमं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2082884, "chapter_id": 2767, "verse_number": "१२-२७२-४०", "content_sanskrit": "नापराधोऽस्ति नारीणां नर एवापराध्यति।\nसर्वकार्यापराध्यत्वान्नापराध्यन्ति चाङ्गनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2082885, "chapter_id": 2767, "verse_number": "१२-२७२-४१", "content_sanskrit": "यश्चनोक्तोऽथ निर्देशः स्त्रिया मैथुनवृद्धये।\nतस्य स्मारयतो व्यक्तमधर्मो नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2082886, "chapter_id": 2767, "verse_number": "१२-२७२-४२", "content_sanskrit": "एवं नारीं मातरं च गौरवे चाधिके स्थिताम्।\nअवध्यां तु विजानीयुः पशवोऽप्यविचक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2082887, "chapter_id": 2767, "verse_number": "१२-२७२-४३", "content_sanskrit": "देवतानां समावायमेकस्थं पितरं विदुः।\nमर्त्यानां देवतानां च स्नेहादभ्येति मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2082888, "chapter_id": 2767, "verse_number": "१२-२७२-४४", "content_sanskrit": "एवं विमृशतस्तस्य विरकारितया बहु।\nदीर्घः कालो व्यतिक्रान्तस्ततोस्याभ्यागमत्पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2082889, "chapter_id": 2767, "verse_number": "१२-२७२-४५", "content_sanskrit": "मेधातिथिर्महाप्राज्ञो गौतमस्तपसि स्थितः।\nविमृश्य तेन कालेन पत्न्याः संस्थाव्यतिक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2082890, "chapter_id": 2767, "verse_number": "१२-२७२-४६", "content_sanskrit": "सोऽब्रवीद्भृशसंतप्तो दुःखेनाश्रूणि वर्तयन्।\nश्रुतधैर्यप्रसादेन पश्चात्तापमुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2082891, "chapter_id": 2767, "verse_number": "१२-२७२-४७", "content_sanskrit": "आश्रमं मम संप्राप्तस्त्रिलोकेशः पुरंदरः।\nअतिथिव्रतमास्थाय ब्राह्मण्यं रूपमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2082892, "chapter_id": 2767, "verse_number": "१२-२७२-४८", "content_sanskrit": "स मया सान्त्वितो वाग्भिः स्वागतेनाभिषूजितः।\nअर्ध्यं पाद्यं यथान्यायं मया च प्रतिपादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2082893, "chapter_id": 2767, "verse_number": "१२-२७२-४९", "content_sanskrit": "परवानस्मि चेत्युक्तः प्रणयिष्यति तेन च।\nअत्र चाकुशले जाते स्त्रिया नास्ति व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2082894, "chapter_id": 2767, "verse_number": "१२-२७२-५०", "content_sanskrit": "एवं न स्त्री न चैवाहं नाध्वगस्त्रिदशेश्वरः।\nअपराध्यति धर्मस्य प्रमादस्त्वपराध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2082895, "chapter_id": 2767, "verse_number": "१२-२७२-५१", "content_sanskrit": "ईर्ष्याजं व्यसनं प्राहुस्तेन चैवोर्ध्वरेतसः।\nईर्ष्यया त्वहमाक्षिप्तो मग्नो दुष्कृतसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2082896, "chapter_id": 2767, "verse_number": "१२-२७२-५२", "content_sanskrit": "हत्वा साध्वीं च नारीं च व्यसनित्वाच्च वासिताम्।\nभर्तव्यत्वेन भार्यां च को नु मां तारयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2082897, "chapter_id": 2767, "verse_number": "१२-२७२-५३", "content_sanskrit": "अन्तरेण मयाऽऽज्ञप्तश्चिरकारीत्युदारधीः।\nयद्यद्य चिरकारी स्यात्स मां त्रायेत पातकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2082898, "chapter_id": 2767, "verse_number": "१२-२७२-५४", "content_sanskrit": "चिरकारिक भद्रं ते भद्रं ते चिरकारिक।\nयद्यद्य चिरकारी त्वं ततोऽसि चिरकारिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2082899, "chapter_id": 2767, "verse_number": "१२-२७२-५५", "content_sanskrit": "त्राहि मां मातरं चैव तपो यच्चार्जितं त्वया।\nआत्मानं पातकेभ्यश्च भवाद्य चिरकारिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2082900, "chapter_id": 2767, "verse_number": "१२-२७२-५६", "content_sanskrit": "सहजं चिरकारित्वमतिप्रज्ञतया तव।\nसफलं तत्तथा तेऽस्तु भवाद्य चिरकारिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2082901, "chapter_id": 2767, "verse_number": "१२-२७२-५७", "content_sanskrit": "चिरमांशसितो मात्रा चिरं गर्भेण धारितः।\nसफलं चिकारित्वं कुरु त्वं चिरकारिक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2082902, "chapter_id": 2767, "verse_number": "१२-२७२-५८", "content_sanskrit": "चिरायते च संतापाच्चिरं स्वपिति धारितः।\nआवयोश्चिरसंतापादवेक्ष्य चिरकारिक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2082903, "chapter_id": 2767, "verse_number": "१२-२७२-५९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2082904, "chapter_id": 2767, "verse_number": "१२-२७२-५९", "content_sanskrit": "एवं स दुःखितो राजन्महर्षिर्गौतमस्तदा।\nचिरकारिं ददर्शाथ पुत्रं स्थितमथान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2082905, "chapter_id": 2767, "verse_number": "१२-२७२-६०", "content_sanskrit": "चिरकारी तु पितरं दृष्ट्वा परमदुःखितः।\nशस्त्रं त्यक्त्वा ततो मूर्ध्ना प्रसादायोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2082906, "chapter_id": 2767, "verse_number": "१२-२७२-६१", "content_sanskrit": "गौतमस्तं ततो दृष्ट्वा शिरसा पतितं भुवि।\nपत्नीं चैव निराकारां परामभ्यागमन्मुदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2082907, "chapter_id": 2767, "verse_number": "१२-२७२-६२", "content_sanskrit": "न हि सा तेन संभेदं पत्नी नीता महात्मना।\nविजने चाश्रमस्थेन पुत्रश्चापि समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2082908, "chapter_id": 2767, "verse_number": "१२-२७२-६३", "content_sanskrit": "हन्या इति समादेशः शस्त्रपाणौ सुते स्थिते।\nविनीते प्रसवत्यर्थे विवासे चात्मकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2082909, "chapter_id": 2767, "verse_number": "१२-२७२-६४", "content_sanskrit": "बुद्धिश्चासीत्सुतं दृष्ट्वा पितुश्चरणयोर्नतम्।\nशस्त्रग्रहणचापल्यं संवृणोति भयादिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2082910, "chapter_id": 2767, "verse_number": "१२-२७२-६५", "content_sanskrit": "ततः पित्रा चिरं स्तुत्वा चिरं चाघ्राय मूर्धनि।\nचिरं दोर्भ्यां परिष्वज्य चिरं जीवेत्युदाहृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2082911, "chapter_id": 2767, "verse_number": "१२-२७२-६६", "content_sanskrit": "एवं स गौतमः पुत्रं प्रीतिहर्षगुणैर्युतः।\nअभिनन्द्य महाप्रज्ञ इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2082912, "chapter_id": 2767, "verse_number": "१२-२७२-६७", "content_sanskrit": "चिरकारिक भद्रं ते चिरकारी चिरं भव।\nचिराय यदि ते सौम्य चिरमस्मि न दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2082913, "chapter_id": 2767, "verse_number": "१२-२७२-६८", "content_sanskrit": "गाथाश्चाप्यब्रवीद्विद्वान्गौतमो मुनिसत्तमः।\nचिरकारिषु धीरेषु गुणोद्देशसमाश्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2082914, "chapter_id": 2767, "verse_number": "१२-२७२-६९", "content_sanskrit": "चिरेण मित्रं बध्नीयाच्चिरेण च कृतं त्यजेत्।\nचिरेण हि कृतं मित्रं चिरं धारणमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2082915, "chapter_id": 2767, "verse_number": "१२-२७२-७०", "content_sanskrit": "रागे दर्पे च माने च द्रोहे पापे च कर्मणि।\nअप्रिये चैव कर्तव्ये चिरकारी प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2082916, "chapter_id": 2767, "verse_number": "१२-२७२-७१", "content_sanskrit": "बन्धूनां सुहृदां चैव भृत्यानां स्त्रीजनस्य च।\nअव्यक्तेष्वपराधेषु चिरकारी प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2082917, "chapter_id": 2767, "verse_number": "१२-२७२-७२", "content_sanskrit": "एवं स गौतमस्तत्र प्रीतः पुत्रस्य भारत।\nकर्मणा तेन कौरव्य चिरकारितया तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2082918, "chapter_id": 2767, "verse_number": "१२-२७२-७३", "content_sanskrit": "एवं सर्वेषु कार्येषु विमृश्य पुरुषस्ततः।\nचिरेण निश्चयं कृत्वा चिरं न परितप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2082919, "chapter_id": 2767, "verse_number": "१२-२७२-७४", "content_sanskrit": "चिरं धारयते रोषं चिरं कर्म नियच्छति।\nपश्चात्तापकरं कर्म न किंचिदुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2082920, "chapter_id": 2767, "verse_number": "१२-२७२-७५", "content_sanskrit": "चिरं वृद्धानुपासीत चिरमन्यांश्च पूजयेत्।\nचिरं धर्मं निषेवेत कुर्याच्चान्वेषणं चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2082921, "chapter_id": 2767, "verse_number": "१२-२७२-७६", "content_sanskrit": "चिरमन्वास्य विदुषश्चिरं शिष्टान्निषेव्य च।\nचिरं विनीय चात्मानं चिरं चात्यनवज्ञताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2082922, "chapter_id": 2767, "verse_number": "१२-२७२-७७", "content_sanskrit": "ब्रुवतश्च परस्यापि वाक्यं धर्मोपसंहितम्।\nचिरं पृष्टोऽपि च ब्रूयाच्चिरं न परितप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2082923, "chapter_id": 2767, "verse_number": "१२-२७२-७८", "content_sanskrit": "उपास्य बहुलास्तस्मिन्नाश्रमो सुमहातपाः।\nसमाः स्वर्गं गतो विप्रः पुत्रेण सहितस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2082924, "chapter_id": 2767, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विसप्तत्यधिकद्विशततमोऽध्यायः॥ २७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]