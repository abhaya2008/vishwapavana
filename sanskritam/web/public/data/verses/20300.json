[{"id": 7000300000, "chapter_id": 20300, "verse_number": "१-५४-१", "content_sanskrit": "श्रीभगवानुवाच ।\nअद्रोहकस्य चाख्यातो महिमा लोकदुःसहः ।\nएकतल्पगतां वामां क्षांत्वा सर्वजितोऽभवत्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000300001, "chapter_id": 20300, "verse_number": "१-५४-२", "content_sanskrit": "ज्ञानिनामपिदुःसाध्यं मुनीनां ब्रह्मचारिणां ।\nसुरासुरमनुष्याणां विषमं तत्समं गतः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000300002, "chapter_id": 20300, "verse_number": "१-५४-३", "content_sanskrit": "स्वभावाद्विषमं कामं जेतुं कः पुरुषः क्षमः ।\nअद्रोहकमृते विप्र स एव भवजित्पुमान्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000300003, "chapter_id": 20300, "verse_number": "१-५४-४", "content_sanskrit": "अहल्याहरणादेव सुरेशस्य भगांकता ।\nपुनर्देव्याः प्रसादाच्च सहस्राक्षेति विश्रुतः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000300004, "chapter_id": 20300, "verse_number": "१-५४-५", "content_sanskrit": "विदितं सर्वलोके च त्रैलोक्ये सचराचरे ।\nद्विज उवाच ।\nकथं च देवदेवस्य अहल्याहरणं प्रभो॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000300005, "chapter_id": 20300, "verse_number": "१-५४-६", "content_sanskrit": "भगांकत्वं च संप्राप सहस्राक्षः सुराधिपः ।\nन गां कोपि भगांकत्वं संप्राप्तस्सुरराट्कथम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000300006, "chapter_id": 20300, "verse_number": "१-५४-७", "content_sanskrit": "दुःश्रुतं सुरवैकल्यं श्रोतुमिच्छामि तत्वतः ।\nश्रीभगवानुवाच ।\nपुरा स्वांतोद्भवां कन्यां लोकेशश्च महामनाः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000300007, "chapter_id": 20300, "verse_number": "१-५४-८", "content_sanskrit": "गौतमाय ददौ धाता लोकपालाग्रतो मुदा ।\nततस्तु लोकपालानां मन्मथाविष्टचेतसाम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000300008, "chapter_id": 20300, "verse_number": "१-५४-९", "content_sanskrit": "शचीपतेस्तु संमोहो हृदि शल्य इव स्थितः ।\nलोकपालानतिक्रम्य सुवेषा वरवर्णिनी॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000300009, "chapter_id": 20300, "verse_number": "१-५४-१०", "content_sanskrit": "द्विजाय रत्नभूतैषा दत्ता किंवा करोम्यहम् ।\nइति संचिंत्य तस्यास्तु वर्तमाने च यौवने॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000300010, "chapter_id": 20300, "verse_number": "१-५४-११", "content_sanskrit": "पुनश्च मायया दृष्टं रूपं तस्यास्सुशोभनम् ।\nपुनश्चिन्तयमानोऽसौ गौतमाध्यासनं गतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000300011, "chapter_id": 20300, "verse_number": "१-५४-१२", "content_sanskrit": "पश्चात्तु तस्य गमनाद्यद्वृत्तं तच्छृणुष्व मे ।\nएकदा गौतमः स्नातुं गतोऽसौ पुष्करं प्रति॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000300012, "chapter_id": 20300, "verse_number": "१-५४-१३", "content_sanskrit": "साध्वी च गृहशौचे च गृहवस्तुनि तत्परा ।\nप्रवृत्ता देववास्तूनां बलिकर्तुं च तत्परा॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000300013, "chapter_id": 20300, "verse_number": "१-५४-१४", "content_sanskrit": "इंधनं वह्निकार्यं च नित्यकर्मानुसंचयम् ।\nएतस्मिन्नंतरे शक्रो मुनेस्तस्य महात्मनः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000300014, "chapter_id": 20300, "verse_number": "१-५४-१५", "content_sanskrit": "रूपमास्थाय गात्रेण प्रविवेशोटजं मुदा ।\nपतिव्रता पतिं दृष्ट्वा श्रद्धया परया सती॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000300015, "chapter_id": 20300, "verse_number": "१-५४-१६", "content_sanskrit": "देवस्थाने च वस्तूनां संचयं कर्तुमुद्यता ।\nततस्तामब्रवीदार्तो मुनिवेषधरो हरिः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000300016, "chapter_id": 20300, "verse_number": "१-५४-१७", "content_sanskrit": "प्रद्युम्नवशगो वामे देहि मे चुंबनादिकम् ।\nएतस्मिन्नंतरे सा च त्रपायुक्ताऽब्रवीद्वचः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000300017, "chapter_id": 20300, "verse_number": "१-५४-१८", "content_sanskrit": "देवकार्यादिकं त्यक्त्वा वक्तुं नार्हसि मे प्रभो ।\nसर्वं जानासि धर्मज्ञ पुण्यानां निश्चयं मुने॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000300018, "chapter_id": 20300, "verse_number": "१-५४-१९", "content_sanskrit": "अयमर्थो हि वेलायामधुनैव न युज्यते ।\nततस्तां चारुसर्वांगीं दृष्ट्वा मन्मथपीडितः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000300019, "chapter_id": 20300, "verse_number": "१-५४-२०", "content_sanskrit": "अलं प्रियेन वक्तव्यं हृच्छयो मे प्रजायते ।\nकर्तव्यं चाप्यकर्तव्यं पत्युर्वचनसंमतम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000300020, "chapter_id": 20300, "verse_number": "१-५४-२१", "content_sanskrit": "करोति सततं या च सा च नारी पतिव्रता ।\nलंघयेद्या च तस्याज्ञां सुरते च विशेषतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000300021, "chapter_id": 20300, "verse_number": "१-५४-२२", "content_sanskrit": "पुण्यं तस्या भवेन्नष्टं दुर्गतिं चाधिगच्छति ।\nसाब्रवीद्देववस्तूनि संति देवार्थतो मुने॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000300022, "chapter_id": 20300, "verse_number": "१-५४-२३", "content_sanskrit": "नित्यकर्माणि चान्यानि किं वा तेषु विपर्ययः ।\nस चोवाच सतीं तत्र देह्यालिगादिकं मम॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000300023, "chapter_id": 20300, "verse_number": "१-५४-२४", "content_sanskrit": "मनसा भयमुत्सृज्य मया दत्तानि तानि च ।\nइत्युक्त्वा तां परिष्वज्य कृतस्तेन मनोरथः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000300024, "chapter_id": 20300, "verse_number": "१-५४-२५", "content_sanskrit": "एतस्मिन्नंतरे विप्र मुनेर्हृद्या सकल्मषम् ।\nततो ध्यानं समारभ्याजानाद्वृत्तं शचीपतेः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000300025, "chapter_id": 20300, "verse_number": "१-५४-२६", "content_sanskrit": "तूर्णमेव द्वारदेशे गत्वा च समुपस्थितः ।\nशक्रो मुनिं तु संलक्ष्य चौतुदेहं विवेश ह॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000300026, "chapter_id": 20300, "verse_number": "१-५४-२७", "content_sanskrit": "गच्छतः पृषदंशस्य पद्धतौ प्रचचाल ह ।\nमुनिस्तत्रावदत्तं वै कस्त्वं मार्जाररूपधृत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000300027, "chapter_id": 20300, "verse_number": "१-५४-२८", "content_sanskrit": "भयात्तस्य मुनेरग्रे शक्रः प्रांजलिराश्रितः ।\nमघवंतं पुरो दृष्ट्वा चुकोप मुनिपुंगवः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000300028, "chapter_id": 20300, "verse_number": "१-५४-२९", "content_sanskrit": "यत्त्वया चेदृशं कर्म भगार्थं छलसाहसम् ।\nकृतं तस्मात्तवांगेषु सहस्रभगमुत्तमम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000300029, "chapter_id": 20300, "verse_number": "१-५४-३०", "content_sanskrit": "भवत्विह तु पापिष्ठ लिंगं ते निपतिष्यति ।\nगच्छ मे पुरतो मूढ सुरस्थानं दिवौकसः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000300030, "chapter_id": 20300, "verse_number": "१-५४-३१", "content_sanskrit": "पश्यंति मुनिशार्दूला नराः सिद्धास्सहोरगाः ।\nएवमुक्त्वा मुनिश्रेष्ठो रुदंतीं तां पतिव्रताम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000300031, "chapter_id": 20300, "verse_number": "१-५४-३२", "content_sanskrit": "पप्रच्छ किमिदानीं ते कर्म दारुणमागतम् ।\nइत्युक्ता वेपमाना सा भीता पतिमुवाच ह॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000300032, "chapter_id": 20300, "verse_number": "१-५४-३३", "content_sanskrit": "अज्ञानाद्यत्कृतं कर्म क्षंतुमर्हसि वै प्रभो ।\nमुनिरुवाच ।\nपरेणाभिगतासि त्वममेध्या पापचारिणी॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000300033, "chapter_id": 20300, "verse_number": "१-५४-३४", "content_sanskrit": "अस्थिचर्मसमाविष्टा निर्मांसा नखवर्जिता ।\nचिरं स्थास्यसि चैकापि त्वां पश्यंतु जनाः स्त्रियः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000300034, "chapter_id": 20300, "verse_number": "१-५४-३५", "content_sanskrit": "दुःखिता तमुवाचेदं शापस्यांतो विधीयताम् ।\nइत्युक्ते करुणाविष्टो मन्युनापि परिप्लुतः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000300035, "chapter_id": 20300, "verse_number": "१-५४-३६", "content_sanskrit": "जगाद गौतमो वाक्यं रामो दाशरथिर्यदा ।\nवनमभ्यागतो विष्णुः सीतालक्ष्मणसंयुतः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000300036, "chapter_id": 20300, "verse_number": "१-५४-३७", "content_sanskrit": "दृष्ट्वा त्वां दुःखितां शुष्कां निर्देहां पथिसंस्थितां ।\nगदिष्यति च वै रामो वसिष्ठस्याग्रतो हसन्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000300037, "chapter_id": 20300, "verse_number": "१-५४-३८", "content_sanskrit": "किमियं शुष्करूपा च प्रतिमास्थिमयी शवा ।\nन दृष्टं मे पुरा ब्रह्मन्रूपं लोकविपर्ययम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000300038, "chapter_id": 20300, "verse_number": "१-५४-३९", "content_sanskrit": "ततो रामं महाभागं विष्णुं मानुषविग्रहम् ।\nयद्वृत्तमासीत्पूर्वं तद्वसिष्ठः कथयिष्यति॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000300039, "chapter_id": 20300, "verse_number": "१-५४-४०", "content_sanskrit": "वसिष्ठवचनं श्रुत्वा रामो वक्ष्यति धर्मवित् ।\nअस्या दोषो न चैवास्ति दोषोयं पाकशासने॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000300040, "chapter_id": 20300, "verse_number": "१-५४-४१", "content_sanskrit": "एवमुक्ते तु रामेण त्यक्त्वा रूपं जुगुप्सितं ।\nदिव्यं रूपं समास्थाय मद्गृहं चागमिष्यसि॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000300041, "chapter_id": 20300, "verse_number": "१-५४-४२", "content_sanskrit": "शप्त्वा तु गौतमस्तां हि तपस्तप्तुं गतो वनम् ।\nततोत्यंतं शुष्करूपा तथैव पथि संस्थिता॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000300042, "chapter_id": 20300, "verse_number": "१-५४-४३", "content_sanskrit": "रामस्य वचनादेव गौतमं पुनरागता ।\nगौतमोपि तया सार्द्धमद्यैवं दिवि तिष्ठति॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000300043, "chapter_id": 20300, "verse_number": "१-५४-४४", "content_sanskrit": "इंद्रोपि त्रपयायुक्तः स्थितश्चांतर्जले चिरम् ।\nस्थित्वा चांतर्जले देवीमस्तौदिंद्राक्षिसंज्ञिताम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000300044, "chapter_id": 20300, "verse_number": "१-५४-४५", "content_sanskrit": "सुप्रसन्ना ततो देवी स्तोत्रेण परितोषिता ।\nगत्वोवाच ततः सा च वरोस्मत्तो विगृह्यताम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000300045, "chapter_id": 20300, "verse_number": "१-५४-४६", "content_sanskrit": "ततो देवीमुवाचेदं शक्रः परपुरंजयः ।\nत्वत्प्रसादाच्च मे देवि वैरूप्यं मुनिशापजम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000300046, "chapter_id": 20300, "verse_number": "१-५४-४७", "content_sanskrit": "संत्यज्य देवराज्यं च लब्ध्वाहं तु पुरा यथा ।\nतमुवाच ततो देवी पापं तं मुनिशापजम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000300047, "chapter_id": 20300, "verse_number": "१-५४-४८", "content_sanskrit": "किंतु बुद्धिं सृजाम्यद्य येन लोकैर्न लक्ष्यते॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000300048, "chapter_id": 20300, "verse_number": "१-५४-४९", "content_sanskrit": "योनिमध्यगतं दृष्टि सहस्रं ते भविष्यति ।\nसहस्राक्ष इति ख्यातस्सुरराज्यं करिष्यसि॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000300049, "chapter_id": 20300, "verse_number": "१-५४-५०", "content_sanskrit": "मेषांडं तव शिश्नं च भविष्यति च मद्वरात् ।\nइत्युक्त्वा सा जगन्माता तत्रैवांतरधीयत॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000300050, "chapter_id": 20300, "verse_number": "१-५४-५१", "content_sanskrit": "शक्रो देववरैः पूज्यो ह्यद्यापि दिवि वर्तते ।\nइंद्रस्यैतादृशी कामादवस्था द्विजसत्तम॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]