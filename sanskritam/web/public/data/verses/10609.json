[{"id": 50002533, "chapter_id": 10609, "verse_number": "1", "content_sanskrit": "यस्य सर्वे समारम्भाः कामसङ्कल्पवर्जिताः। ज्ञानाग्निदग्धकर्माणं तमाहुः पण्डितं बुधाः॥ ४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002534, "chapter_id": 10609, "verse_number": "2", "content_sanskrit": "त्यक्त्वा कर्मफलासङ्गं नित्यतृप्तो(ऽ)निराश्रयः। कर्मण्यभिप्रवृत्तोऽपि नैव किञ्चित् करोति सः॥ ४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002535, "chapter_id": 10609, "verse_number": "3", "content_sanskrit": "॥ कामादित्यागोपायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002536, "chapter_id": 10609, "verse_number": "4", "content_sanskrit": "निराशीर्यतचित्तात्मा त्यक्तसर्वपरिग्रहः। शारीरं केवलं कर्म कुर्वन्नाप्नोति किल्बिषम्॥ ४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002537, "chapter_id": 10609, "verse_number": "5", "content_sanskrit": "॥ यतचित्तात्मनो लक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002538, "chapter_id": 10609, "verse_number": "6", "content_sanskrit": "यदृच्छालाभसन्तुष्टो द्वन्द्वातीतो विमत्सरः। समः सिद्धावसिद्धौ च कृत्वाऽपि न निबद्ध्यते॥ ४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50002539, "chapter_id": 10609, "verse_number": "7", "content_sanskrit": "॥ उपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50002540, "chapter_id": 10609, "verse_number": "8", "content_sanskrit": "गतसङ्गस्य मुक्तस्य ज्ञानावस्थितचेतसः। यज्ञायाचरतः कर्म समग्रं प्रविलीयते॥ ४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50002541, "chapter_id": 10609, "verse_number": "9", "content_sanskrit": "॥ ज्ञानावस्थितचेतस्त्वस्पष्टीकरणम् /अभिमानत्यागादिस्वरूपविवेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50002542, "chapter_id": 10609, "verse_number": "10", "content_sanskrit": "ब्रह्मार्पणं ब्रह्महविर्ब्रह्माग्नौ ब्रह्मणा हुतम्। ब्रह्मैव तेन गन्तव्यं ब्रह्म-कर्म समाधिना॥ ४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]