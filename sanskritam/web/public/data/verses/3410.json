[{"id": 2111380, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "दुष्षन्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111381, "chapter_id": 3410, "verse_number": "१", "content_sanskrit": "सुव्यक्तं राजपुत्री त्वं यथा कल्याणि भाषसे ।\nभार्या मे भव सुश्रोणि ब्रूहि किं करवाणि ते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111382, "chapter_id": 3410, "verse_number": "२", "content_sanskrit": "सुवर्णमालां वासांसि कुण्डले परिपादुके ।\nनानापट्टणजैः शुभ्रैर्मणिरत्नैश्च शोभनैः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111383, "chapter_id": 3410, "verse_number": "३", "content_sanskrit": "आहरामि तवाद्याहं निष्कादीन्यमितानि च ।\nसर्वं राज्यं तवाद्य त्वं भार्या मे भव शोभने \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111384, "chapter_id": 3410, "verse_number": "४", "content_sanskrit": "गान्धर्वेण च मां भीरु विवाहेनैहि सुन्दरि ।\nविवाहानां हि रम्भोरु गान्धर्वः श्रेष्ठ उच्यते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111385, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111386, "chapter_id": 3410, "verse_number": "५", "content_sanskrit": "फलाहारो गतो राजन् पिता मम महातपाः ।\nमुहूर्तं सम्प्रतीक्षस्व स मां तुभ्यं प्रदास्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111387, "chapter_id": 3410, "verse_number": "६", "content_sanskrit": "पिता हि मे प्रभुर्नित्यं दैवतं परमं मम ।\nयस्य मां दास्यति पिता स मे भर्ता भविष्यति \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111388, "chapter_id": 3410, "verse_number": "७", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने ।\nपुत्रस्तु स्थाविरे भावे न स्त्री स्वातन्त्र्यमर्हति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111389, "chapter_id": 3410, "verse_number": "८", "content_sanskrit": "अवमन्यमाना राजेन्द्र पितरं मे मनस्विनम् ।\nअधर्मेण हि धर्मिष्ठ कथं वरमुपास्महे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111390, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "दुष्षन्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111391, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "मा मैवं वद सुश्रोणि तपोराशिं दयात्मकम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111392, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "शकन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111393, "chapter_id": 3410, "verse_number": "९", "content_sanskrit": "मन्युप्रहरणा विप्रा न विप्राः शस्त्रपाणयः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111394, "chapter_id": 3410, "verse_number": "१०", "content_sanskrit": "मन्युना घ्नन्ति ते शत्रून् वज्रेणेन्द्र इवासुरान् ।\nअग्निर्दहति तेजोभिः सूर्यो दहति रश्मिभिः ।\nराजा दहति दण्डेन ब्राह्मणो मन्युना दहेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111395, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "दुष्षन्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111396, "chapter_id": 3410, "verse_number": "११", "content_sanskrit": "जानामि भद्रे महर्षिं तस्य मन्युर्न विद्यते ।\nइच्छामि त्वां वरारोहे भज मां त्वमनिन्दिते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111397, "chapter_id": 3410, "verse_number": "१२", "content_sanskrit": "त्वदर्थं मां स्थितं विद्धि त्वद्गतं हि मनो मम ।\nआत्मनो बन्धुरात्मैव गतिरात्मैव चात्मनः ।\nआत्मनो मित्रमात्मैव शत्रुरात्मैव चात्मनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111398, "chapter_id": 3410, "verse_number": "१३", "content_sanskrit": "आत्मनैवात्मनो दानं कर्तुमर्हसि धर्मतः ।\nअष्टावेव समासेन विवाहा धर्मतः स्मृताः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111399, "chapter_id": 3410, "verse_number": "१५", "content_sanskrit": "ब्राह्मो दैवस्तथैवार्षः प्राजापत्यस्तथाऽऽसुरः ।\nगान्धर्वो राक्षसश्चैव पैशाचश्चाष्टमोऽधमः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111400, "chapter_id": 3410, "verse_number": "१६", "content_sanskrit": "तेषां धर्म्यं यथापूर्वं मनुः स्वायम्भुवोऽब्रवीत् ।\nप्रशस्तांश्चतुरः पूर्वान् ब्राह्मणस्यावधारय \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111401, "chapter_id": 3410, "verse_number": "१७", "content_sanskrit": "षडानुपूर्व्यात् क्षत्रस्य विद्धि धर्म्याननिन्दिते ।\nराज्ञां तु राक्षसोऽयुक्तो विट्छूद्रेष्वासुरः स्मृतः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111402, "chapter_id": 3410, "verse_number": "१६", "content_sanskrit": "पञ्चानां च त्रयो धर्म्या द्वावधर्मौ मताविह ।\nपैशाच आसुरश्चैव न कर्तव्यौ कथञ्चन \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111403, "chapter_id": 3410, "verse_number": "१७", "content_sanskrit": "अन्येन विधिना कार्यो धर्मश्चैव सनातनः ।\nगान्धर्वराक्षसौ क्षत्रे धर्म्यौ तौ मा विशङ्कथाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111404, "chapter_id": 3410, "verse_number": "१८", "content_sanskrit": "पृथग् वा यदि वा मिश्रौ कर्तव्यौ नात्र संशयः ।\nसा त्वं मम सकामस्य सकामा भव शोभने ।\nगान्धर्वेण विवाहेन भार्या मे भव भामिनि \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111405, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111406, "chapter_id": 3410, "verse_number": "१९", "content_sanskrit": "यदि धर्मपथस्त्वेष यदि चात्मा प्रभुर्मम ।\nप्रदाने पौरवश्रेष्ठ शृणु मे समयं प्रभो \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111407, "chapter_id": 3410, "verse_number": "२०", "content_sanskrit": "सत्यं मे प्रतिजानीष्व यत् त्वां याचाम्यहं रहः ।\nमम जायेत यः पुत्रः स राजा त्वदनन्तरम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111408, "chapter_id": 3410, "verse_number": "२१", "content_sanskrit": "युवराजश्च कर्तव्यः सत्यमेतद् ब्रवीहि मे ।\nयद्येतदेवं दुष्षन्त अस्तु मे सङ्गमस्त्वया \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111409, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111410, "chapter_id": 3410, "verse_number": "२२", "content_sanskrit": "तस्यास्तु सर्वं संश्रुत्य यथोक्तं स विशाम्पतिः ।\nदुष्षन्तः पुनरेवाह यद्यदिच्छसि तद् वद \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111411, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111412, "chapter_id": 3410, "verse_number": "२४", "content_sanskrit": "ख्यातो लोकप्रवादोऽयं विवाह इति शास्त्रतः ।\nवैवाहिकीं क्रियां सन्तः प्रशंसन्ति प्रजाहिताम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111413, "chapter_id": 3410, "verse_number": "२५", "content_sanskrit": "लोकापवादशान्त्यर्थं विवाहं विधिना कुरु ।\nसन्त्यत्र यज्ञपात्राणि दर्भाः सुमनसोऽक्षताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111414, "chapter_id": 3410, "verse_number": "२६", "content_sanskrit": "यथा युक्तो विवाहः स्यात् तथा युक्ता प्रजा भवेत् ।\nतस्मादाज्यं हविर्लाजाः सिकता ब्राह्मणास्तथा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111415, "chapter_id": 3410, "verse_number": "२७", "content_sanskrit": "वैवाहिकानि चान्यानि सर्वमस्तीह पार्थिव ।\nदुरुक्तमपि राजेन्द्र क्षन्तव्यं धर्मकारणात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111416, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111417, "chapter_id": 3410, "verse_number": "२८", "content_sanskrit": "एवमस्त्विति तां राजा प्रत्युवाचाविचारयन् ।\nपुरोहितं समाहूय वचनं युक्तमब्रवीत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111418, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "दुष्षन्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111419, "chapter_id": 3410, "verse_number": "२९", "content_sanskrit": "राजपुत्र्या यदुक्तं वै न वृथा कर्तुमुत्सहे ।\nक्रियाहीनो हि न भवेन्मम पुत्रो महाद्युतिः ।\nतथा कुरुष्व शास्त्रोक्तं विवाहं मा चिरं कृथाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111420, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111421, "chapter_id": 3410, "verse_number": "३०", "content_sanskrit": "एवमुक्तो नृपतिना द्विजः परमयन्त्रितः ।\nशोभनं राजराजेति विधिना कृतवान् द्विजः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111422, "chapter_id": 3410, "verse_number": "३१", "content_sanskrit": "शासनाद् विप्रमुख्यस्य कृतकौतुकमङ्गलः ।\nजग्राह विधिवत् पाणिमुवास च तया सह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111423, "chapter_id": 3410, "verse_number": "३२", "content_sanskrit": "विश्वास्य चैनां प्रातिष्ठदब्रवीच्च पुनः पुनः ।\nप्रेषयिष्ये तवार्थाय वाहिनीं चतुरङ्गिणीम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111424, "chapter_id": 3410, "verse_number": "३३", "content_sanskrit": "त्रैविद्यवृद्धैः सहिता नागरा मामकैः सह ।\nशिबिकासहस्रैः सहिता वनमायान्ति बान्धवाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111425, "chapter_id": 3410, "verse_number": "३४", "content_sanskrit": "मूकाश्चैव किराताश्च कुब्जा वामनकैः सह ।\nसहिता कञ्चुकिवरैर्वाहिनी सूतमागधैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111426, "chapter_id": 3410, "verse_number": "३५", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्वनं च समुपेष्यति ।\nतथा त्वामानयिष्यामि नगरं तं शुचिस्मिते \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111427, "chapter_id": 3410, "verse_number": "३६", "content_sanskrit": "अन्यथा त्वां न नेष्यामि स्वनिवेशमसत्कृताम् ।\nसर्वमङ्गलसत्कारैः सुभ्रु सत्यं करोमि ते \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111428, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111429, "chapter_id": 3410, "verse_number": "३७", "content_sanskrit": "एवमुक्त्वा स राजर्षिः तामनिन्दितगामिनीम् ।\nसम्परिष्वज्य बाहुभ्यां स्मितपृर्वमुदैक्षत \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111430, "chapter_id": 3410, "verse_number": "३८", "content_sanskrit": "प्रदक्षिणीकृतां देवीं पुनस्तां परिषस्वजे ।\nशकुन्तला ह्यश्रुमुखी पपात नृपपादयोः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111431, "chapter_id": 3410, "verse_number": "३९", "content_sanskrit": "तां देवीं पुनरुत्थाप्य मा शुचेति पुनः पुनः ।\nशपेयं सुकृतेनैव प्रापयिष्ये नृपात्मजे \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111432, "chapter_id": 3410, "verse_number": "समाप्तिः", "content_sanskrit": "इति तस्याः प्रतिश्रुत्य स नृपो जनमेजय ।\nमनसा चिन्तयन् प्रायात् काश्यपं प्रति पार्थिवः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2111433, "chapter_id": 3410, "verse_number": "४१", "content_sanskrit": "भगवांस्तपसा युक्तः श्रुत्वा किं नु करिष्यति ।\nतं न प्रसाद्यागतोऽहं प्रसीदेति द्विजोत्तमम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2111434, "chapter_id": 3410, "verse_number": "४२", "content_sanskrit": "एवं सञ्चिन्तयन्नेव प्रविवेश स्वकं पुरम् ।\nततो मुहूर्ते याते तु कण्वोऽप्याश्रममागतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2111435, "chapter_id": 3410, "verse_number": "४३", "content_sanskrit": "शकुन्तला च पितरं ह्रिया नोपजगाम तम् ।\nशङ्कितैव च विप्रर्षिमुपचक्राम सा शनैः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2111436, "chapter_id": 3410, "verse_number": "४४", "content_sanskrit": "सा तस्य भारं जग्राह आसनं चाप्यकल्पयत् ।\nप्राक्षालयच्च सा पादौ कण्वस्य सुमहात्मनः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2111437, "chapter_id": 3410, "verse_number": "४५", "content_sanskrit": "न चैनं लज्जयाऽशक्रोद् अक्षिभ्यामभिवीक्षितुम् ।\nशकुन्तला च सव्रीडा तमृषिं नाभ्यभाषत \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2111438, "chapter_id": 3410, "verse_number": "४६", "content_sanskrit": "तस्मात् स्वधर्मात् स्खलिता भीता सा भरतर्षभ ।\nअभवद् दोषदर्शित्वाद् ब्रह्मचारिण्यधः स्थिता\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2111439, "chapter_id": 3410, "verse_number": "४७", "content_sanskrit": "स तदा व्रीळितां दृष्ट्वा ऋषिस्तां प्रत्यभाषत ।\nसव्रीळेव च दीर्घायुः पुरेव भविता न च ।\nवृत्तं कथय रम्भोरु मा त्रासं च प्रकल्पय \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2111440, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2111441, "chapter_id": 3410, "verse_number": "४८", "content_sanskrit": "ततः प्रक्षाल्य पादौ सा विश्रान्तं पुनरब्रवीत् ।\nविधाय कामं तस्यर्षेः कन्दानि च फलानि च \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2111442, "chapter_id": 3410, "verse_number": "४९", "content_sanskrit": "ततः संवाह्य पादौ सा विश्रान्तं वेदिमध्यमा ।\nशकुन्तला पौरवाणां दुष्षन्तं शुश्रुषी पतिम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2111443, "chapter_id": 3410, "verse_number": "५०", "content_sanskrit": "पौरवाणां नृपवरं दुष्षन्तं मनसाऽगमत् ।\nततः कृच्छ्रादतिशुभा सव्रीडा श्रीमती तदा ।\nसगद्गदमुवाचेदं काश्यपं सा शुचिस्मिता \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2111444, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2111445, "chapter_id": 3410, "verse_number": "५१", "content_sanskrit": "राजा ताताजगामेह दुष्षन्त इलिलात्मजः ।\nमया पतिर्वृतो योऽसौ दैवयोगादिहागतः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2111446, "chapter_id": 3410, "verse_number": "५२", "content_sanskrit": "तस्य तात प्रसीदस्व भर्ता मे सुमहायशाः ।\nअतः सर्वं तु यद् वृत्तं दिव्यज्ञानेन पश्यसि ।\nअभयं क्षत्रियकुले प्रसादं कर्तुमर्हसि \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2111447, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2111448, "chapter_id": 3410, "verse_number": "५३", "content_sanskrit": "चक्षुषा स तु दिव्येन सर्वं विज्ञाय काश्यपः ।\nततो धर्मिष्ठतां मत्वा धर्मे चास्खलितं मनः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2111449, "chapter_id": 3410, "verse_number": "५४", "content_sanskrit": "उवाच भगवान् प्रीतः तद् वृत्तं स महातपाः ।\nत्वयाऽद्य राजान्वयया मामनादृत्य यत् कृतम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2111450, "chapter_id": 3410, "verse_number": "५५", "content_sanskrit": "पुंसा सह समायोगो न स धर्मापघातकः ।\nन भयं विद्यते भद्रे मा शुचः सुकृतं कृतम् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2111451, "chapter_id": 3410, "verse_number": "५६", "content_sanskrit": "क्षत्रियस्य तु गान्धर्वो विवाहः श्रेष्ठ उच्यते ।\nसकामायाः सकामेन निर्मन्त्रो रहसि स्मृतः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2111452, "chapter_id": 3410, "verse_number": "५७", "content_sanskrit": "किं पुनर्विधिवत् कृत्वा सुप्रजास्त्वमवाप्स्यसि ।\nधर्मात्मा च महात्मा च दुष्षन्तः पुरुषोत्तमः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2111453, "chapter_id": 3410, "verse_number": "५८", "content_sanskrit": "अभ्यागच्छत् पतिर्यस्त्वां भजमानां शकुन्तले ।\nमहात्मा जनिता लोके पुत्रस्तव महायशाः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2111454, "chapter_id": 3410, "verse_number": "६०", "content_sanskrit": "स च सर्वां समुद्रान्तां कृत्स्नां भोक्ष्यति मेदिनीम् ।\nपरं चाभिप्रयातस्य चक्रं तस्य महात्मनः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2111455, "chapter_id": 3410, "verse_number": "६१", "content_sanskrit": "भविष्यत्यप्रतिहतं विततं चक्रवर्तिनः ।\nप्रसन्न एव तस्याहं त्वत्कृते वरवर्णिनि \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2111456, "chapter_id": 3410, "verse_number": "६२", "content_sanskrit": "ऋतवो बहवस्ते वै गता व्यर्थाः शुचिस्मिते ।\nसार्थकं साम्प्रतं ह्येतन्न च पापोऽस्ति तेऽनधे ।\nगृहाण च वरं मत्तस्त्वत्कृते यदभीप्सितम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2111457, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2111458, "chapter_id": 3410, "verse_number": "६३", "content_sanskrit": "मया पतिर्वृतो योऽसौ दुष्षन्तः पुरुषोत्तमः ।\nमम चैव पतिर्दृष्टो विधात्राऽपि न संशयः ।\nतस्मै ससचिवाय त्वं प्रसादं कर्तुमर्हसि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2111459, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2111460, "chapter_id": 3410, "verse_number": "६४", "content_sanskrit": "इत्येवमुक्त्वा मनसा प्रणिधाय मनस्विनी ।\nतस्य धर्मिष्ठतां वव्रे राज्ये चास्खलनं तथा \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2111461, "chapter_id": 3410, "verse_number": "६५", "content_sanskrit": "शकुन्तलां पौरवाणां दुष्षन्तस्य हितैषिणीम् ।\nएवमस्त्विति तां प्राह कण्वो धर्मभृतां वरः ।\nपस्पर्श चैव पाणिभ्यां सुतां श्रीरिव रूपिणीम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2111462, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2111463, "chapter_id": 3410, "verse_number": "६६", "content_sanskrit": "अद्यप्रभृति देवी त्वं दुष्षन्तस्य महात्मनः ।\nपतिव्रतानां या वृत्तिस्तां वृत्तिमनुपालय \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2111464, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2111465, "chapter_id": 3410, "verse_number": "६७", "content_sanskrit": "इत्येवमुक्त्वा धर्मात्मा तां विशुद्व्यर्थमस्पृशत् ।\nस्पृष्टमात्रे शरीरे तु परं हर्षमवाप सा\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2111466, "chapter_id": 3410, "verse_number": "३७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोननवतितमोऽध्यायः ॥८९॥ ॥ इति सम्भवपर्वणि सप्तत्रिंशोऽध्यायः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2111467, "chapter_id": 3410, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]