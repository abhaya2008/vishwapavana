[{"id": 2079054, "chapter_id": 2681, "verse_number": "१२-१८६-०x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079055, "chapter_id": 2681, "verse_number": "१२-१८६-१", "content_sanskrit": "असृजद्ब्राह्मणानेव पूर्वं ब्रह्मा प्रजापतीन्।\nआत्मतेजोभिनिर्वृत्तान्भास्कराग्निसमप्रभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079056, "chapter_id": 2681, "verse_number": "१२-१८६-२", "content_sanskrit": "ततः सत्यं च धर्मं च तपो ब्रह्म च शाश्वतम्।\nआचारं चैव शौचं च सर्गादौ विदधे प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079057, "chapter_id": 2681, "verse_number": "१२-१८६-३", "content_sanskrit": "देवदानवगन्वर्गा दैत्यासुरमहोरगाः।\nयक्षराक्षसनागाश्च पिशाचा मनुजास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079058, "chapter_id": 2681, "verse_number": "१२-१८६-४", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्च द्विजसत्तम।\nये चान्ये भूतसङ्घानां संघातास्तांश्च निर्ममे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079059, "chapter_id": 2681, "verse_number": "१२-१८६-५", "content_sanskrit": "ब्राह्मणानां सितो वर्णः क्षत्रियाणां तु लोहितः।\nवैश्यानां पीतको वर्णः शूद्राणामसितस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079060, "chapter_id": 2681, "verse_number": "१२-१८६-६x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079061, "chapter_id": 2681, "verse_number": "१२-१८६-६", "content_sanskrit": "चातुर्वर्ण्यस्य वर्णेन यदि वर्णो विभज्यते।\nसर्वेषां खलु वर्णानां दृश्यते वर्णसंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079062, "chapter_id": 2681, "verse_number": "१२-१८६-७", "content_sanskrit": "कामः क्रोधो भयं लोभः शोकश्चिन्ता क्षुधा श्रमः।\nसर्वेषां नः प्रभवति कस्माद्वर्णो विभज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079063, "chapter_id": 2681, "verse_number": "१२-१८६-८", "content_sanskrit": "स्वेदमूत्रपुरीषाणि श्लेष्मा पित्तं सशोणितम्।\nतनुः क्षरति सर्वेषां कस्माद्वर्णो विभज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079064, "chapter_id": 2681, "verse_number": "१२-१८६-९", "content_sanskrit": "जङ्गमानामसङ्ख्येयाः स्थावराणां च जातयः।\nतेषां विविधवर्णानां कुतो वर्णविनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079065, "chapter_id": 2681, "verse_number": "१२-१८६-१०x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079066, "chapter_id": 2681, "verse_number": "१२-१८६-१०", "content_sanskrit": "न विशेषोऽस्ति वर्णानां सर्वं ब्राह्ममिदं जगत्।\nब्राह्मणाः पूर्वसृष्टा हि कर्मभिर्वर्णतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079067, "chapter_id": 2681, "verse_number": "१२-१८६-११", "content_sanskrit": "कामभोगप्रियास्तीक्ष्णाः क्रोधनाः प्रियसाहसाः।\nत्यक्तस्वधर्मा रक्ताङ्गास्ते द्विजाः क्षत्रतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079068, "chapter_id": 2681, "verse_number": "१२-१८६-१२", "content_sanskrit": "गोषु वृत्तिं समाधाय पीताः कृष्युपजीविनः।\nस्वधर्मान्नानुतिष्ठन्ति ते द्विजा वैश्यतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079069, "chapter_id": 2681, "verse_number": "१२-१८६-१३", "content_sanskrit": "हिंसानृतप्रिया लुब्धाः सर्वकर्मोपजीविनः।\nकृष्णाः शौचपरिभ्रष्टास्ते द्विजाः शूद्रता गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079070, "chapter_id": 2681, "verse_number": "१२-१८६-१४", "content_sanskrit": "इत्येतैः कर्मभिर्व्यस्ता द्विजा वर्णान्तरं गताः।\nधर्मो यज्ञक्रिया चैषां नित्यं न प्रतिषिध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079071, "chapter_id": 2681, "verse_number": "१२-१८६-१५", "content_sanskrit": "इत्येते चतुरो वर्णा येषां ब्राह्मी सरस्वती।\nविहिता ब्रह्मणा पूर्वं लोभात्त्वज्ञानतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079072, "chapter_id": 2681, "verse_number": "१२-१८६-१६", "content_sanskrit": "ब्राह्मणा ब्रह्मतन्त्रस्थास्तपस्तेषां न नश्यति।\nब्रह्म धारयतां नित्यं व्रतानि नियमांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079073, "chapter_id": 2681, "verse_number": "१२-१८६-१७", "content_sanskrit": "ब्रह्म वैव परं सृष्टं ये तु जानन्ति ते द्विजाः।\nतेषां बहुविधास्त्वन्ये तत्रतत्र द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079074, "chapter_id": 2681, "verse_number": "१२-१८६-१८", "content_sanskrit": "पिशाचा राक्षसाः प्रेता विविधा म्लेच्छजातयः।\nप्रनष्टज्ञानविज्ञानाः स्वच्छन्दाचारचेष्टिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079075, "chapter_id": 2681, "verse_number": "१२-१८६-१९", "content_sanskrit": "प्रजा ब्राह्मणसंस्काराः स्वकर्मकृतनिश्चयाः।\nऋषिभिः स्वेन तपसा सृज्यन्ते चापरे परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079076, "chapter_id": 2681, "verse_number": "१२-१८६-२०", "content_sanskrit": "आदिदेवसमुद्भूता ब्रह्ममूलाक्षयाव्यया।\nसा सृष्टिर्मानसी नाम धर्मतन्त्रपरायणा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079077, "chapter_id": 2681, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षडशीत्यधिकशततमोऽध्यायः॥ १८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]