[{"id": 900004808, "chapter_id": 8366, "verse_number": "2.1", "content_sanskrit": "य इज्यते विधीशानशक्रपूर्वैस्सदा मखैः । रमाप्रणयिने तस्मै सर्वयज्ञभुजे नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004809, "chapter_id": 8366, "verse_number": "2.2", "content_sanskrit": "महानाम्नीनामृचामुपसर्गा ये उपसर्जनभूतास्तनुपसृजति संयोजयति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004810, "chapter_id": 8366, "verse_number": "2.3", "content_sanskrit": "तत्रैक आहुरगुणं ब्रह्मेति । न तद्युक्तं श्रुतियुक्तिविरोधात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004811, "chapter_id": 8366, "verse_number": "2.4", "content_sanskrit": "तथाहि श्रुतिः । सत्यं ज्ञानमनन्तं ब्रह्म । विज्ञानमानन्दं ब्रह्म", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004812, "chapter_id": 8366, "verse_number": "2.5", "content_sanskrit": "युक्तिश्च । बुद्धिपूर्वं सर्वकर्तृत्वात् सर्वज्ञत्वादयो गुणा युक्ताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004813, "chapter_id": 8366, "verse_number": "2.6", "content_sanskrit": "न च 'एको देवः सर्वभूतेषु गूढः सर्वव्यापी सर्वभूतान्तरात्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004814, "chapter_id": 8366, "verse_number": "2.7", "content_sanskrit": "न च निर्विशेषं नाम किञ्चिदस्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004815, "chapter_id": 8366, "verse_number": "2.8", "content_sanskrit": "न च मिथ्याविशेषवत् । व्याहतेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004816, "chapter_id": 8366, "verse_number": "2.9", "content_sanskrit": "न चानिर्वचनीयविशेष इति भवति । अनिर्वचनीयासिद्धेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004817, "chapter_id": 8366, "verse_number": "2.10", "content_sanskrit": "किञ्चैतद्वैलक्षण्यं भेदोऽभेदो भेदाभेदो वा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004818, "chapter_id": 8366, "verse_number": "2.11", "content_sanskrit": "न च व्यावर्त्यविशेषेणापर्यायत्वं क्वचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004819, "chapter_id": 8366, "verse_number": "2.12", "content_sanskrit": "किञ्चासद्विलक्षणमित्यत्राभावान्यविरोधानां मध्ये नत्रः कोऽर्थः ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004820, "chapter_id": 8366, "verse_number": "2.13", "content_sanskrit": "न च सिद्धेऽर्थे वाक्यस्य प्रामाण्याभावादीश्वराद्यसिद्धिः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004821, "chapter_id": 8366, "verse_number": "2.14", "content_sanskrit": "न च तत्कल्पकं किञ्चित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004822, "chapter_id": 8366, "verse_number": "2.15", "content_sanskrit": "ताश्च विदा मघवन्नित्याद्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]