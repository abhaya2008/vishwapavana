[{"id": 7002667000, "chapter_id": 22667, "verse_number": "७-१०-१", "content_sanskrit": "सूत उवाच ।\nनवमाब्दं वयः प्राप्ते कृष्णांशो बलवत्तरः ।\nपठित्वान्वीक्षिकीं विद्यां चतुःषष्टिकलास्तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002667001, "chapter_id": 22667, "verse_number": "७-१०-२", "content_sanskrit": "धर्मशास्त्रं तथैवापि सर्वश्रेष्ठं बभूव ह ।\nतस्मिन्काले भृगुश्रेष्ठ महीराजो नृपोत्तमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002667002, "chapter_id": 22667, "verse_number": "७-१०-३", "content_sanskrit": "करार्थं प्रेषयामास स्वसैन्यं च महावतीम् ।\nते वै लक्षं महाशूराः सर्वशस्त्रास्त्रधारिणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002667003, "chapter_id": 22667, "verse_number": "७-१०-४", "content_sanskrit": "ऊचुः परिमलं भूपं शृणु चंद्रकुलोद्भव ।\nसर्वे च भारते वर्षे ये राजानो महाबलाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002667004, "chapter_id": 22667, "verse_number": "७-१०-५", "content_sanskrit": "षडंशं करमादायास्मद्राजाय ददंति वै ।\nभवान्करे हि तस्यैव योग्यो भवति सांप्रतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002667005, "chapter_id": 22667, "verse_number": "७-१०-६", "content_sanskrit": "अद्यप्रभृति चेद्राज्ञे तस्मै दद्यात्करं न हि ।\nमहीराजस्य रौद्रास्त्रैः क्षयं यास्यति सैनिकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002667006, "chapter_id": 22667, "verse_number": "७-१०-७", "content_sanskrit": "ये भूपा जयचंद्रस्य पक्षगास्ते हि तद्भयात् ।\nददंते भूमिराजाय दंडं तन्मानसत्कृताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002667007, "chapter_id": 22667, "verse_number": "७-१०-८", "content_sanskrit": "इति श्रुत्वा स नृपतिस्तस्मै राज्ञे महात्मने ।\nकरं षडंशमादाय ददौ प्रीतिसमन्वितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002667008, "chapter_id": 22667, "verse_number": "७-१०-९", "content_sanskrit": "दशलक्षमितं द्रव्यं गृहीत्वा ते समाययुः ।\nमहीराजः प्रसन्नात्मा पूर्ववैरमपाहरत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002667009, "chapter_id": 22667, "verse_number": "७-१०-१०", "content_sanskrit": "तदा ते लक्षशूराश्च कान्यकुब्जमुपाययुः ।\nजयचंद्रं तु नत्वोचुः शृणु लक्षणकोविद ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002667010, "chapter_id": 22667, "verse_number": "७-१०-११", "content_sanskrit": "पृथ्वीराजो महाराजो दंडं त्वत्तः समिच्छति ।\nइत्युक्तस्तैर्वैष्णवास्त्री लक्षणस्तानुवाच ह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002667011, "chapter_id": 22667, "verse_number": "७-१०-१२", "content_sanskrit": "मद्देशे मंडलीकाश्च बहवः संति सांप्रतम् ।\nभूमिराजो मांडलिको मयि जीवति मा भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002667012, "chapter_id": 22667, "verse_number": "७-१०-१३", "content_sanskrit": "इत्युक्त्वा वैष्णवास्त्रं तान्क्रुद्धः स च समादधत् ।\nतदस्त्रज्वालतः सर्वे भयभीता प्रदुद्रुवुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002667013, "chapter_id": 22667, "verse_number": "७-१०-१४", "content_sanskrit": "महीराजस्तु तच्छ्रुत्वा महद्भयमुपागमत् ।\nदशाब्दं च वयः प्राप्ते कृष्णांशे मल्लकोविदे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002667014, "chapter_id": 22667, "verse_number": "७-१०-१५", "content_sanskrit": "नानामल्लाः समाजग्मुस्तेन राज्ञैव सत्कृताः ।\nतेषां मध्ये स कृष्णांशो बाहुशाली बभूव ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002667015, "chapter_id": 22667, "verse_number": "७-१०-१६", "content_sanskrit": "उर्वीयाधिपतेः पुत्रः षोडशाब्दवया बली ।\nशतमल्लैश्च सहितः कदाचित्स समागतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002667016, "chapter_id": 22667, "verse_number": "७-१०-१७", "content_sanskrit": "पितृष्वसृपतिं भूपं नत्वा नाम्नाऽभयो बली ।\nउवाच शृणु भूपाल कृष्णोऽयं मदमत्तरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002667017, "chapter_id": 22667, "verse_number": "७-१०-१८", "content_sanskrit": "तेन सार्द्धं भवेन्मल्लयुद्धं मम नृपोत्तम ।\nइति वज्रसमं वाक्यं श्रुत्वा राजा भयातुरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002667018, "chapter_id": 22667, "verse_number": "७-१०-१९", "content_sanskrit": "उवाच श्यालजं प्रेम्णा भवान्युद्धविशारदः ।\nअष्टाब्दोऽयं सुतः स्निग्धो मम प्राणसमो भुवि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002667019, "chapter_id": 22667, "verse_number": "७-१०-२०", "content_sanskrit": "क्व भवान्वज्रसदृशः क्व सुतोऽयं सुकोमलः ।\nअन्यैर्मल्लैर्मदीयैश्च सार्द्धं योग्यो भवान्रणे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002667020, "chapter_id": 22667, "verse_number": "७-१०-२१", "content_sanskrit": "इति श्रुत्वा नृपः स्यालो महीपतिरिति स्मृतः ।\nस तमाह रुषाविष्टो बालोऽयं बलवत्तरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002667021, "chapter_id": 22667, "verse_number": "७-१०-२२", "content_sanskrit": "शृणु तत्कारणं भूप यथा ज्ञातो मया शिशुः ।\nआगस्कृतं महीराजं मत्वा सतिलकः सुतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002667022, "chapter_id": 22667, "verse_number": "७-१०-२३", "content_sanskrit": "पंडितांश्च समाहूय मुहूर्तं पृष्टवान्मुदा ।\nगणेशो नाम मतिमाञ्ज्योतिश्शास्त्रविशारदः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002667023, "chapter_id": 22667, "verse_number": "७-१०-२४", "content_sanskrit": "लक्षणं वचनं प्राह महीराजमनुत्तमम् ।\nशिवदत्तवरो राजन्कुबेर इव सांप्रतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002667024, "chapter_id": 22667, "verse_number": "७-१०-२५", "content_sanskrit": "कृष्णांशस्तस्य योग्योऽयं देशराजसुतोऽवरः ।\nनान्योऽस्ति भूतले राजन्सत्यं सत्यं ब्रवीम्यहम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002667025, "chapter_id": 22667, "verse_number": "७-१०-२६", "content_sanskrit": "तच्छ्रुत्वा लक्षणो वीरः पूर्वे बर्हिष्मतीं प्रति ।\nकल्पक्षेत्रं दक्षिणे च भूमिग्रामं तु पश्चिमे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002667026, "chapter_id": 22667, "verse_number": "७-१०-२७", "content_sanskrit": "उत्तरे नैमिषारण्यं स्वकीयं राष्ट्रमादधत् ।\nअतः श्रेष्ठः कुमारोऽयं कान्यकुब्जे मया श्रुतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002667027, "chapter_id": 22667, "verse_number": "७-१०-२८", "content_sanskrit": "नागोत्सवे च भूपाल पंचम्यां च नभस्सिते ।\nदृश्यमात्रं कुमारांगं तस्माद्योग्यो ह्ययं सुतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002667028, "chapter_id": 22667, "verse_number": "७-१०-२९", "content_sanskrit": "इति श्रुत्वा स कृष्णांशो वाक्छरेण प्रपीडितः ।\nअभयं भुजयोः शीघ्रं गृहीत्वा सोऽयुधद्बली ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002667029, "chapter_id": 22667, "verse_number": "७-१०-३०", "content_sanskrit": "क्षणमात्रं रणं कृत्वा भूमिमध्ये तमक्षिपत् ।\nअभयस्य भुजो भग्नस्तत्र जातो बलेन वै ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002667030, "chapter_id": 22667, "verse_number": "७-१०-३१", "content_sanskrit": "मूर्च्छितं स्वसुतं ज्ञात्वा खड्गहस्तो महीपतिः ।\nप्रेषयामास तान्मल्लान्कृष्णांशस्य प्रहारणे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002667031, "chapter_id": 22667, "verse_number": "७-१०-३२", "content_sanskrit": "रुषाविष्टांश्च ताञ्ज्ञात्वा कृष्णांशो बलवत्तरः ।\nतानेकैकं समाक्षिप्य विजयी स बभूव ह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002667032, "chapter_id": 22667, "verse_number": "७-१०-३३", "content_sanskrit": "पराजिते मल्लबले खड्गहस्तो महीपतिः ।\nमरणाय मतिं चक्रे कृष्णांशस्य प्रभावतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002667033, "chapter_id": 22667, "verse_number": "७-१०-३४", "content_sanskrit": "ज्ञात्वा तमीदृशं भूपं वारयामास भूपतिः ।\nअभयं नीरुजं कृत्वा प्रेम्णा गेहमवासयत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002667034, "chapter_id": 22667, "verse_number": "७-१०-३५", "content_sanskrit": "नवाब्दांगे च कृष्णांशे चाह्लादाद्याः कुमारकाः ।\nमृगयार्थे दधुश्चित्तं तमूचुर्भूपतिं प्रियम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002667035, "chapter_id": 22667, "verse_number": "७-१०-३६", "content_sanskrit": "नमस्ते तात भूपाग्र्य सर्वानंदप्रदायक ।\nअस्मभ्यं त्वं हयान्देहि मत्प्रियान्करुणाकर ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002667036, "chapter_id": 22667, "verse_number": "७-१०-३७", "content_sanskrit": "इति श्रुत्वा वचस्तेषां तथेत्युक्त्वा महीपतिः ।\nभूतले वासिनोऽश्वान्वै दिव्यान्राट् चतुरो वरान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002667037, "chapter_id": 22667, "verse_number": "७-१०-३८", "content_sanskrit": "ददौ तेभ्यो मुदा युक्तो हरिणीगर्भसंभवान् ।\nऋषय ऊचुः ।\nत्वन्मुखेन श्रुतं सूत हरिणी वडवा यथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002667038, "chapter_id": 22667, "verse_number": "७-१०-३९", "content_sanskrit": "भीष्मसिंहाय संप्राप्ता शक्राद्देवेशतो मुने ।\nइदानीं श्रोतुमिच्छामः कुतो जातास्तुरंगमाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002667039, "chapter_id": 22667, "verse_number": "७-१०-४०", "content_sanskrit": "दिव्यांगा भूषणापन्ना नभस्सलिलगामिनः ।\nसूत उवाच ।\nदेशराजेन भूपेन पुरा धर्मयुतेन वै ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002667040, "chapter_id": 22667, "verse_number": "७-१०-४१", "content_sanskrit": "सेवनं भास्करस्यैव कृतं च द्वादशाब्दिकम् ।\nसेवान्ते भगवान्सूर्यो वरं ब्रूहि तमब्रवीत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002667041, "chapter_id": 22667, "verse_number": "७-१०-४२", "content_sanskrit": "प्राह देव नमस्तुभ्यं यदि देयो वरस्त्वया ।\nहयं दिव्यमयं देहि नभस्थलजलातिगम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002667042, "chapter_id": 22667, "verse_number": "७-१०-४३", "content_sanskrit": "तथेत्युक्त्वा रविः साक्षाद्ददौ तस्मै पपिहकम् ।\nलोकान्पाति पपीर्ज्ञेयस्तस्येदं नाम चोत्तमम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002667043, "chapter_id": 22667, "verse_number": "७-१०-४४", "content_sanskrit": "अतः पपीहको नाम लोकपालनकर्मवान् ।\nस हयो मदमत्तश्च हरिणीं दिव्यरूपिणीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002667044, "chapter_id": 22667, "verse_number": "७-१०-४५", "content_sanskrit": "बुभुजे स्मरवेगेन तस्यां जातास्तुरंगमाः ।\nमनोरथश्च पीतांगः करालः कृष्णरूपकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002667045, "chapter_id": 22667, "verse_number": "७-१०-४६", "content_sanskrit": "एकगर्भे समुद्भूतौ शैब्यसुग्रीवकांशकौ ।\nयस्मिन्दिने समुद्भूतौ जिष्णुविष्णुकलांशतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002667046, "chapter_id": 22667, "verse_number": "७-१०-४७", "content_sanskrit": "तदा जातौ हरिण्याश्च मेघपुष्पबलाहकौ ।\nबिन्दुलश्च सुवर्णांगः श्वेतांगो हरिनागरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002667047, "chapter_id": 22667, "verse_number": "७-१०-४८", "content_sanskrit": "दिव्यांगास्ते हि चत्वारः पूर्वं जाता महाबलाः ।\nपश्चादंशावताराश्च जातास्तेषां महात्मनाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002667048, "chapter_id": 22667, "verse_number": "७-१०-४९", "content_sanskrit": "इति ते कथितं विप्र शृणु तत्र कथां शुभाम् ।\nभूतले ते हयाः सर्वे प्राप्ताश्चोपरिभूमिगाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002667049, "chapter_id": 22667, "verse_number": "७-१०-५०", "content_sanskrit": "देवसिंहाय बलिने ददौ चाश्वं मनोरथम् ।\nआह्लादाय करालं च कृष्णांशायैव बिन्दुलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002667050, "chapter_id": 22667, "verse_number": "७-१०-५१", "content_sanskrit": "ब्रह्मानंदाय पुत्राय प्रददौ हरिनागरम् ।\nते चत्वारो हयारूढा मृगयार्थं वनं ययुः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002667051, "chapter_id": 22667, "verse_number": "७-१०-५२", "content_sanskrit": "हरिणीं वडवां शुभ्रां बलखानिः समारुहत् ।\nतदनु प्रययौ वीरो वनं सिंहनिषेवितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002667052, "chapter_id": 22667, "verse_number": "७-१०-५३", "content_sanskrit": "आह्लादेनैव शार्दूलो हतः प्राणिभयंकरः ।\nदेवसिंहेन सिंहश्च सूकरो बलखानिना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002667053, "chapter_id": 22667, "verse_number": "७-१०-५४", "content_sanskrit": "ब्रह्मानंदेन हरिणो हतस्तत्र महावने ।\nमृगाः शतं हतास्तैश्च तान्गृहीत्वा गृहं ययुः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002667054, "chapter_id": 22667, "verse_number": "७-१०-५५", "content_sanskrit": "एतस्मिन्नंतरे देवी शारदा च शुभानना ।\nमृगी स्वर्णमयी भूत्वा तेषामग्रे प्रधाविता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002667055, "chapter_id": 22667, "verse_number": "७-१०-५६", "content_sanskrit": "दृष्ट्वा तां मोहिताः सर्वे स्वैः स्वैर्बाणैरताडयन् ।\nशरास्तु संक्षयं जग्मुर्मृग्यंगे बलवत्तराः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002667056, "chapter_id": 22667, "verse_number": "७-१०-५७", "content_sanskrit": "आह्लादाद्याश्च ते शूरा विस्मिताश्च बभूविरे ।\nतस्मिन्काले स कृ्ष्णांगो बाणेनैव ह्यताडयत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002667057, "chapter_id": 22667, "verse_number": "७-१०-५८", "content_sanskrit": "तदा च पीडिता देवी भयभीता ययौ वनम् ।\nकृष्णांशः क्रोधताम्राक्षस्तत्पश्चात्प्रययौ बली ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002667058, "chapter_id": 22667, "verse_number": "७-१०-५९", "content_sanskrit": "वनांतरं च संप्राप्य देवी धृत्वा स्वकं वपुः ।\nतमुवाच प्रसन्नाक्षी परीक्षा ते मया कृता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002667059, "chapter_id": 22667, "verse_number": "७-१०-६०", "content_sanskrit": "यदा ते च भयं भूयात्तदा त्वं मां सदा स्मर ।\nसाधयिष्यामि ते कार्यं कृष्णांशो हि भवान्विभुः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002667060, "chapter_id": 22667, "verse_number": "७-१०-६१", "content_sanskrit": "इत्युक्त्वान्तर्हिता देवी शारदा सर्वमंगला ।\nकृष्णांशस्तु ययौ गेहं तैश्च सार्द्धं मुदा युतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002667061, "chapter_id": 22667, "verse_number": "७-१०-६२", "content_sanskrit": "तदा पराक्रमं तेषां दृष्ट्वा राजा सुखोऽभवत् ।\nगृहे गृहे च सर्वेषां लक्ष्मीर्देवी समाविशत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]