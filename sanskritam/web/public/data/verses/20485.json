[{"id": 7000485000, "chapter_id": 20485, "verse_number": "३-३२-१", "content_sanskrit": "नारदौवाच ।\nततो गच्छेत राजेंद्र सुगंधंलोकविश्रुतम् ।\nसर्वपापविशुद्धात्मा ब्रह्मलोके महीयते॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000485001, "chapter_id": 20485, "verse_number": "३-३२-२", "content_sanskrit": "रुद्रावर्तं ततो गच्छेत्तीर्थसेवी नराधिप ।\nतत्र स्नात्वा नरो राजन्स्वर्गलोके महीयते॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000485002, "chapter_id": 20485, "verse_number": "३-३२-३", "content_sanskrit": "गंगायाश्च नरश्रेष्ठ सरस्वत्याश्च संगमे ।\nस्नातोऽश्वमेधमाप्नोति स्वर्गलोकं च गच्छति॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000485003, "chapter_id": 20485, "verse_number": "३-३२-४", "content_sanskrit": "तत्र कर्णह्रदे स्नात्वा देवमभ्यर्च्य शंकरम् ।\nन दुर्गतिमवाप्नोति स्वर्गलोकं च गच्छति॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000485004, "chapter_id": 20485, "verse_number": "३-३२-५", "content_sanskrit": "ततः कुब्जाम्रकं गच्छेत्तीर्थसेवी यथाक्रमम् ।\nगोसहस्रमवाप्नोति स्वर्गलोकं च गच्छति॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000485005, "chapter_id": 20485, "verse_number": "३-३२-६", "content_sanskrit": "अरुंधतीवटं गच्छेत्तीर्थसेवी नराधिप ।\nसामुद्रकमुपस्पृश्य त्रिरात्रोपोषितो नरः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000485006, "chapter_id": 20485, "verse_number": "३-३२-७", "content_sanskrit": "गोसहस्रफलं विंद्यात्स्वर्गलोकं च गच्छति ।\nब्रह्मावर्त्तं ततो गच्छेद्ब्रह्मचारी समाहितः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000485007, "chapter_id": 20485, "verse_number": "३-३२-८", "content_sanskrit": "अश्वमेधमवाप्नोति स्वर्गलोकं च गच्छति ।\nयमुनाप्रभवं गच्छेत्समुपस्पृश्य यामुनम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000485008, "chapter_id": 20485, "verse_number": "३-३२-९", "content_sanskrit": "अश्वमेधफलं लब्ध्वा ब्रह्मलोके महीयते ।\nदर्वीसंक्रमणं प्राप्य तीर्थं त्रैलोक्यविश्रुतम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000485009, "chapter_id": 20485, "verse_number": "३-३२-१०", "content_sanskrit": "अश्वमेधमवाप्नोति स्वर्गलोकं च गच्छति ।\nसिंधोश्च प्रभवं गत्वा सिद्धगंधर्वसेवितम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000485010, "chapter_id": 20485, "verse_number": "३-३२-११", "content_sanskrit": "तत्रोष्य रजनीः पंच दद्याद्बहुसुवर्णकम् ।\nअथ देवीं समासाद्य नरः परमदुर्गमाम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000485011, "chapter_id": 20485, "verse_number": "३-३२-१२", "content_sanskrit": "अश्वमेधमवाप्नोति गच्छेच्चौशनसीं गतिम् ।\nऋषिकुल्यां समासाद्य वसिष्ठं चैव भारत॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000485012, "chapter_id": 20485, "verse_number": "३-३२-१३", "content_sanskrit": "वसिष्ठं समतिक्रम्य सर्वे वर्णा द्विजातयः ।\nऋषिकुल्यां नरः स्नात्वा ऋषिलोकं प्रपद्यते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000485013, "chapter_id": 20485, "verse_number": "३-३२-१४", "content_sanskrit": "यदि तत्र वसेन्मासं शाकाहारो नराधिप ।\nभृगुतुंगं समासाद्य वाजिमेधफलं लभेत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000485014, "chapter_id": 20485, "verse_number": "३-३२-१५", "content_sanskrit": "गत्वा वीरप्रमोक्षं च सर्वपापैः प्रमुच्यते ।\nकार्तिकमाघयोश्चैव तीर्थमासाद्य दुर्लभम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000485015, "chapter_id": 20485, "verse_number": "३-३२-१६", "content_sanskrit": "अग्निष्टोमातिरात्राभ्यां फलं प्राप्नोति पुण्यकृत् ।\nततः संध्यां समासाद्य विद्यातीर्थमनुत्तमम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000485016, "chapter_id": 20485, "verse_number": "३-३२-१७", "content_sanskrit": "उपस्पृशेत्स विद्यानां सर्वासां पारगो भवेत् ।\nमहाश्रमे वसेद्रात्रिं सर्वपापप्रमोचने॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000485017, "chapter_id": 20485, "verse_number": "३-३२-१८", "content_sanskrit": "एककालं निराहारो लोकान्संवसते शुभान् ।\nषष्ठकालोपवासेन मासमुष्य महालये॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000485018, "chapter_id": 20485, "verse_number": "३-३२-१९", "content_sanskrit": "तीर्णस्तारयते जंतून्दशपूर्वान्दशापरान् ।\nदृष्ट्वा माहेश्वरं पुण्यं परं सुरनमस्कृतम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000485019, "chapter_id": 20485, "verse_number": "३-३२-२०", "content_sanskrit": "कृतार्थः सर्वकृत्येषु न शोचेन्मरणं क्वचित् ।\nसर्वपापविशुद्धात्मा विंद्याद्बहुसुवर्णकम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000485020, "chapter_id": 20485, "verse_number": "३-३२-२१", "content_sanskrit": "अथ वेतसिकां गच्छेत्पितामहनिषेविताम् ।\nअश्वमेधमवाप्नोति गतिं च परमां व्रजेत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000485021, "chapter_id": 20485, "verse_number": "३-३२-२२", "content_sanskrit": "अथ सुंदरिकां तीर्थं प्राप्य सिद्धनिषेविताम् ।\nरूपस्य भागी भवति दृष्टमेतत्पुरातनैः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000485022, "chapter_id": 20485, "verse_number": "३-३२-२३", "content_sanskrit": "ततो ब्राह्मणिकां गत्वा ब्रह्मचारी समाहितः ।\nपद्मवर्णेन यानेन ब्रह्मलोकं प्रपद्यते॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000485023, "chapter_id": 20485, "verse_number": "३-३२-२४", "content_sanskrit": "ततश्च नैमिषं गच्छेत्पुण्यं द्विजनिषेवितम् ।\nतत्र नित्यं निवसति ब्रह्मा देवगणैः सह॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000485024, "chapter_id": 20485, "verse_number": "३-३२-२५", "content_sanskrit": "नैमिषं प्रार्थयानस्य पापस्यार्द्धं प्रणश्यति ।\nप्रविष्टमानस्तु नरः सर्वपापात्प्रमुच्यते॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]