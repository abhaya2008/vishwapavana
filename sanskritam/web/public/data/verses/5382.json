[{"id": 2205687, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205688, "chapter_id": 5382, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा महादेवः श्रोतुकामः स्वयं प्रभुः ।\nअनुकूलां प्रियां भार्यां पार्श्वस्थां समभाषत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205689, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205690, "chapter_id": 5382, "verse_number": "२", "content_sanskrit": "परावरज्ञे धर्माणां तपोवननिवासिनाम् ।\nदीक्षाविधिदमोपेते सततं व्रतचारिणि ।\nपृच्छामि त्वां वरारोहे पृष्टा वद ममेप्सितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205691, "chapter_id": 5382, "verse_number": "३", "content_sanskrit": "सावित्री ब्रह्मणः पत्नी कौशिकस्य शची शुभा ।\nलक्ष्मीर्विष्णोः प्रिया भार्या धृतिर्भार्या यमस्य तु\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205692, "chapter_id": 5382, "verse_number": "४", "content_sanskrit": "मार्कण्डेयस्य धूमोर्णा ऋद्धिर्वैश्रवणस्य तु ।\nवरुणस्य प्रिया गौरी सवितुश्च सुवर्चला\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205693, "chapter_id": 5382, "verse_number": "५", "content_sanskrit": "रोहिणी शशिनो भार्या स्वाहा वह्नेरनिन्दिता ।\nकाश्यपस्यादितिश्चैव वसिष्ठस्याप्यरुन्धती\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205694, "chapter_id": 5382, "verse_number": "६", "content_sanskrit": "एताश्चान्याश्च देव्यस्तु सर्वास्ताः पतिदेवताः ।\nश्रूयन्ते लोकविख्यातास्त्वया चैव सहोषिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205695, "chapter_id": 5382, "verse_number": "७", "content_sanskrit": "ताभिश्च पूजिता सा त्वमनुवृत्त्याऽनुभाषणैः ।\nतस्मात् त्वां परिपृच्छामि धर्मज्ञे लोकसम्मते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205696, "chapter_id": 5382, "verse_number": "८", "content_sanskrit": "स्त्रीधर्मं श्रोतुमिच्छामि त्वयैव समुदाहृतम् ।\nसधर्मचारिणी मे त्वं समानव्रतचारिणी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205697, "chapter_id": 5382, "verse_number": "९", "content_sanskrit": "समानसारा वीर्येण मयैव त्वं शुभानने ।\nममैवार्धाच्छरीरस्य निर्मितासि पुरा शुभे ।\nसुरकार्यं करोषि त्वं लोकसन्धारिणी तथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205698, "chapter_id": 5382, "verse_number": "१०", "content_sanskrit": "अयं हि स्त्रीगणस्त्वां तु अनुयाति न मुञ्चति ।\nत्वत्प्रसादाद्धितं श्रोतुं स्त्रीवृत्तं शुभलक्षणम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205699, "chapter_id": 5382, "verse_number": "११", "content_sanskrit": "त्वया चोक्तं विशेषेण गुरुभूतं हि तिष्ठति ।\nस्त्रिय एव सदा लोके स्त्रीगणस्य गतिः प्रिये\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205700, "chapter_id": 5382, "verse_number": "१२", "content_sanskrit": "शश्वद् गौर्गोषु गच्छेत नान्यत्र रमते नरः ।\nएवं लोकगतिर्देवि आदिप्रभृति वर्तते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205701, "chapter_id": 5382, "verse_number": "१३", "content_sanskrit": "प्रमदोक्तं तु यत् किञ्चित् तत्स्त्रीषु बहु मन्यते ।\nन तथा मन्यते स्त्रीषु पुरुषोक्तमनिन्दिते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205702, "chapter_id": 5382, "verse_number": "१४", "content_sanskrit": "त्वयैष विदितो ह्यर्थः स्त्रीणां धर्मः सनातनः ।\nतस्मात् त्वां परिपृच्छामि पृष्टा वद ममेप्सितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205703, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205704, "chapter_id": 5382, "verse_number": "१५", "content_sanskrit": "एवमुक्ता तदा देवी महादेवेन शोभना ।\nसोद्वेगा च सलज्जा च नावदत् तत्र किञ्चन \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2205705, "chapter_id": 5382, "verse_number": "१६", "content_sanskrit": "पुनः पुनस्तदा देवो देवीं किमिति चाब्रवीत् ।\nबहुशश्चोदिता देवी सव्रीडा चेदमब्रवीत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2205706, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2205707, "chapter_id": 5382, "verse_number": "१७", "content_sanskrit": "भगवन् देवदेवेश सुरासुरनमस्कृत ।\nत्वदन्तिके मया वक्तुं स्त्रीणां धर्मः कथं भवेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2205708, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2205709, "chapter_id": 5382, "verse_number": "१८", "content_sanskrit": "मन्नियोगादवश्यं तु वक्तव्यं हि मम प्रिये\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2205710, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2205711, "chapter_id": 5382, "verse_number": "१९", "content_sanskrit": "इमा नद्यो महादेव सर्वतीर्थोदकान्विताः ।\nउपस्पर्शनहेतोस्त्वां न त्यजन्ति समीपतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2205712, "chapter_id": 5382, "verse_number": "२०", "content_sanskrit": "एताभिः सह सम्मन्त्र्य प्रवक्ष्यामि तवेप्सितम् ।\nअयुक्तं सत्सु तज्ज्ञेषु तानतिक्रम्य भाषितुम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2205713, "chapter_id": 5382, "verse_number": "२१", "content_sanskrit": "मया सम्मानिताश्चैव भविष्यन्ति सरिद्वराः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2205714, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2205715, "chapter_id": 5382, "verse_number": "समाप्तिः", "content_sanskrit": "इति मत्वा महादेवी नदीर्देवीः समाह्वयत् ।\nविपाशां च वितस्तां च चन्द्रभागां सरस्वतीम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2205716, "chapter_id": 5382, "verse_number": "२३", "content_sanskrit": "शतद्रुं देविकां सिन्धुं गोमतीं कौशिकीं तथा ।\nयमुनां नर्मदां चैव कावेरीमथ निम्नगाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2205717, "chapter_id": 5382, "verse_number": "२४", "content_sanskrit": "तथा देवनदीं गङ्गां श्रेष्ठां त्रिपथगां शुभाम् ।\nसर्वतीर्थोदकवहां सर्वपापविनाशिनीम् ।\nएता नदीः समाहूय समुद्वीक्ष्येदमब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2205718, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2205719, "chapter_id": 5382, "verse_number": "२५", "content_sanskrit": "हे हे पुण्याः सरिच्छ्रेष्ठाः सर्वपापविनोदकाः ।\nज्ञानविज्ञानसम्पन्नाः शृणुध्वं वचनं मम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2205720, "chapter_id": 5382, "verse_number": "२६", "content_sanskrit": "अयं भगवता प्रश्न उक्तः स्त्रीधर्ममाश्रितः ।\nन चैकया मया साध्यस्तस्माद्वस्त्वानयाम्यहम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2205721, "chapter_id": 5382, "verse_number": "२७", "content_sanskrit": "युष्माभिस्तद्विचार्यैव वक्तुमिच्छामि शोभनाः ।\nतत् कथं देवदेवाय वाच्यः स्त्रीधर्म उत्तमः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2205722, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2205723, "chapter_id": 5382, "verse_number": "समाप्तिः", "content_sanskrit": "इति पृष्टास्तथा देव्या देवनद्यश्चकम्पिरे ।\nतासां श्रेष्ठतमा गङ्गा वचनं चेदमब्रवीत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2205724, "chapter_id": 5382, "verse_number": "२९", "content_sanskrit": "धन्याश्चानुगृहीताः स्म अनेन वचनेन ते ।\nया त्वं सुरासुरैर्मान्या नदीर्मानयसेऽनघे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2205725, "chapter_id": 5382, "verse_number": "३०", "content_sanskrit": "तवैवार्हन्ति कल्याणि एवं सान्त्वप्रसादनम् ।\nअशक्यमपि ये मूर्खाः स्वात्मसम्भावनायुताः ।\nवाक्यं वदन्ति संसत्सु स्वयमेव यथेष्टतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2205726, "chapter_id": 5382, "verse_number": "३१", "content_sanskrit": "यः शक्तश्चानहंवादी सुदुर्लभतमो मतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2205727, "chapter_id": 5382, "verse_number": "३२", "content_sanskrit": "त्वं हि शक्ता सती देवि वक्तुं प्रश्नमशेषतः ।\nव्याहर्तुं नेच्छसि स्त्रीत्वात् सम्पूजयसि नस्तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2205728, "chapter_id": 5382, "verse_number": "३३", "content_sanskrit": "त्वं हि देवसमा देवि ऊहापोहविशारदा ।\nदिव्यज्ञानयुता देवि दिव्यज्ञानेन्धनैधिता\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2205729, "chapter_id": 5382, "verse_number": "३४", "content_sanskrit": "त्वमेवार्हसि तद् वक्तुं स्त्रीणां धर्मं शुभाशुभम् ।\nयाचामहे वयं श्रोतुममृतं त्वन्मुखोद्गतम् ।\nकुरु देवि प्रियं देवि वद स्त्रीधर्ममुत्तमम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2205730, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2205731, "chapter_id": 5382, "verse_number": "३५", "content_sanskrit": "एवं प्रसादिता देवी गङ्गया लोकपूजिता ।\nप्राह सर्वमशेषेण स्त्रीधर्मं सुरसुन्दरी\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2205732, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2205733, "chapter_id": 5382, "verse_number": "३६", "content_sanskrit": "भगवन् देवदेवेश सुरेश्वर महेश्वर ।\nत्वत्प्रसादात् सुरश्रेष्ठ तवैव प्रियकाम्यया ।\nतमहं कीर्तयिष्यामि यथावच्छ्रोतुमर्हसि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2205734, "chapter_id": 5382, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे उमायाः स्त्रीधर्मकथनादेशो नाम त्रयस्त्रिंशोत्तरद्विशततमोऽध्यायः ॥२३३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]