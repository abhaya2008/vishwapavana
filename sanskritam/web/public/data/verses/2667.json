[{"id": 2078485, "chapter_id": 2667, "verse_number": "१२-१७२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078486, "chapter_id": 2667, "verse_number": "१२-१७२-१", "content_sanskrit": "विद्वान्संस्कारयामास पार्थिवो राजधर्मणः।\nगन्धैर्बहुभिरव्यग्रो दाहयामास पूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078487, "chapter_id": 2667, "verse_number": "१२-१७२-२", "content_sanskrit": "तस्य देवस्य वचनादिन्द्रस्य बकराडिह।\nतेनैवामृतसिक्ताश्च पुनः संजीवितो बकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078488, "chapter_id": 2667, "verse_number": "१२-१७२-३", "content_sanskrit": "राजधर्माऽपि तं प्राह सहस्राक्षमरिंदमम्।\nगौतमो ब्राह्मणः क्वाऽसौ मुच्यतां मत्प्रियः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078489, "chapter_id": 2667, "verse_number": "१२-१७२-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078490, "chapter_id": 2667, "verse_number": "१२-१७२-४", "content_sanskrit": "तस्य वाक्यं समाज्ञाय कौशिकः सुरसत्तमः।\nगौतमं ह्यभ्यनुज्ञाप्य प्रीतोऽथ गमनोत्सुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078491, "chapter_id": 2667, "verse_number": "१२-१७२-५", "content_sanskrit": "प्रतीतः स गतः सौम्यो राजधर्मा स्वमालयम्।\nनृशंसो गौतमो मुक्तो मित्रध्रुक्पुरुषाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078492, "chapter_id": 2667, "verse_number": "१२-१७२-६", "content_sanskrit": "सभाण्डोपस्करो यातः स तदा शबरालयम्।\nतत्रासौ शबरी देहे प्रसूतो निरयोपमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078493, "chapter_id": 2667, "verse_number": "१२-१७२-७", "content_sanskrit": "एष शापो महांस्तत्र मुक्तः सुरगणैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078494, "chapter_id": 2667, "verse_number": "१२-१७२-८", "content_sanskrit": "दग्धे राक्षसराजेन खगराजे प्रतापिना।\nचितायाः पार्श्वतो दोग्ध्री सुरभिर्जीवयच्च तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078495, "chapter_id": 2667, "verse_number": "१२-१७२-९", "content_sanskrit": "तस्या वक्राच्च्युतः फेनो दुग्धमात्रस्तदाऽनघ।\nसमीरणाहृतो यातश्चितां तां राजधर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078496, "chapter_id": 2667, "verse_number": "१२-१७२-१०", "content_sanskrit": "देवराजस्ततः प्राप्तो विरूपाक्षपुरं तदा।\nविरूपाक्षोऽपि तं शक्रमयाचत पुनः पुनः।\nकाश्यपश्य सुतो देव भ्राता मे जीवतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078497, "chapter_id": 2667, "verse_number": "१२-१७२-११", "content_sanskrit": "विरूपाक्षमुवाचेदमीश्वरः पाकशासनः।\nब्रह्मणा व्याहृतो रोषाद्राजधर्मा कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078498, "chapter_id": 2667, "verse_number": "१२-१७२-१२", "content_sanskrit": "यस्मात्त्वं नागतो द्रष्टुं मम नित्यमिमां सभाम्।\nतस्माद्बको भवान्भावी धर्मशीलः परात्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078499, "chapter_id": 2667, "verse_number": "१२-१७२-१३", "content_sanskrit": "आगमिष्यति ते वासं कदाचित्पापकर्मकृत्।\nशबरावासगो विप्रः कृतघ्नो वृषलीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078500, "chapter_id": 2667, "verse_number": "१२-१७२-१४", "content_sanskrit": "यदा निहन्ता मोक्षस्ते तदा भावीत्युवाच तम्।\nतस्मादेष गतो लोकं ब्रह्मणः परमेष्ठिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078501, "chapter_id": 2667, "verse_number": "१२-१७२-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078502, "chapter_id": 2667, "verse_number": "१२-१७२-१५", "content_sanskrit": "स चापि निरयं प्राप्तो दुष्कृतिः कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078503, "chapter_id": 2667, "verse_number": "१२-१७२-१६", "content_sanskrit": "एतच्छ्रुत्वा सभामध्ये तद्वाक्यं नारदेरितम्।\nमयाऽपि तव राजेन्द्र यथावदनुवर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078504, "chapter_id": 2667, "verse_number": "१२-१७२-१७", "content_sanskrit": "ब्रह्मघ्ने च सुरापे च चोरे भ्रष्टव्रते तथा।\nनिष्कृतिर्विहिता राजन्कृतघ्ने नास्ति निष्कृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078505, "chapter_id": 2667, "verse_number": "१२-१७२-१८", "content_sanskrit": "कुतः कृतघ्नस्य यशः कुतः स्थानं कुतः सुखम्।\nअश्रद्धेयः कृतघ्नो हि कृतघ्ने नास्ति निष्कृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078506, "chapter_id": 2667, "verse_number": "१२-१७२-१९", "content_sanskrit": "मित्रद्रोहो न कर्तव्यः पुरुषेण विशेषतः।\nमित्रध्रुङ्गिरयं घोरं नरकं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078507, "chapter_id": 2667, "verse_number": "१२-१७२-२०", "content_sanskrit": "कृतज्ञमनसा भाव्यं मित्रभावेन चानघ।\nमित्रात्प्रभवते सर्वं मित्रं धन्यतरं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078508, "chapter_id": 2667, "verse_number": "१२-१७२-२१", "content_sanskrit": "अर्थाद्वा मित्रलाभाद्वा मित्रलाभो विशिष्यते।\nसुलभा मित्रतोऽर्थास्तु मित्रेण यतितुं क्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078509, "chapter_id": 2667, "verse_number": "१२-१७२-२२", "content_sanskrit": "मित्रं चाभिमतं स्निग्धं फलं चापि सतां फलम्।\nसत्कारैः स्वजनोपेतः पूजयेत विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078510, "chapter_id": 2667, "verse_number": "१२-१७२-२३", "content_sanskrit": "परित्याज्यो बुधैः पापः कदर्यः कुलपांसनः।\nमित्रद्रोही कुलाङ्गारः पापकर्मा कुलाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078511, "chapter_id": 2667, "verse_number": "१२-१७२-२४", "content_sanskrit": "एषा सज्जनसांनिध्ये प्रज्ञा प्रोक्ता मयाऽनघ।\nमित्रदुहि कृतघ्ने च किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078512, "chapter_id": 2667, "verse_number": "१२-१७२-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078513, "chapter_id": 2667, "verse_number": "१२-१७२-२५", "content_sanskrit": "एतच्छ्रुत्वा ततो वाक्यं भीष्मेणोक्तं महात्मना।\nयुधिष्ठिरः प्रीतमना बभूव जनमेजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078514, "chapter_id": 2667, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि द्विसप्तत्यधिकशततमोऽध्यायः॥ १७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]