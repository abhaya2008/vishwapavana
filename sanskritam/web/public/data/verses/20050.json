[{"id": 7000050000, "chapter_id": 20050, "verse_number": "५०-१", "content_sanskrit": "प्रतिमोत्पत्तिकथनम् ब्रह्मोवाच स्तुत्वैवं मुनिसार्दूलाः प्रणम्य च सनातनम् ।\nवासुदेवं जगन्नातं सर्वकामलप्रदम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000050001, "chapter_id": 20050, "verse_number": "५०-२", "content_sanskrit": "चिन्ताविष्टो महीपालः कुशानास्तीर्य भूतले ।\nवस्त्रं च तन्मना भूत्वा सुष्वापधरणीतले ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000050002, "chapter_id": 20050, "verse_number": "५०-३", "content_sanskrit": "कथं प्रत्यक्षमभ्येति देवदेवो जनार्दनः ।\nमम चाऽऽर्तिहरो देवस्तदाऽसाविति चिन्तयन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000050003, "chapter_id": 20050, "verse_number": "५०-४", "content_sanskrit": "सुप्तस्य तस्य नृपतेर्वासुदेवो जगद्‌गुरुः ।\nआत्मानं दर्शयामास शङ्खचक्रगदाभृतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000050004, "chapter_id": 20050, "verse_number": "५०-५", "content_sanskrit": "स ददर्श तु सप्रेम देवेदेव जगद्‌गुरुम् ।\nशङ्खचक्रधरं देवं गदाचक्रेग्रपाणिनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000050005, "chapter_id": 20050, "verse_number": "५०-६", "content_sanskrit": "सार्ङ्गबाणधरं देवं ज्वलत्तेजोतिमण्‍डलम् ।\nयुगान्तादित्यवर्णाभं नीलवैदूर्यसंनिभम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000050006, "chapter_id": 20050, "verse_number": "५०-७", "content_sanskrit": "सुपर्णांसे तमासीनं षोडशार्धभुजं शुभम् ।\nस चास्मै प्राब्रवीद्धीराः साधु राजन्महामते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000050007, "chapter_id": 20050, "verse_number": "५०-८", "content_sanskrit": "क्रतुनाऽनेन दिव्येन तया भक्त्या च श्रद्धया ।\nतुष्टोऽस्मि ते महीपाल वृथा किमनुशोचसि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000050008, "chapter_id": 20050, "verse_number": "५०-९", "content_sanskrit": "यदत्र प्रतिमा राजञ्जगत्पूज्या सनातनी ।\nयथा सा प्राप्यते भूप तदुपायं ब्रवीमि ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000050009, "chapter_id": 20050, "verse_number": "५०-१०", "content_sanskrit": "गतायामद्य शर्वर्यां निर्मले भास्करोदिते ।\nसागारस्य जलस्यान्ते नानाद्रुमवविभूषिते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000050010, "chapter_id": 20050, "verse_number": "५०-११", "content_sanskrit": "जलं तथैव वेलायां दश्यते तत्र वै महत् ।\nलवणस्योदधे राजंस्तरङ्गैः समभिप्लुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000050011, "chapter_id": 20050, "verse_number": "५०-१२", "content_sanskrit": "कूलान्ते हि महावृक्षः स्थितः स्थलजलेषु च ।\nवेलाभिर्हन्यमानश्च न चासौ कम्पते द्रुमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000050012, "chapter_id": 20050, "verse_number": "५०-१३", "content_sanskrit": "परशुमादाय हस्तेन ऊर्मेरन्तस्ततो व्रज ।\nएकाकी हिहरन्राजन्स त्वं पश्यसि पादपम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000050013, "chapter_id": 20050, "verse_number": "५०-१४", "content_sanskrit": "ईदृक्चिह्नं समालोक्य छेदय त्वमशङ्कितः ।\nछेद्यमानं तु तं वृक्षं प्रातरद्‌भुतर्दर्शनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000050014, "chapter_id": 20050, "verse_number": "५०-१५", "content_sanskrit": "दृष्ट्वा तेनैव संचिन्त्य ततो भूपालदर्शनात् ।\nकुरु तां प्रतिमां दिव्यां जहि चिन्तां विमोहिनीम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000050015, "chapter_id": 20050, "verse_number": "५०-१६", "content_sanskrit": "ब्रह्मोवाच एवमुक्त्वा महाभागो जगामादर्शनं हरिः ।\nस चापि स्वप्नमालोक्य परं विस्मयमागतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000050016, "chapter_id": 20050, "verse_number": "५०-१७", "content_sanskrit": "तां निशां स समुद्वीक्ष्य स्थितस्तद्‌गतमानसः ।\nव्याहरन्वैष्णवान्मन्त्रान्सूवक्तं चैव तदात्मकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000050017, "chapter_id": 20050, "verse_number": "५०-१८", "content_sanskrit": "प्रगतायां रजन्यां तु उत्थितो नान्यमानसः ।\nसस्नात्वा सागरे सम्यग्यथावद्विधिना ततः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000050018, "chapter_id": 20050, "verse_number": "५०-१९", "content_sanskrit": "दत्त्वा दानं च विप्रेभ्यो ग्रामांस्च नगराणि च ।\nकृत्वा पौर्वाह्णिकं कर्म जगाम स नृपोत्तमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000050019, "chapter_id": 20050, "verse_number": "५०-२०", "content_sanskrit": "न चाश्वो न पदातिश्च न गजो न च सारथिः ।\nएकाकी स महावेलां प्रविवेश महीपतिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000050020, "chapter_id": 20050, "verse_number": "५०-२१", "content_sanskrit": "तं ददर्श महावृक्षं तेजस्वन्तं महाद्रुमम् ।\nमहातिगमहारोहं पुण्यं विपुलमेव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000050021, "chapter_id": 20050, "verse_number": "५०-२२", "content_sanskrit": "महोत्सेवं महाकायं प्रसुप्तं च जलान्तिके ।\nसान्द्रमाञ्जिष्ठवर्णाभं नामजातिविवर्जितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000050022, "chapter_id": 20050, "verse_number": "५०-२३", "content_sanskrit": "नरनायस्तदा विप्रा द्रुमं दृष्ट्वा मुदाऽन्वितः ।\nपरशुना शातयामास निशितेन दृढेन च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000050023, "chapter_id": 20050, "verse_number": "५०-२४", "content_sanskrit": "द्वैधीकर्तुमनास्तत्र बभूवेन्द्रसखः स च ।\nनिरीक्ष्यमाणे काष्ठे तु बभूवाद्भुतदर्शनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000050024, "chapter_id": 20050, "verse_number": "५०-२५", "content_sanskrit": "विश्वकर्मा च विष्णुश्च विप्ररूपधरावुभौ ।\nआजग्मतुर्महाभागौ तदा तुल्याग्रज्न्मानौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000050025, "chapter_id": 20050, "verse_number": "५०-२६", "content_sanskrit": "ज्वलमानौ स्वतेजोभिर्दिव्यस्रगनुलेपनौ ।\nअथ तौ तं समागम्य नृपमिन्द्रसखं तदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000050026, "chapter_id": 20050, "verse_number": "५०-२७", "content_sanskrit": "तावूचतुर्महाराज किमत्र त्वं करिष्यसि ।\nकिमर्थं च महाबाहो शातितश्च वनस्पतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000050027, "chapter_id": 20050, "verse_number": "५०-२८", "content_sanskrit": "असहायो महादुर्गे निर्जने गहने वने ।\nमहासिनधुतटे चैव कथं वै शातितो द्रुमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000050028, "chapter_id": 20050, "verse_number": "५०-२९", "content_sanskrit": "ब्रहमोवाच तयोः श्रुत्वा वचो विप्राः स तु राजा मुदाऽन्विंतः ।\nवभाषे वचनं ताभ्यां मृदुलं मधुरं तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000050029, "chapter_id": 20050, "verse_number": "५०-३०", "content_sanskrit": "दृष्ट्वा तौ ब्राह्मणौ तत्र चन्द्रसूर्याविवाऽऽगतौ ।\nनमस्कृत्य जगन्नाथावावङ्मुखमविस्थितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000050030, "chapter_id": 20050, "verse_number": "५०-३१", "content_sanskrit": "राजोवाच देवदेवमनाद्यन्तमनन्तं जगतां पतिम् ।\nआराधयितुं प्रतिमां करोमीति मतिर्मम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000050031, "chapter_id": 20050, "verse_number": "५०-३२", "content_sanskrit": "अहं स देवेदवेन परमेण महात्मना ।\nस्वप्नान्ते च समुद्दिष्टो भवद्‌भ्यां श्रावितं मया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000050032, "chapter_id": 20050, "verse_number": "५०-३३", "content_sanskrit": "राज्ञास्तु वचनं श्रुत्वा देवेन्द्रप्रतिमस्य च ।\nप्रहस्य तस्मै विश्वेशस्तुष्टो वचनमब्रवीत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000050033, "chapter_id": 20050, "verse_number": "५०-३४", "content_sanskrit": "विष्णुरुवाच साधु साधु महीपाल यदेतन्मतमुत्तमनम् ।\nसंसारसागरे घोरे कदलीदलसंनिभे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000050034, "chapter_id": 20050, "verse_number": "५०-३५", "content_sanskrit": "निःसारे दुःखबहुले कामक्रोधसमाकुले ।\nइन्द्रियावर्तकलिले दुस्तरे रोमहर्षणे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000050035, "chapter_id": 20050, "verse_number": "५०-३६", "content_sanskrit": "नानाव्याधिशतावर्ते जलबुद्‌बुदसंनिभे ।\nयतस्ते मतिरुत्पन्ना विष्णोराराधनाय वै ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000050036, "chapter_id": 20050, "verse_number": "५०-३७", "content_sanskrit": "धन्यस्त्वं नृपशार्दूल गुणैः सर्वैरलंकृता ।\nसप्रजा वृथिवी धन्या सशैसवनकानना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000050037, "chapter_id": 20050, "verse_number": "५०-३८", "content_sanskrit": "सुपुरग्रामनगरा चतुर्वर्णैरलंकृता ।\nयत्र त्वं नृपशार्दूल प्रजाः पालयिता प्रभुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000050038, "chapter_id": 20050, "verse_number": "५०-३९", "content_sanskrit": "एह्येहि सुमहाभाग द्रुमेऽस्मिन्सुखशीतले ।\nआवाभ्यां सह तिष्ठ त्वं कथाभिर्धर्मसंश्रितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000050039, "chapter_id": 20050, "verse_number": "५०-४०", "content_sanskrit": "अयं मम सहायस्तु आगतः शिल्पिनां वरः ।\nविश्वकर्मसमः साक्षान्निपुणः सर्वकर्मसु ।\nमयोद्दिष्टां तु प्रतिमां करोत्येष तटं त्यज ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000050040, "chapter_id": 20050, "verse_number": "५०-४१", "content_sanskrit": "ब्रह्मोवाच श्रुत्वैवं वचनं तस्य तदा राजा द्विजन्मनः ।\nसागरस्य तटं त्यक्त्वा गत्वा तस्य समीपतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000050041, "chapter_id": 20050, "verse_number": "५०-४२", "content_sanskrit": "तस्थौ स नृपतिश्रेष्ठो वृक्षच्छाये सुशीतले ।\nततस्तस्मै स विश्वात्मा ददावाज्ञां द्विजाकृतिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000050042, "chapter_id": 20050, "verse_number": "५०-४३", "content_sanskrit": "शिल्पिमुख्याय विप्रेन्द्राः कुरुष्व प्रतिमा इति ।\nकृष्णरूपं परं शान्तं पद्मत्रायतेक्षणम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000050043, "chapter_id": 20050, "verse_number": "५०-४४", "content_sanskrit": "श्रीवत्सकौस्तुभधरं शङ्खचक्रगदाधरम् ।\nगौराङ्गंक्षीरवर्णभं द्वितीयं स्वस्तिकाङ्कितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000050044, "chapter_id": 20050, "verse_number": "५०-४५", "content_sanskrit": "लाङ्गलास्त्रधरं देवमनन्ताख्यं महाबलम् ।\nदेवदानवागन्धर्वयक्षविद्याधरोरगैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000050045, "chapter_id": 20050, "verse_number": "५०-४६", "content_sanskrit": "न विज्ञातो हि तस्यान्तस्तेनानान्त इति स्मृतः ।\nभगिनीं वासुदेवस्य रुक्मवर्णां सुखोभनाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000050046, "chapter_id": 20050, "verse_number": "५०-४७", "content_sanskrit": "तृतीयां वै सुभद्रां च स्र्वलक्षणलक्षिताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000050047, "chapter_id": 20050, "verse_number": "५०-४८", "content_sanskrit": "ब्रह्मोवाच श्रुत्वैतद्वचनं तस्य विश्वकर्मा सुकर्मकृत् ।\nतत्क्षणात्कारयामास प्रतिमाः शुभलक्षणाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000050048, "chapter_id": 20050, "verse_number": "५०-४९", "content_sanskrit": "प्रथमं शुक्लवर्णाभं शारदेन्दुसमप्रभम् ।\nआरक्ताक्षं महाकायं स्फटाविकटमस्तकम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000050049, "chapter_id": 20050, "verse_number": "५०-५०", "content_sanskrit": "नीलाम्बरधरं चोग्रं बलं बलमदोद्धतम् ।\nकुण्डलैकधरं दिव्यं गदामुशलधारिणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000050050, "chapter_id": 20050, "verse_number": "५०-५१", "content_sanskrit": "द्वितीयं पुण्डरीकाक्षं नीलजीमूतसंनिभम् ।\nअतसीपुष्पसंकाशं पद्मपत्रायतेक्षमण् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000050051, "chapter_id": 20050, "verse_number": "५०-५२", "content_sanskrit": "पीतवाससमत्युग्रं शुभं श्रीवत्सलक्षणम् ।\nचक्रपूर्णकरं दिव्यं सर्वपापहरं हरिम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000050052, "chapter_id": 20050, "verse_number": "५०-५३", "content_sanskrit": "तृतीयां स्वर्णवर्णाभां पद्मपत्रायतेक्षणाम् ।\nविचित्रवस्त्रसंछन्नां हारकेयूरभूषिताम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000050053, "chapter_id": 20050, "verse_number": "५०-५४", "content_sanskrit": "विचित्राभरणोपेतां रत्नहारावलम्बिताम् ।\nपीनोन्नतकुचां रम्यां विश्वकर्मा विनिर्ममे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000050054, "chapter_id": 20050, "verse_number": "५०-५५", "content_sanskrit": "स तु राजाऽद्भुतं दृष्ट्वा क्षणेनैकेन निर्मिताः ।\nदिव्यवस्त्रयुगच्छन्ना नानारत्नैरलंकृताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000050055, "chapter_id": 20050, "verse_number": "५०-५६", "content_sanskrit": "सर्वलक्षणसंपन्नाः प्रतिमाः सुमनोहराः ।\nविस्मयं परमं गत्वा इदं वचनमब्रवीत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000050056, "chapter_id": 20050, "verse_number": "५०-५७", "content_sanskrit": "इन्द्रद्युम्न उवाच किं देवौ समनुप्राप्तौ द्विजरूपधरावुभौ ।\nउभौ चाद्‌भुतकर्माणौ देववृत्तावमानुषौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000050057, "chapter_id": 20050, "verse_number": "५०-५८", "content_sanskrit": "देवौ वा मानुषौ वाऽपि यक्षविद्याधरौ युवाम् ।\nकिंनु ब्रह्महृषीकेशौकिं वसू किमुताश्विनौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000050058, "chapter_id": 20050, "verse_number": "५०-५९", "content_sanskrit": "न वेद्यि सत्यसद्भावौ मायारूपेण संस्तितौ ।\nयुवां गतोऽस्मि शरणमात्मा तु मे प्रकाश्यताम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]