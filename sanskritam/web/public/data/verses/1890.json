[{"id": 2040249, "chapter_id": 1890, "verse_number": "५-१३५-०x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040250, "chapter_id": 1890, "verse_number": "५-१३५-१", "content_sanskrit": "कृष्णायसस्येव च ते संहत्य हृदयं कृतम्।\nमम मातस्त्वकरुणे वीरप्रज्ञे ह्यमर्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040251, "chapter_id": 1890, "verse_number": "५-१३५-२", "content_sanskrit": "अहो क्षत्रसमाचारो यत्र मामितरं यथा।\nनियोजयसि युद्धाय परमातेव मां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040252, "chapter_id": 1890, "verse_number": "५-१३५-३", "content_sanskrit": "ईदृशं वचनं ब्रूयाद्भवती पुत्रमेकजम् ।\nकिं नु ते मामपश्यन्त्याः पृथिव्या अपि सर्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040253, "chapter_id": 1890, "verse_number": "५-१३५-४", "content_sanskrit": "किमाभरणकृत्येन किं भोगैर्जीवितेन वा।\nमयि वा सङ्गरहते प्रियपुत्रे विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040254, "chapter_id": 1890, "verse_number": "५-१३५-५x", "content_sanskrit": "मातोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040255, "chapter_id": 1890, "verse_number": "५-१३५-५", "content_sanskrit": "सर्वावस्था हि विदुषां तात धर्मार्थकारणात् ।\nतावेवाभिसमीक्ष्याहं सञ्जय त्वामचूजुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040256, "chapter_id": 1890, "verse_number": "५-१३५-६", "content_sanskrit": "स समीक्ष्य क्रमोपेतो मुख्यः कालोऽयमागतः।\nअस्मिंश्चेदागते काले कार्यं न प्रतिपद्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040257, "chapter_id": 1890, "verse_number": "५-१३५-७", "content_sanskrit": "असंभावितरूपस्त्वमानृशंस्यं करिष्यसि ।\nतं त्वामयशसा स्पृष्टं न ब्रूयां यदि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040258, "chapter_id": 1890, "verse_number": "५-१३५-८", "content_sanskrit": "खरीवात्सल्यमाहुस्तन्निःसामर्थ्यमहेतुकम् ।\nसद्भिर्विगर्हितं मार्गं त्यज मूर्खनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040259, "chapter_id": 1890, "verse_number": "५-१३५-९", "content_sanskrit": "अविद्या वै महत्यस्ति यामिमां संश्रिताः प्रजाः ।\nतव स्याद्यदि सद्वृत्तं तेन मे त्वं प्रियो भवेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040260, "chapter_id": 1890, "verse_number": "५-१३५-१०", "content_sanskrit": "धर्मार्थगुणयुक्तेन नेतरेण कथञ्चन।\nदैवमानुषयुक्तेन सद्भिराचरितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040261, "chapter_id": 1890, "verse_number": "५-१३५-११", "content_sanskrit": "यो ह्येवमविनीतेन रमते पुत्रनप्तृणा।\nअनुत्थानवता चापि दुर्विनीतेन दुर्धिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040262, "chapter_id": 1890, "verse_number": "५-१३५-१२", "content_sanskrit": "रमते यस्तु पुत्रेण मोघं तस्य प्रजाफलम्।\nअकुर्वन्तो हि कर्माणि कुर्वन्तो निन्दितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040263, "chapter_id": 1890, "verse_number": "५-१३५-१३", "content_sanskrit": "सुखं नैवेह नामुत्र लभन्ते पुरुषाधमाः ।\nयुद्धाय क्षत्रियः सृष्टः सञ्जयेह जयाय च ।\n`क्रूराय कर्मणे नित्यं प्रजानां परिपालने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040264, "chapter_id": 1890, "verse_number": "५-१३५-१४", "content_sanskrit": "जयन्वा वध्यमानो वा प्राप्नोतीन्द्रसलोकताम् ।\nन शक्रभवने पुण्ये दिवि तद्विद्यते सुखम्।\nयदमित्रान्वशे कृत्वा क्षत्रियः सुखमेधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040265, "chapter_id": 1890, "verse_number": "५-१३५-१५", "content_sanskrit": "मन्युना दह्यमानेह पुरुषेण मनस्विना ।\nनिकृतेनेह बहुशः शत्रून्प्रति जिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040266, "chapter_id": 1890, "verse_number": "५-१३५-१६", "content_sanskrit": "आत्मानं वा परित्यज्य शत्रुं वा विनिपात्य च।\nप्राप्यते नेह शान्तिर्हि नित्यमेव तु सञ्जय ।\nअतोन्येन प्रकारेण शान्तिरस्य कुतो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040267, "chapter_id": 1890, "verse_number": "५-१३५-१७", "content_sanskrit": "इह प्राज्ञो हि पुरुषः स्वल्पमप्रियमिच्छति।\nयस्य स्वल्पं प्रियं लोके ध्रुवं तस्याल्पमप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040268, "chapter_id": 1890, "verse_number": "५-१३५-१८", "content_sanskrit": "प्रियाभावाच्च पुरुषो नैव प्राप्नोति शोभनम् ।\nध्रुवं चाभावमभ्येति गत्वा गङ्गेव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040269, "chapter_id": 1890, "verse_number": "५-१३५-१९x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040270, "chapter_id": 1890, "verse_number": "५-१३५-१९", "content_sanskrit": "नेयं मतिस्त्वया वाच्या मातः पुत्रे विशेषतः ।\nकारुण्यमेव पश्य त्वं भूत्वेह जडमूकवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040271, "chapter_id": 1890, "verse_number": "५-१३५-२०x", "content_sanskrit": "मातोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040272, "chapter_id": 1890, "verse_number": "५-१३५-२०", "content_sanskrit": "अतो मे भूयसी नन्दिर्यदेवमनुपश्यसि।\nचोद्यं मां चोदयस्येतद्भृशं वै चोदयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040273, "chapter_id": 1890, "verse_number": "५-१३५-२१", "content_sanskrit": "अथ त्वां पूजयिष्यामि हत्वा वै सर्वसैन्धवान्।\nअहं पश्यामि विजयं कृच्छ्रभाविनमेव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040274, "chapter_id": 1890, "verse_number": "५-१३५-२२x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040275, "chapter_id": 1890, "verse_number": "५-१३५-२२", "content_sanskrit": "अकोशस्यासहायस्य कुतः सिद्धिर्जयो मम।\nइत्यवस्थां विदित्वैतामात्मनात्मनि दारुणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040276, "chapter_id": 1890, "verse_number": "५-१३५-२३", "content_sanskrit": "राज्याद्भावो निवृत्तो मे त्रिदिवादिव दृष्कृतः ।\nईदृशं भवती कंचिदुपायमनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040277, "chapter_id": 1890, "verse_number": "५-१३५-२४", "content_sanskrit": "तन्मे परिणतप्रज्ञे सम्यक्प्रब्रूहि पृच्छते।\nकरिष्यामि हि तत्सर्वं यथावदनुशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040278, "chapter_id": 1890, "verse_number": "५-१३५-२५x", "content_sanskrit": "मातोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040279, "chapter_id": 1890, "verse_number": "५-१३५-२५", "content_sanskrit": "पुत्र नात्मावमन्तव्यः पूर्वाभिरसमृद्धिभिः ।\nअभूत्वा हि भवन्त्यर्था भूत्वा नश्यन्ति चापरे।\nअमर्षेणैव चाप्यर्था नारब्धव्याः सुबालिशैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040280, "chapter_id": 1890, "verse_number": "५-१३५-२६", "content_sanskrit": "सर्वेषां कर्मणां तात फले नित्यमनित्यता।\nअनित्यमिति जानन्तो न भवन्ति भवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040281, "chapter_id": 1890, "verse_number": "५-१३५-२७", "content_sanskrit": "अथ ये नैव कुर्वन्ति नैव जातु भवन्ति ते।\nऐकगुण्यमनीहायामभावः कर्मणां फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040282, "chapter_id": 1890, "verse_number": "५-१३५-२८", "content_sanskrit": "अथ द्वैगुण्यमीहायां फलं भवति वा नवा ।\nयस्य प्रागेव विदिता सर्वार्थानामनित्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040283, "chapter_id": 1890, "verse_number": "५-१३५-२९", "content_sanskrit": "नुदेद्वृद्धिसमृद्धी स प्रतिकूले नृपात्मज ।\nउत्थातव्यं जागृतव्यं योक्तव्यं भूतिकर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040284, "chapter_id": 1890, "verse_number": "५-१३५-३०", "content_sanskrit": "भविष्यतीत्येव मनः कृत्वा सततमव्यथैः ।\nमङ्गलानि पुरस्कृत्य ब्राह्मणांश्चेश्वरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040285, "chapter_id": 1890, "verse_number": "५-१३५-३१", "content_sanskrit": "प्राज्ञस्य नृपतेराशु वृद्धिर्भवति पुत्रक ।\nअभिवर्तति लक्ष्मीस्तं प्राचीमिव दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040286, "chapter_id": 1890, "verse_number": "५-१३५-३२", "content_sanskrit": "निदर्शनान्युपायांश्च बहून्युद्धर्षणानि च।\nअनुदर्शितरूपोऽसि पश्यामि कुरु पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040287, "chapter_id": 1890, "verse_number": "५-१३५-३३", "content_sanskrit": "पुरुषार्थमभिप्रेतं समाहर्तुमिहार्हसि।\nक्रुद्धान्लुब्धान्परिक्षीणानवलिप्तान्विमानितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040288, "chapter_id": 1890, "verse_number": "५-१३५-३४", "content_sanskrit": "स्पर्धिनश्चैव ये केचित्तान्युक्त उपधारय।\nएतेन त्वं प्रकारेण महतो भेत्स्यसे गणान्।\nमहावेग इवोद्धूतो मातरिश्वा बलाहकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040289, "chapter_id": 1890, "verse_number": "५-१३५-३५", "content_sanskrit": "तेषामग्रप्रदायी स्याः कल्पोत्थायी प्रियंवदः ।\nते त्वां प्रियं करिष्यन्ति पुरोधास्यन्ति च ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040290, "chapter_id": 1890, "verse_number": "५-१३५-३६", "content_sanskrit": "यदैव शत्रुर्जानीयात्सपत्नं त्यक्तजीवितम्।\nतदैवास्मादुद्विजेत सर्पाद्वेश्मगतादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040291, "chapter_id": 1890, "verse_number": "५-१३५-३७", "content_sanskrit": "तं विदित्वा पराक्रान्तं वशे न कुरुते यदि।\nनिर्वादैर्निर्वदेदेनमन्ततस्तद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040292, "chapter_id": 1890, "verse_number": "५-१३५-३८", "content_sanskrit": "निर्वादादास्पदं लब्धा धनवृद्धिर्भविष्यति।\nधनवन्तं हि मित्राणि भजन्ते चाश्रयन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040293, "chapter_id": 1890, "verse_number": "५-१३५-३९", "content_sanskrit": "स्खलितार्थं पुनस्तानि सन्त्यजन्ति च बान्धवाः ।\nनह्यस्मिन्नाश्रयन्ते च जुगुप्सन्ते च तादृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040294, "chapter_id": 1890, "verse_number": "५-१३५-४०", "content_sanskrit": "शत्रुं कृत्वा यः सहायं विश्वासमुपगच्छति।\nस न संभाव्यमेवैतद्यद्राज्यं प्राप्नुयादिति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040295, "chapter_id": 1890, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि पञ्चत्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]