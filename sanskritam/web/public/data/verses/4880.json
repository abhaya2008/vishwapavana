[{"id": 2182927, "chapter_id": 4880, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182928, "chapter_id": 4880, "verse_number": "१", "content_sanskrit": "अथ यो विजिगीषेत क्षत्रियः क्षत्रियं युधि ।\nकस्तस्य धम्योर्र् विजय एतत्पृष्टो ब्रवीहि मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182929, "chapter_id": 4880, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182930, "chapter_id": 4880, "verse_number": "२", "content_sanskrit": "ससहायोऽसहायो वा राष्ट्रमागम्य भूमिपः ।\nब्रूयादहं वो राजेति रक्षिष्याम च वः सदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182931, "chapter_id": 4880, "verse_number": "३", "content_sanskrit": "मम धर्म्यं बलिं दत्त किं वा मां प्रतिपत्स्यथ ।\nते चेत् तमागतं तत्र वृणुयुः कुशलं भवेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182932, "chapter_id": 4880, "verse_number": "४", "content_sanskrit": "ते चेदक्षत्रियाः सन्तो विरुद्ध्येयुः कथञ्चन ।\nसर्वोपायैर्नियन्तव्या विकर्मस्था नराधिप\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182933, "chapter_id": 4880, "verse_number": "५", "content_sanskrit": "अशक्तं क्षत्रियं मत्वा शस्त्रं गृह्णात्यथापरः ।\nत्राणायाप्यसमर्थं तं मन्यमानमतीव च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182934, "chapter_id": 4880, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182935, "chapter_id": 4880, "verse_number": "६", "content_sanskrit": "अथ यः क्षत्रियो राजा क्षत्रियं प्रत्युपाव्रजेत् ।\nकथं स प्रतियोद्धव्यस्तन्मे ब्रूहि पितामह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182936, "chapter_id": 4880, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182937, "chapter_id": 4880, "verse_number": "७", "content_sanskrit": "नासन्नद्धो नाकवचो योद्धव्यः क्षत्रियो रणे ।\nएक एकेन वाच्यश्च विसृजस्व क्षिपामि च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182938, "chapter_id": 4880, "verse_number": "८", "content_sanskrit": "स चेत् सन्नद्ध आगच्छेत् सन्नद्धव्यं ततो भवेत् ।\nस चेत् ससैन्य आगच्छेत् ससैन्यस्तमथाह्वयेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182939, "chapter_id": 4880, "verse_number": "९", "content_sanskrit": "स चेन्निकृत्या युद्ध्येत निकृत्या तं प्रयोधयेत् ।\nअथ चेद् धर्मतो युद्ध्येद् धर्मेणैव निवारयेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182940, "chapter_id": 4880, "verse_number": "१०", "content_sanskrit": "नाश्वेन रथिनं यायादुदियाद् रथिनं रथी ।\nव्यसने न प्रहर्तव्यं न भीताय जिताय च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182941, "chapter_id": 4880, "verse_number": "११", "content_sanskrit": "नेषुर्लिप्तो न कर्णी स्यादसतामेतदायुधम् ।\nजयार्थमेव योद्धव्यं न क्रुद्ध्येदजिघांसतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182942, "chapter_id": 4880, "verse_number": "१२", "content_sanskrit": "नास्त्येकस्य गजो युद्धे गजश्चैकस्य विद्यते(?) ।\nन पदातिर्गजं युद्ध्येन्न गजेन पदातिनम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182943, "chapter_id": 4880, "verse_number": "१३", "content_sanskrit": "हस्तिना योधयेन्नागं कदाचिच्छिक्षितो हयम् ।\nदिव्यास्त्रबलसम्पन्नः कामं युद्ध्येत सर्वदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182944, "chapter_id": 4880, "verse_number": "१४", "content_sanskrit": "नागे भूमौ समे चैव रथेनाश्वेन वा पुनः ।\nरामरावणयोर्युद्धे हरयो वै पदातयः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182945, "chapter_id": 4880, "verse_number": "१५", "content_sanskrit": "लक्ष्मणश्च महाभागस्तथा राजन् विभीषणः ।\nरावणस्यान्तकाले च रथेनैन्द्रेण राघवः ।\nनिजघान दुराचारं रावणं पापकारिणम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182946, "chapter_id": 4880, "verse_number": "१६", "content_sanskrit": "दिव्यास्त्रबलसम्पन्ने सर्वमेतद् विधीयते ।\nदेवासुरेषु युद्धेषु दृष्टमेतत् पुरातने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182947, "chapter_id": 4880, "verse_number": "१७", "content_sanskrit": "साधूनां तु मिथो भेदात् साधुश्चेद् व्यसनी भवेत् ।\nसव्रणो नाभिहन्तव्यो नानपत्यः कथञ्चन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182948, "chapter_id": 4880, "verse_number": "१८", "content_sanskrit": "भग्नशस्त्रो विपन्नाश्वश्छिन्नज्यो हतवाहनः ।\nचिकित्स्यः स्यात् स्वविषये प्राप्यो वा स्वगृहान् भवेत्\t।\nनिर्व्रणोऽपि च मोक्तव्य एष धर्मः सनातनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182949, "chapter_id": 4880, "verse_number": "१९", "content_sanskrit": "तस्माद् धर्मेण योद्धव्यं मनुः स्वायम्भुवोऽब्रवीत् ।\nसत्सु नित्यं सतां धर्मस्तमास्थाय न नाशयेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182950, "chapter_id": 4880, "verse_number": "२०", "content_sanskrit": "यो वै जयत्यधर्मेण क्षत्रियो धर्मसङ्गरः ।\nआत्मानमात्मना हन्ति पापो निकृतिजीवनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182951, "chapter_id": 4880, "verse_number": "२१", "content_sanskrit": "कर्म चैतदसाधूनामसाधुं साधुना जयेत् ।\nधर्मेण निधनं श्रेयो न जयः पापकर्मणा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182952, "chapter_id": 4880, "verse_number": "२२", "content_sanskrit": "नाधर्मश्चरितो राजन् सद्यः फलति गौरिव ।\nमूलान्यस्य प्रशाखाश्च दहन् समनुगच्छति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182953, "chapter_id": 4880, "verse_number": "२३", "content_sanskrit": "पापेन कर्मणा वित्तं लब्ध्वा पापः प्रहृष्यति ।\nस वर्धमानः स्तेयेन पापः पापे प्रसज्जति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182954, "chapter_id": 4880, "verse_number": "२४", "content_sanskrit": "न धर्मोऽस्तीति मन्वानः शुचीनवहसन्निव ।\nअश्रद्दधानभावाच्च विनाशमुपगच्छति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182955, "chapter_id": 4880, "verse_number": "२५", "content_sanskrit": "स बद्धो वारुणैः पाशैरमर्त्य इव मन्यते ।\nमहादृतिरिवाध्माता स्वकृतेन विवर्धते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182956, "chapter_id": 4880, "verse_number": "२६", "content_sanskrit": "ततः समूलो ह्रियते नदीकूलादिव द्रुमः ।\nअथैनमभिनन्दन्ति भिन्नं कुम्भमिवाश्मनि ।\nतस्माद् धर्मेण विजयं कामं लिप्सेत भूमिपः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182957, "chapter_id": 4880, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे सप्तनवतितमोऽध्यायः ॥ ९७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]