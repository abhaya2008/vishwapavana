[{"id": 2110543, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110544, "chapter_id": 3391, "verse_number": "१", "content_sanskrit": "अथ दीर्घेण कालेन देवयानी नृपोत्तम ।\nवनं तदेव निर्याता क्रीडार्थं वरवर्णिनी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110545, "chapter_id": 3391, "verse_number": "२", "content_sanskrit": "तेन दासीसहस्रेण सार्धं शर्मिष्ठया तदा ।\nतमेव देशं सम्प्राप्ता यथाकामं चचार सा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110546, "chapter_id": 3391, "verse_number": "३", "content_sanskrit": "ताभिः सखीभिः सहिताः सर्वाभिर्मुदिता भृशम् ।\nक्रीडित्वोपरताः सर्वाः पिबन्त्यो मधु माधवम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110547, "chapter_id": 3391, "verse_number": "४", "content_sanskrit": "खादन्त्यो विविधान् भक्ष्यान् विदंशन्त्यः फलानि च ।\nपुनश्च नाहुषो राजा मृगलिप्सुर्यदृच्छया \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110548, "chapter_id": 3391, "verse_number": "५", "content_sanskrit": "तमेव देशं सम्प्राप्तो जलार्थी श्रमकर्शितः ।\nददर्श देवयानीं च शर्मिष्ठां ताश्च योषितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110549, "chapter_id": 3391, "verse_number": "६", "content_sanskrit": "पिबन्तीर्लपमानाश्च सर्वाभरणभूषिताः ।\nआसने प्रवरे दिव्ये सर्वाभरणभूषिते \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110550, "chapter_id": 3391, "verse_number": "७", "content_sanskrit": "उपविष्टां सुकेशान्तां देवयानीं शुचिस्मिताम् ।\nरूपेणाप्रतिमां तासां स्त्रीणां मध्ये वराङ्गनाम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110551, "chapter_id": 3391, "verse_number": "८", "content_sanskrit": "आसनाच्च ततः किञ्चिद् विहीनां हेमभूषिताम् ।\nअसुरेन्द्रसुतां चापि निषण्णां चारुहासिनीम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110552, "chapter_id": 3391, "verse_number": "९", "content_sanskrit": "ददर्श पादौ विप्रायाः संवहन्तीमनिन्दिताम्\nगायन्त्योऽथ प्रनृत्यन्त्यो वादयन्त्यश्च भारत ।\nदृष्ट्वा ययातिमतुलं लज्जयाऽवनताः स्थिताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110553, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110554, "chapter_id": 3391, "verse_number": "१०", "content_sanskrit": "युवां कन्यासहस्रेण द्वे कन्ये परिवारिते ।\nगोत्रे च नामधेये च द्वयोः पृच्छामि वामहम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110555, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110556, "chapter_id": 3391, "verse_number": "११", "content_sanskrit": "आख्यास्याम्यहमादत्स्व वचनं मे नरोत्तम ।\nशुक्रो नामासुरगुरुः सुतां जानीहि तस्य माम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110557, "chapter_id": 3391, "verse_number": "१२", "content_sanskrit": "इयं च मे सखी दासी यत्राहं तत्र गामिनी ।\nदुहिता दानवेन्द्रस्य शर्मिष्ठा वृषपर्वणः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110558, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110559, "chapter_id": 3391, "verse_number": "१३", "content_sanskrit": "कथं नु ते सखी दासी कन्येयं वरवर्णिनी ।\nनैव देवी न गन्धर्वी न यक्षी न च किन्नरी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110560, "chapter_id": 3391, "verse_number": "१४", "content_sanskrit": "नैवंरूपा मया नारी दृष्टपूर्वा महीतळे ।\nश्रीरिवायतपद्माक्षी सर्वलक्षणशोभिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110561, "chapter_id": 3391, "verse_number": "१५", "content_sanskrit": "असुरेन्द्रसुता कन्या सर्वालङ्कारभूषिता ।\nदैवेनोपहता सुभ्रूरुताहो तपसाऽपि वा ।\nअन्यथैषाऽनवद्याङ्गी दासी ते न भविष्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110562, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110563, "chapter_id": 3391, "verse_number": "१६", "content_sanskrit": "सर्वमेतन्नरव्याघ्र विधानमनुवर्तते ।\nविधानविहितं मत्वा मा विचारय सुव्रत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110564, "chapter_id": 3391, "verse_number": "१७", "content_sanskrit": "राजवद् रूपवेषौ ते ब्राह्मीं वाचं बिभर्षि च ।\nकिं नाम त्वं कुतश्चासि कस्य पुत्रश्च शंस मे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110565, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110566, "chapter_id": 3391, "verse_number": "१८", "content_sanskrit": "ब्रह्मचर्येण सर्वान् वै साङ्गान् वेदान् विदाम्यहम् ।\nराजाऽहं राजपुत्रश्च ययातिरिति विश्रुतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110567, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110568, "chapter_id": 3391, "verse_number": "१९", "content_sanskrit": "केनास्यर्थेन नृपते इमं देशमुपागतः ।\nजिघृक्षुर्वा रिपुं कञ्चिदथवा मृगलिप्सया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110569, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110570, "chapter_id": 3391, "verse_number": "२०", "content_sanskrit": "मृगलिप्सुरहं भद्रे पानीयार्थमिहागतः ।\nबहु चाप्यनुयुक्तोऽस्मि तन्माऽनुज्ञातुमर्हसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110571, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110572, "chapter_id": 3391, "verse_number": "२१", "content_sanskrit": "अहं दासीसहस्रेण दास्या शर्मिष्ठया सह ।\nत्वदधीनाऽस्मि भद्रं ते साधु भर्ता च मे भव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110573, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110574, "chapter_id": 3391, "verse_number": "२२", "content_sanskrit": "असुरेन्द्रसुतामीक्ष्य तस्यां सक्तेन चेतसा ।\nशर्मिष्ठा महिषी मह्यमिति मत्वा वचोऽव्रवीत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110575, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110576, "chapter_id": 3391, "verse_number": "२३", "content_sanskrit": "विद्ध्यौशनसि भद्रं ते न त्वमर्हसि भामिनि ।\nअवैवाह्या हि राजानो देवयानि पितुस्तव \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110577, "chapter_id": 3391, "verse_number": "२४", "content_sanskrit": "परभार्या स्वसा श्रेष्ठा सगोत्रा पतिता स्नुषा ।\nअवरा भिक्षुकाऽस्वस्था अगम्याः कीर्तिता बुधैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110578, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110579, "chapter_id": 3391, "verse_number": "२५", "content_sanskrit": "संसृष्टं ब्रह्मणा क्षत्रं क्षत्रेण ब्रह्म संहितम् ।\nअन्यत्वमस्ति न तयोरेकान्तरसमास्थिते ।\nऋषिश्चाप्यृषिपुत्रश्च नाहुषाङ्ग वहस्व माम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110580, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110581, "chapter_id": 3391, "verse_number": "२६", "content_sanskrit": "एकत्रैवोद्भवा वर्णाश्चत्वारोऽपि वराङ्गने ।\nपृथग्धर्माः पृथक्शौचास्तेषां तु ब्राह्मणो गुरुः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110582, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110583, "chapter_id": 3391, "verse_number": "२७", "content_sanskrit": "पाणिर्मे नाहुषायं वै न पुम्भिः सेवितः पुरा ।\nत्वमेव चाग्रहीरग्रे वृणोमि त्वामहं ततः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110584, "chapter_id": 3391, "verse_number": "२८", "content_sanskrit": "कथं नु मे मनस्विन्याः पाणिमन्यः पुमान् स्पृशेत् ।\nगृहीतमृषिपुत्रेण स्वयं पूर्वं नृप त्वया \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2110585, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2110586, "chapter_id": 3391, "verse_number": "२९", "content_sanskrit": "क्रुद्धादाशीविषाच्छस्त्राज्ज्वलनात् सर्वतोमुखात् ।\nदुराधर्षतरो विप्रः पुरुषेण विजानता\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2110587, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2110588, "chapter_id": 3391, "verse_number": "३०", "content_sanskrit": "कथमाशीविषाच्छस्त्राज्ज्वलनात् सर्वतोमुखात् ।\nदुराधर्षतरो विप्र इत्यात्थ पुरुषर्षभ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2110589, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2110590, "chapter_id": 3391, "verse_number": "३१", "content_sanskrit": "एकमाशीविषो हन्ति शस्त्रमेकं निहन्ति च ।\nसराष्ट्रं सप्रजं हन्ति विप्रः कोपेन संयुतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2110591, "chapter_id": 3391, "verse_number": "३२", "content_sanskrit": "क्वचिदाशीविषो हन्याच्छस्त्रमेवं निकृन्तति ।\nयदृच्छयाऽग्निर्दहति मनसा हन्ति वै द्विजः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2110592, "chapter_id": 3391, "verse_number": "३३", "content_sanskrit": "दुराधर्षतरो विप्रस्तस्माद् भीरु मतो मम ।\nअतो नदत्तां पित्रा त्वां भद्रे न विवहाम्यहम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2110593, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2110594, "chapter_id": 3391, "verse_number": "३४", "content_sanskrit": "दत्तां वहस्व राजेन्द्र पित्रा राजन् वृतो मया ।\nअयाचतो भयं नास्ति दत्तां च प्रतिगृह्णतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2110595, "chapter_id": 3391, "verse_number": "३६", "content_sanskrit": "तिष्ठ राजन् मुहूर्तं त्वं प्रेषयिष्याम्यहं पितुः ।\nगच्छ त्वं धात्रिके शीघ्रं ब्रह्मकल्पमिहानय ।\nस्वयंवरे वृतं शीघ्रं निवेदय च नाहुषम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2110596, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2110597, "chapter_id": 3391, "verse_number": "३७", "content_sanskrit": "त्वरितं देवयान्या तु प्रेषितं पितुरात्मनः ।\nसंश्रुत्वैव वचस्तस्या दर्शयामास भार्गवः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2110598, "chapter_id": 3391, "verse_number": "३९", "content_sanskrit": "दृष्ट्वैव चागतं विप्रं ययातिः पृथवीपतिः।\nववन्दे ब्राह्मणं काव्यं प्राञ्जलिः प्रणतः स्थितः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2110599, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2110600, "chapter_id": 3391, "verse_number": "४०", "content_sanskrit": "राजाऽयं नाहुषस्तात दुर्गे मे पाणिमस्पृशत् ।\nनान्यपूर्वगृहीतं मे तेनाहमभया कृता ।\nनमस्ते देहि मामस्मै लोके नान्यं पतिं वृणे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2110601, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2110602, "chapter_id": 3391, "verse_number": "४१", "content_sanskrit": "अन्यो धर्म्यः प्रियस्त्वन्यो वृतस्त्वन्नाहुषः पतिः ।\nकचशापात् त्वया पूर्वं नान्यद् भवितुमर्हति \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2110603, "chapter_id": 3391, "verse_number": "४२", "content_sanskrit": "वृतो राजन् वृणीष्वेमां महिषी नहुषास्तु ते ।\nस्वयं ग्रहे महान् दोषो ब्राह्मण्या वर्णसङ्करात् ।\nगृहाणेमां मया दत्तां महिषीं नहुषात्मज \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2110604, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2110605, "chapter_id": 3391, "verse_number": "४३", "content_sanskrit": "अधर्मो न स्पृशेदेष महान् मामिह भार्गव ।\nवर्णसङ्करजो ब्रह्मन् भयादेतद् ब्रवीम्यहम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2110606, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2110607, "chapter_id": 3391, "verse_number": "४४", "content_sanskrit": "अधर्मात् त्वां प्रमोक्ष्यामि वरय त्वं यथेप्सितम् ।\nतस्मात् विवाहान्मा भैषीरहं पापं नुदामि ते \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2110608, "chapter_id": 3391, "verse_number": "४५", "content_sanskrit": "वहस्व भार्यां धर्मेण देवयानीं सुमध्यमाम् ।\nअनया सह सम्प्रीतिमतुलां त्वमवाप्नुहि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2110609, "chapter_id": 3391, "verse_number": "४६", "content_sanskrit": "इयं कुमारी शर्मिष्ठा दुहिता वृषपर्वणः ।\nतां पूजयेथा राजेन्द्र मा चैनां शयने ह्वय\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2110610, "chapter_id": 3391, "verse_number": "४७", "content_sanskrit": "रहस्येनां समाहूय न वदेर्न च संस्पृशेः ।\nवहस्व भार्यां भद्रं ते यथा काममवाप्नुहि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2110611, "chapter_id": 3391, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2110612, "chapter_id": 3391, "verse_number": "४८", "content_sanskrit": "तथेत्युक्त्वा ययातिस्तु तत् सर्वमकरोत् प्रभुः ।\nविवाहं विधिवत् कृत्वा प्रदक्षिणमथाकरोत् ।\nययातिः स्वपुरं यायादनुज्ञातो महात्मना\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2110613, "chapter_id": 3391, "verse_number": "१८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि सप्ततितमोऽध्यायः ॥७०॥ ॥ सम्भवर्पणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]