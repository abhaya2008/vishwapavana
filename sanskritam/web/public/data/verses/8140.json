[{"id": 35000622, "chapter_id": 8140, "verse_number": "3.623", "content_sanskrit": "वडवामुखं पातालं वैरोचननिकेतनम् । तथाधोभुवनं प्रोक्तं नागलोको रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 35000623, "chapter_id": 8140, "verse_number": "3.624", "content_sanskrit": "निम्नमगाधो गर्तः श्वभ्रं शुषिरं वपा बिलं विवरम् । अन्तरमवटु च्छिद्रं निर्व्यथनं रन्ध्ररोक्कुहरदराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 35000624, "chapter_id": 8140, "verse_number": "3.625", "content_sanskrit": "निरयो दुर्गतिश्चैव नरकः परिकीर्तितः । नारका जन्तवः प्रेता यात्याश्चैवातिवाहिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 35000625, "chapter_id": 8140, "verse_number": "3.626", "content_sanskrit": "यातना कारणा प्रोक्ता कारा बन्धनमुच्यते । आबाधा वेदना दुःखमार्तिः पीडा व्यथा तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 35000626, "chapter_id": 8140, "verse_number": "3.627", "content_sanskrit": "वृजिनं दुरितं दुष्कृतमघमंहः किल्विषं तमः कल्कम् । एनः कल्मषमशुभं पापं स्यात्पातकं पाप्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 35000627, "chapter_id": 8140, "verse_number": "3.628", "content_sanskrit": "निधनं नाशो मृत्युर्मरणं पञ्चत्वमत्ययः कालः । संस्था स्याद्दिष्टान्तो निमीलनं दीर्घनिद्रा च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 35000628, "chapter_id": 8140, "verse_number": "3.629", "content_sanskrit": "परासुरपसम्पन्नः प्रमीतः संस्थितो मृतः । प्रेतः परेतश्च तथा कुणपः शवमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 35000629, "chapter_id": 8140, "verse_number": "3.630", "content_sanskrit": "कबन्धः कथ्यते रुण्डः क्षतमीर्ममरुर्व्रणः । असृग्घराजिनं चर्म कृत्तिस्त्वक् परिकीर्तिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 35000630, "chapter_id": 8140, "verse_number": "3.631", "content_sanskrit": "पलं जाङ्गलं मांसं पलं पिशितमामिषम् । क्रव्यं तरसमेकार्थं विस्रं स्यादामगन्धिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 35000631, "chapter_id": 8140, "verse_number": "3.632", "content_sanskrit": "क्षतजं लोहितमस्रं रुधिरमसृक् शोणितं च रक्तं स्यात् । अस्थीनि धातुकीकसकुल्यानि भवन्ति तुल्यानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 35000632, "chapter_id": 8140, "verse_number": "3.633", "content_sanskrit": "शरीरस्यास्थि कङ्कालं तथा स्यादस्थिपञ्जरम् । शिरसोऽस्थि करोटिः स्यात्कपालं शकलं च तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 35000633, "chapter_id": 8140, "verse_number": "3.634", "content_sanskrit": "शाखास्थि नलकं प्रोक्तं पृष्ठस्यास्थि कसेरु च । कण्डरा स्यान्महास्नायुः स्नसा स्नायुः शिरा स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 35000634, "chapter_id": 8140, "verse_number": "3.635", "content_sanskrit": "मस्तिष्कं मस्तक्स्नेहो वपा मेदो वसा स्मृता । अन्त्रं पुरीतत्कथितं कालखण्डं यकृन्मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 35000635, "chapter_id": 8140, "verse_number": "3.636", "content_sanskrit": "बुक्कं स्यादग्रमांसं च तिलकं क्लोम कथ्यते । कृमिः कीटस्तु नीलङ्गुः पुलकश्च समः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 35000636, "chapter_id": 8140, "verse_number": "3.637", "content_sanskrit": "उच्यते वर्च उच्चारो वर्चस्कोऽवस्करः शकृत् । गूथं कीटं च विट् विष्ठा पुरीषं शमलं मलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 35000637, "chapter_id": 8140, "verse_number": "3.638", "content_sanskrit": "शुक्रं वीर्यं बलं बीजमिन्द्रियं रेत उच्यते । श्मशानं स्यात्पितृवनं चिता चित्या च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 35000638, "chapter_id": 8140, "verse_number": "3.639", "content_sanskrit": "क्रन्दितं रुदितं प्रोक्तं विलापः परिदेवनम् । अपस्नानं मृतस्नानं निवापः पितृतर्पणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 35000639, "chapter_id": 8140, "verse_number": "3.640", "content_sanskrit": "विषधरदन्दशूकपवनाशनसर्पसरीसृपोरगव्यालभुजगभुजङ्गकुम्भीनसपन्नगनागभोगिनः । अहिफणभृत्पृदाकुकाकोदरकञ्चुकिचक्रिगूढपाद्द्विरसनकाद्रवेयदर्वीकरदृक्श्रुतयो भुजङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 35000640, "chapter_id": 8140, "verse_number": "3.641", "content_sanskrit": "आशीविषो दीर्घपृष्ठः कुण्डली जिह्मगः स्मृतः । फणः फणा फटा प्रोक्ता विषं स्याद्गरलं गरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 35000641, "chapter_id": 8140, "verse_number": "3.642", "content_sanskrit": "अहेः शरीरं भोगः स्यादाशीर्दंष्ट्राभिधीयते । भवेत्तिलित्सो गोनासो वाहसोऽजगरः शयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 35000642, "chapter_id": 8140, "verse_number": "3.643", "content_sanskrit": "अलगर्दो जलव्यालो राजिलो डुण्डुभः स्मृतः । अहीरणी स्याद्द्विमुखो राजसर्पश्च सर्पभुक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 35000643, "chapter_id": 8140, "verse_number": "3.644", "content_sanskrit": "निर्वयनी निर्मोकः कञ्चुक उक्ता भुजङ्गमुक्ता त्वक् । वम्रीकूटं नाकुर्वल्मीको वामलूरश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 35000644, "chapter_id": 8140, "verse_number": "3.645", "content_sanskrit": "उपजिह्वोपदीका च वम्री स्यादुपदेहिका । अलं वृश्चिकलाङ्गूलं द्रुत आलिश्च वृश्चिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 35000645, "chapter_id": 8140, "verse_number": "3.646", "content_sanskrit": "ब्रह्मपुत्रः शौल्किकेयो दारदश्च प्रदीपनः । रसः सौराष्ट्रिकः क्ष्वेडस्तीक्ष्णश्च विषमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 35000646, "chapter_id": 8140, "verse_number": "3.647", "content_sanskrit": "शृङ्गिको वत्सनाभश्च कालकूटो हलाहलः । काकोलो विस्फुलिङ्गश्च तद्भेदाः स्युरनेकधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 35000647, "chapter_id": 8140, "verse_number": "3.648", "content_sanskrit": "आपस्तोयं घनरसपयः पुष्करं मेघपुष्पं कं पानीयं सलिलमुदकं वारि वाः शम्बरं च । अर्णः पाथः कुशजलवनं क्षीरमम्भोऽम्बु नीरं प्रोक्तं प्राज्ञैर्भुवनममृतं जीवनीयं दकं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 35000648, "chapter_id": 8140, "verse_number": "3.649", "content_sanskrit": "अतलस्पर्शमगाधं गम्भीरं स्याद् गभीरमस्थागम् । नावा तार्यं नाव्यं द्राग्भृतकं तत्क्षणोद्धृतं तोयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 35000649, "chapter_id": 8140, "verse_number": "3.650", "content_sanskrit": "प्रालेयमवश्यायस्तुहिनं शिशिरं हिमं तुषारं च । मिहिका स्यान्नीहारो हिमसंघातो हिमानी च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 35000650, "chapter_id": 8140, "verse_number": "3.651", "content_sanskrit": "रोमाञ्चः पुलकः स्यात्कण्टकमुद्भुषणमुल्लकसनं च । रोमोद्गमरोमविकाररोमहर्षाः समानार्थाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 35000651, "chapter_id": 8140, "verse_number": "3.652", "content_sanskrit": "रत्नाकरः सरस्वानुदधिरुदन्वान्सरित्पतिरकूपारः । पारावारस्तोयनिधिरर्णवजलराशिसागरसमुद्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 35000652, "chapter_id": 8140, "verse_number": "3.653", "content_sanskrit": "वीची भङ्गस्तरङ्गः स्यात्तन्महत्त्वे च कथ्यते । ऊर्मिरुत्कलिकोल्लोलः कल्लोलो लहरी तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 35000653, "chapter_id": 8140, "verse_number": "3.654", "content_sanskrit": "मर्यादा कूलदेशोऽस्य वेला वृद्धिश्च वारिणः । वेलावनं तु विज्ञेयमुपकण्ठेऽस्य यद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 35000654, "chapter_id": 8140, "verse_number": "3.655", "content_sanskrit": "सांयात्रिकः पोतवणिक् पोतः प्रवहणं स्मृतम् । कूपको गुणवृक्षः स्यान्निर्यामः कर्णधारकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 35000655, "chapter_id": 8140, "verse_number": "3.656", "content_sanskrit": "अन्तर्जलचरं सत्त्वं क्रूरं यादोऽभिधीयते । अवहारः स्मृतो ग्राहः कुम्भीरो नक्र उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 35000656, "chapter_id": 8140, "verse_number": "3.657", "content_sanskrit": "कच्छपः कमठः कूर्मस्तद्भार्या च डुली स्मृता । वैसारिणो विसारः पृथुरोमा जलचरो झषो मत्स्यः । तिमिरनिमिषश्च मीनः शकली शल्की च विज्ञेयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 35000657, "chapter_id": 8140, "verse_number": "3.658", "content_sanskrit": "सहस्रदंष्ट्रः पाठीनः प्रोष्ठी च शफरी स्मृता । नलमीनश्चिलिचिमः कुलीरः कर्कटो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 35000658, "chapter_id": 8140, "verse_number": "3.659", "content_sanskrit": "शालः शकुलः कुलिशो राजीवो रोहितश्च पल्वकः । शृङ्गीमद्गुरवागुसनन्द्यावर्तदयो महामत्स्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 35000659, "chapter_id": 8140, "verse_number": "3.660", "content_sanskrit": "मत्स्यविशेषो मकरः करिमकरो भवति तद्विशेषस्तु । चीरिल्लितिमितिमिङ्गिलगिलादयो महामत्स्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 35000660, "chapter_id": 8140, "verse_number": "3.661", "content_sanskrit": "क्षुद्राण्डो मत्स्यसंघातः पोताधानं च कथ्यते । गण्डूपदः किञ्चुलको जलौकाः स्युर्जलौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 35000661, "chapter_id": 8140, "verse_number": "3.662", "content_sanskrit": "मण्डूकः प्लवको भेकः शालूरो दर्दु रो हरिः । प्लवङ्गमः प्लवगः स्याद्वर्षाभूस्तद्वधूः स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 35000662, "chapter_id": 8140, "verse_number": "3.663", "content_sanskrit": "यावन्तो दृश्यन्ते नरकरितुरगादयः स्थले जीवाः । तावन्तः सलिलेष्वपि जलपूर्वास्ते तु विज्ञेयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 35000663, "chapter_id": 8140, "verse_number": "3.664", "content_sanskrit": "कम्बुः शङ्खः क्षुल्लकाः क्षुद्रशङ्खाः शम्बूकास्ते स्युः कपर्दो वराटः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 35000664, "chapter_id": 8140, "verse_number": "3.665", "content_sanskrit": "सिन्धुः स्रवन्ती तटिनी तरङ्गिणी नदी धुनी निर्झरिणी च निम्नगा । कूलङ्कषा शैवलिनी सरस्वती समुद्रकान्ता ह्रादिनी तथापगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 35000665, "chapter_id": 8140, "verse_number": "3.666", "content_sanskrit": "स्रोत: स्रोतस्विनी कर्षूः कुल्या द्वीपवती सरित् । रोधो वप्रस्तु विज्ञेयो भिद्य उद्यो नदः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 35000666, "chapter_id": 8140, "verse_number": "3.667", "content_sanskrit": "तीरं कूलं तटं कच्छः प्रपातो रोध उच्यते । अर्वाकूलमपारं स्यात्परं पारमिति स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 35000667, "chapter_id": 8140, "verse_number": "3.668", "content_sanskrit": "पात्रं तु कूलयोर्मध्यमावर्तः पयसां भ्रमः । पूरः स्यादम्भसो वृद्धिः फेनो डिण्डीर उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 35000668, "chapter_id": 8140, "verse_number": "3.669", "content_sanskrit": "ओघः प्रवाहो वेणी च धारा स्रोतो रयः स्मृतः । सम्भेदः सङ्गमो नद्योः संवेद्यश्च निगद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 35000669, "chapter_id": 8140, "verse_number": "3.670", "content_sanskrit": "सैकतं पुलिनं द्वीपं सिकता वालुका स्मृता । मध्ये द्वीपमन्तरीपं ह्रदस्तोयाशयो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 35000670, "chapter_id": 8140, "verse_number": "3.671", "content_sanskrit": "चक्राणि पुटभेदाः स्युः सेतुर्वरण उच्यते । आतरस्तरपण्यं च तल्पं स्यादुडुपः प्लवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}, {"id": 35000671, "chapter_id": 8140, "verse_number": "3.672", "content_sanskrit": "तरीनौर्मज्झिनी बेडा नौदण्डः क्षेपणी स्मृता । अरित्रं कोटिपात्रं स्यात्पुलिन्दो मङ्ग उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50, "avatarnika": ""}, {"id": 35000672, "chapter_id": 8140, "verse_number": "3.673", "content_sanskrit": "भागीरथी सुरसरिद्विष्णुपदी जाह्नवी तथा गङ्गा । मन्दाकिनी त्रिपथगा सरिद्वरा त्रिदशदीर्घिका प्रोक्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51, "avatarnika": ""}, {"id": 35000673, "chapter_id": 8140, "verse_number": "3.674", "content_sanskrit": "गोदावरी च गोदा कालिन्दी दिनकरात्मजा यमुना । शोणो हिरण्यबाहुर्मेकलकन्या च नर्मदा रेवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52, "avatarnika": ""}, {"id": 35000674, "chapter_id": 8140, "verse_number": "3.675", "content_sanskrit": "वेशन्तः पल्वलं तल्लं कासारः सरसी सरः । आखातो देवखातः स्यात्खाता पुष्करिणी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53, "avatarnika": ""}, {"id": 35000675, "chapter_id": 8140, "verse_number": "3.676", "content_sanskrit": "आधारश्च तडागं स्यादाली पाली च कथ्यते । परिखा दीर्घिका प्रोक्ता खाता या परितः पुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54, "avatarnika": ""}, {"id": 35000676, "chapter_id": 8140, "verse_number": "3.677", "content_sanskrit": "परीवाहो जलोच्छ्वास उत्सः प्रस्रवणं स्मृतम् । विप्रुषो विन्दवः प्रोक्ताः पृषतः पृषतास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55, "avatarnika": ""}, {"id": 35000677, "chapter_id": 8140, "verse_number": "3.678", "content_sanskrit": "पिच्छिलं स्याद्द्विजपिलं पङ्कः शादो निषद्गरः । जम्बालः कर्दमः प्रोक्तो बुधैरिचिकिलस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56, "avatarnika": ""}, {"id": 35000678, "chapter_id": 8140, "verse_number": "3.679", "content_sanskrit": "सहस्रपत्रं शतपत्रमम्बुजं कुशेशयं तामरसं सरोरुहम् । विसप्रसूनं कमलं महोत्पलं सरोजमब्जं नलिनं च पुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57, "avatarnika": ""}, {"id": 35000679, "chapter_id": 8140, "verse_number": "3.680", "content_sanskrit": "राजीवमरविन्दं च पद्मं पङ्कजमिष्यते । रक्तं कोकनदं प्रोक्तं पुण्डरीकं सिताम्बुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58, "avatarnika": ""}, {"id": 35000680, "chapter_id": 8140, "verse_number": "3.681", "content_sanskrit": "सौगन्धिकं च कह्लारं स्यादिन्दीवरमुत्पलम् । नीलोत्पलं कुवलयं कैरवं कुमुदं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59, "avatarnika": ""}, {"id": 35000681, "chapter_id": 8140, "verse_number": "3.682", "content_sanskrit": "कर्णिका बीजकोशः स्यात्किञ्जल्कं केसरं स्मृतम् । मृणालं स्याद्विसं कन्दो विसिनी नलिनी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60, "avatarnika": ""}, {"id": 35000682, "chapter_id": 8140, "verse_number": "3.683", "content_sanskrit": "कुमुद्वती कुमुदिनी बुधैः कैरविणी स्मृता । शेवालं शैवलं प्रोक्तं जलशूकं च नीलिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61, "avatarnika": ""}, {"id": 35000683, "chapter_id": 8140, "verse_number": "3.684", "content_sanskrit": "अन्धुः कूपः प्रधिर्नेमिश्चुरी चुण्डी च चूतकः । निपानमुदपानं च वाप्याहावश्च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62, "avatarnika": ""}, {"id": 35000684, "chapter_id": 8140, "verse_number": "3.685", "content_sanskrit": "उद्घाटकं घटीयन्त्रं पादावर्तोऽरघट्टकः । पानं तु सारणिः प्रोक्ता प्रणाली जलपद्धतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63, "avatarnika": ""}]