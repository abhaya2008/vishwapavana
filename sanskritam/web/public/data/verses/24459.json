[{"id": 7004459000, "chapter_id": 24459, "verse_number": "५-३-१५३-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nतस्यैवानन्तरं चान्यद्रवितीर्थमनुत्तमम् ।\nयस्य संदर्शनादेव मुच्यन्ते पातकैर्नराः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004459001, "chapter_id": 24459, "verse_number": "५-३-१५३-२", "content_sanskrit": "रवितीर्थे तु यः स्नात्वा नरः पश्यति भास्करम् ।\nतस्य यत्फलमुद्दिष्टं स्वयं देवेन तच्छृणु॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004459002, "chapter_id": 24459, "verse_number": "५-३-१५३-३", "content_sanskrit": "नान्धो न मूको बधिरः कुले भवति कश्चन ।\nकुरूपः कुनखी वापि तस्य जन्मानि षोडश॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004459003, "chapter_id": 24459, "verse_number": "५-३-१५३-४", "content_sanskrit": "दद्रुचित्रककुष्ठानि मण्डलानि विचर्चिका ।\nनश्यन्ति देवभक्तस्य षण्मासान्नात्र संशयः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004459004, "chapter_id": 24459, "verse_number": "५-३-१५३-५", "content_sanskrit": "चरितं तस्य देवस्य पुराणे यच्छ्रुतं मया ।\nन तत्कथयितुं शक्यं संक्षेपेण नृपोत्तम॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004459005, "chapter_id": 24459, "verse_number": "५-३-१५३-६", "content_sanskrit": "तत्र तीर्थे तु यद्दानं रविमुद्दिश्य दीयते ।\nविधिना पात्रविप्राय तस्यान्तो नास्ति कर्हिचित्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004459006, "chapter_id": 24459, "verse_number": "५-३-१५३-७", "content_sanskrit": "अयने विषुवे चैव चन्द्रसूर्यग्रहे तथा ।\nरवितीर्थे प्रदत्तानां दानानां फलमुत्तमम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004459007, "chapter_id": 24459, "verse_number": "५-३-१५३-८", "content_sanskrit": "संक्रान्तौ यानि दानानि हव्यकव्यानि भारत ।\nअपामिव समुद्रस्य तेषामन्तो न लभ्यते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004459008, "chapter_id": 24459, "verse_number": "५-३-१५३-९", "content_sanskrit": "येन येन यदा दत्तं येन येन यदा हुतम् ।\nतस्य तस्य तदा काले सविता प्रतिदायकः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004459009, "chapter_id": 24459, "verse_number": "५-३-१५३-१०", "content_sanskrit": "सप्त जन्मानि तान्येव ददात्यर्कः पुनः पुनः ।\nशतमिन्दुक्षये दानं सहस्रं तु दिनक्षये॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004459010, "chapter_id": 24459, "verse_number": "५-३-१५३-११", "content_sanskrit": "संक्रान्तौ शतसाहस्रं व्यतीपाते त्वनन्तकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004459011, "chapter_id": 24459, "verse_number": "५-३-१५३-१२", "content_sanskrit": "युधिष्ठिर उवाच ।\nरवितीर्थं कथं तात पुण्यात्पुण्यतरं स्मृतम् ।\nविस्तरेण ममाख्याहि श्रवणौ मम लम्पटौ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004459012, "chapter_id": 24459, "verse_number": "५-३-१५३-१३", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nशृणुष्वावहितो भूत्वा ह्यादित्येश्वरमुत्तमम् ।\nउत्तरे नर्मदाकूले सर्वव्याधिविनाशनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004459013, "chapter_id": 24459, "verse_number": "५-३-१५३-१४", "content_sanskrit": "पुरा कृतयुगस्यादौ जाबालिर्ब्राह्मणोऽभवत् ।\nवसिष्ठान्वयसम्भूतो वेदशास्त्रार्थपारगः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004459014, "chapter_id": 24459, "verse_number": "५-३-१५३-१५", "content_sanskrit": "पतिव्रता साधुशीला तस्य भार्या मनस्विनी ।\nऋतुकाले तु सा गत्वा भर्तारमिदमब्रवीत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004459015, "chapter_id": 24459, "verse_number": "५-३-१५३-१६", "content_sanskrit": "वर्तते ऋतुकालो मे भर्तारं त्वामुपस्थिता ।\nभज मां प्रीतिसंयुक्तः पुत्रकामां तु कामिनीम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004459016, "chapter_id": 24459, "verse_number": "५-३-१५३-१७", "content_sanskrit": "एवमुक्तो द्विजः प्राह प्रियेऽद्याहं व्रतान्वितः ।\nगच्छेदानीं वरारोहे दास्य ऋत्वन्तरे पुनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004459017, "chapter_id": 24459, "verse_number": "५-३-१५३-१८", "content_sanskrit": "पुनर्द्वितीये सम्प्राप्ते ऋतुकालेऽप्युपस्थिता ।\nपुनः सा छन्दिता तेन व्रतस्थोऽद्येति भारत॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004459018, "chapter_id": 24459, "verse_number": "५-३-१५३-१९", "content_sanskrit": "इत्थं वा बहुशस्तेन छन्दिता च पुनः पुनः ।\nनिराशा चाभवत्तत्र भर्तारं प्रति भामिनी॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004459019, "chapter_id": 24459, "verse_number": "५-३-१५३-२०", "content_sanskrit": "दुःखेन महताविष्टा विधायानशनं मृता ।\nतेन भ्रूणहतेनैव पापेन सहसा द्विजः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004459020, "chapter_id": 24459, "verse_number": "५-३-१५३-२१", "content_sanskrit": "शीर्णघ्राणाङ्घ्रिरभवत्तपः सर्वं ननाश च ।\nदृष्ट्वात्मानं स कुष्ठेन व्याप्तं ब्राह्मणसत्तमः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004459021, "chapter_id": 24459, "verse_number": "५-३-१५३-२२", "content_sanskrit": "विषादं परमं गत्वा नर्मदातटमाश्रितः ।\nअपृच्छद्भास्करं तीर्थं द्विजेभ्यो द्विजसत्तमः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004459022, "chapter_id": 24459, "verse_number": "५-३-१५३-२३", "content_sanskrit": "आरोग्यं भास्करादिच्छेदिति संचिन्त्य चेतसि ।\nकुतस्तद्भास्करं तीर्थं भो द्विजाः कथ्यतां मम॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004459023, "chapter_id": 24459, "verse_number": "५-३-१५३-२४", "content_sanskrit": "तपस्तप्याम्यहं गत्वा तस्मिंस्तीर्थे सुभावितः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004459024, "chapter_id": 24459, "verse_number": "५-३-१५३-२५", "content_sanskrit": "द्विजा ऊचुः ।\nरेवाया उत्तरे कूले आदित्येश्वरनामतः ।\nविद्यते भास्करं तीर्थं सर्वव्याधिविनाशनम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004459025, "chapter_id": 24459, "verse_number": "५-३-१५३-२६", "content_sanskrit": "तत्र याह्यविचारेण गन्तुं चेच्छक्यते त्वया ।\nएवमुक्तो द्विजैर्विप्रो गन्तुं तत्र प्रचक्रमे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004459026, "chapter_id": 24459, "verse_number": "५-३-१५३-२७", "content_sanskrit": "व्याधिना परिभूतस्तु घोरेण प्राणहारिणा ।\nयदा गन्तुं न शक्नोति तदा तेन विचिन्तितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004459027, "chapter_id": 24459, "verse_number": "५-३-१५३-२८", "content_sanskrit": "सामर्थ्यं ब्राह्मणानां हि विद्यते भुवनत्रये ।\nलिङ्गपातः कृतो विप्रैर्देवदेवस्य शूलिनः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004459028, "chapter_id": 24459, "verse_number": "५-३-१५३-२९", "content_sanskrit": "समुद्रः शोषितो विप्रैर्विन्ध्यश्चापि निवारितः ।\nअहमप्यत्र संस्थस्तु ह्यानयिष्यामि भास्करम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004459029, "chapter_id": 24459, "verse_number": "५-३-१५३-३०", "content_sanskrit": "तपोबलेन महता ह्यादित्येश्वरसंज्ञितम् ।\nइति निश्चित्य मनसा ह्युग्रे तपसि संस्थितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004459030, "chapter_id": 24459, "verse_number": "५-३-१५३-३१", "content_sanskrit": "वायुभक्षो निराहारो ग्रीष्मे पञ्चाग्निमध्यगः ।\nशिशिरे तोयमध्यस्थो वर्षास्वप्रावृताकृतिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004459031, "chapter_id": 24459, "verse_number": "५-३-१५३-३२", "content_sanskrit": "साग्रे वर्षशते पूर्णे रविस्तुष्टोऽब्रवीदिदम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004459032, "chapter_id": 24459, "verse_number": "५-३-१५३-३३", "content_sanskrit": "सूर्य उवाच ।\nवरं वरय भद्रं ते किं ते मनसि वाञ्छितम् ।\nअदेयमपि दास्यामि ब्रूहि मां त्वं चिरं कृथाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004459033, "chapter_id": 24459, "verse_number": "५-३-१५३-३४", "content_sanskrit": "किमसाध्यं हि ते विप्र इदानीं तपसि स्थितः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004459034, "chapter_id": 24459, "verse_number": "५-३-१५३-३५", "content_sanskrit": "जाबालिरुवाच ।\nयदि तुष्टोऽसि देवेश यदि देयो वरो मम ।\nमम प्रतिज्ञा देवेश ह्यादित्येश्वरदर्शने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004459035, "chapter_id": 24459, "verse_number": "५-३-१५३-३६", "content_sanskrit": "कृता तां पारितुं देव न शक्तो व्याधिना वृतः ।\nशुक्लतीर्थेऽत्र तिष्ठ त्वमादित्येश्वरमूर्तिधृक्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004459036, "chapter_id": 24459, "verse_number": "५-३-१५३-३७", "content_sanskrit": "एवमुक्ते तु देवेशो बहुरूपो दिवाकरः ।\nउत्तरे नर्मदाकूले क्षणादेव व्यदृश्यत॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004459037, "chapter_id": 24459, "verse_number": "५-३-१५३-३८", "content_sanskrit": "तदाप्रभृति भूपाल तद्धि तीर्थं प्रचक्षते ।\nसर्वपापहरं प्रोक्तं सर्वदुःखविनाशनम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004459038, "chapter_id": 24459, "verse_number": "५-३-१५३-३९", "content_sanskrit": "यस्तु संवत्सरं पूर्णं नित्यमादित्यवासरे ।\nस्नात्वा प्रदक्षिणाः सप्त दत्त्वा पश्यति भास्करम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004459039, "chapter_id": 24459, "verse_number": "५-३-१५३-४०", "content_sanskrit": "यत्फलं लभते तेन तच्छृणुष्व मयोदितम् ।\nप्रसुप्तं मण्डलानीह दद्रुकुष्ठविचर्चिकाः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004459040, "chapter_id": 24459, "verse_number": "५-३-१५३-४१", "content_sanskrit": "नश्यन्ति सत्वरं राजंस्तूलराशिरिवानले ।\nधनपुत्रकलत्राणां पूरयेद्वत्सरत्रयात्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004459041, "chapter_id": 24459, "verse_number": "५-३-१५३-४२", "content_sanskrit": "यस्तु श्राद्धप्रदस्तत्र पित्ःनुद्दिश्य संक्रमे ।\nतृप्यन्ति पितरस्तस्य पितृदेवो हि भास्करः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]