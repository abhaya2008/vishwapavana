[{"id": 7002502000, "chapter_id": 22502, "verse_number": "१-१६४-१", "content_sanskrit": "शतानीक उवाच ।\nपुनस्त्वं देवदेवस्य भास्करस्य महौजसः ।\nपूजने यत्फलं प्रोक्तं तन्मे ब्रूहि द्विजोत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002502001, "chapter_id": 22502, "verse_number": "१-१६४-२", "content_sanskrit": "सुमंतुरुवाच ।\nशृणु त्वं हि महाराज सर्वदं लोकपूजितम् ।\nब्रह्मेशोपेंद्रदेवानां त्रयाणामपि भारत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002502002, "chapter_id": 22502, "verse_number": "१-१६४-३", "content_sanskrit": "सुखासीनं सुरज्येष्ठं मनोवत्यां चतुर्मुखम् ।\nप्रणम्य शिरसा भूमौ विष्ण्वीशौ वाक्यमूचतुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002502003, "chapter_id": 22502, "verse_number": "१-१६४-४", "content_sanskrit": "य एष भगवान्देवः सहस्रकिरणो रविः ।\nअस्य यत्पूजने पुण्यं प्राप्यते तद्वदस्व नौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002502004, "chapter_id": 22502, "verse_number": "१-१६४-५", "content_sanskrit": "ब्रह्मोवाच ।\nसाधु साधु जगन्नाथ साधु पृष्टोऽस्मि वामिह ।\nतस्माच्छृणुतमेकाग्रौ गदतो निखिलं मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002502005, "chapter_id": 22502, "verse_number": "१-१६४-६", "content_sanskrit": "स्वयमुत्पाद्य पुष्णाणि यः सूर्यं पूजयेत्स्वयम् ।\nतानि साक्षात्प्रगृह्णाति तद्भक्त्या सततं रविः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002502006, "chapter_id": 22502, "verse_number": "१-१६४-७", "content_sanskrit": "यस्त्वारामं रवेः कुर्यादाम्रबिल्वादिशोभितम् ।\nजातीविजयराजार्ककरवीरैः सकुंकुमैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002502007, "chapter_id": 22502, "verse_number": "१-१६४-८", "content_sanskrit": "पुन्नागनागबकुलैरशोकतिलचंपकैः ।\nअगस्तिकदलीखंडैस्तस्य पुण्यफलं शृणु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002502008, "chapter_id": 22502, "verse_number": "१-१६४-९", "content_sanskrit": "यावद्धि पत्रं कुसुमं बीजं सूतफलानि च ।\nतावद्वर्षसहस्राणि सूरलोके महीयते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002502009, "chapter_id": 22502, "verse_number": "१-१६४-१०", "content_sanskrit": "सघृतं गुग्गुलं दद्याद्राजन्वा कंदुरुं तथा ।\nचतुर्वेदिगृहे जन्म प्राप्नोति सततं सुखी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002502010, "chapter_id": 22502, "verse_number": "१-१६४-११", "content_sanskrit": "कृष्णागुरुं च कर्पूरधूपं दद्याद्दिवाकरे ।\nनैरंतर्येण यस्तस्य राजन्पुण्यफलं शृणु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002502011, "chapter_id": 22502, "verse_number": "१-१६४-१२", "content_sanskrit": "कल्पकोटिसहस्राणि कल्पकोटिशतानि च ।\nभुक्त्वा सूर्यपुरे भोगांस्तस्यांते क्ष्माधिपो भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002502012, "chapter_id": 22502, "verse_number": "१-१६४-१३", "content_sanskrit": "गुग्गुलुं घृतसंयु्क्तं यक्षो गृह्णाति शब्दकृत् ।\nयक्षाह्वयस्य दानेन तस्य लोके महीयते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002502013, "chapter_id": 22502, "verse_number": "१-१६४-१४", "content_sanskrit": "कृष्णांशौ कृष्ण सप्तम्यां यः साज्यं गुग्गुलुं दहेत् ।\nस चासौ सौरमासाद्य वर्षाणां च दशार्बुदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002502014, "chapter_id": 22502, "verse_number": "१-१६४-१५", "content_sanskrit": "देवदारुं नमेरुं च श्रीवासं कुंदुरुं तथा ।\nश्रीफलं चाज्यसंयुक्तं दग्ध्वाश्रयमवाप्नुयात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002502015, "chapter_id": 22502, "verse_number": "१-१६४-१६", "content_sanskrit": "एवं सौगधिकं रूपं षट्सहस्रगुणोत्तरम् ।\nअगुरुं दशसाहस्रं सघृतं द्विगुणं भवेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002502016, "chapter_id": 22502, "verse_number": "१-१६४-१७", "content_sanskrit": "अनंतफलदं देवं सदा कुंदुरुकामुकम् ।\nद्विसहस्रपलानां तु महिषाक्षस्य गुग्गुलोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002502017, "chapter_id": 22502, "verse_number": "१-१६४-१८", "content_sanskrit": "दग्ध्वार्धमविमिश्रस्य सूर्यतुल्यः प्रजायते ।\nशोधयेत्पापसंयुक्तं पुरुषं नात्र संशयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002502018, "chapter_id": 22502, "verse_number": "१-१६४-१९", "content_sanskrit": "कृष्णागुरुभवं धूपं तुषाग्निरिव कांचनम् ।\nयोंतःपुरगृहं गन्धैः सुगन्धैः प्रविलेपयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002502019, "chapter_id": 22502, "verse_number": "१-१६४-२०", "content_sanskrit": "कपाटद्वारकुड्यादितिर्यगूर्ध्वं सवेदिकम् ।\nवासयेत्पुष्पमालाभिर्धूपैश्चापि सुगंधिभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002502020, "chapter_id": 22502, "verse_number": "१-१६४-२१", "content_sanskrit": "तस्य पुण्यं यथावत्तु युवयोर्वच्मि कृत्स्नशः ।\nआपूरयन्दिशः सर्वा नानागंध समन्वितैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002502021, "chapter_id": 22502, "verse_number": "१-१६४-२२", "content_sanskrit": "कल्पकोटिशतं दिव्यं तेजसा वह्निसन्निभः ।\nशक्रवत्प्रज्वलन्देवः सूर्यलोके महीयते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002502022, "chapter_id": 22502, "verse_number": "१-१६४-२३", "content_sanskrit": "तस्यांते धर्मशेषेण त्रैलोक्या धिपतिर्भवेत् ।\nशतावृतं तु यः कुर्यादेवं गन्धैर्भगालयम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002502023, "chapter_id": 22502, "verse_number": "१-१६४-२४", "content_sanskrit": "स सर्वशर्मसंयुक्तः सूर्यतुल्यपराक्रमः ।\nसूर्यलोके वसेद्देवो युवाभ्यां संप्रपू जितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002502024, "chapter_id": 22502, "verse_number": "१-१६४-२५", "content_sanskrit": "तद्वच्छुक्लैश्च संवीतं पट्टसूत्रैर्विनिर्मितम् ।\nदत्त्वोपवीतं सूर्याय भवेद्वेदांगपारगः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002502025, "chapter_id": 22502, "verse_number": "१-१६४-२६", "content_sanskrit": "वासांसि सुविचित्राणि सूरलोके महीयते ।\nत्रुटिमात्रं तु यो दद्यादूर्णावस्त्रं सपंकजम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002502026, "chapter_id": 22502, "verse_number": "१-१६४-२७", "content_sanskrit": "भास्करस्योत्तमांगेषु तस्य पुण्यं ब्रवीम्यहम् ।\nइन्द्रस्यार्धासने तिष्ठेद्यावद्रिन्द्राश्चतुर्दश ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002502027, "chapter_id": 22502, "verse_number": "१-१६४-२८", "content_sanskrit": "एवं वित्तानुसारेण सर्वं ज्ञेयं समासतः ।\nसर्वेषां हेमपात्राणां मुकुटानां च सर्वशः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002502028, "chapter_id": 22502, "verse_number": "१-१६४-२९", "content_sanskrit": "अर्कपत्रपुटं चूर्णं मधुपर्णसमन्वितम् ।\nयो निवेदयतेऽर्काय सोऽश्वमेधफलं लभेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002502029, "chapter_id": 22502, "verse_number": "१-१६४-३०", "content_sanskrit": "शालितंडुलप्रस्थस्य कुर्यादन्नं सुसंस्कतम् ।\nसूर्याय च चरुं दत्त्वा सप्तम्यां तु विशेषतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002502030, "chapter_id": 22502, "verse_number": "१-१६४-३१", "content_sanskrit": "संयावं कृशरं पूपं पायसं यावकं तथा ।\nदध्योदनरसालान्नमोदकान्गुडपूपकान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002502031, "chapter_id": 22502, "verse_number": "१-१६४-३२", "content_sanskrit": "यावंतस्तण्डुलास्तस्मिन्नैवेद्ये परिसंख्यया ।\nतावद्वर्ष सहस्राणि सूरलोके महीयते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002502032, "chapter_id": 22502, "verse_number": "१-१६४-३३", "content_sanskrit": "गुडखंडकृतानां च भक्ष्याणां विनिवेदने ।\nघृतेन प्लावितानां च फलं शतगुणं लभेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002502033, "chapter_id": 22502, "verse_number": "१-१६४-३४", "content_sanskrit": "रसाल खाद्यकाद्यानां भक्ष्याणां फलमिष्यते ।\nतदर्धं सलिलस्यापि वासितस्य निवेदयेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002502034, "chapter_id": 22502, "verse_number": "१-१६४-३५", "content_sanskrit": "यथाकालोपलब्धानि भक्ष्याणि विविधानि च ।\nनिवेद्यार्काय परमं स्थानं प्राप्नोति पूजनात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002502035, "chapter_id": 22502, "verse_number": "१-१६४-३६", "content_sanskrit": "प्रज्वाल्य घृतदीपं तु भास्करस्यालये शुभम् ।\nआग्नेयं यानमारुह्य गच्छेत्सौमनसं पुरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002502036, "chapter_id": 22502, "verse_number": "१-१६४-३७", "content_sanskrit": "यः कुर्यात्कार्तिके मासि शोभनां दीपमालिकाम् ।\nसप्तम्यामथ षष्ठ्यां वामावास्यायामथापि वा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002502037, "chapter_id": 22502, "verse_number": "१-१६४-३८", "content_sanskrit": "भास्करायुतसंकाशस्तेजसा भासयन्दिशः ।\nदिव्याभरणसंपन्नः कुलमुद्धृत्य सर्वशः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002502038, "chapter_id": 22502, "verse_number": "१-१६४-३९", "content_sanskrit": "यावत्प्रदीपसंख्यानं घृतेनापूर्य बोधितम् ।\nतावद्वर्षसहस्राणि सूर्यलोके महीयते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002502039, "chapter_id": 22502, "verse_number": "१-१६४-४०", "content_sanskrit": "दीपवृक्षमथोद्बोध्य पर्वस्वायतनेषु वै ।\nपूर्वस्माद्द्विगुणं पुण्यं लभते नात्र संशयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002502040, "chapter_id": 22502, "verse_number": "१-१६४-४१", "content_sanskrit": "दीपवृक्षं समुद्बोध्य भास्करायतनेषु भोः ।\nसर्वलोहमयं वीर रविलोके महीयते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002502041, "chapter_id": 22502, "verse_number": "१-१६४-४२", "content_sanskrit": "शिरसा धारयेद्दीपं भास्करस्याग्रतो निशि ।\nललाटे चैव हस्ताभ्यां समुद्युक्तस्तथो रसि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002502042, "chapter_id": 22502, "verse_number": "१-१६४-४३", "content_sanskrit": "भास्करायुतसंकाशो विमानैरर्कसन्निभैः ।\nकल्पायुतशतं चैव सूर्यलोके महीयते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002502043, "chapter_id": 22502, "verse_number": "१-१६४-४४", "content_sanskrit": "अन्नदाता तु यो वीर वीरलोके मही यते ।\nभास्करस्याग्रतो दत्त्वा दर्पणं निर्मलं शुभम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002502044, "chapter_id": 22502, "verse_number": "१-१६४-४५", "content_sanskrit": "पर्यंके शोभितं कृत्वा श्वेतमाल्यैः सचन्दनैः ।\nवृकार्कनिर्मलः श्रीमान्दिव्याभरण रूपधृक् ।\nकल्पायुतसहस्राणि सूरलोके महीयते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002502045, "chapter_id": 22502, "verse_number": "१-१६४-४६", "content_sanskrit": "कृत्वा प्रदक्षिणं भक्त्या श्रद्दधानो रवेर्नरः ।\nअश्वमेधसहस्रस्य सुखेन लभते फलम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002502046, "chapter_id": 22502, "verse_number": "१-१६४-४७", "content_sanskrit": "कृत्वा प्रदक्षिणं यस्तु नमस्कारं प्रयोजयेत् ।\nराजसूयाश्वमेधाभ्यां सकलं विन्दते फलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002502047, "chapter_id": 22502, "verse_number": "१-१६४-४८", "content_sanskrit": "नमस्कारः स्मृतो यज्ञः सर्वयज्ञो त्तमोत्तमः ।\nनमस्कृत्वा सहस्रांशुमश्वमेधफलं लभेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002502048, "chapter_id": 22502, "verse_number": "१-१६४-४९", "content_sanskrit": "प्रणम्य दंडवद्भूमौ नमस्कारेण योऽर्चयेत् ।\nस यां गतिमवाप्नोति न तां क्रतु शतैरपि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002502049, "chapter_id": 22502, "verse_number": "१-१६४-५०", "content_sanskrit": "सर्वयज्ञोपवासेपु सर्वतीर्थेषु यत्फलम् ।\nअभिज्ञाप्योपहारेण पूजया फलमश्नुते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002502050, "chapter_id": 22502, "verse_number": "१-१६४-५१", "content_sanskrit": "श्वेतं महाध्वजं कृत्वा कृत्वा चापं च रंगकम् ।\nकिंकिणीजालनिर्घोषं मयूरच्छत्रभूषितम् ।\nयस्त्वर्यम्णे नरो दद्याच्छ्रद्धया परयान्वितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002502051, "chapter_id": 22502, "verse_number": "१-१६४-५२", "content_sanskrit": "स शतेन विमानानां सर्वदेव नमस्कृतः ।\nमन्वन्तरशतं देव मोदते दिवि देववत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002502052, "chapter_id": 22502, "verse_number": "१-१६४-५३", "content_sanskrit": "ध्वजमालाकुलं कुर्याद्यः प्रांतेषु भगालयम् ।\nमहाध्वजाष्टकं चापि दिग्विदिक्षु निवेदयेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002502053, "chapter_id": 22502, "verse_number": "१-१६४-५४", "content_sanskrit": "स विमानसहस्रेण ध्वजमालाकुलेन तु ।\nकल्पायुतशतं दिव्यं मोदेते दिवि सूरवत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002502054, "chapter_id": 22502, "verse_number": "१-१६४-५५", "content_sanskrit": "शतचन्द्रांशुविमलं मुक्तादामोपशोभितम् ।\nमणिदंडमयं छत्रं दद्याद्वा कांचनादिकम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002502055, "chapter_id": 22502, "verse_number": "१-१६४-५६", "content_sanskrit": "स धार्यमाणच्छत्रेण हेमदंडोपशोभिना ।\nमोदते सूर्यलोके तु विमानवरमा स्थितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002502056, "chapter_id": 22502, "verse_number": "१-१६४-५७", "content_sanskrit": "ततस्तस्माच्च्युतो लोकान्निसर्गाद्भुवमागतः ।\nभुङ्क्ते समुद्रपर्यंतामेकच्छत्रां वसुन्धराम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002502057, "chapter_id": 22502, "verse_number": "१-१६४-५८", "content_sanskrit": "यः शृंखलासमायुक्तां महाघण्टां महास्वनाम् ।\nकांस्यलोहमयीं वापि निबध्नीयाद्भगालये ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002502058, "chapter_id": 22502, "verse_number": "१-१६४-५९", "content_sanskrit": "शोभनः स्यान्नरः श्रीमान्भगस्यातीव वल्लभः ।\nसूर्यतुल्यबलो भूत्वा सूर्यलोके महीयते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002502059, "chapter_id": 22502, "verse_number": "१-१६४-६०", "content_sanskrit": "भेरीमृदंगपटहझर्झरीमर्दलादिकम् ।\nदशकांस्यादिवादित्रं यो भगाय निवेदयेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002502060, "chapter_id": 22502, "verse_number": "१-१६४-६१", "content_sanskrit": "स विमानैर्महाभागेर्वंशवीणायुतस्वनैः ।\nयुगान्तकशतं दिव्यं भगलोके महीयते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002502061, "chapter_id": 22502, "verse_number": "१-१६४-६२", "content_sanskrit": "सुसंगीतकदानेन सवाद्येन विशेषतः ।\nयथेष्टं भास्करे लोके मोदते कालमक्षयम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002502062, "chapter_id": 22502, "verse_number": "१-१६४-६३", "content_sanskrit": "महामहास्वनं दत्त्वा शंखयुग्मं भगालये ।\nयुगकोटिशतं दिव्यं भगलोके महीयते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002502063, "chapter_id": 22502, "verse_number": "१-१६४-६४", "content_sanskrit": "विमानं बहुवर्णाभं मध्ये पंकजभूषितम् ।\nविचित्रमेकवर्णं वासनवस्त्रोपकल्पितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002502064, "chapter_id": 22502, "verse_number": "१-१६४-६५", "content_sanskrit": "किंकिणीजालसंपन्नं वर्णकैश्चोपशोभितम् ।\nपुष्पमालाप्रभं वापि घंटाचामरभूषितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002502065, "chapter_id": 22502, "verse_number": "१-१६४-६६", "content_sanskrit": "भगस्योपरि यो दद्यात्सर्वरत्नोपशोभितम् ।\nदुकूलपट्टदेवांगैर्वस्त्रैर्वा वर्णकान्वितैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002502066, "chapter_id": 22502, "verse_number": "१-१६४-६७", "content_sanskrit": "पट्टादिवस्त्रतंतूनां परिसंख्या तु या भवेत् ।\nतावद्युगसहस्राणि सूरलोके महीयते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002502067, "chapter_id": 22502, "verse_number": "१-१६४-६८", "content_sanskrit": "भगाहुत्या जगत्सर्वं सृष्टिद्वारेण धार्यते ।\nअग्निवर्त्मा वचस्युक्तो ह्यग्निरस्यात्मजः सदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002502068, "chapter_id": 22502, "verse_number": "१-१६४-६९", "content_sanskrit": "यस्त्वग्निकार्यं विधिवत्कुर्यान्नित्यं भगालये ।\nभगमुद्दिश्य राजेंद्र स याति परमां गतिम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002502069, "chapter_id": 22502, "verse_number": "१-१६४-७०", "content_sanskrit": "सर्वान्नं यावकोपेतं यस्तु नित्यविधिं हरेत् ।\nपुष्पधूपजलोपेतं कालेकाले विशेषतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002502070, "chapter_id": 22502, "verse_number": "१-१६४-७१", "content_sanskrit": "महाश्वेतादिमातॄणां त्रिकल्पानां च सर्वशः ।\nयः कृत्वा सकृदप्येवं सर्वदिक्षु बलिं हरेत् ।\nस नरश्च सहस्राणि शांडिलेयपुरे वसेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002502071, "chapter_id": 22502, "verse_number": "१-१६४-७२", "content_sanskrit": "सौरसंध्याबलिं कृत्वा दिनांते सततं रवेः ।\nवर्षायुतशतं साग्रं भगलोके महीयते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002502072, "chapter_id": 22502, "verse_number": "१-१६४-७३", "content_sanskrit": "दध्योदनपयोभिर्यः पूरितं पात्रमावृतम् ।\nपुष्पधूपार्चितं चैव वितानोपरि शोभितम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002502073, "chapter_id": 22502, "verse_number": "१-१६४-७४", "content_sanskrit": "शिरसा धारयेत्पात्रं शनैर्गच्छेत्प्रदक्षिणम् ।\nरव्यायतनपर्यंते शंखवीणादिनिस्वनैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002502074, "chapter_id": 22502, "verse_number": "१-१६४-७५", "content_sanskrit": "दर्पणैर्धूपमालाभिर्गेयनृत्यादिशोभितम् ।\nभानोर्हि स्मृतिशीलश्च तस्य पुण्यफलं शृणु ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002502075, "chapter_id": 22502, "verse_number": "१-१६४-७६", "content_sanskrit": "दिव्यं वर्षसहस्रं तु दिव्यं वर्षशतं तथा ।\nतपस्तप्तं महत्तेन भवेदेवं न संशयः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002502076, "chapter_id": 22502, "verse_number": "१-१६४-७७", "content_sanskrit": "भगभक्तिप्रसन्नात्मा यद्यपि स्यात्स पापकृत् ।\nभगलोके वसेन्नित्यं भगानुचरतां गतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002502077, "chapter_id": 22502, "verse_number": "१-१६४-७८", "content_sanskrit": "कृष्णां तु षष्ठीं नक्तेन यश्च कृष्णां च सप्तमीम् ।\nइह भोगानवाप्नोति परत्र च शुभां गतिम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002502078, "chapter_id": 22502, "verse_number": "१-१६४-७९", "content_sanskrit": "योब्दमेकं तु कुर्वीत नक्तं भगदिने नरः ।\nब्रह्मचारी जितक्रोधो भगार्चनपरो नरः ।\nअयाचितात्परं नक्तं तस्मन्नाक्तेन वर्तयेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002502079, "chapter_id": 22502, "verse_number": "१-१६४-८०", "content_sanskrit": "देवैस्तु भुक्तं मध्याह्ने पूर्वाह्णे ऋषिभिस्तथा ।\nअपराह्णे तु पितृभिः संध्यायां गुह्यकादिभिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002502080, "chapter_id": 22502, "verse_number": "१-१६४-८१", "content_sanskrit": "सर्वा वेला ह्यतिक्रम्य सौराणां भोजनं परम् ।\nभुंजानो नक्तकाले तु सूर्यभक्तिपरायणः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002502081, "chapter_id": 22502, "verse_number": "१-१६४-८२", "content_sanskrit": "भगलोकमवाप्नोति सुमनाः सुमनोव्रतः ।\nभुक्त्वा सौमनसांल्लोकान्रा जा भवति भूतले ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002502082, "chapter_id": 22502, "verse_number": "१-१६४-८३", "content_sanskrit": "हविष्यभोजनं स्नानमाहारस्य च लाघवम् ।\nअग्निकार्यमधःशय्यां नक्तभोजी समाचरेत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002502083, "chapter_id": 22502, "verse_number": "१-१६४-८४", "content_sanskrit": "कृष्णषष्ठ्यां प्रयत्नेन कृत्वा नक्तं विधानतः ।\nनरो मार्गशिरे मासि अंशुमानिति पूजयेत ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002502084, "chapter_id": 22502, "verse_number": "१-१६४-८५", "content_sanskrit": "विधिवत्प्राश्य गोमूत्रमनाहारो निशि स्वपेत् ।\nअतिरात्रस्य यज्ञस्य फलमाप्नोति मानवः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002502085, "chapter_id": 22502, "verse_number": "१-१६४-८६", "content_sanskrit": "पुष्येप्येवं सहस्रांशुं भानुमंतमुशंति च ।\nवाजपेयफलं प्राप्य घृतं प्राश्य लभेन्नरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002502086, "chapter_id": 22502, "verse_number": "१-१६४-८७", "content_sanskrit": "माघे दिवाकरं नाम कृष्णषष्ठ्यां नरोत्तम ।\nनिशि पीत्वा तु गोक्षीरं गोमेधफलमाप्नुयात् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002502087, "chapter_id": 22502, "verse_number": "१-१६४-८८", "content_sanskrit": "मार्तंडं फाल्गुने मासि पूजयित्वा गवां पयः ।\nपिबेत्ततः सूर्यलोके मोदते सोऽयुतायुतम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002502088, "chapter_id": 22502, "verse_number": "१-१६४-८९", "content_sanskrit": "चैत्रे मासि विवस्वंतं पूजयित्वा सुभक्तिमान् ।\nहविष्याशी सूर्यलोकेऽप्सरोभिः सह मोदते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002502089, "chapter_id": 22502, "verse_number": "१-१६४-९०", "content_sanskrit": "वैशाखे चण्डकिरणं पूजयेच्च पयोव्रतः ।\nवर्षाणामयुतं साग्रं मोदते सूर्यसंनिधौ ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002502090, "chapter_id": 22502, "verse_number": "१-१६४-९१", "content_sanskrit": "ज्येष्ठे दिवस्पतिं पूज्य गवां शृंगोदकं पिबेत् ।\nगवां कोटिप्रदानस्य निखिलं फलमा प्नुयात् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002502091, "chapter_id": 22502, "verse_number": "१-१६४-९२", "content_sanskrit": "आषाढे त्वर्कनामानमिष्ट्वा प्राश्य च गोमयम् ।\nप्रयात्यर्कसलोकं तु वर्षाणां च शतंशतम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002502092, "chapter_id": 22502, "verse_number": "१-१६४-९३", "content_sanskrit": "श्रावणेऽर्यमनामानं पूजयित्वा पयः पिबेत् ।\nवर्षाणामयुतं साग्रं मोदते भास्करालये ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002502093, "chapter_id": 22502, "verse_number": "१-१६४-९४", "content_sanskrit": "मासि भाद्रपदे षष्ठ्यां भास्करं नाम पूजयेत् ।\nभास्करं पंचगव्यस्य सर्वमेधफलं लभेत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002502094, "chapter_id": 22502, "verse_number": "१-१६४-९५", "content_sanskrit": "मासि चाश्वयुजे षष्ठ्यां भगाख्यं नाम पूजयेत् ।\nपलगोमूत्रभुक्चैव अश्वमेधफलं लभेत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002502095, "chapter_id": 22502, "verse_number": "१-१६४-९६", "content_sanskrit": "मासे तु कार्तिके षष्ठ्यां शक्राख्यं नाम पूजयेत् ।\nदूर्वांकुरं सकृत्प्राश्य राजसूयफलं लभेत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002502096, "chapter_id": 22502, "verse_number": "१-१६४-९७", "content_sanskrit": "वर्षांते भोजयेद्विप्रान्सूर्यभक्तिपरायणान् ।\nपायसं मधुसंयुक्तं वज्रेण च परिप्लुतम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002502097, "chapter_id": 22502, "verse_number": "१-१६४-९८", "content_sanskrit": "शक्त्या हिरण्यवासांसि भक्त्या तेभ्यो निवेदयेत् ।\nनिवेदयेच्च सूर्याय कृष्णां गां च पयस्विनीम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002502098, "chapter_id": 22502, "verse_number": "१-१६४-९९", "content_sanskrit": "वर्षमेकं च देवे वै नैरंतर्येण यो नयेत् ।\nकृष्णषष्ठीव्रतं भक्त्या तस्य पुण्यफलं शृणु ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002502099, "chapter_id": 22502, "verse_number": "१-१६४-१००", "content_sanskrit": "सर्वपापविनिर्मुक्तः सर्वकामसमन्वितः ।\nमोदते सूर्यलोके तु स नरः शाश्वतीः समाः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002502100, "chapter_id": 22502, "verse_number": "१-१६४-१०१", "content_sanskrit": "पुण्येष्वहःसु सर्वेषु विषुवद्ग्रहणादिषु ।\nदानोपवासहोमाद्यैरक्षयं खग जायते ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002502101, "chapter_id": 22502, "verse_number": "१-१६४-१०२", "content_sanskrit": "सुमंतुरुवाच ।\nइत्युक्तवान्पुरा भानुररुणाय विशांपते ।\nकृष्णषष्ठीव्रतं पुण्यं सर्वपापभयापहम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002502102, "chapter_id": 22502, "verse_number": "१-१६४-१०३", "content_sanskrit": "कृत्वेदं पुरुषो भक्त्या भास्करस्य महात्मनः ।\nप्रयाति परमं स्थानं भानोरमिततेजसः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]