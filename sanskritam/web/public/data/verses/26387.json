[{"id": 7006387000, "chapter_id": 26387, "verse_number": "२-४४-१", "content_sanskrit": "वैशम्पायन उवाच\nतानागतान् विदित्वाथ शृगालो युद्धदुर्मदः ।\nपुरस्य धर्षणं मत्वा निर्जगामेन्द्रविक्रमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006387001, "chapter_id": 26387, "verse_number": "२-४४-२", "content_sanskrit": "रथेनादित्यवर्णेन भास्वता रणगामिना ।\nआयुधप्रतिपूर्णेन नेमिनिर्घोषहासिना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006387002, "chapter_id": 26387, "verse_number": "२-४४-३", "content_sanskrit": "मन्दराचलकल्पेन चित्राभरणभूषिणा ।\nअक्षय्यसायकैस्तूणैः पूर्णेनार्णवघोषिणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006387003, "chapter_id": 26387, "verse_number": "२-४४-४", "content_sanskrit": "हर्यश्वेनाशुगतिनासक्तेन शिखरेष्वपि ।\nहेमकूबरगर्भेण दृढाक्षेणातिशोभिना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006387004, "chapter_id": 26387, "verse_number": "२-४४-५", "content_sanskrit": "सुबन्धुरेण दीप्तेन पतत्त्रिवरगामिना ।\nस्वगतेनेव शक्रस्य हर्यश्वेन रथाद्रिणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006387005, "chapter_id": 26387, "verse_number": "२-४४-६", "content_sanskrit": "सावित्रे नियमे पूर्णे यं ददौ सविता स्वयम् ।\nआदित्यरश्मिभिरिव रश्मिभिर्यो निगृह्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006387006, "chapter_id": 26387, "verse_number": "२-४४-७", "content_sanskrit": "तेन स्यन्दनमुख्येन द्विषत्स्यन्दनघातिना ।\nस शृगालोऽभ्ययात्कृष्णं शलभः पावकं यथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006387007, "chapter_id": 26387, "verse_number": "२-४४-८", "content_sanskrit": "चापपाणिः सुतीक्ष्णेषुः कवची हेममालिकः ।\nसितप्रावरणोष्णीषः पावकाकारलोचनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006387008, "chapter_id": 26387, "verse_number": "२-४४-९", "content_sanskrit": "मुहुर्मुहुर्ज्याचपलं विक्षिपन् दुःसहं धनुः ।\nनिर्वमन् रोषजं वायुं सानलज्वालमण्डलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006387009, "chapter_id": 26387, "verse_number": "२-४४-१०", "content_sanskrit": "भाभिर्भूषणपंक्तीनां दीप्तो मेरुरिवाचलः ।\nरथस्थ इव शैलेन्द्रः शृगालः प्रत्यदृश्यत ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006387010, "chapter_id": 26387, "verse_number": "२-४४-११", "content_sanskrit": "तस्यारसितशब्देन रथनेमिस्वनेन च ।\nगुरुत्वेन च नाम्यन्ती चचालोर्वी भयातुरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006387011, "chapter_id": 26387, "verse_number": "२-४४-१२", "content_sanskrit": "तमापतन्तं श्रीमन्तं मूर्तिमन्तमिवाचलम् ।\nशृगालं लोकपालाभं दृष्ट्वा कृष्णो न विव्यथे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006387012, "chapter_id": 26387, "verse_number": "२-४४-१३", "content_sanskrit": "शृगालश्चापि संरब्धः स्यन्दनेनाशुगामिना ।\nसमीपे वासुदेवस्य युयुत्सुः प्रत्यदृश्यत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006387013, "chapter_id": 26387, "verse_number": "२-४४-१४", "content_sanskrit": "वासुदेवं स्थितं दृष्ट्वा शृगालो युद्धलालसः ।\nअभिदुद्राव वेगेन मेघराशिरिवाचलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006387014, "chapter_id": 26387, "verse_number": "२-४४-१५", "content_sanskrit": "वासुदेवः स्मितं कृत्वा प्रतियुद्धाय तस्थिवान् ।\nतद् युद्धमभवत् ताभ्यां समरे घोरदर्शनम् ।\nउभाभ्यामिव मत्ताभ्यां कुंजराभ्यां यथा वने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006387015, "chapter_id": 26387, "verse_number": "२-४४-१६", "content_sanskrit": "शृगालस्त्वब्रवीत्कृष्णं समरे समुपस्थितम् ।\nयुद्धरागेण तेजस्वी मोहाच्चलितगौरवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006387016, "chapter_id": 26387, "verse_number": "२-४४-१७", "content_sanskrit": "गोमन्ते युद्धमार्गेण यत् त्वया कृष्ण चेष्टितम् ।\nअनायकानां मूर्खाणां नृपाणां दुर्बले बले ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006387017, "chapter_id": 26387, "verse_number": "२-४४-१८", "content_sanskrit": "स मे सुविदितः कृष्ण क्षत्रियाणां पराजयः ।\nकृपणानामसत्त्वानामयुद्धानां रणोत्सवे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006387018, "chapter_id": 26387, "verse_number": "२-४४-१९", "content_sanskrit": "तिष्ठेदानीं यथाकामं स्थितोऽहं पार्थिवे पदे ।\nक्व यास्यसि मया रुद्धो रणेष्वपरिनिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006387019, "chapter_id": 26387, "verse_number": "२-४४-२०", "content_sanskrit": "न चाहमेकं सबलो युक्तस्त्वां योद्धुमाहवे ।\nअहमेकस्त्वमप्येको द्वौ युध्याव रणे स्थितौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006387020, "chapter_id": 26387, "verse_number": "२-४४-२१", "content_sanskrit": "किं जनेन निरस्तेन त्वं वाहं च रणे स्थितः ।\nधर्मयुद्धेन निधनं व्रजत्वेकतरो रणे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006387021, "chapter_id": 26387, "verse_number": "२-४४-२२", "content_sanskrit": "लोकेऽस्मिन्वासुदेवोऽहं भविष्यामि हते त्वयि ।\nहते मयि त्वमप्येको वासुदेवो भविष्यसि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006387022, "chapter_id": 26387, "verse_number": "२-४४-२३", "content_sanskrit": "शृगालस्य वचः श्रुत्वा वासुदेवः क्षमापरः ।\nईर्ष्यन्तं प्रहरस्वेति तमुक्त्वा चक्रमाददे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006387023, "chapter_id": 26387, "verse_number": "२-४४-२४", "content_sanskrit": "ततः सायकजालानि शृगालः क्रोधमूर्छितः ।\nचिक्षेप कृष्णे घोराणि युद्धाय लघुविक्रमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006387024, "chapter_id": 26387, "verse_number": "२-४४-२५", "content_sanskrit": "शस्त्राणि यानि चान्यानि मुसलाद्यानि संयुगे ।\nपातयामास गोविन्दे स शृगालः प्रतापवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006387025, "chapter_id": 26387, "verse_number": "२-४४-२६", "content_sanskrit": "शृगालप्रहितैरस्त्रैः पावकज्वालमालिभिः ।\nनिर्दयाभिहतः कृष्णः स्थितो गिरिरिवाचलः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006387026, "chapter_id": 26387, "verse_number": "२-४४-२७", "content_sanskrit": "सोऽस्त्रप्रहाराभिहतः किंचिद् रोषसमन्वितः ।\nचक्रमुद्यम्य गोविन्दः शृगालस्य परिक्षिपत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006387027, "chapter_id": 26387, "verse_number": "२-४४-२८", "content_sanskrit": "तं रथस्थं प्रमाणस्थं शृगालं युद्धदुर्मदम् ।\nजघान समरे चक्रं जातदर्पं महाबलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006387028, "chapter_id": 26387, "verse_number": "२-४४-२९", "content_sanskrit": "ततः सुदर्शनं चक्रं पुनरायाद् गुरोः करे ।\nचक्रेणोरसि निर्भिन्नः स गतासुर्गतोत्सवः ।\nपपात क्षतजस्रावी शृगालोऽद्रिरिवाहतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006387029, "chapter_id": 26387, "verse_number": "२-४४-३०", "content_sanskrit": "निशम्य तं निपतितं वज्रपातादिवाचलम् ।\nतस्य सैन्यान्यपययुर्विमनांसि हते नृपे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006387030, "chapter_id": 26387, "verse_number": "२-४४-३१", "content_sanskrit": "केचित् प्रविश्य नगरं कश्मलाभिहता भृशम् ।\nरुरुदुर्दुःखसंतप्ता भर्तृशोकाभिपीडिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006387031, "chapter_id": 26387, "verse_number": "२-४४-३२", "content_sanskrit": "केचित्तत्रैव शोचन्तः स्मरन्तः सुकृतानि च ।\nपतितं भूपतिं भूमौ न त्यजन्ति स्म दुःखिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006387032, "chapter_id": 26387, "verse_number": "२-४४-३३", "content_sanskrit": "ततो मेघनिनादेन स्वरेणारिविमर्दनः ।\nकृष्णः कमलपत्राक्षो जनानामभयं ददौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006387033, "chapter_id": 26387, "verse_number": "२-४४-३४", "content_sanskrit": "चक्रोचितेन हस्तेन राजतागुङ्लिपर्वणा ।\nन भेतव्यं न भेतव्यमिति तानभ्यभाषत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006387034, "chapter_id": 26387, "verse_number": "२-४४-३५", "content_sanskrit": "नास्य पापस्य दोषेण निरावाधकरं जनम् ।\nघातयिष्यामि समरे नेदं शूरव्रतं मतम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006387035, "chapter_id": 26387, "verse_number": "२-४४-३६", "content_sanskrit": "अश्रुपूर्णमुखा दीनाः क्रन्दमाना भृशं तदा ।\nते स्म पश्यन्ति पतितं धरण्यां धरणीपतिम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006387036, "chapter_id": 26387, "verse_number": "२-४४-३७", "content_sanskrit": "चक्रनिर्दारितोरस्कं भिन्नशृङ्गमिवाचलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006387037, "chapter_id": 26387, "verse_number": "२-४४-३८", "content_sanskrit": "विलपन्ति स्म ते सर्वे सचिवाः सप्रजा भृशम् ।\nसाश्रुपातेक्षणा दीनाः शोकस्य वशमागताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006387038, "chapter_id": 26387, "verse_number": "२-४४-३९", "content_sanskrit": "तेषां रुदितशब्देन पौराणां विस्वरैः स्वरैः ।\nमहिष्यस्तस्य निष्पेतुः सपुत्रा रुदिताननाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006387039, "chapter_id": 26387, "verse_number": "२-४४-४०", "content_sanskrit": "तास्तं निपतितं दृष्ट्वा श्लाघ्यं भूमिपतिं पतिम् ।\nस्तनानारुज्य करजैर्भृशार्ताः पर्यदेवयन् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006387040, "chapter_id": 26387, "verse_number": "२-४४-४१", "content_sanskrit": "उरांस्युरसिजांश्चैव शिरोजान्याकुलान्यपि ।\nनिर्दयं ताडयन्त्यस्ता विस्वरं रुरुदुः स्त्रियः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006387041, "chapter_id": 26387, "verse_number": "२-४४-४२", "content_sanskrit": "तस्योरसि सुदुःखार्ता मृदिताः क्लिन्नलोचनाः ।\nपेतुरूर्ध्वभुजाः सर्वाश्छिन्नमूला लता इव ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006387042, "chapter_id": 26387, "verse_number": "२-४४-४३", "content_sanskrit": "तासां बाष्पाम्बुपूर्णानि नेत्राणि नृपयोषिताम् ।\nवारिविप्रहतानीव पङ्कजानि चकाशिरे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006387043, "chapter_id": 26387, "verse_number": "२-४४-४४", "content_sanskrit": "{baki}", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006387044, "chapter_id": 26387, "verse_number": "२-४४-४५", "content_sanskrit": "पुत्रं चास्य पुरस्कृत्य बालं प्रस्नुतलोचनम् ।\nशक्रदेवं पितुः पार्श्वे द्विगुणं रुरुदुः स्त्रियः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006387045, "chapter_id": 26387, "verse_number": "२-४४-४६", "content_sanskrit": "अयं ते वीर विक्रान्तो बालः पुत्रो न पण्डितः ।\nत्वद्धिहीनः कथमयं पदे स्थास्यात पैतृके ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006387046, "chapter_id": 26387, "verse_number": "२-४४-४७", "content_sanskrit": "कथमेकपदे त्यक्त्वा गतोऽस्यन्तःपुरं परम् ।\nअतृप्तास्तव सौख्यानां किं कुर्मो विधवा वयम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006387047, "chapter_id": 26387, "verse_number": "२-४४-४८", "content_sanskrit": "तस्य पद्मावती नाम महिषी प्रमदोत्तमा ।\nरुदती पुत्रमादाय वासुदेवमुपस्थिता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006387048, "chapter_id": 26387, "verse_number": "२-४४-४९", "content_sanskrit": "यस्त्वया पातितो वीर रणप्रोक्तेन कर्मणा ।\nतस्य प्रेतगतस्यायं पुत्रस्त्वां शरणं गतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006387049, "chapter_id": 26387, "verse_number": "२-४४-५०", "content_sanskrit": "यदि त्वां प्रणमेतासौ कुर्याद वा शासनं तव ।\nनायमेकप्रहारेण जनस्तप्येत दारुणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006387050, "chapter_id": 26387, "verse_number": "२-४४-५१", "content_sanskrit": "यदि कुर्यादयं मूढस्त्वयि बान्धवकं विधिम् ।\nनैवं परीतः कृपणः सेवेत धरणीतलम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006387051, "chapter_id": 26387, "verse_number": "२-४४-५२", "content_sanskrit": "अयमस्य विपन्नस्य बान्धवस्य तवानघ ।\nसन्तती रक्ष्यतां वीर पुत्रः पुत्र इवात्मजः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006387052, "chapter_id": 26387, "verse_number": "२-४४-५३", "content_sanskrit": "तस्यास्तद् वचनं श्रुत्वा महिष्या यदुनन्दनः ।\nमृदुपर्वमिदं वाक्यमुवाच वदतां वरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006387053, "chapter_id": 26387, "verse_number": "२-४४-५४", "content_sanskrit": "राजपत्नि गतो रोषः सहानेन दुरात्मना ।\nप्रकृतिस्था वयं जाता देवि सैषोऽस्मि बान्धवः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006387054, "chapter_id": 26387, "verse_number": "२-४४-५५", "content_sanskrit": "रोषो मे विगतः साध्वि तव वाक्यैरकल्मषैः ।\nयोऽयं पुत्रः शृगालस्य ममाप्येष न संशयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006387055, "chapter_id": 26387, "verse_number": "२-४४-५६", "content_sanskrit": "अभयं चाभिषेकं च ददाम्यस्मै सुखाय वै ।\nआहूयन्तां प्रकृतयः पुरोधा मन्त्रिणस्तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006387056, "chapter_id": 26387, "verse_number": "२-४४-५७", "content_sanskrit": "पितृपैतामहे राज्ये तव पुत्रोऽभिषिच्यताम् ।\nततः प्रकृतयः सर्वाः पुरोधा मन्त्रिणस्तथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006387057, "chapter_id": 26387, "verse_number": "२-४४-५८", "content_sanskrit": "अभिषेकार्थमाजग्मुर्यतो वै रामकेशवौ ।\nततः सिंहासनस्थं तु राजपुत्रं जनार्दनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006387058, "chapter_id": 26387, "verse_number": "२-४४-५९", "content_sanskrit": "अभिषेकेण दिव्येन योजयामास वीर्यवान् ।\nअभिषिच्य शृगालस्य करवीरपुरे सुतम्।\nकृष्णस्तदहरेवाशु प्रस्थानमभ्यरोचयत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006387059, "chapter_id": 26387, "verse_number": "२-४४-६०", "content_sanskrit": "रथेन हरियुक्तेन तेन युद्धार्जितेन वै ।\nकेशवः प्रस्थितोऽध्वानं वृत्रहा त्रिदिवं यथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006387060, "chapter_id": 26387, "verse_number": "२-४४-६१", "content_sanskrit": "शक्रदेवोऽपि धर्मात्मा सह मात्रा परंतपः ।\nसबालवृद्धयुवतीमुख्याः प्रकृतयस्तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006387061, "chapter_id": 26387, "verse_number": "२-४४-६२", "content_sanskrit": "शिबिकायामथारोप्य शृगालं युद्धदुर्मदम् ।\nसंहता दूरमार्गेण पश्चिमाभिमुखा ययुः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006387062, "chapter_id": 26387, "verse_number": "२-४४-६३", "content_sanskrit": "नैधनस्य विधानेन चक्रुस्ते तस्य सत्क्रियाम् ।\nसत्कारं कारयामासुः पितॄणां पारलौकिकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006387063, "chapter_id": 26387, "verse_number": "२-४४-६४", "content_sanskrit": "उद्दिश्योद्दिश्य राजानं श्राद्धं कृत्वा सहस्रशः ।\nततस्ते सलिलं दत्त्वा नामगोत्रादिकीर्तनैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006387064, "chapter_id": 26387, "verse_number": "२-४४-६५", "content_sanskrit": "पितर्युपरते घोरे शोकसंविग्नमानसः ।\nकृत्वोदकं तदा राजा प्रविवेश पुरोत्तमम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]