[{"id": 2141379, "chapter_id": 4050, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141380, "chapter_id": 4050, "verse_number": "१", "content_sanskrit": "जितं वैकर्तनं दृष्ट्वा पार्थो वैराटिमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141381, "chapter_id": 4050, "verse_number": "२", "content_sanskrit": "स्थिरो भव त्वं सङ्ग्रामे जयोऽस्माकं नृपात्मज ।\nजयाच्छङ्खमुपाध्मास्ये द्विषतां लोमहर्षणम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141382, "chapter_id": 4050, "verse_number": "३", "content_sanskrit": "अविक्लब(व)मसम्भ्रान्तमव्यग्रहृदयेक्षणम् ।\nयाहि शीघ्रं यतो द्रोणो ममाचार्यो महारथः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141383, "chapter_id": 4050, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141384, "chapter_id": 4050, "verse_number": "४", "content_sanskrit": "तथा सङ्क्रीडमानस्य ह्यर्जुनस्य रणाजिरे ।\nबलं सत्वं च तेजश्च लाघवं चाभ्यवर्धत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141385, "chapter_id": 4050, "verse_number": "५", "content_sanskrit": "तच्चाद्भुतमभिप्रेक्ष्य भयमुत्तरमाविशत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141386, "chapter_id": 4050, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141387, "chapter_id": 4050, "verse_number": "६", "content_sanskrit": "अस्त्राणां तव दिव्यानां शरौघान् क्षिपतश्च ते ।\nमनो मे मुह्यतेऽत्यर्थं तव दृष्ट्वा पराक्रमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141388, "chapter_id": 4050, "verse_number": "७", "content_sanskrit": "द्वैधीभूतं मनो मह्यं भयाद् भरतसत्तम ।\nअदृष्टपूर्वं पश्यामि तव गाण्डीवनिस्वनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141389, "chapter_id": 4050, "verse_number": "८", "content_sanskrit": "तव बाहुबलं चैव धनुः प्राकर्षतो बहु ।\nतव तेजो दुराधर्षं यथा विष्णोस्त्रिविक्रमे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141390, "chapter_id": 4050, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141391, "chapter_id": 4050, "verse_number": "९", "content_sanskrit": "तमुत्तरश्चित्रमवेक्ष्य गाण्डिवं\nशरांश्च मुक्तान् सहसा किरीटिना ।\nभीतोऽब्रवीदर्जुनमाजिमध्ये\nनाहं तवाश्वान् विषहे नियन्तुम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141392, "chapter_id": 4050, "verse_number": "१०", "content_sanskrit": "तमब्रवीदीषदिव प्रहस्य\nगाण्डीवधन्वा द्विषतां निहन्ता\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141393, "chapter_id": 4050, "verse_number": "११", "content_sanskrit": "मया सहायेन कुतोऽस्ति ते भयं\nप्रेह्युत्तराश्वानुपमन्त्र्य सारथे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141394, "chapter_id": 4050, "verse_number": "१२", "content_sanskrit": "आश्वासितस्तेन धनञ्जयेन\nवैराटिरश्वान् प्रतुतोद शीघ्रम् ।\nधनञ्जयश्चापि विकृष्य चापं\nविष्फारयामास महेन्द्रकल्पः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141395, "chapter_id": 4050, "verse_number": "१३", "content_sanskrit": "उत्तरं चैव बीभत्सुरब्रवीत् पुनरेव हि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141396, "chapter_id": 4050, "verse_number": "१४", "content_sanskrit": "न भेतव्यं मया सार्धं तात सङ्ग्राममूर्धनि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141397, "chapter_id": 4050, "verse_number": "१५", "content_sanskrit": "राजपुत्रोऽसि भद्रं ते कुले महति मात्स्यके ।\nजातस्त्वं क्षत्रियकुले न विषीदितुमर्हसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141398, "chapter_id": 4050, "verse_number": "१६", "content_sanskrit": "धृतिं कृत्वा सुविपुलां राजपुत्र रथं मम ।\nयुध्यमानस्य समरे शत्रुभिः सह वाहय\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141399, "chapter_id": 4050, "verse_number": "१७", "content_sanskrit": "उक्त्वा तमेवं बीभत्सुरर्जुनः पुनरब्रवीत् ।\nपाण्डवो रथिनां श्रेष्ठो भारद्वाजं समीक्ष्य तु\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141400, "chapter_id": 4050, "verse_number": "१८", "content_sanskrit": "यत्रैषा काञ्चनी वेदिर्दृश्यतेऽग्निशिखोपमा ।\nउच्छ्रिता काञ्चने दण्डे पताकाभिरलङ्कृता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141401, "chapter_id": 4050, "verse_number": "१९", "content_sanskrit": "तत्र मां नय भद्रं ते द्रोणं योत्स्यामि सत्तमम् ।\nभारद्वाजेन योत्स्येऽहमाचार्येण महात्मना\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141402, "chapter_id": 4050, "verse_number": "२०", "content_sanskrit": "अमी शोणाः प्रकाशन्ते तुरगाः साधुवाहिनः ।\nयुक्ता रथवरे यस्य सर्वशिक्षाविशारदाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141403, "chapter_id": 4050, "verse_number": "२१", "content_sanskrit": "ततो रथवरे शूरः सर्वशस्त्रभृतां वरः ।\nस्निग्धवैडूर्यसङ्काशस्ताम्राक्षः प्रियदर्शनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141404, "chapter_id": 4050, "verse_number": "२२", "content_sanskrit": "पीनदीर्घभुजः श्रीमान् बलवीर्यसमन्वितः ।\nसर्वलोकधनुःश्रेष्ठः सर्वलोकेषु पूजितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141405, "chapter_id": 4050, "verse_number": "२३", "content_sanskrit": "अङ्गिरोशनसोस्तुल्यो नये बुद्धिमतां वरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141406, "chapter_id": 4050, "verse_number": "२४", "content_sanskrit": "चत्वारो निखिला वेदाः साङ्गोपाङ्गाः सलक्षणाः ।\nधनुर्वेदश्च कार्त्स्न्येन ब्राह्मं चास्त्रं प्रतिष्ठितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141407, "chapter_id": 4050, "verse_number": "२५", "content_sanskrit": "पुराणमितिहासश्च ह्यर्थविद्या च मानवी ।\nभारद्वाजे समस्तानि सर्वाण्येतानि साम्प्रतम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141408, "chapter_id": 4050, "verse_number": "२६", "content_sanskrit": "क्षमा दया च सत्यं च तेजो मार्दवमार्जवम् ।\nप्रतिष्ठिता गुणा यस्मिन् बहवो द्विजसत्तमे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141409, "chapter_id": 4050, "verse_number": "२७", "content_sanskrit": "यस्याहमिष्टः सततं मम चेष्टः सदा च यः ।\nक्षत्रधर्मं पुरस्कृत्य तेन योत्स्यामि संयुगे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141410, "chapter_id": 4050, "verse_number": "२८", "content_sanskrit": "आचार्यं प्रापयेदानीं ममोत्तर महारथम् ।\nअपरं पश्य सङ्ग्राममद्भुतं मम पश्य च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141411, "chapter_id": 4050, "verse_number": "२९", "content_sanskrit": "उत्तरस्त्वेवमुक्तोऽश्वान् चोदयामास तं प्रति ।\nआजगामार्जुनरथो भारद्वाजरथं प्रति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141412, "chapter_id": 4050, "verse_number": "३०", "content_sanskrit": "तमापतन्तं वेगेन पाण्डवं सरथं रणे ।\nद्रोणोऽप्यभ्यद्रवत् पार्थं मत्तो मत्तमिव द्विपम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141413, "chapter_id": 4050, "verse_number": "३१", "content_sanskrit": "स तु रुग्मरथं दृष्ट्वा कौन्तेयः समभिद्रुतम् ।\nआचार्यं तं महाबाहुः प्राञ्जलिर्वाक्यमब्रवीत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141414, "chapter_id": 4050, "verse_number": "३२", "content_sanskrit": "उषिताः स्मो वने वासं प्रतिकर्म चिकीर्षवः ।\nकोपं नार्हसि नः कर्तुं सदा समरदुर्मद\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141415, "chapter_id": 4050, "verse_number": "३३", "content_sanskrit": "अहं तु ताडितः पूर्वं प्रहरेयं त्वयाऽनघ ।\nइति मे वर्तते बुद्धिस्तद् भवान् क्षन्तुमर्हति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141416, "chapter_id": 4050, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141417, "chapter_id": 4050, "verse_number": "३४", "content_sanskrit": "ततः प्राध्मापयच्छङ्खं भेरीपणवनादितम् ।\nव्यक्षोभत बलं सर्वमुद्धूत इव सागरः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141418, "chapter_id": 4050, "verse_number": "३५", "content_sanskrit": "ततस्तु प्राहिणोद् द्रोणः शराणामेकविंशतिम् ।\nअप्राप्तानेव तान् पार्थः चिच्छेद कृतहस्तवान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141419, "chapter_id": 4050, "verse_number": "३६", "content_sanskrit": "ततः शरसहस्रेण रथं पार्थस्य वीर्यवान् ।\nअवाकिरत् ततो द्रोणः शीघ्रहस्तं प्रदर्शयन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141420, "chapter_id": 4050, "verse_number": "३७", "content_sanskrit": "एवं प्रववृधे युद्धं भारद्वाजकिरीटिनोः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141421, "chapter_id": 4050, "verse_number": "३८", "content_sanskrit": "अश्वान् शोणान् महावेगान् हंसवर्णैस्तु वाजिभिः ।\nमिश्रितान् समरे दृष्ट्वा व्यस्मयन्त पृथग्जनाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141422, "chapter_id": 4050, "verse_number": "३९", "content_sanskrit": "रथं रथेन पार्थस्य समापत्य परन्तपः ।\nहर्षयुक्तस्तदाऽऽचार्यः प्रत्यगृह्णत पाण्डवम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141423, "chapter_id": 4050, "verse_number": "४०", "content_sanskrit": "समाश्लिष्टाविवान्योन्यं द्रोणपाण्डवयोर्ध्वजौ ।\nदृष्ट्वा प्राकम्पत मुहुर्भारतानां महाचमूः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141424, "chapter_id": 4050, "verse_number": "४१", "content_sanskrit": "तत्तु युद्धं प्रववृते आचार्यस्यार्जुनस्य च ।\nविमुञ्चतोः शरानुग्रान् विशिखान् दीप्ततेजसः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141425, "chapter_id": 4050, "verse_number": "४२", "content_sanskrit": "तौ वीरौ वीर्यसम्पन्नौ दृष्ट्वा सङ्ग्राममूर्धनि ।\nआचार्यशिष्यौ रथिनौ कृतवीर्यौ तरस्विनौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141426, "chapter_id": 4050, "verse_number": "४३", "content_sanskrit": "उभौ विश्रुतकर्माणावुभौ वीरौ तरस्विनौ ।\nउभावतिरथौ लोके ह्युभौ परपुरञ्जयौ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2141427, "chapter_id": 4050, "verse_number": "४४", "content_sanskrit": "क्षिपन्तौ शरजालानि क्षत्रियान् मोह आविशत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2141428, "chapter_id": 4050, "verse_number": "४५", "content_sanskrit": "व्यस्मयन्त जनाः सर्वे द्रोणार्जुनसमागमे ।\nनराणां ब्रुवतां वाक्यं श्रूयते सुमहास्वनः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2141429, "chapter_id": 4050, "verse_number": "४६", "content_sanskrit": "द्रोणं हि समरे कोऽन्यो योद्धुमर्हत्यथार्जुनात् ।\nरौद्रः क्षत्रियधर्मोऽयं गुरुं वै यदयोधयत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2141430, "chapter_id": 4050, "verse_number": "४७", "content_sanskrit": "इत्यब्रुवन् जनास्तत्र सङ्ग्रामशिरसि स्थिताः ।\nतौ समीक्ष्य तु संरब्धौ सन्निकृष्टौ महारथौ\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2141431, "chapter_id": 4050, "verse_number": "४८", "content_sanskrit": "छादयेतां शरौघैस्तावन्योन्यमपराजितौ ।\nसंयुगे सञ्चकाशेतां कालसूर्याविवोदितौ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2141432, "chapter_id": 4050, "verse_number": "४९", "content_sanskrit": "विष्फार्य च महाचापं हेमपृष्ठं दुरानमम् ।\nसंरब्धस्तु तदा द्रोणः प्रत्ययुध्यत फल्गुनम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2141433, "chapter_id": 4050, "verse_number": "५०", "content_sanskrit": "स सायकमयैर्जालैरर्जुनस्य रथं प्रति ।\nभानुमद्भिः शिलाधौतैर्बाणैः प्राच्छादयद् दिशः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2141434, "chapter_id": 4050, "verse_number": "५१", "content_sanskrit": "अर्जुनस्तु तदा द्रोणं महावेगैर्महारथः ।\nविव्याध शतशो बाणैर्धाराभिरिव पर्वतम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2141435, "chapter_id": 4050, "verse_number": "५२", "content_sanskrit": "काळमेघ इवोष्णान्ते फल्गुनः समवाकिरत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2141436, "chapter_id": 4050, "verse_number": "५३", "content_sanskrit": "तस्य जाम्बूनदमयैः शित्रैश्चापच्युतैः शरैः ।\nप्राच्छादयद् रथश्रेष्ठं भारद्वाजोऽर्जुनस्य वै\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2141437, "chapter_id": 4050, "verse_number": "५४", "content_sanskrit": "तथैव दिव्यं गाण्डीवं धनुरायम्य चार्जुनः ।\nशत्रुघ्नं वेगवत् सृष्टं भारसाधनमुत्तमम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2141438, "chapter_id": 4050, "verse_number": "५५", "content_sanskrit": "शोभते स्म महाबाहोर्गाण्डीवं विक्षिपद् धनुः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2141439, "chapter_id": 4050, "verse_number": "५६", "content_sanskrit": "शरांश्च विसृजंश्चित्रान् सुवर्णविकृतान् बहून् ।\nप्राच्छादयदमेयात्मा भारद्वाजरथं प्रति\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2141440, "chapter_id": 4050, "verse_number": "५७", "content_sanskrit": "द्रोणचापविनिर्मुक्तान् बाणैर्बाणानवारयत्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2141441, "chapter_id": 4050, "verse_number": "५८", "content_sanskrit": "सरथोऽप्यचरत् पार्थः प्रेक्षणीयो महारथः ।\nयुगपद् दिक्षु सर्वासु सर्वतोऽस्त्राण्यवासृजत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2141442, "chapter_id": 4050, "verse_number": "५९", "content_sanskrit": "आददानं शरान् घोरान् सन्दधानं च पाण्डवम् ।\nविसृजन्तं च कौन्तेयं न स्म पश्यन्ति लाघवात्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2141443, "chapter_id": 4050, "verse_number": "६०", "content_sanskrit": "एकच्छायमिवाकाशं बाणैश्चक्रे समन्ततः ।\nनादृश्यत तदा द्रोणो नीहारेणेव सर्वतः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2141444, "chapter_id": 4050, "verse_number": "६१", "content_sanskrit": "मरीचिविकचस्येव राजन् भानुमतो वपुः ।\nआसीत् पार्थस्य सुमहद् वपुः शरशतार्पितम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2141445, "chapter_id": 4050, "verse_number": "६२", "content_sanskrit": "क्षिपतः शरजालानि कौन्तेयस्य महात्मनः ।\nतान् विधूय शरान् घोरान् द्रोणोऽपि समितिञ्जयः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2141446, "chapter_id": 4050, "verse_number": "६३", "content_sanskrit": "बभासे तिमिरं व्योम्नि विधूय सविता यथा\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2141447, "chapter_id": 4050, "verse_number": "६४", "content_sanskrit": "अग्निचक्रोपमं घोरं मण्डलीकृतमाहवे ।\nविकृष्य सुमहच्चापं मेघस्तनितनिस्वनम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2141448, "chapter_id": 4050, "verse_number": "६५", "content_sanskrit": "असक्तं मुञ्चतो बाणान् ददृशुः कुरवो युधि\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2141449, "chapter_id": 4050, "verse_number": "६६", "content_sanskrit": "दिक्षु सर्वासु विपुलः शुश्रुवेऽथ जनैस्तथा\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2141450, "chapter_id": 4050, "verse_number": "६७", "content_sanskrit": "द्रोणस्यापि धनुर्घोषो विद्युत्स्तनितनिस्वनः ।\nअभवद् विस्मयकरः सैन्यानां भरतर्षभ\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2141451, "chapter_id": 4050, "verse_number": "६८", "content_sanskrit": "तस्य जाम्बूनदमयैर्दीप्तैरग्निसमैः शरैः ।\nप्राच्छादयदमेयात्मा दिशः सूर्यस्य च प्रभाम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2141452, "chapter_id": 4050, "verse_number": "६९", "content_sanskrit": "ततः कनकपुङ्खानां शराणां नतपर्वणाम् ।\nवियद्गतानां चरतां दृश्यन्ते बहवो व्रजाः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2141453, "chapter_id": 4050, "verse_number": "७०", "content_sanskrit": "शरासनात् तु द्रोणस्य प्रभवन्ति स्म सायकाः ।\nएको दीर्घ इवापाङ्गात् प्रदृश्यन्ते महाशराः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2141454, "chapter_id": 4050, "verse_number": "७१", "content_sanskrit": "आकाशे समदृश्यन्त हंसानामिव पङ्क्तयः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2141455, "chapter_id": 4050, "verse_number": "७२", "content_sanskrit": "एवं सुवर्णविकृतान् विमुञ्चन्तौ बहून् शरान् ।\nआकाशं संवृतं वीरावुल्काभिरिव चक्रतुः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2141456, "chapter_id": 4050, "verse_number": "७३", "content_sanskrit": "तयोः शराश्च विबभुः कङ्कबर्हिणवाससः ।\nपङ्क्त्यः शरदि मत्तानां सारसानामिवाम्बरे\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2141457, "chapter_id": 4050, "verse_number": "७४", "content_sanskrit": "तत्तु युद्धं महद्घोरं तयोः संरब्धयोरभूत् ।\nअत्यद्भुतमचिन्त्यं च वृत्रवासवयोर्यथा\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2141458, "chapter_id": 4050, "verse_number": "७५", "content_sanskrit": "महागजाविवासाद्य विषाणाग्रैः परस्परम् ।\nशरैः पूर्णायतोत्सृष्टैरन्योन्यमभिजघ्नतुः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2141459, "chapter_id": 4050, "verse_number": "७६", "content_sanskrit": "अथ त्वाचार्यमुख्येन शरान् सृष्टान् शिलाशितान् ।\nअवारयच्छितैर्बाणैरर्जुनो जयतां वरः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2141460, "chapter_id": 4050, "verse_number": "७७", "content_sanskrit": "दर्शयन्नैन्द्रिरात्मानमुग्रमुग्रपराक्रमः ।\nइषुभिस्तूर्णमाकाशं बहुभिश्च समावृणोत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2141461, "chapter_id": 4050, "verse_number": "७८", "content_sanskrit": "जिघांसन्तं नरव्याघ्रमर्जुनं भीमतेजसम् ।\nविव्याध निशितैर्द्रोणः शरैः सन्नतपर्वभिः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2141462, "chapter_id": 4050, "verse_number": "७९", "content_sanskrit": "हृष्टः समभवद् द्रोणो रणे शौण्डः प्रतापवान् ।\nअर्जुनेन समं क्रीडन् शरैः सन्नतपर्वभिः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2141463, "chapter_id": 4050, "verse_number": "८०", "content_sanskrit": "तौ व्यदारयतां शूरौ संरब्धौ रणमूर्द्धनि ।\nउदीरयन्तौ दिव्यानि ब्राह्माद्यस्त्राणि सर्वशः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2141464, "chapter_id": 4050, "verse_number": "८१", "content_sanskrit": "पार्थः स समरे शूरो दर्शयन् वीर्यमात्मनः ।\nसुमहास्त्रैर्महात्मानं द्रोणं प्राच्छादयच्छरैः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2141465, "chapter_id": 4050, "verse_number": "८२", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य पार्थो द्रोणमवारयत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2141466, "chapter_id": 4050, "verse_number": "८३", "content_sanskrit": "तयोरासीत् सम्प्रहारः क्रुद्धयोर्नरसिंहयोः ।\nअमृष्यमाणयोः सङ्खे बलिवासवयोरिव\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2141467, "chapter_id": 4050, "verse_number": "८४", "content_sanskrit": "दर्शयेतां महास्त्राणि भारद्वाजार्जुनावुभौ\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2141468, "chapter_id": 4050, "verse_number": "८५", "content_sanskrit": "ऐन्द्रं वायव्यमाग्नेयमस्त्रमस्त्रेण पाण्डवः ।\nमुक्तं मुक्तं द्रोणचापाद् ग्रसते स्म पुनः पुनः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2141469, "chapter_id": 4050, "verse_number": "८६", "content_sanskrit": "एवं शूरौ महेष्वासौ विसृजन्तौ शरान् शितान् ।\nएकच्छायामकुर्वातां गगनं शरवृष्टिभिः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2141470, "chapter_id": 4050, "verse_number": "८७", "content_sanskrit": "ततोऽर्जुने विमुक्तानां पततां च शरीरिषु ।\nपर्वतेष्विव वज्राणां शराणां श्रूयते स्वनः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2141471, "chapter_id": 4050, "verse_number": "८८", "content_sanskrit": "ततो नागा रथाश्वाश्च सादिनश्च विशाम्पते ।\nशोणिताक्ताश्च दृश्यन्ते पुष्पिता इव किंशुकाः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2141472, "chapter_id": 4050, "verse_number": "८९", "content_sanskrit": "बाहुभिश्च सकेयूरैर्निकृत्तैश्च महारथैः ।\nसुवर्णचित्रैः कवचैर्ध्वजैश्च विनिपातितैः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2141473, "chapter_id": 4050, "verse_number": "९०", "content_sanskrit": "योधैश्च निहतैस्तत्र पार्थबाणाभिपीडितैः ।\nबलमासीत् समुद्भ्रान्तं द्रोणार्जुनसमागमे\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2141474, "chapter_id": 4050, "verse_number": "९१", "content_sanskrit": "विधून्वानौ तु तौ वीरौ धनुषी भारसाधने ।\nप्राच्छादयेतामन्योन्यं दिधक्षन्तौ महेषुभिः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2141475, "chapter_id": 4050, "verse_number": "९२", "content_sanskrit": "अथान्तरिक्षे नादोऽभूद् द्रोणं तत्र प्रशंसताम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2141476, "chapter_id": 4050, "verse_number": "९३", "content_sanskrit": "दुष्करं कृतवान् द्रोणो यदर्जुनमयोधयत् ।\nप्रमाथिनं महावीर्यं दृढमुष्टिं दुरासदम्\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2141477, "chapter_id": 4050, "verse_number": "९४", "content_sanskrit": "जेतारं सर्वसैन्यानां सर्वेषां च महारथम्\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2141478, "chapter_id": 4050, "verse_number": "९५", "content_sanskrit": "अविभ्रमं च शिक्षां च लाघवं दूरपातनम् ।\nपार्थस्य समरे दृष्ट्वा द्रोणस्यासीत् सुविस्मयः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2141479, "chapter_id": 4050, "verse_number": "९६", "content_sanskrit": "तत् प्रवृत्तं चिरं घोरं तयोर्युद्धं महात्मनोः ।\nअवर्तत महारौद्रं लोकसङ्क्षोभकारकम्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2141480, "chapter_id": 4050, "verse_number": "९७", "content_sanskrit": "अथ गाण्डीवमुद्यम्य दिव्यं धनुरमर्षणः ।\nविचकर्ष रणे पार्थो बाहुभ्यां भरतर्षभः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2141481, "chapter_id": 4050, "verse_number": "९८", "content_sanskrit": "तस्य बाणमयं वर्षं शलभानामिवाभवत् ।\nन च बाणान्तरे तस्य वायुः शक्नोति सर्पितुम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2141482, "chapter_id": 4050, "verse_number": "९९", "content_sanskrit": "अभीक्ष्णं सन्दधानस्य बाणानुत्सृजतस्तदा ।\nददृशे नान्तरं किञ्चित् पार्थस्य पततोऽपि च\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2141483, "chapter_id": 4050, "verse_number": "१००", "content_sanskrit": "युद्धे तु कृतशीघ्रास्त्रे वर्तमानेऽतिदारुणे ।\nशीघ्राच्छीघ्रतरं पार्थः शरानन्यानुदैरयत्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2141484, "chapter_id": 4050, "verse_number": "१०१", "content_sanskrit": "ततः शतसहस्राणि शराणां नतपर्वणाम् ।\nयुगपत् प्रापतंस्तत्र द्रोणस्य रथमन्तिकात्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2141485, "chapter_id": 4050, "verse_number": "१०२", "content_sanskrit": "विकीर्यमाणे द्रोणे तु शरैर्गाण्डीवधन्वना ।\nहाहाकारो महानासीत् सैन्यानां भरतर्षभ\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2141486, "chapter_id": 4050, "verse_number": "१०३", "content_sanskrit": "पाण्डवस्य च शीघ्रास्त्रं मघवान् समपूजयत् ।\nगन्धर्वाप्सरसश्चैव ये च तत्र समागताः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2141487, "chapter_id": 4050, "verse_number": "१०४", "content_sanskrit": "द्रोणं युद्धार्णवे मग्नं दृष्ट्वा पुत्रः प्रतापवान् ।\nततो बृन्देन महता रथिनां रथयूथपः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2141488, "chapter_id": 4050, "verse_number": "१०५", "content_sanskrit": "आचार्यपुत्रस्तु शरैः पाण्डवं प्रत्यवारयत् \t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2141489, "chapter_id": 4050, "verse_number": "१०६", "content_sanskrit": "अश्वत्थामा तु तत्कर्म हृदयेन महात्मनः ।\nपूजयामास पार्थस्य कोपं चास्य तदाऽकरोत्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2141490, "chapter_id": 4050, "verse_number": "१०७", "content_sanskrit": "स मन्युवशतामापन्नः पार्थमभ्यद्रवद् रणे ।\nकिरन् शरसहस्राणि पर्जन्य इव वृष्टिमान्\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2141491, "chapter_id": 4050, "verse_number": "१०८", "content_sanskrit": "आवृत्य स महाबाहुर्यतो द्रौणिस्ततो हयान् ।\nअन्तरं प्रददौ पार्थो द्रोणस्य व्यपसर्पितुम्\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2141492, "chapter_id": 4050, "verse_number": "१०९", "content_sanskrit": "स तु लब्धान्तरस्तूर्णमपायाज्जवनैर्हयैः ।\nछिन्नवर्मध्वजरथो निकृत्तः परमेषुभिः\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2141493, "chapter_id": 4050, "verse_number": "११०", "content_sanskrit": "पराजिते रणे द्रोणे द्रोणपुत्रः समागतः ।\nसदण्ड इव रक्ताक्षः कृतान्तः समरे स्थितः\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2141494, "chapter_id": 4050, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि अष्टपञ्चाशोऽध्यायः ॥५८॥ गोग्रहणपर्वणि द्वात्रिंशोऽध्यायः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}]