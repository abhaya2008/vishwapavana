[{"id": 7004518000, "chapter_id": 24518, "verse_number": "५-३-२१२-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nअथान्यत्सम्प्रवक्ष्यामि देवस्य चरितं महत् ।\nश्रुतमात्रेण येनाशु सर्वपापैः प्रमुच्यते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004518001, "chapter_id": 24518, "verse_number": "५-३-२१२-२", "content_sanskrit": "भिक्षुरूपं परं कृत्वा देवदेवो महेश्वरः ।\nएकशालां गतो ग्रामं भिक्षार्थी क्षुत्पिपासितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004518002, "chapter_id": 24518, "verse_number": "५-३-२१२-३", "content_sanskrit": "अक्षसूत्रोद्यतकरो भस्मगुण्ठितविग्रहः ।\nस्फुरत्त्रिशूलो विश्वेशो जटाकुण्डलभूषितः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004518003, "chapter_id": 24518, "verse_number": "५-३-२१२-४", "content_sanskrit": "कृत्तिवासा महाकायो महाहिकृतभूषणः ।\nवादयन्वै डमरुकं डिण्डिमप्रतिमं शुभम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004518004, "chapter_id": 24518, "verse_number": "५-३-२१२-५", "content_sanskrit": "कपालपाणिर्भगवान्बालकैर्बहुभिर्वृतः ।\nक्वचिद्गायन्हसंश्चैव नृत्यन्वदन् क्वचित्क्वचित्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004518005, "chapter_id": 24518, "verse_number": "५-३-२१२-६", "content_sanskrit": "यत्र यत्र गृहे देवो लीलया डिण्डमं न्यसेत् ।\nभाराक्रान्तं गृहं पार्थ तत्रतत्र विनश्यति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004518006, "chapter_id": 24518, "verse_number": "५-३-२१२-७", "content_sanskrit": "एवं सम्प्रचरन् देवो वेष्टितो बहुभिर्जनैः ।\nदृश्यादृश्येन रूपेण निर्जगाम बहिः प्रभुः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004518007, "chapter_id": 24518, "verse_number": "५-३-२१२-८", "content_sanskrit": "इतश्चेतश्च धावन्तं न पश्यन्ति यदा जनाः ।\nविस्मितास्ते स्थिताः शम्भुर्भविष्यति ततोऽस्तुवन्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004518008, "chapter_id": 24518, "verse_number": "५-३-२१२-९", "content_sanskrit": "तेषां तु स्तुवतां भक्त्या शङ्करं जगतां पतिम् ।\nडिण्डिरूपो हि भगवांस्तदासौ प्रत्यदृश्यत॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004518009, "chapter_id": 24518, "verse_number": "५-३-२१२-१०", "content_sanskrit": "तदाप्रभृति देवेशो डिण्डिमेश्वर उच्यते ।\nदर्शनात्स्पर्शनाद्राजन् सर्वपापैः प्रमुच्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]