[{"id": 2042607, "chapter_id": 1952, "verse_number": "६-१-०", "content_sanskrit": "देवीं सरस्वतीं चैव ततो जयमुदीरयेत्|| १", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042608, "chapter_id": 1952, "verse_number": "६-१-१", "content_sanskrit": "जनमेजय उवाच|\nकथं युयुधिरे वीराः कुरुपाण्डवसोमकाः\nपार्थिवाश्च महात्मानो नानादेशसमागताः|| १", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042609, "chapter_id": 1952, "verse_number": "६-१-२", "content_sanskrit": "वैशम्पायन उवाच\nयथा युयुधिरे वीराः कुरुपाण्डवसोमकाः|\nकुरुक्षेत्रे तपःक्षेत्रे शृणु त्वं पृथिवीपते|| २", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042610, "chapter_id": 1952, "verse_number": "६-१-३", "content_sanskrit": "तेऽवतीर्य कुरुक्षेत्रं पाण्डवाः सहसोमकाः|\nकौरवानभ्यवर्तन्त जिगीषन्तो महाबलाः|| ३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042611, "chapter_id": 1952, "verse_number": "६-१-४", "content_sanskrit": "वेदाध्ययनसंपन्नाः सर्वे युद्दाभिनन्दिनः|\nआशंसन्तो जयं युद्धे बलेनाभिमुखा रणे|| ४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042612, "chapter_id": 1952, "verse_number": "६-१-५", "content_sanskrit": "अभियाय च दुर्धर्षां धार्तराष्ट्रस्य वाहिनीं|\nप्राङ्मुखाः पश्चिमे भागे न्यवशन्त ससैनिकाः ५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042613, "chapter_id": 1952, "verse_number": "६-१-६", "content_sanskrit": "स्यमन्तपञ्चकाद्बाह्यं शिबिराणि सहस्रशः|\nकारयामास विधिवत्कुन्तीपुत्रो युधिष्ठिरः|| ६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042614, "chapter_id": 1952, "verse_number": "६-१-७", "content_sanskrit": "शून्येव पृथिवी सर्वा बालवृद्धावशेषिता|\nनिरश्वपुरुषेवासीद्रथकुञ्जरवर्जिता|| ७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042615, "chapter_id": 1952, "verse_number": "६-१-८", "content_sanskrit": "यावत्तपति सुर्यो हि जम्बुद्वीपस्य मण्डलं|\nतावदेव समावृत्तं बलं पार्थिवसत्तम|| ८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042616, "chapter_id": 1952, "verse_number": "६-१-९", "content_sanskrit": "एकस्थाः सर्ववर्णास्ते मण्डलं बहुयोजनम् ।\nपर्याक्रामन्त देशांश्च नदीः शैलान्वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042617, "chapter_id": 1952, "verse_number": "६-१-१०", "content_sanskrit": "तेषां युधिष्ठिरो राजा सर्वेषां पुरुषर्षभ ।\nव्यादिदेश सवाहानां भक्ष्यभोज्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042618, "chapter_id": 1952, "verse_number": "६-१-११", "content_sanskrit": "संज्ञाय विविधास्तात तेषां चक्रे युधिष्ठिरः।\nएवंवादी वेदितव्यः पाण्डवेयोऽयमित्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042619, "chapter_id": 1952, "verse_number": "६-१-१२", "content_sanskrit": "अभिज्ञानानि सर्वेषां संज्ञाश्चाभरणानि च ।\nयोजयामास कौरव्यो युद्धकाल उपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042620, "chapter_id": 1952, "verse_number": "६-१-१३", "content_sanskrit": "दृष्ट्वा ध्वजाग्रं पार्थस्य धार्तराष्ट्रो महामनाः ।\nसह सर्वैर्महीपालैः प्रत्यव्यूहत पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042621, "chapter_id": 1952, "verse_number": "६-१-१४", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nमध्ये नागसहस्रस्य भ्रातृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042622, "chapter_id": 1952, "verse_number": "६-१-१५", "content_sanskrit": "दृष्ट्वा दुर्योधनं हृष्टाः पाञ्चाला युद्धनन्दिनः ।\nदध्मुः प्रीता महाशङ्खान्भेरीर्जघ्नुः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042623, "chapter_id": 1952, "verse_number": "६-१-१६", "content_sanskrit": "ततः प्रहृष्टां स्वां सेनामभिवीक्ष्याथ पाण्डवाः ।\nबभूवुर्हृष्टमनसो वासुदेवश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042624, "chapter_id": 1952, "verse_number": "६-१-१७", "content_sanskrit": "स्वयोधान्हर्षयन्तौ च वासुदेवधनञ्जयौ ।\nदध्मतुः पुरुषव्याघ्रौ दिव्यौ शङ्खौ रथे स्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042625, "chapter_id": 1952, "verse_number": "६-१-१८", "content_sanskrit": "पाञ्चजन्यस्य शङ्खस्य देवदत्तस्य चोभयोः ।\nश्रुत्वा तु निनदं योधाः शकृन्मूत्रं प्रसुस्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042626, "chapter_id": 1952, "verse_number": "६-१-१९", "content_sanskrit": "यथा सिंहस्य नदतः स्वनं श्रुत्वेतरे मृगाः ।\nत्रयेयुर्निनदं श्रुत्वा तथाऽसीदत तद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042627, "chapter_id": 1952, "verse_number": "६-१-२०", "content_sanskrit": "उदतिष्ठद्रजो भौमं न प्राज्ञायत किंचन।\nअस्तं गत इवादित्यः सैन्येन रजसा वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042628, "chapter_id": 1952, "verse_number": "६-१-२१", "content_sanskrit": "सवर्ष तत्र पर्जन्यो मांसशोणितवृष्टिमान्।\nव्युक्षन्सर्वाणि सैन्यानि तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042629, "chapter_id": 1952, "verse_number": "६-१-२२", "content_sanskrit": "वायुस्ततः प्रादूरभून्नीचैः शर्करकर्षणः ।\nविनिघ्नंस्तान्यनीकानि शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042630, "chapter_id": 1952, "verse_number": "६-१-२३", "content_sanskrit": "उभे सैन्ये च राजेन्द्र युद्धाय मुदिते भृशम् ।\nकुरुक्षेत्रे स्थिते यत्ते सागरक्षुभितोपमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042631, "chapter_id": 1952, "verse_number": "६-१-२४", "content_sanskrit": "तयोस्तु सेनयोरासीदद्भुतः स तु संगमः ।\nयुगान्ते समनुप्राप्ते द्वयोः सागरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042632, "chapter_id": 1952, "verse_number": "६-१-२५", "content_sanskrit": "शून्याऽऽसीत्पृथिवी सर्वा वृद्धबालावशेषिता।\nनिरश्वपुरुषेवासीद्रथकुञ्जरवर्जिता।\nतेन सेनासमूहेन समानीतेन कौरवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042633, "chapter_id": 1952, "verse_number": "६-१-२६", "content_sanskrit": "ततस्ते समयं चक्रुः कुरुपाण्डवसोमकाः।\nधर्मान्संस्थापयामासुर्युद्धानां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042634, "chapter_id": 1952, "verse_number": "६-१-२७", "content_sanskrit": "निवृत्ते विहिते युद्धे स्यात्प्रीतिर्नः परस्परम् ।\nयथापरं यथायोगं न च स्यात्कस्यचित्पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042635, "chapter_id": 1952, "verse_number": "६-१-२८", "content_sanskrit": "वाचा युद्धे प्रवृत्तानां वाचैव प्रतियोधनम् ।\nनिष्क्रान्ताः पृतनामध्यान्न हन्तव्याः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042636, "chapter_id": 1952, "verse_number": "६-१-२९", "content_sanskrit": "रथी च रथिना योध्यो गजेन गजधूर्गतः ।\nअश्वेनाश्वी पदातिश्च पादातेनैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042637, "chapter_id": 1952, "verse_number": "६-१-३०", "content_sanskrit": "यथायोगं यथाकामं यथोत्साहं यथाबलम् ।\nसमाभाष्य प्रहर्तव्यं न विश्वस्ते न विह्वले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042638, "chapter_id": 1952, "verse_number": "६-१-३१", "content_sanskrit": "परेण सह संयुक्तः प्रमत्तो विमुखस्तथा ।\nक्षीणशस्त्रो विवर्मा च न हन्तव्यः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042639, "chapter_id": 1952, "verse_number": "६-१-३२", "content_sanskrit": "न सूतेषु न धुर्येषु न च शस्त्रोपनायिषु ।\nन भेरीशङ्खवादेषु प्रहर्तव्यं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042640, "chapter_id": 1952, "verse_number": "६-१-३३", "content_sanskrit": "एवं ते समयं कृत्वा कुरुपाण्डवसोमकाः ।\nविस्मयं परमं जग्मुः प्रेक्षमाणाः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042641, "chapter_id": 1952, "verse_number": "६-१-३४", "content_sanskrit": "निविश्य च महात्मानस्ततस्ते पुरुषर्षभाः ।\nहृष्टरूपाः समुनसो बभूवुः सहसैनिकाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042642, "chapter_id": 1952, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि प्रथमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]