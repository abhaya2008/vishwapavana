[{"id": 7001648000, "chapter_id": 21648, "verse_number": "१-३४-१", "content_sanskrit": "नारद उवाच ।\nसमाख्यातानि सर्वाणि योगाङ्गानि महामुने ।\nइदानीमपि सर्वज्ञ यत्पृच्छामि तदुच्यताम् 1.34.॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001648001, "chapter_id": 21648, "verse_number": "१-३४-२", "content_sanskrit": "योगो भक्तिमतामेव सिध्यतीति त्वयोदितम् ।\nयस्य तुष्यति सर्वेशस्तस्य भक्तिश्च शाश्वतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001648002, "chapter_id": 21648, "verse_number": "१-३४-३", "content_sanskrit": "यथा तुष्यति सर्वेशो देवदेवो जनार्दनः ।\nतन्ममाख्याहि सर्वज्ञ मुने कारुण्यवारिधे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001648003, "chapter_id": 21648, "verse_number": "१-३४-४", "content_sanskrit": "सनक उवाच ।\nनारायणं परं देवं सच्चिदानन्दविग्रहम् ।\nभज सर्वात्मना विप्र यदि मुक्तिमभीप्ससि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001648004, "chapter_id": 21648, "verse_number": "१-३४-५", "content_sanskrit": "रिपवस्तं न हिंसन्ति न बाधन्ते ग्रहाश्च तम् ।\nराक्षसाश्च न चेक्षन्ते नरं विष्णुपरायणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001648005, "chapter_id": 21648, "verse_number": "१-३४-६", "content_sanskrit": "भक्तिर्दृढा भवेद्यस्य देवदेवे जनार्दने ।\nश्रैयांसि तस्य सिध्यन्ति भक्तिमन्तोऽधिकास्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001648006, "chapter_id": 21648, "verse_number": "१-३४-७", "content_sanskrit": "पादौ तौ सफलौ पुंसां यौ विष्णुगृहगामिनौ ।\nतौ करौ सफलौ ज्ञेयौ विष्णुपूजापरौ तु यौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001648007, "chapter_id": 21648, "verse_number": "१-३४-८", "content_sanskrit": "ते नेत्रे सुफले पुंसां पश्यतो ये जनार्दनम् ।\nसा जिह्वा प्रोच्यते सद्भिर्हरिनामपरा तु या ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001648008, "chapter_id": 21648, "verse_number": "१-३४-९", "content_sanskrit": "सत्यं सत्यं पुनः सत्यमुद्धृत्य भुजमुच्यते ।\nतत्त्वं गुरुसमं नास्ति न देवः केशवात्परः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001648009, "chapter_id": 21648, "verse_number": "१-३४-१०", "content_sanskrit": "सत्यं वच्मि हितं वच्मि सारं वच्मि पुनःपुनः ।\nअसारेऽस्मिस्तु संसारे सत्यं हरिसमर्चनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001648010, "chapter_id": 21648, "verse_number": "१-३४-११", "content_sanskrit": "संसारपाशं सुदृढं महामोहप्रदायकम् ।\nहरिभक्तिकुठारेण च्छित्त्वात्यन्तसुखी भव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001648011, "chapter_id": 21648, "verse_number": "१-३४-१२", "content_sanskrit": "तन्मनः संयुतं विष्णौ सा वाणी यत्परायणा ।\nते श्रोत्रे तत्कथासारपूरिते लोकवन्दिते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001648012, "chapter_id": 21648, "verse_number": "१-३४-१३", "content_sanskrit": "आनन्दमक्षरं शून्यमवस्थात्रितयैरपि ।\nआकाशमध्यगं देवं भज नारद सन्ततम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001648013, "chapter_id": 21648, "verse_number": "१-३४-१४", "content_sanskrit": "स्थानं न शक्यते यस्य स्वरूपं वा कदाचन ।\nनिर्देष्टुं मुनिशार्दूल द्र ष्टुं वाप्यकृतात्मभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001648014, "chapter_id": 21648, "verse_number": "१-३४-१५", "content_sanskrit": "समस्तैः करणैर्युक्तो वर्त्ततेऽसौ यदा तदा ।\nजाग्रदित्युच्यते सद्भिरन्तर्यामी सनातनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001648015, "chapter_id": 21648, "verse_number": "१-३४-१६", "content_sanskrit": "यदान्तःकरणैर्युक्तः स्वेच्छया विचरत्यसौ ।\nस्वपन्नित्युच्यते ह्यात्मा यदा स्वापविवर्जितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001648016, "chapter_id": 21648, "verse_number": "१-३४-१७", "content_sanskrit": "न बाह्यकरणैर्युक्तो न चान्तः करणैस्तथा ।\nअस्वरूपो यदात्मासौ पुण्यापुण्यविवर्जितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001648017, "chapter_id": 21648, "verse_number": "१-३४-१८", "content_sanskrit": "सर्वोपाधिविनिर्मुक्तो ह्यानन्दो निर्गुणो विभुः ।\nपरब्रह्ममयो देवः सुषुप्त इति गीयते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001648018, "chapter_id": 21648, "verse_number": "१-३४-१९", "content_sanskrit": "भावनामयमेतद्वै जगत्स्थावरजङ्गमम् ।\nविद्युद्विलोलं विप्रेन्द्र भज तस्माज्जनार्दनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001648019, "chapter_id": 21648, "verse_number": "१-३४-२०", "content_sanskrit": "अहिंसा सत्यमस्तेयं ब्रह्मचर्यापरिग्रहौ ।\nवर्तन्ते यस्य तस्यैव तुष्यते जगतां पतिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001648020, "chapter_id": 21648, "verse_number": "१-३४-२१", "content_sanskrit": "सर्वभूतदयायुक्तो विप्रपूजा परायणः ।\nतस्य तुष्टो जगन्नाथो मधुकैटभमर्दनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001648021, "chapter_id": 21648, "verse_number": "१-३४-२२", "content_sanskrit": "सत्कथायां च रमते सत्कथां च करोति यः ।\nसत्सङ्गो निरहङ्कारस्तस्य प्रीतो रमापतिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001648022, "chapter_id": 21648, "verse_number": "१-३४-२३", "content_sanskrit": "नामसङ्कीर्त्तनं विष्णोः क्षुत्तृट्प्रस्खलितादिषु ।\nकरोति सततं यस्तु तस्य प्रीतो ह्यधोक्षजः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001648023, "chapter_id": 21648, "verse_number": "१-३४-२४", "content_sanskrit": "या तु नारी पतिप्राणा पतिपूजापरायणा ।\nतस्यास्तुष्टो जगन्नाथो ददाति स्वपदं मुने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001648024, "chapter_id": 21648, "verse_number": "१-३४-२५", "content_sanskrit": "असूयारहिता ये तु ह्यहङ्कारविवर्जिताः ।\nदेवपूजापराश्चैव तेषां तुष्यति केशवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001648025, "chapter_id": 21648, "verse_number": "१-३४-२६", "content_sanskrit": "तस्माच्छृणुष्व देवर्षे भजस्व सततं हरिम् ।\nमा कुरुष्व ह्यहङ्कारं विद्युल्लोलश्रिया वृथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001648026, "chapter_id": 21648, "verse_number": "१-३४-२७", "content_sanskrit": "शरीरं मृत्युसंयुक्तं जीवनं चाति चञ्चलम् ।\nराजादिभिर्धनं बाध्यं सम्पदः क्षणभङ्गुराः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001648027, "chapter_id": 21648, "verse_number": "१-३४-२८", "content_sanskrit": "किं न पश्यसि देवर्षे ह्यायुषार्द्धं तु निद्र या ।\nहतं च भोजनाद्यैश्च कियदायुः समाहृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001648028, "chapter_id": 21648, "verse_number": "१-३४-२९", "content_sanskrit": "कियदायुर्बालभावाद् वृद्धभावात्कियद् बृथा ।\nकियद्विषयभोगैश्च कदा धर्मान्करिष्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001648029, "chapter_id": 21648, "verse_number": "१-३४-३०", "content_sanskrit": "बालभावे च वार्द्धक्ये न घटेताच्युतार्चनम् ।\nवयस्येव ततो धर्मान्कुरु त्वमनहङ्कृतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001648030, "chapter_id": 21648, "verse_number": "१-३४-३१", "content_sanskrit": "मा विनाशं व्रज मुने मग्नः संसारगह्वरे ।\nवपुर्विनाशनिलयमापदां परमं पदम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001648031, "chapter_id": 21648, "verse_number": "१-३४-३२", "content_sanskrit": "शरीरं भोगनिलयं मलाद्यैः परिदूषितम् ।\nकिमर्थं शाश्वतधिया कुर्यात्पापं नरो वृथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001648032, "chapter_id": 21648, "verse_number": "१-३४-३३", "content_sanskrit": "असारभूते संसारे नानादुःखसमन्विते ।\nविश्वासो नात्र कर्त्तव्यो निश्चितं मृत्युसङ्कुले ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001648033, "chapter_id": 21648, "verse_number": "१-३४-३४", "content_sanskrit": "तस्माच्छृणुष्व विप्रेन्द्र सत्यमेतद् ब्रवीम्यहम् ।\nदेहयोगनिवृत्यर्थं सद्य एव जनार्दनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001648034, "chapter_id": 21648, "verse_number": "१-३४-३५", "content_sanskrit": "मानं त्यक्त्वा तथा लोभं कामक्रोधविवर्जितः ।\nभजस्व सततं विष्णुं मानुष्यमतिदुर्लभम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001648035, "chapter_id": 21648, "verse_number": "१-३४-३६", "content_sanskrit": "कोटिजन्मसहस्रेषु स्थावरादिषु सत्तम ।\nसम्भ्रान्तस्य तु मानुष्यं कथञ्चित्परिलभ्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001648036, "chapter_id": 21648, "verse_number": "१-३४-३७", "content_sanskrit": "तत्रापि देवताबुद्धिर्दानबुद्धिश्च सत्तम ।\nभोगबुद्धिस्तथा नॄणां जन्मान्तरतपः फलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001648037, "chapter_id": 21648, "verse_number": "१-३४-३८", "content_sanskrit": "मानुष्यं दुर्लभं प्राप्य यो हरिं नार्चयेत्सकृत् ।\nमूर्खः कोऽस्ति परस्तस्माज्जडबुद्धिरचेतनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001648038, "chapter_id": 21648, "verse_number": "१-३४-३९", "content_sanskrit": "दुर्लभं प्राप्य मानुष्यं नार्चयन्ति च ये हरिम् ।\nतेषामतीव मूर्खाणां विवेकः कुत्र तिष्ठति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001648039, "chapter_id": 21648, "verse_number": "१-३४-४०", "content_sanskrit": "आराधितो जगन्नाथो ददात्यभिमतं फलम् ।\nकस्तं न पूजयेद्विप्र संसाराग्निप्रदीपितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001648040, "chapter_id": 21648, "verse_number": "१-३४-४१", "content_sanskrit": "चण्डालोऽपि मुनिश्रेष्ठ विष्णुभक्तो द्विजाधिकः ।\nविष्णुभक्तिविहीनश्च द्विजोऽपि श्वपचाधमः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001648041, "chapter_id": 21648, "verse_number": "१-३४-४२", "content_sanskrit": "तस्मात्कामादिकं त्यक्त्वा भजेत हरिमव्ययम् ।\nयस्मिंस्तुष्टेऽखिलं तुष्येद्यतः सर्वगतो हरिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001648042, "chapter_id": 21648, "verse_number": "१-३४-४३", "content_sanskrit": "यथा हस्तिपदे सर्वं पदमात्रं प्रलीयते ।\nतथा चराचरं विश्वं विष्णावेव प्रलीयते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001648043, "chapter_id": 21648, "verse_number": "१-३४-४४", "content_sanskrit": "आकाशेन यथा व्याप्तं जगत्स्थावरजङ्गमम् ।\nतथैव हरिणा व्याप्तं विश्वमेतच्चराचरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001648044, "chapter_id": 21648, "verse_number": "१-३४-४५", "content_sanskrit": "जन्मनो मरणं नॄणां जन्म वै मृत्युसाधनम् ।\nउभे ते निकटे विद्धि तन्नाशो हरिसेवया ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001648045, "chapter_id": 21648, "verse_number": "१-३४-४६", "content_sanskrit": "ध्यातः स्मृतः पूजितो वा प्रणतो वा जनार्दनः ।\nसंसारपाशविच्छेदी कस्तं न प्रतिपूजयेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001648046, "chapter_id": 21648, "verse_number": "१-३४-४७", "content_sanskrit": "यन्नामोच्चारणादेव महापातकनाशनम् ।\nयं समभ्यर्च्य विप्रर्षे मोक्षभागी भवेन्नरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001648047, "chapter_id": 21648, "verse_number": "१-३४-४८", "content_sanskrit": "अहो चित्रमहो चित्रमहो चित्रमिदं द्विज ।\nहरिनाम्नि स्थिते लोकः संसारे परिवर्त्तते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001648048, "chapter_id": 21648, "verse_number": "१-३४-४९", "content_sanskrit": "भूयो भूयोऽपि वक्ष्यामि सत्यमेतत्तपोधन ।\nनीयमानो यमभटैरशक्तो धर्मसाधनैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001648049, "chapter_id": 21648, "verse_number": "१-३४-५०", "content_sanskrit": "यावन्नेन्द्रि यवैकल्यं यावद्व्याधिर्न बाधते ।\nतावदेवार्चयेद्विष्णुं यदि मुक्तिमभीप्सति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001648050, "chapter_id": 21648, "verse_number": "१-३४-५१", "content_sanskrit": "मातुर्गर्भाद्विनिष्क्रान्तो यदा जन्तुस्तदैव हि ।\nमृत्युः संनिहितो भूयात्तस्माद्धर्मपरो भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001648051, "chapter_id": 21648, "verse_number": "१-३४-५२", "content_sanskrit": "अहो कष्टमहो कष्टमहोकष्टमिदं वपुः ।\nविनश्वरं समाज्ञाय धर्मं नैवाचरत्ययम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001648052, "chapter_id": 21648, "verse_number": "१-३४-५३", "content_sanskrit": "सत्यं सत्यं पुनःसत्यमुद्धृत्य भुजमुच्यते ।\nदम्भाचारं परित्यज्य वासुदेवं समर्चयेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001648053, "chapter_id": 21648, "verse_number": "१-३४-५४", "content_sanskrit": "भूयो भूयो हितं वच्मि भुजमुद्धृत्य नारद ।\nविष्णुः सर्वात्मना पूज्यस्त्याज्यासूया तथानृतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001648054, "chapter_id": 21648, "verse_number": "१-३४-५५", "content_sanskrit": "क्रोधमूलो मनस्तापः क्रोधः संसारबन्धनम् ।\nधर्मक्षयकरः क्रोधस्तस्मात्तं परिवर्जयेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001648055, "chapter_id": 21648, "verse_number": "१-३४-५६", "content_sanskrit": "काममूलमिदं जन्म कामः पापस्य कारणम् ।\nयशःक्षयकरः कामस्तस्मात्तं परिवर्जयेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001648056, "chapter_id": 21648, "verse_number": "१-३४-५७", "content_sanskrit": "समस्तदुःखजालानां मात्सर्यं कारणं स्मृतम् ।\nनरकाणां साधनं च तस्मात्तदपि सन्त्यजेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001648057, "chapter_id": 21648, "verse_number": "१-३४-५८", "content_sanskrit": "मन एव मनुष्याणां कारणं बन्धमोक्षयोः ।\nतस्मात्तदभिसंयोज्य परात्मनि सुखी भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001648058, "chapter_id": 21648, "verse_number": "१-३४-५९", "content_sanskrit": "अहो धैर्यमहो धैर्यमहो धैर्यमहो नृणाम् ।\nविष्णौ स्थिते जगन्नाथे न भजन्ति मदोद्धताः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001648059, "chapter_id": 21648, "verse_number": "१-३४-६०", "content_sanskrit": "अनाराध्य जगन्नाथं सर्वधातारमच्युतम् ।\nसंसारसागरे मग्नाः कथं पारं प्रयान्ति हि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001648060, "chapter_id": 21648, "verse_number": "१-३४-६१", "content_sanskrit": "अच्युतानन्तगोविन्दनामोच्चारणभेषजात् ।\nनश्यन्ति सकला रोगाः सत्यं सत्यं वदाम्यहम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001648061, "chapter_id": 21648, "verse_number": "१-३४-६२", "content_sanskrit": "नारायण जगन्नाथ वासुदेव जनार्दन ।\nइतीरयन्ति ये नित्यं ते वै सर्वत्र वन्दिताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001648062, "chapter_id": 21648, "verse_number": "१-३४-६३", "content_sanskrit": "अद्यापि च मुनिश्रेष्ठ ब्रह्माद्या अपि देवताः ।\nयत्प्रभावं न जानन्ति तं याहि शरणं मुने ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001648063, "chapter_id": 21648, "verse_number": "१-३४-६४", "content_sanskrit": "अहो मौर्ख्यमहो मौर्ख्यमहो मौर्ख्यं दुरात्मनाम् ।\nहृत्पद्मसंस्थितं विष्णुं न विजानन्ति नारद ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001648064, "chapter_id": 21648, "verse_number": "१-३४-६५", "content_sanskrit": "शृणुष्व मुनिशार्दूल भूयो भूयो वदाम्यहम् ।\nहरिः श्रद्धावतां तुष्येन्न धनैर्न च बान्धवैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001648065, "chapter_id": 21648, "verse_number": "१-३४-६६", "content_sanskrit": "बन्धुमत्वं धनाढ्यत्वं पुत्रवत्त्वं च सत्तम ।\nविष्णुभक्तिमतां नॄणां भवेज्जन्मनि जन्मनि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001648066, "chapter_id": 21648, "verse_number": "१-३४-६७", "content_sanskrit": "पापमूलमयं देहः पापकर्मरतस्तथा ।\nएतद्विदित्वा सततं पूजनीयो जनार्दनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001648067, "chapter_id": 21648, "verse_number": "१-३४-६८", "content_sanskrit": "पुत्रमित्रकलत्राद्या बहवः स्युश्च संपदः ।\nहरिपूजारतानां तु भवन्त्येव न संशयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001648068, "chapter_id": 21648, "verse_number": "१-३४-६९", "content_sanskrit": "इहामुत्र सुखप्रेप्सुः पूजयेत्सततं हरिम् ।\nइहामुत्रासुखप्रेप्सुः परनिन्दापरो भवेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001648069, "chapter_id": 21648, "verse_number": "१-३४-७०", "content_sanskrit": "धिग्जन्म भक्तिहीनानां देवदेवे जनार्दने ।\nसत्पात्रदानशून्यं यत्तद्धनं धिक्पुनः पुनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001648070, "chapter_id": 21648, "verse_number": "१-३४-७१", "content_sanskrit": "न नमेद्विष्णवे यस्य शरीरं कर्मभेदिने ।\nपापानामाकरं तद्वै विज्ञेयं मुनिसत्तम ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001648071, "chapter_id": 21648, "verse_number": "१-३४-७२", "content_sanskrit": "सत्पात्रदानरहितं यद्द्र व्यं येन रक्षितम् ।\nचौर्येण रक्षितमिव विद्धि लोकेषु निश्चितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001648072, "chapter_id": 21648, "verse_number": "१-३४-७३", "content_sanskrit": "तडिल्लोलश्रिया मत्ताः क्षणभङ्गुरशालिनः ।\nनाराधयन्ति विश्वेशं पशुपाशविमोचकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001648073, "chapter_id": 21648, "verse_number": "१-३४-७४", "content_sanskrit": "सृष्टिस्तु विविधा प्रोक्ता देवासुरविभेदतः ।\nहरिभक्तियुता दैवी तद्धीना ह्यासुरी महा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001648074, "chapter_id": 21648, "verse_number": "१-३४-७५", "content_sanskrit": "तस्माच्छृणुष्व विप्रेन्द्र हरिभक्तिपरायणाः ।\nश्रेष्ठाः सर्वत्र विख्याता यतो भक्तिः सुदुर्लभा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001648075, "chapter_id": 21648, "verse_number": "१-३४-७६", "content_sanskrit": "असूयारहिता ये च विप्रत्राणपरायणाः ।\nकामादिरहिता ये च तेषां तुष्यति केशवः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001648076, "chapter_id": 21648, "verse_number": "१-३४-७७", "content_sanskrit": "सम्मार्जनादिना ये तु विष्णुशुश्रूषणे रताः ।\nसत्पात्रदाननिरताः प्रयान्ति परमं पदम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]