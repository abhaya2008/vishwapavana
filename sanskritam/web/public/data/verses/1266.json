[{"id": 2012966, "chapter_id": 1266, "verse_number": "२-७-१", "content_sanskrit": "नारद उवाच॥\nशक्रस्य तु सभा दिव्या भास्वरा कर्मनिर्मिता।\nस्वयं शक्रेण कौरव्य निर्जितार्कसमप्रभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012967, "chapter_id": 1266, "verse_number": "२-७-२", "content_sanskrit": "विस्तीर्णा योजनशतं शतमध्यर्धमायता।\nवैहायसी कामगमा पञ्चयोजनमुच्छ्रिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012968, "chapter_id": 1266, "verse_number": "२-७-३", "content_sanskrit": "जराशोकक्लमापेता निरातङ्का शिवा शुभा।\nवेश्मासनवती रम्या दिव्यपादपशोभिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012969, "chapter_id": 1266, "verse_number": "२-७-४", "content_sanskrit": "तस्यां देवेश्वरः पार्थ सभायां परमासने।\nआस्ते शच्या महेन्द्राण्या श्रिया लक्ष्म्या च भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012970, "chapter_id": 1266, "verse_number": "२-७-५", "content_sanskrit": "बिभ्रद्वपुरनिर्देश्यं किरीटी लोहिताङ्गदः।\nविरजोम्बरश्चित्रमाल्यो ह्रीकीर्तिद्युतिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012971, "chapter_id": 1266, "verse_number": "२-७-६", "content_sanskrit": "तस्यामुपासते नित्यं महात्मानं शतक्रतुम्।\nमरुतः सर्वशो राजन्सर्वे च गृहमेधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012972, "chapter_id": 1266, "verse_number": "२-७-७", "content_sanskrit": "सिद्धा देवर्षयश्चैव साध्या देवगणास्तथा।\nमरुत्त्वन्तश्च सहिता भास्वन्तो हेममालिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012973, "chapter_id": 1266, "verse_number": "२-७-८", "content_sanskrit": "एते सानुचराः सर्वे दिव्यरूपाः स्वलङ्कृताः।\nउपासते महात्मान देवराजमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012974, "chapter_id": 1266, "verse_number": "२-७-९", "content_sanskrit": "तथा देवर्षयः सर्वे पार्ते शक्रमुपासते।\nअमला धूतपाप्मानो दीप्यमाना इवाग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012975, "chapter_id": 1266, "verse_number": "२-७-१०", "content_sanskrit": "तेजस्विनः सोमसुतो विशोका विगतज्वराः।\nपराशरः पर्वतश्च तथा सावर्णिगालवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012976, "chapter_id": 1266, "verse_number": "२-७-११", "content_sanskrit": "एकतश्च द्वितश्चैव त्रितश्चैव महामतिः।\nशङ्खश्च लिखितश्चैव तथा गौरशिरा मुनिः।\nदुर्वासाः क्रोधनः श्येनस्तथा दीर्घतमा मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012977, "chapter_id": 1266, "verse_number": "२-७-१२", "content_sanskrit": "पवित्रपाणिः सावर्णिर्याज्ञवल्क्योऽथ भालुकिः।\nउद्दालकः श्वेतकेतुस्ताण्डो भाण्डायनिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012978, "chapter_id": 1266, "verse_number": "२-७-१३", "content_sanskrit": "हविष्मांश्च गरिष्ठश्च हरिश्चन्द्रश्च पार्थिवः॥\nहृद्यश्चोदरशाण्डिल्यः पाराशर्यः कृषीवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012979, "chapter_id": 1266, "verse_number": "२-७-१४", "content_sanskrit": "वातस्कन्धो विशाखश्च विधाता काल एव च।\nकरालदन्तस्त्वष्टा च विश्वकर्मा च तुम्बुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012980, "chapter_id": 1266, "verse_number": "२-७-१५", "content_sanskrit": "अयोनिजा योनिजाश्च वायुभक्षा हुताशिनः।\nईशानं सर्वलोकस्य वज्रिणं समुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012981, "chapter_id": 1266, "verse_number": "२-७-१६", "content_sanskrit": "सहदेवः सुनीथश्च वाल्मीकिश्च महातपाः।\nसमीकः सत्यवाक्चैव प्रचेताः सत्यसङ्गरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012982, "chapter_id": 1266, "verse_number": "२-७-१७", "content_sanskrit": "मेधातिथिर्वामदेवः पुलस्त्यः पुलहः क्रतुः।\nमरुत्तश्च मरीचिश्च स्थाणुश्चात्र महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012983, "chapter_id": 1266, "verse_number": "२-७-१८", "content_sanskrit": "कक्षीवान्गौतमस्तार्क्ष्यस्तथा वैश्वानरो मुनिः।\nमुनिः कालकवृक्षीय आश्राव्योऽथ हिरण्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012984, "chapter_id": 1266, "verse_number": "२-७-१९", "content_sanskrit": "संवर्तो देवहव्यश्च विष्वक्सेनश्च वीर्यवान्।\nदिव्या आपस्तथौषध्यः श्रद्धा मेधा सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012985, "chapter_id": 1266, "verse_number": "२-७-२०", "content_sanskrit": "अर्थो धर्मश्च कामश्च विद्युतश्चैव पाण्डव।\nजलवाहास्तथा मेघा वायवः स्तनयित्नवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012986, "chapter_id": 1266, "verse_number": "२-७-२१", "content_sanskrit": "प्राचीदिग्यज्ञवाहाश्च पावकाः सप्तविंशतिः।\nअग्नीषोमौ तथेन्द्राग्नी मित्रश्च सविताऽर्यमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012987, "chapter_id": 1266, "verse_number": "२-७-२२", "content_sanskrit": "भगो विश्वे साध्याश्च गुरुः शुक्रस्तथैव च।\nविश्वावसुश्चित्रसेनः सुमनस्तरुणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012988, "chapter_id": 1266, "verse_number": "२-७-२३", "content_sanskrit": "यज्ञाश्च दक्षिणाश्चैवं ग्रहास्तोभाश्च भारत।\nयज्ञवाहाश्च ये मन्त्राः सर्वे तत्र समासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012989, "chapter_id": 1266, "verse_number": "२-७-२४", "content_sanskrit": "तथैवाप्सरसो राजन् रम्भोर्वश्यथ मेनका।\nघृताची पञ्चचूडा च विप्रचित्तिपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012990, "chapter_id": 1266, "verse_number": "२-७-२५", "content_sanskrit": "विद्याधराश्च राजेन्द्र गन्धर्वाश्च मनोरमाः।\nनृत्यवादित्रगीतैश्च हास्यैश्च विविधैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012991, "chapter_id": 1266, "verse_number": "२-७-२६", "content_sanskrit": "रमयन्ति स्म नृपते देवराजं शतक्रतुम्।\nस्तुतिभिर्मङ्गलैश्चैव वस्तुवन्तः कर्मभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012992, "chapter_id": 1266, "verse_number": "२-७-२७", "content_sanskrit": "विक्रमैश्च महात्मानं बलवृत्रनिषूदनम्।\nब्रह्मराजर्षयश्चैव सर्वे देवर्षयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012993, "chapter_id": 1266, "verse_number": "२-७-२८", "content_sanskrit": "विमानैर्विविधैर्दिव्यैर्दीप्यमाना इवाग्नयः।\nस्रग्विणो भूषिताः सर्वे यान्ति चायान्ति चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012994, "chapter_id": 1266, "verse_number": "२-७-२९", "content_sanskrit": "बृहस्पतिश्च शुक्रश्च नित्यमास्तां हि तत्र वै॥\nएते चान्ये च बहवो महात्मानो यतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012995, "chapter_id": 1266, "verse_number": "२-७-३०", "content_sanskrit": "विमानैश्चन्द्रसङ्काशैः सोमवत्प्रियदर्शनाः।\nब्रह्मणो वचनाद्राजन्भृगुः सप्तर्षयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012996, "chapter_id": 1266, "verse_number": "२-७-३१", "content_sanskrit": "एषा सभा मया राजन्दृष्टा पुष्करमालिनी।\nशतक्रतोर्महाबाहो याम्यामपि सभां शृणु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012997, "chapter_id": 1266, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि सप्तमोऽध्यायः॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]