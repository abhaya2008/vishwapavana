[{"id": 6000034000, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000034001, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.001.m4a", "display_order": 2}, {"id": 6000034002, "chapter_id": 10034, "verse_number": "३-४-१", "content_sanskrit": "अथ ते तदनुज्ञाता भुक्त्वा पीत्वा च वारुणीम्।\nतया विभ्रंशितज्ञाना दुरुक्तैर्मर्म पस्पृशुः॥ ३/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.002.m4a", "display_order": 3, "topics": [{"text": "मदिरापानमत्तानां यदूनां परस्परं मर्मोक्तिकथनेन क्रोधमुत्पाद्य परस्परेण हत्वा निःशेषं मारणम्", "range": "१–५"}]}, {"id": 6000034003, "chapter_id": 10034, "verse_number": "३-४-२", "content_sanskrit": "तेषां मैरेयदोषेण विषमीकृतचेतसाम्।\nनिम्लोचति रवावासीद् वेणूनामिव मर्दनम्॥ ३/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.003.m4a", "display_order": 4}, {"id": 6000034004, "chapter_id": 10034, "verse_number": "३-४-३", "content_sanskrit": "भगवानात्ममायाया गतिं तामवलोक्य सः।\nसरस्वतीमुपस्पृश्य वृक्षमूलमुपाविशत्॥ ३/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.004.m4a", "display_order": 5}, {"id": 6000034005, "chapter_id": 10034, "verse_number": "३-४-४", "content_sanskrit": "अहं चोक्तो भगवता प्रपन्नार्तिहरेण ह।\nबदरीं त्वं प्रयाहीति स्वकुलं सञ्जिहीर्षुणा॥ ३/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.005.m4a", "display_order": 6}, {"id": 6000034006, "chapter_id": 10034, "verse_number": "३-४-५", "content_sanskrit": "अथापि तदभिप्रेतं जानन्नहमरिंदम।\nपृष्ठतोऽन्वगमं भर्तुः पादविश्लेषणाक्षमः॥ ३/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.006.m4a", "display_order": 7}, {"id": 6000034007, "chapter_id": 10034, "verse_number": "३-४-६", "content_sanskrit": "अद्राक्षमेकमासीनं विचिन्वन् दयितं पतिम्।\nश्रीनिकेतं सरस्वत्यां कृतकेतमकेतनम्॥ ३/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.007.m4a", "display_order": 8, "topics": [{"text": "तदा श्रीकृष्णेन सरस्वतीतीरे किंचिद् वृक्षमूलाश्रयणेन तत्रागतमुद्धवं प्रति मैत्रेयसमक्षं दिव्यज्ञानोपदेशः", "range": "६–१५"}]}, {"id": 6000034008, "chapter_id": 10034, "verse_number": "३-४-७", "content_sanskrit": "श्यामावदातं विरजं प्रशान्तारुणलोचनम्।\nदोर्भिश्चतुर्भिर्विदितं पीतकौशाम्बरेण च॥ ३/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.008.m4a", "display_order": 9}, {"id": 6000034009, "chapter_id": 10034, "verse_number": "३-४-८", "content_sanskrit": "वाम ऊरावधिश्रित्य दक्षिणाङ्घ्रिसरोरुहम्।\nअपाश्रितार्भकावस्थम् अकृशं त्यक्तपिप्पलम्॥ ३/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.009.m4a", "display_order": 10}, {"id": 6000034010, "chapter_id": 10034, "verse_number": "३-४-९", "content_sanskrit": "तस्मिन् महाभागवतो द्वैपायनसुहृत् सखा।\nलोकाननुचरन् सिद्ध आससाद यदृच्छया॥ ३/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.010.m4a", "display_order": 11}, {"id": 6000034011, "chapter_id": 10034, "verse_number": "३-४-१०", "content_sanskrit": "तस्यानुरक्तस्य मुनेर्मुकुन्दः प्रमोदभारानतकन्धरस्य।\nआशृृण्वतो मामनुरागहाससमीक्षया विश्रमयन्नुवाच॥ ३/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.011.m4a", "display_order": 12}, {"id": 6000034012, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.012.m4a", "display_order": 13}, {"id": 6000034013, "chapter_id": 10034, "verse_number": "३-४-११", "content_sanskrit": "वेदाहमन्तर्मनसीप्सितं ते ददामि यत् तद् दुरवापमन्यैः।\nसत्रे पुरा विश्वसृजां मनूनां मत्सिद्धिकामेन वसो त्वयेष्टः॥ ३/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.013.m4a", "display_order": 14}, {"id": 6000034014, "chapter_id": 10034, "verse_number": "३-४-१२", "content_sanskrit": "स एष साधो चरमो भवानामासादितस्ते मदनुग्रहोऽयम्।\nयन्मां नृलोकान् रह उत्सृजन्तं दिष्ट्या ददृश्वान् विशदानुवृत्त्या॥ ३/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.014.m4a", "display_order": 15}, {"id": 6000034015, "chapter_id": 10034, "verse_number": "३-४-१३", "content_sanskrit": "पुरा मया प्रोक्तमजाय नाभ्ये पद्मे निषण्णाय ममादिसर्गे।\nज्ञानं परं मन्महिमावभासं यत् सूरयो भागवतं वदन्ति॥ ३/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.015.m4a", "display_order": 16}, {"id": 6000034016, "chapter_id": 10034, "verse_number": "३-४-१४", "content_sanskrit": "इत्यादरोक्तः परमस्य पुंसः प्रतीक्षणानुग्रहभाजनोऽहम्।\nस्नेहोत्थरोमा स्खलिताक्षरस्तं मुञ्चन् शुचः प्राञ्जलिराबभाषे॥ ३/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.016.m4a", "display_order": 17}, {"id": 6000034017, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.017.m4a", "display_order": 18}, {"id": 6000034018, "chapter_id": 10034, "verse_number": "३-४-१५", "content_sanskrit": "को न्वीश ते पादसरोजभाजां सुदुर्लभोऽर्थेषु चतुर्ष्वपीह।\nतथाऽपि नाहं प्रवृणोमि भूमन् भवत्पदाम्भोजनिषेवणोत्सुकः॥ ३/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.018.m4a", "display_order": 19}, {"id": 6000034019, "chapter_id": 10034, "verse_number": "३-४-१६", "content_sanskrit": "कर्माण्यनीहस्य भवोऽभवस्य ते दुर्गाश्रयोऽथारिभयात् पलायनम्।\nकालात्मनो यत् प्रमदायुताश्रयः स्वात्मन् रतेः खिद्यति धीर्विदामपि॥ ३/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.019.m4a", "display_order": 20, "topics": [{"text": "ततो निर्गतेनोद्धवेन विदुरं प्रति यदुकुलक्षयनिवेदनपूर्वकं स्वस्य बदरिकाश्रमगमनोद्यमनिवेदनम्॥ विदुरेण स्वस्य ज्ञानोपदेशं प्रार्थितेन उद्धवेन ‘श्रीकृष्णाज्ञया तव मैत्रेयो ज्ञानोपदेशं करिष्यति’ इत्युक्त्वा बदरिकाश्रमगमनम्", "range": "१५–२२"}]}, {"id": 6000034020, "chapter_id": 10034, "verse_number": "३-४-१७", "content_sanskrit": "मन्त्रेषु मां वा उपहूय यत् त्वमकुण्ठिताखण्डसदात्मबोधः।\nपृच्छेः प्रभो मुग्ध इवाप्रमत्तस्तन्नो मनो मोहयतीव देव॥ ३/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.020.m4a", "display_order": 21}, {"id": 6000034021, "chapter_id": 10034, "verse_number": "३-४-१८", "content_sanskrit": "ज्ञानं परं स्वात्मरहः प्रकाशं प्रोवाच कस्मै भगवान् समग्रम्।\nअपि क्षमं नो ग्रहणाय भर्तर्वेदाञ्जसा यद् वृजिनं तरेम॥ ३/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.021.m4a", "display_order": 22}, {"id": 6000034022, "chapter_id": 10034, "verse_number": "३-४-१९", "content_sanskrit": "इत्यावेदितहार्दाय मह्यं स भगवान् परः।\nआदिदेशारविन्दाक्ष आत्मनः परमां स्थितिम्॥ ३/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.022.m4a", "display_order": 23}, {"id": 6000034023, "chapter_id": 10034, "verse_number": "३-४-२०", "content_sanskrit": "स एवमाराधितपादतीर्थादधीततत्त्वात्मविबोधमार्गः।\nप्रणम्य पादौ परिवृत्य देवमिहागतोऽहं विरहातुरात्मा॥ ३/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.023.m4a", "display_order": 24}, {"id": 6000034024, "chapter_id": 10034, "verse_number": "३-४-२१", "content_sanskrit": "सोऽहं त्वद्दर्शनाह्लादवियोगार्तियुतः प्रभो।\nगमिष्ये दयितं तस्य बदर्याश्रममण्डलम्॥ ३/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.024.m4a", "display_order": 25}, {"id": 6000034025, "chapter_id": 10034, "verse_number": "३-४-२२", "content_sanskrit": "यत्र नारायणो देवो नरश्च भगवान् ऋषिः।\nमृदु तीव्रं तपो दीर्घं तेपाते लोकभावनौ॥ ३/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.025.m4a", "display_order": 26}, {"id": 6000034026, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.026.m4a", "display_order": 27}, {"id": 6000034027, "chapter_id": 10034, "verse_number": "३-४-२३", "content_sanskrit": "इत्युद्धवादुपाकर्ण्य सुहृदां दुःसहं वधम्।\nज्ञानेनाशमयत् क्षत्ता शोकमुत्पतितं बुधः॥ ३/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.027.m4a", "display_order": 28, "topics": [{"text": "ततो यादवनाशं श्रीकृष्णस्य वैकुण्ठगमनं च श्रुतवता विदुरेण मैत्रेयदिदृक्षया गङ्गातीरगमनम्", "range": "२३–३६"}]}, {"id": 6000034028, "chapter_id": 10034, "verse_number": "३-४-२४", "content_sanskrit": "स तं महाभागवतं व्रजन्तं कौरवर्षभः।\nविश्रम्भादभ्यधत्तेदं मुख्यं कृष्णपरिग्रहे॥ ३/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.028.m4a", "display_order": 29}, {"id": 6000034029, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.029.m4a", "display_order": 30}, {"id": 6000034030, "chapter_id": 10034, "verse_number": "३-४-२५", "content_sanskrit": "ज्ञानं परं स्वात्मरहः प्रकाशं यदाह योगेश्वर ईश्वरस्ते।\nवक्तुं भवान् नोऽर्हति यद्धि विष्णोर्भृत्याः स्वभृत्यार्थकृतश्चरन्ति॥ ३/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.030.m4a", "display_order": 31}, {"id": 6000034031, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.031.m4a", "display_order": 32}, {"id": 6000034032, "chapter_id": 10034, "verse_number": "३-४-२६", "content_sanskrit": "ननु ते तत्त्वसंराद्ध ऋषिः कौषारवोऽन्ति मे।\nसाक्षाद् भगवताऽऽदिष्टो मर्त्यलोकं जिहासता॥ ३/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.032.m4a", "display_order": 33}, {"id": 6000034033, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.033.m4a", "display_order": 34}, {"id": 6000034034, "chapter_id": 10034, "verse_number": "३-४-२७", "content_sanskrit": "इति सह विदुरेण विश्वमूर्तेर्गुणकथया सुधया प्लुतोरुतापः।\nक्षणमिव पुलिने यमस्वसुस्तां समुषित औपगविर्निशां ततोऽगात्॥ ३/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.034.m4a", "display_order": 35}, {"id": 6000034035, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.035.m4a", "display_order": 36}, {"id": 6000034036, "chapter_id": 10034, "verse_number": "३-४-२८", "content_sanskrit": "निधनमुपगतेषु वृष्णिभोजेष्वधिरथयूथपयूथपेषु मुख्यः।\nस तु कथमवशिष्ट उद्धवो यद्धरिरपि तत्यज आकृतिं त्र्यधीशः॥ ३/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.036.m4a", "display_order": 37}, {"id": 6000034037, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.037.m4a", "display_order": 38}, {"id": 6000034038, "chapter_id": 10034, "verse_number": "३-४-२९", "content_sanskrit": "ब्रह्मशापापदेशेन कालेनामोघवाञ्छितः।\nसंहृत्य स्वकुलं नूनं त्यक्ष्यन् देहमचिन्तयत्॥ ३/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.038.m4a", "display_order": 39}, {"id": 6000034039, "chapter_id": 10034, "verse_number": "३-४-३०", "content_sanskrit": "अस्माल्लोकादुपरते मयि ज्ञानं मदाश्रयम्।\nअर्हत्युद्धव एवाद्धा सम्प्रत्यात्मवतां परः॥ ३/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.039.m4a", "display_order": 40}, {"id": 6000034040, "chapter_id": 10034, "verse_number": "३-४-३१", "content_sanskrit": "नोद्धवोऽण्वपि मन्न्यूनो यद्गुणैर्निर्जितः प्रभुः।\nअतो मद्वत् पुनर्लोकं ग्राहयन्निह तिष्ठतु॥ ३/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.040.m4a", "display_order": 41}, {"id": 6000034041, "chapter_id": 10034, "verse_number": "३-४-३२", "content_sanskrit": "एवं त्रिलोकगुरुणा सन्दिष्टः शब्दयोनिना।\nबदर्याश्रममासाद्य हरिमीजे समाधिना॥ ३/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.041.m4a", "display_order": 42}, {"id": 6000034042, "chapter_id": 10034, "verse_number": "३-४-३३", "content_sanskrit": "विदुरोऽप्युद्धवात् श्रुत्वा कृष्णस्य परमात्मनः।\nक्रीडयोपात्तदेहस्य कर्माणि श्लाघितानि च॥ ३/४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.042.m4a", "display_order": 43}, {"id": 6000034043, "chapter_id": 10034, "verse_number": "३-४-३४", "content_sanskrit": "देहन्यासं च तस्यैवं धीराणां धैर्यवर्धनम्।\nअन्येषां दुष्करतरं पशूनां विक्लवात्मनाम्॥ ३/४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.043.m4a", "display_order": 44}, {"id": 6000034044, "chapter_id": 10034, "verse_number": "३-४-३५", "content_sanskrit": "आत्मानं च कुरुश्रेष्ठ कृष्णेन मनसेक्षितम्।\nध्यायन् गते भागवते रुरोद प्रेमविह्वलः॥ ३/४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.044.m4a", "display_order": 45}, {"id": 6000034045, "chapter_id": 10034, "verse_number": "३-४-३६", "content_sanskrit": "कालिन्द्याः कतिभिर्विद्वानहोभिर्भरतर्षभ।\nप्रापद्यत द्युसरितं यत्र मित्रासुतो मुनिः॥ ३/४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_004/BhP_03.004.045.m4a", "display_order": 46}, {"id": 6000034046, "chapter_id": 10034, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]