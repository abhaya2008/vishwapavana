[{"id": 50002590, "chapter_id": 10635, "verse_number": "1", "content_sanskrit": "इहैव तैर्जितः सर्गो येषां साम्ये स्थितं मनः। निर्दोषं हि समं ब्रह्म तस्माद् ब्रह्मणि ते स्थिताः॥ ५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002591, "chapter_id": 10635, "verse_number": "2", "content_sanskrit": "॥ सन्न्यासयोगज्ञानानां मिलित्वा प्रपञ्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]