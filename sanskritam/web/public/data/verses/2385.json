[{"id": 2065486, "chapter_id": 2385, "verse_number": "९-१६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065487, "chapter_id": 2385, "verse_number": "९-१६-१", "content_sanskrit": "शृणु राजन्नवहितो यथावृत्तो महान्क्षयः।\nकुरूणां पाण्डवानां च समासाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065488, "chapter_id": 2385, "verse_number": "९-१६-२", "content_sanskrit": "निहते सूतपुत्रे च फल्गुनेन महात्मना।\nविद्रुतेषु च सैन्येषु समानीतेषु चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065489, "chapter_id": 2385, "verse_number": "९-१६-३", "content_sanskrit": "विमुखे तव पुत्रे च शोकोपहतचेतसि।\nभृशोद्विग्नेषु सैन्येषु दृष्ट्वा पार्थस्य विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065490, "chapter_id": 2385, "verse_number": "९-१६-४", "content_sanskrit": "ध्यायमानेषु योधेषु दुऋखं प्राप्तेषु भारत।\nबलानां मत्यमानानां श्रुत्वा निनदमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065491, "chapter_id": 2385, "verse_number": "९-१६-५", "content_sanskrit": "अभिज्ञानं नरेन्द्राणां विकृतं प्रेक्ष्य संयुगे।\nपतितानवनीपालान्धवजांश्चैव महात्मनाम्।\nरणे विनिहतान्नागान्दृष्ट्वा पत्तींश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065492, "chapter_id": 2385, "verse_number": "९-१६-६", "content_sanskrit": "आयोधनं महाघोरं रुद्रस्याक्रीडसन्निभम्।\nअप्रख्यातिं गतानां तु राज्ञां शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065493, "chapter_id": 2385, "verse_number": "९-१६-७", "content_sanskrit": "कृपाविष्टः कृपो दृष्ट्वा वयः शीलसमन्वितः।\nअब्रवीत्तत्र तेजस्वी सोऽभिसृत्य जनाधिपम्।\nदुर्योधनमनुक्रोशाद्वाक्यं वाक्यविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065494, "chapter_id": 2385, "verse_number": "९-१६-८", "content_sanskrit": "दुर्योधन निबोधेयं यत्त्वां वक्ष्यामि कौरव।\nश्रुत्वा कुरु महाराज यदि ते रोचतेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065495, "chapter_id": 2385, "verse_number": "९-१६-९", "content_sanskrit": "न युद्धधर्माच्छ्रेयान्वै पन्था राजेन्द्र विद्यते।\nयं समाश्रित्य युध्यन्ते क्षत्रियाः क्षत्रियर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065496, "chapter_id": 2385, "verse_number": "९-१६-१०", "content_sanskrit": "पुत्रो भ्राता पिता चैव स्वस्रीयो मातुलस्तथा।\nसम्बन्धिबान्धवाश्चैव योद्वव्याः क्षत्रजीविन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065497, "chapter_id": 2385, "verse_number": "९-१६-११", "content_sanskrit": "वधे चैव परो धर्मस्तथाऽधर्मः पलायने।\nते स्म घोरां समापन्ना जीविकां जीवितार्थिनः।\nतदत्र प्रतिवक्ष्यामि किञ्चिदेव हितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065498, "chapter_id": 2385, "verse_number": "९-१६-१२", "content_sanskrit": "हते भीष्मे च द्रोणे च कर्णे चैव महारथे।\nजयद्रथे च निहते तव भ्रातृषु चानघ।\nलक्ष्मणे तव पुत्रे च किं शेषं पर्युपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065499, "chapter_id": 2385, "verse_number": "९-१६-१३", "content_sanskrit": "येषु भारं समासज्य राज्ये मतिमकुर्महि।\nते सन्त्यज्य तनूर्याताः शूरा ब्रह्मविदां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065500, "chapter_id": 2385, "verse_number": "९-१६-१४", "content_sanskrit": "वयं त्विह विनाभूता गुणवद्भिर्महारथैः।\nकृपणं वर्तयिष्यामः पातयित्वा नृपान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065501, "chapter_id": 2385, "verse_number": "९-१६-१५", "content_sanskrit": "सर्वैरथ च जीवद्भिर्बीभत्सुरपराजितः।\nकृष्णनेत्रो महाबाहुर्देवैरपि दुरासदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065502, "chapter_id": 2385, "verse_number": "९-१६-१६", "content_sanskrit": "इन्द्रकार्मुकवज्राभमिन्द्रकेतुमिवोच्छ्रितम्।\nवानरं केतुमासाद्य सञ्चचाल महाचमूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065503, "chapter_id": 2385, "verse_number": "९-१६-१७", "content_sanskrit": "सिंहनादेन भीमस्य पाञ्चजन्यस्वनेन च।\nगाण्डीवस्य च निर्घोषात्सम्मुह्यन्ते मनांसि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065504, "chapter_id": 2385, "verse_number": "९-१६-१८", "content_sanskrit": "स्फुरन्तीव महाविद्युन्मुष्णन्ती नयनप्रभाम्।\nअलातमिव चाविद्वं गाण्डवीं समदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065505, "chapter_id": 2385, "verse_number": "९-१६-१९", "content_sanskrit": "जाम्बूनदविचित्रं च धूयमानं महद्धनुः।\nदृश्यते दिक्षु स्रवासु विद्युदभ्रघनेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065506, "chapter_id": 2385, "verse_number": "९-१६-२०", "content_sanskrit": "उह्यमानश्च कृष्णेन वायुनेव बलाहकः।\nतावकं तद्बलं राजन्नर्जुनोऽस्त्रविशारदः।\nगहनं शिशिरापाये ददाहाग्निरिवोल्बणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065507, "chapter_id": 2385, "verse_number": "९-१६-२१", "content_sanskrit": "गाहमानमनीकानि महेन्द्रसदृशप्रभम्।\nविक्षोभयन्तं सेनां वै त्रासयन्तं च पार्थिवान्।\nधनञ्जयमपश्याम नलिनीमिव कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065508, "chapter_id": 2385, "verse_number": "९-१६-२२", "content_sanskrit": "त्रासयन्तं तथा योधान्धनुर्घोषेण पांण्डवम्।\nभूय एनमपश्याम सिंहं मृगगणानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065509, "chapter_id": 2385, "verse_number": "९-१६-२३", "content_sanskrit": "सर्वलोकमहेष्वासो वृषभौ सर्वधन्विनाम्।\nआमुक्तकवचौ कृष्णौ लोकमध्ये विरेजतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065510, "chapter_id": 2385, "verse_number": "९-१६-२४", "content_sanskrit": "अद्य सप्तदशाहानि वर्तमानस्य भारत।\nसङ्ग्रामस्यातिघोरस्य युध्यतां चाभितो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065511, "chapter_id": 2385, "verse_number": "९-१६-२५", "content_sanskrit": "वायुनेव विधूतानि एव सैन्यानि गच्छता।\nशरदम्भोदजालानि विशीर्यन्ते समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065512, "chapter_id": 2385, "verse_number": "९-१६-२६", "content_sanskrit": "तां नावमिव पर्यस्तां मज्जमानां महार्णवे।\nतव सेनां महाराज सव्यसाची व्यकम्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065513, "chapter_id": 2385, "verse_number": "९-१६-२७", "content_sanskrit": "क्वनु ते सूतपुत्रोऽभूत्क्वनु द्रोणः सहात्मजः।\nअहं क्व च क्व चात्मा ते हार्दिक्यश्च तथा क्वनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065514, "chapter_id": 2385, "verse_number": "९-१६-२८", "content_sanskrit": "दुःशासनश्च ते भ्राता भ्रातृभिः सहितः क्वनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065515, "chapter_id": 2385, "verse_number": "९-१६-२९", "content_sanskrit": "वाणगोचरसम्प्राप्तं युध्यमानं जयद्रथम्।\nसम्बन्धिनस्ते भ्रातॄंश्च साहयान्मातुलांस्तथा।\nसर्वान्विक्रम्य मिपतो लोकमाक्रम्य मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065516, "chapter_id": 2385, "verse_number": "९-१६-३०", "content_sanskrit": "जयद्रथो हतो राजन्किन्नु शेषमुपास्महे।\nको वेह स पुमानास्ते यो विजेष्यति पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065517, "chapter_id": 2385, "verse_number": "९-१६-३१", "content_sanskrit": "तस्य चास्त्राणि दिव्यानि विदितानि महात्मनः।\nगाण्डीवस्य च निर्घोषो धैर्याणि हरते हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065518, "chapter_id": 2385, "verse_number": "९-१६-३२", "content_sanskrit": "नष्टचन्द्रा यथा रात्रिः सेनेयं हतनायका।\nनागभग्नद्रुमा शुष्का नदीव प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065519, "chapter_id": 2385, "verse_number": "९-१६-३३", "content_sanskrit": "ध्वजिन्यां हतनेत्रायां यथेष्टं श्वेतवाहनः।\nचरिष्यति महाराजः कक्षेष्वग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065520, "chapter_id": 2385, "verse_number": "९-१६-३४", "content_sanskrit": "सात्यकेश्चैव यो वेगो भीमसेनस्य चोभयोः।\nदारयेत गिरीन्सर्वाञ्शोषयेच्चैव सागरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065521, "chapter_id": 2385, "verse_number": "९-१६-३५", "content_sanskrit": "उवाच वाक्यं यद्भीमः सभामध्ये विशाम्पते।\nकृतं तत्सफलं सर्वं भूयश्चैव करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065522, "chapter_id": 2385, "verse_number": "९-१६-३६", "content_sanskrit": "प्रमुखस्थे तदा कर्णे बलं पाण्डवरक्षितम्।\nदुरासदं तदा गुप्तं व्यूढं गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065523, "chapter_id": 2385, "verse_number": "९-१६-३७", "content_sanskrit": "युष्माभिस्तानि चीर्णानि यान्यसाधूनि साधुषु।\nअकारणकृतान्येव तेषां वः फलमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065524, "chapter_id": 2385, "verse_number": "९-१६-३८", "content_sanskrit": "आत्मनोऽर्थे त्वया लोके यत्नतः सर्व आहृतः।\nस ते संशयितस्तात आत्मा च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065525, "chapter_id": 2385, "verse_number": "९-१६-३९", "content_sanskrit": "रक्ष दुर्योधनात्मानमात्मा सर्वस्य भाजनम्।\nभिन्ने हि भाजने तात दिशो गच्छति तद्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065526, "chapter_id": 2385, "verse_number": "९-१६-४०", "content_sanskrit": "हीयमानेन वै सन्धिः पर्येष्टव्यः समेन वा।\nविग्रहो वर्धमानेन नीतिरेषा बृहस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065527, "chapter_id": 2385, "verse_number": "९-१६-४१", "content_sanskrit": "ते वयं पाण्डुपुत्रेभ्यो हीनाः स्म बलशक्तितः।\nअत्र ते पाण्डवैः सार्धं सन्धिं मन्ये क्षमं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065528, "chapter_id": 2385, "verse_number": "९-१६-४२", "content_sanskrit": "न जानीते हि यः श्रेयः श्रेयसश्चावमन्यते।\nस क्षिप्रं भ्रश्यते राज्यान्न च श्रेयोऽनुविन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065529, "chapter_id": 2385, "verse_number": "९-१६-४३", "content_sanskrit": "अणिपत्य हि राजानं राज्यं यदि लभेमहि।\nश्रेयः स्यान्न तु मौढ्येन राजन्गन्तुं पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065530, "chapter_id": 2385, "verse_number": "९-१६-४४", "content_sanskrit": "वैचित्रवीर्यवचनात्कृपाशीलो युधिष्ठिरः।\nविनियुञ्जीत राज्ये त्वां गोविन्दवचनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065531, "chapter_id": 2385, "verse_number": "९-१६-४५", "content_sanskrit": "`अजातशत्रुः कौरव्यो गुरुशुश्रूषणे रतः।\nधृतराष्ट्रस्य वचनं नावमंस्यति धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065532, "chapter_id": 2385, "verse_number": "९-१६-४६", "content_sanskrit": "कुर्वन्ति भ्रातरश्चास्य वचनं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065533, "chapter_id": 2385, "verse_number": "९-१६-४७", "content_sanskrit": "यद्ब्रूयाद्धि हृषीकेशो राजानमपराजितम्।\nअर्जुनो भीमसेनश्च सर्वे कुर्युरसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065534, "chapter_id": 2385, "verse_number": "९-१६-४८", "content_sanskrit": "नातिक्रमिष्यते कृष्णो वचनं पाण्डवस्य तु।\nधृतराष्ट्रस्य मन्येऽहं नापि कृष्णस्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065535, "chapter_id": 2385, "verse_number": "९-१६-४९", "content_sanskrit": "एतत्क्षममहं मन्ये तव पार्थैरविग्रहम्।\nन त्वां ब्रवीमि कार्पण्यान्न प्राणपरिरक्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065536, "chapter_id": 2385, "verse_number": "९-१६-५०", "content_sanskrit": "पथ्यं राजन्ब्रवीमि त्वां तत्परासुः स्मरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065537, "chapter_id": 2385, "verse_number": "९-१६-५१", "content_sanskrit": "इति वृद्धो विलप्यैतत्कृपः शारद्वतो वचः।\nदीर्घमुष्णं च निःश्वस्यशुशोच च मुमोह च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065538, "chapter_id": 2385, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]