[{"id": 2018330, "chapter_id": 1381, "verse_number": "३-१९-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018331, "chapter_id": 1381, "verse_number": "३-१९-१", "content_sanskrit": "एवमुक्तस्तु कौन्तेय सूतपुत्रस्ततो मृधे।\nप्रद्युम्नमब्रवीच्छ्लक्ष्णं मधुरं वाक्यमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018332, "chapter_id": 1381, "verse_number": "३-१९-२", "content_sanskrit": "न मे भयं रौक्मिणेय संग्रामे यच्छतो हयान्।\nयुद्धज्ञोस्मि च वृष्णीनां नात्र किंचिदतोऽन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018333, "chapter_id": 1381, "verse_number": "३-१९-३", "content_sanskrit": "आयुष्मन्नुपदेशस्तु सारथ्ये वर्ततां स्मृतः।\nसर्वार्थेषु रथी रक्ष्यस्त्वं चापि भृशपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018334, "chapter_id": 1381, "verse_number": "३-१९-४", "content_sanskrit": "त्वं हि साल्वप्रयुक्तेन शरेणाभिहतो भृशम्।\nकश्मलाभिहतो वीर ततोऽहमपयातवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018335, "chapter_id": 1381, "verse_number": "३-१९-५", "content_sanskrit": "सत्वं सात्वतमुख्याद्य लब्धसंज्ञो यदृच्छया।\nपश्य मे हयसंयाने शिक्षां केशवनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018336, "chapter_id": 1381, "verse_number": "३-१९-६", "content_sanskrit": "दारुकेणाहमुत्पन्नो यथावच्चैव शिक्षितः।\nवीतभीः प्रविशाम्येतां साल्वस्य महतीं चमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018337, "chapter_id": 1381, "verse_number": "३-१९-७x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018338, "chapter_id": 1381, "verse_number": "३-१९-७", "content_sanskrit": "एवमुक्त्वा ततो वीरो हयान्संचोद्य संगरे।\nरश्मिभिस्तु समुद्यम्य जवेनाभ्यपतत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018339, "chapter_id": 1381, "verse_number": "३-१९-८", "content_sanskrit": "मण्डलानि विचित्राणि यमकानीतराणि च।\nसव्यानि च विचित्राणि दक्षिणानि च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018340, "chapter_id": 1381, "verse_number": "३-१९-९", "content_sanskrit": "प्रतोदेनाहता राजन्रश्मिभिश्च समुद्यताः।\nउत्पतन्त इवाकाशं विबभुस्ते हयोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018341, "chapter_id": 1381, "verse_number": "३-१९-१०", "content_sanskrit": "ते हस्तलाघवोपेतं विज्ञाय नृप दारुकिम्।\nउह्यमाना इव तदा नास्पृशंश्चरणैर्महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018342, "chapter_id": 1381, "verse_number": "३-१९-११", "content_sanskrit": "सोपसव्यां चमूं तस्य साल्वस्य भरतर्षभ।\nचकार नातियत्नेन तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018343, "chapter_id": 1381, "verse_number": "३-१९-१२", "content_sanskrit": "अमृष्यमाणोपसव्यं साल्वः समितिदारुणः।\nयन्तारमस्य सहसा त्रिभिर्बाणैः समार्दयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018344, "chapter_id": 1381, "verse_number": "३-१९-१३", "content_sanskrit": "दारुकस्य सुतस्तं तु बाणवेगमचिन्तयन्।\nभूय एव महाबाहो प्रययावपसव्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018345, "chapter_id": 1381, "verse_number": "३-१९-१४", "content_sanskrit": "ततो बाणान्बहुविधान्पुनरेव स सौभराट्।\nमुमोच तनये वीर मम रुक्मिणिनन्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018346, "chapter_id": 1381, "verse_number": "३-१९-१५", "content_sanskrit": "तानप्राप्ताञ्शितैर्ब्राणैश्चिच्छेद परवीरहा।\nरौक्मिणेयः स्मितं कृत्वा दर्शयन्हस्तलाघवं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018347, "chapter_id": 1381, "verse_number": "३-१९-१६", "content_sanskrit": "छिन्नान्दृष्ट्वा तु तान्बाणान्प्रद्युम्नेन च सौभराट्।\nआसुरीं दारुणीं मायामास्थाय व्यसृजच्छरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018348, "chapter_id": 1381, "verse_number": "३-१९-१७", "content_sanskrit": "प्रयुज्यमानमाज्ञाय दैतेयास्त्रं महाबलम्।\nब्रह्मास्त्रेणान्तरा च्छित्त्वामुमोचान्यन्पतस्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018349, "chapter_id": 1381, "verse_number": "३-१९-१८", "content_sanskrit": "ते तदस्त्रं विधूयाशु विव्यधू रुधिराशनाः।\nशिरस्युरसि वक्रे च स मुमोह पपात च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018350, "chapter_id": 1381, "verse_number": "३-१९-१९", "content_sanskrit": "तस्मिन्निपतिते क्षुद्रे साल्वे बाणप्रपीडिते।\nरौक्मिणेयोऽपरं बाणं संदधे शत्रतापनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018351, "chapter_id": 1381, "verse_number": "३-१९-२०", "content_sanskrit": "तमर्चितं सर्वदाशार्हपूगै-\nराशीर्भिरर्कज्वलनप्रकाशम्।\nदृष्ट्वा शरं ज्यामभिनीयमानं\nबभूव हाहाकृतमन्तरिक्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018352, "chapter_id": 1381, "verse_number": "३-१९-२१", "content_sanskrit": "ततो देवगणाः सर्वे सेन्द्राः सहधनेश्वराः।\nनारदं प्रेषयामासु- श्वसनं च मनोजवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018353, "chapter_id": 1381, "verse_number": "३-१९-२२", "content_sanskrit": "तौ रौक्मिणेयमागम्य वचोऽब्रूतां दिवौकसाम्।\nनैव वध्यस्त्वया वीर साल्वराजः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018354, "chapter_id": 1381, "verse_number": "३-१९-२३", "content_sanskrit": "संहरस्व पुनर्बाणमवध्योऽयं त्वया रणे।\nएतस्य च शरस्याजौ नावध्योस्ति पुमान्क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018355, "chapter_id": 1381, "verse_number": "३-१९-२४", "content_sanskrit": "मृत्युरस्य महाबाहो रणे देवकिनन्दनः।\nकृष्णः संकल्पितो धात्रा तन्मिथ्या न भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018356, "chapter_id": 1381, "verse_number": "३-१९-२५", "content_sanskrit": "ततः परमसंहृष्टः प्रद्युम्नः शरमुत्तमम्।\nसंजहार धनुःश्रेष्ठात्तूणे चैव न्यवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018357, "chapter_id": 1381, "verse_number": "३-१९-२६", "content_sanskrit": "तत उत्थाय राजेन्द्र साल्वः परमदुर्मनाः।\nव्यपायात्सबलस्तूर्णं प्रद्युम्नशरपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018358, "chapter_id": 1381, "verse_number": "३-१९-२७", "content_sanskrit": "स द्वारकां परित्यज्य साल्वो वृष्णिभिरार्दितः।\nसौभमास्थाय राजेन्द्र दिवमाचक्रमे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018359, "chapter_id": 1381, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि विंशोऽध्यायः ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]