[{"id": 2197297, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197298, "chapter_id": 5193, "verse_number": "१", "content_sanskrit": "अथ सा स्त्री तमुक्त्वा तु विप्रमेवं भवत्विति ।\nतैलं दिव्यमुपादाय स्नानशाटीमुपानयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197299, "chapter_id": 5193, "verse_number": "२", "content_sanskrit": "अनुज्ञाता च मुनिना सा स्त्री तेन महात्मना ।\nअथास्य तैलेनाङ्गानि सर्वाण्येवाभ्यमृक्षयत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197300, "chapter_id": 5193, "verse_number": "३", "content_sanskrit": "शनैश्चाच्छादितस्तत्र स्नानशालामुपागमत् ।\nभद्रासनं ततश्चित्रं ऋषिरन्वाविशन्नवम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197301, "chapter_id": 5193, "verse_number": "४", "content_sanskrit": "अथोपविष्टश्च यदा तस्मिन् भद्रासने तदा ।\nस्नापयामास शनकैस्तमृषिं सुखहस्तवत् ।\nजलेन सुसुखोष्णेन तस्या हस्तसुखेन च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197302, "chapter_id": 5193, "verse_number": "५", "content_sanskrit": "दिव्यं च विधिवच्चक्रे सोपचारं मुनेस्तदा ।\nव्यतीतां रजनीं कृत्स्नां नाजानात् स महाव्रतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197303, "chapter_id": 5193, "verse_number": "६", "content_sanskrit": "तत उत्थाय स मुनिस्तदा परमविस्मितः ।\nपूर्वस्यां दिशि सूर्यं च सोऽपश्यदुदितं दिवि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197304, "chapter_id": 5193, "verse_number": "७", "content_sanskrit": "तस्य बुद्धिरियं किं नु मोहस्तत्त्वमिदं भवेत् ।\nअथोपास्य सहस्रांशुं किं करोमीत्युवाच ताम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197305, "chapter_id": 5193, "verse_number": "८", "content_sanskrit": "सा चामृतरसप्रख्यमृषेरन्नमुपाहरत् ।\nतस्य स्वादुतयाऽन्नस्य न प्रभूतं चकार सः ।\nव्यगमच्चाप्यहःशेषं ततः सन्ध्याऽगमत् पुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197306, "chapter_id": 5193, "verse_number": "९", "content_sanskrit": "अथ स्त्री भगवन्तं सा सुप्यतामित्यचोदयत् ।\nतत्र वै शयने दिव्ये तस्य तस्याश्च कल्पिते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197307, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197308, "chapter_id": 5193, "verse_number": "१०", "content_sanskrit": "न भद्रे परदारेषु मनो मे सम्प्रसज्जति ।\nउत्तिष्ठ भद्रे भद्रं ते स्वप वै विरमस्व च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197309, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197310, "chapter_id": 5193, "verse_number": "११", "content_sanskrit": "सा तदा तेन विप्रेण तथा धृत्या निवर्तिता ।\nस्वतन्त्रास्मीत्युवाचर्षिं न धर्मच्छलमस्ति ते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197311, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197312, "chapter_id": 5193, "verse_number": "१२", "content_sanskrit": "नास्ति स्वतन्त्रता स्त्रीणामस्वतन्त्रा हि योषितः ।\nप्रजापतिमतं ह्येतन्न स्त्री स्वातन्त्र्यमर्हति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197313, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "स्त्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197314, "chapter_id": 5193, "verse_number": "१३", "content_sanskrit": "बाधते मैथुनं विप्र मम भक्तिं च पश्य वै ।\nअधर्मं प्राप्स्यसे विप्र यन्मां त्वं नाभिनन्दसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197315, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197316, "chapter_id": 5193, "verse_number": "१४", "content_sanskrit": "हरन्ति दोषजातानि नरमिन्द्रियकिङ्करम् ।\nप्रभवामि सदा धृत्या भद्रे स्वं शयनं व्रज\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197317, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "स्त्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197318, "chapter_id": 5193, "verse_number": "१५", "content_sanskrit": "शिरसा प्रणमे विप्र प्रसादं कर्तुमर्हसि ।\nभूमौ निपतमानायाः शरणं भव मेऽनघ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197319, "chapter_id": 5193, "verse_number": "१६", "content_sanskrit": "यदि वा दोषजातं त्वं परदारेषु पश्यसि ।\nआत्मानं स्पर्शयाम्यद्य पाणिं गृह्णीष्व मे द्विज\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197320, "chapter_id": 5193, "verse_number": "१७", "content_sanskrit": "न दोषो भविता चैव सत्येनैतद् ब्रवीम्यहम् ।\nस्वतन्त्रां मां विजानीहि योऽधर्मः सोऽस्तु वै मयि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197321, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197322, "chapter_id": 5193, "verse_number": "१८", "content_sanskrit": "स्वतन्त्रा त्वं कथं भद्रे ब्रूहि कारणमत्र वै ।\nनास्ति लोके हि काचित्स्त्री या वै स्वातन्त्र्यमर्हति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197323, "chapter_id": 5193, "verse_number": "१९", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने ।\nपुत्रस्तु स्थविरीभावे न स्त्री स्वातन्त्र्यमर्हति ।\nन वृद्धामक्षमां मन्ये न चेच्छा त्वयि मेऽनघे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197324, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "स्त्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197325, "chapter_id": 5193, "verse_number": "२०", "content_sanskrit": "कौमारं ब्रह्मचर्यं मे कन्यैवास्मि न संशयः ।\nपत्निं कुरुष्व मां विप्र श्रद्धां विजहि मा मम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197326, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197327, "chapter_id": 5193, "verse_number": "२१", "content_sanskrit": "यथा मम तथा तुभ्यं यथा तव तथा मम ।\nजिज्ञासेयमृषेस्तस्य विघ्नः सत्यं नु किं भवेत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197328, "chapter_id": 5193, "verse_number": "२२", "content_sanskrit": "आश्चर्यं परमं हीदं किं नु श्रेयो हि मे भवेत् ।\nदिव्याभरणवस्त्रा हि कन्येयं मामुपस्थिता\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2197329, "chapter_id": 5193, "verse_number": "२३", "content_sanskrit": "किं त्वस्याः परमं रूपं जीर्णमासीत् कथं पुनः ।\nकन्यारूपमिहाद्यैव किमिहात्रोत्तरं भवेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2197330, "chapter_id": 5193, "verse_number": "२४", "content_sanskrit": "यथा परं शक्तिधृतेर्न व्युत्थास्ये कथञ्चन ।\nन रोचये हि व्युत्थानं धृत्यैवं साधयाम्यहम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2197331, "chapter_id": 5193, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे अष्टावक्रीये दिक्संवादे चतुश्चत्वारिंशोऽध्यायः ॥४४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]