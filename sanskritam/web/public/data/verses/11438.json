[{"id": 50010235, "chapter_id": 11438, "verse_number": "1", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50010236, "chapter_id": 11438, "verse_number": "2", "content_sanskrit": "एवं स भगवान् वैन्यः ख्यापितो गुणकर्मभिः। छन्दयामास तान् कामैः प्रतिपूज्याभिनन्द्य च॥ ४/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50010237, "chapter_id": 11438, "verse_number": "3", "content_sanskrit": "ब्राह्मणप्रमुखान् वर्णान् भृत्यामात्यपुरोधसः। पौरान् जानपदान् श्रेणीः प्रकृतीः समपूजयत्॥ ४/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50010238, "chapter_id": 11438, "verse_number": "4", "content_sanskrit": "विदुर उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50010239, "chapter_id": 11438, "verse_number": "5", "content_sanskrit": "कस्माद् दधार गोरूपं धरित्री बहुरूपिणी। यां दुदोह पृथुस्तत्र को वत्सो दोहनं च किम्॥ ४/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50010240, "chapter_id": 11438, "verse_number": "6", "content_sanskrit": "प्रकृत्या विषमा देवी कृता तेन समा कथम्। तस्य मेध्यं हयं देवः कस्य हेतोरपाहरत्॥ ४/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50010241, "chapter_id": 11438, "verse_number": "7", "content_sanskrit": "सनत्कुमाराद् भगवतो ब्रह्मन् ब्रह्मविदुत्तमात्। लब्ध्वा ज्ञानं सविज्ञानं राजर्षिः कां गतिं गतः॥ ४/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50010242, "chapter_id": 11438, "verse_number": "8", "content_sanskrit": "यच्चान्यदपि कृष्णस्य भवान् भगवतः१ प्रभोः। श्रवः सुश्रवसः पुण्यं पूर्वदेहकथाश्रयम्॥ ४/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50010243, "chapter_id": 11438, "verse_number": "9", "content_sanskrit": "भक्ताय मेऽनुरक्ताय तव चाधोक्षजस्य च। वक्तुमर्हति योऽदुह्यद् वैन्यरूपेण गामिमाम्॥ ४/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50010244, "chapter_id": 11438, "verse_number": "10", "content_sanskrit": "श्रीशुक उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50010245, "chapter_id": 11438, "verse_number": "11", "content_sanskrit": "चोदितो विदुरेणैवं वासुदेवकथां प्रति। प्रशस्य तं प्रीतमना मैत्रेयः प्रत्यभाषत॥ ४/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50010246, "chapter_id": 11438, "verse_number": "12", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50010247, "chapter_id": 11438, "verse_number": "13", "content_sanskrit": "यदाऽभिषिक्तः पृथुरङ्ग विप्रैरामन्त्रितो जनतायाश्च पालः। प्रजा निरन्ने क्षितिपृष्ठ एत्य क्षुत्क्षामदेहाः पतिमभ्यवोचन्॥ ४/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50010248, "chapter_id": 11438, "verse_number": "14", "content_sanskrit": "प्रजा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50010249, "chapter_id": 11438, "verse_number": "15", "content_sanskrit": "वयं राजन् जाठरेणाभितप्ता यथाऽग्निना कोटरस्थेन वृक्षाः। त्वामद्य याताः शरणं शरण्यं यः शाधि नो वृत्तिकरः पतिर्नः॥ ४/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50010250, "chapter_id": 11438, "verse_number": "16", "content_sanskrit": "तन्नो भवानर्हति रातवेऽन्नं क्षुधाऽर्दितानां नरदेवदेव। यावन्न नङ्क्ष्यामह उज्झितान्ना वार्तापतिस्त्वं किल लोकपालः॥ ४/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50010251, "chapter_id": 11438, "verse_number": "17", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50010252, "chapter_id": 11438, "verse_number": "18", "content_sanskrit": "पृथुः प्रजानां करुणं निशम्य परिदेवितम्। दीर्घं दध्यौ कुरुश्रेष्ठ निमित्तं सोऽन्वपद्यत॥ ४/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50010253, "chapter_id": 11438, "verse_number": "19", "content_sanskrit": "इति व्यवसितो बुद्ध्या प्रगृहीतशरासनः। सन्दधे विशिखं भूमेः क्रुद्धस्त्रिपुरहा यथा॥ ४/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50010254, "chapter_id": 11438, "verse_number": "20", "content_sanskrit": "प्रवेपमाना धरणी निशाम्योदायुधं च तम्। गौः सत्यपाद्रवद् भीता मृगीव मृगयोर्द्रुतम्॥ ४/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50010255, "chapter_id": 11438, "verse_number": "21", "content_sanskrit": "तामेवान्वव्रजद् वैन्यः कुपितोऽत्यरुणेक्षणः। शरं धनुषि सन्धाय यत्रयत्र पलायति॥ ४/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50010256, "chapter_id": 11438, "verse_number": "22", "content_sanskrit": "सा दिशो विदिशो देवी रोदसी चान्तरं तयोः। धावन्ती तत्रतत्रैनं ददर्शानूद्यतायुधम्॥ ४/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50010257, "chapter_id": 11438, "verse_number": "23", "content_sanskrit": "लोके नाविन्दत त्राणं वैन्यान्मृत्योरिव प्रजाः। त्रस्ता तदा निववृते हृदयेन विदूयता॥ ४/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50010258, "chapter_id": 11438, "verse_number": "24", "content_sanskrit": "उवाच ।ाथ महाभागं धर्मज्ञापन्नवत्सल। त्राहि मामपि भूतानां पालनेऽवस्थितो भवान्॥ ४/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50010259, "chapter_id": 11438, "verse_number": "25", "content_sanskrit": "स त्वं जिघांससे कस्माद् दीनामकृतकिल्बिषाम्। अहनिष्यत् कथं योषां धर्मज्ञ इति यो मतः॥ ४/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50010260, "chapter_id": 11438, "verse_number": "26", "content_sanskrit": "प्रहरन्ति न वै स्त्रीषु कृतागःस्वपि जन्तवः। किं पुनस्त्वद्विधा राजन् करुणा दीनवत्सलाः॥ ४/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50010261, "chapter_id": 11438, "verse_number": "27", "content_sanskrit": "मां निहत्याजरां नावं यत्र विश्वं प्रतिष्ठितम्। आत्मानं च प्रजाश्चेमाः कथमम्भसि धास्यसि॥ ४/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50010262, "chapter_id": 11438, "verse_number": "28", "content_sanskrit": "पृथुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50010263, "chapter_id": 11438, "verse_number": "29", "content_sanskrit": "वसुधे त्वां हनिष्यामि मच्छासनपराङ्मुखीम्। भागं बर्हिषि या वृङ्क्ते न तनोषि च नो वसु॥ ४/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50010264, "chapter_id": 11438, "verse_number": "30", "content_sanskrit": "यवसं जग्ध्यनुदिनं नैव दोग्ध्यौधसं पयः। तस्यामेवं हि दुष्टायां दण्डो नात्र न शस्यते॥ ४/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50010265, "chapter_id": 11438, "verse_number": "31", "content_sanskrit": "त्वं खल्वौषधिबीजानि प्राक् सृष्टानि स्वयम्भुवा। न मुञ्चस्यात्मरुद्धानि मामवज्ञाय मन्दधीः॥ ४/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50010266, "chapter_id": 11438, "verse_number": "32", "content_sanskrit": "अमूषां क्षुत्परीतानामार्तानां परिदेवितम्। शमयिष्यामि मद्बाणैर्भिन्नायास्तव मेदसा॥ ४/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50010267, "chapter_id": 11438, "verse_number": "33", "content_sanskrit": "पुमान् योषिदुत क्लब आत्मसम्भावनोऽधमः। भूतेषु निरनुक्रोशो नृपाणां तद्वधो वरः॥ ४/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50010268, "chapter_id": 11438, "verse_number": "34", "content_sanskrit": "त्वां स्तब्धां दुर्मदां नीत्वा मायागां तिलशः शरैः। आत्मयोगबलेनेमा धारयिष्याम्यहं प्रजाः॥ ४/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50010269, "chapter_id": 11438, "verse_number": "35", "content_sanskrit": "एवं मन्युमयीं मूर्तिं कृतान्तमिव बिभ्रतम्। प्रणता प्राञ्जलिः प्राह मही सञ्जातवेपथुः॥ ४/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50010270, "chapter_id": 11438, "verse_number": "36", "content_sanskrit": "धरण्युवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50010271, "chapter_id": 11438, "verse_number": "37", "content_sanskrit": "नमः परस्मै पुरुषाय मायया विन्यस्तनानातनवे गुणात्मने। नमः स्वरूपानुभवेन निर्धुतद्रव्यक्रियाकारकविभ्रमोर्मये॥ ४/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50010272, "chapter_id": 11438, "verse_number": "38", "content_sanskrit": "येनाहमात्मीयतनुर्विनिर्मिता धात्रा यतोऽयं गुणसर्गसङ्ग्रहः। स एव मां हन्तुमुदायुधः स्वराडुपस्थितोऽन्यं शरणं कमाश्रये॥ ४/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50010273, "chapter_id": 11438, "verse_number": "39", "content_sanskrit": "य एतदादावसृजच्चराचरं स्वमाययाऽऽत्माश्रययाऽवितर्क्यया। तयैव सोऽयं किल१ गोप्तुमुद्यतः कथं नु मां धर्मपरो जिघांसति॥ ४/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50010274, "chapter_id": 11438, "verse_number": "40", "content_sanskrit": "नूनं तवेशस्य समीहितं जनैः स्वमायया दुर्जययाऽकृतात्मभिः। न लक्ष्यते यस्त्वकरोदकारयद् योऽनेक एकः परतः स ईश्वरः॥ ४/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50010275, "chapter_id": 11438, "verse_number": "41", "content_sanskrit": "सर्गादि योऽस्यानुरुणद्धि शक्तिभिर्द्रव्यक्रियाकारकचेतनात्मभिः। तस्मै समुन्नद्धविरुद्धशक्तये नमः परस्मै पुरुषाय वेधसे॥ ४/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50010276, "chapter_id": 11438, "verse_number": "42", "content_sanskrit": "स वै भवानात्मविनिर्मितं जगद् भूतेन्द्रियान्तःकरणात्मकं विभो। संस्थापयिष्यन्नज मां रसातळादभ्युज्जहाराम्भस आदिसूकरः॥ ४/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50010277, "chapter_id": 11438, "verse_number": "43", "content_sanskrit": "अपामुपस्थे मयि नाव्यवस्थिताः प्रजा भवानद्य रिरक्षिषुः किल। स वीरमूर्तिः समभूद् धराधरो यो मां पयस्युग्रशरो जिघांसति॥ ४/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50010278, "chapter_id": 11438, "verse_number": "44", "content_sanskrit": "नूनं जनैरीहितमीश्वराणामस्मद्विधैस्तद्गुणसर्गमायया। न ज्ञायते मोहितचित्तवृत्तिभिस्तेभ्यो नमो वीरयशस्करेभ्यः॥ ४/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50010279, "chapter_id": 11438, "verse_number": "45", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे सप्तदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]