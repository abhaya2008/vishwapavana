[{"id": 2096961, "chapter_id": 3079, "verse_number": "१३-२०९-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश त्रिपुरान्तक शङ्कर।\nअयं त्वृषिगणो देव तपस्तप इति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096962, "chapter_id": 3079, "verse_number": "१३-२०९-२", "content_sanskrit": "तपसा कर्शितो नित्यं तपोऽर्जनपरायणः।\nअस्य किंलक्षणो धर्मः कीदृशश्चागमस्तथा।\nएतदिच्छाम्यहं श्रोतुं तन्मे वद वरप्रद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096963, "chapter_id": 3079, "verse_number": "१३-२०९-३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096964, "chapter_id": 3079, "verse_number": "१३-२०९-३", "content_sanskrit": "एवं ब्रुवन्त्यां रुद्राण्यामृषयः साधुसाध्विति।\nअब्रुवन्हृष्टमनसः सर्वे तद्गतमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096965, "chapter_id": 3079, "verse_number": "१३-२०९-४", "content_sanskrit": "शृण्वन्तीमृषिधर्मांस्तु ऋषयश्चाभ्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096966, "chapter_id": 3079, "verse_number": "१३-२०९-५x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096967, "chapter_id": 3079, "verse_number": "१३-२०९-५", "content_sanskrit": "त्वत्प्रसादद्वयं देवि श्रोष्यामः परमं हितम्।\nधन्याः खलु वयं सर्वे पादमूलं तवाश्रिताः।\nइति सर्वे तदा देवीं वाचा समभिपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096968, "chapter_id": 3079, "verse_number": "१३-२०९-६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096969, "chapter_id": 3079, "verse_number": "१३-२०९-६", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामा मनस्विनि।\nहन्त ते कथयिष्यामि मुनिधर्मं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096970, "chapter_id": 3079, "verse_number": "१३-२०९-७", "content_sanskrit": "वानप्रस्थं समाश्रित्य क्रियते बहुधा नरैः।\nबहुशाखो बहुविधो ऋषिधर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096971, "chapter_id": 3079, "verse_number": "१३-२०९-८", "content_sanskrit": "प्रायशः सर्वभोगार्थमृषिभिः क्रियते तपः।\nतथा सञ्चरतां तेषां देवि धर्मविधिं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096972, "chapter_id": 3079, "verse_number": "१३-२०९-९", "content_sanskrit": "भूत्वा पूर्वं गृहस्थस्तु पुत्रानृण्यमवाप्य च।\nकलत्रकार्यं संस्थाप्य कारणात्संत्यजेद्गृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096973, "chapter_id": 3079, "verse_number": "१३-२०९-१०", "content_sanskrit": "अवस्थाप्य मनो धृत्या व्यवसायपुरःसरः।\nनिर्दारो वा सदारो वा वनवासाय संव्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096974, "chapter_id": 3079, "verse_number": "१३-२०९-११", "content_sanskrit": "देशाः परमपुण्या ये नदीवनसमन्विताः।\nअबोधमुक्ताः प्रायेण तीर्थायतनसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096975, "chapter_id": 3079, "verse_number": "१३-२०९-१२", "content_sanskrit": "तत्र गत्वा विधिं ज्ञात्वा दीक्षां कुर्याद्यथागमम्।\nदीक्षित्वैकमना भूत्वा परिचर्यां समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096976, "chapter_id": 3079, "verse_number": "१३-२०९-१३", "content_sanskrit": "काल्योत्थानं च शौचं च सर्वदेवप्रणामनम्।\nसकृदालेपनं काये त्यक्तदोषोऽप्रमादिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096977, "chapter_id": 3079, "verse_number": "१३-२०९-१४", "content_sanskrit": "सायंप्रातश्चाभिषेकं चाग्निहोत्रं यथाविधि।\nकाले शौचं च कार्यं च जटावल्कलधारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096978, "chapter_id": 3079, "verse_number": "१३-२०९-१५", "content_sanskrit": "सततं वनचर्या च समित्कुसुमकारणात्।\nनीवाराग्रयणं काले शाकमूलोपचायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096979, "chapter_id": 3079, "verse_number": "१३-२०९-१६", "content_sanskrit": "सदायतनशौचं च तस्य धर्माय चेष्यते।\nअतिथीनामाभिमुख्यं तत्परत्वं च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096980, "chapter_id": 3079, "verse_number": "१३-२०९-१७", "content_sanskrit": "पाद्यासनाभ्यां सम्पूज्य तथाऽऽहारनिमन्त्रणम्।\nअग्राम्यपचनं काले पितृदेवार्चनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096981, "chapter_id": 3079, "verse_number": "१३-२०९-१८", "content_sanskrit": "पश्चादतिथिसत्कारस्तस्य धर्मः सनातनः।\nशिष्टैर्धर्मासने चैव धर्मार्थसहिताः कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096982, "chapter_id": 3079, "verse_number": "१३-२०९-१९", "content_sanskrit": "प्रतिश्रयविभागश्च भूमिशय्या शिलासु वा।\nव्रतोपवासयोगश्च क्षमा चेन्द्रियनिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096983, "chapter_id": 3079, "verse_number": "१३-२०९-२०", "content_sanskrit": "दिवारात्रं यथायोगं शौचं धर्मस्य चिन्तनम्।\nएवं धर्माः पुरा दृष्टाः सामान्या वनवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096984, "chapter_id": 3079, "verse_number": "१३-२०९-२१", "content_sanskrit": "एवं वै यतमानस्य कालधर्मो यथा भवेत्।\nतथैव सोऽभिजयति स्वर्गलोकं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096985, "chapter_id": 3079, "verse_number": "१३-२०९-२२", "content_sanskrit": "तत्र संविदिता भोगाः स्वर्गस्त्रीभिरनिन्दिते।\nपरिभ्रष्टो यथा स्वर्गाद्विशिष्टस्तु भवेन्नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096986, "chapter_id": 3079, "verse_number": "१३-२०९-२३", "content_sanskrit": "एवं धर्मस्तथा देवि सर्वेषां वनवासिनाम्।\nएतत्ते कथितं सर्वं किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096987, "chapter_id": 3079, "verse_number": "१३-२०९-२४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096988, "chapter_id": 3079, "verse_number": "१३-२०९-२४", "content_sanskrit": "भगवन्देवदेवेश ऋषीणां चरितं शुभम्।\nविशेषधर्मानिच्छामि श्रोतुं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096989, "chapter_id": 3079, "verse_number": "१३-२०९-२५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096990, "chapter_id": 3079, "verse_number": "१३-२०९-२५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु देवि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096991, "chapter_id": 3079, "verse_number": "१३-२०९-२६", "content_sanskrit": "वननित्यैर्वनरतैर्वानप्रस्थैर्महर्षिभिः।\nवनं गुरुमिवालम्ब्य वस्तुव्यमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096992, "chapter_id": 3079, "verse_number": "१३-२०९-२७", "content_sanskrit": "वीरशय्यामुपासद्भिर्वारस्थानोपसेविभिः।\nव्रतोपवासैर्बहुलैर्ग्रीष्मे पञ्चतपैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096993, "chapter_id": 3079, "verse_number": "१३-२०९-२८", "content_sanskrit": "पञ्चयज्ञपरैर्नित्यं पौर्णमास्यापरायणैः।\nमण्डूकशायैर्हेमन्ते शैवालाङ्कुरभोजनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096994, "chapter_id": 3079, "verse_number": "१३-२०९-२९", "content_sanskrit": "चीरवल्कलसंवीतैर्मृगाजिनधरैस्तथा।\nचातुर्मास्यपरैः कैश्चिद्देवधर्मपरायणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096995, "chapter_id": 3079, "verse_number": "१३-२०९-३०", "content_sanskrit": "एवंविधैर्वनेवासैस्तप्यते सुमहत्तपः।\nएवं कृत्वा शुभं कर्म पश्चाद्याति त्रिविष्टपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096996, "chapter_id": 3079, "verse_number": "१३-२०९-३१", "content_sanskrit": "तत्रापि सुमहत्कालं संविहृत्यि यथासुखम्।\nजायते मानुषे लोके दानभोगसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096997, "chapter_id": 3079, "verse_number": "१३-२०९-३२", "content_sanskrit": "तपोविशेषसंयुक्ताः कथितास्ते शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096998, "chapter_id": 3079, "verse_number": "१३-२०९-३३x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096999, "chapter_id": 3079, "verse_number": "१३-२०९-३३", "content_sanskrit": "भगवन्देवदेवेश तेषु ये दारसंयुताः।\nकीदृशं चरितं तेषां तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097000, "chapter_id": 3079, "verse_number": "१३-२०९-३४x", "content_sanskrit": "महेश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097001, "chapter_id": 3079, "verse_number": "१३-२०९-३४", "content_sanskrit": "य एकपत्नीधर्माणश्चरन्ति विपुलं तपः।\nविंध्यपादेषु ये केचिद्ये च नैमिशवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097002, "chapter_id": 3079, "verse_number": "१३-२०९-३५", "content_sanskrit": "पुष्करेषु च ये चान्ये नदीवनसमाश्रिताः।\nसर्वे ते विधिदृष्टेन चरन्ति विपुलं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097003, "chapter_id": 3079, "verse_number": "१३-२०९-३६", "content_sanskrit": "हिंसाद्रोहविमुक्ताश्च सर्वभूतानुकम्पिनः।\nशान्ता दान्ता जितक्रोधाः सर्वातिथ्यपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097004, "chapter_id": 3079, "verse_number": "१३-२०९-३७", "content_sanskrit": "प्राणिष्वात्मोपमा नित्यमृतुकालाभिगामिनः।\nस्वदारसहिता देवि चरन्ति व्रतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097005, "chapter_id": 3079, "verse_number": "१३-२०९-३८", "content_sanskrit": "वसन्ति सुखमव्यग्राः पुत्रदारसमन्विताः।\nतेषां परिच्छदारम्भाः कृतोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097006, "chapter_id": 3079, "verse_number": "१३-२०९-३९", "content_sanskrit": "गृहस्थवद्द्वितीयं ते यथायोगं प्रमाणतः।\nपोषणार्थं स्वदाराणामग्निकार्यार्थमेव च।\nगावश्च कर्षणं चैव सर्वमेतद्विधीयते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097007, "chapter_id": 3079, "verse_number": "१३-२०९-४०", "content_sanskrit": "एवं वनगतैर्देवि कर्तव्यं दारसङ्ग्रहैः।\nते स्वदारैः समायान्ति पुण्याँल्लोकान्द्दढव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097008, "chapter_id": 3079, "verse_number": "१३-२०९-४१", "content_sanskrit": "पतिभिः सह ये दाराश्चरन्ति विपुलं तपः।\nअव्यग्रभावादैकात्म्यात्ताश्च गच्छन्ति वै दिवम्।\nएतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097009, "chapter_id": 3079, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि नवाधिकद्विशततमोऽध्यायः॥ २०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]