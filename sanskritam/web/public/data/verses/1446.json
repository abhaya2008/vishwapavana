[{"id": 2021667, "chapter_id": 1446, "verse_number": "३-८४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021668, "chapter_id": 1446, "verse_number": "३-८४-१", "content_sanskrit": "भ्रातॄणां मतमाज्ञाय नारदस्य च धीमतः।\nपितामहसमं धौम्यं प्राह राजा युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021669, "chapter_id": 1446, "verse_number": "३-८४-२", "content_sanskrit": "मया स पुरुषव्याघ्रो जिष्णुः सत्यपराक्रमः।\nअस्त्रहेतोर्महाबाहुरमितात्मा विवासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021670, "chapter_id": 1446, "verse_number": "३-८४-३", "content_sanskrit": "स हि वीरोऽनुरक्तश् समर्थश्च तपोधनः।\nकृती च भृशमप्यस्त्रे वासुदेव इव प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021671, "chapter_id": 1446, "verse_number": "३-८४-४", "content_sanskrit": "अहं ह्येतावुभौ ब्रह्मन्कृष्णावरिविघातिनौ।\nअभिजानामि विक्रान्तौ तथा व्यासः परन्तपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021672, "chapter_id": 1446, "verse_number": "३-८४-५", "content_sanskrit": "त्रियुगौ पुण्डरीकाक्षौ वासुदेवधनंजयौ।\nनारदोऽपितथा वेद योष्यशंसत्सदा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021673, "chapter_id": 1446, "verse_number": "३-८४-६", "content_sanskrit": "तथाऽहमपि जानामि नरनारायणावृषी।\nशक्तोऽयमित्यतो मत्वा मया स प्रेषितोऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021674, "chapter_id": 1446, "verse_number": "३-८४-७", "content_sanskrit": "इन्द्रादनवरः शक्रं सुरसूनुः सुराधिपम्।\nद्रष्टुमस्त्राणि चादातुमिन्द्रादिति विवासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021675, "chapter_id": 1446, "verse_number": "३-८४-८", "content_sanskrit": "भीष्मद्रोणावतिरथौ कृपो द्रौणिश्च दुर्जयः।\nधृतराष्ट्रस्य पुत्रेण सुधृताः सुमहाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021676, "chapter_id": 1446, "verse_number": "३-८४-९", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वेऽस्त्रकुशलास्तथा।\n`सर्वे महारथा मुख्याः सर्वे जितपरिश्रमाः।\nयोद्धुकामाश्च पार्थेन सततं ये महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021677, "chapter_id": 1446, "verse_number": "३-८४-१०", "content_sanskrit": "स च दिव्यास्त्रवित्कर्णः सूतपुत्रो महारथः।\nयोऽस्त्रवेगानिलबलः शरार्चिस्तलनिःस्वनः।\nरजोधूमोऽस्त्रसंपातो धार्तराष्ट्रानिलोद्धतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021678, "chapter_id": 1446, "verse_number": "३-८४-११", "content_sanskrit": "निसृष्ट इव कालेन युगान्तज्वलनो यथा।\nमम सैन्यमयं कक्षं प्रधक्ष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021679, "chapter_id": 1446, "verse_number": "३-८४-१२", "content_sanskrit": "तं स कुष्णानिलोद्धूतो दिव्यास्त्रज्वलनो महान्।\nश्वेतवाजिबलाकाभृद्गण्डीवेन्द्रायुधोल्बणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021680, "chapter_id": 1446, "verse_number": "३-८४-१३", "content_sanskrit": "संरब्धः शरधाराभिः सुधीप्तं कर्णपावकम्।\nउदीर्णोऽर्जुनमेघोऽयं शमयिष्यति संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021681, "chapter_id": 1446, "verse_number": "३-८४-१४", "content_sanskrit": "स साक्षादेव सर्वाणि शक्रात्परपुरंजयः।\nदिव्यान्यस्त्राणि वीभत्सुर्यथावत्प्रतिपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021682, "chapter_id": 1446, "verse_number": "३-८४-१५", "content_sanskrit": "अलं स तेषां सर्वेषामिति मे धीयते मतिः।\nनास्ति त्वतिक्रिया तस् रणेऽरीणां प्रतिक्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021683, "chapter_id": 1446, "verse_number": "३-८४-१६", "content_sanskrit": "ते वयं पाण्डवं सर्वे गृहीतास्त्रमरिंदमम्।\nद्रष्टारो न हि बीभत्सुर्भारमुद्यम्य सीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021684, "chapter_id": 1446, "verse_number": "३-८४-१७", "content_sanskrit": "वयं तु तमृते वीरं वनेऽस्मिन्द्विपदांवर।\nअवधानं न गच्छामः काम्यके सह कृष्णया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021685, "chapter_id": 1446, "verse_number": "३-८४-१८", "content_sanskrit": "भवानन्यद्वनं साधु बह्वन्नं फलवच्छुचि।\nआख्यातु रमणीयं च सेवितं पुण्यक्रमभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021686, "chapter_id": 1446, "verse_number": "३-८४-१९", "content_sanskrit": "यत्रकंचिद्वयं कालं वसन्तः सत्यविक्रमम्।\nप्रतीक्षामोऽर्जुनं वरं वृष्टिकामा इवाम्बुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021687, "chapter_id": 1446, "verse_number": "३-८४-२०", "content_sanskrit": "विविधानाश्रमान्कांश्चिद्द्विजातिभ्यः प्रतिश्रुतान्।\nसरांसि सरितश्चैव रमणीयांश्च पर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021688, "chapter_id": 1446, "verse_number": "३-८४-२१", "content_sanskrit": "आचक्ष्व न हि मे ब्रह्मन्रोचते तमृतेऽर्जुनम्।\nवनेऽस्मिन्काम्यके वासो गच्छामोऽन्यां दिशंप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021689, "chapter_id": 1446, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि चतुरशीतितमोऽध्यायः ॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]