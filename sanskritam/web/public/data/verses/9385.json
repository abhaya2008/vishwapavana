[{"id": 5000385000, "chapter_id": 9385, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000385001, "chapter_id": 9385, "verse_number": "५-४६-१", "content_sanskrit": "हतान् मन्त्रिसुतान् बुद्‍ध्वा वानरेण महात्मना।\nरावणः संवृताकारश्चकार मतिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000385002, "chapter_id": 9385, "verse_number": "५-४६-२", "content_sanskrit": "स विरूपाक्षयूपाक्षौ दुर्धरं चैव राक्षसम्।\nप्रघसं भासकर्णं च पञ्च सेनाग्रनायकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000385003, "chapter_id": 9385, "verse_number": "५-४६-३", "content_sanskrit": "संदिदेश दशग्रीवो वीरान् नयविशारदान्।\nहनूमद्‍ग्रहणेऽव्यग्रान् वायुवेगसमान् युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000385004, "chapter_id": 9385, "verse_number": "५-४६-४", "content_sanskrit": "यात सेनाग्रगाः सर्वे महाबलपरिग्रहाः।\nसवाजिरथमातङ्गाः स कपिः शास्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000385005, "chapter_id": 9385, "verse_number": "५-४६-५", "content_sanskrit": "यत्तैश्च खलु भाव्यं स्यात् तमासाद्य वनालयम्।\nकर्म चापि समाधेयं देशकालाविरोधितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000385006, "chapter_id": 9385, "verse_number": "५-४६-६", "content_sanskrit": "न ह्यहं तं कपिं मन्ये कर्मणा प्रति तर्कयन्।\nसर्वथा तन्महद् भूतं महाबलपरिग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000385007, "chapter_id": 9385, "verse_number": "५-४६-७", "content_sanskrit": "वानरोऽयमिति ज्ञात्वा नहि शुद्ध्यति मे मनः।\nनैवाहं तं कपिं मन्ये यथेयं प्रस्तुता कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000385008, "chapter_id": 9385, "verse_number": "५-४६-८", "content_sanskrit": "भवेदिन्द्रेण वा सृष्टमस्मदर्थं तपोबलात्।\nसनागयक्षगन्धर्वदेवासुरमहर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000385009, "chapter_id": 9385, "verse_number": "५-४६-९", "content_sanskrit": "युष्माभिः प्रहितैः सर्वैर्मया सह विनिर्जिताः।\nतैरवश्यं विधातव्यं व्यलीकं किंचिदेव नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000385010, "chapter_id": 9385, "verse_number": "५-४६-१०", "content_sanskrit": "तदेव नात्र संदेहः प्रसह्य परिगृह्यताम्।\nयात सेनाग्रगाः सर्वे महाबलपरिग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000385011, "chapter_id": 9385, "verse_number": "५-४६-११", "content_sanskrit": "सवाजिरथमातङ्गाः स कपिः शास्यतामिति।\nनावमन्यो भवद्भिश्च कपिर्धीरपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000385012, "chapter_id": 9385, "verse_number": "५-४६-१२", "content_sanskrit": "दृष्टा हि हरयः पूर्वे मया विपुलविक्रमाः।\nवाली च सह सुग्रीवो जाम्बवांश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000385013, "chapter_id": 9385, "verse_number": "५-४६-१३", "content_sanskrit": "नीलः सेनापतिश्चैव ये चान्ये द्विविदादयः।\nनैव तेषां गतिर्भीमा न तेजो न पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000385014, "chapter_id": 9385, "verse_number": "५-४६-१४", "content_sanskrit": "न मतिर्न बलोत्साहो न रूपपरिकल्पनम्।\nमहत्सत्त्वमिदं ज्ञेयं कपिरूपं व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000385015, "chapter_id": 9385, "verse_number": "५-४६-१५", "content_sanskrit": "प्रयत्नं महदास्थाय क्रियतामस्य निग्रहः।\nकामं लोकास्त्रयः सेन्द्राः ससुरासुरमानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000385016, "chapter_id": 9385, "verse_number": "५-४६-१६", "content_sanskrit": "भवतामग्रतः स्थातुं न पर्याप्ता रणाजिरे।\nतथापि तु नयज्ञेन जयमाकाङ्क्षता रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000385017, "chapter_id": 9385, "verse_number": "५-४६-१७", "content_sanskrit": "आत्मा रक्ष्यः प्रयत्नेन युद्धसिद्धिर्हि चञ्चला।\nते स्वामिवचनं सर्वे प्रतिगृह्य महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000385018, "chapter_id": 9385, "verse_number": "५-४६-१८", "content_sanskrit": "समुत्पेतुर्महावेगा हुताशसमतेजसः।\nरथैश्च मत्तैर्नागैश्च वाजिभिश्च महाजवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000385019, "chapter_id": 9385, "verse_number": "५-४६-१९", "content_sanskrit": "शस्त्रैश्च विविधैस्तीक्ष्णैः सर्वैश्चोपहिता बलैः।\nततस्तु ददृशुर्वीरा दीप्यमानं महाकपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000385020, "chapter_id": 9385, "verse_number": "५-४६-२०", "content_sanskrit": "रश्मिमन्तमिवोद्यन्तं स्वतेजोरश्मिमालिनम्।\nतोरणस्थं महावेगं महासत्त्वं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000385021, "chapter_id": 9385, "verse_number": "५-४६-२१", "content_sanskrit": "महामतिं महोत्साहं महाकायं महाभुजम्।\nतं समीक्ष्यैव ते सर्वे दिक्षु सर्वास्ववस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000385022, "chapter_id": 9385, "verse_number": "५-४६-२२", "content_sanskrit": "तैस्तैः प्रहरणैर्भीमैरभिपेतुस्ततस्ततः।\nतस्य पञ्चायसास्तीक्ष्णाः सिताः पीतमुखाः शराः।\nशिरस्युत्पलपत्राभा दुर्धरेण निपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000385023, "chapter_id": 9385, "verse_number": "५-४६-२३", "content_sanskrit": "स तैः पञ्चभिराविद्धः शरैः शिरसि वानरः।\nउत्पपात नदन् व्योम्नि दिशो दश विनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000385024, "chapter_id": 9385, "verse_number": "५-४६-२४", "content_sanskrit": "ततस्तु दुर्धरो वीरः सरथः सज्जकार्मुकः।\nकिरन् शरशतैर्नैकैरभिपेदे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000385025, "chapter_id": 9385, "verse_number": "५-४६-२५", "content_sanskrit": "स कपिर्वारयामास तं व्योम्नि शरवर्षिणम्।\nवृष्टिमन्तं पयोदान्ते पयोदमिव मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000385026, "chapter_id": 9385, "verse_number": "५-४६-२६", "content_sanskrit": "अर्द्यमानस्ततस्तेन दुर्धरेणानिलात्मजः।\nचकार निनदं भूयो व्यवर्धत च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000385027, "chapter_id": 9385, "verse_number": "५-४६-२७", "content_sanskrit": "स दूरं सहसोत्पत्य दुर्धरस्य रथे हरिः।\nनिपपात महावेगो विद्युद्राशिर्गिराविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000385028, "chapter_id": 9385, "verse_number": "५-४६-२८", "content_sanskrit": "ततः स मथिताष्टाश्वं रथं भग्नाक्षकूबरम्।\nविहाय न्यपतद् भूमौ दुर्धरस्त्यक्तजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000385029, "chapter_id": 9385, "verse_number": "५-४६-२९", "content_sanskrit": "तं विरूपाक्षयूपाक्षौ दृष्ट्वा निपतितं भुवि।\nतौ जातरोषौ दुर्धर्षावुत्पेततुररिंदमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000385030, "chapter_id": 9385, "verse_number": "५-४६-३०", "content_sanskrit": "स ताभ्यां सहसोत्प्लुत्य विष्ठितो विमलेऽम्बरे।\nमुद‍्गराभ्यां महाबाहुर्वक्षस्यभिहतः कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000385031, "chapter_id": 9385, "verse_number": "५-४६-३१", "content_sanskrit": "तयोर्वेगवतोर्वेगं निहत्य स महाबलः।\nनिपपात पुनर्भूमौ सुपर्ण इव वेगितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000385032, "chapter_id": 9385, "verse_number": "५-४६-३२", "content_sanskrit": "स सालवृक्षमासाद्य समुत्पाट्य च वानरः।\nतावुभौ राक्षसौ वीरौ जघान पवनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000385033, "chapter_id": 9385, "verse_number": "५-४६-३३", "content_sanskrit": "ततस्तांस्त्रीन् हतान् ज्ञात्वा वानरेण तरस्विना।\nअभिपेदे महावेगः प्रहस्य प्रघसो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000385034, "chapter_id": 9385, "verse_number": "५-४६-३४", "content_sanskrit": "भासकर्णश्च संक्रुद्धः शूलमादाय वीर्यवान्।\nएकतः कपिशार्दूलं यशस्विनमवस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000385035, "chapter_id": 9385, "verse_number": "५-४६-३५", "content_sanskrit": "पट्टिशेन शिताग्रेण प्रघसः प्रत्यपोथयत्।\nभासकर्णश्च शूलेन राक्षसः कपिकुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000385036, "chapter_id": 9385, "verse_number": "५-४६-३६", "content_sanskrit": "स ताभ्यां विक्षतैर्गात्रैरसृग्दिग्धतनूरुहः।\nअभवद् वानरः क्रुद्धो बालसूर्यसमप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000385037, "chapter_id": 9385, "verse_number": "५-४६-३७", "content_sanskrit": "समुत्पाट्य गिरेः शृङ्गं समृगव्यालपादपम्।\nजघान हनुमान् वीरो राक्षसौ कपिकुञ्जरः।\nगिरिशृङ्गसुनिष्पिष्टौ तिलशस्तौ बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000385038, "chapter_id": 9385, "verse_number": "५-४६-३८", "content_sanskrit": "ततस्तेष्ववसन्नेषु सेनापतिषु पञ्चसु।\nबलं तदवशेषं तु नाशयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000385039, "chapter_id": 9385, "verse_number": "५-४६-३९", "content_sanskrit": "अश्वैरश्वान् गजैर्नागान् योधैर्योधान् रथै रथान्।\nस कपिर्नाशयामास सहस्राक्ष इवासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000385040, "chapter_id": 9385, "verse_number": "५-४६-४०", "content_sanskrit": "हयैर्नागैस्तुरंगैश्च भग्नाक्षैश्च महारथैः।\nहतैश्च राक्षसैर्भूमी रुद्धमार्गा समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000385041, "chapter_id": 9385, "verse_number": "५-४६-४१", "content_sanskrit": "ततः कपिस्तान् ध्वजिनीपतीन् रणे\nनिहत्य वीरान् सबलान् सवाहनान्।\nतथैव वीरः परिगृह्य तोरणं\nकृतक्षणः काल इव प्रजाक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000385042, "chapter_id": 9385, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]