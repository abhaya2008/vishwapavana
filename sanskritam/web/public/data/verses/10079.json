[{"id": 6000079000, "chapter_id": 10079, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000079001, "chapter_id": 10079, "verse_number": null, "content_sanskrit": "विप्रा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.001.m4a", "display_order": 2}, {"id": 6000079002, "chapter_id": 10079, "verse_number": "४-१५-१", "content_sanskrit": "अत्र तु प्रथमो राज्ञां पुमान् प्रथयिता यशः।\nपृथुर्नाम महाराजा भविष्यति पृथुश्रवाः॥ ४/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.002.m4a", "display_order": 3, "topics": [{"text": "अर्चिर्नाम्नीं भार्याकृतवतः पृथोः पट्टाभिषेकः", "range": "१–८"}]}, {"id": 6000079003, "chapter_id": 10079, "verse_number": "४-१५-२", "content_sanskrit": "इयं च देवी सुदती गुणभूषणभूषणा।\nअर्चिर्नाम वरारोहा पृथुमेवावरुन्धती॥ ४/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.003.m4a", "display_order": 4}, {"id": 6000079004, "chapter_id": 10079, "verse_number": "४-१५-३", "content_sanskrit": "एष साक्षाद्धरेरंशो जातो लोकरिरक्षया।\nइयं च तत्परा हि श्रीरनुजज्ञेऽनपायिनी॥ ४/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.004.m4a", "display_order": 5}, {"id": 6000079005, "chapter_id": 10079, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.005.m4a", "display_order": 6}, {"id": 6000079006, "chapter_id": 10079, "verse_number": "४-१५-४", "content_sanskrit": "प्रशंसन्ति स्म तं विप्रा गन्धर्वप्रमुखा जगुः।\nमुमुचुः सुमनोधाराः सिद्धा नृत्यन्ति तत्स्‍त्रियः॥ ४/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.006.m4a", "display_order": 7}, {"id": 6000079007, "chapter_id": 10079, "verse_number": "४-१५-५", "content_sanskrit": "शङ्खतूर्यमृदङ्गाद्या नेदुर्दुन्दुभयो दिवि।\nतत्र सर्व उपाजग्मुर्देवर्षिपितृणां गणाः॥ ४/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.007.m4a", "display_order": 8}, {"id": 6000079008, "chapter_id": 10079, "verse_number": "४-१५-६", "content_sanskrit": "ब्रह्मा जगद्गुरुर्देवः सहागत्य सुरेश्वरैः।\nवैन्यस्य दक्षिणे हस्ते दृष्ट्वा चिह्नं गदाभृतः॥ ४/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.008.m4a", "display_order": 9}, {"id": 6000079009, "chapter_id": 10079, "verse_number": "४-१५-७", "content_sanskrit": "पादयोररविन्दं च तस्मिन् मेने हरेः कलाम्।\nयस्याप्रतिहतं चक्रमंशस्य परमेष्ठिनः॥ ४/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.009.m4a", "display_order": 10}, {"id": 6000079010, "chapter_id": 10079, "verse_number": "४-१५-८", "content_sanskrit": "तस्याभिषेक आरब्धो ब्राह्मणैर्ब्रह्मवादिभिः।\nआभिषेचनिकान्यस्मै आजह्रुः सर्वतो जनाः॥ ४/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.010.m4a", "display_order": 11}, {"id": 6000079011, "chapter_id": 10079, "verse_number": "४-१५-९", "content_sanskrit": "सरित्समुद्रा गिरयो नागा गावः खगा मृगाः।\nद्यौः क्षितिः सर्वभूतानि समाजह्रुरुपायनम्॥ ४/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.011.m4a", "display_order": 12, "topics": [{"text": "तस्मै दातुं देवैरईणाहरणम्", "range": "९–१८"}]}, {"id": 6000079012, "chapter_id": 10079, "verse_number": "४-१५-१०", "content_sanskrit": "सोऽभिषिक्तो महाराजः सुवासाः साध्वलङ्कृतः।\nपत्न्याऽर्चिषाऽलङ्कृतया विरेजेऽग्निरिवापरः॥ ४/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.012.m4a", "display_order": 13}, {"id": 6000079013, "chapter_id": 10079, "verse_number": "४-१५-११", "content_sanskrit": "तस्मै जहार धनदो हैमं वीर वरासनम्।\nवरुणः सलिलस्रावमातपत्रं शशिप्रभम्॥ ४/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.013.m4a", "display_order": 14}, {"id": 6000079014, "chapter_id": 10079, "verse_number": "४-१५-१२", "content_sanskrit": "वायुश्च वालव्यजने धर्मः कीर्तिमयीं स्रजम्।\nइन्द्रः किरीटमुत्कृष्टं दण्डं संयमनं यमः॥ ४/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.014.m4a", "display_order": 15}, {"id": 6000079015, "chapter_id": 10079, "verse_number": "४-१५-१३", "content_sanskrit": "ब्रह्मा ब्रह्ममयं वर्म भारती हारमुत्तमम्।\nहरिस्सुदर्शनं चक्रं तत्पत्न्यव्याहतां श्रियम्॥ ४/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.015.m4a", "display_order": 16}, {"id": 6000079016, "chapter_id": 10079, "verse_number": "४-१५-१४", "content_sanskrit": "दशचन्द्रमसिं रुद्रः शतचन्द्रं तथाऽम्बिका।\nसोमोऽमृतमयानश्वांस्त्वष्टा रूपाश्रयं रथम्॥ ४/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.016.m4a", "display_order": 17}, {"id": 6000079017, "chapter_id": 10079, "verse_number": "४-१५-१५", "content_sanskrit": "अग्निराजगवं चापं सूर्यो रश्मिमयानिषून्।\nभूः पादुके योगमये द्यौः पुष्पबलिमन्वहम्॥ ४/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.017.m4a", "display_order": 18}, {"id": 6000079018, "chapter_id": 10079, "verse_number": "४-१५-१६", "content_sanskrit": "नाट्यं सुगीतं वादित्रमन्तर्धानं च खेचराः।\nऋषयश्चाशिषः सत्याः समुद्रः शङ्खमात्मजम्॥ ४/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.018.m4a", "display_order": 19}, {"id": 6000079019, "chapter_id": 10079, "verse_number": "४-१५-१७", "content_sanskrit": "सिन्धवः पर्वता नद्यो रथवीथीर्महात्मनः।\nसूतोऽथ मागधो बन्दी संस्तोतुमुपतस्थिरे॥ ४/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.019.m4a", "display_order": 20}, {"id": 6000079020, "chapter_id": 10079, "verse_number": "४-१५-१८", "content_sanskrit": "स्तावकांस्तानभिप्रेत्य पृथुर्वैन्यः प्रतापवान्।\nमेघनिर्ह्रादया वाचा प्रहसन्निदमब्रवीत्॥ ४/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.020.m4a", "display_order": 21}, {"id": 6000079021, "chapter_id": 10079, "verse_number": null, "content_sanskrit": "पृथुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.021.m4a", "display_order": 22}, {"id": 6000079022, "chapter_id": 10079, "verse_number": "४-१५-१९", "content_sanskrit": "हे सूत हे मागध सौम्य बन्दिन् लोकेऽधुनाऽस्पष्टगुणस्य मे स्यात्।\nकिमाश्रयो मे स्तव एष योज्यतां मा मय्यभूवन् वितथा गिरो वः॥ ४/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.022.m4a", "display_order": 23, "topics": [{"text": "तं स्तोतुमुपक्रान्तान् सूतादीन् स्वस्तवनान्निवारणम्", "range": "१९–२३"}]}, {"id": 6000079023, "chapter_id": 10079, "verse_number": "४-१५-२०", "content_sanskrit": "तस्मात् परोक्षेऽस्मदुपाश्रितान्यलं करिष्यथ स्तोत्रमपीड्यवाचः।\nसत्युत्तमश्लोकगुणानुवादे जुगुप्सितं न स्तवयन्ति सभ्याः॥ ४/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.023.m4a", "display_order": 24}, {"id": 6000079024, "chapter_id": 10079, "verse_number": "४-१५-२१", "content_sanskrit": "महद्गुणानात्मनि कर्तुमिच्छन् कः स्तावकैः स्तावयतेऽसतोऽपि।\nस वै भविष्यन्निति विप्रलब्धो जनापहासं कुमतिर्न वेद॥ ४/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.024.m4a", "display_order": 25}, {"id": 6000079025, "chapter_id": 10079, "verse_number": "४-१५-२२", "content_sanskrit": "प्रभवो ह्यात्मनः स्तोत्रं जुगुप्सन्त्यपि विश्रुताः।\nह्रीमन्तः परमोदाराः पौरुषं वा विगर्हितम्॥ ४/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.025.m4a", "display_order": 26}, {"id": 6000079026, "chapter_id": 10079, "verse_number": "४-१५-२३", "content_sanskrit": "वयं त्वविदिता लोके सूताद्यापि वरीमभिः।\nकर्मभिः कथमात्मानं गापयिष्याम बालवत्॥ ४/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_015/BhP_04.015.026.m4a", "display_order": 27}, {"id": 6000079027, "chapter_id": 10079, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे पञ्चदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]