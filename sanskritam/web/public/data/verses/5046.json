[{"id": 2190138, "chapter_id": 5046, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190139, "chapter_id": 5046, "verse_number": "१", "content_sanskrit": "सूक्ष्मं साधु समादिष्टं भवता धर्मलक्षणम् ।\nप्रतिभा त्वस्ति मे काचित्तां ब्रूयामनुमानतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190140, "chapter_id": 5046, "verse_number": "२", "content_sanskrit": "भूयांसो हृदये ये मे प्रश्नास्ते व्याहृतास्त्वया ।\nइममन्यं प्रवक्ष्यामि न राजन् विग्रहादिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190141, "chapter_id": 5046, "verse_number": "३", "content_sanskrit": "इमानि हि प्रापयन्ति सृजन्त्युत्तारयन्ति च ।\nन धर्मः परिपाठेन शक्यो भारत वेदितुम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190142, "chapter_id": 5046, "verse_number": "४", "content_sanskrit": "अन्यो धर्मः समस्थस्य विषमस्थस्य चापरः ।\nआपदस्तु कथं शक्याः परिपाठेन वेदितुम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190143, "chapter_id": 5046, "verse_number": "५", "content_sanskrit": "सदाचारो मतो धर्मः सन्तस्त्वाचारलक्षणाः ।\nसाध्यासाध्यं कथं शक्यं सदाचारो ह्यलक्षणम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190144, "chapter_id": 5046, "verse_number": "६", "content_sanskrit": "दृश्यते धर्मरूपेण अधर्मं प्राकृतश्चरन् ।\nधर्मं चाधर्मरूपेण कश्चिदप्राकृतश्चरन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190145, "chapter_id": 5046, "verse_number": "७", "content_sanskrit": "पुनरस्य प्रमाणं हि निर्दिष्टं शास्त्रकोविदैः ।\nवेदवादाश्चानुयुगं ह्रसन्तीति ह नः श्रुतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190146, "chapter_id": 5046, "verse_number": "८", "content_sanskrit": "अन्ये कृतयुगे धर्मास्त्रेतायां द्वापरेऽपरे ।\nअन्ये कलियुगे धर्मा यथाशक्तिकृता इव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190147, "chapter_id": 5046, "verse_number": "९", "content_sanskrit": "आम्नायवचनं सत्यमित्ययं लोकसङ्ग्रहः ।\nआम्नायेभ्यः परं वेदाः प्रसृता विश्वतोमुखाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190148, "chapter_id": 5046, "verse_number": "१०", "content_sanskrit": "ते चेत् सर्वे प्रमाणं वै प्रमाणं तन्न विद्यते ।\nप्रमाणे चाप्रमाणे च विरुद्धे शास्त्रता कुतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190149, "chapter_id": 5046, "verse_number": "११", "content_sanskrit": "धर्मस्य ह्रियमाणस्य बलवद्भिर्दुरात्मभिः ।\nया या विक्रियते संस्था ततः सापि प्रणश्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190150, "chapter_id": 5046, "verse_number": "१२", "content_sanskrit": "विद्म चैवं न वा विद्म शक्यं वा वेदितुं न वा ।\nअणीयान्क्षुरधाराया गरीयान् पर्वतादपि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190151, "chapter_id": 5046, "verse_number": "१३", "content_sanskrit": "गन्धर्वनगराकारः प्रथमं सम्प्रदृश्यते ।\nअन्वीक्ष्यमाणः कविभिः पुनर्गच्छत्यदर्शनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190152, "chapter_id": 5046, "verse_number": "१४", "content_sanskrit": "निपानानीव गोभ्याशे क्षेत्रे कुल्येव भारत ।\nस्मृतोऽपि शाश्वतो धर्मो विप्रहीणो न दृश्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190153, "chapter_id": 5046, "verse_number": "१५", "content_sanskrit": "कामादन्ये भयादन्ये कारणैरपरैस्तथा ।\nअसन्तो हि वृथाचारं भजन्ते बहवोऽपरे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190154, "chapter_id": 5046, "verse_number": "१६", "content_sanskrit": "धर्मो भवति स क्षिप्रं विलीनस्त्वेव साधुषु ।\nअन्ये तानाहुरुन्मत्तानपि चावहसन्त्युत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190155, "chapter_id": 5046, "verse_number": "१७", "content_sanskrit": "महाजना ह्युपावृत्ता राजधर्मं समाश्रिताः ।\nन हि सर्वहितः कश्चिदाचारः सम्प्रदृश्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190156, "chapter_id": 5046, "verse_number": "१८", "content_sanskrit": "तेनैवान्यः प्रभवति सोऽपरं बाधते पुनः ।\nदृश्यते चैव स पुनस्तुल्यरूपो यदृच्छया\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190157, "chapter_id": 5046, "verse_number": "१९", "content_sanskrit": "येनैवान्यः प्रभवति सोऽपरानपि बाधते ।\nआचाराणामनैकाग्र्यं सर्वेषामेव लक्षयेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190158, "chapter_id": 5046, "verse_number": "२०", "content_sanskrit": "चिराभिपन्नः कविभिः पूर्वं धर्म उदाहृतः ।\nतेनाचारेण पूर्वेण संस्था भवति शाश्वती\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190159, "chapter_id": 5046, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे पञ्चनवतितमोऽध्यायः ॥९५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]