[{"id": 7005703000, "chapter_id": 25703, "verse_number": "१७६-१", "content_sanskrit": "देवासुरसङ्ग्रामवर्णनम् ।\nमत्स्य उवाच ।\nएवमस्त्विति संहृष्टः शक्रस्त्रिदशवर्धनः ।\nसन्दिदेशाग्रतः सोमं युद्धाय शिशिरायुधम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005703001, "chapter_id": 25703, "verse_number": "१७६-२", "content_sanskrit": "गच्छ सोम! सहायत्वं कुरुपाशधरस्य वै ।\nअसुराणां विनाशाय जयार्थञ्च दिवौकसाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005703002, "chapter_id": 25703, "verse_number": "१७६-३", "content_sanskrit": "त्वं मत्तः प्रतिवीर्यश्च ज्योतिषाञ्चेश्वरेश्वरः ।\nत्वन्मयं सर्वलोकेषु रसं रसविदो विदुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005703003, "chapter_id": 25703, "verse_number": "१७६-४", "content_sanskrit": "क्षयवृद्धी तव व्यक्ते सागरस्येव मण्डले ।\nपरिवर्त्तस्यहोरात्रं कालं जगति योजयन् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005703004, "chapter_id": 25703, "verse_number": "१७६-५", "content_sanskrit": "लोकच्छायामयः लक्ष्म तवाङ्कः शशसन्निभः ।\nन विदुः सोमदेवापि ये च नक्षत्रयोनयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005703005, "chapter_id": 25703, "verse_number": "१७६-६", "content_sanskrit": "त्वमादित्यपथादूर्ध्वं ज्योतिषां चोपरि स्थितः ।\nतमः प्रोत्सार्य सहसा भासयस्यखिलं जगत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005703006, "chapter_id": 25703, "verse_number": "१७६-७", "content_sanskrit": "अधिकृत्कालयोगात्मा इष्टो यज्ञस्य सोऽव्ययः ।\nऔषधीशः क्रियायोनिरब्जयोनिरनुष्णभाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005703007, "chapter_id": 25703, "verse_number": "१७६-८", "content_sanskrit": "शीतांशुरमृताधार श्चपलः श्वेतवाहनः ।\nत्वं कान्तिः कान्तिवपुषा त्वं सोमः सोमपायिनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005703008, "chapter_id": 25703, "verse_number": "१७६-९", "content_sanskrit": "सौम्यस्त्वं सर्वभूतानां तिमिरघ्नस्त्वमृक्षराट् ।\nतद्गच्छत्वं महासेन! वरुणेन वरूथिनाशमयत्वासुरीं मायां यया दह्याम संयुगे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005703009, "chapter_id": 25703, "verse_number": "१७६-१०", "content_sanskrit": "सोम उवाच ।\nयन्मां वदसि युद्धार्थे देवराज! वरप्रद! ।\nएवं वर्षामि शिशिरन्दैत्यमायापकर्षणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005703010, "chapter_id": 25703, "verse_number": "१७६-११", "content_sanskrit": "एतान् मच्छीतनिर्दग्धान् पश्य स्वहिमवेष्टितान् ।\nविमायान् विमदांश्चैव दैत्यसिंहान्महाहवे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005703011, "chapter_id": 25703, "verse_number": "१७६-१२", "content_sanskrit": "तेषां हिमकरोत्सृष्टाः सपाशा हिमवृष्टयः ।\nवेष्टयन्तिस्म तान् घोरान्दैत्यान् मेघगणा इव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005703012, "chapter_id": 25703, "verse_number": "१७६-१३", "content_sanskrit": "तौ पाशशीतांशुधरौ वरुणेन्दू महाबलौ ।\nजघ्नतुर्हिमपातैश्च पाशपातैश्च दानवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005703013, "chapter_id": 25703, "verse_number": "१७६-१४", "content_sanskrit": "द्वावम्बुनाथौ समरे तौ पाश हिमयोधिनौ ।\nमृधे चेरतुरम्भोभिः क्षुब्धाविव महार्णवौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005703014, "chapter_id": 25703, "verse_number": "१७६-१५", "content_sanskrit": "ताभ्यामाप्लावितं सैन्यं तद्दानवमदृश्यत ।\nशमयामासतुर्मायां देवौ दैत्येन्द्र निर्मिताम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005703015, "chapter_id": 25703, "verse_number": "१७६-१६", "content_sanskrit": "शीतांशुजालनिर्दग्धाः पाशैश्च स्पन्दिता रणे ।\nन शेकुश्चलितुं दैत्या विशिरस्का इवाद्रयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005703016, "chapter_id": 25703, "verse_number": "१७६-१७", "content_sanskrit": "शीतांशु निहतास्ते तु दैत्यास्तोय हिमार्दिताः ।\nहिमाप्लावित सर्वाङ्गा निरूष्माण इवाग्नयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005703017, "chapter_id": 25703, "verse_number": "१७६-१८", "content_sanskrit": "तेषान्तु दिवि दैत्यानां विपरीत प्रभाणि वै ।\nविमाननि विचित्राणि प्रपतन्त्युत्पतन्ति च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005703018, "chapter_id": 25703, "verse_number": "१७६-१९", "content_sanskrit": "तान् पाशहस्तग्रथितां श्छादितां श्छीतरश्मिभिः ।\nमयो ददर्श मायावी दानवान्दिवि दानवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005703019, "chapter_id": 25703, "verse_number": "१७६-२०", "content_sanskrit": "स शिलाजालविततां खङ्गचर्माट्ट हासिनीम् ।\nपादपोत्कटकूटाग्रां कन्दराकीर्ण काननाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005703020, "chapter_id": 25703, "verse_number": "१७६-२१", "content_sanskrit": "स शिलाजालविततां खङ्गचर्माट्टहासिनीम् ।\nपादपोत्कटकूटाग्रां कन्दराकीर्ण काननाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005703021, "chapter_id": 25703, "verse_number": "१७६-२२", "content_sanskrit": "सिंहव्याघ्रगणाकीर्णां नदद्भिर्गज यूथपैः ।\nईहामृगगणाकीर्णां पवनाघूर्णितद्रुमाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005703022, "chapter_id": 25703, "verse_number": "१७६-२३", "content_sanskrit": "निर्मितां स्वेन यत्नेन कूजितां दिवि कामगाम् ।\nप्रथितां पार्वतीमायामसृजत्ससमन्ततः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005703023, "chapter_id": 25703, "verse_number": "१७६-२४", "content_sanskrit": "सासिशब्दैः शिलावर्षैः सम्पतद्भिश्च पादपैः ।\nजघान देवसङ्घांश्च दानवांश्चाप्यजीवयत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005703024, "chapter_id": 25703, "verse_number": "१७६-२५", "content_sanskrit": "नैशाकरी वारुणी च मायेऽन्तर्दधतुस्ततः ।\nअसिभिश्चायसगणै किरन् देवगणान् रणे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005703025, "chapter_id": 25703, "verse_number": "१७६-२६", "content_sanskrit": "शाश्मयन्त्रायुध घना द्रुमपर्वतसङ्कटा ।\nअभवत् घोरसञ्चार्या पृथिवी पर्वतैरिव ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005703026, "chapter_id": 25703, "verse_number": "१७६-२७", "content_sanskrit": "अश्मना प्रहताः केचित् शिलाभिः शकलीकृताः ।\nनानिरुद्धो द्रुमगणै देवोऽदृश्यत कश्चन ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005703027, "chapter_id": 25703, "verse_number": "१७६-२८", "content_sanskrit": "तदपध्वस्त धनुषं भग्न प्रहरणाविलम् ।\nनिष्प्रयत्नं सुरानीकं वर्जयित्वा गदाधरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005703028, "chapter_id": 25703, "verse_number": "१७६-२९", "content_sanskrit": "स हि युद्धगतः श्रीमानीशानोऽश्म व्यकम्पत ।\nसहिष्णुत्वाज्जगत्स्वामी न चुक्रोध गदाधरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005703029, "chapter_id": 25703, "verse_number": "१७६-३०", "content_sanskrit": "कालज्ञः कालमेघाभः समीक्षत् कालमाहवे ।\nदेवासुरविमर्दन्तु द्रष्टुकामस्तदा हरिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005703030, "chapter_id": 25703, "verse_number": "१७६-३१", "content_sanskrit": "ततो भगवता दृष्टौ रणे पावकमारूतौ ।\nचोदितौ विष्णुवाक्येन तौ मायामपकर्षताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005703031, "chapter_id": 25703, "verse_number": "१७६-३२", "content_sanskrit": "ताभ्यामुद्भ्रान्त वेगाभ्यां प्रवृद्धाभ्यां महाहवे ।\nदग्धा सा पार्वती माया भस्मीभूता ननाश ह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005703032, "chapter_id": 25703, "verse_number": "१७६-३३", "content_sanskrit": "सोऽनिलोऽनलसंयुक्तः सोऽनलश्चानिलाकुलः ।\nदैत्यसेनां ददहतुर्युगान्तेष्विवमूर्च्छितौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005703033, "chapter_id": 25703, "verse_number": "१७६-३४", "content_sanskrit": "वायुः प्रधावितस्तत्र पश्चादग्निस्तु मारुतम् ।\nचेरतुर्दानवानीके क्रीडन्तावनिलानलौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005703034, "chapter_id": 25703, "verse_number": "१७६-३५", "content_sanskrit": "भस्मावयवभूतेषु प्रपतत्सूत्पतत्सु च ।\nदानवानां विमानेषु निपतत्सु समन्ततः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005703035, "chapter_id": 25703, "verse_number": "१७६-३६", "content_sanskrit": "वातस्कन्धापविद्धेषु कृतकर्म्मणि पावके ।\nमया वधे निवृत्ते तु स्तूयमाने गदाधरे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005703036, "chapter_id": 25703, "verse_number": "१७६-३७", "content_sanskrit": "निष्प्रयत्नेषु दैत्येषु त्रैलोक्ये मुक्तबन्धने ।\nसम्प्रहृष्टेषु देवेषु साधु साध्विति सर्वशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005703037, "chapter_id": 25703, "verse_number": "१७६-३८", "content_sanskrit": "जये दशशताक्षस्य दैत्यानाञ्च पराजये ।\nदिक्षु सर्वासु शुद्धासु प्रवृत्ते धर्म्मविस्तरे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005703038, "chapter_id": 25703, "verse_number": "१७६-३९", "content_sanskrit": "अपावृते चन्द्रमसि स्वस्थानस्थे दिवाकरे ।\nप्रकृतिस्थेषु लोकेषु त्रिषु चारित्रबन्धुषु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005703039, "chapter_id": 25703, "verse_number": "१७६-४०", "content_sanskrit": "यजमानेषु भूतेषु प्रशान्तेषु च पाप्मसु ।\nअभिन्नबन्धेन मृत्यौ हूयमाने हुताशने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005703040, "chapter_id": 25703, "verse_number": "१७६-४१", "content_sanskrit": "यज्ञशोभिषु देवेषु स्वर्गार्थं दर्शयत्सु च ।\nलोकपालेषु सर्वेषु दिक्षु संयानवर्तिषु ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005703041, "chapter_id": 25703, "verse_number": "१७६-४२", "content_sanskrit": "भावे तपसि सिद्धानामभावे पापकर्म्मणाम् ।\nदेवपक्षे प्रमुदिते दैत्यपक्षे विषीदति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005703042, "chapter_id": 25703, "verse_number": "१७६-४३", "content_sanskrit": "त्रिपादविग्रहे धर्मे अधर्मे पादविग्रहे ।\nअपावृत्ते महाद्वारे वर्त्तमाने च सत्पथे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005703043, "chapter_id": 25703, "verse_number": "१७६-४४", "content_sanskrit": "लोके प्रवृत्ते धर्मेषु सुधर्मेष्वाश्रमेषु च ।\nप्रजारक्षणयुक्तेषु भ्राजमानेषु राजसु ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005703044, "chapter_id": 25703, "verse_number": "१७६-४५", "content_sanskrit": "प्रशान्तकल्मषे लोके शान्ते तमसि दानवे ।\nअग्निमारुतयोस्तत्र वृत्ते सङ्ग्राम कर्म्मणि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005703045, "chapter_id": 25703, "verse_number": "१७६-४६", "content_sanskrit": "तन्मया विपुला लोकास्ताभ्यां तज्जय कृत्क्रिया ।\nपूर्वदेवभयं श्रुत्वा मारुताग्नि कृतं महत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005703046, "chapter_id": 25703, "verse_number": "१७६-४७", "content_sanskrit": "कालनेमीति विख्यातो दानवः प्रत्यदृश्यत ।\nभास्कराकारमुकुटः शिञ्जिता भरणाङ्गदः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005703047, "chapter_id": 25703, "verse_number": "१७६-४८", "content_sanskrit": "बाहुभिस्तुलयन् व्योम क्षिपन् पद्भ्यां महीधरान् ।\nईरयन्मुखनिश्वासैर्वृष्टियुक्तान् बलाहकान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005703048, "chapter_id": 25703, "verse_number": "१७६-४९", "content_sanskrit": "तिर्यगायतरक्ताक्षं मन्दरोदग्र वर्चसम् ।\nदिधक्षन्तमिवायान्तं सर्वान् देवगणान् मृधे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005703049, "chapter_id": 25703, "verse_number": "१७६-५०", "content_sanskrit": "तर्जयन्तं सुरगणां श्छादयन्तं दिशो दश ।\nसंवर्तकाले तृषितं दृष्टं मृत्युमिवोत्थितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005703050, "chapter_id": 25703, "verse_number": "१७६-५१", "content_sanskrit": "सुतलेनोच्छ्रयवता विपुलाङ्गुलि पर्वणा ।\nलम्बाभरणपूर्णेन किञ्चिच्चलित कर्म्मणा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005703051, "chapter_id": 25703, "verse_number": "१७६-५२", "content_sanskrit": "उच्छ्रितेनाग्रहस्तेन दक्षिणेन वपुष्मता ।\nदानवान् देवनिहतानुत्तिष्ठध्वमिति ब्रुवन् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005703052, "chapter_id": 25703, "verse_number": "१७६-५३", "content_sanskrit": "तं कालनेमिं समरे द्विषतां कालचेष्टितम् ।\nवीक्षन्ते स्म सुराः सर्वे भयवित्रस्तलोचनाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005703053, "chapter_id": 25703, "verse_number": "१७६-५४", "content_sanskrit": "तं वीक्षन्तिस्म भूतानि क्रमन्तं कालनेमिनम् ।\nत्रिविक्रमाधिकमतं नारायणमिवापरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005703054, "chapter_id": 25703, "verse_number": "१७६-५५", "content_sanskrit": "सोऽत्युच्छ्रयपुरः पादमारुता घूर्णिताम्बरः ।\nप्रक्रामन्नसुरो युद्धे त्रासयामास देवताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005703055, "chapter_id": 25703, "verse_number": "१७६-५६", "content_sanskrit": "समयेनासुरेन्द्रेण परिष्वक्तस्ततो रणे ।\nकालनेमिर्बभौ दैत्यः स विष्णुरिव मन्दरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005703056, "chapter_id": 25703, "verse_number": "१७६-५७", "content_sanskrit": "अथ विव्यथिरे देवाः सर्वे शक्रपुरोगमा ।\nकालनेमिं समायान्तं दृष्ट्वा कालमिवापरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]