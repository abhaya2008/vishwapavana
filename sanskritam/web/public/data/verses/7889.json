[{"id": 33000020, "chapter_id": 7889, "verse_number": "1", "content_sanskrit": "स्फूर्तौ सप्ताविरस्त्याविर्भवति प्रादुरस्ति च। प्रादुर्भवति निर्भाति स्फुरति प्रतिभासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000021, "chapter_id": 7889, "verse_number": "2", "content_sanskrit": "वेत्ति जानाति जानीते वेद बोधति बुध्यते । निबोधते चेतयते मन्यते प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000022, "chapter_id": 7889, "verse_number": "3", "content_sanskrit": "प्रेक्षते पण्डते प्रत्येत्यवगच्छति चेतति । मनुते चोपलभते वेति वेदयतेऽञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000023, "chapter_id": 7889, "verse_number": "4", "content_sanskrit": "ज्ञाने मानयते संवेत्यात्मनेऽयम्‌ अकर्मकः । गृह्णात्यपि च गृह्णीते चिकेत्ति च चिकेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000024, "chapter_id": 7889, "verse_number": "5", "content_sanskrit": "एतौ च्छन्दसि केषाञ्चिज्‌ ज्ञानाऽर्थाः षट्‌ च विंशतिः। धातू च नीवदी ज्ञानविषयौ स्तः क्वचिद्‌ यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000025, "chapter_id": 7889, "verse_number": "6", "content_sanskrit": "विद्यासु नयते प्राज्ञो वदते तासु पण्डितः । चित्तेमनस्युरसितः करोति कुरुते परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000026, "chapter_id": 7889, "verse_number": "7", "content_sanskrit": "मनसा गोचरीकारे मनस्वित्वे मनस्यति । मेधायति तु मेधायां त्रयं मेदति मेधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000027, "chapter_id": 7889, "verse_number": "8", "content_sanskrit": "विभ्राम्यति विपर्येति विपर्यस्यति विभ्रमे । भ्रमति भ्राम्यतीत्येते विमतौ तु विमायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000028, "chapter_id": 7889, "verse_number": "9", "content_sanskrit": "विमन्यते विवदते तथा विप्रतिपद्यते । संशये पश्च सन्देग्धि सन्दिग्धे विचिकित्सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000029, "chapter_id": 7889, "verse_number": "10", "content_sanskrit": "संशेते च विशेते च वितर्कयति तूहते । मीमांसते स्यामयते वितर्के विमृशत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000030, "chapter_id": 7889, "verse_number": "11", "content_sanskrit": "विन्ते चोत्पश्यति परामृशत्यु्त्प्रेक्षते तथा । तावप्युपालोचते द्वौ पर्यालोचत इत्यमू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000031, "chapter_id": 7889, "verse_number": "12", "content_sanskrit": "विचारयति सम्पृच्छत्यात्मनेऽयम्‌ अकर्मकः । सम्प्रधारयतीत्येके समर्थयत इत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000032, "chapter_id": 7889, "verse_number": "13", "content_sanskrit": "शङ्कायां रगतीति स्याद्‌ रेकते शङ्कते त्रयम्‌ । सम्भावयति तुल्यार्थाववकल्पयतीत्यमू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000033, "chapter_id": 7889, "verse_number": "14", "content_sanskrit": "विस्रम्भते तु प्रत्येति विश्चसित्याश्चसित्यपि । श्रद्धत्ते श्रद्दधातीति विश्वासे प्रश्वसित्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000034, "chapter_id": 7889, "verse_number": "15", "content_sanskrit": "विवेके तु विवेवेक्ति विविनक्त्यात्मनेऽप्यमू । निश्चिनुते निर्णयते निर्णयति च निर्णयेऽध्यवस्यति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000035, "chapter_id": 7889, "verse_number": "16", "content_sanskrit": "निष्टङ्कयति च सप्त च निर्धारयतीह निश्चिनोति स्युः। । सङ्कल्पयति सङ्कल्पेऽभिसन्धत्त उदीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000036, "chapter_id": 7889, "verse_number": "17", "content_sanskrit": "लक्षीकरोत्युद्धिशति चोद्धेशेऽपदिशत्यपि । साक्षात्करोत्यात्मनेऽपि प्रत्यक्षेऽध्यक्षयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000037, "chapter_id": 7889, "verse_number": "18", "content_sanskrit": "साक्षयत्यपि चाध्यक्षीकरोत्यनुभवत्यपि । मिमीते मीयते माति मिनोति मिनुते मितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000038, "chapter_id": 7889, "verse_number": "19", "content_sanskrit": "प्रमाऽनुमोपमासु स्युः प्राऽनूपाऽऽदीन्यनुक्रमात्‌ । ध्याने चिन्तयति ध्यायत्यमी भावयति त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000039, "chapter_id": 7889, "verse_number": "20", "content_sanskrit": "स्मरणे त्वभिजानाति स्मरत्यध्येति च त्रयम्‌ । प्रतिजानाति चोत्कण्ठत्युत्कण्टयति मण्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000040, "chapter_id": 7889, "verse_number": "21", "content_sanskrit": "उत्कण्ठते चोत्कण्ठायाम्‌ आध्यायत्युन्मनायते ।दैवं पर्यालोचयतीत्यर्थ राध्यति चेष्टते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000041, "chapter_id": 7889, "verse_number": "22", "content_sanskrit": "प्रत्यभिजानात्यभिसन्धत्तेऽप्यनुसन्दधाति समाः। प्रतिसन्धत्ते प्रत्यवमृशति प्रतिसन्दधातीति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000042, "chapter_id": 7889, "verse_number": "23", "content_sanskrit": "विस्मृत्यां विस्मरति च स्फूर्च्छति प्रस्मरत्यपि । मोहे विचेतीभवति विमुह्यति च मूर्च्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000043, "chapter_id": 7889, "verse_number": "24", "content_sanskrit": "युप्यत्यष्टौ विलुभति रुप्यत्यृच्छति लुप्यति । प्रयच्छति स्रम्भते चाऽनवधाने प्रमाद्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000044, "chapter_id": 7889, "verse_number": "25", "content_sanskrit": "विमनीभवतीति स्युः पञ्चाऽमी विमनायते । समादधात्यवदधात्यमी प्रणिदधाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000045, "chapter_id": 7889, "verse_number": "26", "content_sanskrit": "आत्मनेऽपि त्रयं शीलत्यवधानेऽथ संश्रवे । आशृणोति प्रतिशृणोत्यभ्युपैत्यभ्युपेयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000046, "chapter_id": 7889, "verse_number": "27", "content_sanskrit": "आतिष्ठतेऽवगिरते प्रतिजानीत इत्यपि । सङ्गिरते संशृणोतीत्यात्मनेऽयम्‌ अकर्मकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000047, "chapter_id": 7889, "verse_number": "28", "content_sanskrit": "समादधात्यात्मनेऽपि मुणत्यभ्युपगच्छति । उरर्यङ्ग्यूर्यूररीभ्यः करोति कुरुते परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000048, "chapter_id": 7889, "verse_number": "29", "content_sanskrit": "प्रसौत्यभ्यनुजानाति प्रसवत्यनुमन्यते । शूषति स्माऽनुमनुतेऽप्यनुज्ञायाम्‌ अथेक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000049, "chapter_id": 7889, "verse_number": "30", "content_sanskrit": "निर्वर्णयति निध्यायत्यालोकयति पश्यति । आलोकते लक्षयते निभालयत ईक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000050, "chapter_id": 7889, "verse_number": "31", "content_sanskrit": "निरूपयत्यपि निशामयते च विचायति । विवलत्यात्मनेऽपि द्वौ लक्षयत्यपि लोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000051, "chapter_id": 7889, "verse_number": "32", "content_sanskrit": "चष्टे च्छन्दसि सम्पश्यत्यात्मने स्याद्‌ अकर्मकः । शृणोत्याकर्णयति च तद्वन्निशमयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000052, "chapter_id": 7889, "verse_number": "33", "content_sanskrit": "निशाम्यतीति श्रवणे घ्राणे जिघ्रति शिङ्घति । स्पृशत्यामृशति स्पर्शे छुपत्यालभते च षट्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000053, "chapter_id": 7889, "verse_number": "34", "content_sanskrit": "स्पशति स्पशते लेडि त्वास्वादे रसयत्यपि । लागयत्यास्वादयति लीढे राकयतीति षट्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}]