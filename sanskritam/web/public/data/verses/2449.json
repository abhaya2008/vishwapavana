[{"id": 2069195, "chapter_id": 2449, "verse_number": "१०-१-०x", "content_sanskrit": "श्रीवेदव्यासाय नमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069196, "chapter_id": 2449, "verse_number": "१०-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069197, "chapter_id": 2449, "verse_number": "१०-१-१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069198, "chapter_id": 2449, "verse_number": "१०-१-१", "content_sanskrit": "ततस्ते सहिताः सर्वे प्रयाता दक्षिणामुखाः।\nउपास्तमयवेलायां शिबिराभ्याशमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069199, "chapter_id": 2449, "verse_number": "१०-१-२", "content_sanskrit": "विमुच्य वाहांस्त्वरिता भीताः समनुबोधनात्।\nगहनं देशमासाद्य प्रच्छन्ना न्यविशन्त ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069200, "chapter_id": 2449, "verse_number": "१०-१-३", "content_sanskrit": "सेनानिवेशमभितो नातिदूरमवस्थिताः।\n[निकृत्ता निशितैः शस्त्रैः समन्तात्क्षतविक्षताः।]\nदीर्घमुष्णं च निःश्वस्य पाण्डवानन्वचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069201, "chapter_id": 2449, "verse_number": "१०-१-४", "content_sanskrit": "श्रुत्वा च निनदं घोरं पाण्डवानां जयैषिणाम्।\nअनुसारभयाद्भीताः प्राङ्मुखाः प्राद्रवन्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069202, "chapter_id": 2449, "verse_number": "१०-१-५", "content_sanskrit": "ते मुहूर्तात्ततो गत्वा श्रान्तवाहा पिपासिताः।\nनामृष्यन्त महेष्वासाः क्रोधामर्षवशङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069203, "chapter_id": 2449, "verse_number": "१०-१-६", "content_sanskrit": "राज्ञो वधेन सन्तप्ता मुहूर्तं समवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069204, "chapter_id": 2449, "verse_number": "१०-१-७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069205, "chapter_id": 2449, "verse_number": "१०-१-७", "content_sanskrit": "अश्रद्धेयमिदं कर्म कृतं मीमेन सञ्जय।\nयत्स नागायुतप्राणः पुत्रो मम निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069206, "chapter_id": 2449, "verse_number": "१०-१-८", "content_sanskrit": "अवध्यः सर्वभूतानां वज्रसंहननो युवा।\nपाण्डवैः समरे पुत्रो निहतो मम निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069207, "chapter_id": 2449, "verse_number": "१०-१-९", "content_sanskrit": "न दिष्टमभ्यतिक्रान्तुं शक्यं गावल्गणे नरैः।\nयत्समेत्य रणे पार्थैः पुत्रो मम निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069208, "chapter_id": 2449, "verse_number": "१०-१-१०", "content_sanskrit": "अद्रिसारमयं नूनं हृदयं मम सञ्जय।\nहतं पुत्रशतं श्रुत्वा यन्न दीर्णं सहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069209, "chapter_id": 2449, "verse_number": "१०-१-११", "content_sanskrit": "कथं हि वृद्धमिथुनं हतपुत्रं भविष्यति।\nन ह्यहं पाण्डुपुत्रस्य विषये वस्तुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069210, "chapter_id": 2449, "verse_number": "१०-१-१२", "content_sanskrit": "कथं राज्ञः पिता भूत्वा स्वयं राजा च सञ्जय।\nप्रेष्यभूतः प्रवर्तेयं पाण्डवेयस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069211, "chapter_id": 2449, "verse_number": "१०-१-१३", "content_sanskrit": "प्रभुज्य पृथिवीं सर्वां स्थिता मूर्धनि सञ्जय।\nकथमद्य भविष्यामि श्रोतुं शक्ष्यामि सञ्जय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069212, "chapter_id": 2449, "verse_number": "१०-१-१४", "content_sanskrit": "येन पुत्रशतं पूर्णमेकेन निहतं मम॥\nकृतं सत्यं वचस्तस्य विदुरस्य महात्मनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069213, "chapter_id": 2449, "verse_number": "१०-१-१५", "content_sanskrit": "अकुर्वता वचस्तस्य मम पुत्रेण सञ्जय॥\nअधर्मेण हते तात पुत्रे दुर्योधने मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069214, "chapter_id": 2449, "verse_number": "१०-१-१६", "content_sanskrit": "कृतवर्मा कृपो द्रौणिः किमकुर्वत सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069215, "chapter_id": 2449, "verse_number": "१०-१-१७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069216, "chapter_id": 2449, "verse_number": "१०-१-१७", "content_sanskrit": "गत्वा तु तावका राजन्नातिदूरं मनस्विनः।\nअपश्यन्त वनं घोरं नानाद्रुमलतावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069217, "chapter_id": 2449, "verse_number": "१०-१-१८", "content_sanskrit": "ते मुहूर्तं तु विश्रम्य लब्धतोयैर्हयोत्तमैः।\nसूर्यास्तमयवेलायां कौरवेयस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069218, "chapter_id": 2449, "verse_number": "१०-१-१९", "content_sanskrit": "नानामृगगणैर्जुष्टं नानापक्षिभिराकुलम्।\nनानाद्रुमलताच्छन्नं नानाव्यालनिषेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069219, "chapter_id": 2449, "verse_number": "१०-१-२०", "content_sanskrit": "नानातोयसमाकीर्णैस्तटाकैरुपशोभितम्।\nपद्मिनीशतसञ्छन्नं नीलोत्पलसमायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069220, "chapter_id": 2449, "verse_number": "१०-१-२१", "content_sanskrit": "प्रविश्य तद्वनं घोरं वीक्षमाणाः समन्ततः।\nशाखासहस्रसञ्छन्नं न्यग्रोधं ददृशुस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069221, "chapter_id": 2449, "verse_number": "१०-१-२२", "content_sanskrit": "उपेत्य तु तदा राजन्न्यग्रोधं ते महारथाः।\nददृशुर्द्विपदां श्रेष्ठाः श्रेष्ठं तं वै वनस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069222, "chapter_id": 2449, "verse_number": "१०-१-२३", "content_sanskrit": "तेऽवतीर्य रथेभ्यश्च विप्रमुच्य च वाजिनः।\nउपस्पृश्य यथान्यायं सन्ध्यामन्वासत प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069223, "chapter_id": 2449, "verse_number": "१०-१-२४", "content_sanskrit": "ततोऽस्तं पर्वतश्रेष्ठमनुप्राप्ते दिवाकरे।\nसर्वस्य जगतो धात्री शर्वरी प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069224, "chapter_id": 2449, "verse_number": "१०-१-२५", "content_sanskrit": "ग्रहनक्षत्रताराभिः प्रकीर्णाभिरलङ्कृतम्।\nनभोंऽशुकमिवाभाति प्रेक्षणीयं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069225, "chapter_id": 2449, "verse_number": "१०-१-२६", "content_sanskrit": "इच्छया ते प्रवल्गन्ति ये सत्वा रात्रिचारिणः।\nदिवाचराश्च ये सत्वास्ते निद्रावशमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069226, "chapter_id": 2449, "verse_number": "१०-१-२७", "content_sanskrit": "रात्रिञ्चराणां सत्वानां निनादोऽभूत्सुदारुणः।\nक्रव्यादाश्च प्रमुदिता घोरा प्राप्ता च शर्वरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069227, "chapter_id": 2449, "verse_number": "१०-१-२८", "content_sanskrit": "तस्मिन्रात्रिमुखे घोरे दुःखशोकसमन्विताः।\nकृतवर्मा कृपो द्रौणिरुपोपविविशुः समम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069228, "chapter_id": 2449, "verse_number": "१०-१-२९", "content_sanskrit": "उपोपविष्टाः शोचन्तो न्यग्रोधस्य समीपतः।\nतमेवार्थमतिक्रान्तं कुरुपाण्डवयोः क्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069229, "chapter_id": 2449, "verse_number": "१०-१-३०", "content_sanskrit": "निद्रया च परीताङ्गा निषेदुर्धरणीतले।\nश्रमेण सुदृढं युक्ता विक्षता विविधैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069230, "chapter_id": 2449, "verse_number": "१०-१-३१", "content_sanskrit": "ततो निद्रावशं प्राप्तौ कृपभोजौ महाबालौ।\nसुखोचितावदुःखार्हौ निषण्णौ धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069231, "chapter_id": 2449, "verse_number": "१०-१-३२", "content_sanskrit": "तौ तु सुप्तौ महाराज तस्मिन्देशे महारथौ।\n[महार्हशयनोपेतौ भूमावेव ह्यनाथवत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069232, "chapter_id": 2449, "verse_number": "१०-१-३३", "content_sanskrit": "क्रोधामर्षवशं प्राप्तो द्रोणपुत्रस्तु भारत।\nन वै स्म स जगामाथ निद्रां सर्प इव श्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069233, "chapter_id": 2449, "verse_number": "१०-१-३४", "content_sanskrit": "न लेभे स तु निद्रां वै दह्यमानोऽतिमन्युना।\nवीक्षाञ्चक्रे महाबाहुस्तद्वनं घोरदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069234, "chapter_id": 2449, "verse_number": "१०-१-३५", "content_sanskrit": "वीक्षमाणो वनोद्देशं नानासत्वैर्निषेवितम्।\nअपश्यत महाबाहुर्न्यग्रोधं वायसावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069235, "chapter_id": 2449, "verse_number": "१०-१-३६", "content_sanskrit": "तत्र काकसहस्राणि तां निशां पर्यणामयन्।\nसुखं स्वपन्तः कौरव्य पृथक्पृथगुपाश्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069236, "chapter_id": 2449, "verse_number": "१०-१-३७", "content_sanskrit": "सुप्तेषु तेषु काकेषु विस्रब्धेषु समन्ततः।\nसोऽपश्यत्सहसा यान्तमुलूकं घोरदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069237, "chapter_id": 2449, "verse_number": "१०-१-३८", "content_sanskrit": "महास्वनं महाकायं हर्यक्षं बभ्रुपिङ्गलम्।\nसुतीक्ष्णघोणानखरं सुपर्णमिव वेगितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069238, "chapter_id": 2449, "verse_number": "१०-१-३९", "content_sanskrit": "सोऽथ शब्दं मृदुं कृत्वा लीयमान इवाण़्डजः।\nन्यग्रोधस्य ततः साखां पातयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069239, "chapter_id": 2449, "verse_number": "१०-१-४०", "content_sanskrit": "सन्निपत्य तु शाखायां न्यग्रोधस्य विहङ्गमः।\nसुप्ताञ्जघान विस्रब्धान्वायसान्वायसान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069240, "chapter_id": 2449, "verse_number": "१०-१-४१", "content_sanskrit": "केषाञ्चिदच्छिनत्पक्षाञ्शिरांसि च चकर्त ह।\nचरणांश्चैव केषाञ्चिद्बभञ्ज चरणायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2069241, "chapter_id": 2449, "verse_number": "१०-१-४२", "content_sanskrit": "क्षणेनाघ्नत्स बलवान्येऽस्य दृष्टिपथे स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2069242, "chapter_id": 2449, "verse_number": "१०-१-४३", "content_sanskrit": "तेषां शरीरावयवैः शरीरैश्च विशाम्पते।\nन्यग्रोधमण्डलं सर्वं सञ्छन्नं पर्वतोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2069243, "chapter_id": 2449, "verse_number": "१०-१-४४", "content_sanskrit": "तांस्तु हत्वा ततः काकान्कौशिको मुदितोऽभवत्।\nप्रतिकृत्य यथाकामं शत्रूणां शत्रुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2069244, "chapter_id": 2449, "verse_number": "१०-१-४५", "content_sanskrit": "तद्दृष्ट्वा तादृशं कर्म कौशिकेन कृतं निशि।\nतद्भावे कृतसङ्कल्पो द्रौणिरेकोऽन्वचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2069245, "chapter_id": 2449, "verse_number": "१०-१-४६", "content_sanskrit": "उपदेशः कृतोऽनेन पक्षिणा मम संयुगे।\nशत्रूणां क्षपणं युक्तं प्राप्तः कालश्च मे मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2069246, "chapter_id": 2449, "verse_number": "१०-१-४७", "content_sanskrit": "नाद्य शक्यं मया हन्तुं पाण्डवा जितकाशिनः।\nबलवन्तः कृतोत्साहा लब्धलक्षाः प्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2069247, "chapter_id": 2449, "verse_number": "१०-१-४८", "content_sanskrit": "राज्ञः सकाशे तेषां च प्रतिज्ञातो वधो मया।\nपतङ्गाग्निसमां वृत्तिमास्यायात्मविनाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2069248, "chapter_id": 2449, "verse_number": "१०-१-४९", "content_sanskrit": "न्यायतो युध्यमानस्य प्राणत्यागो न संशयः।\nछद्मना तु भवेत्सिद्विः शत्रूणां च क्षयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2069249, "chapter_id": 2449, "verse_number": "१०-१-५०", "content_sanskrit": "तत्र सशयितादर्थाद्योऽर्थो निःसंशयो भवेत्।\nतं जना बहुमन्यन्ते येऽर्थशास्त्रविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2069250, "chapter_id": 2449, "verse_number": "१०-१-५१", "content_sanskrit": "यच्चाप्यत्र भवेत्कार्यं गर्हितं लोकनिन्दितम्।\nकर्तव्यं तन्मनुष्येण क्षत्रधर्मेण वर्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2069251, "chapter_id": 2449, "verse_number": "१०-१-५२", "content_sanskrit": "निन्दितानि च कर्माणि कुत्सितानि पदेपदे।\nसोपधानि कृतान्येव पाण्डवैरकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2069252, "chapter_id": 2449, "verse_number": "१०-१-५३", "content_sanskrit": "अस्मिन्नर्थे पुरा गीताः श्रूयन्ते धर्मवित्तमैः।\nश्लोका न्यायमवेक्षद्भिस्तत्त्वार्थास्तत्त्वदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2069253, "chapter_id": 2449, "verse_number": "१०-१-५४", "content_sanskrit": "परिश्रान्ते विदीर्णे वा भुञ्जाने वाऽपि शत्रुभिः।\nप्रस्थाने वा प्रवेशे वा प्रहर्तव्यं रिपोर्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2069254, "chapter_id": 2449, "verse_number": "१०-१-५५", "content_sanskrit": "निद्रार्तमर्धरात्रे च तथा नष्टप्रणायकम्।\nभिन्नयोधं बलं यच्च द्विधा युक्तं च यद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2069255, "chapter_id": 2449, "verse_number": "१०-१-५६", "content_sanskrit": "इत्येवं निश्चयं चक्रे सुप्तानां निशि मारणे।\nपाण्डूनां सह पाञ्चालैर्द्रोणपुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2069256, "chapter_id": 2449, "verse_number": "१०-१-५७", "content_sanskrit": "स क्रूरां मतिमास्थाय विनिश्चित्य मुहुर्मुहुः।\nसुप्तौ प्राबोधयत्तौ तु मातुलं भोजमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2069257, "chapter_id": 2449, "verse_number": "१०-१-५८", "content_sanskrit": "तौ प्रबुद्धौ महात्मानौ कृपभोजौ महाबालौ।\nनोत्तरं प्रतिपद्येतां तत्र युक्तं हिया वृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2069258, "chapter_id": 2449, "verse_number": "१०-१-५९", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा तावुभौ वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2069259, "chapter_id": 2449, "verse_number": "१०-१-६०", "content_sanskrit": "हतो दुर्योधनो राजा एकवीरो मबाहलः।\nयस्यार्थे वैरमस्माभिरासक्तं पाण्डवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2069260, "chapter_id": 2449, "verse_number": "१०-१-६१", "content_sanskrit": "एकाकी बहुभिः क्षुद्रैराहवे शुद्धविक्रमः।\nपातितो भीमसेनेन एकादशचमूपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2069261, "chapter_id": 2449, "verse_number": "१०-१-६२", "content_sanskrit": "वृकोदरेण क्षुद्रेण सुनृशंसमिदं कृतम्।\nमूर्धाभिषिक्तस्य शिरः पादेन परिमृद्गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2069262, "chapter_id": 2449, "verse_number": "१०-१-६३", "content_sanskrit": "विनर्दन्ति च पाञ्चालाः क्ष्वेलन्ति च हसन्ति च।\nधमन्ति शङ्खाञ्शतशो हृष्टा घ्नन्ति च दुन्दुभीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2069263, "chapter_id": 2449, "verse_number": "१०-१-६४", "content_sanskrit": "वादित्रघोषस्तुमुलो विमिश्रः शङ्खनिःस्वनैः।\nअनिलेनेरितो घोरो दिशः पूरयतीव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2069264, "chapter_id": 2449, "verse_number": "१०-१-६५", "content_sanskrit": "अश्वानां हेषमाणानां गजानां चैव बृंहताम्।\nसिंहनादश्च शूराणां श्रूयते सुमहानयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2069265, "chapter_id": 2449, "verse_number": "१०-१-६६", "content_sanskrit": "दिशं प्राचीं समाश्रित्य हृष्टानां गच्छतां भृशम्।\nरथनेमिस्वनाश्चैव श्रूयन्ते रोमहर्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2069266, "chapter_id": 2449, "verse_number": "१०-१-६७", "content_sanskrit": "पाण्डवैर्धार्तराष्ट्राणां यदिदं कदनं कृतम्।\nवयमेव त्रयः शिष्टा अस्मिन्महति वैशसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2069267, "chapter_id": 2449, "verse_number": "१०-१-६८", "content_sanskrit": "केचिन्नागशतप्राणाः केचित्सर्वास्त्रकोविदाः।\nनिहताः पाण्डवैर्यस्मिन्मन्ये कालस्य पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2069268, "chapter_id": 2449, "verse_number": "१०-१-६९", "content_sanskrit": "एवमेतेन भाव्यं हि नूनं कार्येण तत्त्वतः।\nयथा ह्यस्येदृशी निष्ठा कृते यत्नेऽपि दुष्करे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2069269, "chapter_id": 2449, "verse_number": "१०-१-७०", "content_sanskrit": "भवतोस्तु यदि प्रज्ञा न मोहादपचीयते।\nव्यसनेऽस्मिन्महत्यर्थे यन्नः श्रेयस्तदुच्यताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2069270, "chapter_id": 2449, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]