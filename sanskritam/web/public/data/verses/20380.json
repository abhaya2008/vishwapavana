[{"id": 7000380000, "chapter_id": 20380, "verse_number": "२-५२-१", "content_sanskrit": "शिवशर्मोवाच ।\nमंगले श्रूयतां वाक्यं यदि पृच्छसि सांप्रतम् ।\nयदर्थं हि त्वया पृष्टं तन्निबोध वरानने॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000380001, "chapter_id": 20380, "verse_number": "२-५२-२", "content_sanskrit": "इयं हि सांप्रतं प्राप्ता वराकी भिक्षुरूपिणी ।\nवसुदत्तस्य विप्रस्य सुतेयं चारुलोचने॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000380002, "chapter_id": 20380, "verse_number": "२-५२-३", "content_sanskrit": "सुदेवा नाम भद्रेयं मम जाया प्रिया सदा ।\nकेनापि कारणेनैव देशं त्यक्त्वा समागता॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000380003, "chapter_id": 20380, "verse_number": "२-५२-४", "content_sanskrit": "ममदुःखेन दग्धेयं वियोगेन वरानने ।\nमां ज्ञात्वा तु समायाता भिक्षुरूपेण ते गृहम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000380004, "chapter_id": 20380, "verse_number": "२-५२-५", "content_sanskrit": "एवं ज्ञात्वा त्वया भद्रे आतिथ्यं परिशोभितम् ।\nकर्त्तव्यं न च संदेह इच्छंत्या मम सुप्रियम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000380005, "chapter_id": 20380, "verse_number": "२-५२-६", "content_sanskrit": "भर्तुर्वाक्यं निशम्यैव मंगला पतिदेवता ।\nहर्षेण महताविष्टा स्वयमेव सुमंगला॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000380006, "chapter_id": 20380, "verse_number": "२-५२-७", "content_sanskrit": "स्नानाच्छादन भोज्यं च मम चक्रे वरानने ।\nरत्नकांचनयुक्तैश्चाभरणैश्च पतिव्रता॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000380007, "chapter_id": 20380, "verse_number": "२-५२-८", "content_sanskrit": "अहं हि भूषिता भद्रे तयैव पतिकाम्यया ।\nतयाहं भूषिता देवि मानस्नानैश्च भोजनैः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000380008, "chapter_id": 20380, "verse_number": "२-५२-९", "content_sanskrit": "भर्त्राहं मानिता देवि जातं दुःखमनंतकम् ।\nममोरसि महातीव्रं सर्वप्राणविनाशनम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000380009, "chapter_id": 20380, "verse_number": "२-५२-१०", "content_sanskrit": "तस्या मानो मया दृष्टो दुःखमात्मगतं तथा ।\nचिंता मे दारुणा जाता यया प्राणा व्रजंति मे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000380010, "chapter_id": 20380, "verse_number": "२-५२-११", "content_sanskrit": "कदापि वचनं दत्तं न मया पापया शुभम् ।\nअस्यैव विप्रवर्यस्य आचरंत्या च दुष्कृतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000380011, "chapter_id": 20380, "verse_number": "२-५२-१२", "content_sanskrit": "पादप्रक्षालनं नैव अंगसंवाहनं नहि ।\nएकांतं न मया दत्तं तस्यैव हि महात्मनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000380012, "chapter_id": 20380, "verse_number": "२-५२-१३", "content_sanskrit": "संभाषां कथमस्यैव करिष्ये पापनिश्चया ।\nरात्रौ चैव तदा तत्र पतिता दुःखसागरे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000380013, "chapter_id": 20380, "verse_number": "२-५२-१४", "content_sanskrit": "एवं हि चिंतमानायाः स्फुटितं हृदयं मम ।\nगताः प्राणास्तदा कायं परित्यज्य वरानने॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000380014, "chapter_id": 20380, "verse_number": "२-५२-१५", "content_sanskrit": "तत्र दूताः समायाता धर्मराजस्य वै तदा ।\nवीराश्च दारुणाः क्रूरा गदाचक्रासिधारिणः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000380015, "chapter_id": 20380, "verse_number": "२-५२-१६", "content_sanskrit": "तैस्तु बद्धा महाभागे शृंखलैर्दृढबंधनैः ।\nनीता यमपुरं तैस्तु रुदमाना सुदुःखिता॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000380016, "chapter_id": 20380, "verse_number": "२-५२-१७", "content_sanskrit": "मुद्गरैस्ताड्यमानाहं दुर्गमार्गेण पीडिता ।\nभर्त्स्यमाना यमस्याग्रे तैस्तत्राहं प्रवेशिता॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000380017, "chapter_id": 20380, "verse_number": "२-५२-१८", "content_sanskrit": "दृष्टाहं यमराजेन सक्रोधेन महात्मना ।\nअंगारसंचये क्षिप्ता क्षिप्ता नरकसंचये॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000380018, "chapter_id": 20380, "verse_number": "२-५२-१९", "content_sanskrit": "लोहस्य पुरुषं कृत्वा अग्निना परितापितः ।\nममोरसि समुत्क्षिप्तो निजभर्तुश्च वंचनात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000380019, "chapter_id": 20380, "verse_number": "२-५२-२०", "content_sanskrit": "नानापीडातिसंतप्ता नरकाग्निप्रतापिता ।\nतैलद्रोण्यां परिक्षिप्ता करम्भवालुकोपरि॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000380020, "chapter_id": 20380, "verse_number": "२-५२-२१", "content_sanskrit": "असिपत्रैश्च संच्छिन्ना जलमंत्रेण वाहिता ।\nकूटशाल्मलिवृक्षेषु क्षिप्ता तेन महात्मना॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000380021, "chapter_id": 20380, "verse_number": "२-५२-२२", "content_sanskrit": "पूयशोणितविष्ठायां पतिता कृमिसंकुले ।\nसर्वेषु नरकेष्वेवं क्षिप्ताहं नृपनंदिनि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000380022, "chapter_id": 20380, "verse_number": "२-५२-२३", "content_sanskrit": "पीडायुक्तेषु तीव्रेषु तेनैवापि महात्मना ।\nकरपत्रैः पाटिताहं शक्तिभिस्ताडिता भृशम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000380023, "chapter_id": 20380, "verse_number": "२-५२-२४", "content_sanskrit": "अन्येष्वेव नरकेषु पातिता नृपनंदिनि ।\nयोनिगर्तेषु क्षिप्तास्मि पतिता दुःखसंकटे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000380024, "chapter_id": 20380, "verse_number": "२-५२-२५", "content_sanskrit": "धर्मराजेन तेनाहं नरकेषु निपातिता ।\nवल्गुनीयोनिमासाद्य भुक्तं दुःखं सुदारुणम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000380025, "chapter_id": 20380, "verse_number": "२-५२-२६", "content_sanskrit": "गताहं क्रौष्टुकीं योनिं शुनीयोनिं पुनर्गता ।\nसकुक्कुटीं च मार्जारीमाखुयोनिं गता ह्यहम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000380026, "chapter_id": 20380, "verse_number": "२-५२-२७", "content_sanskrit": "एवं योनिविशेषेषु पापयोनिषु तेन च ।\nक्षिप्तास्मि धर्मराजेन पीडिता सर्वयोनिषु॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000380027, "chapter_id": 20380, "verse_number": "२-५२-२८", "content_sanskrit": "तेनैवाहं कृता भूमौ शूकरी नृपनंदिनि ।\nतवहस्ते महाभागे संति तीर्थान्यनेकशः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000380028, "chapter_id": 20380, "verse_number": "२-५२-२९", "content_sanskrit": "तेनोदकेन सिक्तास्मि त्वयैव वरवर्णिनि ।\nमम पापं गतं देवि प्रसादात्तव सुंदरि॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000380029, "chapter_id": 20380, "verse_number": "२-५२-३०", "content_sanskrit": "तवैव तेजःपुण्येन जातं ज्ञानं वरानने ।\nइदानीं मामुद्धरस्व पतितां नरकसंकटे॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000380030, "chapter_id": 20380, "verse_number": "२-५२-३१", "content_sanskrit": "यदा नोद्धरसे देवि पुनर्यास्यामि दारुणम् ।\nनरकं च महाभागे त्राहि मां दुःखभागिनीम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000380031, "chapter_id": 20380, "verse_number": "२-५२-३२", "content_sanskrit": "गताहं पापभावेन दीनाहं च निराश्रया ।\nसुदेवोवाच ।\nकिं कृतं हि मया भद्रे सुकृतं पुण्यसंभवम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000380032, "chapter_id": 20380, "verse_number": "२-५२-३३", "content_sanskrit": "येनाहमुद्धरे त्वां वै तन्मे त्वं वद सांप्रतम् ।\nशूकर्युवाच ।\nअयं राजा महाभाग इक्ष्वाकुर्मनुनंदनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000380033, "chapter_id": 20380, "verse_number": "२-५२-३४", "content_sanskrit": "विष्णुरेष महाप्राज्ञो भवती श्रीर्हि नान्यथा ।\nपतिव्रता महाभागा पतिव्रतपरायणा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000380034, "chapter_id": 20380, "verse_number": "२-५२-३५", "content_sanskrit": "त्वं सती सर्वदा भद्रे सर्वतीर्थमयी प्रिया ।\nदेवि सर्वमयी नित्यं सर्वदेवमयी सदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000380035, "chapter_id": 20380, "verse_number": "२-५२-३६", "content_sanskrit": "महापतिव्रता लोक एका त्वं नृपतेः प्रिया ।\nयया शुश्रूषितो भर्ता भवत्या हि अहर्निशम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000380036, "chapter_id": 20380, "verse_number": "२-५२-३७", "content_sanskrit": "एकस्य दिवसस्यापि पुण्यं देहि वरानने ।\nपति शुश्रूषितस्यापि यदि मे कुरुषे प्रियम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000380037, "chapter_id": 20380, "verse_number": "२-५२-३८", "content_sanskrit": "मम माता पिता त्वं वै त्वं मे गुरुः सनातनः ।\nअहं पापा दुराचारा असत्या ज्ञानवर्जिता॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000380038, "chapter_id": 20380, "verse_number": "२-५२-३९", "content_sanskrit": "मामुद्धर महाभागे भीताहं यमताडनैः ।\nसुकलोवाच ।\nएवं श्रुत्वा तया प्रोक्तं समालोक्य नृपं तदा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000380039, "chapter_id": 20380, "verse_number": "२-५२-४०", "content_sanskrit": "किं करोमि महाराज एषा किं वदते पशुः ।\nइक्ष्वाकुरुवाच ।\nएनां दुःखां वराकीं वै पापयोनिं गतां शुभे॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000380040, "chapter_id": 20380, "verse_number": "२-५२-४१", "content_sanskrit": "समुद्धरस्व पुण्यैस्त्वं महच्छ्रेयो भविष्यति ।\nएवमुक्ता वरा नारी सुदेवा चारुमंगला॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000380041, "chapter_id": 20380, "verse_number": "२-५२-४२", "content_sanskrit": "उवाचैकाब्दपुण्यं ते मया दत्तं वरानने ।\nएवमुक्तेन वाक्येन तया देव्या हि तत्क्षणात्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000380042, "chapter_id": 20380, "verse_number": "२-५२-४३", "content_sanskrit": "रूपयौवनसंपन्ना दिव्यमालाविभूषिता ।\nदिव्यदेहा च संभूता तेजोज्वालासमावृता॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000380043, "chapter_id": 20380, "verse_number": "२-५२-४४", "content_sanskrit": "सर्वभूषणशोभाढ्या नानारत्नैश्च शोभिता ।\nसंजाता दिव्यरूपा सा दिव्यगंधानुलेपना॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000380044, "chapter_id": 20380, "verse_number": "२-५२-४५", "content_sanskrit": "दिव्यं विमानमारूढा अंतरिक्षं गता सती ।\nतामुवाच ततो राज्ञीं प्रणतानतकंधरा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000380045, "chapter_id": 20380, "verse_number": "२-५२-४६", "content_sanskrit": "स्वस्त्यस्तु ते महाभागे प्रसादात्तव सुंदरि ।\nव्रजामि पातकान्मुक्ता स्वर्गं पुण्यतमं शुभम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000380046, "chapter_id": 20380, "verse_number": "२-५२-४७", "content_sanskrit": "प्रणम्यैवं गता स्वर्गं सुदेवा शृणु सत्तम ।\nएतत्ते सर्वमाख्यातं सुकलाया निवेदितम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]