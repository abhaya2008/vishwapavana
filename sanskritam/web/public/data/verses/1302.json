[{"id": 2014578, "chapter_id": 1302, "verse_number": "२-४३-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो भीष्मस्य तच्छ्रुत्वा वचः काले युधिष्ठिरः।\nज्ञापनार्थाय सर्वेषां भीष्मं पुनरथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014579, "chapter_id": 1302, "verse_number": "२-४३-२", "content_sanskrit": "विस्तरेणास्य देवस्य कर्माणीच्छामि सर्वशः।\nश्रोतुं भगवतस्तानि प्रब्रवीहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014580, "chapter_id": 1302, "verse_number": "२-४३-३", "content_sanskrit": "कर्मणामानुपूर्वा च प्रादुर्भावाश्च ये विभोः।\nयथा च प्रकृतिः कृष्णे तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014581, "chapter_id": 1302, "verse_number": "२-४३-४", "content_sanskrit": "एवमुक्तस्तदा भीष्मः प्रोवाच भरतर्षभ।\nयुधिष्ठिरममित्रघ्नं तस्मिन्त्राजसमागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014582, "chapter_id": 1302, "verse_number": "२-४३-५", "content_sanskrit": "समक्षं वासुदेवस्य देवस्येव शतक्रतोः।\nकर्माण्यसुकराण्यन्यैराचचक्षे जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014583, "chapter_id": 1302, "verse_number": "२-४३-६", "content_sanskrit": "शृण्वतां पार्थिवानां च धर्मराजस्य चान्तिके।\nइदं मतिमतां श्रेष्ठः कृष्णं प्रति विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014584, "chapter_id": 1302, "verse_number": "२-४३-७", "content_sanskrit": "नाम्नैवामन्त्र्य राजेन्द्र चेदिराजमरिन्दमम्।\nभीमकर्मा ततो भीष्णो भूयः स इतमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014585, "chapter_id": 1302, "verse_number": "२-४३-८", "content_sanskrit": "करूणामपि राजानं युधिष्ठिरमभाषत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014586, "chapter_id": 1302, "verse_number": "२-४३-८x", "content_sanskrit": "भीष्ण उवाच।\nवर्तमानामतीतां च शृणु राजन्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014587, "chapter_id": 1302, "verse_number": "२-४३-९", "content_sanskrit": "ईश्वरस्योत्तमस्यैनां कर्मणां गहनां गतिम्।\nअव्यक्तो व्यक्तलिङ्गस्थो य एष भगवान्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014588, "chapter_id": 1302, "verse_number": "२-४३-१०", "content_sanskrit": "पुरा नारायणो देवः स्वयम्भूः प्रपितामहः।\nसहस्रशीर्षः पुरुषो ध्रवोऽनन्तः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014589, "chapter_id": 1302, "verse_number": "२-४३-११", "content_sanskrit": "सहस्रास्यः सहस्राश्चः सहस्रचरणो विभुः।\nसहस्रवाहुः सर्वज्ञो देवो नामसहस्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014590, "chapter_id": 1302, "verse_number": "२-४३-१२", "content_sanskrit": "सहस्रमुकुटो देवो विश्वरूपो महाद्युतिः।\nअनेकवर्णो देवादिरव्यक्ताद्वै परे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014591, "chapter_id": 1302, "verse_number": "२-४३-१३", "content_sanskrit": "असृजत्सलिलं पूर्वं स च नारायणः प्रभुः।\nततस्तु भगवांस्तोये ब्रह्माणमसृजत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014592, "chapter_id": 1302, "verse_number": "२-४३-१४", "content_sanskrit": "ब्रह्मा चतुर्मुखो लोकान्सर्वांस्तानसृजत्स्वयम्।\nआदिकाले पुरा ह्येवं सर्वलोकस्य चोद्भवः।\nपुरा यः प्रलये प्राप्ते नष्टे स्थावरजङ्गमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014593, "chapter_id": 1302, "verse_number": "२-४३-१५", "content_sanskrit": "ब्रह्मादिषु प्रलीनेषु नष्टे लोके चराचरे।\nआभूतसम्प्लवे प्राप्ते प्रलीने प्रकृतौ महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014594, "chapter_id": 1302, "verse_number": "२-४३-१६", "content_sanskrit": "एकस्मिष्ठति सर्वात्मा स तु नारायणः प्रभुः।\nनारायणस्य चाङ्गानि सर्वदैवानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014595, "chapter_id": 1302, "verse_number": "२-४३-१७", "content_sanskrit": "शिरस्तस्य दिवं राजन्नाभिः खं चरणौ मही।\nअश्विनौ कर्णयोर्देवौ चक्षुषी शशिभास्करौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014596, "chapter_id": 1302, "verse_number": "२-४३-१८", "content_sanskrit": "इन्द्रवैश्वानरौ देवौ मुखं तस्य महात्मनः।\nअन्यानि सर्वदैवानि सर्वाङ्गानि महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014597, "chapter_id": 1302, "verse_number": "२-४३-१९", "content_sanskrit": "सर्वं चापि हरौ संस्थं सूत्रे मणिगणा इव।\nआभूतसम्प्लवान्तेऽथ दृष्ट्वा सर्वं तमोन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014598, "chapter_id": 1302, "verse_number": "२-४३-२०", "content_sanskrit": "नारायणो महायोगी सर्वज्ञः परमात्मवान्।\nब्रह्मभूतस्तदात्मानं ब्रह्मणमसृजत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014599, "chapter_id": 1302, "verse_number": "२-४३-२१", "content_sanskrit": "सोऽध्यक्षः सर्वभूतानां प्रभूतप्रभवोऽच्युतः।\nसनत्कुमारं रुद्रं च सप्तर्षीश्च तपोधनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014600, "chapter_id": 1302, "verse_number": "२-४३-२२", "content_sanskrit": "सर्वमेवासृजद्ब्रह्मा तथा लोकांस्तथा प्रजाः।\nते च तद्व्यसृजंस्तत्र प्राप्तकाले युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014601, "chapter_id": 1302, "verse_number": "२-४३-२३", "content_sanskrit": "तेभ्योऽभवन्महात्मभ्यो बहुधा ब्रह्म शाश्वतम्।\nकल्पानां बहुकोट्यश्चसमतीतास्तु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014602, "chapter_id": 1302, "verse_number": "२-४३-२४", "content_sanskrit": "आभूतसम्प्लवाश्चैव बहुधाऽद्धाऽपचक्रमुः।\nमन्वन्तरयुगा राजन्सङ्कल्पो भूतसम्प्लवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014603, "chapter_id": 1302, "verse_number": "२-४३-२५", "content_sanskrit": "चक्रवत्परिवर्तन्ते सर्वं विषमुखं जगत्।\nसृष्ट्वा चतुर्मुखं देवं देवो नारायणः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014604, "chapter_id": 1302, "verse_number": "२-४३-२६", "content_sanskrit": "स लोकानां हितार्थाय क्षीरोदे वसति प्रभुः।\nब्रह्मा च सर्वलोकानां लोकस्य च पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014605, "chapter_id": 1302, "verse_number": "२-४३-२७", "content_sanskrit": "ततो नारायणो देवः सर्वस्य प्रपितामहः। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014606, "chapter_id": 1302, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि त्रिचत्वारिंशोऽध्यायः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]