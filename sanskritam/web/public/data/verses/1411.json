[{"id": 2019740, "chapter_id": 1411, "verse_number": "३-४९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019741, "chapter_id": 1411, "verse_number": "३-४९-१", "content_sanskrit": "अस्त्रहेतोर्गते पार्थे शक्रलोकं महात्मनि।\nयुधिष्ठिरप्रभृतयः किमकुर्वत पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019742, "chapter_id": 1411, "verse_number": "३-४९-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019743, "chapter_id": 1411, "verse_number": "३-४९-२", "content_sanskrit": "अस्त्रहेतोर्गते पार्थे शक्रलोकं महात्मनि।\nन्यवसन्कृष्णया सार्धं काम्यके भरतर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019744, "chapter_id": 1411, "verse_number": "३-४९-३", "content_sanskrit": "ततः कदाचिदेकान्ते विविक्ते मृदुशाद्वले।\nदुःखार्ता भरतश्रेष्ठा निषेदुः सह कृष्णया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019745, "chapter_id": 1411, "verse_number": "३-४९-४", "content_sanskrit": "धनंजयं शोचमानाः साश्रुकण्ठाः सुदुःखिताः।\nतद्वियोगार्दितान्सर्वाञ्शोकः समभिपुप्लुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019746, "chapter_id": 1411, "verse_number": "३-४९-५", "content_sanskrit": "धनंजयवियोगाच्च राज्यभ्रंशाच्च दुःखिताः।\nअथ भीमो महाबाहुर्युधिष्ठिरमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019747, "chapter_id": 1411, "verse_number": "३-४९-६", "content_sanskrit": "निदेशात्ते महाराज गतोऽसौ भरतर्षभः।\nअर्जुनः पाण्डुपुत्राणां यस्मिन्प्राणाः प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019748, "chapter_id": 1411, "verse_number": "३-४९-७", "content_sanskrit": "यस्मिन्विनष्टे पाञ्चालाः सह पुत्रैस्तथा वयम्।\nसात्यकिर्वासुदेवश्च विनश्येयुर्न संशयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019749, "chapter_id": 1411, "verse_number": "३-४९-८", "content_sanskrit": "योसौ गच्छति धर्मात्मा बहून्क्लेशान्विचिन्तयन्।\nभवन्नियोगाद्बीभत्सुस्ततो दुःखतरं नु किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019750, "chapter_id": 1411, "verse_number": "३-४९-९", "content_sanskrit": "यस्य बाहू समाश्रित्य वयं सर्वे महात्मनः।\nमन्यामहे जितानाजौ परान्प्राप्तां च मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019751, "chapter_id": 1411, "verse_number": "३-४९-१०", "content_sanskrit": "यस्य प्रभावाद्धि वयं सभामध्ये धनुष्मतः।\n`जितान्मन्यामहे सर्वान्धार्तराष्ट्रात्ससौबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019752, "chapter_id": 1411, "verse_number": "३-४९-११", "content_sanskrit": "यस्य प्रभावान्न मया सभामध्ये महाबलाः।\nनीता लोकममुं सर्वे धार्तराष्ट्राः ससौबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019753, "chapter_id": 1411, "verse_number": "३-४९-१२", "content_sanskrit": "तेवयं बाहुबलिनः क्रोधमुत्थितमात्मनः।\nसहामहे भवन्मूलं वासुदेवेन पालिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019754, "chapter_id": 1411, "verse_number": "३-४९-१३", "content_sanskrit": "मया हि सह कृष्णेन हत्वा कर्णमुखान्परान्।\nस्वबाहुविजितां कृत्स्नां प्रशाधीनां वसुंधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019755, "chapter_id": 1411, "verse_number": "३-४९-१४", "content_sanskrit": "भतो द्यूतदोषेण सर्वेवयमुपप्लुताः।\nअहीनपौरुषा राजन्बलिभिर्बलवत्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019756, "chapter_id": 1411, "verse_number": "३-४९-१५", "content_sanskrit": "क्षात्रं धर्मं महाराज त्वमवेक्षितुमर्हसि।\nग हिधर्मो महाराज त्रियस्य वनाश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019757, "chapter_id": 1411, "verse_number": "३-४९-१६", "content_sanskrit": "राज्यमेव परंधर्मं क्षत्रियस्य विदुर्बुधाः।\nस क्षत्रधर्मविद्राजन्माधर्म्यान्नीनशः पथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019758, "chapter_id": 1411, "verse_number": "३-४९-१७", "content_sanskrit": "प्राग्द्वादश समा राजन्धार्तराष्ट्रान्निहन्महि।\nनिवर्त्य च वनात्पार्थमानाय्य च जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019759, "chapter_id": 1411, "verse_number": "३-४९-१८", "content_sanskrit": "व्यूढानीकान्महाराज जवेनैव महाहवे।\nधार्तराष्ट्रानमुं लोकं गमयाम विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019760, "chapter_id": 1411, "verse_number": "३-४९-१९", "content_sanskrit": "सर्वानहं हनिष्यामि धार्तराष्ट्रान्ससौबलान्।\nदुर्योधनं च कर्णं च यो वाऽन्यः प्रतियोत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019761, "chapter_id": 1411, "verse_number": "३-४९-२०", "content_sanskrit": "मया प्रशमिते पश्चात्त्वमेष्यसि वनं पुनः।\nएवं कृते न ते दोषो भविष्यति विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019762, "chapter_id": 1411, "verse_number": "३-४९-२१", "content_sanskrit": "यज्ञैश्च विविधैस्तात कृतंपापमरिंदम।\nअवधूय महाराजगच्छेम स्वर्गमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019763, "chapter_id": 1411, "verse_number": "३-४९-२२", "content_sanskrit": "एवमेतद्भवेद्राजन्यदि राजा न बालिशः।\nअस्माकं दीर्घसूत्रः स्याद्भवान्धर्मपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019764, "chapter_id": 1411, "verse_number": "३-४९-२३", "content_sanskrit": "निकृत्या निकृतिप्रत्रा हन्तव्या इति निश्चयः।\nन हि नैकृतिकं हत्वा निकृत्या पापमुच्यते।\nतथा भारत धर्मेषु धर्मज्ञैरिह दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019765, "chapter_id": 1411, "verse_number": "३-४९-२४", "content_sanskrit": "अहोरात्रं महाराज तुल्यं संवत्सरेण ह।\nतथैव वेदवचनं श्रूयते नित्यदा विभो।\nसंवत्सरो महाराज पूर्णो भवति कृच्छ्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019766, "chapter_id": 1411, "verse_number": "३-४९-२५", "content_sanskrit": "यदि वेदाः प्रमाणं ते दिवसादूर्ध्वमच्युत।\nतयोदशादितः कालो ज्ञायतां परिनिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019767, "chapter_id": 1411, "verse_number": "३-४९-२६", "content_sanskrit": "कालो दुर्योधनं हन्तुं सानुबन्धमरिंदम।\nएकाग्रां पृथिवीं सर्वां पुरा राजन्करोति सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019768, "chapter_id": 1411, "verse_number": "३-४९-२७", "content_sanskrit": "द्यूतप्रियेण राजेन्द्र तथा तद्भवता कृतम्।\nप्रायेणाज्ञातच्रयायां वयं सर्वेनिपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019769, "chapter_id": 1411, "verse_number": "३-४९-२८", "content_sanskrit": "न तं देशं प्रपश्यामि यत्र सोऽस्मान्सुदुर्जनः।\nन विज्ञास्यति दुष्टात्मा चारैरिति सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019770, "chapter_id": 1411, "verse_number": "३-४९-२९", "content_sanskrit": "अधिगम्य च सर्वान्नो वनवासमिमं ततः।\nप्रव्राजयिष्यतिपुनर्निकृत्याऽधमपूरुषः।\nयद्यस्मानभिगच्छेत पापः स हि कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019771, "chapter_id": 1411, "verse_number": "३-४९-३०", "content_sanskrit": "अज्ञातचर्यामुत्तीर्णान्दृष्ट्वा च पुनराह्वयेत्।\nद्यूतेन ते महाराज पुनर्युद्धं प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019772, "chapter_id": 1411, "verse_number": "३-४९-३१", "content_sanskrit": "भवांश्च पुनराहूतो द्यूतेनैवापनेष्यति।\nस तथाऽक्षेषु कुशलो निश्चितो गतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019773, "chapter_id": 1411, "verse_number": "३-४९-३२", "content_sanskrit": "चरिष्यसि महाराज वनेषु वसतीः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019774, "chapter_id": 1411, "verse_number": "३-४९-३३", "content_sanskrit": "यद्यस्मान्सुमहाराज कृपणान्कर्तुमर्हसि।\nयावज्जीवमवेक्षस्व वेदधर्मांश्च कृत्स्नशः।\nनिकृत्या निकृतिप्रज्ञो हन्तव्य इति निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019775, "chapter_id": 1411, "verse_number": "३-४९-३४", "content_sanskrit": "अनुज्ञातस्त्वया गत्वायावच्छक्ति सुयोधनम्।\nयथैव कक्षमुत्सृष्टो दहेदनिलसारथिः।\nहनिष्यामि तथा मन्दमनुजानातु मे भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019776, "chapter_id": 1411, "verse_number": "३-४९-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019777, "chapter_id": 1411, "verse_number": "३-४९-३५", "content_sanskrit": "एवं ब्रुवाणं भीमं तु धर्मराजो युधिष्ठिरः।\nउवाच सान्त्वयन्राजा मूर्न्ध्युपाघ्राय पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019778, "chapter_id": 1411, "verse_number": "३-४९-३६", "content_sanskrit": "असशयं महाबाहो हनिष्यसि सुयोधनम्।\nवर्षात्रयोदशादूर्ध्वं सह गाण्डीवधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019779, "chapter_id": 1411, "verse_number": "३-४९-३७", "content_sanskrit": "यत्त्वमाभाषसे पार्थ प्राप्तः काल इति प्रभो।\nअनृतं नत्सहे वक्तुं न ह्येतन्मयि विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019780, "chapter_id": 1411, "verse_number": "३-४९-३८", "content_sanskrit": "अन्तरेणापि कौन्तेय निकृतिंपापनिश्चयम्।\nहन्ता त्वमसि दुर्धर्ष सानुबन्धं सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019781, "chapter_id": 1411, "verse_number": "३-४९-३९", "content_sanskrit": "एवं ब्रुवति भीमं तु धर्मराजे युधिष्ठिरे।\nआजगाम महाभागो बृहदश्वो महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019782, "chapter_id": 1411, "verse_number": "३-४९-४०", "content_sanskrit": "तमभिप्रेक्ष्यधर्मात्मा संप्राप्तं धर्मचारिणम्।\nशास्त्रवन्मधुपर्केण पूजयामास धर्मराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019783, "chapter_id": 1411, "verse_number": "३-४९-४१", "content_sanskrit": "आश्वस्तं चैनमासीनमुपासनो युधिष्ठिरः।\nअभिप्रेक्ष्य महाबाहुः कृपणं बह्वभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019784, "chapter_id": 1411, "verse_number": "३-४९-४२", "content_sanskrit": "अक्षद्यूते च भगवन्धनं राज्यं च मे हृतम्।\nआहूय निकृतिप्रज्ञैः कितवैरक्षकोविदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019785, "chapter_id": 1411, "verse_number": "३-४९-४३", "content_sanskrit": "अनक्षज्ञस्य हि सतो निकृत्या पापनिश्चयैः।\nभार्या च मे सभां नीता प्राणेभ्योपि गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019786, "chapter_id": 1411, "verse_number": "३-४९-४४", "content_sanskrit": "पुनर्द्यूतेन मां जित्वा वनवासां सुदारुणम्।\nप्राव्राजयन्मंहारण्यमजिनैः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019787, "chapter_id": 1411, "verse_number": "३-४९-४५", "content_sanskrit": "अहं वने दुर्वसतीर्वसन्परमदुःखितः।\nअक्षद्यूताभिषङ्गेण गिरः शृण्वन्सुदारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019788, "chapter_id": 1411, "verse_number": "३-४९-४६", "content_sanskrit": "आर्तानां सुहृदां वाचो द्यूतप्रभृति शंसताम्।\nअहं हृदि श्रिताः स्मृत्वा सर्वरात्रीर्विचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2019789, "chapter_id": 1411, "verse_number": "३-४९-४७", "content_sanskrit": "यस्मिंश्च वयमायत्ताः सदा गाण्डीवधन्वनि।\n`स चेन्द्रलोकं गतवानस्त्रहेतोर्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2019790, "chapter_id": 1411, "verse_number": "३-४९-४८", "content_sanskrit": "विना महात्मना तेन गतसत्व इवास्महे।\nकदा द्रक्ष्यामि बीभत्सुं कृतास्त्रं पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2019791, "chapter_id": 1411, "verse_number": "३-४९-४९", "content_sanskrit": "`इति सर्वे महेष्वासं चिन्तयाना धनंजयम्।\nअनेन तु विषण्णोऽहं कारणेन सहानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2019792, "chapter_id": 1411, "verse_number": "३-४९-५०", "content_sanskrit": "वनवासान्निवृत्तं मां पुनस्ते पापबुद्धयः।\nजानन्तः प्रीयमाणा वै देवने भ्रातृभिः सह।\nद्यूतेनैवाह्वयिष्यन्ति बलादक्षेषु तद्विदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2019793, "chapter_id": 1411, "verse_number": "३-४९-५१", "content_sanskrit": "आहूतश्च पुनर्द्यूते नास्मि शक्तो निवर्तितुम्।\nपणे च मम नात्यर्थं वसु किंचन विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2019794, "chapter_id": 1411, "verse_number": "३-४९-५२", "content_sanskrit": "एतत्सर्वमनुध्यायंश्चिन्तयानो दिवानिशम्।\nन मत्तो दुःखिततरः पुमानस्तीह कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2019795, "chapter_id": 1411, "verse_number": "३-४९-५३", "content_sanskrit": "नास्ति राजा मया कश्चिदल्पभाग्यतरो भुवि।\nभवता दृष्टपूर्वो वा श्रुतपूर्वोपि वा क्वचित्।\nन मत्तो दुःखिततरः पुमानस्तीति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2019796, "chapter_id": 1411, "verse_number": "३-४९-५४", "content_sanskrit": "`एवं ब्रुवन्तं दुःखार्तमुवाच भगवानृषिः।\nशोकं व्यपनुदन्राज्ञो धर्मराजस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2019797, "chapter_id": 1411, "verse_number": "३-४९-५५x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2019798, "chapter_id": 1411, "verse_number": "३-४९-५५", "content_sanskrit": "न विषादे मनः त्वया बुद्धिमतांवर।\nआगमिष्यति बीभत्सुरमित्रांश्च विजेष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2019799, "chapter_id": 1411, "verse_number": "३-४९-५६", "content_sanskrit": "यद्ब्रवीषि महाराज न मत्तो विद्ते क्वचित्।\nअल्पभाग्यतरः कश्चित्पुमानस्तीति पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2019800, "chapter_id": 1411, "verse_number": "३-४९-५७", "content_sanskrit": "अत्र ते वर्णयिष्यामि यदि शुश्रूषसेऽनघ।\nयस्त्वत्तो दुःखिततरो राजाऽऽसीत्पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2019801, "chapter_id": 1411, "verse_number": "३-४९-५८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2019802, "chapter_id": 1411, "verse_number": "३-४९-५८", "content_sanskrit": "अथैनमब्रवीद्राजा ब्रवीतु भगवानिति।\nइमामवस्थां संप्राप्तं श्रोतुमिच्छामि पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2019803, "chapter_id": 1411, "verse_number": "३-४९-५९x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2019804, "chapter_id": 1411, "verse_number": "३-४९-५९", "content_sanskrit": "शृणु राजन्नवहितः सह भ्रातृभिरच्युत।\nयस्त्वत्तो दुःखिततरो राजाऽऽसीत्पृथिवोपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2019805, "chapter_id": 1411, "verse_number": "३-४९-६०", "content_sanskrit": "निषधेषु महीपालो वीरसेन इति श्रुतः।\nतस्य पुत्रोऽभवन्नाम्ना नलो धर्मार्तकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2019806, "chapter_id": 1411, "verse_number": "३-४९-६१", "content_sanskrit": "स निकृत्याजतो राजा पुष्करेणेति नः श्रुतम्।\nवनवासं सुदुःखार्तो भार्यया न्यवसत्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2019807, "chapter_id": 1411, "verse_number": "३-४९-६२", "content_sanskrit": "न तस्य दासा न रथो न भ्राता न च भान्धवाः।\nवने निवसतो राजन्नश्रूयन्त कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2019808, "chapter_id": 1411, "verse_number": "३-४९-६३", "content_sanskrit": "भवान्हि संवृतो वीरैर्भ्रातृभिर्देवसंमितैः।\nब्रह्मकल्पैर्द्विजाग्र्यैश्च तस्मान्नार्हसि शोचितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2019809, "chapter_id": 1411, "verse_number": "३-४९-६४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2019810, "chapter_id": 1411, "verse_number": "३-४९-६४", "content_sanskrit": "विस्तरेणाहमिच्छामि नलस्य सुमहात्मनः।\nचरितं वदतांश्रेष्ठ तन्ममाख्यातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2019811, "chapter_id": 1411, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि एकोनपञ्चाशोऽध्यायः ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]