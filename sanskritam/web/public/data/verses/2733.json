[{"id": 2081759, "chapter_id": 2733, "verse_number": "१२-२३८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081760, "chapter_id": 2733, "verse_number": "१२-२३८-१", "content_sanskrit": "आद्यन्तं सर्वभूतानां ज्ञातुमिच्छामि कौरव।\nध्यानं कर्म च कालं च तथैवायुर्युगेयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081761, "chapter_id": 2733, "verse_number": "१२-२३८-२", "content_sanskrit": "लोकतत्त्वं च कार्त्स्न्येन भूतानामागतिं गतिम्।\nसर्गश्च निधनं चैव कुत एतत्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081762, "chapter_id": 2733, "verse_number": "१२-२३८-३", "content_sanskrit": "`भेदकं भेदतत्वं च तथाऽन्येषां मतं तथा।\nअवस्थात्रितयं चैव यादृशं च पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081763, "chapter_id": 2733, "verse_number": "१२-२३८-४", "content_sanskrit": "यदि तेऽनुग्रहे बुद्धिरस्मास्विह सतां वर।\nएतद्भवन्तं पृच्छामि तद्भवान्प्रब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081764, "chapter_id": 2733, "verse_number": "१२-२३८-५", "content_sanskrit": "पूर्वं हि कथितं श्रुत्वा भृगुभाषितमुत्तमम्॥\nभरद्वाजस्य विप्रर्षेस्ततो मे बुद्धिरुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081765, "chapter_id": 2733, "verse_number": "१२-२३८-६", "content_sanskrit": "जाता परमधर्मिष्ठा दिव्यसंस्थानसंस्थिता।\nततो भूयस्तु पृच्छामि तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081766, "chapter_id": 2733, "verse_number": "१२-२३८-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081767, "chapter_id": 2733, "verse_number": "१२-२३८-७", "content_sanskrit": "अत्र ते वर्तयिष्येऽहमितिहासं पुरातनम्।\nजगौ यद्भगवान्व्यासः पुत्राय परिपृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081768, "chapter_id": 2733, "verse_number": "१२-२३८-८", "content_sanskrit": "अधीत्य वेदानखिलान्साङ्गोपनिषदस्तथा।\nअन्विच्छन्नैष्ठिकं कर्म धर्मनैपुणदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081769, "chapter_id": 2733, "verse_number": "१२-२३८-९", "content_sanskrit": "कृष्णद्वैपायनं व्यासं पुत्रो वैयासकिः शुकः।\nपप्रच्छ संशयमिमं छिन्नधर्मार्थसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081770, "chapter_id": 2733, "verse_number": "१२-२३८-१०x", "content_sanskrit": "श्रीशुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081771, "chapter_id": 2733, "verse_number": "१२-२३८-१०", "content_sanskrit": "भूतग्रामस्य र्क्तारं कालज्ञाने च निश्चितम्।\n`ज्ञानं ब्रह्म च योगं च गवात्मकमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081772, "chapter_id": 2733, "verse_number": "१२-२३८-११", "content_sanskrit": "त्रितये त्वेनमायाति तथा ह्येषोऽपि वा पुनः।\nकेनैव च विभागः स्यात्तुरीयो लक्षणैर्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081773, "chapter_id": 2733, "verse_number": "१२-२३८-१२", "content_sanskrit": "ज्ञानज्ञेयान्तरे कोसौ कोयं भावस्तु भेदवत्।\nयज्ज्ञानं लक्षणं चैव तेषां कर्तारमेव च।\nब्राह्मणस्य च यत्कृत्यं तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081774, "chapter_id": 2733, "verse_number": "१२-२३८-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081775, "chapter_id": 2733, "verse_number": "१२-२३८-१३", "content_sanskrit": "तस्मै प्रोवाच तत्सर्वं पिता पुत्राय पृच्छते।\nअतीतानागते विद्वान्सर्वज्ञः सर्वधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081776, "chapter_id": 2733, "verse_number": "१२-२३८-१४", "content_sanskrit": "`पृच्छतस्तव सत्पुत्र यथावत्कीर्तयाम्यहम्।\nशृणुष्वावहितो भूत्वा यथाऽऽवृतमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081777, "chapter_id": 2733, "verse_number": "१२-२३८-१५", "content_sanskrit": "कार्यादि कारणान्तं यत्कार्यान्तं कारणादिकम्।\nज्ञानं तदुभयं वित्त्वा सत्यं च परमं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081778, "chapter_id": 2733, "verse_number": "१२-२३८-१६", "content_sanskrit": "ब्रह्मेति चाभिविख्यातं तद्वै पश्यन्ति सूरयः।\nब्रह्मतेजोमयं भूतं भूतकारणमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081779, "chapter_id": 2733, "verse_number": "१२-२३८-१७", "content_sanskrit": "आसीदादौ ततस्त्वाहुः प्राधान्यमिति तद्विदः।\nत्रिगुणां तां महामायां वैष्णवीं प्रकृतिं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081780, "chapter_id": 2733, "verse_number": "१२-२३८-१८", "content_sanskrit": "तदीदृशमनाद्यन्तमव्यक्तमजरं ध्रुवम्।\nअप्रतर्क्यमविज्ञेयं ब्रह्माग्रे वैकृतं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081781, "chapter_id": 2733, "verse_number": "१२-२३८-१९", "content_sanskrit": "तद्वै प्रधानमुद्दिष्टं त्रिसूक्ष्मं त्रिगुणात्मकम्।\nसम्यग्योगगुणं स्वस्थं तदिच्छाक्षोभितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081782, "chapter_id": 2733, "verse_number": "१२-२३८-२०", "content_sanskrit": "शक्तित्रयात्मिका तस्य प्रकृतिः कारणात्मिका।\nअस्वतन्त्रा च सततं विदधिष्ठानसंयुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081783, "chapter_id": 2733, "verse_number": "१२-२३८-२१", "content_sanskrit": "स्वभावाख्यं समापन्ना मोहविग्रहधारिणी।\nविविधस्यास्य जीवस्य भोगार्थं समुपागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081784, "chapter_id": 2733, "verse_number": "१२-२३८-२२", "content_sanskrit": "यथा संनिधिमात्रेण गन्धक्षोभाय जायते।\nमनस्तद्वदशेषस्य परात्पर इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081785, "chapter_id": 2733, "verse_number": "१२-२३८-२३", "content_sanskrit": "सृष्ट्वा प्रविश्य तत्तस्मिन्क्षोभयामास विष्ठितः।\nसात्विको राजसश्चैव तामसश्च त्रिधा महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081786, "chapter_id": 2733, "verse_number": "१२-२३८-२४", "content_sanskrit": "प्रधानतत्वादुद्भूतो महत्वाच्च महान्स्मृतः।\nप्रधानतत्वमुद्भूतं महत्तत्वं समावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081787, "chapter_id": 2733, "verse_number": "१२-२३८-२५", "content_sanskrit": "कालात्मनाऽभिभूतं तत्कालोंऽशः परमात्मनः।\nपुरुषश्चाप्रमेयात्मा स एव इति गीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081788, "chapter_id": 2733, "verse_number": "१२-२३८-२६", "content_sanskrit": "त्रिगुणोसौ महाज्ञातः प्रधान इति वै श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081789, "chapter_id": 2733, "verse_number": "१२-२३८-२७", "content_sanskrit": "सात्विको राजसश्चैव तामसश्च त्रिधात्मकः।\nत्रिविधोऽयमहङ्कारो महत्तत्वादजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081790, "chapter_id": 2733, "verse_number": "१२-२३८-२८", "content_sanskrit": "तामसोऽसावहङ्कारो भूतादिरिति संज्ञितः।\nभूतानामादिभूतत्वाद्रक्ताहिस्तामसः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081791, "chapter_id": 2733, "verse_number": "१२-२३८-२९", "content_sanskrit": "भूतादिः स विकुर्वाणः शिष्टं तन्मात्रकं ततः।\nससर्ज शब्दं तन्मात्रमाकाशं शब्दलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081792, "chapter_id": 2733, "verse_number": "१२-२३८-३०", "content_sanskrit": "शब्दलक्षणमाकाशं शब्दतन्मात्रमावृणोत्।\nतेन संपीड्यमानस्तु स्पर्शमात्रं ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081793, "chapter_id": 2733, "verse_number": "१२-२३८-३१", "content_sanskrit": "शब्दमात्रं तदाकाशं स्पर्शमात्रं समावृणोत्।\nससर्ज वायुस्तेनासौ पीड्यमान इति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081794, "chapter_id": 2733, "verse_number": "१२-२३८-३२", "content_sanskrit": "स्पर्शमात्रं तदा वायू रूपमात्रं समावृणोत्।\nतेन संपीड्यमानस्तु ससर्जाग्निमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081795, "chapter_id": 2733, "verse_number": "१२-२३८-३३", "content_sanskrit": "रूपमात्रं ततो वह्निं समुत्सृज्य समावृणोत्।\nतेन संपीड्यमानस्तु रसमात्रं ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081796, "chapter_id": 2733, "verse_number": "१२-२३८-३४", "content_sanskrit": "रुपमात्रगतं तेजो रसमात्रं समावृणोत्।\nतेन संपीड्यमानस्तु ससर्जाम्भ इति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081797, "chapter_id": 2733, "verse_number": "१२-२३८-३५", "content_sanskrit": "रसमात्रात्मकं भूयो रसं तन्मात्रमावृणोत्।\nतेन संपीड्यमानस्तु गन्धं तन्मात्रकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081798, "chapter_id": 2733, "verse_number": "१२-२३८-३६", "content_sanskrit": "ससर्ज गन्धं तन्मात्रमावृणोत्करकं ततः।\nतेन संपीड्यमानस्तु काठिन्यं च ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081799, "chapter_id": 2733, "verse_number": "१२-२३८-३७", "content_sanskrit": "पृथिवी जायते तस्माद्गन्धतन्मात्रजात्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081800, "chapter_id": 2733, "verse_number": "१२-२३८-३८", "content_sanskrit": "अम्मयं सर्वमेवेदमापस्तस्तम्भिरे पुनः।\nभूतानीमानि जातानि पृथिव्यादीनि वै श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081801, "chapter_id": 2733, "verse_number": "१२-२३८-३९", "content_sanskrit": "भूतानां मूर्तिरेवैषामन्नं चैषां मता बुधैः।\nतस्मिंस्तस्मिंस्तु तन्मात्रा तन्मात्रा इति ते स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081802, "chapter_id": 2733, "verse_number": "१२-२३८-४०", "content_sanskrit": "तैजसानीन्द्रियाण्याहुर्देवा वैकारिका दश।\nएकादशं मनश्चात्र देवा वैकारिकाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081803, "chapter_id": 2733, "verse_number": "१२-२३८-४१", "content_sanskrit": "एषामुद्धर्तकः कालो नानाभेदवदास्थितः।\nपरमात्मा च भूतात्मा गुणभेदेन संस्थितः।\nएक एव त्रिधा भिन्नः करोति विविधाः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081804, "chapter_id": 2733, "verse_number": "१२-२३८-४२", "content_sanskrit": "ब्रह्मा सृजति भूतानि पाति नारायणोऽव्ययः।\nरुद्रो हन्ति जगन्मूर्तिः काल एष क्रियाबुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081805, "chapter_id": 2733, "verse_number": "१२-२३८-४३", "content_sanskrit": "कालोपि तन्मयोचिन्त्यस्त्रिगुणात्मा सनातनः।\nअव्यक्तोसावचिन्त्योसौ वर्तते भिन्नलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081806, "chapter_id": 2733, "verse_number": "१२-२३८-४४", "content_sanskrit": "कालात्मना त्विदं भिन्नमभिन्नं श्रूयते हि यत्।\nअनाद्यन्तमजं दिव्यमव्यक्तमजरं ध्रुवम्।\nअप्रतर्क्यमविज्ञेयं ब्रह्माग्रे संप्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081807, "chapter_id": 2733, "verse_number": "१२-२३८-४५", "content_sanskrit": "काष्ठा निमेषा दश पञ्च चैव\nत्रिंशत्तु काष्ठा गणयेत्कलां ताम्।\nत्रिंशत्कलश्चापि भवेन्मुहूर्तो\nभागः कलाया दशमश्च यः स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081808, "chapter_id": 2733, "verse_number": "१२-२३८-४६", "content_sanskrit": "त्रिंशन्मुहूर्तं तु भवेदहश्च\nरात्रिश्च सङ्ख्या मुनिभिः प्रणीता।\nमासः स्मृतो रात्र्यहनी च त्रिंशु\nत्संवत्सरो द्वादशमास उक्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081809, "chapter_id": 2733, "verse_number": "१२-२३८-४७", "content_sanskrit": "संवत्सरं द्वे अयने वदन्ति\nसङ्ख्याविदो दक्षिणमुत्तरं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081810, "chapter_id": 2733, "verse_number": "१२-२३८-४८", "content_sanskrit": "पहोरात्रौ विभजते सूर्यो मानुषलौकिकौ।\nरात्रिः स्वप्नाय संयाति चेष्टायै कर्मणामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2081811, "chapter_id": 2733, "verse_number": "१२-२३८-४९", "content_sanskrit": "पित्र्ये रात्र्यहनी मासः प्रविभागस्तयोः पुनः।\nशुक्लोऽहः कर्मचेष्टायां कृष्णः स्वप्नाय शर्वरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2081812, "chapter_id": 2733, "verse_number": "१२-२३८-५०", "content_sanskrit": "दैवे रात्र्यहनी ह्यब्दः प्रविभागस्तयोः पुनः।\nअहस्तत्रोदगयनं रात्रिः स्याद्दक्षिणायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2081813, "chapter_id": 2733, "verse_number": "१२-२३८-५१", "content_sanskrit": "ये ते रात्र्यहनी पूर्वं कीर्तिते दैवलौकिके।\nतयोः सङ्ख्याय वर्षाग्रं ब्राह्ने वक्ष्याम्यहः क्षपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2081814, "chapter_id": 2733, "verse_number": "१२-२३८-५२", "content_sanskrit": "तेषां संवत्सराग्नाणि प्रवक्ष्याम्यनुपूर्वशः।\nकृते त्रेतायुगे चैव द्वापरे च कलौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2081815, "chapter_id": 2733, "verse_number": "१२-२३८-५३", "content_sanskrit": "चत्वार्याहुः सहस्राणि वर्षाणां तत्कृतं युगम्।\nतस्य तावच्छती संध्या संध्यांशश्च तथाविधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2081816, "chapter_id": 2733, "verse_number": "१२-२३८-५४", "content_sanskrit": "इतरेषु ससंध्येषु संध्यांशेषु ततस्त्रिषु।\nएकापायेन संयान्ति सहस्राणि शतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2081817, "chapter_id": 2733, "verse_number": "१२-२३८-५५", "content_sanskrit": "एतानि शाश्वताँल्लोकान्धारयन्ति सनातनान्।\nएतद्ब्रह्मविदां तात विदितं ब्रह्म शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2081818, "chapter_id": 2733, "verse_number": "१२-२३८-५६", "content_sanskrit": "चतुष्पात्सकलो धर्मः सत्यं चैव कृते युग।\nनाधर्मेणागमः कश्चिद्युगे तस्मिन्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2081819, "chapter_id": 2733, "verse_number": "१२-२३८-५७", "content_sanskrit": "इतरेष्वागमाद्धर्मः पादशस्त्ववरोप्यते।\n`सत्यं शौत्रं तथायुश्च धर्मश्चापैति पादशः।\nचौर्यकानृतमायाभिरधर्मश्चोपचीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2081820, "chapter_id": 2733, "verse_number": "१२-२३८-५८", "content_sanskrit": "अरोगाः सर्वसिद्धार्थाश्चतुर्वर्षशतायुषः।\nकृते त्रेतायुगे त्वेषां पादशो ह्रसते वयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2081821, "chapter_id": 2733, "verse_number": "१२-२३८-५९", "content_sanskrit": "वेदवादाश्चानुयुगं ह्रसन्तीतीह न श्रुतम्।\nआयूंषि चाशिषश्चैव वेदस्यैव च यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2081822, "chapter_id": 2733, "verse_number": "१२-२३८-६०", "content_sanskrit": "अन्ये कृतयुगे धर्मास्त्रेतायां द्वापरेऽपरे।\nअन्ये कलियुगे धर्मा यथाशक्ति कृता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2081823, "chapter_id": 2733, "verse_number": "१२-२३८-६१", "content_sanskrit": "तपः परं कृतयुगे त्रेतायां सत्यमुत्तमम्।\nद्वापरे यज्ञमेवाहुर्दानमेव कलौ युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2081824, "chapter_id": 2733, "verse_number": "१२-२३८-६२", "content_sanskrit": "एतां द्वादशसाहस्त्रीं युगाख्यां कवयो विदुः।\nसहस्रपरिवर्तं तद्ब्राह्मं दिवसमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2081825, "chapter_id": 2733, "verse_number": "१२-२३८-६३", "content_sanskrit": "रात्रिस्तु तावती ब्राह्मी तदादौ विश्वमीश्वरः।\nप्रलयेत्मानमाविश्य सुप्त्वासोऽन्ते विबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2081826, "chapter_id": 2733, "verse_number": "१२-२३८-६४", "content_sanskrit": "सहस्रयुगपर्यन्तमहर्यद्ब्रह्मणे विदुः।\nरात्रिं युगसहस्रां तां तेऽहोरात्रविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2081827, "chapter_id": 2733, "verse_number": "१२-२३८-६५", "content_sanskrit": "प्रतिबुद्धो विकुरुते ब्रह्माक्षय्यं क्षपाक्षये।\nसृजते च महद्भूतं तस्माद्व्यक्तात्मकं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2081828, "chapter_id": 2733, "verse_number": "१२-२३८-६६", "content_sanskrit": "मनः सृष्टिं विकुरुते चोद्यमानं सिसृक्षया।\nआकाशं जायते तस्मात्तस्य शब्दे गुणो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2081829, "chapter_id": 2733, "verse_number": "१२-२३८-६७", "content_sanskrit": "आकाशात्तु विकुर्वाणात्सर्वगन्धवहः शुचिः।\nबलवाञ्जायते वायुस्तस्य स्पर्शो गुणो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2081830, "chapter_id": 2733, "verse_number": "१२-२३८-६८", "content_sanskrit": "वायोरपि विकुर्वाणाज्ज्योतिर्भवति भास्वरम्।\nरोचनं जनयेच्छुद्धं तद्रूपगुणमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2081831, "chapter_id": 2733, "verse_number": "१२-२३८-६९", "content_sanskrit": "ज्योतिषोपि विकुर्वाणाद्भवन्त्यापो रसात्मिकाः।\nअद्भ्यो गन्धवहा भूमिः पूर्वेषां सृष्टिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2081832, "chapter_id": 2733, "verse_number": "१२-२३८-७०", "content_sanskrit": "`ब्रह्मतेजोमयं शुक्लं यस्य सर्वमिदं जगत्।\nएकस्य ब्रह्मभूतस्य द्वयं स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2081833, "chapter_id": 2733, "verse_number": "१२-२३८-७१", "content_sanskrit": "अहर्मुखे विवुद्धं तत्सृजते विद्यया जगत्।\nअग्र एव महद्भूतमाशु व्यक्तात्मकं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2081834, "chapter_id": 2733, "verse_number": "१२-२३८-७२", "content_sanskrit": "अभिभूयेह चातिष्ठद्व्यसृदत्सप्त मानसान्।\nदूरगं बहुधागामि प्रार्थनासंशयात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2081835, "chapter_id": 2733, "verse_number": "१२-२३८-७३", "content_sanskrit": "मनः सृष्टिं न कुरुते चोद्यमानं सिसृक्षया।\nआकाशोजायते तस्मात्तस्य शब्दो गुणो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2081836, "chapter_id": 2733, "verse_number": "१२-२३८-७४", "content_sanskrit": "आकाशात्तु विकुर्वाणात्सर्वगन्धवहः शुचिः।\nबलवाञ्जायते वायुस्तस्य स्पर्शगुणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2081837, "chapter_id": 2733, "verse_number": "१२-२३८-७५", "content_sanskrit": "वायोरपि विकुर्वाणाज्ज्योतिर्भूतं तमोनुदम्।\nरोचिष्णुर्जायते तत्र तद्रूपगुणमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2081838, "chapter_id": 2733, "verse_number": "१२-२३८-७६", "content_sanskrit": "ज्योतिषोपि विकुर्वाणाद्भवन्त्यापो रसात्मिकाः।\nअद्भ्यो गन्धवहा भूमिः पूर्वेषां सृष्टिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2081839, "chapter_id": 2733, "verse_number": "१२-२३८-७७", "content_sanskrit": "गुणाः पूर्वस्य पूर्वस्य प्राप्नुवन्त्युत्तरोत्तरम्।\nतेषां यावद्गुणं यद्यत्तत्तावद्गुणकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2081840, "chapter_id": 2733, "verse_number": "१२-२३८-७८", "content_sanskrit": "उपलभ्याप्सु चेद्गन्धं केचिद्ब्रयुरनैपुणात्।\nपृथिव्यामेव तं विद्यादपां वायोश्च संश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2081841, "chapter_id": 2733, "verse_number": "१२-२३८-७९", "content_sanskrit": "एते सप्तविधात्मानो नानावीर्याः पृथक्पृथक्।\nनाशक्नुवन्प्रजाः स्रष्टुभसमागम्य कृत्स्नशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2081842, "chapter_id": 2733, "verse_number": "१२-२३८-८०", "content_sanskrit": "ते समेत्य महात्मानो ह्यन्योन्यमभिसंश्रिताः।\nशरीराश्रयणं प्राप्तास्ततः पुरुष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2081843, "chapter_id": 2733, "verse_number": "१२-२३८-८१", "content_sanskrit": "श्रयणाच्छरीरी भवति मूर्तिमान्षोडशात्मकः।\nतमाविशन्ति भूतानि महान्ति सह कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2081844, "chapter_id": 2733, "verse_number": "१२-२३८-८२", "content_sanskrit": "सर्वभूतान्युपादाय तपसश्चरणाय हि।\nआदिकर्ता महाभूतं तमेवाहुः प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2081845, "chapter_id": 2733, "verse_number": "१२-२३८-८३", "content_sanskrit": "स वै सृजति भूतानि स एव पुरुषः परः।\nअजो जनयते ब्रह्मा देवर्षिपितृमानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2081846, "chapter_id": 2733, "verse_number": "१२-२३८-८४", "content_sanskrit": "लोकान्नदीः समुद्रांश्च दिशः शैलान्वनस्पतीन्।\nनरकिन्नररक्षांसि वयः पशुमृगोरगान्।\nअव्ययं च व्ययं चैव द्वयं स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2081847, "chapter_id": 2733, "verse_number": "१२-२३८-८५", "content_sanskrit": "तेषां ये यानि कर्माणि प्राक्सृष्ट्यां प्रतिपेदिरे।\nतान्येव प्रतिपाद्यन्ते सृज्यमानाः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2081848, "chapter_id": 2733, "verse_number": "१२-२३८-८६", "content_sanskrit": "हिंस्राहिंस्रे मृदुक्रूरे धर्माधर्मावृत्तानृते।\nतद्भाविताः प्रपद्यन्ते तस्मात्तत्तस्य रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2081849, "chapter_id": 2733, "verse_number": "१२-२३८-८७", "content_sanskrit": "महाभूतेषु नानात्वमिन्द्रियार्थेषु मूर्तिषु।\nविनियोगं च भूतानां धातैव विदधात्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2081850, "chapter_id": 2733, "verse_number": "१२-२३८-८८", "content_sanskrit": "केचित्पुरुषकारं तु प्राहुः कर्मविदो जनाः।\nदैवमित्यपरे विप्राः स्वभावं भूतचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2081851, "chapter_id": 2733, "verse_number": "१२-२३८-८९", "content_sanskrit": "पौरुषं कर्म दैवं च फलवृत्तिस्वभावतः।\nत्रय एतेऽपृथग्भूता अविवेकः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2081852, "chapter_id": 2733, "verse_number": "१२-२३८-९०", "content_sanskrit": "एवमेतच्च दैवं च द्भूतं सृजते जगत्।\nकर्मस्था विषयं ब्रूयुः सत्वस्थाः समदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2081853, "chapter_id": 2733, "verse_number": "१२-२३८-९१", "content_sanskrit": "ततो निःश्रेयसं जन्तोस्तस्य मूलं शमो दमः।\nतेन सर्वानवाप्नोति यान्कामान्मनसेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2081854, "chapter_id": 2733, "verse_number": "१२-२३८-९२", "content_sanskrit": "तपसा तदवाप्नोति यद्भूतं सृजते जगत्।\nस तद्भूतश्च सर्वेषां भूतानां भवति प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2081855, "chapter_id": 2733, "verse_number": "१२-२३८-९३", "content_sanskrit": "ऋषयस्तपसा वेदानध्यैषन्त दिवानिशम्।\nअनादिनिधना नित्या वागुत्सृष्टा स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2081856, "chapter_id": 2733, "verse_number": "१२-२३८-९४", "content_sanskrit": "ऋषीणां नामधेयानि याश्च वेदेषु सृष्टयः।\nनाम रूपं च भूतानां कर्मणां च प्रवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2081857, "chapter_id": 2733, "verse_number": "१२-२३८-९५", "content_sanskrit": "वेदशब्देभ्य एवादौ निर्मिमीते स ईश्वरः।\nनामधेयानि चर्षीणां याश्च वेदेषु सृष्टयः।\nशर्वर्यन्तेषु जातानामन्येभ्यो विदधात्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2081858, "chapter_id": 2733, "verse_number": "१२-२३८-९६", "content_sanskrit": "नामभेदतपः कर्मयज्ञाख्या लोकसिद्धये।\nआत्मसिद्धिस्तु वेदेषु प्रोच्यते दशभिः क्रमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2081859, "chapter_id": 2733, "verse_number": "१२-२३८-९७", "content_sanskrit": "यदुक्तं वेदवादेषु गहनं वेददृष्टिभिः।\nतदन्तेषु यथायुक्तं क्रमयोगेन लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2081860, "chapter_id": 2733, "verse_number": "१२-२३८-९८", "content_sanskrit": "कर्मजोऽयं पृथग्भावो द्वन्द्वयुक्तो हि देहिनः।\nआत्मसिद्धिस्तु विज्ञानाज्जहाति प्रायशो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2081861, "chapter_id": 2733, "verse_number": "१२-२३८-९९", "content_sanskrit": "द्वे ब्रह्मणी वेदितव्ये शब्दब्रह्म परं च यत्।\nशब्दब्रह्मणि निष्णातः परं ब्रह्माधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2081862, "chapter_id": 2733, "verse_number": "१२-२३८-१००", "content_sanskrit": "आलम्भयज्ञाः क्षत्राश्च हविर्यज्ञा विशः स्मृताः।\nपरिचारयज्ञाः शूद्रास्तु तपोयज्ञा द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2081863, "chapter_id": 2733, "verse_number": "१२-२३८-१०१", "content_sanskrit": "त्रेतायुगे विधिस्त्वेष यज्ञानां न कृते युगे।\nद्वापरे विप्लवं यान्ति यज्ञाः कलियुगे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2081864, "chapter_id": 2733, "verse_number": "१२-२३८-१०२", "content_sanskrit": "अपृथग्धर्मिणो मर्त्या ऋक्सामानि यजूंषि च।\nकाम्या इष्टीः पृथक्दृष्ट्वा तपोभिस्तप एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2081865, "chapter_id": 2733, "verse_number": "१२-२३८-१०३", "content_sanskrit": "त्रेतायां तु समस्ता ये प्रादुरासन्महाबलाः।\nसंयन्तारः स्थावराणां जङ्गमानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2081866, "chapter_id": 2733, "verse_number": "१२-२३८-१०४", "content_sanskrit": "त्रेतायां संहता वेदा यज्ञा वर्णास्तथैव च।\nसंरोधादायुषस्त्वेते व्यस्यन्ते द्वापरे युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2081867, "chapter_id": 2733, "verse_number": "१२-२३८-१०५", "content_sanskrit": "दृश्यन्ते न च दृश्यन्ते वेदाः कलियुगेऽखिलाः।\nउत्सीदन्ते सयज्ञाश्च केवला धर्मपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2081868, "chapter_id": 2733, "verse_number": "१२-२३८-१०६", "content_sanskrit": "कृते युगे यस्तु धर्मो ब्राह्मणेषु प्रदृश्यते।\nआत्मवत्सु तपोवत्सु श्रुतवत्सु प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2081869, "chapter_id": 2733, "verse_number": "१२-२३८-१०७", "content_sanskrit": "स धर्मः प्रैति संयोगं यथाधर्मं युगेयुगे।\nविक्रियन्ते स्वधर्मस्था वेदवादा यथागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2081870, "chapter_id": 2733, "verse_number": "१२-२३८-१०८", "content_sanskrit": "यथा विश्वानि भूतानि वृष्ट्या भूयांसि प्रावृषि।\nसृज्यन्ते जङ्गमस्थानि तथा धर्मा युगेयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2081871, "chapter_id": 2733, "verse_number": "१२-२३८-१०९", "content_sanskrit": "यथर्तुष्वृतुलिङ्गानि नानारूपाणि पर्यये।\nदृश्यन्ते तानि तान्येव तथा ब्रह्महरादिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2081872, "chapter_id": 2733, "verse_number": "१२-२३८-११०", "content_sanskrit": "विहितं कालनानात्वमनादिनिधनं तथा।\nकीर्तितं यत्पुरस्तात्ते तत्सूते चाति च प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2081873, "chapter_id": 2733, "verse_number": "१२-२३८-१११", "content_sanskrit": "ददाति भवनस्थानं भूतानां संयमो यमः।\nस्वभावेनैव वर्तन्ते द्वन्द्वयुक्तानि भूरिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2081874, "chapter_id": 2733, "verse_number": "१२-२३८-११२", "content_sanskrit": "सर्वकालक्रिया वेदाः कर्ता कार्यं क्रियाफलम्।\nप्रोक्तं ते पुत्र सर्वं वै यन्मां त्वं परिपृच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2081875, "chapter_id": 2733, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टत्रिंशदधिकद्विशततमोऽध्यायः॥ २३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]