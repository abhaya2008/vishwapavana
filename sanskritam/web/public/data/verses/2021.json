[{"id": 2045965, "chapter_id": 2021, "verse_number": "६-७०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045966, "chapter_id": 2021, "verse_number": "६-७०-१", "content_sanskrit": "अकरोत्तुमुलं युद्धं भीष्मः शान्तनवस्तदा।\nभीमसेनभयादिच्छन्पुत्रांस्तारयितुं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045967, "chapter_id": 2021, "verse_number": "६-७०-२", "content_sanskrit": "पूर्वाह्णे तन्महारौद्रं राज्ञां युद्धमवर्तत ।\nकुरूणां पाण्डवानां च मुख्यशूरविनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045968, "chapter_id": 2021, "verse_number": "६-७०-३", "content_sanskrit": "तस्मिन्नाकुलसंग्रामे वर्तमाने महाभये ।\nअभवत्तुमुलः शब्दः संस्पृशन्गगनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045969, "chapter_id": 2021, "verse_number": "६-७०-४", "content_sanskrit": "नदद्भिश्च महानागैर्हेषमाणैश्च वाजिभिः ।\nभेरीशङ्खनिनादैश्च तुमुलं समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045970, "chapter_id": 2021, "verse_number": "६-७०-५", "content_sanskrit": "युयुत्सवस्ते विक्रान्ता विजयाय महाबलाःक ।\nअन्योन्यमभिगर्जन्तो गोष्ठिष्विव महर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045971, "chapter_id": 2021, "verse_number": "६-७०-६", "content_sanskrit": "शिरासं पात्यमानानां समरे निशितैः शरैः।\nअश्यवृष्टिरिवाकाशे बभूव भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045972, "chapter_id": 2021, "verse_number": "६-७०-७", "content_sanskrit": "कुण्डलोष्णीषधारीणि जातरूपोज्ज्वलानि च।\nपतितानि स्म दृश्यन्ते शिरांसि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045973, "chapter_id": 2021, "verse_number": "६-७०-८", "content_sanskrit": "विशिखोन्मथितैर्गात्रैर्बाहुभिश्च सकार्मुकैः ।\nसहस्ताभरणैश्चान्यैरभवच्छादिता मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045974, "chapter_id": 2021, "verse_number": "६-७०-९", "content_sanskrit": "कवचोपहितैर्गात्रैर्हस्तैश्च समलङ्कृतैः ।\nमुखैश्च चन्द्रसंकाशै रक्तान्तनयनैः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045975, "chapter_id": 2021, "verse_number": "६-७०-१०", "content_sanskrit": "गजवाजिमनुष्याणां सर्वगात्रैश्च भूपते ।\nआसीत्सर्वा समास्तीर्णा मुहूर्तेन वसुंधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045976, "chapter_id": 2021, "verse_number": "६-७०-११", "content_sanskrit": "रजोमेघैश्च तुमुलैः शस्त्रविद्युत्प्रकाशिभिः ।\nआयुधानां च निर्घोषः स्तनयित्नुसमोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045977, "chapter_id": 2021, "verse_number": "६-७०-१२", "content_sanskrit": "स संप्रहारस्तुमुलःक कटुकः शोणितोदकः।\nप्रावर्तत कुरूणां च पाण्डवानां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045978, "chapter_id": 2021, "verse_number": "६-७०-१३", "content_sanskrit": "तस्मिन्महाभये घोरे तुमुले रोमहर्षणे।\nववृषुः शरवर्षाणि क्षत्रिया युद्धदुर्मदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045979, "chapter_id": 2021, "verse_number": "६-७०-१४", "content_sanskrit": "आक्रोशन्कुञ्जरास्तत्र शरवर्षप्रतापिताः ।\nतावकानां परेषां च संयुगे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045980, "chapter_id": 2021, "verse_number": "६-७०-१५", "content_sanskrit": "संरब्धानां च वीराणां धीराणाममितौजसाम् ।\nधनुर्ज्यातलशब्देन न प्राज्ञायत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045981, "chapter_id": 2021, "verse_number": "६-७०-१६", "content_sanskrit": "उत्थितेषु कबन्धेषु सर्वतः शोमितोदके।\nसमरे पर्यधावन्त नृपा रिपुवधोद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045982, "chapter_id": 2021, "verse_number": "६-७०-१७", "content_sanskrit": "शरशक्तिगदाभिस्ते खङ्गैश्चामिततेजसः ।\nनिजघ्नुः समरेऽन्योन्यं शूराः परिघबाहवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045983, "chapter_id": 2021, "verse_number": "६-७०-१८", "content_sanskrit": "बभ्रमुः कुञ्जराश्चात्र शरैर्विद्धा निरङ्कुशाः ।\nअश्वाश्च पर्यधावन्त हतारोहा दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045984, "chapter_id": 2021, "verse_number": "६-७०-१९", "content_sanskrit": "उत्पत्य निपतन्त्यन्ये शरघातप्रपीडिताः।\nतावकानां परेषां च योधा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045985, "chapter_id": 2021, "verse_number": "६-७०-२०", "content_sanskrit": "वाहानामुत्तमाङ्गानां कार्मुकाणां च भारत।\nगदानां परिघाणां च हस्तानां चोरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045986, "chapter_id": 2021, "verse_number": "६-७०-२१", "content_sanskrit": "पादानां भूषणानां च केयूराणां च सङ्घशः।\nराशयस्तत्र दृश्यन्ते भीष्मभीमसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045987, "chapter_id": 2021, "verse_number": "६-७०-२२", "content_sanskrit": "अश्वानां कुञ्जराणां च रथानां चानिवर्तिनाम् ।\nसङ्घाताः स्म प्रदृश्यन्ते तत्रतत्र विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045988, "chapter_id": 2021, "verse_number": "६-७०-२३", "content_sanskrit": "गदाभिरसिभिः प्रासैर्बाणैश्च नतपर्वभिः ।\nजघ्नुः परस्पर तत्र क्षत्रियाः काल आगते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045989, "chapter_id": 2021, "verse_number": "६-७०-२४", "content_sanskrit": "अपरे बाहुभिर्वीरा नियुद्धकुशला युधि।\nबहुधा समसञ्जन्त आयसैः परिघैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045990, "chapter_id": 2021, "verse_number": "६-७०-२५", "content_sanskrit": "मुष्टिभिर्जानुभिश्चैव तलैश्चैव विशांपते ।\nअन्योन्यं जघ्रिरे वीरास्तावकाः पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045991, "chapter_id": 2021, "verse_number": "६-७०-२६", "content_sanskrit": "पतितैः पात्यमानैश्च विचेष्टद्भिश्च भूतले।\nघोरमायोधनं जज्ञे तत्रतत्र जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045992, "chapter_id": 2021, "verse_number": "६-७०-२७", "content_sanskrit": "विरथा रथिनश्चात्र निस्त्रिंशवरधारिणःक ।\nअन्योन्यमभिधावन्तः परस्परवधैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045993, "chapter_id": 2021, "verse_number": "६-७०-२८", "content_sanskrit": "ततो दुर्योधनो राजा कलिङ्गैर्बहुभिर्वृतः।\nपुरस्कृत्य रणे भीष्मं पाण्डवानभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045994, "chapter_id": 2021, "verse_number": "६-७०-२९", "content_sanskrit": "तथैव पाण्डवाः सर्वे परिवार्य वृकोदरम्।\nभीष्ममभ्यद्रवन्क्रुद्धास्ततो युद्धमवर्तत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045995, "chapter_id": 2021, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि पञ्चमदिवसयुद्धे सप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]