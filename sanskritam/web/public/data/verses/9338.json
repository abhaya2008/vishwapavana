[{"id": 5000338000, "chapter_id": 9338, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षट्षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000338001, "chapter_id": 9338, "verse_number": "४-६६-१", "content_sanskrit": "अनेकशतसाहस्रीं विषण्णां हरिवाहिनीम्।\nजाम्बवान् समुदीक्ष्यैवं हनूमन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000338002, "chapter_id": 9338, "verse_number": "४-६६-२", "content_sanskrit": "वीर वानरलोकस्य सर्वशास्त्रविदां वर।\nतूष्णीमेकान्तमाश्रित्य हनूमन् किं न जल्पसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000338003, "chapter_id": 9338, "verse_number": "४-६६-३", "content_sanskrit": "हनूमन् हरिराजस्य सुग्रीवस्य समो ह्यसि।\nरामलक्ष्मणयोश्चापि तेजसा च बलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000338004, "chapter_id": 9338, "verse_number": "४-६६-४", "content_sanskrit": "अरिष्टनेमिनः पुत्रो वैनतेयो महाबलः।\nगरुत्मानिव विख्यात उत्तमः सर्वपक्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000338005, "chapter_id": 9338, "verse_number": "४-६६-५", "content_sanskrit": "बहुशो हि मया दृष्टः सागरे स महाबलः।\nभुजङ्गानुद्धरन् पक्षी महाबाहुर्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000338006, "chapter_id": 9338, "verse_number": "४-६६-६", "content_sanskrit": "पक्षयोर्यद् बलं तस्य भुजवीर्यबलं तव।\nविक्रमश्चापि वेगश्च न ते तेनापहीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000338007, "chapter_id": 9338, "verse_number": "४-६६-७", "content_sanskrit": "बलं बुद्धिश्च तेजश्च सत्त्वं च हरिपुङ्गव।\nविशिष्टं सर्वभूतेषु किमात्मानं न सज्जसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000338008, "chapter_id": 9338, "verse_number": "४-६६-८", "content_sanskrit": "अप्सराऽप्सरसां श्रेष्ठा विख्याता पुञ्जिकस्थला।\nअञ्जनेति परिख्याता पत्नी केसरिणो हरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000338009, "chapter_id": 9338, "verse_number": "४-६६-९", "content_sanskrit": "विख्याता त्रिषु लोकेषु रूपेणाप्रतिमा भुवि।\nअभिशापादभूत् तात कपित्वे कामरूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000338010, "chapter_id": 9338, "verse_number": "४-६६-१०", "content_sanskrit": "दुहिता वानरेन्द्रस्य कुञ्जरस्य महात्मनः।\nमानुषं विग्रहं कृत्वा रूपयौवनशालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000338011, "chapter_id": 9338, "verse_number": "४-६६-११", "content_sanskrit": "विचित्रमाल्याभरणा कदाचित् क्षौमधारिणी।\nअचरत् पर्वतस्याग्रे प्रावृडम्बुदसंनिभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000338012, "chapter_id": 9338, "verse_number": "४-६६-१२", "content_sanskrit": "तस्या वस्त्रं विशालाक्ष्याः पीतं रक्तदशं शुभम्।\nस्थितायाः पर्वतस्याग्रे मारुतोऽपाहरच्छनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000338013, "chapter_id": 9338, "verse_number": "४-६६-१३", "content_sanskrit": "स ददर्श ततस्तस्या वृत्तावूरू सुसंहतौ।\nस्तनौ च पीनौ सहितौ सुजातं चारु चाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000338014, "chapter_id": 9338, "verse_number": "४-६६-१४", "content_sanskrit": "तां बलादायतश्रोणीं तनुमध्यां यशस्विनीम्।\nदृष्ट्वैव शुभसर्वाङ्गीं पवनः काममोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000338015, "chapter_id": 9338, "verse_number": "४-६६-१५", "content_sanskrit": "स तां भुजाभ्यां दीर्घाभ्यां पर्यष्वजत मारुतः।\nमन्मथाविष्टसर्वाङ्गो गतात्मा तामनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000338016, "chapter_id": 9338, "verse_number": "४-६६-१६", "content_sanskrit": "सा तु तत्रैव सम्भ्रान्ता सुव्रता वाक्यमब्रवीत्।\nएकपत्नीव्रतमिदं को नाशयितुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000338017, "chapter_id": 9338, "verse_number": "४-६६-१७", "content_sanskrit": "अञ्जनाया वचः श्रुत्वा मारुतः प्रत्यभाषत।\nन त्वां हिंसामि सुश्रोणि मा भूत् ते मनसो भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000338018, "chapter_id": 9338, "verse_number": "४-६६-१८", "content_sanskrit": "मनसास्मि गतो यत् त्वां परिष्वज्य यशस्विनि।\nवीर्यवान् बुद्धिसम्पन्नस्तव पुत्रो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000338019, "chapter_id": 9338, "verse_number": "४-६६-१९", "content_sanskrit": "महासत्त्वो महातेजा महाबलपराक्रमः।\nलङ्घने प्लवने चैव भविष्यति मया समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000338020, "chapter_id": 9338, "verse_number": "४-६६-२०", "content_sanskrit": "एवमुक्ता ततस्तुष्टा जननी ते महाकपे।\nगुहायां त्वां महाबाहो प्रजज्ञे प्लवगर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000338021, "chapter_id": 9338, "verse_number": "४-६६-२१", "content_sanskrit": "अभ्युत्थितं ततः सूर्यं बालो दृष्ट्वा महावने।\nफलं चेति जिघृक्षुस्त्वमुत्प्लुत्याभ्युत्पतो दिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000338022, "chapter_id": 9338, "verse_number": "४-६६-२२", "content_sanskrit": "शतानि त्रीणि गत्वाथ योजनानां महाकपे।\nतेजसा तस्य निर्धूतो न विषादं गतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000338023, "chapter_id": 9338, "verse_number": "४-६६-२३", "content_sanskrit": "त्वामप्युपगतं तूर्णमन्तरिक्षं महाकपे।\nक्षिप्तमिन्द्रेण ते वज्रं कोपाविष्टेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000338024, "chapter_id": 9338, "verse_number": "४-६६-२४", "content_sanskrit": "तदा शैलाग्रशिखरे वामो हनुरभज्यत।\nततो हि नामधेयं ते हनुमानिति कीर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000338025, "chapter_id": 9338, "verse_number": "४-६६-२५", "content_sanskrit": "ततस्त्वां निहतं दृष्ट्वा वायुर्गन्धवहः स्वयम्।\nत्रैलोक्यं भृशसंक्रुद्धो न ववौ वै प्रभञ्जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000338026, "chapter_id": 9338, "verse_number": "४-६६-२६", "content_sanskrit": "सम्भ्रान्ताश्च सुराः सर्वे त्रैलोक्ये क्षुभिते सति।\nप्रसादयन्ति संक्रुद्धं मारुतं भुवनेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000338027, "chapter_id": 9338, "verse_number": "४-६६-२७", "content_sanskrit": "प्रसादिते च पवने ब्रह्मा तुभ्यं वरं ददौ।\nअशस्त्रवध्यतां तात समरे सत्यविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000338028, "chapter_id": 9338, "verse_number": "४-६६-२८", "content_sanskrit": "वज्रस्य च निपातेन विरुजं त्वां समीक्ष्य च।\nसहस्रनेत्रः प्रीतात्मा ददौ ते वरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000338029, "chapter_id": 9338, "verse_number": "४-६६-२९", "content_sanskrit": "स्वच्छन्दतश्च मरणं तव स्यादिति वै प्रभो।\nस त्वं केसरिणः पुत्रः क्षेत्रजो भीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000338030, "chapter_id": 9338, "verse_number": "४-६६-३०", "content_sanskrit": "मारुतस्यौरसः पुत्रस्तेजसा चापि तत्समः।\nत्वं हि वायुसुतो वत्स प्लवने चापि तत्समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000338031, "chapter_id": 9338, "verse_number": "४-६६-३१", "content_sanskrit": "वयमद्य गतप्राणा भवानस्मासु साम्प्रतम्।\nदाक्ष्यविक्रमसम्पन्नः कपिराज इवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000338032, "chapter_id": 9338, "verse_number": "४-६६-३२", "content_sanskrit": "त्रिविक्रमे मया तात सशैलवनकानना।\nत्रिःसप्तकृत्वः पृथिवी परिक्रान्ता प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000338033, "chapter_id": 9338, "verse_number": "४-६६-३३", "content_sanskrit": "तथा चौषधयोऽस्माभिः संचिता देवशासनात्।\nनिर्मथ्यममृतं याभिस्तदानीं नो महद‍्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000338034, "chapter_id": 9338, "verse_number": "४-६६-३४", "content_sanskrit": "स इदानीमहं वृद्धः परिहीनपराक्रमः।\nसाम्प्रतं कालमस्माकं भवान् सर्वगुणान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000338035, "chapter_id": 9338, "verse_number": "४-६६-३५", "content_sanskrit": "तद् विजृम्भस्व विक्रान्त प्लवतामुत्तमो ह्यसि।\nत्वद्वीर्यं द्रष्टुकामा हि सर्वा वानरवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000338036, "chapter_id": 9338, "verse_number": "४-६६-३६", "content_sanskrit": "उत्तिष्ठ हरिशार्दूल लङ्घयस्व महार्णवम्।\nपरा हि सर्वभूतानां हनुमन् या गतिस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000338037, "chapter_id": 9338, "verse_number": "४-६६-३७", "content_sanskrit": "विषण्णा हरयः सर्वे हनुमन् किमुपेक्षसे।\nविक्रमस्व महावेग विष्णुस्त्रीन् विक्रमानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000338038, "chapter_id": 9338, "verse_number": "४-६६-३८", "content_sanskrit": "ततः कपीनामृषभेण चोदितः\nप्रतीतवेगः पवनात्मजः कपिः।\nप्रहर्षयंस्तां हरिवीरवाहिनीं\nचकार रूपं महदात्मनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000338039, "chapter_id": 9338, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षट्षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]