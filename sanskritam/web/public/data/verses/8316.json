[{"id": 900004023, "chapter_id": 8316, "verse_number": "12.1", "content_sanskrit": "अस्तिप्रास्तीति कंसस्य महिष्यौ भरतर्षभ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004024, "chapter_id": 8316, "verse_number": "12.2", "content_sanskrit": "तृतीये मासि भूयश्च राजा बार्हद्रथो बली", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004025, "chapter_id": 8316, "verse_number": "12.3", "content_sanskrit": "मागधस्तु रणश्लाघी माधवेन पराजितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004026, "chapter_id": 8316, "verse_number": "12.4", "content_sanskrit": "बाणसेनां गतां दृष्ट्वा शस्त्रौघेण भृशार्दिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004027, "chapter_id": 8316, "verse_number": "12.5", "content_sanskrit": "गोमन्तं पर्वतश्रेष्ठं तुङ्गद्रुमलतान्वितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004028, "chapter_id": 8316, "verse_number": "12.6", "content_sanskrit": "तं विलोक्य विनिष्क्रान्तमुज्जिहानमिवोडुपम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004029, "chapter_id": 8316, "verse_number": "12.7", "content_sanskrit": "इत्थं सोऽनुगृहीतोऽङ्ग कृष्णेनेक्ष्वाकुनन्दनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004030, "chapter_id": 8316, "verse_number": "12.8", "content_sanskrit": "कदाचिद् देवकीपुत्रो रामशैनेयसंयुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004031, "chapter_id": 8316, "verse_number": "12.9", "content_sanskrit": "आनर्ताधिपतिः श्रीमान् रेवतो रेवतीं सुताम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004032, "chapter_id": 8316, "verse_number": "12.10", "content_sanskrit": "वेदर्भ्याः स तु सन्देशं निशम्य यदुनन्द", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004033, "chapter_id": 8316, "verse_number": "12.11", "content_sanskrit": "तं मानिनः स्वाभिभवं यशःक्षयं परे जरासन्धवशा न सेहिरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004034, "chapter_id": 8316, "verse_number": "12.12", "content_sanskrit": "सत्राजित्तनयां तन्वीं कृष्णाय कृतकिल्बिषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004035, "chapter_id": 8316, "verse_number": "12.13", "content_sanskrit": "विज्ञातार्थोऽपि गोविन्दो दग्धानाकर्ण्य पाण्डवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004036, "chapter_id": 8316, "verse_number": "12.14", "content_sanskrit": "एकदा पाण्डवान् द्रष्टुं प्रतीतान् पुरुषोत्तमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004037, "chapter_id": 8316, "verse_number": "12.15", "content_sanskrit": "यथा हतो भगवता भौमो नीता यथा स्त्रियः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004038, "chapter_id": 8316, "verse_number": "12.16", "content_sanskrit": "यानि योधैः प्रयुक्तानि शस्त्रास्त्राणि कुरूद्वह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004039, "chapter_id": 8316, "verse_number": "12.17", "content_sanskrit": "हत्वा नरकमत्युग्रं दानवं दानवान्तकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004040, "chapter_id": 8316, "verse_number": "12.18", "content_sanskrit": "सुरानभिद्रुतान् दृष्ट्वा सत्यामाह जगत्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004041, "chapter_id": 8316, "verse_number": "12.19", "content_sanskrit": "ततः स्वयं देवपतिस्तुङ्गमारुह्य वारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004042, "chapter_id": 8316, "verse_number": "12.20", "content_sanskrit": "आराध्य देवदेवेशं शङ्करं लोकशङ्करम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900004043, "chapter_id": 8316, "verse_number": "12.21", "content_sanskrit": "पौण्ड्रको नाम राजा वै तस्मिन् काले कुरूद्वह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900004044, "chapter_id": 8316, "verse_number": "12.22", "content_sanskrit": "अथैकदा द्वारवत्यां वसतो रामकृष्णयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900004045, "chapter_id": 8316, "verse_number": "12.23", "content_sanskrit": "तथाऽनुगृह्य भगवान् गोपीनां स गुरुर्गतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900004046, "chapter_id": 8316, "verse_number": "12.24", "content_sanskrit": "श्रुत्वा पृथा सुबलपुत्र्यथ याज्ञसेनी माधव्य इत्थमनु याः परमप्रतीताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900004047, "chapter_id": 8316, "verse_number": "12.25", "content_sanskrit": "तन्मुखैर्वचनं श्रुत्वा वसुदेवो महामनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900004048, "chapter_id": 8316, "verse_number": "12.26", "content_sanskrit": "अथैकदात्मजौ प्राप्तौ कृतपादाभिवन्दनौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]