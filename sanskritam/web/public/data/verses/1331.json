[{"id": 2015732, "chapter_id": 1331, "verse_number": "२-७२-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततः स कुरुराजस्य सर्वकर्मसमृद्धिमान्।\nयज्ञः प्रीतिकरो राजन्संबभौ विपुलोत्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015733, "chapter_id": 1331, "verse_number": "२-७२-२", "content_sanskrit": "शान्तविघ्नः सुखारम्भः प्रभूतधनधान्यवान्।\nअन्नवान्बहुभक्ष्यश्च केशवेन सुरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015734, "chapter_id": 1331, "verse_number": "२-७२-३", "content_sanskrit": "समापयामास च तं राजसूयं महाक्रतुम्।\nकोटिसहस्रं प्रददौ ब्राह्मणानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015735, "chapter_id": 1331, "verse_number": "२-७२-४", "content_sanskrit": "न करिष्यति तं लोके कश्चिदन्यो महीपतिः।\nयाजकाः सर्वकामैश्च सततं ततृपुर्धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015736, "chapter_id": 1331, "verse_number": "२-७२-५", "content_sanskrit": "ततश्चावभृथस्नातः स राजा पाण्डुनन्दनः।\nव्यासं धौम्यं वसिष्ठं च नारदं च महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015737, "chapter_id": 1331, "verse_number": "२-७२-६", "content_sanskrit": "सुमन्तु जैमिनिं पैलं वैशम्पायनमेव च।\nयाज्ञवल्क्यं च कपिलं कपालं कौशिकं तथा।\nसर्वांश्च ऋत्विक्प्रवरान्पूजयामास सत्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015738, "chapter_id": 1331, "verse_number": "२-७२-७x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015739, "chapter_id": 1331, "verse_number": "२-७२-७", "content_sanskrit": "युष्मत्प्रसादात्प्राप्तोऽयं राजसूयो महाक्रतुः।\nजनार्दनप्रसादाद्धि सम्पूर्णो मे मनोरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015740, "chapter_id": 1331, "verse_number": "२-७२-८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015741, "chapter_id": 1331, "verse_number": "२-७२-८", "content_sanskrit": "अथ यज्ञं समाप्यान्ते पूजयामास माधवम्।\nबलदेव च देवेशं भीष्माद्यांश्च कुरूद्वहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015742, "chapter_id": 1331, "verse_number": "२-७२-९", "content_sanskrit": "ततस्त्ववभृथस्नातं धर्मात्मानं युधिष्ठिरम्।\nसमस्तं पार्थिवं क्षत्रमुपगम्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015743, "chapter_id": 1331, "verse_number": "२-७२-१०", "content_sanskrit": "दिष्ट्या वर्धसि धर्मज्ञ साम्राज्यं प्राप्तवानसि।\nआजमीढाजमीढानां यशः संवर्धितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015744, "chapter_id": 1331, "verse_number": "२-७२-११", "content_sanskrit": "कर्मणैतेन राजेन्द्र धर्मश्च सुमहान्कृतः।\nआपृच्छामो नरव्याघ्र सर्वकामैः सूपूजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015745, "chapter_id": 1331, "verse_number": "२-७२-१२", "content_sanskrit": "स्वराष्ट्राणि गमिष्यामस्तदनुज्ञातुमर्हसि।\nश्रुत्वा तु वचनं राज्ञां धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015746, "chapter_id": 1331, "verse_number": "२-७२-१३", "content_sanskrit": "यथार्हं पूज्य नृपतीन्भ्रातॄन्सर्वानुवाच ह।\nराजानः सर्व एवैते प्रीत्याऽस्मान्प्तमुपागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015747, "chapter_id": 1331, "verse_number": "२-७२-१४", "content_sanskrit": "प्रस्थिताः स्वानि राष्ट्राणि मामापृच्छय परन्तपाः।\nअनुव्रजत भद्रं वो विषयान्तं नृपोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015748, "chapter_id": 1331, "verse_number": "२-७२-१५", "content_sanskrit": "भ्रातुर्वचनमाज्ञाय पाण्डवा धर्मचारिणः।\nयथार्हं नृपतीन्सर्वानेकैकं समनुव्रजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015749, "chapter_id": 1331, "verse_number": "२-७२-१६", "content_sanskrit": "विरायटमन्वायात्तूर्णं धृष्टह्युम्नः प्रतापवान्।\nधनञ्जयो यज्ञसेनं महात्मानं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015750, "chapter_id": 1331, "verse_number": "२-७२-१७", "content_sanskrit": "भीष्मं च धृतराष्ट्रं च भीमसेनो महाबलः।\nद्रोणं तु ससुतं वीरं सहदेवो युधां पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015751, "chapter_id": 1331, "verse_number": "२-७२-१८", "content_sanskrit": "नकुलः सुबलं राजन्सहपुत्रं समन्वयात्।\nद्रौपदेयाः ससौभद्राः पार्वतीयान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015752, "chapter_id": 1331, "verse_number": "२-७२-१९", "content_sanskrit": "अन्वगच्छंस्तथैवान्यान्क्षत्रियान्क्षत्रियर्षभाः।\nएवं सुपूजिताः सर्वे जग्मुर्विप्राः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015753, "chapter_id": 1331, "verse_number": "२-७२-२०", "content_sanskrit": "गतेषु पार्थिवेन्द्रेषु सर्वेषु ब्राह्मणेषु च।\nयुधिष्ठिरमुवाचेदं वासुदेवः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015754, "chapter_id": 1331, "verse_number": "२-७२-२१", "content_sanskrit": "आपृच्छे त्वां गमिष्यामि द्वारकां कुरुनन्दन।\nराजसूयं क्रतुश्रेष्ठं दिष्ट्या त्वं प्राप्तवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015755, "chapter_id": 1331, "verse_number": "२-७२-२२", "content_sanskrit": "तमुवाचैवमुक्तस्तु धर्मराजो जनार्दनम्।\nतव प्रसादाद्गोविन्द प्राप्तः क्रतुवरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015756, "chapter_id": 1331, "verse_number": "२-७२-२३", "content_sanskrit": "क्षत्रं समग्रमपि च त्वत्प्रसादाद्वशे स्थितम्।\nउपादाय बलिं मुख्यं मामेव समुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015757, "chapter_id": 1331, "verse_number": "२-७२-२४", "content_sanskrit": "कथं त्वद्गमनार्थं मे वाणी वितरतेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015758, "chapter_id": 1331, "verse_number": "२-७२-२५", "content_sanskrit": "न ह्यहं त्वामृते वीरं रतिं प्राप्नोमि कर्हचित्।\nअवश्यं चैव गन्तव्या भवता द्वारका पुरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015759, "chapter_id": 1331, "verse_number": "२-७२-२६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015760, "chapter_id": 1331, "verse_number": "२-७२-२६", "content_sanskrit": "एवमुक्तः स धर्मात्मा युधिष्ठिरसहायवान्।\nअभिगम्याब्रवीत्प्रीतः पृथां पृथुयशा हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015761, "chapter_id": 1331, "verse_number": "२-७२-२७", "content_sanskrit": "साम्राज्यं समनुप्राप्ताः पुत्रास्तेऽद्य पितृष्वसः।\nसिद्धार्था वसुमन्तश्च सा त्वं प्रीतिमवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015762, "chapter_id": 1331, "verse_number": "२-७२-२८", "content_sanskrit": "अनुज्ञातस्त्वया चाहं द्वारकां गन्तुमुत्सहे।\nसुभद्रां द्रौपदीं चैव सभाजयत केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015763, "chapter_id": 1331, "verse_number": "२-७२-२९", "content_sanskrit": "निष्क्रम्यान्तः पुरात्तस्माद्युधिष्ठिरसहायवान्।\nस्नातश्च कृतजप्यश्च ब्राह्मणान्स्वस्ति वाच्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015764, "chapter_id": 1331, "verse_number": "२-७२-३०", "content_sanskrit": "ततो मेघवपुः प्रग्व्यं स्यन्दनं च सुकल्पितम्।\nयोजयित्वा महाबाहुर्दारुकः समुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015765, "chapter_id": 1331, "verse_number": "२-७२-३१", "content_sanskrit": "उपस्थितं रथं दृष्ट्वा तार्क्ष्यप्रवरकेतनम्।\nप्रदक्षिणमुपावृत्य समारुह्य महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015766, "chapter_id": 1331, "verse_number": "२-७२-३२", "content_sanskrit": "प्रययौ पुण्डरीकाक्षस्ततो द्वारवतीं पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015767, "chapter_id": 1331, "verse_number": "२-७२-३३", "content_sanskrit": "तं पद्भ्यामनुवव्राज धर्मराजो युधिष्ठिरः।\nभ्रातृभिः सहितः श्रीमान्वासुदेवं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015768, "chapter_id": 1331, "verse_number": "२-७२-३४", "content_sanskrit": "ततो मुहूर्तं सङ्गृह्य स्यन्दनप्रवरं हरिः।\nअब्रवीत्पुण्डरीकाक्षः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015769, "chapter_id": 1331, "verse_number": "२-७२-३५", "content_sanskrit": "अप्रमत्तः स्थितो नित्यं प्रजाः पाहि विशाम्पते।\nपर्जन्यमिव भूतानि महाद्रुममिव द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015770, "chapter_id": 1331, "verse_number": "२-७२-३६", "content_sanskrit": "बान्धवास्त्वोपजीवन्तु सहस्राक्षमिवामराः।\nकृत्वा परस्परेणैव संवादं कृष्णपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015771, "chapter_id": 1331, "verse_number": "२-७२-३७", "content_sanskrit": "अन्योन्यं समनुज्ञाप्य जग्मतुः स्वगृहान्प्रति।\nगते द्वारवतीं कृष्णे सात्वतप्रवरे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015772, "chapter_id": 1331, "verse_number": "२-७२-३८", "content_sanskrit": "महादुर्योधनो राजा शकुनिश्चापि सौबलः।\nसूतपुत्रश्च गधेयः सह दुःशासनादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015773, "chapter_id": 1331, "verse_number": "२-७२-३९", "content_sanskrit": "सर्वकामगुणोपेतैरर्च्यमानास्तु भारत।\nतस्यां सभायां दिव्यायामवसंस्तत्र पाण्डवैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015774, "chapter_id": 1331, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि द्विसप्ततितमोऽध्यायः॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]