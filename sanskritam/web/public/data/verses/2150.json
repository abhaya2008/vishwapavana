[{"id": 2052030, "chapter_id": 2150, "verse_number": "७-७७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052031, "chapter_id": 2150, "verse_number": "७-७७-१", "content_sanskrit": "तां निशां दुःखशोकार्तौ निःश्वसन्ताविवोरगौ।\nनिद्रां नैवोपलेभाते वासुदेवधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052032, "chapter_id": 2150, "verse_number": "७-७७-२", "content_sanskrit": "नरनारायणौ क्रुद्धौ ज्ञात्वा देवाः सवासवाः।\nव्यथिताश्चिन्तयामासुः किंस्विदेतद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052033, "chapter_id": 2150, "verse_number": "७-७७-३", "content_sanskrit": "ववुश्च दारुणा वाता रूक्षा घोराभिशंसिनः।\nसकबन्धस्तथाऽऽदित्ये परिघः समदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052034, "chapter_id": 2150, "verse_number": "७-७७-४", "content_sanskrit": "शुष्काशन्यश्च निष्पेतुः सनिर्घाताः सविद्युतः।\nचचाल चापि पृथिवी सशैलवनकानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052035, "chapter_id": 2150, "verse_number": "७-७७-५", "content_sanskrit": "चुक्षुभुश्च महाराज सागारा मकरालयाः।\nप्रतिस्रोतःप्रवृत्ताश्च तथा गन्तुं समुद्रगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052036, "chapter_id": 2150, "verse_number": "७-७७-६", "content_sanskrit": "रथाश्वनरनागानां प्रवृत्तमधरोत्तरम्।\nक्रव्यादानां प्रमोदार्थं यमराष्ट्रविवृद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052037, "chapter_id": 2150, "verse_number": "७-७७-७", "content_sanskrit": "वाहनानि शकृन्मूत्रे मुमुचू रुरुदुश्च ह।\nतान्दृष्ट्वा दारुणान्सर्वानुत्पाताँल्लोमहर्षणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052038, "chapter_id": 2150, "verse_number": "७-७७-८", "content_sanskrit": "सर्वे ते व्यथिताः सैन्यास्त्वदीया भरतर्षभा।\nश्रुत्वा महाबलस्योग्रां प्रतिज्ञां सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052039, "chapter_id": 2150, "verse_number": "७-७७-९", "content_sanskrit": "अथ कृष्णं महाबाहुरब्रवीत्पाकशासनिः।\nआश्वासय सुभद्रां त्वं भगिनीं स्नुषया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052040, "chapter_id": 2150, "verse_number": "७-७७-१०", "content_sanskrit": "स्नुषां चास्या वयस्याश्च विशोकाः कुरु माधव।\nसाम्ना सत्येन युक्तेन वचसाऽऽश्वासय प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052041, "chapter_id": 2150, "verse_number": "७-७७-११", "content_sanskrit": "ततोऽर्जुनगृहं गत्वा वासुदेवः सुदुर्मनाः।\nभगिनीं पुत्रशोकार्तामाश्वासयत दुःखिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052042, "chapter_id": 2150, "verse_number": "७-७७-१२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052043, "chapter_id": 2150, "verse_number": "७-७७-१२", "content_sanskrit": "मा शोकं कुरु वार्ष्णेयि कुमारं प्रति सस्नुषा।\nसर्वेषां प्राणिनां भीरु निष्ठैषा कालनिर्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052044, "chapter_id": 2150, "verse_number": "७-७७-१३", "content_sanskrit": "कुले जातस्य वीरस्य क्षत्रियस्य विशेषतः।\nसदृशं मरणं ह्येतत्तव पुत्रस्य मा शुचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052045, "chapter_id": 2150, "verse_number": "७-७७-१४", "content_sanskrit": "दिष्ट्या महारथो धीरः पितुस्तुल्यपराक्रमः।\nक्षात्रेण विधिना प्राप्तो वीराभिलषितां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052046, "chapter_id": 2150, "verse_number": "७-७७-१५", "content_sanskrit": "जित्वा सुबहुशः शत्रून्प्रेषयित्वा च मृत्यवे।\nगतः पुण्यकृतां लोकान्सर्वकामदुहोऽक्षयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052047, "chapter_id": 2150, "verse_number": "७-७७-१६", "content_sanskrit": "तपसा ब्रह्मचर्येण श्रुतेन प्रज्ञयापि च।\nसन्तो यां गतिमिच्छन्ति तां प्राप्तस्तव पुत्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052048, "chapter_id": 2150, "verse_number": "७-७७-१७", "content_sanskrit": "वीरसूर्वीरपत्नी त्वं वीरजा वीरबान्धवा।\nमा शुचस्तनयं भद्रे गतःस परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052049, "chapter_id": 2150, "verse_number": "७-७७-१८", "content_sanskrit": "`स्वाध्याययुक्तं ब्राह्ममी याचितारं\n`स्वाध्याययुक्तं ब्राह्मणी याचितारं\nगौर्बोढारं क्षिप्रगन्तारमश्वा।\nदासं शूद्रा कर्मकारं तु वैश्या\nशूरं सूते त्वद्विधा राजपुत्री॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052050, "chapter_id": 2150, "verse_number": "७-७७-१९", "content_sanskrit": "प्राप्स्यते चाप्यसौ पापः सैन्धवो बालघातकः।\nअधर्मस्यास्य तु फलं ससुहृद्गणबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052051, "chapter_id": 2150, "verse_number": "७-७७-२०", "content_sanskrit": "व्युष्टायां तु वरारोहे रजन्यां पापकर्मकृत्।\nन हि मोक्ष्यति पार्थात्स प्रविष्टोऽप्यमरावतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052052, "chapter_id": 2150, "verse_number": "७-७७-२१", "content_sanskrit": "श्वः शिरः पादमूलं ते सैन्धवस्याहृतं ध्रुवम्।\nपद्ध्यां प्रमथितासि त्वं विशोका भव मा रुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052053, "chapter_id": 2150, "verse_number": "७-७७-२२", "content_sanskrit": "क्षत्रधर्मं पुरस्कृत्य गतः शूरः सतां गतिम्।\nवयं च प्राप्नुयामेह ये चान्ये शस्त्रजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052054, "chapter_id": 2150, "verse_number": "७-७७-२३", "content_sanskrit": "व्यूढोरस्को महाबाहुरनिवर्ती रिपुव्रजात्।\nगतस्तव वरारोहे पुत्रः स्वर्गं ज्वरं जहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052055, "chapter_id": 2150, "verse_number": "७-७७-२४", "content_sanskrit": "अनुयातश्च पितरं मातृपक्षं च वीर्यवान्।\nसहस्रशो रिपून्हत्वा हतः शूरो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052056, "chapter_id": 2150, "verse_number": "७-७७-२५", "content_sanskrit": "आश्वासय स्नुषां राज्ञि मा शुचः क्षत्रिये भृशम्।\nश्वः प्रियं सुमहच्छ्रुत्वा विशोका भव नन्दिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052057, "chapter_id": 2150, "verse_number": "७-७७-२६", "content_sanskrit": "यत्पार्थेन प्रतिज्ञातं तत्तथा न तदन्यथा।\nचिकीर्षितं हि ते भर्तुर्न भवेज्जातु निष्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052058, "chapter_id": 2150, "verse_number": "७-७७-२७", "content_sanskrit": "यदि च मनुजपन्नगाः पिशाचा\nरजनिचचाराः पतगाः सुरासुराश्च।\nरणगतमभियान्ति सिन्धुराजं\nन स भविता सह तैरपि प्रभाते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052059, "chapter_id": 2150, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि सप्तसप्ततितमोऽध्यायः॥ ७७ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-७७-२७ अभियान्ति रक्षिष्यन्ति॥ ५-७७-७७ सप्तसप्ततितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]