[{"id": 2012754, "chapter_id": 1263, "verse_number": "२-४-१", "content_sanskrit": "वैशम्पायन उवाच॥\nतां तु कृत्वा सभां श्रेष्ठां मयश्चार्जुनमब्रवीत्।\nभूतानां च महावीर्यो ध्वजाग्रे किङ्करो गणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012755, "chapter_id": 1263, "verse_number": "२-४-२", "content_sanskrit": "तव विष्फारघोषेण मेघवन्निनदिष्यति।\nअयं हि सूर्यसङ्काशो ज्वलनस्य रथो महान्॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012756, "chapter_id": 1263, "verse_number": "२-४-३", "content_sanskrit": "इमे च दिविजाः श्वेता वीर्यवन्तो हयोत्तमाः।\nमायामयः कृतो ह्येष ध्वजो वानरलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012757, "chapter_id": 1263, "verse_number": "२-४-४", "content_sanskrit": "असज्जमानो वृक्षेषु धूमकेतुरिवोच्छ्रितः।\nबहुवर्णं हि लक्ष्येत ध्वजं वानरलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012758, "chapter_id": 1263, "verse_number": "२-४-५", "content_sanskrit": "ध्वजोत्कटं ह्यनवमं युद्धे द्रक्ष्यसि विष्ठितम्।\nएव वीरः सव्यसाचिन्ध्वजस्यान्ते भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012759, "chapter_id": 1263, "verse_number": "२-४-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012760, "chapter_id": 1263, "verse_number": "२-४-६", "content_sanskrit": "इत्युक्त्वाऽऽलिङ्ग्य वीभत्सुं विसृष्टः प्रययौ मयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012761, "chapter_id": 1263, "verse_number": "२-४-७", "content_sanskrit": "ततः प्रवेशनं तस्यां चक्रे राजा युधिष्ठिरः।\nअयुतं भोजयित्वा तु ब्राह्मणानां नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012762, "chapter_id": 1263, "verse_number": "२-४-८", "content_sanskrit": "साज्येन पायसेनैव मधुना मिश्रितेन च।\nभक्ष्यैर्मूलैः फलैश्चैव मांसैर्वाराहहारिणैः।\nकृसरेणाथ जीवन्त्या हविष्येण च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012763, "chapter_id": 1263, "verse_number": "२-४-९", "content_sanskrit": "मांसप्रकारैर्विविधैः खाद्यैश्चापि तथा नृप।\nचोष्यैश्च विविधै राजन्पेयैश्च बहुविस्तरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012764, "chapter_id": 1263, "verse_number": "२-४-१०", "content_sanskrit": "अहतैश्चैव वासोभिर्माल्यैरुच्चावचैरपि।\nतर्पयामास विप्रेन्द्रान्नानादिग्भ्यः समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012765, "chapter_id": 1263, "verse_number": "२-४-११", "content_sanskrit": "ददौ तेभ्यः सहस्राणि गवां प्रत्येकशः पुनः।\nपुण्याहघोषस्तत्रासीद्दिवस्पृगिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012766, "chapter_id": 1263, "verse_number": "२-४-१२", "content_sanskrit": "वादित्रैर्विविधैर्दिव्यैर्गन्धैरुच्चावचैरपि।\nपूजयित्वा कुरुश्रेष्ठो देवतानि निवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012767, "chapter_id": 1263, "verse_number": "२-४-१३", "content_sanskrit": "तत्र मल्ला नटा झल्लाः सूता वैतालिकास्तथा।\nउपतस्थुर्महात्मानं धर्मपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012768, "chapter_id": 1263, "verse_number": "२-४-१४", "content_sanskrit": "तथा स कृत्वा पूजां तां भ्रातृभिः सह पाण्डवः।\nतस्यां सभायां रम्यायां रेमे शक्रो यथा दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012769, "chapter_id": 1263, "verse_number": "२-४-१५", "content_sanskrit": "सभायामृषयस्तस्यां पाण्डवैः सह आसते।\nआसाञ्चक्रुर्नरेन्द्राश्च नानादेशसमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012770, "chapter_id": 1263, "verse_number": "२-४-१६", "content_sanskrit": "असितो देवलः सत्यः सर्पिर्माली महाशिराः।\nअर्वा वसुः सुमित्रश्च मैत्रेयः शुनको बलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012771, "chapter_id": 1263, "verse_number": "२-४-१७", "content_sanskrit": "बको दाल्भ्यः स्थूलशिराः कृष्णद्वैपायनः शुकः।\nसुमन्तुर्जैमिनिः पैलो व्यासशिष्यास्तथा वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012772, "chapter_id": 1263, "verse_number": "२-४-१८", "content_sanskrit": "तित्तिरिर्याज्ञवल्क्यश्च ससुतो रोमहर्षणः।\nअप्सुहोम्यश्च धौम्यश्च अणीमाण्डव्यकौशिकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012773, "chapter_id": 1263, "verse_number": "२-४-१९", "content_sanskrit": "दामोष्णीपस्त्रैबलीश्च पर्णादो घटजानुकः।\nमौञ्जायनो वायुभक्षः पाराशर्यश्च सारिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012774, "chapter_id": 1263, "verse_number": "२-४-२०", "content_sanskrit": "बलिवाकः सिनीवाकः सप्तपालः कृतश्रमः।\nजातूकर्णः शिखावांश्च आलम्बः पारिजातकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012775, "chapter_id": 1263, "verse_number": "२-४-२१", "content_sanskrit": "पर्वतश्च महाभागो मार्कण्डेयो महामुनिः।\nपवित्रपाणिः सावर्णो भालुकिर्गालवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012776, "chapter_id": 1263, "verse_number": "२-४-२२", "content_sanskrit": "जङ्घाबन्धुश्च रैभ्यश्च कोपवेगस्तथा भृगुः।\nहरिबभ्रुश्च कौण्डिन्यो बभ्रुमाली सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012777, "chapter_id": 1263, "verse_number": "२-४-२३", "content_sanskrit": "काक्षीवानौशिजश्चैव नाचिकेतोऽथ गौतमः।\nपैङ्ग्यो वराहः शुनकः शाण्डिल्यश्च महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012778, "chapter_id": 1263, "verse_number": "२-४-२४", "content_sanskrit": "कुक्कुरो वेणुजङ्घोऽथ कालापः कठ एव च।\nमुनयो धर्मविद्वांसो धृतात्मानो जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012779, "chapter_id": 1263, "verse_number": "२-४-२५", "content_sanskrit": "एते चान्ये च बहवो वेदवेदाङ्गपारगाः।\nउपासते महात्मानं सभायामृषिसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012780, "chapter_id": 1263, "verse_number": "२-४-२६", "content_sanskrit": "कथयन्तः कथाः पुण्या धर्मज्ञाः शुचयोऽमलाः।\nतथैव क्षत्रियश्रेष्ठा धर्मराजमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012781, "chapter_id": 1263, "verse_number": "२-४-२७", "content_sanskrit": "श्रीमान्महात्मा धर्मात्मा मुञ्जकेतुर्विवर्धनः।\nसङ्ग्रामजिद्दुर्मुखश्च उग्रसेनश्च वीर्यवान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012782, "chapter_id": 1263, "verse_number": "२-४-२८", "content_sanskrit": "कक्षसेनः क्षितिपतिः क्षेमकश्चापराजितः।\nकम्बोजराजः कमठः कम्पनश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012783, "chapter_id": 1263, "verse_number": "२-४-२९", "content_sanskrit": "सततं कम्पयामास यवनानेक एव यः।\nबलपौरुषसम्पन्नान्कृतास्त्रानमितौजसः।\nयथाऽसुरान्कालकेयान्देवो वज्रधरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012784, "chapter_id": 1263, "verse_number": "२-४-३०", "content_sanskrit": "जटासुरो मद्रकानां च राजा\nकुन्तिः पुलिन्दश्च किरातराजः।\nतथाङ्गवाङ्गौ सहपुण्ड्रकेण\nपाण्ड्योड्रराजौ च सहान्ध्रकेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012785, "chapter_id": 1263, "verse_number": "२-४-३१", "content_sanskrit": "अङ्गो वङ्गः सुमित्रश्च शैब्यश्चामित्रकर्शनः।\nकिरातराजः सुमना यवनाधिपतिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012786, "chapter_id": 1263, "verse_number": "२-४-३२", "content_sanskrit": "चाणूरो देवरातश्च भोजो भीमरथश्च यः।\nश्रुतायुधश्च कालिङ्गो जयसेनश्च मागधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012787, "chapter_id": 1263, "verse_number": "२-४-३३", "content_sanskrit": "सुकर्मा चेकितानश्च पुरुश्चामित्रकर्शनः।\nकेतुमान्वसुदानश्च वैदेहोऽथ कृतक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012788, "chapter_id": 1263, "verse_number": "२-४-३४", "content_sanskrit": "सुधर्मा चानिरुद्धश्च श्रुतायुश्च महाबलः।\nअनूपराजो दुर्धर्पः क्रमजिच्च सुदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012789, "chapter_id": 1263, "verse_number": "२-४-३५", "content_sanskrit": "शिशुपालः सहसुतः करूपाधिपतिस्तथा।\nवृष्णीनां चैव दुर्धर्पाः कुमारा देवरूपिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012790, "chapter_id": 1263, "verse_number": "२-४-३६", "content_sanskrit": "आहुको विपृथुश्चैव गदः सारण एव च।\nअक्रूरः कृतवर्मा च सत्यकश्च शिनेः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012791, "chapter_id": 1263, "verse_number": "२-४-३७", "content_sanskrit": "भीष्मकोऽथाकृतिश्चैव द्युमत्सेनश्च वीर्यवान्।\nकेकयाश्च महेष्वासा यज्ञसेनश्च सोमकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012792, "chapter_id": 1263, "verse_number": "२-४-३८", "content_sanskrit": "केतुमान्वसुमांश्चैव कृतास्त्रश्च महाबलः।\nएते चान्ये च बहवः क्षत्रिया मुख्यसंमताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012793, "chapter_id": 1263, "verse_number": "२-४-३९", "content_sanskrit": "उपासते सभायां स्म कुन्तीपुत्रं युधिष्ठिरम्।\nअर्जुनं ये व संश्रित्य राजपुत्रा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012794, "chapter_id": 1263, "verse_number": "२-४-४०", "content_sanskrit": "अशिक्षन्त धनुर्वेदं रौरवाजिनवाससः।\nतत्रैव शिक्षिता राजन्कुमारा वृष्णिनन्दनाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012795, "chapter_id": 1263, "verse_number": "२-४-४१", "content_sanskrit": "रौक्मिणेयश्च साम्बश्च युयुधानश्च सात्यकिः।\nसुधर्मा चानिरुद्धश्च शैव्यश्च नरपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012796, "chapter_id": 1263, "verse_number": "२-४-४२", "content_sanskrit": "एते चान्ये च बहवो राजानः पृथिवीपते।\nधनञ्जयसखा चात्र नित्यमास्ते स्म तुम्बुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012797, "chapter_id": 1263, "verse_number": "२-४-४३", "content_sanskrit": "उपासते महात्मानमासीनं सप्तविंशतिः।\nचित्रसेनः सहामात्यो गन्धर्वाप्सरसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012798, "chapter_id": 1263, "verse_number": "२-४-४४", "content_sanskrit": "गीतवादित्रकुशलाः साम्यतालविशारदाः।\nप्रमाणोऽथ लये स्थाने किन्नराः कृतनिश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2012799, "chapter_id": 1263, "verse_number": "२-४-४५", "content_sanskrit": "सञ्चोदितास्तुम्बुरुणा गन्धर्वसहितास्तदा।\nगायन्ति दिव्यतानैस्ते यथान्यायं मनस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2012800, "chapter_id": 1263, "verse_number": "२-४-४६", "content_sanskrit": "पाण्डुपुत्रानृषींश्चैव रमयन्त उपासते।\nतस्यां सभायामासीनाः सुव्रताः सत्यसङ्गराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2012801, "chapter_id": 1263, "verse_number": "२-४-४७", "content_sanskrit": "दिवीव देवा ब्रह्माणं युधिष्ठिरमुपासते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2012802, "chapter_id": 1263, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि चतुर्थोऽध्यायः॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]