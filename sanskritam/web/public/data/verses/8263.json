[{"id": 900002323, "chapter_id": 8263, "verse_number": "8.1", "content_sanskrit": "श्वेतकेतुर्हारुणेय आस तं ह पितोवाच श्वेतकेतो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002324, "chapter_id": 8263, "verse_number": "8.2", "content_sanskrit": "यथा मृत्पिण्डविज्ञानात् सादृश्यादेव मृन्मयाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002325, "chapter_id": 8263, "verse_number": "8.3", "content_sanskrit": "विकारत्वविवक्षायामेकपिण्डमणिशब्दा व्यर्थाः स्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002326, "chapter_id": 8263, "verse_number": "8.4", "content_sanskrit": "'मृत्तिकेति', 'लोहमणिरिति'..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002327, "chapter_id": 8263, "verse_number": "8.5", "content_sanskrit": "न च वाचारम्भणमात्रमिति मात्रशब्दोऽस्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002328, "chapter_id": 8263, "verse_number": "8.6", "content_sanskrit": "अतो वाचा नाम्नामारम्भणं विकारो विविधाकारो विक्रियमाण:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002329, "chapter_id": 8263, "verse_number": "8.7", "content_sanskrit": "न च मृत्तिकादिनामविकारः साङ्केतिकं नाम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002330, "chapter_id": 8263, "verse_number": "8.8", "content_sanskrit": "सदेव सोम्येदमग्र आसीदेकमेवाद्वितीयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002331, "chapter_id": 8263, "verse_number": "8.9", "content_sanskrit": "न च विजातीयभेदवर्जनं नाम कुत्रचित् प्रसिद्धम् तत्प्रमाणाभावाच्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002332, "chapter_id": 8263, "verse_number": "8.10", "content_sanskrit": "विजातीयाभावे येनाश्रुतं श्रुतं भवतीत्यादि विशेषणं च व्यर्थम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002333, "chapter_id": 8263, "verse_number": "8.11", "content_sanskrit": "न च मिथ्या सत्यमिति भेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002334, "chapter_id": 8263, "verse_number": "8.12", "content_sanskrit": "सर्वोत्तमत्वात् सन्नामा हरिर्नारायणः प्रभुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002335, "chapter_id": 8263, "verse_number": "8.13", "content_sanskrit": "तेषां खल्वेषां भूतानां त्रीण्येव बीजानि भवन्त्याण्डजं जीवजमुदि्भज्जमिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002336, "chapter_id": 8263, "verse_number": "8.14", "content_sanskrit": "यदग्ने रोहितं रूपं तेजसस्तद्रूपं यच्छुक्लं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002337, "chapter_id": 8263, "verse_number": "8.15", "content_sanskrit": "अतोऽन्यनामधेयं तु वाचाऽऽरम्भणहेतुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002338, "chapter_id": 8263, "verse_number": "8.16", "content_sanskrit": "एक एवाद्वितीयोऽसावतः सर्वोत्तमत्वतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002339, "chapter_id": 8263, "verse_number": "8.17", "content_sanskrit": "अन्नमशितं त्रेधा विधीयते तस्य यः स्थविष्ठो धातुस्तत्पुरीषं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002340, "chapter_id": 8263, "verse_number": "8.18", "content_sanskrit": "'जीव इति भगवतोऽनिरुद्धस्याऽख्या ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002341, "chapter_id": 8263, "verse_number": "8.19", "content_sanskrit": "जीवशब्देन संसारिविवक्षायां तत् तेज ऐक्षतेत्यादिना ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002342, "chapter_id": 8263, "verse_number": "8.20", "content_sanskrit": "यतश्च स एव जीवेनाऽत्मनाऽनुप्रभूतः पेपीयमानो मोदमानस्तिष्ठतीति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002343, "chapter_id": 8263, "verse_number": "8.21", "content_sanskrit": "दध्नः सोम्यः मथ्यमानस्य योऽणिमा स ऊर्ध्वः समुदीषति तत्सर्पिर्भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002344, "chapter_id": 8263, "verse_number": "8.22", "content_sanskrit": "षोडशकलः सोम्य पुरुषः पञ्चदशाहानि माऽशीः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002345, "chapter_id": 8263, "verse_number": "8.23", "content_sanskrit": "उद्दालको हाऽरुणिः श्वेतकेतुं पुत्रमुवाच ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002346, "chapter_id": 8263, "verse_number": "8.24", "content_sanskrit": "अशनायापिपासे मे सोम्य विजानीहीति यत्रैतत्पुरुषोऽशिशिषति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002347, "chapter_id": 8263, "verse_number": "8.25", "content_sanskrit": "यत्रैतत् पुरुषः स्वपिति नाम सता सोम्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002348, "chapter_id": 8263, "verse_number": "8.26", "content_sanskrit": "शरीरधातुकृत्त्वेन लक्ष्म्याद्याश्च मुमुक्षुणा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002349, "chapter_id": 8263, "verse_number": "8.27", "content_sanskrit": "मुक्तावुमा तु वागारख्या रुद्रं याति मनोऽभिधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002350, "chapter_id": 8263, "verse_number": "8.28", "content_sanskrit": "स य एषोऽणिमैतदात्म्यमिदं सर्वं तत्सत्यं स आत्मा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002351, "chapter_id": 8263, "verse_number": "8.29", "content_sanskrit": "असुराः स्तब्धतां याता ब्रह्माहमिति मानिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002352, "chapter_id": 8263, "verse_number": "8.30", "content_sanskrit": "आलम्ब्य तन्मतं न त्वमेकत्वं विद्धि विष्णुना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002353, "chapter_id": 8263, "verse_number": "8.31", "content_sanskrit": "यथा सोम्य मधु मधुकृतो निस्तिष्ठन्ति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002354, "chapter_id": 8263, "verse_number": "8.32", "content_sanskrit": "इमाः सोम्य नद्यः पुरस्तात् प्राच्यः स्यन्दन्ते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_engl