[{"id": 7003215000, "chapter_id": 23215, "verse_number": "१-१८-१", "content_sanskrit": "विष्णुरुवाच  ।\nएकाक्षराय रुद्राय अकारायात्मरूपिणे  ।\nउकारायादिदेवाय विद्यादेहाय वै नमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003215001, "chapter_id": 23215, "verse_number": "१-१८-२", "content_sanskrit": "तृतीयाय मकाराय शिवाय परमात्मने  ।\nसूर्याग्निसोमवर्णाय यजमानाय वै नमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003215002, "chapter_id": 23215, "verse_number": "१-१८-३", "content_sanskrit": "अग्नये रुद्ररूपाय रुद्राणां पतये नमः  ।\nशिवाय शिवमंत्राय सद्योजाताय वेधसे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003215003, "chapter_id": 23215, "verse_number": "१-१८-४", "content_sanskrit": "वामाय वामदेवाय वरदायामृताय ते  ।\nअघोरायातिघोराय सद्योजाताय रंहसे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003215004, "chapter_id": 23215, "verse_number": "१-१८-५", "content_sanskrit": "ईशानाय श्मशानाय अतिवेगाय वेगिने  ।\nनमोस्तु श्रुतिपादाय ऊर्ध्वलिंगाय लिंगिने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003215005, "chapter_id": 23215, "verse_number": "१-१८-६", "content_sanskrit": "हेमलिंगाय हेमाय वारिलिंगाय चांभसे  ।\nशिवाय शिव लिंगाय व्यापिने व्योमव्यापिने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003215006, "chapter_id": 23215, "verse_number": "१-१८-७", "content_sanskrit": "वायवे वायुवेगाय नमस्ते वायुव्यापिने  ।\nतेजसे तेजसां भर्त्रे नमस्तेजोधिव्यापिने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003215007, "chapter_id": 23215, "verse_number": "१-१८-८", "content_sanskrit": "जलाय जलभूताय नमस्ते जलव्यापिने  ।\nपृथिव्यै चांतरिक्षाय पृथिवीव्यापिने नमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003215008, "chapter_id": 23215, "verse_number": "१-१८-९", "content_sanskrit": "शब्दस्पर्शस्वरूपाय रसगंधाय गंधिने  ।\nगणाधिपतये तुभ्यं गुह्यद्गुह्यतमाय ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003215009, "chapter_id": 23215, "verse_number": "१-१८-१०", "content_sanskrit": "अनंताय विरुपाय अनंतानामयाय च  ।\nशाश्वताय वरिष्ठाय वारिगर्भाय योगिने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003215010, "chapter_id": 23215, "verse_number": "१-१८-११", "content_sanskrit": "संस्थिता याम्भसां मध्ये आवयोर्मध्यवर्चसे  ।\nगोप्त्रे हर्त्रे सदा कर्त्रे निधनायेश्वराय च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003215011, "chapter_id": 23215, "verse_number": "१-१८-१२", "content_sanskrit": "अचेतनाय चिंत्याय चेतनायासहारिणे  ।\nअरूपाय सुरूपाय अनंगायाङ्गहारिणे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003215012, "chapter_id": 23215, "verse_number": "१-१८-१३", "content_sanskrit": "भस्मदिग्धशरीराय भानुसोमाग्निहेतवे  ।\nश्वेताय श्वेतवर्णाय तुहिनाद्रिचराय च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003215013, "chapter_id": 23215, "verse_number": "१-१८-१४", "content_sanskrit": "सुश्वेताय सुवक्त्राय नमः श्वेतशिखाय च  ।\nश्वेतास्याय महास्याय नमस्ते श्वेतलोहित ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003215014, "chapter_id": 23215, "verse_number": "१-१८-१५", "content_sanskrit": "सुताराय विशिष्टाय नमो दुंदुभिने हर  ।\nशतरूप विरुपाय नमः केतुमते सदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003215015, "chapter_id": 23215, "verse_number": "१-१८-१६", "content_sanskrit": "ऋद्धिशोकविशोकाय पिनाकाय कपर्दिने  ।\nविपाशाय सुपाशाय नमस्ते पाशनाशिने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003215016, "chapter_id": 23215, "verse_number": "१-१८-१७", "content_sanskrit": "सुहोत्राय हविष्याय सुब्रह्मण्याय सूरिणे  ।\nसुमुखाय सुवक्त्राय दुर्दमाय दमाय च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003215017, "chapter_id": 23215, "verse_number": "१-१८-१८", "content_sanskrit": "कंकाय कंकरूपाय कंकणीकृतपन्नग  ।\nसनकाय नमस्तुभ्यं सनातन सनंदन ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003215018, "chapter_id": 23215, "verse_number": "१-१८-१९", "content_sanskrit": "सनत्कुमार सारंगमारणाय महात्मने  ।\nलोकाक्षिणे त्रिधामाय नमो विरजसे सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003215019, "chapter_id": 23215, "verse_number": "१-१८-२०", "content_sanskrit": "शंखपालाय शंखाय रजसे तमसे नमः  ।\nसारस्वताय मेघाय मेघवाहन ते नमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003215020, "chapter_id": 23215, "verse_number": "१-१८-२१", "content_sanskrit": "सुवाहाय विवाहाय विवादवरदाय च  ।\nनमः शिवाय रुद्राय प्रधानाय नमोनमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003215021, "chapter_id": 23215, "verse_number": "१-१८-२२", "content_sanskrit": "त्रिगुणाय नमस्तुभ्यं चतुर्व्यूहात्मने नमः  ।\nसंसाराय नमस्तुभ्यं नमः संसारहेतवे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003215022, "chapter_id": 23215, "verse_number": "१-१८-२३", "content_sanskrit": "मोक्षाय मोक्षरूपाय मोक्षकर्त्रे नमोनमः  ।\nआत्मने ऋषये तुभ्यं स्वामिने विष्णवे नमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003215023, "chapter_id": 23215, "verse_number": "१-१८-२४", "content_sanskrit": "नमो भगवते तुभ्यं नागानां पतये नमः  ।\nओंकाराय नमस्तुभ्यं सर्वज्ञाय नमो नमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003215024, "chapter_id": 23215, "verse_number": "१-१८-२५", "content_sanskrit": "सर्वाय च नमस्तुभ्यं नमो नारायणाय च  ।\nनमो हिरण्यगर्भाय आदिदेवाय ते नमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003215025, "chapter_id": 23215, "verse_number": "१-१८-२६", "content_sanskrit": "नमोस्त्वजाय पतये प्रजानां व्यूहहेतवे  ।\nमहादेवाय देवानामीश्वराय नमो नमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003215026, "chapter_id": 23215, "verse_number": "१-१८-२७", "content_sanskrit": "शर्वाय च नमस्तुभ्यं सत्याय शमनाय च  ।\nब्रह्मणे चैव भूतानां सर्वज्ञाय नमो नमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003215027, "chapter_id": 23215, "verse_number": "१-१८-२८", "content_sanskrit": "महात्मने नमस्तुभ्यं प्रज्ञारूपाय वै नमः  ।\nचितये चितिरूपाय स्मृतिरूपाय वै नमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003215028, "chapter_id": 23215, "verse_number": "१-१८-२९", "content_sanskrit": "ज्ञानाय ज्ञानगम्याय नमस्ते संविदे सदा  ।\nशिखराय नमस्तुभ्यं नीलकंठाय वै नमः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003215029, "chapter_id": 23215, "verse_number": "१-१८-३०", "content_sanskrit": "अर्धनारीशरीराय अव्यक्ताय नमोनमः  ।\nएकादशविभेदाय स्थाणवे ते नमः सदा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003215030, "chapter_id": 23215, "verse_number": "१-१८-३१", "content_sanskrit": "नमः सोमाय सूर्याय भवाय भवहारिणे  ।\nयशस्कराय देवाय शंकरायेश्वराय च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003215031, "chapter_id": 23215, "verse_number": "१-१८-३२", "content_sanskrit": "नमोंबिकाधिपतये उमायाः पतये नमः  ।\nहिरण्यबाहवे तुभ्यं नमस्ते हेमरेतसे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003215032, "chapter_id": 23215, "verse_number": "१-१८-३३", "content_sanskrit": "नीलकेशाय वित्ताय शितिकंठाय वै नमः  ।\nकपर्दिने नमस्तुभ्यं नागांगाभरणाय च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003215033, "chapter_id": 23215, "verse_number": "१-१८-३४", "content_sanskrit": "वृषारूढाय सर्वस्य हर्त्रे कर्त्रे नमोनमः  ।\nवीररामातिरामाय रामनाथाय ते विभो ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003215034, "chapter_id": 23215, "verse_number": "१-१८-३५", "content_sanskrit": "नमो राजाधिराजाय राज्ञामधिगताय ते  ।\nनमः पालाधिपतये पालाशाकृंतते नमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003215035, "chapter_id": 23215, "verse_number": "१-१८-३६", "content_sanskrit": "नमः केयूरभूषाय गोपते ते नमोनमः  ।\nनमः श्रीकंठनाथाय नमो लिकुचपाणये ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003215036, "chapter_id": 23215, "verse_number": "१-१८-३७", "content_sanskrit": "भुवनेशाय देवाय वेदशास्त्र नमोस्तु ते  ।\nसारंगाय नमस्तुभ्यं राजहंसाय ते नमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003215037, "chapter_id": 23215, "verse_number": "१-१८-३८", "content_sanskrit": "कनकांगदहाराय नमः सर्पोपवीतिने  ।\nसर्पकुंडलमालाय कटिसूत्रीकृताहिने ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003215038, "chapter_id": 23215, "verse_number": "१-१८-३९", "content_sanskrit": "वेदगर्भाय गर्भाय विश्वगर्भाय ते शिव  ।\nब्रह्मोवाच  ।\nविररामेति संस्तुत्वा ब्रह्मणा सहितो हरिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003215039, "chapter_id": 23215, "verse_number": "१-१८-४०", "content_sanskrit": "एतत्स्तोत्रवरं पुण्यं सर्वपापप्रणाशनम्  ।\nयः पठेच्छ्रावयेद्वापि ब्राह्मणान् वेदपारगान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003215040, "chapter_id": 23215, "verse_number": "१-१८-४१", "content_sanskrit": "स याति ब्रह्मणो लोके पापकर्मरतोपि वै  ।\nतस्माज्जपेत्पठेन्नित्यं श्रावयेद्ब्राह्मणाञ्छुभान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003215041, "chapter_id": 23215, "verse_number": "१-१८-४२", "content_sanskrit": "सर्वपापविशुद्ध्यर्थं विष्णुना परिभाषितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]