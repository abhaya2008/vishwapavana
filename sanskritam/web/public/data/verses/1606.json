[{"id": 2028100, "chapter_id": 1606, "verse_number": "३-२४४-०x", "content_sanskrit": "यधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028101, "chapter_id": 1606, "verse_number": "३-२४४-१", "content_sanskrit": "अस्मानभिगतांस्तात भयार्ताञ्छरणैषिणः।\nकौरवान्विषमप्राप्तान्कथं ब्रूयास्त्वमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028102, "chapter_id": 1606, "verse_number": "३-२४४-२", "content_sanskrit": "भवन्ति भेदा ज्ञातीनां कलहाश्च वृकोदर।\nप्रसक्तानि च वैराणि ज्ञातिधर्मो न नश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028103, "chapter_id": 1606, "verse_number": "३-२४४-३", "content_sanskrit": "यदा तु कश्चिज्ज्ञातीनां बाह्यः प्रार्थयते कुलम्।\nन मर्षयन्ति तत्सन्तो बाह्येनाभिप्रधर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028104, "chapter_id": 1606, "verse_number": "३-२४४-४", "content_sanskrit": "जानात्येष हि दुर्बुद्धिरस्मानिह चिरोषितान्।\nस एवं परिभूयास्मानकार्षीदिदमप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028105, "chapter_id": 1606, "verse_number": "३-२४४-५", "content_sanskrit": "दुर्योधनस्य ग्रहणाद्गन्धर्वेण बलाद्रणे।\nस्त्रीणां बाह्याभिमर्शाच्च हतं भवति नः कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028106, "chapter_id": 1606, "verse_number": "३-२४४-६", "content_sanskrit": "श्चरणं च प्रपन्नानां त्राणार्थं च कुलस्य च।\nउत्तिष्ठध्वं नरव्याघ्राः सज्जीभवत मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028107, "chapter_id": 1606, "verse_number": "३-२४४-७", "content_sanskrit": "अर्जुनश्च यमौ चैव त्वं च भीमापराजितः।\nमोक्षयध्वं नरव्याघ्रा ह्रियमाणं सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028108, "chapter_id": 1606, "verse_number": "३-२४४-८", "content_sanskrit": "एते रथा नरव्याघ्राः सर्वशस्त्रसमन्विताः।\nधृतराष्ट्रस्य पुत्राणां विमला काञ्चनध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028109, "chapter_id": 1606, "verse_number": "३-२४४-९", "content_sanskrit": "सस्वनानधिरोहध्वं नित्यसज्जानिमान्रथान्।\nइन्द्रसेनादिभिः सूतैः कृतशस्त्रैरधिष्ठितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028110, "chapter_id": 1606, "verse_number": "३-२४४-१०", "content_sanskrit": "एतानास्थाय वै यत्ता गन्धर्वान्योद्धुमाहवे।\nसुयोधनस्य मोक्षाय प्रयतध्वमतनद्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028111, "chapter_id": 1606, "verse_number": "३-२४४-११", "content_sanskrit": "`परैः परिभवे प्राप्ते वयं पञ्चोत्तरं शतम्।\nपरस्परविरोधे तु वयं पञ्चैव ते शतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028112, "chapter_id": 1606, "verse_number": "३-२४४-१२", "content_sanskrit": "य एव कश्चिद्राजन्यः शरणार्थमिहागतम्।\nपरं शक्त्याभिरक्षेत किं पुनस्त्वं वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028113, "chapter_id": 1606, "verse_number": "३-२४४-१३", "content_sanskrit": "`एवमुक्तस्तु कौन्तेयः पुनर्वाक्यमभाषत।\nकोपसंरक्तनयनः पूर्ववैरमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028114, "chapter_id": 1606, "verse_number": "३-२४४-१४", "content_sanskrit": "पुरा जतुगृहेऽनेन दग्धुमस्मान्युधिष्ठिर।\nदुर्बुद्धिर्हि कृता वीर तदा दैवेन रक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028115, "chapter_id": 1606, "verse_number": "३-२४४-१५", "content_sanskrit": "कालकूटविषं तीक्ष्णं भोजने मम भारत।\nउप्त्वा गङ्गां लतापाशैर्वैद्ध्वा च प्राक्षिपत्प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028116, "chapter_id": 1606, "verse_number": "३-२४४-१६", "content_sanskrit": "रसातलं च संप्राप्य तदा वासुकिमञ्जसा।\nतत्र दृष्ट्वा तु राजेन्द्रपुनः प्राप्तो महीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028117, "chapter_id": 1606, "verse_number": "३-२४४-१७", "content_sanskrit": "द्यूतकालेऽपिकौन्तेय वृजिनानि कृतनि वै।\nद्रौपद्याश्च पराभर्शः केशग्रहणमेव च।\nवस्त्रापहरणं चैव सभामध्ये कृतानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028118, "chapter_id": 1606, "verse_number": "३-२४४-१८", "content_sanskrit": "राज्यं चाच्छिद्य राजेन्द्र उक्तवान्परुषाणि नः।\nपुरा कृतानां पापानां फलं भुङ्क्ते सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028119, "chapter_id": 1606, "verse_number": "३-२४४-१९", "content_sanskrit": "अस्माबिरेवकर्तव्यं धार्तराष्ट्रस्य निग्रहम्।\nअन्येन तु कृतं तद्वै मैत्र्यमस्माकमिच्छता।\nउपकारी तु गन्धर्वो मा राजन्विमना भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028120, "chapter_id": 1606, "verse_number": "३-२४४-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028121, "chapter_id": 1606, "verse_number": "३-२४४-२०", "content_sanskrit": "एतस्मिन्नन्तरे राजंश्चित्रसेनेन वै हृतः।\nविललाप सुदुःखार्तो नीयमानः सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028122, "chapter_id": 1606, "verse_number": "३-२४४-२१", "content_sanskrit": "युधिष्ठिर महाबाहो सर्वधर्मभृतांवर।\nसपुत्रान्सहदारांश्च गन्धर्वेण हृतान्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028123, "chapter_id": 1606, "verse_number": "३-२४४-२२", "content_sanskrit": "पाण्डुपुत्र महाबाहो कौरवाणां यशस्कर\nसर्वधर्मभृतां श्रेष्ठ गन्धर्वेण हृतं बलात्।\nरक्षस्व पुरुषव्याघ्र युधिष्ठिर महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028124, "chapter_id": 1606, "verse_number": "३-२४४-२३", "content_sanskrit": "भ्रातरं ते महाबाहो बद्ध्वा नयति मामयम्।\nदुश्शासनं दुर्विषहं दुर्मुखं दुर्जयं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028125, "chapter_id": 1606, "verse_number": "३-२४४-२४", "content_sanskrit": "बद्ध्वा हरन्ति गन्धर्वा अस्मान्दारांश्च सर्वशः।\nअनुधावत मां क्षिप्रं रक्षध्वं पुरुषोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028126, "chapter_id": 1606, "verse_number": "३-२४४-२५", "content_sanskrit": "यमौ मामनुधावेतां रक्षार्थं मम सायुधौ।\nकुरुवंशस्य सुमहदयशः प्राप्तमीदृशम्।\nव्यपोहयध्वं गन्धर्वाञ्जित्वा वीर्येण पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028127, "chapter_id": 1606, "verse_number": "३-२४४-२६", "content_sanskrit": "एवं विलपमानस्य कौरवस्यार्तया गिरा।\nश्रुत्वा विलापं संभ्रान्तो घृणयाऽभिपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028128, "chapter_id": 1606, "verse_number": "३-२४४-२७", "content_sanskrit": "युधिष्ठिरः पुनर्वाक्यं भीमसेनमथाब्रवीत्।\nसुयोधनस्य मोक्षाय प्रयतध्वमतन्द्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028129, "chapter_id": 1606, "verse_number": "३-२४४-२८", "content_sanskrit": "क इवार्यो दयेत्प्राणानभिधावेति चोदितः।\nप्राञ्जलं शरणापन्नं दृष्ट्वा शत्रुमपि ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028130, "chapter_id": 1606, "verse_number": "३-२४४-२९", "content_sanskrit": "वरप्रदानं राज्यं च पुत्रजन्म च पाण्डवाः।\nशत्रोश्च मोक्षणं क्लेशास्त्रीणि चैकं च तत्समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028131, "chapter_id": 1606, "verse_number": "३-२४४-३०", "content_sanskrit": "न ह्यस्त्यधिकमेतस्माद्यदापन्नः सुयोधनः।\nत्वद्बाहुबलमाश्रित्य जीवितं परिमार्गते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028132, "chapter_id": 1606, "verse_number": "३-२४४-३१", "content_sanskrit": "स्वयमेव प्रधावेयं यदि न स्याद्वृकोदर।\nविततो मे क्रतुर्वीर न हि मेऽत्र विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028133, "chapter_id": 1606, "verse_number": "३-२४४-३२", "content_sanskrit": "साम्नैव तु यथा भीम मोक्षयेथाः सुयोधनम्।\nतथा सर्वैरुपायैस्त्वं यतेथाः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028134, "chapter_id": 1606, "verse_number": "३-२४४-३३", "content_sanskrit": "न साम्ना प्रतिपद्येत यदि गन्धर्वराडसौ।\nपराक्रमेण मृदुना मोक्षयेथाः सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028135, "chapter_id": 1606, "verse_number": "३-२४४-३४", "content_sanskrit": "अथासौ मृदुयुद्धेन न मुञ्चेद्भीम कौरवान्।\nसर्वोपायैर्पिमोच्यास्ते निगृह्य परिपन्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028136, "chapter_id": 1606, "verse_number": "३-२४४-३५", "content_sanskrit": "एतावद्धि मया शक्यं संदेष्टुं वै वृकोदर।\nवैताने कर्मणि तते वर्तमाने च भारत।\n`वरप्रदानं सुमहद्याचकस्य प्रकीर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028137, "chapter_id": 1606, "verse_number": "३-२४४-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2028138, "chapter_id": 1606, "verse_number": "३-२४४-३६", "content_sanskrit": "अजातसत्रोर्वचनं तच्छ्रुत्वा तु धनंजयः।\nप्रतिजज्ञे गुरोर्वाक्यं कौरवाणां विमोक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2028139, "chapter_id": 1606, "verse_number": "३-२४४-३७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2028140, "chapter_id": 1606, "verse_number": "३-२४४-३७", "content_sanskrit": "यदि ककसाम्ना न मोक्ष्यन्ति गन्धर्वा धृतराष्ट्रजान्।\nअद्य गन्धर्वराजस्य भूमिः पास्यति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2028141, "chapter_id": 1606, "verse_number": "३-२४४-३८", "content_sanskrit": "अर्जुनस्य तु तां श्रुत्वा प्रतिज्ञां सत्यवादिनः।\nकौरवाणां तदा राजन्पुनः प्रत्यागतं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2028142, "chapter_id": 1606, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि चतुश्चत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]