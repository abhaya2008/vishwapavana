[{"id": 2086326, "chapter_id": 2836, "verse_number": "१२-३४१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086327, "chapter_id": 2836, "verse_number": "१२-३४१-१", "content_sanskrit": "इत्येवमुक्त्वा वचनं ब्रह्मर्षिः सुमहातपाः।\nप्रातिष्ठत शुकः सिद्धिं हित्वा दोषांश्चतुर्विधान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086328, "chapter_id": 2836, "verse_number": "१२-३४१-२", "content_sanskrit": "तमो ह्यष्टगुणं हित्वा जहौ पञ्चविधं रजः।\nततः सत्वं जहौ धीमांस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086329, "chapter_id": 2836, "verse_number": "१२-३४१-३", "content_sanskrit": "ततस्तस्मिन्पदे नित्ये निर्गुणे लिङ्गवर्जिते।\nब्रह्मणि प्रत्यतिष्ठत्स विधूमोऽग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086330, "chapter_id": 2836, "verse_number": "१२-३४१-४", "content_sanskrit": "उत्कापाता दिशां दाहो भूमिकम्पस्तथैव च।\nप्रादुर्भूताः क्षणे तस्मिंस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086331, "chapter_id": 2836, "verse_number": "१२-३४१-५", "content_sanskrit": "द्रुमाः शाखाश्च मुमुचुः शिखराणि च पर्वताः।\nनिर्घातशब्दैर्गुरुभिर्भूमिर्व्यादीर्यतेव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086332, "chapter_id": 2836, "verse_number": "१२-३४१-६", "content_sanskrit": "न बभासे सहस्रांशुर्न जज्वाल च पावकः।\nह्रदाश्च सरितश्चैव चुक्षुभुः सागरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086333, "chapter_id": 2836, "verse_number": "१२-३४१-७", "content_sanskrit": "ववर्ष वासवस्तोयं रसवच्च सुगन्धि च।\nववौ समीरणश्चापि दिव्यगन्धवहः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086334, "chapter_id": 2836, "verse_number": "१२-३४१-८", "content_sanskrit": "स शृङ्गेऽप्रतिमे दिव्ये हिमवन्मेरुसंनिभे।\nसंश्लिष्टे स्वतेपीते द्वे रुक्मरूप्यमये शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086335, "chapter_id": 2836, "verse_number": "१२-३४१-९", "content_sanskrit": "शतयोजनविस्तारे तिर्यगूर्ध्वं च भारत।\nउदीचीं दिशमास्थाय रुचिरे संददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086336, "chapter_id": 2836, "verse_number": "१२-३४१-१०", "content_sanskrit": "सोऽविशङ्केन मनसा तथैवाभ्यपतच्छुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086337, "chapter_id": 2836, "verse_number": "१२-३४१-११", "content_sanskrit": "ततः पर्वतशृङ्गे द्वे सहसैव द्विधाकृते।\nअदृश्येतां महाराज तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086338, "chapter_id": 2836, "verse_number": "१२-३४१-१२", "content_sanskrit": "ततः पर्वतशृङ्गाभ्यां सहसैव विनिःसृतः।\nन च प्रतिजघानास्य स गतिं पर्वतोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086339, "chapter_id": 2836, "verse_number": "१२-३४१-१३", "content_sanskrit": "ततो महानभूच्छब्दो दिवि सर्वदिवौकसाम्।\nगन्धर्वाणामृषीणां च ये च शैलनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086340, "chapter_id": 2836, "verse_number": "१२-३४१-१४", "content_sanskrit": "दृष्ट्वा शुकमतिक्रान्तं पर्वतं च द्विधा कृतम्।\nसाधुसाध्विति तत्रासीन्नादः सर्वत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086341, "chapter_id": 2836, "verse_number": "१२-३४१-१५", "content_sanskrit": "स पूज्यमानो देवैश्च गन्धर्वैर्ऋशिभिस्तथा।\nयक्षराक्षससङ्घैश्च विद्याधरगणैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086342, "chapter_id": 2836, "verse_number": "१२-३४१-१६", "content_sanskrit": "दिव्यैः पुष्पैः समाकीर्णमन्तरिक्षं समन्ततः।\nआसीत्किल महाराज शुकाभिपतने तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086343, "chapter_id": 2836, "verse_number": "१२-३४१-१७", "content_sanskrit": "ततो मन्दाकिनीं रम्यामुपरिष्टादभिव्रजन्।\nशुको ददर्श धर्मात्मा पुष्पितद्रुमकाननाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086344, "chapter_id": 2836, "verse_number": "१२-३४१-१८", "content_sanskrit": "तस्यां क्रीडन्त्यभिरताः स्नान्ति चैवाप्सरोगणाः।\nशून्याकारं निराकाराः शुकं दृष्ट्वा विवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086345, "chapter_id": 2836, "verse_number": "१२-३४१-१९", "content_sanskrit": "तं प्रक्रामन्तमाज्ञाय पिता स्नेहसमन्वितः।\nउत्तमां गतिमास्थाय पृष्ठतोऽनुससार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086346, "chapter_id": 2836, "verse_number": "१२-३४१-२०", "content_sanskrit": "शुकस्तु मारुतादूर्ध्वं गतिं कृत्वान्तरिक्षगाम्।\nदर्शयित्वा प्रभावं स्वं सर्वभूतोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086347, "chapter_id": 2836, "verse_number": "१२-३४१-२१", "content_sanskrit": "महायोगगतिं त्वग्र्यां व्यासोत्थाय महातपाः।\nनिमेषान्तरमात्रेण शुकाभिपतनं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086348, "chapter_id": 2836, "verse_number": "१२-३४१-२२", "content_sanskrit": "स ददर्श द्विधा कृत्वा पर्वताग्रं शुकं गतम्।\nशशंसुर्ऋषयस्तत्र कर्म पुत्रस्य तत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086349, "chapter_id": 2836, "verse_number": "१२-३४१-२३", "content_sanskrit": "ततः शुकेति दीर्घेण शब्देनाक्रन्दितस्तदा।\nस्वयं पित्रा स्वरेणोच्चैस्त्रील्लोँकाननुनाद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086350, "chapter_id": 2836, "verse_number": "१२-३४१-२४", "content_sanskrit": "शुकः सर्वगतो भूत्वा सर्वात्मा सर्वतोमुखः।\nप्रत्यभाषत धर्मात्मा भोःशब्देनानुनादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086351, "chapter_id": 2836, "verse_number": "१२-३४१-२५", "content_sanskrit": "तत एकाक्षरं नादं भोरित्येव समीरयन्।\nप्रत्याहरञ्जगत्सर्वमुच्चैः स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086352, "chapter_id": 2836, "verse_number": "१२-३४१-२६", "content_sanskrit": "ततःप्रभृति चाद्यापि शब्दानुच्चारितान्पृथक्।\nगिरिगह्वरपृष्ठेषु व्याहरन्ति शुकं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086353, "chapter_id": 2836, "verse_number": "१२-३४१-२७", "content_sanskrit": "अन्तर्हितः प्रभावं तु दर्शयित्वा शुकस्तदा।\nगुणान्संत्यज्य शब्दादीन्पदमभ्यगमत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086354, "chapter_id": 2836, "verse_number": "१२-३४१-२८", "content_sanskrit": "महिमानं तु तं दृष्ट्वा पुत्रस्यामिततेजसः।\nनिषसाद गिरिप्रस्थे पुत्रमेवानुचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086355, "chapter_id": 2836, "verse_number": "१२-३४१-२९", "content_sanskrit": "ततो मन्दाकिनीतीरे क्रीडन्तोऽऽप्सरसां गणाः।\nआसाद्य तमृषिं सर्वाः संभ्रान्ता गतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086356, "chapter_id": 2836, "verse_number": "१२-३४१-३०", "content_sanskrit": "जले निलिल्यिरे काश्चित्काश्चिद्गुल्मान्प्रपेदिरे।\nवसनान्याददुः काश्चित्तं दृष्ट्वा मुनिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086357, "chapter_id": 2836, "verse_number": "१२-३४१-३१", "content_sanskrit": "तां मुक्ततां तु विज्ञाय मुनिः पुत्रस्य वै तदा।\nसक्ततामात्मनश्चैव प्रीतोऽभूद्बीडितश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086358, "chapter_id": 2836, "verse_number": "१२-३४१-३२", "content_sanskrit": "तं देवगन्धर्ववृतो महर्षिगणपूजितः।\nपिनाकहस्तो भगवानभ्यागच्छत शंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086359, "chapter_id": 2836, "verse_number": "१२-३४१-३३", "content_sanskrit": "तमुवाच महादेवः सान्त्वपूर्वमिदं वचः।\nपुत्रशोकाभिसंतप्तं कृष्णद्वैपायनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086360, "chapter_id": 2836, "verse_number": "१२-३४१-३४", "content_sanskrit": "अग्नेर्भूमेरपां वायोरन्तरिक्षस्य चैव ह।\nवीर्येण सदृशः पुत्रः पुरा मत्तस्त्वया वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086361, "chapter_id": 2836, "verse_number": "१२-३४१-३५", "content_sanskrit": "स तथालक्षणो जातस्तपसा तव संभृतः।\nमम चैव प्रसादेन ब्रह्मतेजोमयः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086362, "chapter_id": 2836, "verse_number": "१२-३४१-३६", "content_sanskrit": "स गतिं परमां प्राप्तो दुष्प्रापामजितेन्द्रियैः।\nदैवतैरपि विप्रर्षे तं त्वं किमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086363, "chapter_id": 2836, "verse_number": "१२-३४१-३७", "content_sanskrit": "यावत्स्थास्यन्ति गिरयो यावत्स्थास्यन्ति सागराः।\nतावत्तवाक्षया कीर्तिः सपुत्रस्य भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086364, "chapter_id": 2836, "verse_number": "१२-३४१-३८", "content_sanskrit": "छायां स्वपुत्रसदृशीं सर्वतोऽनपगां सदा।\nद्रक्ष्यसे त्वं च लोकेऽस्मिन्मत्प्रसादान्महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086365, "chapter_id": 2836, "verse_number": "१२-३४१-३९", "content_sanskrit": "सोऽनुगीतो भगवता स्वयं रुद्रेण भारत।\nछायां पश्यन्परावृत्तः स मुनिः परया मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086366, "chapter_id": 2836, "verse_number": "१२-३४१-४०", "content_sanskrit": "इति जन्म गतिश्चैव शुकस्य भरतर्षभ।\nविस्तरेण समाख्याता यन्मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086367, "chapter_id": 2836, "verse_number": "१२-३४१-४१", "content_sanskrit": "एतदाचष्ट मे राजन्देवर्षिर्नारदः पुरा।\nव्यासश्चैव महायोगी संजल्पेषु पदेपदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086368, "chapter_id": 2836, "verse_number": "१२-३४१-४२", "content_sanskrit": "इतिहासमिमं पुण्यं मोक्षधर्मार्थसंहितम्।\nधारयेद्यः शमपरः स गच्छेत्परमां गतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086369, "chapter_id": 2836, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकचत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]