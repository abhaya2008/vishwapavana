[{"id": 7004213000, "chapter_id": 24213, "verse_number": "५-१-६२-१", "content_sanskrit": "व्यास उवाच ।\nगोमतीकुण्डं त्वया प्रोक्तं पुरा ब्रह्मन्सनातनम् ।\nकस्मिन्काले कदा जातं तन्नो वद सुविस्तरात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004213001, "chapter_id": 24213, "verse_number": "५-१-६२-२", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणुष्व भो महाप्राज्ञ कथां पापहरां पराम् ।\nगोमतीकुण्डोद्भवां पुण्यां पुरा रुद्रेण भाषिताम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004213002, "chapter_id": 24213, "verse_number": "५-१-६२-३", "content_sanskrit": "नैमिषे च समासीना ऋषयः शौनकादयः ।\nकथयंति कथां पुण्यां सर्वतीर्थोद्भवां शुभाम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004213003, "chapter_id": 24213, "verse_number": "५-१-६२-४", "content_sanskrit": "तस्मिन्नवसरे पुण्ये काशीमाहात्म्यमुत्तमम् ।\nकथितं नारदेनैव पवित्रं पापहारकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004213004, "chapter_id": 24213, "verse_number": "५-१-६२-५", "content_sanskrit": "ऊषरः पुण्य पापानां धन्या वाराणसी पुरी ।\nध्रुवं लभंते मोक्षं च समं चंडालपंडिताः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004213005, "chapter_id": 24213, "verse_number": "५-१-६२-६", "content_sanskrit": "असीवरुणयोर्मध्ये पंचक्रोशी महाफलम् ।\nअमरा मरणमिच्छन्ति का कथा इतरे जनाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004213006, "chapter_id": 24213, "verse_number": "५-१-६२-७", "content_sanskrit": "इति स्मृत्वा तदा व्यास स्वयंभूः प्रत्यभाषत ।\nशृण्वतां सर्वदेवानामृषीणां च परंतप॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004213007, "chapter_id": 24213, "verse_number": "५-१-६२-८", "content_sanskrit": "नदी न गोमतीतुल्या कृष्णतुल्या न देवता ।\nसर्वपातालभूमध्ये न द्वारकासमा पुरी॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004213008, "chapter_id": 24213, "verse_number": "५-१-६२-९", "content_sanskrit": "इति ते निश्चयं ज्ञात्वा ऋषयः शौनकादयः ।\nयत्र तत्र स्थिताः सर्वे प्रातःसंध्यामुपासितुम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004213009, "chapter_id": 24213, "verse_number": "५-१-६२-१०", "content_sanskrit": "तत्रैव गोमतीतीरे चक्रुस्ते ला धृतव्रताः ।\nसांदीपनोऽपि तत्रैव प्रातःसंध्यां समाचरत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004213010, "chapter_id": 24213, "verse_number": "५-१-६२-११", "content_sanskrit": "एवं बहुतिथे काले चरतस्तस्य वै व्रतम् ।\nसांदीपनस्य वै व्यास ह्यवंतीपुरवासिनः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004213011, "chapter_id": 24213, "verse_number": "५-१-६२-१२", "content_sanskrit": "तस्यैव कामपूर्त्यर्थं विद्यार्थिनौ रामजनार्दनौ ।\nसमायातौ सुकुमारांगौ सततं ब्रह्मचारिणौ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004213012, "chapter_id": 24213, "verse_number": "५-१-६२-१३", "content_sanskrit": "निवासं चक्रतुस्तस्य गुरोर्गेहे परंतप ।\nतस्य पाठयतः सम्यग्विद्यां सर्वश्रुतीः परम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004213013, "chapter_id": 24213, "verse_number": "५-१-६२-१४", "content_sanskrit": "उषस्युषसि तत्रैव दृश्यते न तदा गुरुः ।\nविद्योपदेशकालोऽयं क्व गतो नौ गुरुर्वरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004213014, "chapter_id": 24213, "verse_number": "५-१-६२-१५", "content_sanskrit": "इति पृष्टे तयोरेवं गुरुपत्नी ह्युवाच ह ।\nसदैव कुरुते वत्स प्रातःसंध्याद्युपास नम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004213015, "chapter_id": 24213, "verse_number": "५-१-६२-१६", "content_sanskrit": "तत्रैव याति वै नित्यं गुरुस्ते स्नानकारणात् ।\nगोमती वै सरिच्छ्रेष्ठा द्वारकायां च पावनी॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004213016, "chapter_id": 24213, "verse_number": "५-१-६२-१७", "content_sanskrit": "इति श्रुत्वा तदा कृष्णो रामेण सह संयुतः ।\nकिं कर्तव्यमिहास्माभिरात्मनो हितमुत्तमम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004213017, "chapter_id": 24213, "verse_number": "५-१-६२-१८", "content_sanskrit": "गुरोरागमनं कांक्षे अत्रैव स्थितिकांक्षया ।\nएतस्मिन्नेव काले तु सांदीपनिरगा द्गृहम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004213018, "chapter_id": 24213, "verse_number": "५-१-६२-१९", "content_sanskrit": "तत उत्थाय तौ वीरौ गुरोरावंदनं ततः ।\nप्रश्रयावनतौ कृत्वा ह्यब्रूतां वचनं गुरुम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004213019, "chapter_id": 24213, "verse_number": "५-१-६२-२०", "content_sanskrit": "श्रूयतां भो महायोगिन्नस्माकं वासकार णम् ।\nविद्यार्थिनाविह प्राप्तौ युष्माकं च गृहोत्तमे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004213020, "chapter_id": 24213, "verse_number": "५-१-६२-२१", "content_sanskrit": "प्रातःकाले च ते ब्रह्मन्समयो नास्ति नौ प्रभो ।\nएतच्छुत्वा वचस्तस्य कृष्णस्य च बलस्य च॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004213021, "chapter_id": 24213, "verse_number": "५-१-६२-२२", "content_sanskrit": "उवाच भगवान्व्यास आत्मनो व्रतकारणम् ।\nअस्माकं परमं वत्स व्रतं वै शाश्वतं मतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004213022, "chapter_id": 24213, "verse_number": "५-१-६२-२३", "content_sanskrit": "गोमतीस्नानं कर्तव्यं प्रातःकाले सदा बुधैः ।\nतत्रैवोपासनं पुण्यं संध्याया इति निश्चितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004213023, "chapter_id": 24213, "verse_number": "५-१-६२-२४", "content_sanskrit": "इति निश्चित्य युष्माभिर्यद्योग्यं क्रियतां तथा ।\nतच्छ्रुत्वा भगवान्विष्णुर्मायामानुषरूपवान्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004213024, "chapter_id": 24213, "verse_number": "५-१-६२-२५", "content_sanskrit": "गोमत्याराधनं चक्रे कुशस्थल्यां द्विजोत्तम ।\nयत्र शिवेश्वरो देवो यज्ञकुण्डमनुत्तमम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004213025, "chapter_id": 24213, "verse_number": "५-१-६२-२६", "content_sanskrit": "कंथडेश्वरस्योत्तरे भागे गोमती सा समागता ।\nपातालतलमाभेद्य सरस्वत्या सहागता॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004213026, "chapter_id": 24213, "verse_number": "५-१-६२-२७", "content_sanskrit": "प्रातरुत्थाय ते सर्वे गोमतीं सरितां वराम् ।\nददृशुः सुचिरापांगीं व्यास स्वाश्रमगामिनीम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004213027, "chapter_id": 24213, "verse_number": "५-१-६२-२८", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअत्रैव चागता ब्रह्मन्गोमती सरितांवरा ।\nस्नानदानादिकं सर्वमत्रैव समुपासय॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004213028, "chapter_id": 24213, "verse_number": "५-१-६२-२९", "content_sanskrit": "गोमत्यत्र समालीना यज्ञकुण्डे सरस्वती ।\nतदाप्रभृति लोकेऽस्मिन्गोमतीकुण्डमुच्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004213029, "chapter_id": 24213, "verse_number": "५-१-६२-३०", "content_sanskrit": "सर्वेषामपि लोकानां मार्गोऽ त्रैव च विद्यते ।\nतस्माद्व्यास महापुण्यं भुवि तीर्थमनुत्तमम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004213030, "chapter_id": 24213, "verse_number": "५-१-६२-३१", "content_sanskrit": "गोमतीकुण्डमाख्यातं सर्वपापप्रणानशनम् ।\nभाद्रे मास्यसिताऽष्टम्यां कृष्ण जन्मसमुद्भवम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004213031, "chapter_id": 24213, "verse_number": "५-१-६२-३२", "content_sanskrit": "तत्र स्नात्वा नरो नित्यं रात्रौ जागरणं चरेत् ।\nउपोष्य विधिवद्व्यास सशिष्यं व्यासमर्चयेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004213032, "chapter_id": 24213, "verse_number": "५-१-६२-३३", "content_sanskrit": "वैष्णवांश्च नरांश्चैव कृष्णजन्मोत्सुकान्वरान् ।\nनानासुगंधपुष्पाद्यैर्वस्त्रालंकारसंयुतैः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004213033, "chapter_id": 24213, "verse_number": "५-१-६२-३४", "content_sanskrit": "गोब्राह्मणानां पूजाश्च क्रियते यैः समाहितैः ।\nन तेषां दुर्लभं किंचित्सर्वलोकेषु विद्यते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004213034, "chapter_id": 24213, "verse_number": "५-१-६२-३५", "content_sanskrit": "गोमतीस्नानजात्पुण्याद्वासुदेवसमागमात् ।\nमनोरथफलप्राप्तिर्जायते नाऽत्र संशयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004213035, "chapter_id": 24213, "verse_number": "५-१-६२-३६", "content_sanskrit": "तथा चैत्रसिते पक्षे यावच्चैकादशी भवेत् ।\nतद्दिने च नरः स्नात्वा गोमत्यां च विशेषतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004213036, "chapter_id": 24213, "verse_number": "५-१-६२-३७", "content_sanskrit": "रात्रौ जागरणं कृत्वा विष्णुपूजां तथैव च ।\nआमलकीं ततो गत्वा प्रदक्षिणात्पदेपदे॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004213037, "chapter_id": 24213, "verse_number": "५-१-६२-३८", "content_sanskrit": "गोसहस्रफलं तेषां प्राप्यते नाऽत्र संशयः ।\nये शृण्वंति कथां पुण्यां पवित्रां पापहारिणीम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004213038, "chapter_id": 24213, "verse_number": "५-१-६२-३९", "content_sanskrit": "सर्वपापविनिर्मुक्ता विष्णुलोकं प्रयांति ते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]