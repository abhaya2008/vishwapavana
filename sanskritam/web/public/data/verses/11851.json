[{"id": 50024343, "chapter_id": 11851, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। ऋभवः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024344, "chapter_id": 11851, "verse_number": "2", "content_sanskrit": "अ॒यं दे॒वाय॒ जन्म॑ने॒ स्तोमो॒ विप्रे॑भिरास॒या। अका॑रि रत्न॒धात॑मः॥ २०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024345, "chapter_id": 11851, "verse_number": "3", "content_sanskrit": "य इन्द्रा॑य वचो॒युजा॑ तत॒क्षुर्मन॑सा॒ हरी॑। शमी॑भिर्य॒ज्ञमा॑शत॥ २०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024346, "chapter_id": 11851, "verse_number": "4", "content_sanskrit": "तक्ष॒न्नास॑त्याभ्यां॒ परि॑ज्मानं सु॒खं रथ॑म्। तक्ष॑न्धे॒नुं स॑ब॒र्दुघा॑म्॥ २०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024347, "chapter_id": 11851, "verse_number": "5", "content_sanskrit": "युवा॑ना पि॒तरा॒ पुन॑ः स॒त्यम॑न्त्रा ऋजू॒यव॑ः। ऋ॒भवो॑ वि॒ष्ट्य॑क्रत॥ २०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024348, "chapter_id": 11851, "verse_number": "6", "content_sanskrit": "सं वो॒ मदा॑सो अग्म॒तेन्द्रे॑ण च म॒रुत्व॑ता। आ॒दि॒त्येभि॑श्च॒ राज॑भिः॥ २०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024349, "chapter_id": 11851, "verse_number": "7", "content_sanskrit": "उ॒त त्यं च॑म॒सं नवं॒ त्वष्टु॑र्दे॒वस्य॒ निष्कृ॑तम्। अक॑र्त च॒तुर॒ः पुन॑ः॥ २०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024350, "chapter_id": 11851, "verse_number": "8", "content_sanskrit": "ते नो॒ रत्ना॑नि धत्तन॒ त्रिरा साप्ता॑नि सुन्व॒ते। एक॑मेकं सुश॒स्तिभि॑ः॥ २०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024351, "chapter_id": 11851, "verse_number": "9", "content_sanskrit": "अधा॑रयन्त॒ वह्न॒योऽभ॑जन्त सुकृ॒त्यया॑। भा॒गं दे॒वेषु॑ य॒ज्ञिय॑म्॥ २०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]