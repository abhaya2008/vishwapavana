[{"id": 2041869, "chapter_id": 1932, "verse_number": "५-१७७-०x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041870, "chapter_id": 1932, "verse_number": "५-१७७-१", "content_sanskrit": "दुःख द्वयोरिदं भद्रे कतरस्य चिकीर्षसि।\nप्रतिकर्तव्यमबले तत्त्वं वत्से वदस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041871, "chapter_id": 1932, "verse_number": "५-१७७-२", "content_sanskrit": "यदि सौभपतिर्भद्रे नियोक्तव्यो मतस्तव ।\nनियोक्ष्यति महात्मा स रामस्त्वद्धितकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041872, "chapter_id": 1932, "verse_number": "५-१७७-३", "content_sanskrit": "अथापगेयं भीष्मं त्वं रामेणेच्छसि धीमता ।\nरणे विनिर्जितं द्रष्टुं कुर्यात्तदपि भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041873, "chapter_id": 1932, "verse_number": "५-१७७-४", "content_sanskrit": "सृञ्जयस्य वचः श्रुत्वा तव चैव शुचिस्मिते।\nयदत्र ते भृशं कार्यं तदद्यैव विचिन्त्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041874, "chapter_id": 1932, "verse_number": "५-१७७-५x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041875, "chapter_id": 1932, "verse_number": "५-१७७-५", "content_sanskrit": "अपनीतास्मि भीष्मेण भगवन्नविजानता।\nनाभिजानाति मे भीष्मो ब्रह्मन्साल्वगतं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041876, "chapter_id": 1932, "verse_number": "५-१७७-६", "content_sanskrit": "एतद्विचार्य मनसा भवानेतद्विनिश्चयम्।\nविचिनोतु यथान्यायं विधानं क्रियतां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041877, "chapter_id": 1932, "verse_number": "५-१७७-७", "content_sanskrit": "भीष्मे वा कुरुशार्दूले शाल्वराजेऽथवा पुनः।\nउभयोरेव वा ब्रह्मन्युक्तं यत्तत्समाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041878, "chapter_id": 1932, "verse_number": "५-१७७-८", "content_sanskrit": "निवेदितं मया ह्येतद्दुःखमूलं यथातथम् ।\nविधानं तत्र भगवन्कर्तुमर्हसि युक्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041879, "chapter_id": 1932, "verse_number": "५-१७७-९x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041880, "chapter_id": 1932, "verse_number": "५-१७७-९", "content_sanskrit": "उपपदमिदं भद्रे यदेवं वरवर्णिनि ।\nधर्मं प्रतिवचो ब्रूयाः श्रृणु चदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041881, "chapter_id": 1932, "verse_number": "५-१७७-१०", "content_sanskrit": "यदि त्वामापगेयो वै न नयेद्गजसाह्वयम् ।\nसाल्वस्त्वा शिरसा भीरु गृह्णीयाद्रामचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041882, "chapter_id": 1932, "verse_number": "५-१७७-११", "content_sanskrit": "तेन त्वं निर्जिता भद्रे यस्मान्नीतासि भामिनि ।\nसंशयः साल्वराजस्य तेन त्वयि सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041883, "chapter_id": 1932, "verse_number": "५-१७७-१२", "content_sanskrit": "भीष्मः पुरुषमानी च जितकाशी तथैव च।\nतस्मात्प्रतिक्रिया युक्ता भीष्मे कारयितुं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041884, "chapter_id": 1932, "verse_number": "५-१७७-१३x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041885, "chapter_id": 1932, "verse_number": "५-१७७-१३", "content_sanskrit": "ममाप्येष सदा ब्रह्मन्हृदि कामोऽभिवर्तते।\nघातयेयं यदि रणे भीष्ममित्येव नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041886, "chapter_id": 1932, "verse_number": "५-१७७-१४", "content_sanskrit": "भीष्मं वा साल्वराजं वा यं वा दोषेण गच्छसि ।\nप्रशाधि तं महाबाहोयत्कृतेऽहं सुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041887, "chapter_id": 1932, "verse_number": "५-१७७-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041888, "chapter_id": 1932, "verse_number": "५-१७७-१५", "content_sanskrit": "एवं कथयतामेव तेषां स दिवसो गतः ।\nरात्रिश्च भरतश्रेष्ठ सुखशीतोष्णमारुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041889, "chapter_id": 1932, "verse_number": "५-१७७-१६", "content_sanskrit": "ततो रामः प्रादुरासीत्प्रज्वलन्निव तेजसा ।\nशिष्यैः परिवृतो राजञ्जटाचीरधरो मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041890, "chapter_id": 1932, "verse_number": "५-१७७-१७", "content_sanskrit": "धनुष्पाणिरदीनात्मा खङ्गं बिभ्रत्परश्वधी ।\nविरजा राजशार्दूल सृञ्जयं सोऽभ्ययान्नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041891, "chapter_id": 1932, "verse_number": "५-१७७-१८", "content_sanskrit": "ततस्तं तापसा दृष्ट्वा स च राजा महातपाः ।\nतस्थुः प्राञ्जलयो राजन्सा च कन्या तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041892, "chapter_id": 1932, "verse_number": "५-१७७-१९", "content_sanskrit": "पूजयामासुरव्यग्रा मधुपर्केण भार्गवम्।\nअर्चितश्च यथान्यायं निषसाद सहैव तैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041893, "chapter_id": 1932, "verse_number": "५-१७७-२०", "content_sanskrit": "ततः पूर्वव्यतीतानि कथयन्तौ स्म तावुभौ ।\nआसातां जामदग्न्यश्च सृञ्जयश्चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041894, "chapter_id": 1932, "verse_number": "५-१७७-२१", "content_sanskrit": "तथा कथान्ते राजर्षिर्भृगुश्रेष्ठं महाबलम् ।\nउवाच मधुरं काले रामं वचनमर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041895, "chapter_id": 1932, "verse_number": "५-१७७-२२", "content_sanskrit": "रामेयं मम दौहित्री काशिराजसुता प्रभो ।\nअस्याः श्रृणु यथातत्त्वं कार्यं कार्यविशारद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041896, "chapter_id": 1932, "verse_number": "५-१७७-२३", "content_sanskrit": "परमं कथ्यतां चेति तां रामः प्रत्यभाषत ।\nततः साभ्यवदद्रामं ज्वलन्तमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041897, "chapter_id": 1932, "verse_number": "५-१७७-२४", "content_sanskrit": "ततोऽभिवाद्य चरणौ रामस्य शिरसा शुभौ ।\nस्पृष्ट्वा पद्मदलाभाभ्यां पाणिभ्यामग्रतः स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041898, "chapter_id": 1932, "verse_number": "५-१७७-२५", "content_sanskrit": "रुरोद सा शोकवती बाष्पव्याकुललोचना।\nप्रपेदे शरणं चैव शरण्यं भृगुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041899, "chapter_id": 1932, "verse_number": "५-१७७-२६x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041900, "chapter_id": 1932, "verse_number": "५-१७७-२६", "content_sanskrit": "यथा त्वं सृंजयस्यास्य तथा मे त्वं नृपात्मजे ।\nब्रूहि यत्ते मनोदुःखं करिष्ये वचनं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041901, "chapter_id": 1932, "verse_number": "५-१७७-२७x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041902, "chapter_id": 1932, "verse_number": "५-१७७-२७", "content_sanskrit": "भगवञ्शरणं त्वाद्य प्रपन्नाऽस्मि महाव्रतम् ।\nशोकपङ्कार्णवान्मग्नं घोरादुद्धर मां विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041903, "chapter_id": 1932, "verse_number": "५-१७७-२८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041904, "chapter_id": 1932, "verse_number": "५-१७७-२८", "content_sanskrit": "तस्याश्च दृष्ट्वा रूपं च वपुश्चाभिनवं पुनः।\nसौकुमार्यं परं चैव रामश्चिन्तापरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041905, "chapter_id": 1932, "verse_number": "५-१७७-२९", "content_sanskrit": "किमियं वक्ष्यतीत्येवं विममर्श भृगूद्वहः।\nइति दध्यौ चिरं रामः कृपयाभिपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041906, "chapter_id": 1932, "verse_number": "५-१७७-३०", "content_sanskrit": "कथ्यतामिति सा भूयो रामेणोक्ता शुचिस्मिता।\nसर्वमेव यथातत्त्वं कथयामास भार्गवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041907, "chapter_id": 1932, "verse_number": "५-१७७-३१", "content_sanskrit": "तच्छुत्वा जामदग्र्यस्तु राजपुत्र्या वचस्तदा ।\nउवाच तां वरारोहां निश्चित्यार्थविनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041908, "chapter_id": 1932, "verse_number": "५-१७७-३२x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041909, "chapter_id": 1932, "verse_number": "५-१७७-३२", "content_sanskrit": "प्रेषयिष्यामि भीष्माय कुरुश्रेष्ठाय भामिनि ।\nकरिष्यति वचो मह्यं श्रुत्वा च स नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041910, "chapter_id": 1932, "verse_number": "५-१७७-३३", "content_sanskrit": "न चेत्करिष्यति वचो मयोक्तं जाह्नवीसुतः।\nधक्ष्याम्यहं रणे भद्रे सामात्यं शस्त्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041911, "chapter_id": 1932, "verse_number": "५-१७७-३४", "content_sanskrit": "अथवा ते मतिस्तत्र राजपुत्रि न वर्तते।\nयावत्साल्वपतिं वीरं योजयाम्यत्र कर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041912, "chapter_id": 1932, "verse_number": "५-१७७-३५x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041913, "chapter_id": 1932, "verse_number": "५-१७७-३५", "content_sanskrit": "विसर्जिताऽहं भीष्मेण श्रुत्वैव भृगुनन्दन।\nसाल्वराजगतं भावं मम पूर्वं मनीषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041914, "chapter_id": 1932, "verse_number": "५-१७७-३६", "content_sanskrit": "सौभराजमुपेत्याहमवोचं दुर्वचं वचः।\nन च मां प्रत्यगृह्णात्स चारित्र्यपरिशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2041915, "chapter_id": 1932, "verse_number": "५-१७७-३७", "content_sanskrit": "एतत्सर्वं विनिश्चित्य स्वबुद्ध्या भृगुनन्दन ।\nयदत्रौपयिकं कार्यं तच्चिन्तयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2041916, "chapter_id": 1932, "verse_number": "५-१७७-३८", "content_sanskrit": "मम तु व्यसनस्यास्य भीष्मो मूलं महाव्रतः।\nयेनाहं वशमानीता समत्क्षिप्य बलात्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2041917, "chapter_id": 1932, "verse_number": "५-१७७-३९", "content_sanskrit": "भीष्मं जहि महाबाहो यत्कृते दुःखमीदृशम् ।\nप्राप्ताहं भृगुशार्दूल चराम्यप्रियमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2041918, "chapter_id": 1932, "verse_number": "५-१७७-४०", "content_sanskrit": "स हि लुब्धश्च नीचश्च जितकाशी च भार्गव ।\nतस्मात्प्रतिक्रिया कर्तुं युक्ता तस्मै त्वयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2041919, "chapter_id": 1932, "verse_number": "५-१७७-४१", "content_sanskrit": "एष मे ह्रियमाणाया भारतेन तदा विभो।\nअभवद्धृदि संकल्पो घातयेदं महाव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2041920, "chapter_id": 1932, "verse_number": "५-१७७-४२", "content_sanskrit": "तस्मात्कामं ममाद्येमं राम संपादयानघ।\nजहि भीष्मं महाबाहो यथा वृत्रं पुरन्दरः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2041921, "chapter_id": 1932, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि सप्तसप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]