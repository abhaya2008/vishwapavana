[{"id": 2093811, "chapter_id": 3005, "verse_number": "१३-१३५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकिंस्विद्दत्तं पितृभ्यो वै भवत्यक्षयमीश्वरः।\nकिंस्विद्वहुफलं प्रोक्तं किमानन्त्याय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093812, "chapter_id": 3005, "verse_number": "१३-१३५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093813, "chapter_id": 3005, "verse_number": "१३-१३५-२", "content_sanskrit": "हवींषि श्राद्धकल्पे तु यानि श्राद्धविदो विदुः।\nतानि मे शृणु काम्यानि फलं चैषां युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093814, "chapter_id": 3005, "verse_number": "१३-१३५-३", "content_sanskrit": "तिलैर्व्रीहियवैर्माषैरद्भिर्मूलफलैस्तथा।\nदत्तेन मासं प्रीयन्ते श्राद्धेन पितरो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093815, "chapter_id": 3005, "verse_number": "१३-१३५-४", "content_sanskrit": "वर्धमानतिलं श्राद्धमक्षयं मनुरब्रवीत्।\nसर्वेष्वेव तु भोज्येषु तिलाः प्राधान्यतः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093816, "chapter_id": 3005, "verse_number": "१३-१३५-५", "content_sanskrit": "द्वौ मासौ तु भवेत्तुप्तिर्मत्स्यैः तितृगणस्य ह।\nत्रीन्मासानाविकेनाहुश्चतुर्मासं शशेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093817, "chapter_id": 3005, "verse_number": "१३-१३५-६", "content_sanskrit": "आजेन मासान्प्रीयन्ते पञ्चैव पितरो नृप।\nवाराहेण तु षण्मासान्सप्त वै शाकुलेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093818, "chapter_id": 3005, "verse_number": "१३-१३५-७", "content_sanskrit": "मासानष्टौ पार्षतेन रौरवेण नव प्रभो।\nगवयस्य तु मांसेन तृप्तिः स्याद्दशमासिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093819, "chapter_id": 3005, "verse_number": "१३-१३५-८", "content_sanskrit": "मांसेनेकादश प्रीतिः पितॄणां माहिषेण तु।\nगव्येन दत्ते श्राद्धे तु संवत्सरमिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093820, "chapter_id": 3005, "verse_number": "१३-१३५-९", "content_sanskrit": "यथा गव्यं तथा युक्तं पायसं सर्पिषा सह।\nवाध्रीणसस्य मांसेन तृप्तिर्द्वादशवार्षिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093821, "chapter_id": 3005, "verse_number": "१३-१३५-१०", "content_sanskrit": "आन्त्याय भवेद्दतं खङ्गमांसं पितृक्षते।\nकालशाकं च लौहं चाप्यानन्त्यं छाग उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093822, "chapter_id": 3005, "verse_number": "१३-१३५-११", "content_sanskrit": "गाथाश्चाप्यत्र गायन्ति पितृगीता युधिष्ठिर।\nसनत्कुमारो भगवान्पुरा मध्यभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093823, "chapter_id": 3005, "verse_number": "१३-१३५-१२", "content_sanskrit": "अपि नः स्वकुले जायाद्यो नो दद्यात्त्रयोदशीम्।\nमघासु सर्पिःसंयुक्तं पायसं दक्षिणायने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093824, "chapter_id": 3005, "verse_number": "१३-१३५-१३", "content_sanskrit": "आजेन वाऽपि लौहेन मघास्वेव यतव्रतः।\nहस्तिच्छायासु विधिवत्कर्णव्यजनवीजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093825, "chapter_id": 3005, "verse_number": "१३-१३५-१४", "content_sanskrit": "एष्टव्या बहवः पुत्रा यद्येकोपि गयां व्रजेत्।\nयत्रासौ प्रथितो लोकेष्वक्ष्यकरणो वटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093826, "chapter_id": 3005, "verse_number": "१३-१३५-१५", "content_sanskrit": "आपो मूलं फलं मांसमन्नं वाऽपि पितृक्षये।\nयत्किञ्चिन्मधुसंमिश्रं तदानन्त्याय कल्पते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093827, "chapter_id": 3005, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चत्रिंशदधिकशततमोऽध्यायः॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]