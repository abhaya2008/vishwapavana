[{"id": 7001676000, "chapter_id": 21676, "verse_number": "१-६२-१", "content_sanskrit": "सूत उवाच ।\nएतच्छ्रृत्वा तु वचनं नारदो भगवानृषिः ।\nपुनः पप्रच्छ तं विप्र शुकाभिपतनं मुनिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001676001, "chapter_id": 21676, "verse_number": "१-६२-२", "content_sanskrit": "नारद उवाच ।\nभगवन्सर्वमाख्यातं त्वयाऽतिकरुणात्मना ।\nयच्छ्रृत्वा मानसं मेऽद्य शांतिमग्र्यामुपागतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001676002, "chapter_id": 21676, "verse_number": "१-६२-३", "content_sanskrit": "पुनश्च मोक्षशास्त्रं मे त्वमादिश महामुने ।\nनहि सम्पूर्णतामेति तृष्णा कृष्णगुणार्णवे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001676003, "chapter_id": 21676, "verse_number": "१-६२-४", "content_sanskrit": "ये तु संसारनिर्मुक्ता मोक्ष शास्त्रपरायणाः ।\nकुत्र ते निवसंतीह संशयो मे महानयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001676004, "chapter_id": 21676, "verse_number": "१-६२-५", "content_sanskrit": "तं छिन्धि सुमहाभागत्वत्तो नान्यो विदांवरः ।\nसनं.उ. ।\nधारयामास चात्मानं यथाशास्त्रं महामुनिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001676005, "chapter_id": 21676, "verse_number": "१-६२-६", "content_sanskrit": "पादात्प्रभृति गात्रेषु क्रमेण क्रमयोगवित् ।\nततः स प्राङ्मुखो विद्वानादित्येन विरोचिते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001676006, "chapter_id": 21676, "verse_number": "१-६२-७", "content_sanskrit": "पाणिपादं समाधाय विनीतवदुपाविशत् ।\nन तत्र पक्षिसंघातो न शब्दो न च दर्शनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001676007, "chapter_id": 21676, "verse_number": "१-६२-८", "content_sanskrit": "यत्र वैयासकिर्द्धाम्नि योक्तुं समुपचक्रमे ।\nस ददर्श तदात्मानं सर्वसंगविनिःसृतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001676008, "chapter_id": 21676, "verse_number": "१-६२-९", "content_sanskrit": "प्रजहास ततो हासं शुकः सम्प्रेक्ष्य भास्करम् ।\nस पुनर्योगमास्थाय मोक्षमार्गोपलब्धये ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001676009, "chapter_id": 21676, "verse_number": "१-६२-१०", "content_sanskrit": "महायोगीश्वरो भूत्वा सोऽत्यक्रामद्विहायसम् ।\nअंतरीक्षचरः श्रीमान्व्यासपुत्रः सुनिश्चितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001676010, "chapter_id": 21676, "verse_number": "१-६२-११", "content_sanskrit": "तमुंद्यंतं द्विजश्रेष्टं वैनतेयसमद्युतिम् ।\nददृशुः सर्वभूतानि मनोमारुतरंहसम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001676011, "chapter_id": 21676, "verse_number": "१-६२-१२", "content_sanskrit": "यथाशक्ति यथान्यायं पूजयांचक्रिरे तथा ।\nपुष्प वर्षैश्च दिव्यैस्तमवचक्रुर्दिवौकसः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001676012, "chapter_id": 21676, "verse_number": "१-६२-१३", "content_sanskrit": "तं दृष्ट्वा विस्मिताः सर्वे गंधर्वाप्सरसां गणाः ।\nऋषयश्चैव संसिद्धाः कोऽयं सिद्धिमुपागतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001676013, "chapter_id": 21676, "verse_number": "१-६२-१४", "content_sanskrit": "ततोऽसौ स्वाह्रयं तेभ्यः कथयामास नारद ।\nउवाच च महातेजास्तानृषीन्संप्रहर्षितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001676014, "chapter_id": 21676, "verse_number": "१-६२-१५", "content_sanskrit": "पिता यद्यनुगच्छेन्मां क्रोशमानः शुकेति वै ।\nतस्मै प्रतिवचोदेयं भवद्भिस्तु समाहितैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001676015, "chapter_id": 21676, "verse_number": "१-६२-१६", "content_sanskrit": "बाढमुक्तस्ततस्तैस्तु लोकान्हित्वा चतुर्विधान् ।\nतमो ह्यष्टविधं त्यक्त्वा जहौ पञ्चविधं रजः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001676016, "chapter_id": 21676, "verse_number": "१-६२-१७", "content_sanskrit": "ततः सत्वं जहौ धीमांस्तदद्भुतमिवाभवत् ।\nततस्तस्मिन्पदे नित्ये निर्गुणे लिंगपूजिते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001676017, "chapter_id": 21676, "verse_number": "१-६२-१८", "content_sanskrit": "ततः स श्रृङ्गेऽप्रतिमे हिमवन्मेरुसन्निभे ।\nसंश्लिष्टे श्वेतपीते च रुक्मरूप्यमये शुभे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001676018, "chapter_id": 21676, "verse_number": "१-६२-१९", "content_sanskrit": "शतयोजनविस्तारे तिर्यागूर्द्ध्च नारद ।\nसोऽविशंकेन मनसा तथैवाभ्यपतच्छुकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001676019, "chapter_id": 21676, "verse_number": "१-६२-२०", "content_sanskrit": "ते श्रृङ्गेऽत्यंतसंश्लिष्टे सहसैव द्विधाकृते ।\nअदृश्येतां द्विजश्रेष्ट तदद्भुतमिवाभवत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001676020, "chapter_id": 21676, "verse_number": "१-६२-२१", "content_sanskrit": "ततः पर्वतश्रृंगाभ्यां सहसैव विनिःसृतः ।\nन च प्रतिजघानास्य स गतिं पर्वतोत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001676021, "chapter_id": 21676, "verse_number": "१-६२-२२", "content_sanskrit": "ततो मंदाकिनीं दिव्या मुपरिष्टादभिव्रजन् ।\nशुको ददर्श धर्मात्मा पुष्पितद्रुमकाननम् ॥२२।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001676022, "chapter_id": 21676, "verse_number": "१-६२-२३", "content_sanskrit": "तस्यां क्रीडासु निरताः स्नांति चैवाप्सरोगणाः ।\nनिराकारं तु साकाराददृशुस्तं विवाससः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001676023, "chapter_id": 21676, "verse_number": "१-६२-२४", "content_sanskrit": "तं प्रक्रमंतमाज्ञाय पिता स्नेहसमन्वितः ।\nउत्‌तमां गतिमास्थाय पृष्टतोऽनुससार ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001676024, "chapter_id": 21676, "verse_number": "१-६२-२५", "content_sanskrit": "शुकस्तु मारुतादूर्द्ध्वं गतिं कृत्वां तरिक्षगाम् ।\nदर्शयित्वा प्रभावं स्वं सर्वभूतोऽभवत्तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001676025, "chapter_id": 21676, "verse_number": "१-६२-२६", "content_sanskrit": "अथ योगगतिं व्यासः समास्थाय महातपाः ।\nनिमेषांतरमात्रेण शुकाभिपतनं ययौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001676026, "chapter_id": 21676, "verse_number": "१-६२-२७", "content_sanskrit": "स ददर्श द्विधा कृत्वा पर्वताग्रं गतं शुकम् ।\nशशंसुर्मुनयः सिद्धा गतिं तस्मै सुतस्य ताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001676027, "chapter_id": 21676, "verse_number": "१-६२-२८", "content_sanskrit": "ततः शुकेतिशब्देन दीर्घेण क्रंदितं तदाः ।\nस्वयं पित्रा स्वरेणोञ्चैस्त्रींल्लोकाननुनाद्य वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001676028, "chapter_id": 21676, "verse_number": "१-६२-२९", "content_sanskrit": "शुकः सर्वगतिर्भूत्वा सर्वात्मा सर्वतोमुखः ।\nप्रत्यभाषत धर्मात्मा भोः शब्देनानुनादयन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001676029, "chapter_id": 21676, "verse_number": "१-६२-३०", "content_sanskrit": "तत एकाक्षरं नादं भोरित्येवमुदीरयन् ।\nप्रत्याहरज्जगत्सर्वमुञ्चैः स्थावरजंगमम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001676030, "chapter_id": 21676, "verse_number": "१-६२-३१", "content_sanskrit": "ततः प्रभृति वाऽद्यापि शब्दानुञ्चारितान्पृथक् ।\nगिरिगह्वरपृष्टेषु व्याजहार शुकं प्रति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001676031, "chapter_id": 21676, "verse_number": "१-६२-३२", "content_sanskrit": "अंतर्हितप्रभावं तं दर्शयित्वा शुकस्तदा ।\nगुणान्संत्यज्य सत्त्वादीन्पदमध्यगमत्परम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001676032, "chapter_id": 21676, "verse_number": "१-६२-३३", "content_sanskrit": "महिमानं तु तं दृष्ट्वा पुत्रस्यामिततेजसः ।\nसोऽनुनीतो भगवता व्यासो रुद्रेण नारद ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001676033, "chapter_id": 21676, "verse_number": "१-६२-३४", "content_sanskrit": "किमु त्वं ताम्यसि मुने पुत्रं प्रति समाकुलः ।\nपश्यसि विप्र नायांतं ब्रह्यभूतं निजांतिरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001676034, "chapter_id": 21676, "verse_number": "१-६२-३५", "content_sanskrit": "इत्येवमनुनीतोऽसौ व्यासः पुनरुप्राव्रजत् ।\nश्वाश्रमं स शुको ब्रह्मभूतो लोकांश्चचार ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001676035, "chapter_id": 21676, "verse_number": "१-६२-३६", "content_sanskrit": "तत कालांतरे ब्रह्मन्व्यासः सत्यवतीसुतः ।\nनरनारायणौ द्रष्टुं ययौ बदरिकाश्रमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001676036, "chapter_id": 21676, "verse_number": "१-६२-३७", "content_sanskrit": "तत्र दृष्ट्वा तु तौ देवौ तप्यमानो महत्तपः ।\nस्वयं च तत्र तपसि स्थितः शुकमनुस्मरन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001676037, "chapter_id": 21676, "verse_number": "१-६२-३८", "content_sanskrit": "यावत्तत्र स्थितो व्यासः शुकः परमयोगवित् ।\nश्वेतद्वीपं गतस्तात यत्र त्वमगमः पुरा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001676038, "chapter_id": 21676, "verse_number": "१-६२-३९", "content_sanskrit": "तत्र दृष्टप्रभावस्तु श्रीमान्नारायणः प्रभुः ।\nदृष्टः श्रुतिविमृग्यो हि देवदेवो जनार्दनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001676039, "chapter_id": 21676, "verse_number": "१-६२-४०", "content_sanskrit": "स्तुतश्च शुकदेवेन प्रसन्नः प्राह नारद ।\nश्रीभगवानुवाच ।\nत्वया दृष्टोऽस्मि योगीन्द्र सर्वदेवरहःस्थितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001676040, "chapter_id": 21676, "verse_number": "१-६२-४१", "content_sanskrit": "सनत्कुमारादिष्टेन सिद्धो योगेन वाडव ।\nत्वं सदागतिमार्गस्थो लोकान्पश्य यथेच्छया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001676041, "chapter_id": 21676, "verse_number": "१-६२-४२", "content_sanskrit": "इत्युक्तो वासुदेवेन तं नत्वारणिसंभवः ।\nवैकुंठं प्रययौ विप्र सर्वलोकनमस्कृतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001676042, "chapter_id": 21676, "verse_number": "१-६२-४३", "content_sanskrit": "वैमानिकैः सुरैर्जुष्टं विरजापरिचेष्टितम् ।\nयं भांतमनुभांत्येते लोकाः सर्वेऽपि नारद ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001676043, "chapter_id": 21676, "verse_number": "१-६२-४४", "content_sanskrit": "यत्र विदुमसोपानाः स्वर्णरत्नविचित्रिताः ।\nवाप्य उत्पलंसंछन्नाः सुरस्त्रीक्रीडनाकुलाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001676044, "chapter_id": 21676, "verse_number": "१-६२-४५", "content_sanskrit": "दिव्यैर्हंसकुलैर्घुष्टाः स्वच्छांबुनिभृताः सदा ।\nतत्र द्वाःस्थैश्चतुर्हस्तेनार्नाभरणभूषितैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001676045, "chapter_id": 21676, "verse_number": "१-६२-४६", "content_sanskrit": "विष्वक्सेनानुगैः सिद्धैः कुमुदाद्यैरवा रितः ।\nप्रविश्याभ्यांतरं तत्र देवदेवं चतुर्भुजम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001676046, "chapter_id": 21676, "verse_number": "१-६२-४७", "content_sanskrit": "शांतं प्रसन्नवदनं पीतकौशेयवाससम् ।\nशंखचक्रगदापद्मैर्मूर्तिमद्भिरुपासितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001676047, "chapter_id": 21676, "verse_number": "१-६२-४८", "content_sanskrit": "वक्षस्थलस्थया लक्ष्म्या कौस्तुभेन विराजितम् ।\nकटीसूत्रब्रह्मसूत्रकटकांगदभूषितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001676048, "chapter_id": 21676, "verse_number": "१-६२-४९", "content_sanskrit": "भ्राजत्किरीटवलयं मणिनूपुरशोभितम् ।\nददर्श सिद्धनि करैः सेव्यमानमहर्निशम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001676049, "chapter_id": 21676, "verse_number": "१-६२-५०", "content_sanskrit": "तं दृष्ट्वा भक्तिभावेन तुष्टाव मधुसूदनम् ।\nशुक उवाच ।\nनमस्ते वासुदेवाय सर्वलोकैकसाक्षिणे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001676050, "chapter_id": 21676, "verse_number": "१-६२-५१", "content_sanskrit": "जगद्बीजस्वरूपाय पूर्णाय निभृतात्मने ।\nहरये वासुकिस्थाय श्वेतद्वीपनिवासिने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001676051, "chapter_id": 21676, "verse_number": "१-६२-५२", "content_sanskrit": "हंसाय मत्स्यरूपाय वाराहतनुधारिणे ।\nनृसिंहाय ध्रुवेज्याय सांख्ययोगेश्वराय च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001676052, "chapter_id": 21676, "verse_number": "१-६२-५३", "content_sanskrit": "चतुःसनाय कूर्माय पृथवे स्वसुरवात्मने ।\nनाभेयाय जगद्धात्रे विधात्रेंऽतकारय च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001676053, "chapter_id": 21676, "verse_number": "१-६२-५४", "content_sanskrit": "भार्गवेंद्राय रामाय राघवाय पराय च ।\nकृष्णाय वेदकर्त्रे च बुद्धकल्किस्वरूपिणे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001676054, "chapter_id": 21676, "verse_number": "१-६२-५५", "content_sanskrit": "चतुर्व्युहाय वेद्याय ध्येयाय परमात्मने ।\nनरनारायणाख्याय शिषिविष्टाय विष्णवे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001676055, "chapter_id": 21676, "verse_number": "१-६२-५६", "content_sanskrit": "ऋतधाम्ने विधाम्ने च सुपर्णाय स्वरोचिषे ।\nऋभवे सुव्रताख्याय सुधाम्ने चाजिताय च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001676056, "chapter_id": 21676, "verse_number": "१-६२-५७", "content_sanskrit": "विश्वरूपाय विश्वाय सृष्टिस्थित्यंतकारिणे ।\nयज्ञाय यज्ञभोक्ते च स्थविष्ठायाणवेऽर्थिने ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001676057, "chapter_id": 21676, "verse_number": "१-६२-५८", "content_sanskrit": "आदित्यसोमनेत्राय सहओजोबलाय च ।\nईज्याय साक्षिणेऽजायबहुशीर्षांघ्रिबाहवे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001676058, "chapter_id": 21676, "verse_number": "१-६२-५९", "content_sanskrit": "श्रीशाय श्रीनिवासाय भक्तवश्याय शार्ङ्गिणे ।\nअष्टप्रकृत्यधीशाय ब्रह्मणेऽनंतसक्तये ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001676059, "chapter_id": 21676, "verse_number": "१-६२-६०", "content_sanskrit": "बृहदारण्यवेद्याय हृषीकेशाय वेधसे ।\nपुंडरीकनिभाक्षाय क्षेत्रज्ञाय विभासिने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001676060, "chapter_id": 21676, "verse_number": "१-६२-६१", "content_sanskrit": "गोविंदाय जगत्कर्त्रे जगन्नाथाय योगिने ।\nसत्याय सत्यसंधाय वैकुंठायाच्युताय च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001676061, "chapter_id": 21676, "verse_number": "१-६२-६२", "content_sanskrit": "अधोक्षजाय धर्माय वामनाय त्रिधातवे ।\nघृतार्चिषे विष्णवे तेऽनंताय कपिलायय च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001676062, "chapter_id": 21676, "verse_number": "१-६२-६३", "content_sanskrit": "विरिंचये त्रिककुदे ऋग्यजुःसामरूपिणे ।\nएकश्रृंगाय च शुचिश्रवसे शास्त्रयोनये ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001676063, "chapter_id": 21676, "verse_number": "१-६२-६४", "content_sanskrit": "वृषाकपय ऋद्धाय प्रभवे विश्वकर्मणे ।\nभूर्भुवुःस्वःस्वरूपाय दैत्यघ्ने निर्गुणाय च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001676064, "chapter_id": 21676, "verse_number": "१-६२-६५", "content_sanskrit": "निरंजनाय नित्याय ह्यव्ययायाक्षराय च ।\nनमस्ते पाहि मामीश शरणागतवत्सल ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001676065, "chapter_id": 21676, "verse_number": "१-६२-६६", "content_sanskrit": "इति स्तुतः स भगवाञ्च्छंखचक्रगदाधरः ।\nआरणेयमुवाचेदं भृशं प्रणतवत्सलः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001676066, "chapter_id": 21676, "verse_number": "१-६२-६७", "content_sanskrit": "श्रीभगवानुवाच ।\nव्यासपुत्र महाभाग प्रीतोऽस्मि तव सुव्रत ।\nविद्यामाप्नुहि भक्तिं च ज्ञानी त्वं मम रूपधृक् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001676067, "chapter_id": 21676, "verse_number": "१-६२-६८", "content_sanskrit": "यद्रूपं मम दृष्टं प्राक् श्वेतद्वीपे त्वया द्विज ।\nसोऽहमेवावतारार्थं स्थितो विश्वंभरात्मकः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001676068, "chapter_id": 21676, "verse_number": "१-६२-६९", "content_sanskrit": "सिद्धोऽसि त्वं महाभाग मोक्षधर्मानुनुचिंतया ।\nवरलोकान्यथा वायुर्यथा रवं सविता तथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001676069, "chapter_id": 21676, "verse_number": "१-६२-७०", "content_sanskrit": "नित्यमुक्तस्वरूपस्त्वं पूज्यमानः सुरैर्नरैः ।\nभक्तिर्हि दुर्लभा लोके मयि सर्वपरायणे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001676070, "chapter_id": 21676, "verse_number": "१-६२-७१", "content_sanskrit": "तां लब्ध्वा नापरं किंचिल्लब्धव्यमवशिष्यते ।\nआकल्पांतः तपः संस्थौ नरनारायणावृषी ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001676071, "chapter_id": 21676, "verse_number": "१-६२-७२", "content_sanskrit": "तयोर्निदेशतो व्यासो जनक स्तव सुव्रतः ।\nकर्ता भागवतं शास्त्रं तदधीष्व भुवं व्रज ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001676072, "chapter_id": 21676, "verse_number": "१-६२-७३", "content_sanskrit": "स तप्यति तपस्त्वद्य पर्वते गंधमादने ।\nत्वद्वियोगेन खिन्नात्मा तं प्रसादय मत्प्रियम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001676073, "chapter_id": 21676, "verse_number": "१-६२-७४", "content_sanskrit": "एवमुक्तः शुको विप्र नमस्कृत्य चतुर्भुजम् ।\nयथागतं निवृत्तोऽसौ पितुरंतिकमागमत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001676074, "chapter_id": 21676, "verse_number": "१-६२-७५", "content_sanskrit": "अथ तं स्वंतिके दृष्ट्वा पाराशर्य्यः प्रतापवान् ।\nपुत्रं प्राप्य प्रहृष्टात्मा तपसो निववर्त ह ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001676075, "chapter_id": 21676, "verse_number": "१-६२-७६", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम् ।\nआरणेयसमायुक्तः स्वाश्रमं समुपागमत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001676076, "chapter_id": 21676, "verse_number": "१-६२-७७", "content_sanskrit": "नारायणनियोगात्तु त्वन्मुखेन मुनीश्वर ।\nचकार संहितां दिव्यां नानाख्यानसमन्विताम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001676077, "chapter_id": 21676, "verse_number": "१-६२-७८", "content_sanskrit": "वेदतुल्यां भागवतीं हरिभक्तिविवर्द्धिनीम् ।\nनिवृत्तिनिरतं पुत्रं शुकमध्यापयञ्च ताम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001676078, "chapter_id": 21676, "verse_number": "१-६२-७९", "content_sanskrit": "आत्मारामोऽपि भगवान्पाराशर्यात्मजः शुकः ।\nअधीतवान्संहितां वै नित्यं विष्णुजनप्रियाम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001676079, "chapter_id": 21676, "verse_number": "१-६२-८०", "content_sanskrit": "एवमेते समाख्याता  मोक्षधर्मास्तवानध ।\nपठतां श्रृण्वतां चापि हरिभक्तिविवर्द्धनाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]