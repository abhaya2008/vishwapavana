[{"id": 2070128, "chapter_id": 2468, "verse_number": "११-२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070129, "chapter_id": 2468, "verse_number": "११-२-१", "content_sanskrit": "ततोऽमृतरसैर्वाक्यैर्ह्लादयन्पुरुषर्षभम्।\nवैचित्रवीर्यं विदुरो यदुवाच निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070130, "chapter_id": 2468, "verse_number": "११-२-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070131, "chapter_id": 2468, "verse_number": "११-२-२", "content_sanskrit": "उत्तिष्ठ राजन्किं शेषे धारयात्मानमात्मना।\nएषा वै सर्वसत्वानां लोकेश्वर परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070132, "chapter_id": 2468, "verse_number": "११-२-३", "content_sanskrit": "सर्वे क्षयान्ता निचयाः पतनान्ताः समुच्छ्रयाः।\nसंयोगा विप्रयोगान्ता मरणान्तं च जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070133, "chapter_id": 2468, "verse_number": "११-२-४", "content_sanskrit": "यदा शूरं च भीरुं च यमः कर्षति भारत।\nतत्किं न योत्स्यन्ति हि ते क्षत्रियाः क्षत्रियर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070134, "chapter_id": 2468, "verse_number": "११-२-५", "content_sanskrit": "अयुध्यमानो म्रियते युध्यमानश्च जीवति।\nकालं प्राप्य महाराज न कश्चिदतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070135, "chapter_id": 2468, "verse_number": "११-२-६", "content_sanskrit": "अभावादीनि भूतानि भावमध्यानि भारत।\nअभावनिधनान्येव तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070136, "chapter_id": 2468, "verse_number": "११-२-७", "content_sanskrit": "न शोचन्मृतमन्वेति न शोचन्म्रियते नरः।\nएवं सांसिद्धिके लोके किमर्थमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070137, "chapter_id": 2468, "verse_number": "११-२-८", "content_sanskrit": "कालः कर्षति भूतानि सर्वाणि विविधान्युत।\nन कालस्य प्रियः कश्चिन्न द्वेष्यः कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070138, "chapter_id": 2468, "verse_number": "११-२-९", "content_sanskrit": "यथा वायुस्तृणाग्राणि संवर्तयति सर्वशः।\nतथा कालवशं यान्ति भूतानि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070139, "chapter_id": 2468, "verse_number": "११-२-१०", "content_sanskrit": "एकसार्थप्रयातानां सर्वेषां तत्र गामिनाम्।\nयस्य कालः स यात्यग्रे तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070140, "chapter_id": 2468, "verse_number": "११-२-११", "content_sanskrit": "न चाप्येतान्हतान्युद्धे राजञ्शोचितुमर्हसि।\nप्रमाणं यदि शास्त्राणि गतास्ते परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070141, "chapter_id": 2468, "verse_number": "११-२-१२", "content_sanskrit": "सर्वे स्वाध्यायवन्तो हि सर्वे च चरितव्रताः।\nसर्वे चाभिमुखाः क्षीणास्तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070142, "chapter_id": 2468, "verse_number": "११-२-१३", "content_sanskrit": "अदर्शनादापतिताः पुनश्चादर्शनं गताः।\nनैते तव न तेषां त्वं तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070143, "chapter_id": 2468, "verse_number": "११-२-१४", "content_sanskrit": "हतो हि लभते स्वर्गं जित्वा च लभते यशः।\nउभयं नो बहुगुणं नास्ति निष्फलता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070144, "chapter_id": 2468, "verse_number": "११-२-१५", "content_sanskrit": "तेषां कामदुघाँल्लोकानिन्द्रः सङ्कल्पयिष्यति।\nइन्द्रस्यातिथयो ह्येते भवन्ति भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070145, "chapter_id": 2468, "verse_number": "११-२-१६", "content_sanskrit": "न यज्ञैर्दक्षिणावद्भिर्न तपोभिर्न विद्यया।\nस्वर्गं यान्ति तथा मर्त्या यथा शूरा रणे हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070146, "chapter_id": 2468, "verse_number": "११-२-१७", "content_sanskrit": "शरीराग्निषु शूराणां जुहुवुस्ते शराहुतीः।\nहूयमानाञ्शरांश्चैव सेहुस्तेजस्विनो मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070147, "chapter_id": 2468, "verse_number": "११-२-१८", "content_sanskrit": "एवं राजंस्तवाचक्षे स्वर्ग्यं पन्थानमुत्तमम्।\nन युद्धादधिकं किञ्चित्क्षत्रियस्येह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070148, "chapter_id": 2468, "verse_number": "११-२-१९", "content_sanskrit": "क्षत्रियास्ते महात्मानः शूराः समितिशोभनाः।\nआशिषः परमाः प्राप्ता न शोच्याः सर्व एव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070149, "chapter_id": 2468, "verse_number": "११-२-२०", "content_sanskrit": "आत्मानमात्मनाऽऽश्वास्य मा शुचः पुरुषर्षभ।\nनाद्य शोकाभिभूतस्त्वं कायमुत्स्रष्टुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070150, "chapter_id": 2468, "verse_number": "११-२-२१", "content_sanskrit": "मातापितृसहस्राणि पुत्रदारशतानि च।\nसंसारेष्वनुभूतानि कस्य ते कस्य वा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070151, "chapter_id": 2468, "verse_number": "११-२-२२", "content_sanskrit": "शोकस्थानसहसाणि भयस्थानशतानि च।\nदिवसेदिवसे मूढमाविशन्ति न पण़्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070152, "chapter_id": 2468, "verse_number": "११-२-२३", "content_sanskrit": "न कालस्य प्रियः कश्चिन्न द्वेष्यः कुरुसत्तम।\nन मध्यस्थः क्वचित्कालः सर्वं कालः प्रकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070153, "chapter_id": 2468, "verse_number": "११-२-२४", "content_sanskrit": "कालः पचति भूतानि कालः संहरते प्रजाः।\nकालः सुप्तेषु जागर्ति कालो हि दुरतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070154, "chapter_id": 2468, "verse_number": "११-२-२५", "content_sanskrit": "अनित्यं यौवनं रूपं जीवितं द्रव्यसञ्चयः।\nआरोग्यं प्रियसंवासो गृद्ध्येदेषु न पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070155, "chapter_id": 2468, "verse_number": "११-२-२६", "content_sanskrit": "न जानपदिकं दुःखमेकः शोचितुमर्हसि।\nअप्यभावेन युज्येत तच्चास्य न निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070156, "chapter_id": 2468, "verse_number": "११-२-२७", "content_sanskrit": "अशोचन्प्रतिकुर्वीत यदि पश्येत्पराक्रमम्।\nभैषज्यमेतद्दुःखस्य यदेतन्नानुचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070157, "chapter_id": 2468, "verse_number": "११-२-२८", "content_sanskrit": "चिन्त्यमानं हि न व्येति भूयश्चापि प्रवर्धते॥\nअनिष्टसम्प्रयोगाच्च विप्रयोगात्प्रियस्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070158, "chapter_id": 2468, "verse_number": "११-२-२९", "content_sanskrit": "मानुषा मानसैर्दुःखैर्युज्यन्ते येऽल्पबुद्धयः॥\nनार्थो न धर्मो न सुखं यदेतदनुशोचति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070159, "chapter_id": 2468, "verse_number": "११-२-३०", "content_sanskrit": "तच्च नाप्नोति कार्यार्थं त्रिवर्गाच्चैव भ्रश्यते॥\nअन्योन्यबाधनावस्थां प्राप्य वैषयिकीं नराः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070160, "chapter_id": 2468, "verse_number": "११-२-३१", "content_sanskrit": "असन्तुष्टाः प्रमुह्यन्ति सन्तोषं यान्ति पण्डिताः॥\nप्रज्ञया मानसं दुःखं हन्याच्छारीरमौषधैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070161, "chapter_id": 2468, "verse_number": "११-२-३२", "content_sanskrit": "एतद्विज्ञानसामर्थ्यं न बालैः समतामियात्॥\nशयानं चानुशेते हि तिष्ठन्तं चानुतिष्ठति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070162, "chapter_id": 2468, "verse_number": "११-२-३३", "content_sanskrit": "अनुधावति धावन्तं कर्म पूर्वकृतं नरम्॥\nयस्यांयस्यामवस्थायां यत्करोति शुभाशुभम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070163, "chapter_id": 2468, "verse_number": "११-२-३४", "content_sanskrit": "तस्यांतस्यामवस्थायां तत्तत्फलमवाप्नुते॥\n[येनयेन शरीरेण यद्यत्कर्म करोति यः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070164, "chapter_id": 2468, "verse_number": "११-२-३५", "content_sanskrit": "तेनतेन शरीरेण तत्फलं समुपाश्नुते॥\nआत्मैव ह्यात्मनः साक्षी कृतस्यापकृतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070165, "chapter_id": 2468, "verse_number": "११-२-३६", "content_sanskrit": "शुभेन कर्मणा सौख्यं दुःखं पापेन कर्मणा।\nकृतं भवति सर्वत्र नाकृतं विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070166, "chapter_id": 2468, "verse_number": "११-२-३७", "content_sanskrit": "न हि ज्ञानविरुद्धेषु बह्वपायेषु कर्मसु।\nमूलघातिषु सज्जन्ते बुद्धिमन्तो भवद्विघाः॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070167, "chapter_id": 2468, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]