[{"id": 7003150000, "chapter_id": 23150, "verse_number": "४-८६-१", "content_sanskrit": "नन्द उवाच ।\nकेदारकन्याप्रस्तावात्कथितं कर्मकीर्तनम् ।\nकृत्यास्त्रीणां प्रसङ्गेन तद्व्यासेन वद प्रभो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003150001, "chapter_id": 23150, "verse_number": "४-८६-२", "content_sanskrit": "केदारकन्या सा का वा को वा केदारभूपतिः ।\nकस्य वंशेचतज्जन्म तन्मे व्याख्यातुमर्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003150002, "chapter_id": 23150, "verse_number": "४-८६-३", "content_sanskrit": "श्रीकृष्ण उवाच ।\nपुरातु ब्रह्मणाः पुत्रो मनुः स्वांयभुवस्तथा ।\nतस्य स्त्री शतरूपा च धन्या मान्या च योषिताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003150003, "chapter_id": 23150, "verse_number": "४-८६-४", "content_sanskrit": "प्रियव्रतोत्तानपादौ तयोः पुत्रौ बभूवतुः ।\nउत्तानपादपुत्रश्च ध्रुव एव महायशाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003150004, "chapter_id": 23150, "verse_number": "४-८६-५", "content_sanskrit": "तत्पुत्रो नन्दसावर्णिः केदारश्च तदात्मजः ।\nसप्तद्वीपपतिः श्रीमान्केदारो वैष्णवः स्वयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003150005, "chapter_id": 23150, "verse_number": "४-८६-६", "content_sanskrit": "तस्य रक्षानिमित्तेन सत्सभायां सुदर्शनम् ।\nगवां लक्षं शुद्धं स्वर्णशृङ्गं च भूषितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003150006, "chapter_id": 23150, "verse_number": "४-८६-७", "content_sanskrit": "वह्निशुद्धानि वस्त्राणि दत्तानि वरुणेन च ।\nसुवर्णानां तथा लक्षं सर्वसस्यां वसुंधराम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003150007, "chapter_id": 23150, "verse_number": "४-८६-८", "content_sanskrit": "मणिरत्नं च मुक्ताश्च हीरकं परमं तथा ।\nमाणिक्यामश्वरत्नानां लक्षं लक्षं चहस्तिनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003150008, "chapter_id": 23150, "verse_number": "४-८६-९", "content_sanskrit": "रौप्यं प्रवालं मिष्टान्नं शतधान्याचलं वरम् ।\nनित्यं नित्यं ब्राह्मणेम्यो ददौ च रत्नभूषणाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003150009, "chapter_id": 23150, "verse_number": "४-८६-१०", "content_sanskrit": "शतलक्षं ब्राह्मणानां भोजयामास नित्यशः ।\nजलभोजनपात्राणि सुवर्णानां ददौ नृपः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003150010, "chapter_id": 23150, "verse_number": "४-८६-११", "content_sanskrit": "सुवर्णानां यज्ञसूत्रमङ्गुलीयकमुत्तमम् ।\nआसनं स्वर्णरत्नानां ब्राह्मणेभ्यो ददौ मुदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003150011, "chapter_id": 23150, "verse_number": "४-८६-१२", "content_sanskrit": "ब्राह्मणानां च लक्षं च सूपकारं नृपस्य च ।\nब्राह्मणानां द्विलक्षं च परिवेषणकारकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003150012, "chapter_id": 23150, "verse_number": "४-८६-१३", "content_sanskrit": "घृतकुल्या मधुकुल्या दधिकुल्या मनोहराः ।\nगुडकुल्या दुग्धकुल्या नित्यं प्रार्थनमीप्सितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003150013, "chapter_id": 23150, "verse_number": "४-८६-१४", "content_sanskrit": "प्रातरारभ्य संध्यान्तं विप्राणां भोजनं तथा ।\nदुःशिनां भिक्षुकाणां च धनदानं यथोचितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003150014, "chapter_id": 23150, "verse_number": "४-८६-१५", "content_sanskrit": "फलमूलाशनो राजा वैष्णवश्च जितेन्द्रियः ।\nसर्व मदर्पणं कृत्वाऽजपन्मां च दिवानिशम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003150015, "chapter_id": 23150, "verse_number": "४-८६-१६", "content_sanskrit": "एकदा सूपकारश्च तमुवाच नृपेश्वरम् ।\nविप्राणां भोजनायैव दशलक्षमुपस्थितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003150016, "chapter_id": 23150, "verse_number": "४-८६-१७", "content_sanskrit": "भुञ्जते ब्राह्मणाश्चाद्य रूक्षमन्नं वद प्रभो ।\nकुर्वन्तु भक्षणं ते वै विप्राः सूपादिना नृप ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003150017, "chapter_id": 23150, "verse_number": "४-८६-१८", "content_sanskrit": "चतुर्योजनपर्यन्तमधिकारो नृपस्य च ।\nयो राजा तच्छतसुणः स एव मण्डलेश्वरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003150018, "chapter_id": 23150, "verse_number": "४-८६-१९", "content_sanskrit": "तत्तद्दशगुणो राजा राजेन्द्रः परिकीर्तितः ।\nराजेन्द्राणां पञ्चलक्षं नित्यं केदारसंसदि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003150019, "chapter_id": 23150, "verse_number": "४-८६-२०", "content_sanskrit": "अमूल्यरत्नमाणिक्यं मुक्ताहीरं मणीश्वरम् ।\nगजरत्नमश्वरत्नं केदाराय करं ददौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003150020, "chapter_id": 23150, "verse_number": "४-८६-२१", "content_sanskrit": "कमलाकलया जाता यज्ञकुण्डसमुद्भवाः ।\nवह्रिशुद्धांसुकाधाना रत्नभूषणभूषिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003150021, "chapter_id": 23150, "verse_number": "४-८६-२२", "content_sanskrit": "कामुकी कामिनीश्रेष्ठा कन्या कमललोचना ।\nकन्याऽस्मि ते महाराजेत्युवाच नृपतिं च सा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003150022, "chapter_id": 23150, "verse_number": "४-८६-२३", "content_sanskrit": "राजा संपूज्य तां भक्त्या तस्थौ पत्नींसर्प्य च ।\nसा विज्ञाय प्रसूं तातं कृत्वा च विनयं सुदा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003150023, "chapter_id": 23150, "verse_number": "४-८६-२४", "content_sanskrit": "ययौ पुण्यवनं रम्यं तपसे यमृनान्तिकम् ।\nतत्तपस्यावनं यस्मात्तस्माद्दृन्दावनं स्मृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003150024, "chapter_id": 23150, "verse_number": "४-८६-२५", "content_sanskrit": "तपसा वरयामास मां वरं च वरं वरम् ।\nब्रह्मा ददौ वरं तस्यै पश्यात्कृष्णं लभेष्यसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003150025, "chapter_id": 23150, "verse_number": "४-८६-२६", "content_sanskrit": "स चैकदा नदीतीने वसन्ते सस्मिता सती ।\nशयाना पुष्पशय्यायां रत्नाभरणभूषिता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003150026, "chapter_id": 23150, "verse_number": "४-८६-२७", "content_sanskrit": "ब्रह्मा परीक्षितुं यातःसाध्वीं च सुमनोहराम् ।\nददर्श कन्या रहसि युवानं पुरुषं परम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003150027, "chapter_id": 23150, "verse_number": "४-८६-२८", "content_sanskrit": "चन्दनोक्षितसर्वाङ्गं रत्नभूषणभूषितम् ।\nसस्मीतं कामुकं रम्यं रमणीनां च वाञ्छितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003150028, "chapter_id": 23150, "verse_number": "४-८६-२९", "content_sanskrit": "यथा षोडशवर्षीयं कुमारं कनकप्रभम् ।\nकोटिकन्दर्पलीलाभं वीताम्बरधरं वरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003150029, "chapter_id": 23150, "verse_number": "४-८६-३०", "content_sanskrit": "शरत्पार्वणाचन्द्रास्यं शरत्पद्मसुलोचनम् ।\nदृष्ट्वा तं च समुत्थाय वासयामास संनिधौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003150030, "chapter_id": 23150, "verse_number": "४-८६-३१", "content_sanskrit": "पूजां चकार भक्त्या च फलं मूलं ददौ मुदा ।\nसुवा सितं जलं दत्त्वा प्रणनाम मुदाऽन्विता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003150031, "chapter_id": 23150, "verse_number": "४-८६-३२", "content_sanskrit": "पूजां गृहीत्वा मुदितः सादरं तामुवाच ह ।\nविप्ररूपी च भगवान्प्रज्वलन्ब्रह्मातेजसा ।\nकामुकीनां च काम्यं च सतीनां दुष्करं व्रज ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003150032, "chapter_id": 23150, "verse_number": "४-८६-३३", "content_sanskrit": "धर्म उवाच ।\nभवती कस्य कन्या वा किं ते नाम मनोहरे ।\nकिं करोषि रहस्येव तन्मे कथितुमर्हसि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003150033, "chapter_id": 23150, "verse_number": "४-८६-३४", "content_sanskrit": "कस्य हेतोस्तपस्या ते किं वा वाञ्छसि सुन्दरि ।\nवरं वृणीष्व भद्रं ते यत्ते मनसि वाञ्छितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003150034, "chapter_id": 23150, "verse_number": "४-८६-३५", "content_sanskrit": "वृन्दोवाच ।\nविप्र केदारकन्याऽहं वृन्दा वृन्दावने स्थिता ।\nतपः करोमि रहसि चिन्तयामि हरिं पतिम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003150035, "chapter_id": 23150, "verse_number": "४-८६-३६", "content_sanskrit": "यदि दातुं समर्थोऽसि देहि मे वाञ्छितं वरम् ।\nअसमर्थोऽसि चेद्गच्छ किं ते प्रश्नेन ब्राह्मण ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003150036, "chapter_id": 23150, "verse_number": "४-८६-३७", "content_sanskrit": "धर्म उवाच ।\nनिरीहमवितर्क्यं च परमात्मानमीश्वरम् ।\nनिर्गुणं च निराकारं भक्तानुग्रहविग्रहम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003150037, "chapter_id": 23150, "verse_number": "४-८६-३८", "content_sanskrit": "का क्षमा तं पतिं कर्तुं विना लक्षमीं सरस्वतीम् ।\nचतुर्भुजस्य द्वे भार्ये हरेर्वैकुण्ठशाथिनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003150038, "chapter_id": 23150, "verse_number": "४-८६-३९", "content_sanskrit": "गोलोके द्विभुजस्यापि श्रीवंशीवदनस्य च ।\nकिशोरगोपवेषस्य परिपूर्णतमस्य च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003150039, "chapter_id": 23150, "verse_number": "४-८६-४०", "content_sanskrit": "तस्य भार्या स्वयं राधा महालक्ष्मीः परात्परा ।\nब्रह्मस्वरूपा परमा परमात्मानमीश्वरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003150040, "chapter_id": 23150, "verse_number": "४-८६-४१", "content_sanskrit": "भजते सततं शान्तं सुरम्यं श्यामसुन्दरम् ।\nकोटिकन्दर्पसौन्दर्यनिन्दितं सुकलेवरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003150041, "chapter_id": 23150, "verse_number": "४-८६-४२", "content_sanskrit": "अमूल्यरत्नाभरणं सत्यं च नित्यविग्रहम् ।\nपीताम्बरधरं रम्यं दातारं सर्वसंपदाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003150042, "chapter_id": 23150, "verse_number": "४-८६-४३", "content_sanskrit": "श्रीकृष्णश्च द्विधारूपो द्विभुजश्च चतुर्भुजः ।\nचतुर्भुजश्च वैकुण्ठे गोलोके द्विभुजः स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003150043, "chapter_id": 23150, "verse_number": "४-८६-४४", "content_sanskrit": "यन्निमेषो भवेद्वृन्दे ब्रह्मणः पततेन च ।\nपञ्चविंशत्सहस्रेणा युगेनेन्द्रस्य पातनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003150044, "chapter_id": 23150, "verse_number": "४-८६-४५", "content_sanskrit": "चतुर्दशेन्द्रावच्छिन्नकालेन ब्रह्मणो दिनम् ।\nतावतीति निशा तस्य विधातुर्जगतामपि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003150045, "chapter_id": 23150, "verse_number": "४-८६-४६", "content_sanskrit": "एवं त्रिंशद्दिनैर्मासं द्विषट्के मासि वर्षकम् ।\nएवं शतायुस्तस्यैव निबोध बोधतत्परम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003150046, "chapter_id": 23150, "verse_number": "४-८६-४७", "content_sanskrit": "यावज्जीवनपर्यन्तं सेवन्ते सनकादयः ।\nकल्पानां कोटिकोटिं च तन्न साध्याश्चयो विभुः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003150047, "chapter_id": 23150, "verse_number": "४-८६-४८", "content_sanskrit": "सहस्रवक्त्रः शेषश्च सेवते च जपन्सदा ।\nदिवानिशं च यं भक्त्या कल्पकोटिशतं शतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003150048, "chapter_id": 23150, "verse_number": "४-८६-४९", "content_sanskrit": "तन्न साध्यो हितकरो दुराराध्यः परात्परः ।\nब्रह्मा ब्रह्मास्वरूपं तं भजेज्जन्मनि जन्मनि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003150049, "chapter_id": 23150, "verse_number": "४-८६-५०", "content_sanskrit": "वक्त्रैश्चतुर्भिः सततं स्तौति नित्यं सनातनम् ।\nवेदेऽनिर्वचनीयश्च वेदानां जनको विधिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003150050, "chapter_id": 23150, "verse_number": "४-८६-५१", "content_sanskrit": "विधाता फलदाता च दाता च सर्वसंपदाम् ।\nतन्न साध्यो हि भगवान्कालकालान्तकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003150051, "chapter_id": 23150, "verse_number": "४-८६-५२", "content_sanskrit": "संहारकर्ता जगतां कलया रुद्ररूपतः ।\nस स्तौति पञ्चवक्त्रेण कोऽन्योऽन्यस्यापि का कथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003150052, "chapter_id": 23150, "verse_number": "४-८६-५३", "content_sanskrit": "तत्परश्च प्रियो नास्ति वृन्दे भगवातः शृणु ।\nसर्वशक्तिस्वरूपा सा दुर्गा दुर्गतिनाशिनी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003150053, "chapter_id": 23150, "verse_number": "४-८६-५४", "content_sanskrit": "ब्रह्मस्वरूपा परमा मूलप्रकृतिरीश्वरी ।\nनारायणी विष्णुमाया वैष्णवी सा सनातनी ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003150054, "chapter_id": 23150, "verse_number": "४-८६-५५", "content_sanskrit": "यन्मायया जगद्भ्रान्तमनित्ये भ्रमते सदा ।\nसा स्तौति भक्त्यायं देवं वृन्देऽयङ्गे.दिवानिशम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003150055, "chapter_id": 23150, "verse_number": "४-८६-५६", "content_sanskrit": "स्तौति भक्त्या स्वशक्त्या च गजवक्त्रः षडाननः ।\nध्यायते यं गणेशश्च सर्वादौ यस्य पूजनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003150056, "chapter_id": 23150, "verse_number": "४-८६-५७", "content_sanskrit": "भगवान्सर्वदेवेशो ज्ञानिनां च गुरोर्गुरुः ।\nसिद्वेन्द्रेषु च देवेन्द्रे योमीन्द्रे ज्ञानिनां गुरौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003150057, "chapter_id": 23150, "verse_number": "४-८६-५८", "content_sanskrit": "न गणेशात्परो विद्वान्गणेशश्च सुराधिपः ।\nसरस्वती च यं स्तोतुमशक्ता परमेश्वरी ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003150058, "chapter_id": 23150, "verse_number": "४-८६-५९", "content_sanskrit": "दिवानिशं पादपद्मं भक्त्या पद्मा निषेवते ।\nयत्कटाक्षाज्जगत्सर्व परिपूर्णतमं शिवम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003150059, "chapter_id": 23150, "verse_number": "४-८६-६०", "content_sanskrit": "यद्भयाद्वाति वातोऽयं सूर्यस्तपति यद्भयात् ।\nवर्षतीन्द्रो दहत्यग्निर्मृत्युश्चरति जन्तुषु ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003150060, "chapter_id": 23150, "verse_number": "४-८६-६१", "content_sanskrit": "पृथिवी सेवया यस्य सर्वाधारा वसंधरा ।\nसमृद्रा निश्चलाः शैला यस्य भीताश्च सुन्दरि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003150061, "chapter_id": 23150, "verse_number": "४-८६-६२", "content_sanskrit": "तीर्थसारा च सा गङ्गा पवित्रा मुक्तिदायिनी ।\nजगतां पावनी देवी यस्य पादाब्जसेवया ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003150062, "chapter_id": 23150, "verse_number": "४-८६-६३", "content_sanskrit": "पवित्रा तुलसी देवी स्मरणाद्यस्य सेवनात् ।\nनवग्रहाश्च दिक्पाला भीता यस्य प्रतापतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003150063, "chapter_id": 23150, "verse_number": "४-८६-६४", "content_sanskrit": "ब्रह्मण्डेषु च सर्वेषु ब्रह्मविष्णुशिवात्मकाः ।\nअन्ये ये ये सुरेशाश्च शेषाद्या मुनयस्तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003150064, "chapter_id": 23150, "verse_number": "४-८६-६५", "content_sanskrit": "केचित्कलास्वरूपाश्चाप्यंशरूपाश्च केचन ।\nकेचित्कलांशाः कृष्णस्य केचिच्च परमात्मनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003150065, "chapter_id": 23150, "verse_number": "४-८६-६६", "content_sanskrit": "पतिमिच्छसि कल्याणि प्रकृतेः परमीश्वरम् ।\nगोलोके राधिका साध्यो नान्येषां च कदाचन ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003150066, "chapter_id": 23150, "verse_number": "४-८६-६७", "content_sanskrit": "मां भजस्व महाभागे नृपाणामीश्वरं पतिम् ।\nबलवन्तं च देवेभ्यो दैत्येभ्यश्च वरानने ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003150067, "chapter_id": 23150, "verse_number": "४-८६-६८", "content_sanskrit": "सुखानि यानि कल्याणि त्रिषु लोकेषु सन्ति वै ।\nभुङ्क्ष्व तान्येव सर्वाणि मत्प्रसादान्न संशयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003150068, "chapter_id": 23150, "verse_number": "४-८६-६९", "content_sanskrit": "सप्तसागलपारे च काञ्चनी रुचिरा वरे ।\nदेवानां क्रीडनार्थाय विधात्रा निर्मिता पुरी ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003150069, "chapter_id": 23150, "verse_number": "४-८६-७०", "content_sanskrit": "तत्रैव गच्छभद्रं ते रम रामे मया सह ।\nमहेन्द्रस्य प्रियवनं पुष्पोद्यानसमन्वितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003150070, "chapter_id": 23150, "verse_number": "४-८६-७१", "content_sanskrit": "गच्छ स्वर्णमयीं लङ्कां नानारत्नविभूषिताम् ।\nतत्रैव गच्छ भद्रं ते रम ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003150071, "chapter_id": 23150, "verse_number": "४-८६-७२", "content_sanskrit": "विस्पन्दकं सुवसनं नन्दकं पुष्पभद्रकम् ।\nतत्रैव गच्छ भद्रं ते रम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003150072, "chapter_id": 23150, "verse_number": "४-८६-७३", "content_sanskrit": "सुमेरुगह्वरं वाऽपि क्षीरोर्द वा मनोहरम् ।\nतत्रैव गच्छ भद्रं ते रम ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003150073, "chapter_id": 23150, "verse_number": "४-८६-७४", "content_sanskrit": "सत्यलोकं ब्रह्मलोकं रम्यं सद्म रहःस्थलम् ।\nतत्रैव गच्छ भद्रं ते रम ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003150074, "chapter_id": 23150, "verse_number": "४-८६-७५", "content_sanskrit": "मलये निलयं रम्यं रत्नेन्द्रसारनिर्मितम् ।\nसुगन्धियुक्तं सततं शुद्धं चन्दनवायुना ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003150075, "chapter_id": 23150, "verse_number": "४-८६-७६", "content_sanskrit": "मालती यूथिका रम्या केतकी माधवी तथा ।\nचारुचम्पकपुष्पाणां गन्धेन सुमनोहरम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003150076, "chapter_id": 23150, "verse_number": "४-८६-७७", "content_sanskrit": "पिकानां भ्रमराणां च मधुरध्वनिसंयुतम् ।\nतत्रैव गच्छ भद्रं ते रम ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003150077, "chapter_id": 23150, "verse_number": "४-८६-७८", "content_sanskrit": "इन्द्रस्य वरुणास्यैव वायोरपि यमस्य च ।\nधनेश्वरस्य बह्रेश्च धर्मस्य शशिनस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003150078, "chapter_id": 23150, "verse_number": "४-८६-७९", "content_sanskrit": "सुरम्यं लोकमेतेषां मध्ये तेवि यथेच्छसि ।\nतत्रैव गच्छ भद्रं ते रम ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003150079, "chapter_id": 23150, "verse_number": "४-८६-८०", "content_sanskrit": "रत्नद्वीपं मणिद्वीपं रम्यं चन्द्रसरोवरम् ।\nतत्रैव गच्छ भद्रं ते रम ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003150080, "chapter_id": 23150, "verse_number": "४-८६-८१", "content_sanskrit": "इत्येवमुक्त्वा संभोक्तुं गच्छन्तं तं छलेन च ।\nन वास्तवपरीक्षार्थं सतीत्वं बोधितुं व्रज ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003150081, "chapter_id": 23150, "verse_number": "४-८६-८२", "content_sanskrit": "उवाच सा नृपसुता कोपवक्त्रास्यलोचना ।\nहितं सत्यं योगयुक्तं धर्मार्थं च यशस्करम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003150082, "chapter_id": 23150, "verse_number": "४-८६-८३", "content_sanskrit": "वृन्दोवाच ।\nधैर्य कुरु महाभाग श्रेष्ठो जातिषु ब्रह्मणः ।\nब्रह्मणानां तपो मूलं सत्यं वेदव्रतं धृतिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003150083, "chapter_id": 23150, "verse_number": "४-८६-८४", "content_sanskrit": "परस्त्रीसहसंभोगः स्वभावश्चाप्यधर्मिणाम् ।\nअधर्मेणैव हे विप्र दुष्टोऽभद्राणि पश्यति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003150084, "chapter_id": 23150, "verse_number": "४-८६-८५", "content_sanskrit": "ततः सपत्ने जयति समूलस्थो विनश्यति ।\nपतिव्रतानां गमने बलात्कारेण निश्चितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003150085, "chapter_id": 23150, "verse_number": "४-८६-८६", "content_sanskrit": "मातृगामी भवेत्सद्यो ब्रह्महत्याशतं भवेत् ।\nकुम्भीपाके पच्यते च यावच्चन्द्रदिवाकरौ ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003150086, "chapter_id": 23150, "verse_number": "४-८६-८७", "content_sanskrit": "प्रदग्धस्तैलतप्तेषु न मृतः सूक्ष्मदेहतः ।\nताडितो यमदूतैश्च लोहदण़्डेन मूर्धनि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003150087, "chapter_id": 23150, "verse_number": "४-८६-८८", "content_sanskrit": "क्षणं सुखं चिरं दुःखं सर्वनाशस्य कारणम् ।\nअगम्यागमनं दुःखं धर्मिष्ठो नैव वाञ्छति ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003150088, "chapter_id": 23150, "verse_number": "४-८६-८९", "content_sanskrit": "क्षमस्वगच्छ भद्रं ते ब्राह्मण ज्ञानदुर्बल ।\nयथा दीपशिखां दृष्ट्वा कीटः पतति निश्चितम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003150089, "chapter_id": 23150, "verse_number": "४-८६-९०", "content_sanskrit": "मिष्टं दृष्ट्वा बडीशाग्रे लुब्धमीनो मृगो यथा ।\nयथा विषाक्तं भक्ष्यं च भुङ्क्ते भोक्ता बुभुक्षितः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003150090, "chapter_id": 23150, "verse_number": "४-८६-९१", "content_sanskrit": "गृह्णाति दुष्टो दुष्टं च विषकुम्भं पयोमुखम् ।\nतथा दृष्ट्वा परस्त्रीणां मुखपद्मं मनोहरम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003150091, "chapter_id": 23150, "verse_number": "४-८६-९२", "content_sanskrit": "विनाशबीजं मोहेन भ्रान्तो भवति लम्पटः ।\nमुखं च रुचिरं स्त्रीणां श्रोणियुग्मं मनोहरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003150092, "chapter_id": 23150, "verse_number": "४-८६-९३", "content_sanskrit": "कामाधारं नाशबीजमधर्मस्थलमेव च ।\nभगं नरककुण्डं च लालामूत्रसमन्वितम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003150093, "chapter_id": 23150, "verse_number": "४-८६-९४", "content_sanskrit": "दुर्गन्धियुक्तं पापं च यमदण्डस्य कारणम् ।\nयथा लिङ्गं विशत्येव पापयोनौ च योषिताम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003150094, "chapter_id": 23150, "verse_number": "४-८६-९५", "content_sanskrit": "तथा पुमान्विशत्येव रौरवे च युगे युगे ।\nरहस्यं चाऽऽपदं दृष्ट्वा मां तवं धर्षितुमिच्छसि ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003150095, "chapter_id": 23150, "verse_number": "४-८६-९६", "content_sanskrit": "अत्रैव सर्वदेवाश्च लोकपालाश्च ब्राह्मणा ।\nजाज्वल्यमानो धर्मश्च साक्षी शास्ता च कर्मणाम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003150096, "chapter_id": 23150, "verse_number": "४-८६-९७", "content_sanskrit": "यमश्च दण़्डकर्ता च स्थापितो हरिणा स्वयम् ।\nस्वयं कुष्णश्च धर्मात्मा ज्ञानरुपो महेश्वरः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003150097, "chapter_id": 23150, "verse_number": "४-८६-९८", "content_sanskrit": "दुर्गा बुद्धिर्मनो ब्रह्म चेन्द्रियाणि सुरास्तथा ।\nसर्वप्राणिषु तिष्ठन्ति साक्षिणाः कर्मणां द्विज ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003150098, "chapter_id": 23150, "verse_number": "४-८६-९९", "content_sanskrit": "क्व गुप्तं क्व रहस्यं वा ब्रह्मण ज्ञानदुर्बल ।\nक्षमस्व गच्छ भद्रं ते अवध्याश्च द्विजातयः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003150099, "chapter_id": 23150, "verse_number": "४-८६-१००", "content_sanskrit": "शक्ताऽहं भमसात्कर्तुं गच्छ वत्स यथासुखम् ।\nतपस्यासु मम गतमष्टोत्तरशतं युगम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003150100, "chapter_id": 23150, "verse_number": "४-८६-१०१", "content_sanskrit": "नास्ति गोर्त्र मत्पितुश्च न माता न पिता मम ।\nसर्वान्तरात्मा भगवान्कृष्णो रक्षति मां द्विज ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003150101, "chapter_id": 23150, "verse_number": "४-८६-१०२", "content_sanskrit": "कृष्णेन स्थापितो धर्मो मां च रक्षति नित्यशः ।\nआदित्यश्च तथा चन्द्रः पवनश्च हुताशनः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003150102, "chapter_id": 23150, "verse_number": "४-८६-१०३", "content_sanskrit": "ब्रह्मा शंभुर्भगवती दुर्गा रक्षति मां सदा ।\nयेन शुक्लीकृता हंसाः शुकाश्च हरिताः कृताः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003150103, "chapter_id": 23150, "verse_number": "४-८६-१०४", "content_sanskrit": "मयूराश्चित्रिता येन स मे रक्षां करिष्यति ।\nअनाथबालवृद्धानां रक्षकाः सर्वदेवताः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003150104, "chapter_id": 23150, "verse_number": "४-८६-१०५", "content_sanskrit": "नारीबुद्व्या न मां धर्मस्त्यक्त्वा गच्छेद्धि सर्वदा ।\nमां मातरं परित्यज्य गच्छ वत्स यथासुखम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003150105, "chapter_id": 23150, "verse_number": "४-८६-१०६", "content_sanskrit": "इत्येवमुक्त्वा देवी सा तस्थौ तत्र धरा यथा ।\nआगच्छन्तं च संभोक्तुं मा यान्तं बोधनेन च ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003150106, "chapter_id": 23150, "verse_number": "४-८६-१०७", "content_sanskrit": "शशापेति च सा कोपाद्ब्रह्मपन्धो क्षयो भव ।\nक्षयो भव दुराचार हे पापिष्ठ क्षयो भव ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003150107, "chapter_id": 23150, "verse_number": "४-८६-१०८", "content_sanskrit": "पुनः शप्तं स्वयं सूर्यो वारयामास यत्नतः ।\nएतसिमन्नन्तरे तात तत्रव जगदीश्वराः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003150108, "chapter_id": 23150, "verse_number": "४-८६-१०९", "content_sanskrit": "आजग्मुरतिसंत्रस्ता ब्रह्मविष्णुशिवादयः ।\nधर्म दृष्ट्वा कलारूपं रुरुदुस्त्रिदशेश्वराः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003150109, "chapter_id": 23150, "verse_number": "४-८६-११०", "content_sanskrit": "कृत्वा क्रोडेऽतीव कृशं कुह्वा भीतं यथा विधुम् ।\nनिश्चेष्टं मलिनं दग्धं सतीकोपाग्निना व्रज ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003150110, "chapter_id": 23150, "verse_number": "४-८६-१११", "content_sanskrit": "श्रीभवानुवाच ।\nक्षमस्व वृन्दे मद्भक्ते जन्ममृत्युजराहरे ।\nधर्म जीवय मद्भक्तं रक्ष धर्म पतिव्रते ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003150111, "chapter_id": 23150, "verse_number": "४-८६-११२", "content_sanskrit": "ब्रह्मोवाच ।\nध्वान्तपूर्ण जगत्सर्दं विना धर्म बभूव ह ।\nकम्पितौ चन्द्रसूर्यौ च शेषश्चापि वसुंधरा ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003150112, "chapter_id": 23150, "verse_number": "४-८६-११३", "content_sanskrit": "महदेव उवाच ।\nप्रनष्टं च जगत्सर्वं विना धर्मेण सुन्दरि ।\nधर्मं जीवय भद्रं ते स्वस्ति तेऽस्तु वरानने ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003150113, "chapter_id": 23150, "verse_number": "४-८६-११४", "content_sanskrit": "सूर्य उवाच ।\nवरं वृष्णीष्व भद्रं ते यत्ते मनसि वाञ्छितम् ।\nधर्मं जीवय भद्रं ते रक्ष सृष्टिं पतिव्रते ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003150114, "chapter_id": 23150, "verse_number": "४-८६-११५", "content_sanskrit": "अनन्त उवाच ।\nधर्मं करोषि तपसा कथं धर्मं विहसि च ।\nधर्मं जीवय भद्रं ते सर्वधर्मो भवेत्तव ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003150115, "chapter_id": 23150, "verse_number": "४-८६-११६", "content_sanskrit": "चन्द्र उवाच ।\nद्विजरूपधरो धर्मस्त्वां परीक्षितुमागतः ।\nब्रह्मणा प्रेरितश्चैव निर्दोषश्च विहिंसितः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003150116, "chapter_id": 23150, "verse_number": "४-८६-११७", "content_sanskrit": "महेन्द्र उवाच ।\nतपसोपान्जितो धर्मो धर्मेण च फलं नृपाम् ।\nकथं फलं च तपसां यदि धर्मः क्षयं गतः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003150117, "chapter_id": 23150, "verse_number": "४-८६-११८", "content_sanskrit": "वरुण उवाच ।\nधर्मं जीवय धर्मिष्ठे धर्मं रक्ष सनातनम् ।\nनिष्फलं कर्मिणां कर्म विना धर्मेणा धार्मिके ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003150118, "chapter_id": 23150, "verse_number": "४-८६-११९", "content_sanskrit": "पवन उवाच ।\nजगत्पूतं कुरु शुभे धर्मं जौवय सांप्रतम् ।\nधर्मे प्रनष्टे तपसां तवापूर्वं विनङ्क्ष्यति ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003150119, "chapter_id": 23150, "verse_number": "४-८६-१२०", "content_sanskrit": "वह्निरुवाच ।\nस्वधर्मोपार्जनं कर्तुमागताऽसि च भारतम् ।\nविहंसि धर्ममज्ञात्वा पुनर्जीवय सुन्दरि ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003150120, "chapter_id": 23150, "verse_number": "४-८६-१२१", "content_sanskrit": "यम उवाच ।\nवेदोक्तकर्मकर्तणासहं विश्वे वरानने ।\nधर्मानुसारात्फलदो धर्म जीवय सत्वरम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003150121, "chapter_id": 23150, "verse_number": "४-८६-१२२", "content_sanskrit": "देवानां वचनं क्षुत्वा समुत्थाय पतिव्रता ।\nनमस्कृत्य सुरेशांश्चतानुवाच तपस्विनी ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003150122, "chapter_id": 23150, "verse_number": "४-८६-१२३", "content_sanskrit": "वृन्दोवाच ।\nअहं देवा न जानामि धर्मं ब्राह्मणरूपिणम् ।\nकृतः क्षयो मया कोपान्मां परीङितुमागतः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003150123, "chapter_id": 23150, "verse_number": "४-८६-१२४", "content_sanskrit": "जीवयामि ध्रुवं धर्मं युष्माकं च प्रसादतः ।\nइत्येवमुक्त्वा सा वृन्दा चेत्युवाच व्पजेश्वर ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003150124, "chapter_id": 23150, "verse_number": "४-८६-१२५", "content_sanskrit": "तपः सत्यं यदि मम सत्यं च विष्णुपूजनम् ।\nतेन पुण्येन सद्योऽत्र द्विजो भवतु विज्वरः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003150125, "chapter_id": 23150, "verse_number": "४-८६-१२६", "content_sanskrit": "यदि मे च भवेत्सत्यं व्रतं सत्यं तपःशुचि ।\nतेन पुण्येन सत्येन द्विजो भ ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003150126, "chapter_id": 23150, "verse_number": "४-८६-१२७", "content_sanskrit": "यदि नारायणः सत्यः सर्वात्मा नित्यविग्रहः ।\nज्ञानात्मकः शिवः सत्यो द्विजो भ ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003150127, "chapter_id": 23150, "verse_number": "४-८६-१२८", "content_sanskrit": "ब्रह्म सत्यं च ते देवाः प्रकृतिः परमा यदि ।\nयज्ञः सत्यस्तपः सत्यं द्विजो भ ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003150128, "chapter_id": 23150, "verse_number": "४-८६-१२९", "content_sanskrit": "इत्येवमुक्त्वा सा वृन्दा धर्म क्रोडे चकार च ।\nतं दृष्ट्वा च कलारूपं रुरोद कृपयासती ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003150129, "chapter_id": 23150, "verse_number": "४-८६-१३०", "content_sanskrit": "एतस्मिन्नन्तरे मूर्तिर्धर्मभार्या शुचाऽऽकुला ।\nनिपत्य विष्णुपादे य शिरसा चेत्युवाच सा ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003150130, "chapter_id": 23150, "verse_number": "४-८६-१३१", "content_sanskrit": "मूर्तिरुवाच ।\nहे नाथ करुणासिन्धो दीनबन्धो कृपां कुरु ।\nतूर्णं जीवय कान्तं मे जगन्नाथ कृपामय ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003150131, "chapter_id": 23150, "verse_number": "४-८६-१३२", "content_sanskrit": "पतिहीना च या नारी पापिनी सा भवार्णवे ।\nयथाऽऽस्यं चक्षुर्विरतं प्राणहीना यथा तनूः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003150132, "chapter_id": 23150, "verse_number": "४-८६-१३३", "content_sanskrit": "मितं ददाति हि पिता मितं भ्रादा मितं सुतः ।\nमितं बन्धुर्मितं माता सर्वदाता पतिः प्रभुः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003150133, "chapter_id": 23150, "verse_number": "४-८६-१३४", "content_sanskrit": "इत्येवमुक्त्वा सा देवी तत्र तस्थौ रुरोद च ।\nउवाच वृन्दां णगवान्सर्वात्मा प्रकृतेः परः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003150134, "chapter_id": 23150, "verse_number": "४-८६-१३५", "content_sanskrit": "श्रीभगवानुवाच ।\nत्वयाऽऽयुस्तपसा लब्धं यावदायुश्च ब्रह्मणः ।\nतदेव देहि धर्माय गोलोकं गच्छ सुन्दरि ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003150135, "chapter_id": 23150, "verse_number": "४-८६-१३६", "content_sanskrit": "तन्वाऽनया च तपसा पश्चान्मां च लभिष्यसि ।\nपश्चाद्गोलोकमागत्य वाराहे च वरानने ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003150136, "chapter_id": 23150, "verse_number": "४-८६-१३७", "content_sanskrit": "वृषभानसुता त्वं च राधाच्छाया भविष्यसि ।\nमत्कलांशश्च रायाणस्त्वां विवाह ग्रहीष्यति ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003150137, "chapter_id": 23150, "verse_number": "४-८६-१३८", "content_sanskrit": "मां लभिष्यसि रासे च गोपीभी राधया सह ।\nराधा श्रीदामशापेन वृषभानसुता यदा ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003150138, "chapter_id": 23150, "verse_number": "४-८६-१३९", "content_sanskrit": "सा चैव वास्तवी राधा त्वं च च्छायास्वरुपिणी ।\nविवाहकाले रायाणस्त्वां च च्छायां ग्रहीष्यति ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003150139, "chapter_id": 23150, "verse_number": "४-८६-१४०", "content_sanskrit": "त्वां दत्त्वा वास्तवी राधा साऽन्तर्धाना भविष्यति ।\nराधैवेति विमूढाश्च विज्ञास्यन्ति ।\nच गोकुले ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003150140, "chapter_id": 23150, "verse_number": "४-८६-१४१", "content_sanskrit": "स्वप्ने राधापदाम्भोजं न रि पश्यन्ति बल्लवाः ।\nस्वयं राधा मम क्रोडे छाया रायाणकामिनी ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003150141, "chapter_id": 23150, "verse_number": "४-८६-१४२", "content_sanskrit": "विष्णोश्च वचनं श्रुत्वा ददावायुश्च सुन्दरी ।\nउत्तस्थौ पूर्ण धर्मश्च तप्तकाञ्चनसंनिभः ।\nपूर्वस्मात्सुन्दरः श्रीमान्प्रणनाम परात्परम् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7003150142, "chapter_id": 23150, "verse_number": "४-८६-१४३", "content_sanskrit": "वृन्दोवाच ।\nदेवाः शृणुत मद्वाक्यं दुर्लङ्घ्यं सावधानतः ।\nन हि मिथ्या भवेद्वाक्यं मदीयं च निशामय ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7003150143, "chapter_id": 23150, "verse_number": "४-८६-१४४", "content_sanskrit": "क्षयो भवेति वाक्यं च मयोक्तं कोपभीतया ।\nवारत्रयं पुनर्वक्तुं वारयामास भास्करः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7003150144, "chapter_id": 23150, "verse_number": "४-८६-१४५", "content_sanskrit": "सत्ये च परिपूर्णोऽयं यथापूर्वो यथाऽधुना ।\nत्रिपादश्चापि त्रेतायां द्वापदो द्विपरे तथा ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7003150145, "chapter_id": 23150, "verse_number": "४-८६-१४६", "content_sanskrit": "एकपादश्च दर्मोऽयं कलेश्च प्रथमे हरे ।\nशेषे कलाषोडशांशः पुनः सत्ये यथा पुरा ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7003150146, "chapter_id": 23150, "verse_number": "४-८६-१४७", "content_sanskrit": "त्रिर्निर्गतं मम मुखात्क्षयस्तेन ततः क्रमात् ।\nपुनरुक्ते च मनसि वारयामास भास्करः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7003150147, "chapter_id": 23150, "verse_number": "४-८६-१४८", "content_sanskrit": "तेनैव रेतुनाऽयं च करिशेषे कलामयः ।\nतथा शप्तः स्थितो दुर्गे कलिशेषे तथा ध्रुवम् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7003150148, "chapter_id": 23150, "verse_number": "४-८६-१४९", "content_sanskrit": "एतस्मिन्नन्तरे नन्द ददृशुर्देवता रथम् ।\nगोलोकादागतं वेगादतीव सुन्दरं शुभम् ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7003150149, "chapter_id": 23150, "verse_number": "४-८६-१५०", "content_sanskrit": "अमूल्यरत्ननिर्माणं हीरहारपरिष्कृतम् ।\nमणिमाणिक्यमुक्ताभिर्वस्त्रैश्च श्वेतचामरै ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7003150150, "chapter_id": 23150, "verse_number": "४-८६-१५१", "content_sanskrit": "विभूषितं भूषणौश्च रुचिरै स्तनदर्पणैः ।\nनत्वा हरिं हरं वृन्दा ब्रह्माणं सर्वदेवताः ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7003150151, "chapter_id": 23150, "verse_number": "४-८६-१५२", "content_sanskrit": "समारुङ्य रथं दृष्ट्वा गोलोकं च जगाम सा ।\nदेवा जग्मुश्च स्वस्थानं किं भूयः श्रोतुमिच्छसि ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}]