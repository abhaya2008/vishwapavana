[{"id": 7000301000, "chapter_id": 20301, "verse_number": "१-५५-१", "content_sanskrit": "श्रीभगवानुवाच ।\nअपरं च प्रवक्ष्यामि कामेनाधिष्ठितस्य च ।\nपुरा भागीरथी तीरे द्विजः परमहंसकः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000301001, "chapter_id": 20301, "verse_number": "१-५५-२", "content_sanskrit": "उपदेष्टा सहस्राणां द्विजानां शांतिदः परः ।\nएकदंडधरः साक्षात्कूर्मवद्धरणी स्थितः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000301002, "chapter_id": 20301, "verse_number": "१-५५-३", "content_sanskrit": "एकाकिनः सतस्तस्य देवागारे विनिष्कृते ।\nपत्युर्गृहात्परं गेहं गंतुं सायं समुद्यता॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000301003, "chapter_id": 20301, "verse_number": "१-५५-४", "content_sanskrit": "अकस्माद्युवती नारी मिलिता रूपधारिणी ।\nदृष्ट्वा तां भगवान्विप्रो मन्मथस्य भयार्दितः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000301004, "chapter_id": 20301, "verse_number": "१-५५-५", "content_sanskrit": "अगारजठरे कृत्वा स चैनां प्राक्षिपत्क्षपाम् ।\nअर्गलं सा दृढं कृत्वा देवागारे सुशोभने॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000301005, "chapter_id": 20301, "verse_number": "१-५५-६", "content_sanskrit": "कदाचिदपि तं द्वारादागंतुं न ददाति ह ।\nएवंभूतः समाधिस्थः क्षपां क्षिप्त्वा विलप्य सः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000301006, "chapter_id": 20301, "verse_number": "१-५५-७", "content_sanskrit": "चिंतयंस्तां वरारोहां द्वारि किं वा कृतं मम ।\nएवं संचिंत्यतामाह द्वारं देहीह नः प्रिये॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000301007, "chapter_id": 20301, "verse_number": "१-५५-८", "content_sanskrit": "पतिश्च वशगः कांते दयितस्ते भविष्यति ।\nततस्तं प्राह सा विप्रं वृद्धं कामप्रलालसम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000301008, "chapter_id": 20301, "verse_number": "१-५५-९", "content_sanskrit": "अनन्विता गिरःस्तात वक्तुं त्वं नार्हसि प्रभो ।\nअथासौ भगवान्प्राह प्रचुरं चास्ति मे वसु॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000301009, "chapter_id": 20301, "verse_number": "१-५५-१०", "content_sanskrit": "तव दास्यामि कल्याणि प्रस्फोटय कपाटिकाम् ।\nविप्रमाह पुनः सा च त्वं वै मे धर्मतः पिता॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000301010, "chapter_id": 20301, "verse_number": "१-५५-११", "content_sanskrit": "मा गच्छ पुत्रिकां मां च परयोषां च धार्मिक ।\nमनसा स समालोच्य सुषिरेण पथा गृहान्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000301011, "chapter_id": 20301, "verse_number": "१-५५-१२", "content_sanskrit": "बाहुनोद्धाट्यते नैव गंतुं चैव समुद्यतः ।\nगच्छतश्चार्द्धमरर उत्तमांगं सुसंकटे॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000301012, "chapter_id": 20301, "verse_number": "१-५५-१३", "content_sanskrit": "प्रविष्टं न पुनश्चैति पंचत्वमगमत्तदा ।\nउषःकाले समायाता रक्षिणो ये च किंकराः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000301013, "chapter_id": 20301, "verse_number": "१-५५-१४", "content_sanskrit": "अद्भुतं तं शवं दृष्ट्वा तामुचुस्ते च विस्मिताः ।\nकथं च निधनं त्वस्य संभूतं ब्रूहि सुंदरि॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000301014, "chapter_id": 20301, "verse_number": "१-५५-१५", "content_sanskrit": "कथयित्वा तु तद्वृत्तमभीष्टं देशमागता ।\nएवं कामस्य महिमा दुर्निवारो जनेषु च॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000301015, "chapter_id": 20301, "verse_number": "१-५५-१६", "content_sanskrit": "सर्वेषामपि जंतूनां सुरासुरनृणां भवेत् ।\nदृष्ट्वाऽमोघां वरारोहां सर्वलोकपितामहः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000301016, "chapter_id": 20301, "verse_number": "१-५५-१७", "content_sanskrit": "च्युतबीजोभवत्तत्र लौहित्यसंभवस्मृतः ।\nपुनाति सकलान्लोकान्सर्वतीर्थमयो हि सः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000301017, "chapter_id": 20301, "verse_number": "१-५५-१८", "content_sanskrit": "यमाश्रित्य नरो याति ब्रह्मलोकमनामयम् ।\nद्विज उवाच ।\nकथं च ब्रह्मणो मोहो ह्यमोघा का वरांगना॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000301018, "chapter_id": 20301, "verse_number": "१-५५-१९", "content_sanskrit": "उद्भवं तीर्थराजस्य श्रोतुमिच्छामि तत्त्वतः ।\nश्रीभगवानुवाच ।\nमुनिर्देवैः समाराध्यः पद्मयोनिसमप्रभः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000301019, "chapter_id": 20301, "verse_number": "१-५५-२०", "content_sanskrit": "शंतनुश्चेति विख्यातः पत्नी तस्य पतिव्रता ।\nअमोघेति समाख्याता रूपयौवनशालिनी॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000301020, "chapter_id": 20301, "verse_number": "१-५५-२१", "content_sanskrit": "अस्याश्च पतिमन्वेष्टुं यातो ब्रह्मा च तद्गृहम् ।\nतस्मिन्काले मुनिश्रेष्ठः पुष्पाद्यर्थं वनं गतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000301021, "chapter_id": 20301, "verse_number": "१-५५-२२", "content_sanskrit": "सा तं दृष्ट्वा सुरश्रेष्ठमर्घ्यपाद्यादिकं ददौ ।\nदूरेभिवादनं कृत्वा सा गृहं प्रविवेश ह॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000301022, "chapter_id": 20301, "verse_number": "१-५५-२३", "content_sanskrit": "तां च दृष्ट्वा नवद्यांगीं धाता कामवशं गतः ।\nस्रष्टात्मानं समाधायाचिंतयत्तां पुरोगताम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000301023, "chapter_id": 20301, "verse_number": "१-५५-२४", "content_sanskrit": "बीजं पपात खट्वायां ब्रह्मणः परमात्मनः ।\nततो ब्रह्मा गतस्त्रस्तस्त्वरया परिपीडितः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000301024, "chapter_id": 20301, "verse_number": "१-५५-२५", "content_sanskrit": "अथायातो मुनिर्गेहं शुक्रं पीठे ददर्श ह ।\nतमपृच्छद्वरारोहां कश्चाप्यत्रागतः पुमान्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000301025, "chapter_id": 20301, "verse_number": "१-५५-२६", "content_sanskrit": "तमुवाच ततोऽमोघा ब्रह्मा ह्यत्रागतः पते ।\nत्वामेवान्वेषितुं नाथ मया दत्तोत्र पीठकः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000301026, "chapter_id": 20301, "verse_number": "१-५५-२७", "content_sanskrit": "शुक्रस्य कारणं चात्र तपसा ज्ञातुमर्हसि ।\nततो ध्यानात्परिज्ञातं तेनैव च द्विजन्मना॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000301027, "chapter_id": 20301, "verse_number": "१-५५-२८", "content_sanskrit": "ब्रह्मरेतः परं साध्वी पालयस्व ममाज्ञया ।\nउत्पद्यते सुतस्ते तु सर्वलोकैकपावनः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000301028, "chapter_id": 20301, "verse_number": "१-५५-२९", "content_sanskrit": "आवयोः सर्वकल्याणं फलिष्यति मनोगतम् ।\nततः पतिव्रता तस्य आज्ञामागृह्य संभवात्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000301029, "chapter_id": 20301, "verse_number": "१-५५-३०", "content_sanskrit": "पपौ रेतो महाभागा ब्रह्मणः परमात्मनः ।\nआवर्त इव संजज्ञे रौद्रगर्भ इति स्फुरन्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000301030, "chapter_id": 20301, "verse_number": "१-५५-३१", "content_sanskrit": "प्रसोढुं नैव शक्ता सा शंतनुं चाब्रवीत्ततः ।\nगर्भं धारयितुं नाथ न शक्नोम्यधुना प्रभो॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000301031, "chapter_id": 20301, "verse_number": "१-५५-३२", "content_sanskrit": "किं करिष्यामि धर्मज्ञ प्राणो मे संचलत्यपि ।\nआज्ञापय महाभाग गर्भं त्यक्ष्यामि यत्र च॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000301032, "chapter_id": 20301, "verse_number": "१-५५-३३", "content_sanskrit": "पत्युराज्ञां समादाय मुक्तो गर्भो युगंधरे ।\nपयस्तेजोमयं शुद्धं सर्वधर्मप्रतिष्ठितम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000301033, "chapter_id": 20301, "verse_number": "१-५५-३४", "content_sanskrit": "तन्मध्ये पुरुषः शुद्धः किरीटी नीलवाससा ।\nरत्नदाम्ना च विद्धांगो दुःप्रेक्ष्यो ज्योतिषां गणः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000301034, "chapter_id": 20301, "verse_number": "१-५५-३५", "content_sanskrit": "ततो देवगणाः स्वर्गात्पुष्पवर्षमवाकिरन् ।\nप्रसूतः सर्वतीर्थेषु तीर्थराज इति स्मृतः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000301035, "chapter_id": 20301, "verse_number": "१-५५-३६", "content_sanskrit": "ततो राम इति ख्यातः प्रजातोहं भृगोः कुले ।\nक्षत्रियान्पितृहंतॄंस्तु ससैन्यबलवाहनान्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000301036, "chapter_id": 20301, "verse_number": "१-५५-३७", "content_sanskrit": "हत्वा युद्धगतान्भीतान्पंकैः सर्वैर्युतो ह्यहम् ।\nब्रह्महत्यासमं घोरं मद्गेहे समुपस्थितम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000301037, "chapter_id": 20301, "verse_number": "१-५५-३८", "content_sanskrit": "पंकयुक्तं कुठारं मे क्षालितं नैव शुद्ध्यति ।\nततः खे चाभवद्वाणी राम मद्वचनं कुरु॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000301038, "chapter_id": 20301, "verse_number": "१-५५-३९", "content_sanskrit": "यत्र तीर्थे कुठारं ते निर्मलं च भवेदिह ।\nतत्र ते सर्वपापानां जातानां च क्षयो भवेत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000301039, "chapter_id": 20301, "verse_number": "१-५५-४०", "content_sanskrit": "जनानां तत्र सर्वेषां हितार्थं तिष्ठ मानद ।\nचपलं गच्छ तीर्थानि सर्वाणि सुमहांति च॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000301040, "chapter_id": 20301, "verse_number": "१-५५-४१", "content_sanskrit": "तेषां मध्ये महातीर्थे पर्शुः शुद्धो भवेद्यदि ।\nतं च जानीहि तीर्थेषु मुक्तिदं परिकीर्तितम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000301041, "chapter_id": 20301, "verse_number": "१-५५-४२", "content_sanskrit": "तच्छ्रुत्वा जामदग्न्यस्तु तीर्थानि प्रययौ तदा ।\nगंगां सरस्वतीं शुभ्रां कावेरीं सरयूं तथा॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000301042, "chapter_id": 20301, "verse_number": "१-५५-४३", "content_sanskrit": "गोदावरीं च यमुनां कद्रूं च वसुदां तथा ।\nअन्यां च पुण्यदां रम्यां गौरीं पूर्वां स्थितां शुभाम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000301043, "chapter_id": 20301, "verse_number": "१-५५-४४", "content_sanskrit": "गच्छतस्तस्य धीरस्य सदागतिसमस्य च ।\nक्षालितः सर्वतीर्थेषु न पुनर्निर्मलोऽभवत्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000301044, "chapter_id": 20301, "verse_number": "१-५५-४५", "content_sanskrit": "ततो गिरिगुहां दुर्गां महारण्यं च पर्वतम् ।\nगिरिकूटं च दुर्लभ्यं ययौ तीर्थमसौ हरिः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000301045, "chapter_id": 20301, "verse_number": "१-५५-४६", "content_sanskrit": "न च निर्मलतामेति कुठारस्तस्य तेन च ।\nविषादमगमत्तत्र रामः परपुरंजयः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000301046, "chapter_id": 20301, "verse_number": "१-५५-४७", "content_sanskrit": "हाहेति विविधं कृत्वा चोपविश्य धरातले ।\nप्रचिंतामगमद्वीरस्तमुवाच पुनस्तथा॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000301047, "chapter_id": 20301, "verse_number": "१-५५-४८", "content_sanskrit": "पूर्वस्यां दिशि देवेश तीर्थं चास्ति गुहोदरे ।\nतच्छ्रुत्वा नरशार्दूलो गत्वा कुंडं ददर्श सः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000301048, "chapter_id": 20301, "verse_number": "१-५५-४९", "content_sanskrit": "प्रदक्षिणं जलावर्तं शुभ्रं पापहरं शुभम् ।\nतज्जलस्पर्शमात्रेण कुठारः शुद्धतां गतः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000301049, "chapter_id": 20301, "verse_number": "१-५५-५०", "content_sanskrit": "ततो रामोभिषेकं तु कृतवान्प्रमुदान्वितः ।\nशुद्धात्मनस्त्वपापस्य बुद्धिर्जाता प्रपाविनी॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000301050, "chapter_id": 20301, "verse_number": "१-५५-५१", "content_sanskrit": "स रामः सुचिरं स्थित्वा तीर्थराजं प्रसाद्य तम् ।\nततस्ततोऽचलात्प्राप्य पुरं वेगसमन्वितः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000301051, "chapter_id": 20301, "verse_number": "१-५५-५२", "content_sanskrit": "ख्यातं कृत्वा ततश्चोर्व्यां गतोसौ लवणार्णवम् ।\nअयं तीर्थवरः साक्षात्पितामहकृतो भुवि॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000301052, "chapter_id": 20301, "verse_number": "१-५५-५३", "content_sanskrit": "सुखदः सर्वतः शुद्धो मुक्तिमार्गप्रदः किल ।\nएवं कामप्रभावं च विद्धि दुर्वारदुःसहम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000301053, "chapter_id": 20301, "verse_number": "१-५५-५४", "content_sanskrit": "कामाज्जातं वृषं पापं पुण्यं पुण्यप्रयोगतः ।\nस जातश्चैव लौहित्यो विरंचेश्चैव चौरसः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000301054, "chapter_id": 20301, "verse_number": "१-५५-५५", "content_sanskrit": "शंतनो क्षेत्र संजातस्त्वमोघागर्भसंभवः ।\nविरिञ्चिना जितः कामः शांतनोरप्यमत्सरात्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000301055, "chapter_id": 20301, "verse_number": "१-५५-५६", "content_sanskrit": "तस्याः पतिव्रतात्वाच्च तीर्थात्तीर्थवरो हि सः ।\nएवं यस्तु पठेन्नित्यं पुण्याख्यानमिदं शिवम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000301056, "chapter_id": 20301, "verse_number": "१-५५-५७", "content_sanskrit": "शृणुयाद्वा मुदा पृथ्व्यां मुक्तिमार्गं स गच्छति॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]