[{"id": 50006038, "chapter_id": 11286, "verse_number": "1", "content_sanskrit": "- 【पाठभेदः: TRK—(ॐ योनेः शरीरम् ॐ॥)】 बीजपूरुषयोनीनां सङ्गातिनियमोज्झितिम्। अथशब्देन भगवानाह कारणतश्च ताम्॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006039, "chapter_id": 11286, "verse_number": "2", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते ब्रह्मसूत्रानुव्याख्याने तृतीयाध्यायस्य प्रथमः पादः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006040, "chapter_id": 11286, "verse_number": "3", "content_sanskrit": "॥ द्वितीयः पादः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]