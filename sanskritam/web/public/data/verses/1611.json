[{"id": 2028253, "chapter_id": 1611, "verse_number": "३-२४९-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028254, "chapter_id": 1611, "verse_number": "३-२४९-१", "content_sanskrit": "अजानतस्ते राधेय नाभ्यसूयाम्यहं वचः।\nजानासि त्वं जिताञ्शत्रून्गन्धर्वां स्तेजसा मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028255, "chapter_id": 1611, "verse_number": "३-२४९-२", "content_sanskrit": "आयोधितास्तु गन्धर्वाः सुचिरं सोदरैर्मम।\nमया सह महाबाहो कृतश्चोभयतः क्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028256, "chapter_id": 1611, "verse_number": "३-२४९-३", "content_sanskrit": "मायाधिकास्त्वयुध्यन्त यदा शूरा वियद्गताः।\nतदा नो न समं युद्धमभवत्खेचरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028257, "chapter_id": 1611, "verse_number": "३-२४९-४", "content_sanskrit": "पराजयं च प्राप्ताः स्मो रणे बन्धनमेव च।\nसभृत्यामात्यपुत्राश्च सदारबलवाहनाः।\nउच्चैराकाशमार्गेण ह्रियमाणाः सुदुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028258, "chapter_id": 1611, "verse_number": "३-२४९-५", "content_sanskrit": "अथ नः सैनिकाः केचिदमात्याश्च महारथाः।\nउपगम्याब्रुवन्दीनाः पाण्डवाञ्शरणप्रदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028259, "chapter_id": 1611, "verse_number": "३-२४९-६", "content_sanskrit": "एष दुर्योधनो राजा धार्तराष्ट्रः सहानुजः।\nसामात्यदारो ह्रियते गन्धर्वैर्दिवमाश्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028260, "chapter_id": 1611, "verse_number": "३-२४९-७", "content_sanskrit": "तं मोक्षयत भद्रं वः सहदारं नराधिपम्।\nपरामर्शो मा भविष्यत्कुरुदारेषु सर्वशः।\n`इत्यब्रुवन्रणआन्मुक्ता धर्मराजमुपागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028261, "chapter_id": 1611, "verse_number": "३-२४९-८", "content_sanskrit": "एवमुक्ते तु धर्मात्मा ज्येष्ठः पाण्डुसुतस्तदा।\nप्रसाद्य सोदरान्सर्वानाज्ञापयत मोक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028262, "chapter_id": 1611, "verse_number": "३-२४९-९", "content_sanskrit": "अथागम्य तमुद्देशं पाण्डवाः पुरुषर्षभाः।\nसान्त्वपूर्वमयाचन्त शक्ताः सन्तो महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028263, "chapter_id": 1611, "verse_number": "३-२४९-१०", "content_sanskrit": "यदा चास्मान्न मुमुचुर्गन्धर्वाः सान्त्विता अपि।\n`आकाशचारिणो वीरा नदन्तो जलदा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028264, "chapter_id": 1611, "verse_number": "३-२४९-११", "content_sanskrit": "ततोऽर्जुनश्च भीमश्च यमजौ च बलोत्कटौ।\nमुमुचुः शरवर्षाणि गन्धर्वान्प्रत्यनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028265, "chapter_id": 1611, "verse_number": "३-२४९-१२", "content_sanskrit": "अथ सर्वे रणं मुक्त्वा प्रयाताः खेचरा दिवम्।\nअस्मानेवाभिकर्षन्तो दीनान्मुदितमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028266, "chapter_id": 1611, "verse_number": "३-२४९-१३", "content_sanskrit": "ततः समन्तात्पश्यामः शरजालेन वेष्टितम्।\nअमानुषाणि चास्त्राणि प्रयुञ्जानं घनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028267, "chapter_id": 1611, "verse_number": "३-२४९-१४", "content_sanskrit": "समावृता दिशो दृष्ट्वा पाण्डवेन शितैः शरैः।\nधनंजयसखाऽऽत्मानं दर्शयामास वै तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028268, "chapter_id": 1611, "verse_number": "३-२४९-१५", "content_sanskrit": "चित्रसेनः पाण्डवेन समाश्लिष्य परस्परम्।\nकुशलं परिपप्रच्छ तैः पृष्टश्चाप्यनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028269, "chapter_id": 1611, "verse_number": "३-२४९-१६", "content_sanskrit": "ते समेत्य तथाऽन्योन्यं सन्नाहान्विप्रमुच्य च।\nएकीभूतास्ततो वीरा गन्धर्वाः सह पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028270, "chapter_id": 1611, "verse_number": "३-२४९-१७", "content_sanskrit": "`परस्परं समागम्य प्रीत्या परमया युतौ।\nअपूजयेतामन्योन्यं चित्रसेनधनंजयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028271, "chapter_id": 1611, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि एकोनपञ्चाशदधिकद्विशततमोऽध्यायः ॥ २४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]