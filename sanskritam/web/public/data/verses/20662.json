[{"id": 7000662000, "chapter_id": 20662, "verse_number": "६-५-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nकः पितृव्यः सिंधुसूनोः किं वृत्तं तस्य विग्रहे ।\nयुयुधे स कथं दैत्यस्तन्मे कथय नारद ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000662001, "chapter_id": 20662, "verse_number": "६-५-२", "content_sanskrit": "नारद उवाच ।\nशृणु त्वं नृपशार्दूल पितृव्यः क्षीरसागरः ।\nजालंधरस्य तं देवैः प्रमथ्य धनमाहृतम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000662002, "chapter_id": 20662, "verse_number": "६-५-३", "content_sanskrit": "श्रीचंद्रामृतनागाश्वपूर्वं तस्य सुरासुरैः ।\nतच्छ्रुत्वा विग्रहं चक्रे देवैर्जालंधरोऽसुरः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000662003, "chapter_id": 20662, "verse_number": "६-५-४", "content_sanskrit": "कदाचित्प्रेषयामास दूतं दुर्वारणं बली ।\nशिक्षयित्वा तु वक्तव्यं देवेंद्रभवनं प्रति ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000662004, "chapter_id": 20662, "verse_number": "६-५-५", "content_sanskrit": "अथ स्यंदनमारुह्य ययौ दुर्वारणो दिवि ।\nप्रवेष्टुकामो भवनं द्वारस्थैर्द्वारि निवारितः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000662005, "chapter_id": 20662, "verse_number": "६-५-६", "content_sanskrit": "दूत उवाच ।\nजालंधरस्य दूतोऽहं आगतः शक्रसंनिधौ ।\nगत्वा तत्र भवंतो मां विज्ञापयितुमर्हथ ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000662006, "chapter_id": 20662, "verse_number": "६-५-७", "content_sanskrit": "इति तस्य वचः श्रुत्वा तदैव तु शचीपतिम् ।\nगत्वा च प्रणिपत्याह दूतो देवागतो भुवः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000662007, "chapter_id": 20662, "verse_number": "६-५-८", "content_sanskrit": "दौवारिको महेंद्रेण प्रत्युक्तो दूतमानय ।\nहस्ते गृहीत्वा तं दूतं वासवांतिकमानयत् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000662008, "chapter_id": 20662, "verse_number": "६-५-९", "content_sanskrit": "दुर्वारणो देवसभां प्रविष्टः प्रव्यलोकयत् ।\nहरिं देवैस्तु यस्त्रिंशत्कोटिभिः परिवेष्टितम् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000662009, "chapter_id": 20662, "verse_number": "६-५-१०", "content_sanskrit": "स्वर्णसिंहासनं दिव्यं चामरानिलसेवितम् ।\nशचीप्रेमरसोत्फुल्लनयनाब्जसहस्रकम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000662010, "chapter_id": 20662, "verse_number": "६-५-११", "content_sanskrit": "दुर्वारणोऽथ देवेशं विलोक्य गुरुणा सह ।\nप्रणनामात्मगर्वेण प्रहसन्नयनश्रियम् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000662011, "chapter_id": 20662, "verse_number": "६-५-१२", "content_sanskrit": "निर्दिष्टमासनं भेजे दूतो जालंधरस्य सः ।\nकस्य त्वं केन कार्येण प्राप्तः प्राहेति तं हरिः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000662012, "chapter_id": 20662, "verse_number": "६-५-१३", "content_sanskrit": "दूतो जालंधरस्याहं स जगाद पुरंदरम् ।\nस राजा सर्वलोकानां तस्याज्ञां शृणु मन्मुखात् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000662013, "chapter_id": 20662, "verse_number": "६-५-१४", "content_sanskrit": "पितृव्यो मम दुग्धाब्धिस्त्वया कस्माद्विलोडितः ।\nमंदराद्रिविधानेन हृतं कोशं महाधनम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000662014, "chapter_id": 20662, "verse_number": "६-५-१५", "content_sanskrit": "श्रीचंद्रामृतनागाश्वं तन्मणिं विद्रुमादिकम् ।\nदेहि सर्वं तथा स्वर्गं शीघ्रं त्यज पुरंदर ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000662015, "chapter_id": 20662, "verse_number": "६-५-१६", "content_sanskrit": "स त्वं मद्वचनात्तूर्णं कुरु सर्वं यथोचितम् ।\nतं क्षमापय भूपाल यदि जीवितुमिच्छसि ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000662016, "chapter_id": 20662, "verse_number": "६-५-१७", "content_sanskrit": "अथ प्रहस्य मघवा प्राह दुर्वारणं प्रति ।\nशृणु दूत समासेन सिंधोर्मथनकारणम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000662017, "chapter_id": 20662, "verse_number": "६-५-१८", "content_sanskrit": "पुरा हिमवतः सूनुर्मैनाको नाम मे रिपुः ।\nस कुक्षौ विधृतस्तेन सागरेण जडेन च ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000662018, "chapter_id": 20662, "verse_number": "६-५-१९", "content_sanskrit": "दग्धं चराचरं येन वह्निना हयरूपिणा ।\nस चापि विधृतस्तेन सागरेण दुरात्मना ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000662019, "chapter_id": 20662, "verse_number": "६-५-२०", "content_sanskrit": "धर्मद्विषां दानवानामसौ वै आश्रयः प्रभुः ।\nनित्यं दधि घृतं क्षीरं दानवेभ्यः प्रयच्छति ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000662020, "chapter_id": 20662, "verse_number": "६-५-२१", "content_sanskrit": "अतएवायमस्माभिः दुर्वारण विलोडितः ।\nदंडितश्च गतश्रीको देवैरथ पुरातनैः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000662021, "chapter_id": 20662, "verse_number": "६-५-२२", "content_sanskrit": "शृणु दूत सबंधेन मम विप्रेण शोषितः ।\nकुंभोद्भवेन किंचैष दुःसंगे नैव बाध्यते ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000662022, "chapter_id": 20662, "verse_number": "६-५-२३", "content_sanskrit": "सोऽपि युद्धार्थमस्माभिः सर्वसैन्येन संवृतः ।\nआगमिष्यति वै नाशं गमिष्यति तदैव हि ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000662023, "chapter_id": 20662, "verse_number": "६-५-२४", "content_sanskrit": "इतीरयित्वा विरराम वृत्रहा सरित्पतेरात्मजदूतमुच्चकैः ।\nशशंस चागत्य समुद्रसूनोर्देवेश्वरेणोक्तमशेषमादितः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000662024, "chapter_id": 20662, "verse_number": "६-५-२५", "content_sanskrit": "नारद उवाच ।\nमहेंद्र वचनं श्रुत्वा निजदूतमुखेन च ।\nसमुद्रसूनुः संक्रुद्धः सर्वं सैन्यं समाह्वयत् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000662025, "chapter_id": 20662, "verse_number": "६-५-२६", "content_sanskrit": "रसातलस्थिता दैत्याः ये च भूतलवासिनः ।\nआययुः सबलास्तत्र जालंधरमथाज्ञया ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000662026, "chapter_id": 20662, "verse_number": "६-५-२७", "content_sanskrit": "प्रयाणप्रक्रमे सिंधुसूनोः सैन्यस्य गर्जितैः ।\nस्फुटंति नभसो राजन्पातालमखिला दिशः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000662027, "chapter_id": 20662, "verse_number": "६-५-२८", "content_sanskrit": "हयनागोष्ट्रवदना बिडालमुखभीषणाः ।\nव्याघ्रसिंहाखुवदना विद्युत्सदृशलोचनाः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000662028, "chapter_id": 20662, "verse_number": "६-५-२९", "content_sanskrit": "सर्पकेशा महादेहाः केचित्खङ्गतनूरुहाः ।\nअन्ये च परिधावंति गर्जंति जलदस्वनैः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000662029, "chapter_id": 20662, "verse_number": "६-५-३०", "content_sanskrit": "रथगजहयपत्तिसंकुलं समरविनोदकदंब भासुरम् ।\nअब्जशतसहस्रकोटिनायकं बलमखिलं च तदा रराज राजन् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000662030, "chapter_id": 20662, "verse_number": "६-५-३१", "content_sanskrit": "शतयोजनविस्तीर्णं विमानं हंसकोटिभिः ।\nयुक्तं भूतिसहस्रौघं सर्ववस्तुप्रपूरितम् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000662031, "chapter_id": 20662, "verse_number": "६-५-३२", "content_sanskrit": "तद्विमानं समारुह्य सद्यो जालंधरो ययौ ।\nमध्याह्ने मंदरं प्राप्तः प्रथमेऽह्नि बलैः सह ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000662032, "chapter_id": 20662, "verse_number": "६-५-३३", "content_sanskrit": "खंडितं शिबिकावाहैर्दलितं भूरिकुंजरैः ।\nद्वितीये दिवसे मेरुं संप्राप्तो बलसंयुतः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000662033, "chapter_id": 20662, "verse_number": "६-५-३४", "content_sanskrit": "इलावृत्ते तु शिखरे तस्थौ तत्कटकं महत् ।\nअथ दैत्याधिपैर्भग्नं खांडवं नंदनं वनम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000662034, "chapter_id": 20662, "verse_number": "६-५-३५", "content_sanskrit": "शिखराणि विशीर्णानि मेरोर्दानवपुंगवैः ।\nसंतानकेषु वृक्षेषु बद्धा हिंदोलमंचकान् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000662035, "chapter_id": 20662, "verse_number": "६-५-३६", "content_sanskrit": "सिद्धांगनाभिः सहिता रेमिरे दैत्यपुंगवाः ।\nकुचकुंकुमतांबूल चंदनागरुभूषणैः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000662036, "chapter_id": 20662, "verse_number": "६-५-३७", "content_sanskrit": "केशपाशच्युतैः पुष्पैः मेरोः संपूरिता नदी ।\nसुमेरोः पूर्वदिग्भागो गजैस्तस्य विघट्टितः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000662037, "chapter_id": 20662, "verse_number": "६-५-३८", "content_sanskrit": "दक्षिणं च रथैश्चेरुरुत्तरं पश्चिमं भटैः ।\nअथ प्रस्थापयामास दैत्याञ्जालधरोऽसुरः ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000662038, "chapter_id": 20662, "verse_number": "६-५-३९", "content_sanskrit": "महेंद्रशिखरं चान्ये ययुर्दुंदुभिनिःस्वनैः ।\nराजराजपुरीं भंक्त्वा यमस्य वरुणस्य च ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000662039, "chapter_id": 20662, "verse_number": "६-५-४०", "content_sanskrit": "अन्येषां लोकपालानामाययुस्तेऽमरावतीम् ।\nअथोत्पाताभवन्नाके दिव्यभौमांतरिक्षगाः ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000662040, "chapter_id": 20662, "verse_number": "६-५-४१", "content_sanskrit": "रजः पपात बहुलं तमस्तोमो विजृंभते ।\nतदा पपात कुलिशं करादिंद्रस्य निष्प्रभम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000662041, "chapter_id": 20662, "verse_number": "६-५-४२", "content_sanskrit": "दृष्ट्वा निमित्तानि भयावहानि नाके महेंद्रो गुरुमित्युवाच ।\nकिं कुर्महे कं शरणं च यामस्तं पश्य युद्धं समुपस्थितं च ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000662042, "chapter_id": 20662, "verse_number": "६-५-४३", "content_sanskrit": "ततो वाचस्पतिर्वाक्यमुवाच त्रिदशाधिपम् ।\nचरणौ पाहि शरणं विष्णोर्वैकुंठवासिनः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000662043, "chapter_id": 20662, "verse_number": "६-५-४४", "content_sanskrit": "इत्युक्तो गुरुणा देवैः साकं वैकुंठमंदिरम् ।\nजगामाखंडलः शीघ्रं शरणं कैटभद्विषः ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000662044, "chapter_id": 20662, "verse_number": "६-५-४५", "content_sanskrit": "शशंस वासुदेवाय विजयो द्वारपालकः ।\nजालंधरभयत्रस्ताः सर्वे देवाः समागताः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000662045, "chapter_id": 20662, "verse_number": "६-५-४६", "content_sanskrit": "श्रीरुवाच ।\nन वध्योऽसौ मम भ्राता देवार्थे युध्यता त्वया ।\nशापितो देव मत्प्रीत्या वधार्हो न भविष्यति ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000662046, "chapter_id": 20662, "verse_number": "६-५-४७", "content_sanskrit": "इति श्रीवचनं श्रुत्वा विष्णुस्त्रैलोक्यपालकः ।\nअथारुरोह गरुडं पक्षक्षेपावृतांबरम् ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000662047, "chapter_id": 20662, "verse_number": "६-५-४८", "content_sanskrit": "वैकुंठभवनात्तूर्णं निर्गतस्त्रिदशान्हरिः ।\nजालंधरभयत्रस्तान्गतकांतीनथैक्षत ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000662048, "chapter_id": 20662, "verse_number": "६-५-४९", "content_sanskrit": "ददृशुस्ते सुराः सर्वे हरिं सांद्रघनोपमम् ।\nशार्ङ्गशंखगदापद्मविभूषितचतुर्भुजम् ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000662049, "chapter_id": 20662, "verse_number": "६-५-५०", "content_sanskrit": "स्तोत्रं पठित्वा पुरतः प्राहेंद्रः सरितांपतेः ।\nजालंधरेणात्मजेन भग्नं देव त्रिविष्टपम् ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000662050, "chapter_id": 20662, "verse_number": "६-५-५१", "content_sanskrit": "तदिंद्रवचनं श्रुत्वाऽभयं दत्वा दिवौकसाम् ।\nविजेतुमसुरं देवैः सह रेजे सुरांतकृत् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000662051, "chapter_id": 20662, "verse_number": "६-५-५२", "content_sanskrit": "अथानीतं मातलिना रथमारुह्य वासवः ।\nवासुदेवस्य पुरतः प्रययौ विधृताशनिः ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000662052, "chapter_id": 20662, "verse_number": "६-५-५३", "content_sanskrit": "वामतस्त्रिदशाः सर्वे सव्यतश्च समाययौ ।\nस्वाहाप्रियो दक्षिणतः स च मेषं समास्थितः ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000662053, "chapter_id": 20662, "verse_number": "६-५-५४", "content_sanskrit": "आरुह्यैरावतं नागं जयंतः शक्रनंदनः ।\nउच्चैःश्रवसमिंद्रश्च उभौ भगवतः पुरः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000662054, "chapter_id": 20662, "verse_number": "६-५-५५", "content_sanskrit": "धातार्यमा च मित्रश्च वरुणोंशो भगस्तथा ।\nइंद्रो विवस्वान्पूषा च पर्जन्यो दशमः स्मृतः ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000662055, "chapter_id": 20662, "verse_number": "६-५-५६", "content_sanskrit": "ततस्त्वष्टा ततो विष्णू रेजे धन्यो जघन्यजः ।\nइत्येते द्वादशादित्या इंद्रस्य पुरतः स्थिताः ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000662056, "chapter_id": 20662, "verse_number": "६-५-५७", "content_sanskrit": "वीरभद्रश्च शंभुश्च गिरिशश्च महायशाः ।\nअजैकपादहिर्बुध्न्यः पिनाकी चापराजितः ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000662057, "chapter_id": 20662, "verse_number": "६-५-५८", "content_sanskrit": "भुवनाधीश्वरश्चैव कपाली च विशांपते ।\nस्थाणुर्भगश्च भगवान्रुद्रा एकादश स्मृताः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000662058, "chapter_id": 20662, "verse_number": "६-५-५९", "content_sanskrit": "श्वसनः स्पर्शनो वायुरनिलो मारुतस्तथा ।\nप्राणापानौ सजीवौ च मरुतोऽष्टौ तदग्रतः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000662059, "chapter_id": 20662, "verse_number": "६-५-६०", "content_sanskrit": "विवस्वानपि तन्मध्ये ययौ द्वादशमूर्तिभिः ।\nधनदः शिबिकारूढः किंनरेशो ययौ तदा ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000662060, "chapter_id": 20662, "verse_number": "६-५-६१", "content_sanskrit": "रुद्राश्च वृषभारूढा मारुतो मृगवाहनः ।\nययुः सैन्यस्य पुरतः त्रिशूलपरिघायुधाः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000662061, "chapter_id": 20662, "verse_number": "६-५-६२", "content_sanskrit": "गंधर्वाश्चारणा यक्षाः पिशाचोरग गुह्यकाः ।\nसर्वसैन्यस्य पुरतः सर्वशस्त्रभृतो ययुः ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000662062, "chapter_id": 20662, "verse_number": "६-५-६३", "content_sanskrit": "पूर्वापरौ तोयराशी समाक्रांतौ च सैनिकैः ।\nतस्मिन्ससार भूमिराट्वराहवपुषा हरिः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000662063, "chapter_id": 20662, "verse_number": "६-५-६४", "content_sanskrit": "स्वर्गादागत्य वेगेन दैत्यसैन्यजिघांसया ।\nसुमेरोरुत्तरो भागः सुरसैन्येन संवृतः ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000662064, "chapter_id": 20662, "verse_number": "६-५-६५", "content_sanskrit": "सेनाभारोद्भुतकरस्तस्थौ जालंधरस्य च ।\nआश्रित्य दक्षिणं भागं तूर्णं कनकशृंगतः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000662065, "chapter_id": 20662, "verse_number": "६-५-६६", "content_sanskrit": "अहोरात्रेण विहिता वर्षे तस्मिन्निलावृते ।\nमेरुमंदरयोर्मध्ये युद्धभूमिः प्रतिष्ठिता ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000662066, "chapter_id": 20662, "verse_number": "६-५-६७", "content_sanskrit": "तत्रात्मजयदां भूमिं कविप्रोक्तां मुदायुताः ।\nजग्मुस्ते दानवास्तूर्णं गुरुप्रोक्तां ययुः सुराः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000662067, "chapter_id": 20662, "verse_number": "६-५-६८", "content_sanskrit": "रथप्रवीरैः परितश्च संप्लवैर्गजैर्घनाकारमदप्रवाहिभिः ।\nअश्वैरनंतैर्गरुडाग्रगामिभिः पदातिभिः सारणभूर्भृता बभौ ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000662068, "chapter_id": 20662, "verse_number": "६-५-६९", "content_sanskrit": "ततो वादित्रनिर्घोषः सेनयोरुभयोरभूत् ।\nकोलाहलश्च वीराणामन्योन्यमभिगर्जताम् ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000662069, "chapter_id": 20662, "verse_number": "६-५-७०", "content_sanskrit": "अथ दानवदेवानां संग्रामोऽभूद्भयावहः ।\nसर्वसैन्यस्य संमर्दो यथा त्रिभुवनक्षयः ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000662070, "chapter_id": 20662, "verse_number": "६-५-७१", "content_sanskrit": "भयक्रांता महाश्रांता श्रुतिर्विलपती मुहुः ।\nस्वरथाकाररहितं शरैः संपूरितं तदा ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000662071, "chapter_id": 20662, "verse_number": "६-५-७२", "content_sanskrit": "रोमांचिता बभौ द्यौश्च रजोवस्त्रं विधुन्वती ।\nरौद्रैर्विहंगमारावैस्त्रासादाक्रंदतीव हि ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000662072, "chapter_id": 20662, "verse_number": "६-५-७३", "content_sanskrit": "देवेंद्रेण तदाज्ञप्ता मेघाः संवर्तकादयः ।\nगजानुच्चैः समारुह्य तेऽसुरान्युयुधुर्मृधे ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000662073, "chapter_id": 20662, "verse_number": "६-५-७४", "content_sanskrit": "देवानामश्वारोहाश्च जाता गंधर्वकिन्नराः ।\nरथिनः साध्यसिद्धाश्च गजिनो यक्षचारणाः ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000662074, "chapter_id": 20662, "verse_number": "६-५-७५", "content_sanskrit": "पदातिनः किंपुरुषाः पन्नगाः पवनाशनाः ।\nरोगाणामधिपो राजन्यक्ष्मा च यमनायकः ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000662075, "chapter_id": 20662, "verse_number": "६-५-७६", "content_sanskrit": "तत्र दानवरोगाणां संग्रामोऽभूत्सुदारुणः ।\nपतिता लुलुठुर्भूमौ दैत्याः शूलज्वरामयैः ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000662076, "chapter_id": 20662, "verse_number": "६-५-७७", "content_sanskrit": "दानवैर्निहता रोगाः पेतुः समरमूर्द्धनि ।\nपलायांचक्रिरे केचित्व्याधयो भूधरान्प्रति ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000662077, "chapter_id": 20662, "verse_number": "६-५-७८", "content_sanskrit": "औषध्यस्तत्र सहजा वैशल्यकरणीमुखाः ।\nताभिर्विशल्याः सैन्येषु युयुधुर्यमकिंकराः ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000662078, "chapter_id": 20662, "verse_number": "६-५-७९", "content_sanskrit": "दानवैर्निहताः सर्वे शरमुद्गरपट्टिशैः ।\nपदातयः पत्तिगणैः खङ्गैस्तीक्ष्णैः परश्वधैः ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000662079, "chapter_id": 20662, "verse_number": "६-५-८०", "content_sanskrit": "कोटिशो जघ्नुरन्योन्यं रुधिरारुणविग्रहाः ।\nअश्वचारा हयैस्तूर्णैश्चिक्षिपुर्गगने तदा ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000662080, "chapter_id": 20662, "verse_number": "६-५-८१", "content_sanskrit": "संश्लिष्य जघ्नुरन्योन्यं रुधिरारुणविग्रहाः ।\nसमूहो रथिनां भीमो रथौघैश्छाद्य मेदिनीम् ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000662081, "chapter_id": 20662, "verse_number": "६-५-८२", "content_sanskrit": "विव्यधुर्निशितैर्बाणैर्धनुर्मुक्तैर्महारथान् ।\nमदक्षीणकपोलांगाः करैर्बद्धा करान्दृढम् ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000662082, "chapter_id": 20662, "verse_number": "६-५-८३", "content_sanskrit": "गजान्प्रतिगजाः क्रुद्धाः पातयंति महीतले ।\nकोपि दैत्यो रथं दोर्भ्यामुत्क्षिप्योत्थाय खं ययौ ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000662083, "chapter_id": 20662, "verse_number": "६-५-८४", "content_sanskrit": "अश्वचारान्हयान्नागान्पातयामास भूतले ।\nस्कंधे गृहीत्वा तरसा ययौ जालंधरं प्रति ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000662084, "chapter_id": 20662, "verse_number": "६-५-८५", "content_sanskrit": "कक्षयोर्वै गजौ गृह्य तृतीयं जठरोपरि ।\nचतुर्थं मस्तके गृह्य रणे धावति कश्चन ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000662085, "chapter_id": 20662, "verse_number": "६-५-८६", "content_sanskrit": "उत्पाट्य कोशतः खङ्गं विधूय विमलांबरम् ।\nययौ सहस्रशो देवान्पातयित्वा रणेऽसुरः ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000662086, "chapter_id": 20662, "verse_number": "६-५-८७", "content_sanskrit": "काचित्पीनस्तनी तन्वी खेचरीरति लंपटा ।\nआगत्य गगनात्तूर्णं निन्ये दैत्यं रणांगणात् ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000662087, "chapter_id": 20662, "verse_number": "६-५-८८", "content_sanskrit": "चुचुंब सा तद्वदनं तीक्ष्णनाराचकीलितम् ।\nदेवसैन्यं ततो बद्ध्वा कालनेमिर्ननर्त्त ह ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000662088, "chapter_id": 20662, "verse_number": "६-५-८९", "content_sanskrit": "ततो जनार्दनः क्रुद्धो निर्ययौ कालनेमिनम् ।\nयमो दुर्वारणं वीरं स्वर्भानुश्चंद्रभास्करौ ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000662089, "chapter_id": 20662, "verse_number": "६-५-९०", "content_sanskrit": "केतुं वैश्वानरो देवो ययौ शुक्रं बृहस्पतिः ।\nआश्विनौ संयतौ तत्र दैत्यमंगारपर्णकम् ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000662090, "chapter_id": 20662, "verse_number": "६-५-९१", "content_sanskrit": "संह्रादं शक्रपुत्रश्च निर्ह्रादं धनदो ययौ ।\nनिशुंभश्चावृतो रुद्रैः शुंभो वसुभिराहवे ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000662091, "chapter_id": 20662, "verse_number": "६-५-९२", "content_sanskrit": "मेघाकारं स्थितं जंभं विश्वेदेवाः समाययौ ।\nवायवो वज्ररोमाणमथ मृत्युर्मयं ययौ ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000662092, "chapter_id": 20662, "verse_number": "६-५-९३", "content_sanskrit": "नमुचिं वासवो व्यग्रं शक्तिहस्तोऽभ्यधावत ।\nअन्यैरपि सुरैर्दैत्याः स्वस्ववीर्यसमैर्वृताः ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]