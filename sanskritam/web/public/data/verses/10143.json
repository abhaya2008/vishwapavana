[{"id": 6000143000, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000143001, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.001.m4a", "display_order": 2}, {"id": 6000143002, "chapter_id": 10143, "verse_number": "७-५-१", "content_sanskrit": "पौरोहित्याय भगवान् वृतः काव्यः किलासुरैः।\nशण्डामर्कौ सुतौ तस्य दैत्यराजगृहान्तिके॥ ७/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.002.m4a", "display_order": 3, "topics": [{"text": "हिरण्यकशिपुना ‘गुरोः सकाशाद्यदधीतं तत्कथय’ इत्युक्तेन प्रह्लादेन ‘विष्णौ भक्तिरवश्यं कर्तव्या’ इति कथनम्", "range": "१–३३"}]}, {"id": 6000143003, "chapter_id": 10143, "verse_number": "७-५-२", "content_sanskrit": "तौ राज्ञा प्रापितं बालं प्रह्लादं नयकोविदम्।\nपाठयामासतुः पाठ्यानन्यांश्चासुरबालकान्॥ ७/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.003.m4a", "display_order": 4}, {"id": 6000143004, "chapter_id": 10143, "verse_number": "७-५-३", "content_sanskrit": "यत् तत्र गुरुणा प्रोक्तं शुश्रुवे न पपाठ ह।\nन साधु मनसा मेने स्वरूपासद्ग्रहाश्रयम्॥ ७/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.004.m4a", "display_order": 5}, {"id": 6000143005, "chapter_id": 10143, "verse_number": "७-५-४", "content_sanskrit": "एकदाऽसुरराट् पुत्रमङ्कमारोप्य पाण्डव।\nपप्रच्छ कथ्यतां वत्स मन्यते साधु यद् भवान्॥ ७/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.005.m4a", "display_order": 6}, {"id": 6000143006, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.006.m4a", "display_order": 7}, {"id": 6000143007, "chapter_id": 10143, "verse_number": "७-५-५", "content_sanskrit": "तत् साधु मन्येऽसुरवर्य देहिनां सदा समुद्विग्नधियामसद्ग्रहात्।\nहित्वाऽऽत्मपातं गृहमन्धकूपं वनं गतो यद्धरिमाश्रयेत॥ ७/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.007.m4a", "display_order": 8}, {"id": 6000143008, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.008.m4a", "display_order": 9}, {"id": 6000143009, "chapter_id": 10143, "verse_number": "७-५-६", "content_sanskrit": "श्रुत्वा पुत्रगिरो दैत्यः परपक्षसमीहिताः।\nजहास बुद्धिर्बालानां भिद्यते परबुद्धिभिः॥ ७/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.009.m4a", "display_order": 10}, {"id": 6000143010, "chapter_id": 10143, "verse_number": "७-५-७", "content_sanskrit": "सम्यग् विधार्यतां बालो गुरुगेहे द्विजातिभिः।\nविष्णुपक्षप्रतिच्छन्नैर्न भिद्येतास्य धीर्यथा॥ ७/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.010.m4a", "display_order": 11}, {"id": 6000143011, "chapter_id": 10143, "verse_number": "७-५-८", "content_sanskrit": "गृहमानीतमाहूय प्रह्लादं दैत्ययाजकाः।\nप्रशस्य श्लक्ष्णया वाचा समपृच्छन्त सामभिः॥ ७/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.011.m4a", "display_order": 12}, {"id": 6000143012, "chapter_id": 10143, "verse_number": "७-५-९", "content_sanskrit": "वत्स प्रह्लाद भद्रं ते सत्यं कथय मा मृषा।\nबालानति कुतस्तुभ्यमेष बुद्धिविपर्ययः॥ ७/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.012.m4a", "display_order": 13}, {"id": 6000143013, "chapter_id": 10143, "verse_number": "७-५-१०", "content_sanskrit": "बुद्धिभेदः परकृत उताहो ते स्वतो भवेत्।\nभण्यतां श्रोतुकामानां गुरूणां कुलनन्दन॥ ७/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.013.m4a", "display_order": 14}, {"id": 6000143014, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.014.m4a", "display_order": 15}, {"id": 6000143015, "chapter_id": 10143, "verse_number": "७-५-११", "content_sanskrit": "परः स्वश्चेत्यसद्ग्राहः पुंसां यन्मायया कृतः।\nविमोहितधियां दृष्टः तस्मै भगवते नमः॥ ७/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.015.m4a", "display_order": 16}, {"id": 6000143016, "chapter_id": 10143, "verse_number": "७-५-१२", "content_sanskrit": "स यदाऽनुगतः पुंसां पशुबुद्धिर्विभिद्यते।\nअन्य एष तथाऽन्योऽहमिति देहगताऽसती॥ ७/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.016.m4a", "display_order": 17}, {"id": 6000143017, "chapter_id": 10143, "verse_number": "७-५-१३", "content_sanskrit": "स एष आत्मा स्वपरेत्यबुद्धिभिर्दुरन्वयानुक्रमणो निरुच्यते।\nमुह्यन्ति यद्वर्त्मनि वेदवादिनो ब्रह्मादयो ह्येष भिनत्ति मे मतिम्॥ ७/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.017.m4a", "display_order": 18}, {"id": 6000143018, "chapter_id": 10143, "verse_number": "७-५-१४", "content_sanskrit": "यथा भ्राम्यत्ययो ब्रह्मन् स्वयमाकर्षसन्निधौ।\nतथा मे भिद्यते चेतश्चक्रपाणौ यदृच्छया॥ ७/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.018.m4a", "display_order": 19}, {"id": 6000143019, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.019.m4a", "display_order": 20}, {"id": 6000143020, "chapter_id": 10143, "verse_number": "७-५-१५", "content_sanskrit": "एतावद् ब्राह्मणायोक्त्वा विरराम महामतिः।\nतं निर्भर्त्स्याथ कुपितः सुदीनो राजसेवकः॥ ७/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.020.m4a", "display_order": 21}, {"id": 6000143021, "chapter_id": 10143, "verse_number": "७-५-१६", "content_sanskrit": "आनीयतामरे वेत्रमस्माकमयशस्कृतः।\nकुलाङ्गारस्य दुर्बुद्धेश्चतुर्थोऽस्योदितो दमः॥ ७/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.021.m4a", "display_order": 22}, {"id": 6000143022, "chapter_id": 10143, "verse_number": "७-५-१७", "content_sanskrit": "दैतेयचन्दनवने जातोऽयं कण्टकद्रुमः।\nतन्मूलोन्मूलपरशोर्विष्णोर्नालायितोऽर्भकः॥ ७/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.022.m4a", "display_order": 23}, {"id": 6000143023, "chapter_id": 10143, "verse_number": "७-५-१८", "content_sanskrit": "इति तं विविधोपायैर्भीषयन् तर्जनादिभिः।\nप्रह्लादं ग्राहयामास त्रिवर्गस्योपपादनम्॥ ७/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.023.m4a", "display_order": 24}, {"id": 6000143024, "chapter_id": 10143, "verse_number": "७-५-१९", "content_sanskrit": "तत एनं गुरुर्ज्ञात्वा ज्ञातज्ञेयचतुष्टयम्।\nदैत्येन्द्रं दर्शयामास मातृमृष्टमलंकृतम्॥ ७/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.024.m4a", "display_order": 25}, {"id": 6000143025, "chapter_id": 10143, "verse_number": "७-५-२०", "content_sanskrit": "पादयोः पतितं बालं प्रतिनन्द्याशिषाऽसुरः।\nपरिष्वज्य चिरं दोर्भ्यां परमामाप निर्वृतिम्॥ ७/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.025.m4a", "display_order": 26}, {"id": 6000143026, "chapter_id": 10143, "verse_number": "७-५-२१", "content_sanskrit": "आरोप्याङ्कमवघ्राय मूर्धन्यश्रुकलाम्बुभिः।\nआसिञ्चन् विकसद्वक्त्रमिदमाह युधिष्ठिर॥ ७/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.026.m4a", "display_order": 27}, {"id": 6000143027, "chapter_id": 10143, "verse_number": "७-५-२२", "content_sanskrit": "प्रह्लादानूद्यतां१ तात स्वधीतं किञ्चिदुत्तमम्।\nकालेनैतावताऽऽयुष्मन् यदशिक्षद् गुरोर्भवान्॥ ७/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.027.m4a", "display_order": 28}, {"id": 6000143028, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.028.m4a", "display_order": 29}, {"id": 6000143029, "chapter_id": 10143, "verse_number": "७-५-२३", "content_sanskrit": "श्रवणं कीर्तनं विष्णोः स्मरणं पादसेवनम्।\nअर्चनं वन्दनं दास्यं सख्यमात्मनिवेदनम्॥ ७/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.029.m4a", "display_order": 30}, {"id": 6000143030, "chapter_id": 10143, "verse_number": "७-५-२४", "content_sanskrit": "इति पुंसाऽर्पिता विष्णौ भक्तिश्चेन्नवलक्षणा।\nक्रियते भगवत्यद्धा तन्मन्येऽधीतमुत्तमम्॥ ७/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.030.m4a", "display_order": 31}, {"id": 6000143031, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.031.m4a", "display_order": 32}, {"id": 6000143032, "chapter_id": 10143, "verse_number": "७-५-२५", "content_sanskrit": "निशम्यैतत् सुतवचो हिरण्यकशिपुस्तदा।\nगुरुपुत्रमुवाचेदं रुषा प्रस्फुरिताधरः॥ ७/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.032.m4a", "display_order": 33}, {"id": 6000143033, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.033.m4a", "display_order": 34}, {"id": 6000143034, "chapter_id": 10143, "verse_number": "७-५-२६", "content_sanskrit": "ब्रह्मबन्धो किमेतत् ते विपक्षं श्रयताऽसता।\nअसारं ग्राहितो बालो मामनादृत्य दुर्मते॥ ७/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.034.m4a", "display_order": 35}, {"id": 6000143035, "chapter_id": 10143, "verse_number": "७-५-२७", "content_sanskrit": "सन्ति ह्यसाधवो लोके दुर्मैत्राश्छद्मवेषिणः।\nतेषामुदेत्यघं काले रोगः पातकिनामिव॥ ७/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.035.m4a", "display_order": 36}, {"id": 6000143036, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "गुरुपुत्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.036.m4a", "display_order": 37}, {"id": 6000143037, "chapter_id": 10143, "verse_number": "७-५-२८", "content_sanskrit": "न मत्प्रणीतं न परप्रणीतं सुतो वदत्येष तवेन्द्रशत्रो।\nनैसर्गिकीयं मतिरस्य राजन् नियच्छ मन्युं क्‍व तदात्ममानः॥ ७/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.037.m4a", "display_order": 38}, {"id": 6000143038, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.038.m4a", "display_order": 39}, {"id": 6000143039, "chapter_id": 10143, "verse_number": "७-५-२९", "content_sanskrit": "गुरुणैवं प्रतिप्रोक्तो भूय आहासुरः सुतम्।\nन चेद्गुरुमुखीयं ते कुतो भद्रासती मतिः॥ ७/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.039.m4a", "display_order": 40}, {"id": 6000143040, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.040.m4a", "display_order": 41}, {"id": 6000143041, "chapter_id": 10143, "verse_number": "७-५-३०", "content_sanskrit": "मतिर्न कृष्णे परतः स्वतो वा मिथोऽभिपद्येत गृहव्रतानाम्।\nअदान्तगोभिर्विशतां तमिस्रं पुनः पुनश्चर्वितचर्वणानाम्॥ ७/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.041.m4a", "display_order": 42}, {"id": 6000143042, "chapter_id": 10143, "verse_number": "७-५-३१", "content_sanskrit": "न ते विदुः स्वार्थगतिं हि विष्णुं दुराशया ये बहिरर्थभावाः।\nअन्धा यथान्धैरुपनीयमाना वाचीशतन्त्यामुरुदाम्नि बद्धाः॥ ७/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.042.m4a", "display_order": 43}, {"id": 6000143043, "chapter_id": 10143, "verse_number": "७-५-३२", "content_sanskrit": "नैषां मतिस्तावदुरुक्रमाङ्घ्रिं स्पृशत्यनर्थापगमो यदुत्थः।\nमहीयसां पादरजोऽभिषेकं निष्किञ्चनानां न वृणीत यावत्॥ ७/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.043.m4a", "display_order": 44}, {"id": 6000143044, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.044.m4a", "display_order": 45}, {"id": 6000143045, "chapter_id": 10143, "verse_number": "७-५-३३", "content_sanskrit": "इत्युक्त्वोपरतं पुत्रं हिरण्यकशिपू रुषा। अन्धीकृतात्मा स्वोत्सङ्गान्निरस्यत महीतले।\nआहामर्षरुषाऽऽविष्टः कषायीकृतलोचनः॥ ७/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.045.m4a", "display_order": 46}, {"id": 6000143046, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.046.m4a", "display_order": 47}, {"id": 6000143047, "chapter_id": 10143, "verse_number": "७-५-३४", "content_sanskrit": "वध्यतामाश्वयं वध्यो निस्सारयत नैर्ऋताः।\nअयं मे भ्रातृहा शोच्यो हित्वा स्वान् सुहृदोऽधमः॥ ७/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.047.m4a", "display_order": 48, "topics": [{"text": "प्रह्लादस्य विष्णुभक्तत्वं ज्ञात्वा क्रुद्धेन हिरण्यकशिपुना नानाप्रकारैः तद्धननप्रयत्नः", "range": "३४–५६"}]}, {"id": 6000143048, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "पितृव्यहन्तुः पादौ यो विष्णोर्दासवदर्चति।\nविष्णोर्वा साध्वसौ किं नु करिष्यत्यसमञ्जसः॥ ७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.048.m4a", "display_order": 49}, {"id": 6000143049, "chapter_id": 10143, "verse_number": "७-५-३५", "content_sanskrit": "सौहृदं दुस्त्यजं पित्रोरत्यजत् पञ्चहायनः॥ ७/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.049.m4a", "display_order": 50}, {"id": 6000143050, "chapter_id": 10143, "verse_number": "७-५-३६", "content_sanskrit": "परोऽप्यपत्यं हितकृद् यथौषधं स्वदेहजोऽप्यामयवत् सुतोऽहितः।\nछिन्द्यात् तदङ्गं यदुतात्मनोऽहितं शेषं सुखं जीवति यद्विसर्जनात्॥ ७/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.050.m4a", "display_order": 51}, {"id": 6000143051, "chapter_id": 10143, "verse_number": "७-५-३७", "content_sanskrit": "सर्वैरुपायैर्हन्तव्यः सम्भोगशयनासनैः।\nसुहृल्लिङ्गधरः शत्रुर्मुनेर्दुष्टमिवेन्द्रियम्॥ ७/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.051.m4a", "display_order": 52}, {"id": 6000143052, "chapter_id": 10143, "verse_number": "७-५-३८", "content_sanskrit": "नैर्ऋतास्ते समुद्दिष्टा भर्त्रा वै शूलपाणयः।\nतिग्मदंष्ट्राः करालास्याः ताम्रश्मश्रुशिरोरुहाः॥ ७/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.052.m4a", "display_order": 53}, {"id": 6000143053, "chapter_id": 10143, "verse_number": "७-५-३९", "content_sanskrit": "नदन्तो भैरवं नादं छिन्धि भिन्धीति वादिनः।\nआसीनं चाहनन् शूलैः प्रह्लादं सर्वमर्मसु॥ ७/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.053.m4a", "display_order": 54}, {"id": 6000143054, "chapter_id": 10143, "verse_number": "७-५-४०", "content_sanskrit": "परे ब्रह्मण्यनिर्देश्ये भगवत्यखिलात्मनि।\nयुक्तात्मन्यफला आसन्नपुण्यस्येव तत्क्रियाः॥ ७/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.054.m4a", "display_order": 55}, {"id": 6000143055, "chapter_id": 10143, "verse_number": "७-५-४१", "content_sanskrit": "प्रयासेऽपिहते तस्मिन् दैत्येन्द्रः परिशङ्कितः।\nचकार तद्वधोपायान् निर्बन्धेन युधिष्ठिर॥ ७/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.055.m4a", "display_order": 56}, {"id": 6000143056, "chapter_id": 10143, "verse_number": "७-५-४२", "content_sanskrit": "दिग्गजैर्दन्दशूकेन्द्रैरभिचारावपातनैः।\nमायाभिः सन्निरोधैश्च गरदानैरभोजनैः॥ ७/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.056.m4a", "display_order": 57}, {"id": 6000143057, "chapter_id": 10143, "verse_number": "७-५-४३", "content_sanskrit": "हिमवाय्वग्निसलिलैः पर्वताक्रमणैरपि।\nन शशाक यदा हन्तुमपापमसुरः सुतम्॥ ७/५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.057.m4a", "display_order": 58}, {"id": 6000143058, "chapter_id": 10143, "verse_number": "७-५-४४", "content_sanskrit": "चिन्तां दीर्घतमां प्राप्तस्तत्कर्तुं नाभ्यपद्यत।\nएष मे बह्वसाधूक्तो वधोपायाश्च निर्मिताः॥ ७/५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.058.m4a", "display_order": 59}, {"id": 6000143059, "chapter_id": 10143, "verse_number": "७-५-४५", "content_sanskrit": "तैस्तैर्द्रोहैरसद्धर्मैर्मुक्तः स्वेनैव तेजसा।\nवर्तमानोऽविदूरे वै बालोऽप्यजडधीरयम्॥ ७/५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.059.m4a", "display_order": 60}, {"id": 6000143060, "chapter_id": 10143, "verse_number": "७-५-४६", "content_sanskrit": "न विस्मरति मेऽनार्यं शुनःशेप इव प्रभुः।\nअप्रमेयानुभावोऽयमकुतश्चिद्भयोऽमरः॥ ७/५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.060.m4a", "display_order": 61}, {"id": 6000143061, "chapter_id": 10143, "verse_number": "७-५-४७", "content_sanskrit": "नूनमेतद्विरोधेन मृत्युर्मे भविता न वा। इति तच्चिन्तया किञ्चिन्म्लानश्रियमधोमुखम्।\nशण्डामर्कावौशनसौ विविक्त इति होचतुः॥ ७/५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.061.m4a", "display_order": 62}, {"id": 6000143062, "chapter_id": 10143, "verse_number": "७-५-४८", "content_sanskrit": "जितं त्वयैकेन जगत्त्रयं भ्रुवोर्विजृम्भणत्रस्तसमस्तधिष्ण्यपम्।\nन तस्य चिन्त्यं तव नाथ चक्ष्महे न वै शिशूनां गुणदोषयोः पदम्॥ ७/५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.062.m4a", "display_order": 63}, {"id": 6000143063, "chapter_id": 10143, "verse_number": "७-५-४९", "content_sanskrit": "इमं तु पाशैर्वरुणस्य बद्ध्वा निधेहि भीतो न पलायते यथा।\nबुद्धिश्च पुंसो वयसाऽऽर्यसेवया यावद्गुरुर्भार्गव आगमिष्यति॥ ७/५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.063.m4a", "display_order": 64}, {"id": 6000143064, "chapter_id": 10143, "verse_number": "७-५-५०", "content_sanskrit": "तथेति गुरुपुत्रोक्तमनुज्ञायेदमब्रवीत्।\nधर्मा ह्यस्योपदेष्टव्या राज्ञां ये गृहमेधिनाम्॥ ७/५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.064.m4a", "display_order": 65}, {"id": 6000143065, "chapter_id": 10143, "verse_number": "७-५-५१", "content_sanskrit": "धर्ममर्थं च कामं च नितरां चानुपूर्वशः।\nप्रह्लादायोचतू राजन् प्रश्रितावनताय च॥ ७/५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.065.m4a", "display_order": 66}, {"id": 6000143066, "chapter_id": 10143, "verse_number": "७-५-५२", "content_sanskrit": "यथा त्रिवर्गं गुरुभिरात्मने उपशिक्षितम्।\nन साधु मेने तच्छिक्षां द्वन्द्वारामोपवर्णिताम्॥ ७/५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.066.m4a", "display_order": 67}, {"id": 6000143067, "chapter_id": 10143, "verse_number": "७-५-५३", "content_sanskrit": "यदाऽऽचार्यः परावृत्तो गृहमेधीयकर्मसु।\nवयस्यैर्बालकैस्तत्र सोपहूतः कृतक्षणैः॥ ७/५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.067.m4a", "display_order": 68}, {"id": 6000143068, "chapter_id": 10143, "verse_number": "७-५-५४", "content_sanskrit": "अथ तान् श्लक्ष्णया वाचा प्रत्याहूय महाबुधः।\nउवाच विद्वान् तन्निष्ठां कृपया प्रहसन्निव॥ ७/५/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.068.m4a", "display_order": 69}, {"id": 6000143069, "chapter_id": 10143, "verse_number": "७-५-५५", "content_sanskrit": "ते तु तद्गौरवात् सर्वे त्यक्तक्रीडापरिच्छदाः।\nबाला न दूषितधियो द्वन्द्वारामेरितेहितैः॥ ७/५/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.069.m4a", "display_order": 70}, {"id": 6000143070, "chapter_id": 10143, "verse_number": "७-५-५६", "content_sanskrit": "पर्युपासत राजेन्द्र तन्न्यस्तहृदयेक्षणाः।\nतानाह करुणो मैत्रो महाभागवतोऽसुरः॥ ७/५/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_005/BhP_07.005.070.m4a", "display_order": 71}, {"id": 6000143071, "chapter_id": 10143, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]