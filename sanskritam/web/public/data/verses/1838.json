[{"id": 2038393, "chapter_id": 1838, "verse_number": "५-८३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038394, "chapter_id": 1838, "verse_number": "५-८३-१", "content_sanskrit": "या सा बाल्यात्प्रभृत्यस्मान्पर्यवर्धयताबला।\nउपवासतपःशीला सदा स्वस्त्ययने रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038395, "chapter_id": 1838, "verse_number": "५-८३-२", "content_sanskrit": "देवतातिथिपूजासु गुरुशुश्रूषणे रता।\nवत्सला प्रियपुत्रा च माताऽस्माकं जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038396, "chapter_id": 1838, "verse_number": "५-८३-३", "content_sanskrit": "सुयोधनभयाद्या नो त्रायतामित्रकर्शन ।\nमहतो मृत्युसंबाधुद्दुस्तरान्नौरिवार्णवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038397, "chapter_id": 1838, "verse_number": "५-८३-४", "content_sanskrit": "अस्मत्कृते च सततं यया दुःखानि माधव ।\nअनुभूतान्यदुःखार्हां तां स्म पृच्छेरनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038398, "chapter_id": 1838, "verse_number": "५-८३-५", "content_sanskrit": "भृशमाश्वासयेश्चैनां पुत्रशोकपरिप्लुताम् ।\nअभिवाद्य स्वजेथास्त्वं पाण्डवान्परिकीर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038399, "chapter_id": 1838, "verse_number": "५-८३-६", "content_sanskrit": "ऊढात्प्रभृति दुःखानि श्वशुराणामरिन्दम।\nनिराकाराऽतदर्हा च पश्यन्ती दुःखमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038400, "chapter_id": 1838, "verse_number": "५-८३-७", "content_sanskrit": "अपि जातु स कालः स्यात्कृष्ण दुःखविपर्ययः ।\nयदहं मातरं क्लिष्टां सुखं दद्यामरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038401, "chapter_id": 1838, "verse_number": "५-८३-८", "content_sanskrit": "प्रव्रजन्तोऽनुधावन्तीं कृपणां पुत्रगृद्धिनीम् ।\nरुदतीमपहायैनामगच्छाम वयं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038402, "chapter_id": 1838, "verse_number": "५-८३-९", "content_sanskrit": "सा नूनं म्रियते दुःखैः सा चेज्जीवति केशव।\nतथा पुत्राधिभिर्गाढमार्तामर्चय सत्कृत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038403, "chapter_id": 1838, "verse_number": "५-८३-१०", "content_sanskrit": "अभिवाद्याऽथ सा कृष्ण त्वया मद्वचवाद्विभो ।\nधृतराष्ट्रश्च कौरव्यो राजानश्च वयोधिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038404, "chapter_id": 1838, "verse_number": "५-८३-११", "content_sanskrit": "भीष्मं द्रोणं कृपं चैव महाराजं च वाह्लिकम्।\nद्रौणिं च सोमदत्तं च सर्वांश्च भरतान्पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038405, "chapter_id": 1838, "verse_number": "५-८३-१२", "content_sanskrit": "` यथावयो यथास्थानं प्रपद्यस्व जनार्दन।\nविदुरं च महाप्राज्ञं कुरूणां मन्त्रधारिणम्।\nअगाधबुद्धिं मर्मज्ञं स्वजेथा मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038406, "chapter_id": 1838, "verse_number": "५-८३-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038407, "chapter_id": 1838, "verse_number": "५-८३-१३", "content_sanskrit": "इत्युक्त्वा केशवं तत्र राजमध्ये युधिष्ठिरः।\nअनुज्ञातो निववृते कृष्णं कृत्वा प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038408, "chapter_id": 1838, "verse_number": "५-८३-१४", "content_sanskrit": "व्रजन्नेव तु बीभत्सुः सखायं पुरुषर्षभम् ।\nअब्रवीत्परवीरघ्रं दाशार्हमपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038409, "chapter_id": 1838, "verse_number": "५-८३-१५", "content_sanskrit": "यदस्माकं विभो वृत्तं पुरा वै मन्त्रनिश्चये ।\nअर्धराज्यस्य गोविद विदितं सर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038410, "chapter_id": 1838, "verse_number": "५-८३-१६", "content_sanskrit": "तच्चेद्दद्यादखङ्गेन सत्कृत्यानवमत्य च।\nप्रियं मे स्यान्महाबाहो मुच्येरन्महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038411, "chapter_id": 1838, "verse_number": "५-८३-१७", "content_sanskrit": "अतश्चेदन्यथाकर्ता धार्तराष्ट्रोऽनुपायवित्।\nअन्तं नूनं करिष्यामि क्षत्रियाणां जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038412, "chapter_id": 1838, "verse_number": "५-८३-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038413, "chapter_id": 1838, "verse_number": "५-८३-१८", "content_sanskrit": "एवमुक्ते पाण्डवेन समहृष्यद्वृकोदरः।\nमुहुर्मुहुः क्रोधवशात्प्रावेपत च पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038414, "chapter_id": 1838, "verse_number": "५-८३-१९", "content_sanskrit": "वेपमानश्च कौन्तेयः प्राक्रोशन्महतो रजन्।\nधनञ्जयवचः श्रुत्वा हर्षोत्सिक्तमना भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038415, "chapter_id": 1838, "verse_number": "५-८३-२०", "content_sanskrit": "तस्य तं निनदं श्रुत्वा संप्रावेपन्त धन्विनः ।\nवाहनानि च सर्वामि शकृन्मूत्रे प्रमुस्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038416, "chapter_id": 1838, "verse_number": "५-८३-२१", "content_sanskrit": "इत्युक्त्वा केशवं तत्र तथा चोह्वा विनिश्चयम्।\nअनुज्ञातो निववृते परिष्वज्य जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038417, "chapter_id": 1838, "verse_number": "५-८३-२२", "content_sanskrit": "तेषु राजसु सर्वेषु निवृत्तेषु जनार्दनः।\nतूर्णमभ्यगमद्धृष्टः शैब्यसुग्रीववाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038418, "chapter_id": 1838, "verse_number": "५-८३-२३", "content_sanskrit": "ते हया वासुदेवस्य दारुकेण प्रचोदिताः ।\nपन्थानमाचेमुरिव ग्रसमाना इवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038419, "chapter_id": 1838, "verse_number": "५-८३-२४", "content_sanskrit": "अथापश्यन्महाबाहुर्ऋषीनध्वनि केशवः ।\nब्राह्या श्रिया दीप्यमानान्स्थितानुभयतः पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038420, "chapter_id": 1838, "verse_number": "५-८३-२५", "content_sanskrit": "सोऽवतीर्य रथात्तूर्णमभिवाद्य जनार्दनः।\nयथावृत्तानृषीन्सर्वानभ्यभाषत पूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038421, "chapter_id": 1838, "verse_number": "५-८३-२६", "content_sanskrit": "कच्चिल्लोकेषु कुशलं कच्चिद्धर्मः स्वनुष्ठितः ।\nब्राह्मणानां त्रयो वर्णाः कच्चित्तिष्ठन्ति शासने ।\n` पितृदेवातिथिभ्यश्च कच्चित्पूता स्वनुष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038422, "chapter_id": 1838, "verse_number": "५-८३-२७", "content_sanskrit": "तेभ्यः प्रयुज्य तां पूजां प्रोवाच मधुसूदनः।\nभगवन्तः क्व संसिद्धाः कोऽवधिर्भवतामिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038423, "chapter_id": 1838, "verse_number": "५-८३-२८", "content_sanskrit": "किं वा कार्यं भगवतामहं किं करवाणि यः ।\nकेनार्थेनोपप्तंप्राप्ता भगवन्तो महीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038424, "chapter_id": 1838, "verse_number": "५-८३-२९", "content_sanskrit": "` एवमुक्ताः केशवेन मुनयः शंसितव्रताः ।\nनारदप्रमुखाः सर्वे प्रत्यनन्दन्त केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038425, "chapter_id": 1838, "verse_number": "५-८३-३०", "content_sanskrit": "अधश्शिराः सर्पमाली महर्षिः स हि देवलः ।\nअर्वावसुः सुजानुश्च मैत्रेयः शुनको बली", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038426, "chapter_id": 1838, "verse_number": "५-८३-३१", "content_sanskrit": "बको दाल्भ्यः स्थूलशिराः कृष्णद्वैपायनस्तथा।\nआपोदधौम्यो धौम्यश्च आणिमाण्डव्यकौशिकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038427, "chapter_id": 1838, "verse_number": "५-८३-३२", "content_sanskrit": "दामोष्णीषस्त्रिषवणः पर्णादो घटजानुकः।\nमौञ्जायनो वायुभक्षः पाराशर्योऽथ शालिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038428, "chapter_id": 1838, "verse_number": "५-८३-३३", "content_sanskrit": "शीलवानशनिर्धाता शून्यपालोऽकृतव्रणः।\nश्वेतकेतुः कहोलश्च रामश्चैव महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038429, "chapter_id": 1838, "verse_number": "५-८३-३४", "content_sanskrit": "तमब्रवीज्जामदग्न्य उपेत्य मधुसूदनम्।\nपरिष्वज्य च गोविन्दं सुरासुरपतेः सखा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038430, "chapter_id": 1838, "verse_number": "५-८३-३५", "content_sanskrit": "देवर्षयः पुण्यकृतो ब्राह्मणाश्च बहुश्रुताः ।\nराजर्षयश्च दाशार्ह मानयन्ति तपस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038431, "chapter_id": 1838, "verse_number": "५-८३-३६", "content_sanskrit": "दैवासुरस्य द्रुष्टारः पुराणस्य महामते।\nसमेत पार्थिवं क्षत्रं दिदृक्षन्तश्च सर्वतः।\nसभासदश्च राजानस्त्वां च सत्यं जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038432, "chapter_id": 1838, "verse_number": "५-८३-३७", "content_sanskrit": "एतन्महत्प्रेक्षणीयं द्रुष्टुमिच्छाम केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038433, "chapter_id": 1838, "verse_number": "५-८३-३८", "content_sanskrit": "धर्मार्थसहिता वाचः श्रोतुमिच्छाम माधव।\nत्वयोच्यमानाः कुरुषु राजमध्ये परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038434, "chapter_id": 1838, "verse_number": "५-८३-३९", "content_sanskrit": "` सभायां मधुरा वाचः शुश्रूषन्तस्त्वयेरिताः ।\nकुरूणां प्रतिवाचश्च श्रोतुमिच्छाम माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038435, "chapter_id": 1838, "verse_number": "५-८३-४०", "content_sanskrit": "भीष्मद्रोणादयश्चैव विदुरश्च महामतिः ।\nत्वं च यादवशार्दूल सभायां वै समेष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038436, "chapter_id": 1838, "verse_number": "५-८३-४१", "content_sanskrit": "तव वाक्यानि दिव्यानि तथा तेषां च माधव।\nश्रोतुमिच्छाम गोविन्द सत्यानि च हितानि च।\nआपृष्टोऽसि महाबाहो पुनर्द्रक्ष्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2038437, "chapter_id": 1838, "verse_number": "५-८३-४२", "content_sanskrit": "याह्यविघ्नेन वै वीर द्रक्ष्यामस्त्वां सभागतम्।\nआसीनमासने दिव्ये बलतेजःसमाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2038438, "chapter_id": 1838, "verse_number": "५-८३-४३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2038439, "chapter_id": 1838, "verse_number": "५-८३-४३", "content_sanskrit": "प्रयान्तं देवकीपुत्रं परवीररुजो दश।\nमहारथा महाबाहुमन्वयुः शस्त्रपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2038440, "chapter_id": 1838, "verse_number": "५-८३-४४", "content_sanskrit": "पदातीनां सहस्रं च सादिनां च परन्तप।\nभोज्यं च विपुलं राजन्प्रेष्याश्च शतशोपरे ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2038441, "chapter_id": 1838, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि त्र्यशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]