[{"id": 7004408000, "chapter_id": 24408, "verse_number": "५-३-१०२-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nमन्मथेशं ततो गच्छेत्सर्वदेवनमस्कृतम् ।\nस्नानमात्रान्नरो राजन्यमलोकं न पश्यति॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004408001, "chapter_id": 24408, "verse_number": "५-३-१०२-२", "content_sanskrit": "अनपत्या या च नारी स्नायाद्वै पाण्डुनन्दन ।\nपुत्रं सा लभते पार्थ सत्यसङ्घं दृढव्रतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004408002, "chapter_id": 24408, "verse_number": "५-३-१०२-३", "content_sanskrit": "तत्र स्नात्वा नरो राजञ्छुचिः प्रयतमानसः ।\nउपोष्य रजनीमेकां गोसहस्रफलं लभेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004408003, "chapter_id": 24408, "verse_number": "५-३-१०२-४", "content_sanskrit": "कामिकं तीर्थराजं तु तादृशं न भविष्यति ।\nत्रिरात्रं कुरुते राजन्स गोलक्षफलं लभेत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004408004, "chapter_id": 24408, "verse_number": "५-३-१०२-५", "content_sanskrit": "तत्र नृत्यं प्रकर्तव्यं तुष्यते परमेश्वरः ।\nगीतवादित्रनिर्घोषै रात्रौ जागरणेन च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004408005, "chapter_id": 24408, "verse_number": "५-३-१०२-६", "content_sanskrit": "एरण्ड्यां च महादेवो दृष्टो मे मन्मथेश्वरः ।\nकिं समर्थो यमो रुष्टो भद्रो भद्राणि पश्यति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004408006, "chapter_id": 24408, "verse_number": "५-३-१०२-७", "content_sanskrit": "कामेन स्थापितः शम्भुरेतस्मात्कामदो नृप ।\nसोपानः स्वर्गमार्गस्य पृथिव्यां मन्मथेश्वरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004408007, "chapter_id": 24408, "verse_number": "५-३-१०२-८", "content_sanskrit": "विशेषश्चात्र सन्ध्यायां श्राद्धदाने च भारत ।\nअन्नदानेन राजेन्द्र कीर्तितं फलमुत्तमम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004408008, "chapter_id": 24408, "verse_number": "५-३-१०२-९", "content_sanskrit": "एतत्ते सर्वमाख्यातं तव भक्त्या तु भारत ।\nपृथिव्यां सागरान्तायां प्रख्यातो मन्मथेश्वरः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004408009, "chapter_id": 24408, "verse_number": "५-३-१०२-१०", "content_sanskrit": "गोदानं पाण्डवश्रेष्ठ त्रयोदश्यां प्रकारयेत् ।\nचैत्रे मासि सिते पक्षे तत्र गत्वा जितेन्द्रियः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004408010, "chapter_id": 24408, "verse_number": "५-३-१०२-११", "content_sanskrit": "रात्रौ जागरणं कृत्वा देवस्याग्रे नृपोत्तम ।\nदीपं भक्त्या घृतेनैव देवस्याग्रे निवेदयेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004408011, "chapter_id": 24408, "verse_number": "५-३-१०२-१२", "content_sanskrit": "स्त्र्यथ वा पुरुषो वापि सममेतत्फलं स्मृतम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]