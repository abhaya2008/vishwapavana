[{"id": 2020180, "chapter_id": 1423, "verse_number": "३-६१-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020181, "chapter_id": 1423, "verse_number": "३-६१-१", "content_sanskrit": "सा निहत्य मृगव्याधं प्रतस्थे कमलेक्षणा।\nवनं प्रतिभयं शून्यं झिल्लिकागणनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020182, "chapter_id": 1423, "verse_number": "३-६१-२", "content_sanskrit": "सिंहद्वीपिरुरुव्याघ्रवराहर्क्षगणैर्युतम्।\nनानापक्षिगणाकीर्णां म्लेच्छतस्करसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020183, "chapter_id": 1423, "verse_number": "३-६१-३", "content_sanskrit": "सालवेणुधवाश्वत्थतिन्दुकेङ्गुदिकिंशुकैः।\nअर्जुनारिष्टसंछन्नं स्यन्दनैश्च सशाल्मलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020184, "chapter_id": 1423, "verse_number": "३-६१-४", "content_sanskrit": "जम्ब्वाम्रलोध्रखदिरशाकवेत्रसमाकुलम्।\nपद्मकामलकप्लक्षकदम्बोदुम्बरावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020185, "chapter_id": 1423, "verse_number": "३-६१-५", "content_sanskrit": "बदरीबिल्वसंछन्नं न्यग्रोधैश्च समाकुलम्।\nप्रियालतालखर्जूरहरीतकिबिभीतकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020186, "chapter_id": 1423, "verse_number": "३-६१-६", "content_sanskrit": "नानाधातुशतैर्नद्धान्विविधानपि चाचलान्।\nनिकुञ्जान्पक्षिसंघुष्टान्दरीश्चाद्भुतदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020187, "chapter_id": 1423, "verse_number": "३-६१-७", "content_sanskrit": "नदी सरांसि वापीश्च विविधांश्चरतो द्विजान्।\nसा बहून्भीमरूपांश्च पिशाचोरगराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020188, "chapter_id": 1423, "verse_number": "३-६१-८", "content_sanskrit": "पल्वलानि तटाकानि गिरिकूटानि सर्वशः।\nसरित्सरांसि च तदा ददर्शाद्भुतदर्शनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020189, "chapter_id": 1423, "verse_number": "३-६१-९", "content_sanskrit": "यूथशो ददृशे चात्र विदर्भाधिपनन्दिनी।\nमहिषान्वराहान्गोमायूनृक्षवानरपन्नगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020190, "chapter_id": 1423, "verse_number": "३-६१-१०", "content_sanskrit": "तेजसा यशसा लक्ष्म्या स्थित्या च परया युता।\nवैर्दभी विचचारैका नलमन्वेषती तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020191, "chapter_id": 1423, "verse_number": "३-६१-११", "content_sanskrit": "नाबिभ्यत्सा नृपसुता भैमी तत्राथ कस्यचित्।\nदारुणामटवीं प्राप्य भर्तृव्यसनकर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020192, "chapter_id": 1423, "verse_number": "३-६१-१२", "content_sanskrit": "विदर्भतनया राजन्विललाप सुदुःखिता।\nभर्तृशोकपरीताङ्गी शिलातलमथाश्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020193, "chapter_id": 1423, "verse_number": "३-६१-१३x", "content_sanskrit": "दमयन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020194, "chapter_id": 1423, "verse_number": "३-६१-१३", "content_sanskrit": "सिह्योरस्क महाबाहो निषधानां जनाधिप।\nक्वनु राजन्गतोसि त्वं त्यक्त्वा मां विजने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020195, "chapter_id": 1423, "verse_number": "३-६१-१४", "content_sanskrit": "अश्वमेधादिभिर्वीर क्रतुभिश्चाप्तदक्षिणैः।\nकथमिष्ट्वा नरव्याघ्र मयि मिथ्या प्रवर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020196, "chapter_id": 1423, "verse_number": "३-६१-१५", "content_sanskrit": "यत्त्वयोक्तं नरश्रेष्ठ मत्समक्षं महाद्युते।\nकर्तुमर्हसि कल्याण तदृतं पार्थिवर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020197, "chapter_id": 1423, "verse_number": "३-६१-१६", "content_sanskrit": "यच्चोक्तं विहगैर्हंसैः समीपे तव भूमिप।\nमत्सकाशे च तैरुक्तं तदवेक्षितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020198, "chapter_id": 1423, "verse_number": "३-६१-१७", "content_sanskrit": "चत्वार एकतो वेदाः साङ्गोपाङ्गाः सविस्तराः।\nस्वधीता मनुजव्याघ्र सत्यमेकं किलैकतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020199, "chapter_id": 1423, "verse_number": "३-६१-१८", "content_sanskrit": "तस्मादर्हसि शत्रुघ्न सत्यं कर्तुं नरेश्वर।\nउक्तवानसि यद्वीर मत्सकाशे पुरा वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020200, "chapter_id": 1423, "verse_number": "३-६१-१९", "content_sanskrit": "हा वीर ननुनामाहमिष्टा किल तवानघ।\nअस्यामटव्यां घोरायां किं मां न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020201, "chapter_id": 1423, "verse_number": "३-६१-२०", "content_sanskrit": "भर्त्सयत्येष मां रौद्रो व्यात्तास्यो दारुणाकृतिः।\nअरण्यराट् क्षुधाविष्टः किं मां न त्रातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020202, "chapter_id": 1423, "verse_number": "३-६१-२१", "content_sanskrit": "न मे त्वदन्या काचिद्धि प्रियाऽस्तीत्यब्रवीस्तदा।\nतामृतां कुरु कल्याण पुरोक्तां भारतीं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020203, "chapter_id": 1423, "verse_number": "३-६१-२२", "content_sanskrit": "उन्मत्तां विलपन्तीं मां भार्यामिष्टां नराधिप।\nईप्सितामीप्सितोसि त्वं किं मां न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020204, "chapter_id": 1423, "verse_number": "३-६१-२३", "content_sanskrit": "कृशां दीनां विवर्णां च मलिनां वसुधाधिप।\nवस्त्रार्धप्रावृतामेकां विलपन्तीमनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020205, "chapter_id": 1423, "verse_number": "३-६१-२४", "content_sanskrit": "यूथभ्रष्टामिवैकां मां हरिणीं पृथुलोचन।\nन मानयसि मामार्य रुदन्तीमरिकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020206, "chapter_id": 1423, "verse_number": "३-६१-२५", "content_sanskrit": "महाराज महारण्ये मामिहैकाकिनीं सतीम्।\nआभाषमाणां स्वां पत्नीं किं मां न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020207, "chapter_id": 1423, "verse_number": "३-६१-२६", "content_sanskrit": "कुलशीलोपसंपन्नां चारुसर्वाङ्गशोभनाम्।\n`अनुव्रतां महाराज किं मां न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020208, "chapter_id": 1423, "verse_number": "३-६१-२७", "content_sanskrit": "नाद्यत्वां प्रतिपश्यामि गिरावस्मिन्नरोत्तम।\nवने चास्मिन्महाधोरे सिंहव्याघ्रनिषेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020209, "chapter_id": 1423, "verse_number": "३-६१-२८", "content_sanskrit": "शयानमुपविष्टं वा स्थितं वा निषधाधिप।\nप्रस्थितं वा नरश्रेष्ठ मम शोकनिबर्हण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020210, "chapter_id": 1423, "verse_number": "३-६१-२९", "content_sanskrit": "कं नु पृच्छामि दुःखार्ता त्वदर्थे शोककर्शिता।\nकच्चिद्दृष्टस्त्वयाऽरण्ये संगत्येति नलो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020211, "chapter_id": 1423, "verse_number": "३-६१-३०", "content_sanskrit": "को नु मे कथयेदद्य वनेऽस्मिन्विष्ठितं नृपम्।\nअभिरूपं महात्मानं परव्यूहविनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020212, "chapter_id": 1423, "verse_number": "३-६१-३१", "content_sanskrit": "यमन्वेपसि राजानं नलं पद्मनिभेक्षणम्।\nअयंस इति कस्याद्य श्रोष्यामि मधुरां गिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020213, "chapter_id": 1423, "verse_number": "३-६१-३२", "content_sanskrit": "अरण्यराडयं श्रीमांश्चतुर्दंष्ट्रो महाहनुः।\nशार्दूलोऽभिमुखोऽभ्येति पृच्छाम्येनमशङ्किता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020214, "chapter_id": 1423, "verse_number": "३-६१-३३", "content_sanskrit": "भवान्मृगाणामधिपस्त्वमस्मिन्कानने प्रभुः।\nविदर्भराजतनयां दमयन्तीति विद्धि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020215, "chapter_id": 1423, "verse_number": "३-६१-३४", "content_sanskrit": "निषधाधिपतेर्भार्यां नलस्यामित्रघातिनः।\nपतिमन्वेषतीमेकां कृपणां शोककर्शिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020216, "chapter_id": 1423, "verse_number": "३-६१-३५", "content_sanskrit": "आश्वासय मृगेन्द्रेह यदि दृष्टस्त्वया नलः।\n`सिंहस्कन्धो महाबाहुः पद्मपत्रनिभेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020217, "chapter_id": 1423, "verse_number": "३-६१-३६", "content_sanskrit": "अथवाऽरण्यनृपते नलं यदि न शंससि।\nमां खादय मृगश्रेष्ठ दुःखादस्माद्विमोचय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020218, "chapter_id": 1423, "verse_number": "३-६१-३७", "content_sanskrit": "श्रुत्वाऽरण्ये विलपितं ममैष मृगराट् स्वयम्।\nयात्येष मृष्टसलिलामापगां सागरोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020219, "chapter_id": 1423, "verse_number": "३-६१-३८", "content_sanskrit": "इमं शिलोच्चयं पृच्छे शृङ्गैर्बहुभिरुच्छितैः।\nविराजितं दिवस्पृग्भिर्नैकवर्णैर्मनोरमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020220, "chapter_id": 1423, "verse_number": "३-६१-३९", "content_sanskrit": "नानाधातुसमाकीर्णं विविधोपलभूषितम्।\nआस्यारण्यस्य महतः केतुभूतमिवोच्छितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020221, "chapter_id": 1423, "verse_number": "३-६१-४०", "content_sanskrit": "सिंहशार्दूलमातङ्गवराहर्क्षमृगायुतम्।\nपतत्रिभिर्बहुविधैः समन्तादनुनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2020222, "chapter_id": 1423, "verse_number": "३-६१-४१", "content_sanskrit": "किंशुकाशोकबकुलपुन्नागैरुपशोभितम्।\n[कर्णिकारधवप्लक्षैः सुपुष्पैरुपशोभितम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2020223, "chapter_id": 1423, "verse_number": "३-६१-४२", "content_sanskrit": "सरिद्भिः सविहङ्गाभिः शिखरैश्च समाकुलम्।\n`पृथिव्या रुचिराकारं चूडामणिमिव स्थितम्।\nनिरिराजमिमं तावत्पृच्छामि नृपतिं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2020224, "chapter_id": 1423, "verse_number": "३-६१-४३", "content_sanskrit": "भगवन्नचलश्रेष्ठ दिव्यद्रशन विश्रुत।\nशरण्य बहुकल्याण नमस्तेऽस्तु महीधर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2020225, "chapter_id": 1423, "verse_number": "३-६१-४४", "content_sanskrit": "प्रणमे त्वाऽभिगम्याहं राजपुत्रीं निबोध माम्।\nराजस्नुषां राजभार्यां दमयन्तीति विश्रुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2020226, "chapter_id": 1423, "verse_number": "३-६१-४५", "content_sanskrit": "राजा विदर्भाधिपतिः पिता मम महारथः।\nभीमो नाम क्षितिपतिश्चातुर्वर्ण्यस्य रक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2020227, "chapter_id": 1423, "verse_number": "३-६१-४६", "content_sanskrit": "राजसूयाश्वमेधानां क्रतूनां दक्षिणावताम्।\nआहर्ता पार्थिवश्रेष्ठः पृथुचार्वञ्चितेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2020228, "chapter_id": 1423, "verse_number": "३-६१-४७", "content_sanskrit": "ब्रह्मण्यः साधुवृत्तश्च सत्यवागनसूयकः।\nशीलवान्वीर्यसंपन्नः पृथुश्रीर्धर्मविच्छुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2020229, "chapter_id": 1423, "verse_number": "३-६१-४८", "content_sanskrit": "सम्यग्गोप्ता विदर्भाणां निर्जितारिगणः प्रभुः।\nतस्य मां विद्धि तनयां भगवंस्त्वामुपस्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2020230, "chapter_id": 1423, "verse_number": "३-६१-४९", "content_sanskrit": "निषधेषु महाराजः श्वशुरो मे नरोत्तमः।\nगृहीतनामा विख्यातो वीरसेन इति स्म ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2020231, "chapter_id": 1423, "verse_number": "३-६१-५०", "content_sanskrit": "तस्य राज्ञः सुतो वीरः श्रीमान्सत्यपराक्रमः।\nक्रमप्राप्तं पितुः स्वं यो राज्यं समनुशास्ति ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2020232, "chapter_id": 1423, "verse_number": "३-६१-५१", "content_sanskrit": "नलो नामारिहा श्यामः पुण्यल्को इति श्रुतः।\nब्रह्मण्यो वेदविद्वाग्मी पुण्यकृत्सोमपोऽग्निचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2020233, "chapter_id": 1423, "verse_number": "३-६१-५२", "content_sanskrit": "यष्टा दाता च योद्धा च सम्यक्चैव प्रशासिता।\nतस्य मामचलश्रेष्ठ विद्धि भार्यामिहागताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2020234, "chapter_id": 1423, "verse_number": "३-६१-५३", "content_sanskrit": "त्यक्तश्रियं भर्तृहीनामनाथां व्यसनान्विताम्।\nअन्वेषमाणां भर्तारं नलं नरवरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2020235, "chapter_id": 1423, "verse_number": "३-६१-५४", "content_sanskrit": "खमुल्लिखद्भिरेतैर्हि त्वया शृङ्गशतैर्नृपः।\nकच्चिद्दृष्टोऽचलश्रेष्ठ वनेऽस्मिन्दारुणे नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2020236, "chapter_id": 1423, "verse_number": "३-६१-५५", "content_sanskrit": "विक्रान्तः सत्त्ववान्वीरो भर्ता मम महायशाः।\nनिषधानामधिपतिः कच्चिद्दृष्टस्त्वया नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2020237, "chapter_id": 1423, "verse_number": "३-६१-५६", "content_sanskrit": "कं मीं विलपतीमेकां पर्वतश्रेष्ठ विह्वलाम्।\nगिरा नाश्वासयस्यद्यस्वां सुतामिव दुखितां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2020238, "chapter_id": 1423, "verse_number": "३-६१-५७", "content_sanskrit": "वीर विक्रान्त धर्मज्ञ सत्यसंध महीपते।\nयद्यस्यस्मिन्वने राजन्दर्शयात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2020239, "chapter_id": 1423, "verse_number": "३-६१-५८", "content_sanskrit": "कदा सुस्निग्गम्भीरां जीमूतस्वनसन्निभाम्।\nश्रोष्यामि नैषधस्याहं वाचं ताममृतोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2020240, "chapter_id": 1423, "verse_number": "३-६१-५९", "content_sanskrit": "वैदर्भ्येहीति विस्पष्टां शुभां राज्ञो महात्मनः।\nआत्माभिधायिनीमृद्धां मम शोकविनाशिनीं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2020241, "chapter_id": 1423, "verse_number": "३-६१-६०", "content_sanskrit": "इतिसा तं गिरिश्रेष्ठमुक्त्वा पार्थिवनन्दिनी।\nदमयन्ती ततो भूयो जगाम दिशमुत्तराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2020242, "chapter_id": 1423, "verse_number": "३-६१-६१", "content_sanskrit": "सा गत्वा त्रीनहोरात्रान्ददर्श परमाङ्गना।\nतापसारण्यमतुलं दिव्यकाननशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2020243, "chapter_id": 1423, "verse_number": "३-६१-६२", "content_sanskrit": "वसिष्ठभृग्वत्रिसमैस्तापसैरुपशोभितम्।\nनियतैः संयताहारैर्दमशौचसमन्वितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2020244, "chapter_id": 1423, "verse_number": "३-६१-६३", "content_sanskrit": "अब्भक्षैर्वायुभक्षैश्च पत्राहारैस्तथैव च।\nजितेन्द्रियैर्महाभागैः स्वर्गमार्गदिदृक्षुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2020245, "chapter_id": 1423, "verse_number": "३-६१-६४", "content_sanskrit": "वल्कलाजिनसंवीतैर्मुनिभिः संयतेन्द्रियैः।\nतापसाध्युषितं रम्यं ददर्शाश्रममण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2020246, "chapter_id": 1423, "verse_number": "३-६१-६५", "content_sanskrit": "नानामृगगणैर्जुष्टं शाखामृगगणायुतम्।\nतापसैः समुपेतं च सा दृष्ट्वैव समाश्वसत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2020247, "chapter_id": 1423, "verse_number": "३-६१-६६", "content_sanskrit": "सुभ्रूः सुकेशी सुश्रोणी सुकुचा सुद्विजानना।\nवर्चस्विनी सुप्रतिष्ठा स्वसितायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2020248, "chapter_id": 1423, "verse_number": "३-६१-६७", "content_sanskrit": "सा विवेशाश्रमपदं वीरसेनसुतप्रिया।\nयोषिद्रत्नं महाभागा दमयन्ती तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2020249, "chapter_id": 1423, "verse_number": "३-६१-६८", "content_sanskrit": "साऽभिवाद्य तपोवृद्धान्विनयावनता स्थिता।\nस्वागतं त इतिप्रोक्ता तैः सर्वैस्तापसोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2020250, "chapter_id": 1423, "verse_number": "३-६१-६९", "content_sanskrit": "पूजां चास्या यथान्यायं कृत्वा तत्रतपोधनाः।\nआस्यतामित्यथोचुस्ते ब्रूहि किं करवामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2020251, "chapter_id": 1423, "verse_number": "३-६१-७०", "content_sanskrit": "तानुवाच वरारोहा कच्चिद्भगवतामिह।\nतपःस्वग्निषु धर्मेषु मृगपक्षिषु चानघाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2020252, "chapter_id": 1423, "verse_number": "३-६१-७१", "content_sanskrit": "कुशलं वो महाभागाः स्वधर्माचरणेषु च।\nतैरुक्ता कुशलं भद्रे सर्वत्रेति यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2020253, "chapter_id": 1423, "verse_number": "३-६१-७२", "content_sanskrit": "ब्रूहि सर्वानवद्याङ्गि का त्वं किंच चिकीर्षसि।\nदृष्ट्वैव ते परंरूपं द्युतिं च परमामिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2020254, "chapter_id": 1423, "verse_number": "३-६१-७३", "content_sanskrit": "विस्मयो नः समुत्पन्नः समाश्वसिहि मा शुचः।\nअस्यारण्यस्य देवी त्वमुताहोऽस्य महीभृतः।\nअस्याश्च नद्याः कल्याणि वद सत्यमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2020255, "chapter_id": 1423, "verse_number": "३-६१-७४", "content_sanskrit": "साऽब्रवीत्तानृपीन्नाहमरण्यस्यास्य देवता।\nन चाप्यस्य गिरर्विप्रा नैव नद्याश्च देवता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2020256, "chapter_id": 1423, "verse_number": "३-६१-७५", "content_sanskrit": "मानुषीं मां विजानीत यूयं सर्वेतपोधनाः।\nविस्तरेणाभिधास्यामि तन्मे शृणुत सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2020257, "chapter_id": 1423, "verse_number": "३-६१-७६", "content_sanskrit": "विदर्भेपु महीपालो भीमो नाम महीपतिः।\nतस्य मां तनयां सर्वे जानीत द्विजसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2020258, "chapter_id": 1423, "verse_number": "३-६१-७७", "content_sanskrit": "निपधाधिपतिर्धीमान्नलो नाम महायशाः।\nवीरः संग्रामजिद्विद्वान्मम भर्ता विशांपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2020259, "chapter_id": 1423, "verse_number": "३-६१-७८", "content_sanskrit": "देवताभ्यर्चनपरो द्विजातिजनवत्सलः।\nगोप्ता निपधवंशस्य महातेजा महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2020260, "chapter_id": 1423, "verse_number": "३-६१-७९", "content_sanskrit": "सत्यवान्धर्मवित्प्राज्ञः सत्यसंधोऽरिमर्दनः।\nब्रह्मण्यो दैवतपरः श्रीमान्परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2020261, "chapter_id": 1423, "verse_number": "३-६१-८०", "content_sanskrit": "नलो नाम नृपश्रेष्ठो देवराजसमद्युतिः।\nमम भर्ता विशालाक्षः पूर्णेन्दुवदनोऽरिहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2020262, "chapter_id": 1423, "verse_number": "३-६१-८१", "content_sanskrit": "आहर्ता क्रतुमुख्यानां वेदवेदाङ्गपारगः।\nसपत्नानां मृधे हन्ता रविसोमसमप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2020263, "chapter_id": 1423, "verse_number": "३-६१-८२", "content_sanskrit": "स कैश्चिन्निकृतिप्रज्ञैरनार्यैरकृतात्मभिः।\nआहृय पृथिवीपालः सत्यधर्मपरायणः।\nदेवनेकुशलैर्जिह्मैर्जितो राज्यं वसूनि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2020264, "chapter_id": 1423, "verse_number": "३-६१-८३", "content_sanskrit": "तस्य मामवगच्छध्वं भार्यां राजर्पभस्य वै।\nदमयन्तीति विख्यातां भर्तुर्दर्शनलालसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2020265, "chapter_id": 1423, "verse_number": "३-६१-८४", "content_sanskrit": "सा वनानि गिरींश्चैव सरांसि सरितस्तथा।\nपल्वलानि च सर्वाणि तथाऽरण्यानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2020266, "chapter_id": 1423, "verse_number": "३-६१-८५", "content_sanskrit": "अन्वेपमाणआ भर्तारं नलं रणविशारदम्।\nमहात्मानं कृतास्त्रं च विचरामीह दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2020267, "chapter_id": 1423, "verse_number": "३-६१-८६", "content_sanskrit": "कच्चिद्भगवतां रम्यं तपोवनमिदं नृपः।\nभवेत्प्राप्तो नलो नाम निपधानां जनाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2020268, "chapter_id": 1423, "verse_number": "३-६१-८७", "content_sanskrit": "यत्कृतेऽहमिदं दुःखं प्रपन्ना भृशदारुणम्।\nवनं प्रतियं धोरं शार्दूलमृगसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2020269, "chapter_id": 1423, "verse_number": "३-६१-८८", "content_sanskrit": "यदि कैश्चिदहोरात्रैर्न द्रक्ष्यामि नलं नृपम्।\nआत्मानं श्रेयसा योक्ष्ये देहस्यास्य विमोक्षणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2020270, "chapter_id": 1423, "verse_number": "३-६१-८९", "content_sanskrit": "कोनु मे जीवितेनार्थस्तमृते पुरुषर्षभम्।\nकथं भविष्याम्यद्याहं भर्तृशोकाभिपीडिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2020271, "chapter_id": 1423, "verse_number": "३-६१-९०", "content_sanskrit": "तथा विलपतीमेकामरण्ये भीमनन्दिनीम्।\nदमयन्तीमथोचुस्ते तापसाः सत्यवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2020272, "chapter_id": 1423, "verse_number": "३-६१-९१", "content_sanskrit": "उदर्कस्तव कल्याणि कल्याणो भविता शुभे।\nवयं पश्याम तपसा क्षिप्रं द्रक्ष्यसि नैषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2020273, "chapter_id": 1423, "verse_number": "३-६१-९२", "content_sanskrit": "निपधानामधिपतिं नलं रिपुनिपातिनम्।\nभैमि धर्मभृतां श्रेष्ठं द्रक्ष्यसे विगतज्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2020274, "chapter_id": 1423, "verse_number": "३-६१-९३", "content_sanskrit": "विमुक्तं सर्वपापेभ्यः सर्वरत्नसमन्वितम्।\nतदेव नगरं श्रेष्ठं प्रशासतमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2020275, "chapter_id": 1423, "verse_number": "३-६१-९४", "content_sanskrit": "द्विपतां भयकर्तारं सुहृदां शोकनाशनम्।\nपतिमेष्यसि कल्याणि कल्याणाभिजनं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2020276, "chapter_id": 1423, "verse_number": "३-६१-९५", "content_sanskrit": "एवमुक्त्वा नलस्येष्टां महिषीं पार्थिवात्मजाम्।\nअन्तर्हितास्तापसास्ते साग्निहोत्राश्रमास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2020277, "chapter_id": 1423, "verse_number": "३-६१-९६", "content_sanskrit": "सा दृष्ट्वा महदाश्चर्यं विस्मिता ह्यभवत्तदा।\nदमयन्त्यनवद्याङ्गी वीरसेननृपस्नुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2020278, "chapter_id": 1423, "verse_number": "३-६१-९७", "content_sanskrit": "`चिन्तयामास वैदर्भी किमेतद्दृष्टवत्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2020279, "chapter_id": 1423, "verse_number": "३-६१-९८", "content_sanskrit": "किंनु स्वप्नो मया दृष्टः कोऽयंविधिरिहाभवत्।\nक्वनु ते तापसाः सर्वे क्व तदाश्रममण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2020280, "chapter_id": 1423, "verse_number": "३-६१-९९", "content_sanskrit": "क्व सा पुण्यजला रम्या नदी द्विजनिषेविता।\nक्वनु ते ह नगा हृद्याः फलपुष्पोपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2020281, "chapter_id": 1423, "verse_number": "३-६१-१००", "content_sanskrit": "`इत्येवं नरशार्दूल विस्मिता कमलेक्षणा।\nध्यात्वा चिरं भीमसुता दमयन्ती शुचिस्मिता।\nभर्तृशोकपरा दीनाविवर्णवदनाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2020282, "chapter_id": 1423, "verse_number": "३-६१-१०१", "content_sanskrit": "सा गत्वाऽथापरां भूमिं बाष्पसंदिग्धया गिरा।\nविललापाश्रुपूर्णाक्षी दृष्ट्वाऽशोकतरुं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2020283, "chapter_id": 1423, "verse_number": "३-६१-१०२", "content_sanskrit": "उपगम्य तरुश्रेष्ठमशोकं पुष्पितं वने।\nपल्लवापीडितं हृद्यं विहङ्गैरनुनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2020284, "chapter_id": 1423, "verse_number": "३-६१-१०३", "content_sanskrit": "अहो बतायमगमः श्रीमानस्मिन्वनान्तरे।\nआपीडैर्बहुभिर्भाति श्रीमान्पर्वतराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2020285, "chapter_id": 1423, "verse_number": "३-६१-१०४", "content_sanskrit": "विशोकां कुरु मां क्षिप्रमशोक प्रियदर्शन।\nवीतशोकभयाबाधं कच्चित्त्वं दृष्टवान्नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2020286, "chapter_id": 1423, "verse_number": "३-६१-१०५", "content_sanskrit": "नलं नामारिदमनं नमयन्त्याः प्रियं पतिम्।\nनिमधानामधिपतिं दृष्टवानसि मे प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2020287, "chapter_id": 1423, "verse_number": "३-६१-१०६", "content_sanskrit": "एकवस्त्रार्धसंवीतं सुकुमारतनुत्वचम्।\nव्यसनेनार्दितं वीरमरण्यमिदमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2020288, "chapter_id": 1423, "verse_number": "३-६१-१०७", "content_sanskrit": "यथा विशोका गच्छेयमशोकनग तत्कुरु।\nसत्यनामा भवाशोक मम शोकविनाशनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2020289, "chapter_id": 1423, "verse_number": "३-६१-१०८", "content_sanskrit": "एवंसाऽशोकवृत्तं तमार्ता वै परिगम्य ह।\nजगाम दारुणतरं देशं भैमी वराङ्गना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2020290, "chapter_id": 1423, "verse_number": "३-६१-१०९", "content_sanskrit": "सा ददर्श नागान्नैकान्नैकाश्च सरितस्तथा।\nनैकांश्च पर्वतान्रम्यान्नैकांश्च मृगपक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2020291, "chapter_id": 1423, "verse_number": "३-६१-११०", "content_sanskrit": "कन्दरांश्च नितम्बांश्च नदीश्चाद्भुतदर्शनाः।\nददर्श तान्भीमसुता पतिमन्वेषती तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2020292, "chapter_id": 1423, "verse_number": "३-६१-१११", "content_sanskrit": "गत्वा प्रकृष्टमध्वानं दमयन्ती शुचिस्मिता।\nददर्शाथ महासार्थं हस्त्यश्वरथसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2020293, "chapter_id": 1423, "verse_number": "३-६१-११२", "content_sanskrit": "उत्तरन्तं नदीं रम्यां प्रसन्नसलिलां शुभाम्।\nसुशीततोयां विस्तीर्णां ह्रदिनीं वेतसैर्वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2020294, "chapter_id": 1423, "verse_number": "३-६१-११३", "content_sanskrit": "प्रोद्धुष्टां क्रौञ्चकुररैश्चक्रबाकोपकूजिताम्।\nकूर्मग्राहझवाकीर्णां विपुलद्वीपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2020295, "chapter_id": 1423, "verse_number": "३-६१-११४", "content_sanskrit": "सा दृष्ट्वैव महासार्थं नलपत्नी यशस्विनी।\nउपसर्प्य वरारोहा जनमध्यं विवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2020296, "chapter_id": 1423, "verse_number": "३-६१-११५", "content_sanskrit": "उन्मत्तरूपा शोकार्ता तथा वस्त्रार्धसंवृता।\nकृशा विवर्णा मलिना पांसुध्वस्तशिरोरुहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2020297, "chapter_id": 1423, "verse_number": "३-६१-११६", "content_sanskrit": "तां दृष्ट्वा तत्रमनुजाः केचिद्भीताः प्रदुद्रुवुः।\nकेचिच्चिन्तापरास्तस्थुः केचित्तत्रविचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2020298, "chapter_id": 1423, "verse_number": "३-६१-११७", "content_sanskrit": "प्रहसन्ति स्म तां केचिदभ्यसूयन्ति चापरे।\nकुर्वन्त्यस्यांदयांकेचित्पप्रच्छुश्चापि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2020299, "chapter_id": 1423, "verse_number": "३-६१-११८", "content_sanskrit": "काऽसि कस्यासि कल्याणि किं वा मृगयसे वने।\nत्वां दृष्ट्वा व्यथिताः स्मेह कच्चित्त्वमसिं मानुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2020300, "chapter_id": 1423, "verse_number": "३-६१-११९", "content_sanskrit": "वद सत्यं वनस्यास्य पर्वतस्याथवा दिशः।\nदेवता त्वं हि कल्याणि त्वां वयं शरणं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2020301, "chapter_id": 1423, "verse_number": "३-६१-१२०", "content_sanskrit": "यक्षी वा राक्षसी वा त्वमुताहोसि सुराङ्गना।\nसर्वथाकुरु नः स्वस्ति रक्ष चास्माननिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2020302, "chapter_id": 1423, "verse_number": "३-६१-१२१", "content_sanskrit": "यथाऽयंसर्वथा सार्थः क्षेमी शीघ्रमितो व्रजेत्।\nतथा विधत्स्व कल्याणि यथा श्रेयो हि नो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2020303, "chapter_id": 1423, "verse_number": "३-६१-१२२", "content_sanskrit": "तथोक्ता तेन सार्थेन दमयन्ती नृपात्मजा।\nप्रत्युवाच ततः साध्वी भर्तृव्यसनपीडिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2020304, "chapter_id": 1423, "verse_number": "३-६१-१२३", "content_sanskrit": "सार्तवाहं च सार्थं च जना ये चात्र केचन।\nयुवस्थविरबालाश् सार्थस्य च पुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2020305, "chapter_id": 1423, "verse_number": "३-६१-१२४", "content_sanskrit": "मानुषीं मां विजानीत मनुजाधिपतेः सुताम्।\nनृपस्नुषां राजभार्यां भर्तृदर्शनलालसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2020306, "chapter_id": 1423, "verse_number": "३-६१-१२५", "content_sanskrit": "विदर्भराण्मम पिता भर्ता राजा च नैषधः।\nनलोनाम महाभागस्तं मार्गाम्यपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2020307, "chapter_id": 1423, "verse_number": "३-६१-१२६", "content_sanskrit": "यदि जानीत नृपतिं क्षिप्रं शंसत मे प्रियम्।\nनलं पुरुषशार्दूलममित्रगणसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2020308, "chapter_id": 1423, "verse_number": "३-६१-१२७", "content_sanskrit": "तामुवाचानवद्याङ्गीं सार्थस्य महतः प्रभुः।\nसार्थवाहः शुचिर्नाम शृणु कल्याणि मद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2020309, "chapter_id": 1423, "verse_number": "३-६१-१२८", "content_sanskrit": "अहं सार्थस्य नेता वै सार्थवाहः शुचिस्मिते।\nमनुष्यं नलनामानं न पश्यामि यशस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2020310, "chapter_id": 1423, "verse_number": "३-६१-१२९", "content_sanskrit": "कुञ्जरद्वीपिमहिषशार्दूलर्क्षमृगानपि।\nपश्याम्यस्मिन्वने कृत्स्ने ह्यमनुष्यनिषेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2020311, "chapter_id": 1423, "verse_number": "३-६१-१३०", "content_sanskrit": "ऋते त्वां मानुषीं मर्त्यं न पश्यामि महावने।\nतथा नो यक्षराडद्य मणिभद्रः प्रसीदतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2020312, "chapter_id": 1423, "verse_number": "३-६१-१३१", "content_sanskrit": "साऽब्रवीद्वणिजः सर्वान्सार्थवाहं च तं ततः।\nक्वनु यास्यति सार्थोऽयमेतदाख्यातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2020313, "chapter_id": 1423, "verse_number": "३-६१-१३२x", "content_sanskrit": "सार्तवाह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2020314, "chapter_id": 1423, "verse_number": "३-६१-१३२", "content_sanskrit": "सार्थोऽयं चेदिराजस्य सुबाहोः सत्यदर्शिनः।\nक्षिप्रं जनपदं गन्ता लाभाय मनुजात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2020315, "chapter_id": 1423, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि एकषष्टितमोऽध्यायः ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}]