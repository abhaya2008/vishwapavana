[{"id": 7004374000, "chapter_id": 24374, "verse_number": "५-३-६८-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nधनदस्य तु तत्तीर्थं ततो गच्छेद्युधिष्ठिर ।\nनर्मदादक्षिणे कूले सर्वपापक्षयंकरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004374001, "chapter_id": 24374, "verse_number": "५-३-६८-२", "content_sanskrit": "सर्वतीर्थफलं तत्र प्राप्यते नात्र संशयः ।\nचैत्रमासत्रयोदश्यां शुक्लपक्षे जितेन्द्रियः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004374002, "chapter_id": 24374, "verse_number": "५-३-६८-३", "content_sanskrit": "उपोष्य परया भक्त्या रात्रौ कुर्वीत जागरम् ।\nपञ्चामृतेन राजेन्द्र स्नापयेद्धनदं बुधः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004374003, "chapter_id": 24374, "verse_number": "५-३-६८-४", "content_sanskrit": "दीपं घृतेन दातव्यं गीतं वाद्यं च कारयेत् ।\nप्रभाते पूजयेद्विप्रानात्मनः श्रेय इच्छति॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004374004, "chapter_id": 24374, "verse_number": "५-३-६८-५", "content_sanskrit": "प्रतिग्रहसमर्थांश्च विद्यासिद्धान्तवादिनः ।\nश्रौतस्मार्तक्रियायुक्तान् परदारपराङ्मुखान्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004374005, "chapter_id": 24374, "verse_number": "५-३-६८-६", "content_sanskrit": "पूजयेद्गोहिरण्येन वस्त्रोपानहभोजनैः ।\nछत्रशय्याप्रदानेन सर्वपापक्षयो भवेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004374006, "chapter_id": 24374, "verse_number": "५-३-६८-७", "content_sanskrit": "त्रिजन्मजनितं पापं वरदस्य प्रभावतः ।\nस्वर्गदं दुर्विनीतानां विनीतानां च मोक्षदम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004374007, "chapter_id": 24374, "verse_number": "५-३-६८-८", "content_sanskrit": "अन्नदं च दरिद्राणां भवेज्जन्मनिजन्मनि ।\nकुलीनत्वं दुःखहानिः स्वभावाजायते नरे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004374008, "chapter_id": 24374, "verse_number": "५-३-६८-९", "content_sanskrit": "व्याधिध्वंसो भवेत्तेषां नर्मदोदकसेवनात् ।\nधनदस्य तु यस्तीर्थे विद्यादानं प्रयच्छति॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004374009, "chapter_id": 24374, "verse_number": "५-३-६८-१०", "content_sanskrit": "स याति भास्करे लोके सर्वव्याधिविवर्जिते ।\nदेवद्रोणीं च तत्रैव स्वशक्त्या पाण्डुनन्दन॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004374010, "chapter_id": 24374, "verse_number": "५-३-६८-११", "content_sanskrit": "ये प्रकुर्वन्ति भूयिष्ठां रेवाया दक्षिणे तटे ।\nते यान्ति शांकरे लोके सर्वदुःखविवर्जिते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]