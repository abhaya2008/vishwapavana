[{"id": 7000468000, "chapter_id": 20468, "verse_number": "३-१५-१", "content_sanskrit": "नारद उवाच ।\nयन्मां पृच्छसि कौंतेय तन्निबोध च तच्छृणु ।\nएतस्मिन्नंतरे रुद्रो नर्मदातटमास्थितः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000468001, "chapter_id": 20468, "verse_number": "३-१५-२", "content_sanskrit": "नाम्ना हरेश्वरं स्थानं त्रिषु लोकेषु विश्रुतम् ।\nतस्मिन्स्थाने महादेवश्चिंतयंस्त्रैपुरं वधम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000468002, "chapter_id": 20468, "verse_number": "३-१५-३", "content_sanskrit": "गांडीवं मंदरं कृत्वा गुणं कृत्वा तु वासुकिम् ।\nस्थानं कृत्वा तु वैशाखं विष्णुं कृत्वा शरोत्तमम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000468003, "chapter_id": 20468, "verse_number": "३-१५-४", "content_sanskrit": "अग्रे चाग्निं प्रतिष्ठाप्य मुखे वायुः समर्पितः ।\nहयाश्च चतुरो वेदाः सर्वदेवमयं रथम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000468004, "chapter_id": 20468, "verse_number": "३-१५-५", "content_sanskrit": "चक्रगौ चाश्विनौ देवावक्षं चक्रधरः स्वयम् ।\nस्वयमिंद्रश्च चापांते बाणे वैश्रवणः स्थितः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000468005, "chapter_id": 20468, "verse_number": "३-१५-६", "content_sanskrit": "यमस्तु दक्षिणे हस्ते वामे कालस्तु दारुणः ।\nचक्राणामारके न्यस्ता गंधर्वा लोकविश्रुताः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000468006, "chapter_id": 20468, "verse_number": "३-१५-७", "content_sanskrit": "प्रजापती रथश्रेष्ठे ब्रह्मा चैव तु सारथिः ।\nएवं कृत्वा तु देवेशः सर्वदेवमयं रथम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000468007, "chapter_id": 20468, "verse_number": "३-१५-८", "content_sanskrit": "सोतिष्ठत्स्थाणुभूतो हि सहस्रं परिवत्सरान् ।\nयदा त्रीणि समेतानि अंतरिक्षचराणि च॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000468008, "chapter_id": 20468, "verse_number": "३-१५-९", "content_sanskrit": "त्रिपुराणि त्रिशल्येन तदा तानि बिभेद सः ।\nशरः प्रचोदितस्तत्र रुद्रेण त्रिपुरं प्रति॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000468009, "chapter_id": 20468, "verse_number": "३-१५-१०", "content_sanskrit": "भ्रष्टतेजा स्त्रियो जाता बलं तेषां व्यशीर्यत ।\nउत्पाताश्च पुरे तस्मिन्प्रादुर्भूता सहस्रशः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000468010, "chapter_id": 20468, "verse_number": "३-१५-११", "content_sanskrit": "त्रिपुरस्य विनाशाय कालरूपोभवत्तदा ।\nअट्टहासं प्रमुंचंति रूपाः काष्ठमयास्तथा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000468011, "chapter_id": 20468, "verse_number": "३-१५-१२", "content_sanskrit": "निमेषोन्मेषणं चैव कुर्वंति चित्रकर्मणा ।\nस्वप्ने पश्यंति चात्मानं रक्तांबरविभूषितम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000468012, "chapter_id": 20468, "verse_number": "३-१५-१३", "content_sanskrit": "स्वप्ने पश्यंति ते चैवं विपरीतानि यानि तु ।\nएतान्पश्यति उत्पातांस्तत्र स्थाने तु ये जनाः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000468013, "chapter_id": 20468, "verse_number": "३-१५-१४", "content_sanskrit": "तेषां बलं च बुद्धिश्च हरक्रोधेन नाशितम् ।\nसंवर्तको नाम वायुर्युगांतप्रतिमो महान्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000468014, "chapter_id": 20468, "verse_number": "३-१५-१५", "content_sanskrit": "समीरितोनलश्रेष्ठ उत्तमांगेषु बाधते ।\nज्वलंति पादपास्तत्र पतंति शिखराणि च॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000468015, "chapter_id": 20468, "verse_number": "३-१५-१६", "content_sanskrit": "सर्वं तद्व्याकुलीभूतं हाहाकारमचेतनम् ।\nभग्नोद्यानानि सर्वाणि क्षिप्रं तु प्रज्वलंति च॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000468016, "chapter_id": 20468, "verse_number": "३-१५-१७", "content_sanskrit": "तेनैव दीपितं सर्वं ज्वलते विशिखैः शिखैः ।\nद्रुमा आरामगंडानि गृहाणि विविधानि च॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000468017, "chapter_id": 20468, "verse_number": "३-१५-१८", "content_sanskrit": "दशदिक्षु प्रवृत्तोयं समिद्धो हव्यवाहनः ।\nततः शिलाः प्रमुंचंति दिशो दश विभागशः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000468018, "chapter_id": 20468, "verse_number": "३-१५-१९", "content_sanskrit": "शिखासहस्रैरत्युग्रैः प्रज्वलंति हुताशनैः ।\nसर्वं किंशुकसंप्रख्यं ज्वलितंदृश्यते पुरम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000468019, "chapter_id": 20468, "verse_number": "३-१५-२०", "content_sanskrit": "गृहाद्गृहांतरे नैव गंतुं धूमैश्च शक्यते ।\nहरकोपानलादग्धं क्रंदमानं सुदुःखितम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000468020, "chapter_id": 20468, "verse_number": "३-१५-२१", "content_sanskrit": "प्रदीप्तं सर्वतो दिक्षु दह्यते त्रिपुरं पुरम् ।\nप्रासादशिखराग्राणि विशीर्यंति सहस्रशः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000468021, "chapter_id": 20468, "verse_number": "३-१५-२२", "content_sanskrit": "नानारत्नविचित्राणि विमानान्यप्यनेकधा ।\nगृहाणि चैव रम्याणि दह्यंते दीप्तिवह्निना॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000468022, "chapter_id": 20468, "verse_number": "३-१५-२३", "content_sanskrit": "बाधंते द्रुमखंडेषु जनस्थाने तथैव च ।\nदेवागारेषु सर्वेषु प्रज्वलंते ज्वलंत्यपि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000468023, "chapter_id": 20468, "verse_number": "३-१५-२४", "content_sanskrit": "सीदंति चानलस्पृष्टाः क्रंदंति विविधै स्वरैः ।\nगिरिकूटनिभास्तत्र दृश्यंतेंऽगारराशयः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000468024, "chapter_id": 20468, "verse_number": "३-१५-२५", "content_sanskrit": "स्तुवंति देवदेवेशं परित्रायस्व मां प्रभो ।\nअन्योन्यं च परिष्वज्य हुताशनप्रपीडिताः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000468025, "chapter_id": 20468, "verse_number": "३-१५-२६", "content_sanskrit": "दह्यंते दानवास्तत्र शतशोथ सहस्रशः ।\nहंसकारंडवाकीर्णा नलिनी सह पंकजा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000468026, "chapter_id": 20468, "verse_number": "३-१५-२७", "content_sanskrit": "दह्यंतेनलदग्धानि पुरोद्यानानि दीर्घिकाः ।\nअम्लानैः पंकजैश्छन्ना विस्तीर्णा योजनैः शतैः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000468027, "chapter_id": 20468, "verse_number": "३-१५-२८", "content_sanskrit": "गिरिकूटनिभास्तत्र प्रासादारत्नभूषिताः ।\nपतंत्यनलनिर्दग्धा निस्तोया जलदा इव॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000468028, "chapter_id": 20468, "verse_number": "३-१५-२९", "content_sanskrit": "सह स्त्रीबालवृद्धेषु गोषु पक्षिषु वाजिषु ।\nनिर्दयो दहते वह्निर्हरकोपेन प्रेरितः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000468029, "chapter_id": 20468, "verse_number": "३-१५-३०", "content_sanskrit": "सपत्नीकाश्चैव सुप्ताः संसुप्ता बहवो जनाः ।\nपुत्रमालिंग्यते गाढं दह्यंते त्रिपुरारिणा॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000468030, "chapter_id": 20468, "verse_number": "३-१५-३१", "content_sanskrit": "अथ तस्मिन्पुरे दीप्ते स्त्रियश्चाप्सरसोपमाः ।\nअग्निज्वालाहतास्तत्र पतंति धरणीतले॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000468031, "chapter_id": 20468, "verse_number": "३-१५-३२", "content_sanskrit": "काचिद्बाला विशालाक्षी मुक्तावलि विभूषिता ।\nधूमेनाकुलिता सा तु प्रतिबुद्धा शिखार्द्दिता॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000468032, "chapter_id": 20468, "verse_number": "३-१५-३३", "content_sanskrit": "सुतं संचिंत्यमाना सा पतिता धरणीतले ।\nकाचित्सुवर्णवर्णाभा नीलरत्नैर्विभूषिता॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000468033, "chapter_id": 20468, "verse_number": "३-१५-३४", "content_sanskrit": "धूमेनाकुलिता सा तु पतिता धरणीतले ।\nअन्या गृहीतहस्ता तु सखी दहति बालकैः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000468034, "chapter_id": 20468, "verse_number": "३-१५-३५", "content_sanskrit": "अनेन दिव्यरूपान्यादृष्टा मदविमोहिता ।\nशिरसा प्रांजलिं कृत्वा विज्ञापयति पावकम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000468035, "chapter_id": 20468, "verse_number": "३-१५-३६", "content_sanskrit": "यदि त्वमिच्छसे वैरं पुरुषेष्वपकारिषु ।\nस्त्रियः किमपराध्यंते गृहपंजरकोकिलाः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000468036, "chapter_id": 20468, "verse_number": "३-१५-३७", "content_sanskrit": "पापनिर्दय निर्ल्लज्ज कस्ते कोपः स्त्रियोपरि ।\nन दाक्षिण्यं न ते लज्जा न सत्यं शौचवर्जितः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000468037, "chapter_id": 20468, "verse_number": "३-१५-३८", "content_sanskrit": "अनेकरूपवर्णाढ्या उपलभ्या वदस्व ह ।\nकिं त्वया न श्रुतं लोके अवध्याः सर्वयोषितः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000468038, "chapter_id": 20468, "verse_number": "३-१५-३९", "content_sanskrit": "किं तु तुभ्यं गुणा ह्येते दहनस्त्र्यर्दनं प्रति ।\nन कारुण्यं दया वापि दाक्षिण्यं वा स्त्रियोपरि॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000468039, "chapter_id": 20468, "verse_number": "३-१५-४०", "content_sanskrit": "दयां कुर्वंति म्लेच्छापि दहनं प्रेक्ष्य योषितः ।\nम्लेच्छानामपि कष्टोसि दुर्निवार्यो ह्यचेतनः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000468040, "chapter_id": 20468, "verse_number": "३-१५-४१", "content_sanskrit": "एते चैव गुणास्तुभ्यं दहनोत्सादनं प्रति ।\nआसामपि दुराचार स्त्रीणां किं विनिपातसे॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000468041, "chapter_id": 20468, "verse_number": "३-१५-४२", "content_sanskrit": "दुष्ट निर्घृण निर्लज्ज हुताश मंदभाग्यक ।\nनिराशस्त्वं दुराचार बालान्दहसि निर्दय॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000468042, "chapter_id": 20468, "verse_number": "३-१५-४३", "content_sanskrit": "एवं प्रलपमानास्ता जल्पमाना बहुस्वरम् ।\nअन्याः क्रोशंति संक्रुद्धा बालशोकेन मोहिताः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000468043, "chapter_id": 20468, "verse_number": "३-१५-४४", "content_sanskrit": "दहते निर्दयो वह्निः संक्रुद्धः सर्वशत्रुवत् ।\nपुष्करिण्यां जले ज्वाला कूपेष्वपि तथैव च॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000468044, "chapter_id": 20468, "verse_number": "३-१५-४५", "content_sanskrit": "अस्मान्संदह्य म्लेच्छ त्वं कां गतिं प्रापयिष्यसि ।\nएवं प्रलपतां तासां वह्निर्वचनमब्रवीत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000468045, "chapter_id": 20468, "verse_number": "३-१५-४६", "content_sanskrit": "वैश्वानर उवाच ।\nस्ववशो नैव युष्माकं विनाशं तु करोम्यहम् ।\nअहमादेशकर्ता वै नाहं कर्त्तास्म्यनुग्रहम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000468046, "chapter_id": 20468, "verse_number": "३-१५-४७", "content_sanskrit": "अत्र क्रोधसमाविष्टो विचरामि यदृच्छया ।\nततो बाणो महातेजास्त्रिपुरं वीक्ष्य दीपितम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000468047, "chapter_id": 20468, "verse_number": "३-१५-४८", "content_sanskrit": "आसनस्थोऽब्रवीदेवमहं देवैर्विनाशितः ।\nअल्पसारैर्दुराचारैरीश्वरस्य निवेदितः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000468048, "chapter_id": 20468, "verse_number": "३-१५-४९", "content_sanskrit": "अपरीक्ष्य ह्यहं दग्धः शंकरेण महात्मना ।\nनान्यः शत्रुस्तु मां हंतुं वर्ज्जयित्वा महेश्वरम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000468049, "chapter_id": 20468, "verse_number": "३-१५-५०", "content_sanskrit": "उत्थितः शिरसा कृत्वा लिगं त्रिभुवनेश्वरम् ।\nनिर्गतः स पुरद्वारात्परित्यज्य सुहृत्स्वयम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000468050, "chapter_id": 20468, "verse_number": "३-१५-५१", "content_sanskrit": "रत्नानि सुविचित्राणि स्त्रियो नानाविधास्तथा ।\nगृहीत्वा शिरसा लिंगं न्यस्तं नगरमंडले॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000468051, "chapter_id": 20468, "verse_number": "३-१५-५२", "content_sanskrit": "स्तुवते देवदेवेशं त्रैलोक्याधिपतिं शिवम् ।\nहर त्वयाहं निर्दग्धो यदि वध्योसि शंकर॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000468052, "chapter_id": 20468, "verse_number": "३-१५-५३", "content_sanskrit": "त्वत्प्रसादान्महादेव मा मे लिंगं विनश्यतु ।\nअर्चितं हि महादेव भक्त्या परमया सदा॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000468053, "chapter_id": 20468, "verse_number": "३-१५-५४", "content_sanskrit": "त्वया यद्यपि वध्योहं मा मे लिंगं विनश्यतु ।\nप्राप्यमेतन्महादेव त्वत्पादग्रहणं मम॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000468054, "chapter_id": 20468, "verse_number": "३-१५-५५", "content_sanskrit": "जन्मजन्म महादेव त्वत्पादनिरतो ह्यहम् ।\nतोटकच्छंदसा देवं स्तुत्वा तु परमेश्वरम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000468055, "chapter_id": 20468, "verse_number": "३-१५-५६", "content_sanskrit": "ओंशिवशंकरसर्वकराय नमो भवभीममहेशशिवाय नमः ।\nकुसुमायुध देहविनाशकर त्रिपुरांतकरांधक चूर्णकर॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000468056, "chapter_id": 20468, "verse_number": "३-१५-५७", "content_sanskrit": "प्रमदाप्रियकामविभक्त नमो हि नमः सुरसिद्धगणैर्नमितः ।\nहयवानरसिंहगजेंद्रमुखैरति ह्रस्वसुदीर्घमुखैश्च गणैः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000468057, "chapter_id": 20468, "verse_number": "३-१५-५८", "content_sanskrit": "उपलब्धुमशक्यतरैरसुरैर्व्यथितो न शरीरशतैर्बहुभिः ।\nप्रणतो भगवन्बहुभक्तिमता चलचंद्र कलाधर देव नमः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000468058, "chapter_id": 20468, "verse_number": "३-१५-५९", "content_sanskrit": "सहपुत्रकलत्रकलापधनैः सततं जय देहि अनुस्मरणम् ।\nव्यथितोस्मि शरीरशतैर्बहुभिर्गमिताद्य महानरकस्य गतिः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000468059, "chapter_id": 20468, "verse_number": "३-१५-६०", "content_sanskrit": "न निवर्तति यन्ममपापगतिः शुचिकर्म्मविशुद्धमपि त्यजति ।\nअनुकंपति दिग्भ्रमति भ्रमति भ्रम एष कुबुद्धि निवारयति॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000468060, "chapter_id": 20468, "verse_number": "३-१५-६१", "content_sanskrit": "यः पठेत्तोटकं दिव्यं प्रयतः शुचिमानसः ।\nबाणस्यैव यथारुद्रस्तस्यैव वरदो भवेत्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000468061, "chapter_id": 20468, "verse_number": "३-१५-६२", "content_sanskrit": "इमं स्तवं महादिव्यं श्रुत्वा देवो महेश्वरः ।\nप्रसन्नस्तु तदा तस्य स्वयं देवो महेश्वरः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000468062, "chapter_id": 20468, "verse_number": "३-१५-६३", "content_sanskrit": "ईश्वर उवाच ।\nन भेतव्यं त्वया वत्स सौवर्णे तिष्ठ दानव ।\nपुत्रपौत्रसपत्नीनां भार्याभृत्यजनैः सह॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000468063, "chapter_id": 20468, "verse_number": "३-१५-६४", "content_sanskrit": "अद्यप्रभृति बाण त्वमवध्यस्त्रिदशैरपि ।\nभूयस्तस्य वरो दत्तो देवदेवेन पांडव॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000468064, "chapter_id": 20468, "verse_number": "३-१५-६५", "content_sanskrit": "अक्षयश्चाव्ययो लोके विचचार ह निर्भयः ।\nततो निवारयामास रुद्र सप्तशिखं तथा॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000468065, "chapter_id": 20468, "verse_number": "३-१५-६६", "content_sanskrit": "तृतीयं रक्षितं तस्य शंकरेण महात्मना ।\nभ्रमते गगने नित्यं रुद्रतेजः प्रभावतः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000468066, "chapter_id": 20468, "verse_number": "३-१५-६७", "content_sanskrit": "एवं तु त्रिपुरं दग्धं शंकरेण महात्मना ।\nज्वालामालाप्रदीप्तं तु पतितं धरणीतले॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000468067, "chapter_id": 20468, "verse_number": "३-१५-६८", "content_sanskrit": "एकं निपातितं तस्य श्रीशैले त्रिपुरांतके ।\nद्वितीयं पातितं तत्र पर्वतेऽमरकंटके॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000468068, "chapter_id": 20468, "verse_number": "३-१५-६९", "content_sanskrit": "दग्धे तु त्रिपुरे राजन्रुद्रकोटिः प्रतिष्ठिता ।\nज्वलंतं पातितं तत्र तेन ज्वालेश्वरः स्मृतः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000468069, "chapter_id": 20468, "verse_number": "३-१५-७०", "content_sanskrit": "ऊर्ध्वेन प्रस्थिता तस्य दिव्या ज्वाला दिवं गता ।\nहाहाकारस्तदा जातो सदेवासुरकिंनरान्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000468070, "chapter_id": 20468, "verse_number": "३-१५-७१", "content_sanskrit": "तं शरं स्तंभयेद्रुद्रो माहेश्वरपुरोत्तमे ।\nएवं व्रजेत यस्तस्मिन्पर्वतेऽमरकंटके॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000468071, "chapter_id": 20468, "verse_number": "३-१५-७२", "content_sanskrit": "चतुर्द्दशभुवनानि सुभुक्त्वा पांडुनंदन ।\nवर्षकोटिसहस्रं तु त्रिंशत्कोट्यस्तथा पराः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000468072, "chapter_id": 20468, "verse_number": "३-१५-७३", "content_sanskrit": "ततो महीतलं प्राप्य राजा भवति धार्मिकः ।\nपृथिव्यामेकच्छत्रेण भुंक्ते नास्त्यत्र संशयः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000468073, "chapter_id": 20468, "verse_number": "३-१५-७४", "content_sanskrit": "एष पुण्यो महाराज सर्वतोऽमरकंटकः ।\nचंद्र सूर्योपरागेषु गच्छेद्योऽमरकंटकम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000468074, "chapter_id": 20468, "verse_number": "३-१५-७५", "content_sanskrit": "अश्वमेधाद्दशगुणं प्रवदंति मनीषिणः ।\nस्वर्गलोकमवाप्नोति दृष्ट्वा तत्र महेश्वरम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000468075, "chapter_id": 20468, "verse_number": "३-१५-७६", "content_sanskrit": "संनिहत्या गमिष्यंति राहुग्रस्ते दिवाकरे ।\nतदेव निखिलं पुण्यं पर्वतेऽमरकंटके॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000468076, "chapter_id": 20468, "verse_number": "३-१५-७७", "content_sanskrit": "पुंडरीकस्य यज्ञस्य फलं प्राप्नोति मानवः ।\nतत्र ज्वालेश्वरो नाम पर्वतेऽमरकंटके॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000468077, "chapter_id": 20468, "verse_number": "३-१५-७८", "content_sanskrit": "तत्र स्नात्वा दिवं यांति ये मृतास्तेऽपुनर्भवाः ।\nज्वालेश्वरे महाराज यस्तु प्राणान्परित्यजेत्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000468078, "chapter_id": 20468, "verse_number": "३-१५-७९", "content_sanskrit": "चंद्र सूर्योपरागे तु भक्त्यापि शृणु तत्फलम् ।\nअमरा नाम देवास्ते पर्वतेऽमरकंटके॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000468079, "chapter_id": 20468, "verse_number": "३-१५-८०", "content_sanskrit": "रुद्रलोकमवाप्नोति यावदाभूतसंप्लवम् ।\nअमरेश्वरस्य देवस्य पर्वतस्य तटे जले॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000468080, "chapter_id": 20468, "verse_number": "३-१५-८१", "content_sanskrit": "कोटिश ऋषिमुख्यास्ते तपस्तप्यंति सुव्रताः ।\nसमंताद्योजनं राजन्क्षेत्रं चामरकंटकम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000468081, "chapter_id": 20468, "verse_number": "३-१५-८२", "content_sanskrit": "अकामो वा सकामो वा नर्मदायां शुभे जले ।\nस्नात्वा मुच्येत पापेभ्यो रुद्रलोकं स गच्छति॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]