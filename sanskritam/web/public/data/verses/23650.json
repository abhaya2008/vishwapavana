[{"id": 7003650000, "chapter_id": 23650, "verse_number": "१-२-३७-१", "content_sanskrit": "श्रीनारद उवाच ।\nबर्बरीतीर्थमाहात्म्यमथो वक्ष्यामि तेऽर्जुन ।\nयथा बर्बरिका जाता शतश्रृंगा नृपात्मजा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003650001, "chapter_id": 23650, "verse_number": "१-२-३७-२", "content_sanskrit": "कुमारिकेति विख्याता तस्या नाम्ना प्रकथ्यते ।\nइदं कौमारिकाखंडं चतुर्वर्गफलप्रदम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003650002, "chapter_id": 23650, "verse_number": "१-२-३७-३", "content_sanskrit": "यया कृता पृथिव्यां च नानाग्रामादिकल्पना ।\nइदं भरतखंडं च यया सम्यक्प्रकल्पितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003650003, "chapter_id": 23650, "verse_number": "१-२-३७-४", "content_sanskrit": "धनंजय उवाच ।\nमहदेतन्ममाश्चर्यं श्रोतव्यं परमं मुने ।\nकुमारीचरितं सर्वं ब्रूहि मह्यं सविस्तरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003650004, "chapter_id": 23650, "verse_number": "१-२-३७-५", "content_sanskrit": "कथं विश्वमिदं जातं कर्मजातिप्रकल्पितम् ।\nकथं वा भारतं खंडं शुश्रूषेय सदा मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003650005, "chapter_id": 23650, "verse_number": "१-२-३७-६", "content_sanskrit": "नारद उवाच ।\nअव्यक्तोऽस्मिन्निरालोके प्रधानपुरुषावुभौ ।\nअजौ समागतावेकौ केवलं श्रृणुमो वयम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003650006, "chapter_id": 23650, "verse_number": "१-२-३७-७", "content_sanskrit": "ततः स्वभावकालाभ्यां स्वरूपाभ्यां समीरितम् ।\nईक्षणेनैव प्रकृतेर्महत्तत्त्वमजायत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003650007, "chapter_id": 23650, "verse_number": "१-२-३७-८", "content_sanskrit": "महत्तत्त्वाद्विकुर्वाणादहंतत्त्वं व्यजायत ।\nत्रिधा तन्मुनिभिः प्रोक्तं सत्त्वरासतामसम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003650008, "chapter_id": 23650, "verse_number": "१-२-३७-९", "content_sanskrit": "तामसात्पंच जातानि तन्मात्राणि वुदुर्बुधाः ।\nतन्मात्रेभ्यश्च भूतानि वेशेषाः पंच तद्भवाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003650009, "chapter_id": 23650, "verse_number": "१-२-३७-१०", "content_sanskrit": "सात्त्विकाच्चाप्यहंकाराद्विद्वि कर्मेद्रियाणि च ।\nएकादशं मनश्चैव राजसं च द्वयोर्विदुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003650010, "chapter_id": 23650, "verse_number": "१-२-३७-११", "content_sanskrit": "चतुर्विशतितत्त्वानि जातानीति पुरा विदुः ।\nसदाशिवेन वै पुंसा तानि दृष्टानि भारत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003650011, "chapter_id": 23650, "verse_number": "१-२-३७-१२", "content_sanskrit": "बुद्बुदाकारतां जग्मुरंडं जातं ततः शुभम् ।\nशकतोटिप्रमाणं च ब्रह्मांडमिदमुच्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003650012, "chapter_id": 23650, "verse_number": "१-२-३७-१३", "content_sanskrit": "आत्मास्य कथितो ब्रह्मा व्यभजत्स त्रिधा त्विदम् ।\nऊर्ध्वं तत्र स्थिता देवा मध्ये चैव च मानवाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003650013, "chapter_id": 23650, "verse_number": "१-२-३७-१४", "content_sanskrit": "नागा दैत्याश्च पाताले त्रिधैतत्परिकल्पितम् ।\nऐकैकं सप्तधाभूय ततस्तेन प्रकल्पितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003650014, "chapter_id": 23650, "verse_number": "१-२-३७-१५", "content_sanskrit": "पातालानि च द्वीपानि स्वर्लोकाः सप्तसप्त च ।\nसप्त द्वीपानि वक्ष्यामि श्रृणु तेषां प्रकल्पनाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003650015, "chapter_id": 23650, "verse_number": "१-२-३७-१६", "content_sanskrit": "लक्षयोजनविस्तारं जंबूद्वीपं प्रकीर्त्यते ।\nसूर्यबिंबसमाकारं तावत्क्षारार्णवावृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003650016, "chapter_id": 23650, "verse_number": "१-२-३७-१७", "content_sanskrit": "शाकद्वीपं द्विगुणतो जंबूद्वीपात्ततः परम् ।\nतावता क्षीरतोयेन समुद्रेण परीवृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003650017, "chapter_id": 23650, "verse_number": "१-२-३७-१८", "content_sanskrit": "सुरातोयेन दैत्यानां मोहकार्यर्णवेन हि ।\nपुष्करं तु ततो द्वीपं द्विगुणं तावता वृतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003650018, "chapter_id": 23650, "verse_number": "१-२-३७-१९", "content_sanskrit": "कुशद्वीपं द्विगुणतस्ततस्तत्परतः स्मृतम् ।\nदधितोयेन परितस्तावदर्णवसंवृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003650019, "chapter_id": 23650, "verse_number": "१-२-३७-२०", "content_sanskrit": "ततः परं क्रौञ्चसंज्ञं द्विगुणं हि घृताब्धिना ।\nततः शाल्मलिद्वीपं च द्विगुणं तावतैव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003650020, "chapter_id": 23650, "verse_number": "१-२-३७-२१", "content_sanskrit": "इक्षुसारस्वरूपेण समुद्रेण परिवृतम् ।\nगोमेदं तस्य परितो द्विगुणं तावता वृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003650021, "chapter_id": 23650, "verse_number": "१-२-३७-२२", "content_sanskrit": "स्वादुतोयेन रम्येण समुद्रेण समंततः ।\nएवं कोटिद्वयं पार्थ लक्षपंचाशतत्रयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003650022, "chapter_id": 23650, "verse_number": "१-२-३७-२३", "content_sanskrit": "पंचाशच्च सहस्राणि सप्तद्वीपाः ससागराः ।\nदशोत्तराणि पंचैव अंगुलानां शतानि च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003650023, "chapter_id": 23650, "verse_number": "१-२-३७-२४", "content_sanskrit": "अपां वृद्धिक्षयो दृष्टः पक्षयोः शुक्लकृष्णयोः ।\nततो हेममयी भूमिर्दशकोट्यः कुरूद्वह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003650024, "chapter_id": 23650, "verse_number": "१-२-३७-२५", "content_sanskrit": "देवानां क्रीडनस्थानं लोकालोकस्ततः परम् ।\nपर्वतो वलयाकारो योजनायुतविस्तृतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003650025, "chapter_id": 23650, "verse_number": "१-२-३७-२६", "content_sanskrit": "अस्य बाह्ये तमो घोरं दुष्प्रेक्ष्यं जीववर्जितम् ।\nपंचत्रिंशत्स्मृताः कोट्यो लक्षाण्येकोनविंशतिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003650026, "chapter_id": 23650, "verse_number": "१-२-३७-२७", "content_sanskrit": "चत्वारिंशत्सहस्राणि योजनानां च फाल्गुन ।\nसप्तसागरमानस्तु गर्भोदस्तदनंतरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003650027, "chapter_id": 23650, "verse_number": "१-२-३७-२८", "content_sanskrit": "कोटियोजनविस्तारः कटाहऋ संव्यवस्थितः ।\nब्रह्मणोंऽडं कटाहेन संयुक्तं मेरुमध्यतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003650028, "chapter_id": 23650, "verse_number": "१-२-३७-२९", "content_sanskrit": "पंचाशत्कोटयो ज्ञेया दशदिक्षु समंततः ।\nजंबुद्वीपस्य मध्ये तु मेरुनामास्ति पर्वतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003650029, "chapter_id": 23650, "verse_number": "१-२-३७-३०", "content_sanskrit": "स लक्षयोजनो ज्ञेयो ह्यधश्चोर्ध्वं प्रमाणतः ।\nषोडशैव सहस्राणि योजनानामधः स्थितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003650030, "chapter_id": 23650, "verse_number": "१-२-३७-३१", "content_sanskrit": "उच्छ्रयश्चतुराशीतिर्द्वात्रिंशन्मूर्ध्नि विस्तृतः ।\nत्रिभिः शृंगैः समायुक्तः शरावाकृतिमस्तकः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003650031, "chapter_id": 23650, "verse_number": "१-२-३७-३२", "content_sanskrit": "मध्यशृंगे ब्रह्मवास ऐशान्यां त्र्यंबकस्य च ।\nनैरृत्ये वासुदेवस्य हेमशृंगं च ब्रह्मणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003650032, "chapter_id": 23650, "verse_number": "१-२-३७-३३", "content_sanskrit": "रत्नजं शंकरस्यापि राजतं केशवस्य च ।\nमेरुदिक्षु चतसृषु विष्कंभा गिरयः स्मृताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003650033, "chapter_id": 23650, "verse_number": "१-२-३७-३४", "content_sanskrit": "पूर्वेण मंदरो नामदक्षिणे गंधमादनः ।\nविपुलः पश्चिमो ज्ञेयः सुपार्श्वस्तु तथोत्तरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003650034, "chapter_id": 23650, "verse_number": "१-२-३७-३५", "content_sanskrit": "कदंबो मंदरे ज्ञेयोजंबुर्वै गंधमादने ।\nअश्वत्थो विपुले चैव सुपार्श्वेच वटोमतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003650035, "chapter_id": 23650, "verse_number": "१-२-३७-३६", "content_sanskrit": "एकादशशतायामाश्चत्वारो गिरिकेतवः ।\nएतेषां संति चत्वारि वनानि जयमूर्धसु ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003650036, "chapter_id": 23650, "verse_number": "१-२-३७-३७", "content_sanskrit": "पूर्वं चैत्ररथं नामदक्षिणे गंधमादनम् ।\nवैभ्राजंपश्चिमे ज्ञेयमुदक्चित्ररथं वनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003650037, "chapter_id": 23650, "verse_number": "१-२-३७-३८", "content_sanskrit": "सरांसि चापि चत्वारि चतुर्दिक्षु निबोध मे ।\nप्राच्येऽरुणोदसंज्ञं तु मानसं दक्षिणे सरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003650038, "chapter_id": 23650, "verse_number": "१-२-३७-३९", "content_sanskrit": "प्रत्यक्छीतो दकंनाम उत्तरे च महाह्रदः ।\nविष्कंभगिरयो ह्येत उच्छ्रिताः पंचविंशतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003650039, "chapter_id": 23650, "verse_number": "१-२-३७-४०", "content_sanskrit": "योजनानां सहस्राणि सहस्रं पिंडतः स्मृतम् ।\nअन्ये च संति बहुशस्तत्र वै केसराचलाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003650040, "chapter_id": 23650, "verse_number": "१-२-३७-४१", "content_sanskrit": "मेरोर्दक्षिणतश्चैव त्रयो मर्यादपर्वताः ।\nनिषधो हेमकूटश्च हिमवानिति ते त्रयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003650041, "chapter_id": 23650, "verse_number": "१-२-३७-४२", "content_sanskrit": "लक्षयोजनदीर्घाश्च विस्तीर्णा द्विसहस्रकम् ।\nत्रयश्चोत्तरतो मेरोर्नीलः श्वेतोऽथ श्रृंगवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003650042, "chapter_id": 23650, "verse_number": "१-२-३७-४३", "content_sanskrit": "माल्यवान्पूर्वतो मेरोर्गंधाख्यः पश्चिमे तथा ।\nइत्येते गिरयः प्रोक्ता जंबुद्वीपे समंततः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003650043, "chapter_id": 23650, "verse_number": "१-२-३७-४४", "content_sanskrit": "गंधमादनसंस्थाया महागजप्रमाणतः ।\nफलानि जंबवास्तन्नाम्ना जंबूद्वीपमिति स्मृतम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003650044, "chapter_id": 23650, "verse_number": "१-२-३७-४५", "content_sanskrit": "आसीत्स्वायंभुवोनाम मनुराद्यः प्रजापतिः ।\nआसीत्स्त्री शतरूपा तामुदुवोढ प्रजापतिः ।\nप्रियव्रतोत्तानपादौ तस्याऽस्तां तनयावुभौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003650045, "chapter_id": 23650, "verse_number": "१-२-३७-४६", "content_sanskrit": "ध्रुवश्चोत्तानपादस्य पुत्रः परमधार्मिकः ।\nभक्त्या स विष्णुमाराध्य स्थानं चैवाक्षयं गतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003650046, "chapter_id": 23650, "verse_number": "१-२-३७-४७", "content_sanskrit": "प्रियव्रतस्य राजर्षेरुत्पन्ना दश सूनवः ।\nत्रयः प्रव्रजितास्तत्र परंब्रह्म समाश्रिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003650047, "chapter_id": 23650, "verse_number": "१-२-३७-४८", "content_sanskrit": "सप्त सप्तसु द्वीपेषु तेन पुत्राः प्रतिष्ठिताः ।\nजंबूद्वीपाधिपो ज्येष्ठ आग्नीध्र इति विश्रुतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003650048, "chapter_id": 23650, "verse_number": "१-२-३७-४९", "content_sanskrit": "तस्यासन्नव सुताः पार्थ नववर्षेश्वराः स्मृताः ।\nतेषां नाम्ना च ते वर्षास्तिष्ठंत्यद्यापि चांकिताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003650049, "chapter_id": 23650, "verse_number": "१-२-३७-५०", "content_sanskrit": "योजनानां सहस्राणि नव प्रत्येकशः स्मृताः ।\nमेरोश्चतुर्दशं खंडं गंधमाल्यवतोर्द्वयोः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003650050, "chapter_id": 23650, "verse_number": "१-२-३७-५१", "content_sanskrit": "अंतरे हेमभूमिष्ठमिलावृतमिहोच्यते ।\nमाल्यवत्सागरांतस्य भद्राश्वमिति प्रोच्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003650051, "chapter_id": 23650, "verse_number": "१-२-३७-५२", "content_sanskrit": "गंधवत्सागरांतस्य केतुमालमिति स्मृतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003650052, "chapter_id": 23650, "verse_number": "१-२-३७-५३", "content_sanskrit": "श्रृंगवज्जलधेरंतः कुरुखंडमिति स्मृतम् ।\nश्रृंगवच्छ्वेतमध्ये च खण्डं प्रोक्तं हिरण्मयम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003650053, "chapter_id": 23650, "verse_number": "१-२-३७-५४", "content_sanskrit": "सुनीलश्वेतयोर्मध्ये खंडमाहुश्च रम्यकम् ।\nनिषधो हेमकूटश्च हरिखंडं तदंतरा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003650054, "chapter_id": 23650, "verse_number": "१-२-३७-५५", "content_sanskrit": "हिमवद्धिमकूटांतः खण्डं किंपुरुषं स्मृतम् ।\nहिमाद्रिजलधेरन्तर्नाभि खण्डमिति स्मृतम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003650055, "chapter_id": 23650, "verse_number": "१-२-३७-५६", "content_sanskrit": "नाभिखण्डं च कुरवो द्वे वर्षे धनुपाकृती ।\nहिमवांश्च गिरिश्रृंगी ज्यास्थाने परिकीर्तितौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003650056, "chapter_id": 23650, "verse_number": "१-२-३७-५७", "content_sanskrit": "नाभेः पुत्रश्च ऋषभ ऋषभाद्बरतोऽभवत् ।\nतस्य नाम्ना त्विदं वर्षं भारतं चेति कीर्त्यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003650057, "chapter_id": 23650, "verse_number": "१-२-३७-५८", "content_sanskrit": "अत्र धर्मार्थकामानां मोक्षस्य च उपार्जनम् ।\nअन्यत्र भोगभूमिश्च सर्वत्र कुरुनंदन ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003650058, "chapter_id": 23650, "verse_number": "१-२-३७-५९", "content_sanskrit": "शाकद्वीपे च शाकोऽस्ति योजनानां सहस्रकः ।\nतस्य नाम्ना च तद्वर्षं शाकद्वीपमिति स्मृतम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003650059, "chapter_id": 23650, "verse_number": "१-२-३७-६०", "content_sanskrit": "तस्य च प्रियव्रत एवाधिपतिर्नाम्ना मेधातिथिरिति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003650060, "chapter_id": 23650, "verse_number": "१-२-३७-६१", "content_sanskrit": "तस्य पुरोजवमनोजववेपमानधूम्रानीकचित्ररेफबहुरूपविश्वचारसंज्ञानि पुत्रनामानि सप्त वर्षाणि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003650061, "chapter_id": 23650, "verse_number": "१-२-३७-६२", "content_sanskrit": "शाकद्वीपे च वर्ष ऋतव्रतसत्यव्रतानुव्रतनामानो वाय्यवात्कमं भगवंतं जपंति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003650062, "chapter_id": 23650, "verse_number": "१-२-३७-६३", "content_sanskrit": "अंतः प्रविश्य भूतानि यो विभज्यात्मकेतुभिः ।\nअंतर्यामीश्वरः साक्षात्पातु नो यद्वशे जगत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003650063, "chapter_id": 23650, "verse_number": "१-२-३७-६४", "content_sanskrit": "इति जपः ।\nकुशद्वीपे कुशस्तंबो योजनानां सहस्रकः ।\nतच्चिह्नचिह्नितं तस्मात्कुशद्वीपं ततः स्मृतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003650064, "chapter_id": 23650, "verse_number": "१-२-३७-६५", "content_sanskrit": "तद्द्वीपपतिश्च प्रैयव्रतो हिरण्यरोमा तत्पुत्रवसुवसुदानदृढकविनाभिगुप्तसत्यव्रतवामदेवनामांकितानि सप्त वर्षाणि ।\nवर्णाश्च कुलिशकोविदाभियुक्तकुलकसंज्ञा जातवेदसं भगवंतं स्तुवंति ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003650065, "chapter_id": 23650, "verse_number": "१-२-३७-६६", "content_sanskrit": "परस्य ब्रह्णः साक्षाज्जातवेदासि हव्यवाट् ।\nदेवानां पुरुषांगानां यज्ञेन पुरुषं यजः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003650066, "chapter_id": 23650, "verse_number": "१-२-३७-६७", "content_sanskrit": "इति स्तुतिः ।\nक्रौंचद्वीपे क्रौंचनामा पर्वतो योजनायतः ।\nयोऽसौ गुहेन निर्भिन्नस्तच्चिह्नं क्रौंचद्वीपकम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003650067, "chapter_id": 23650, "verse_number": "१-२-३७-६८", "content_sanskrit": "तत्र च प्रैयव्रतो घृतपृष्टिनामा तत्पुत्राममधुरुहमेघपृष्ठस्वदामऋताश्वलोहितार्णववनस्पतिइतिसप्तपुत्रनामांकितानि सप्त वर्षाणि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003650068, "chapter_id": 23650, "verse_number": "१-२-३७-६९", "content_sanskrit": "वर्णाश्च गुरुऋषभद्रविणदेवकसंज्ञाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003650069, "chapter_id": 23650, "verse_number": "१-२-३७-७०", "content_sanskrit": "आपोमयं भगवंतं स्तुवंति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003650070, "chapter_id": 23650, "verse_number": "१-२-३७-७१", "content_sanskrit": "आपः पुरुषवीर्याश्च पुनंतीर्भूर्भूवःस्वश्च ।\nतैः पुनरमीवघ्नाःसंस्पृशेतात्मना भुवः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003650071, "chapter_id": 23650, "verse_number": "१-२-३७-७२", "content_sanskrit": "इति जपः ।\nशाल्मलेर्नाम वृक्षस्य तत्रवासः सहस्रं योजनानां तच्चिह्नं शाल्मलिद्विपमुच्यते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003650072, "chapter_id": 23650, "verse_number": "१-२-३७-७३", "content_sanskrit": "तस्याधिपतिः प्रैयव्रतो यज्ञबाहुस्तत्पुत्रसुरोचनसौमनस्यरमणकदेवबर्हिपारिभद्राप्यायनाभिज्ञाननामानि सप्तवर्षाणि ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003650073, "chapter_id": 23650, "verse_number": "१-२-३७-७४", "content_sanskrit": "वर्णाश्च श्रुतधरवीर्यवसुंधरैषंधरसंज्ञा भगवंतं सोमं यजंति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003650074, "chapter_id": 23650, "verse_number": "१-२-३७-७५", "content_sanskrit": "स्वयोनिः पितृदेवेभ्यो विभजञ्छुक्लकृष्णयोः ।\nअधः प्रजानां सर्वासां राजा नः सोमोस्तु ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003650075, "chapter_id": 23650, "verse_number": "१-२-३७-७६", "content_sanskrit": "इति जपः गोमेदनामा प्लक्षोस्ति सुरम्यो यस्य च्छायया ।\nमोदोवृद्धिं गतं लौल्याद्गोमेदं द्वीपमुच्यते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003650076, "chapter_id": 23650, "verse_number": "१-२-३७-७७", "content_sanskrit": "तत्र प्रैयव्रत इध्मजिह्वः पतिस्तत्पुत्रसिवसुरम्यसुभद्र शांत्यशप्तमृताभयनामांकितानि सप्त वर्षाणि ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003650077, "chapter_id": 23650, "verse_number": "१-२-३७-७८", "content_sanskrit": "वर्णाश्च हंसपतंगोर्ध्वांचनसत्यांगसंज्ञाश्चत्वारो भगवंतं सूर्यं यजंते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003650078, "chapter_id": 23650, "verse_number": "१-२-३७-७९", "content_sanskrit": "प्रश्रस्य विष्णुरूपंयत्तत्रोत्थस्य ब्रह्मणोऽमृतस्य च ।\nमृत्योश्च सूर्यमात्मानं धीमहि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003650079, "chapter_id": 23650, "verse_number": "१-२-३७-८०", "content_sanskrit": "इति जपः ।\nस्वर्णपत्राणि नियुतं योजनानां सहस्रकम् ।\nपुष्करं ज्वलदा भाति तच्चिह्नं द्वीपपुष्करम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003650080, "chapter_id": 23650, "verse_number": "१-२-३७-८१", "content_sanskrit": "तस्याधिपतिः प्रैयव्रतो वीतहोत्रनामा तत्पुत्रौ रमणकघातकौ ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003650081, "chapter_id": 23650, "verse_number": "१-२-३७-८२", "content_sanskrit": "तन्नामचिह्नतं खंडद्वयम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003650082, "chapter_id": 23650, "verse_number": "१-२-३७-८३", "content_sanskrit": "तयोरंतरालेमानसाचलो नाम वलयाकारः पर्वतो यस्मिन्भ्रमति भगवान्भास्कर इति ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003650083, "chapter_id": 23650, "verse_number": "१-२-३७-८४", "content_sanskrit": "तत्र वर्णाश्च न संति केवलं समानास्ते ब्रह्म ध्यायंति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003650084, "chapter_id": 23650, "verse_number": "१-२-३७-८५", "content_sanskrit": "यद्यत्कर्ममयं लिंगं ब्रह्मलिंगं जनोर्चयन् ।\nभेदेनैकांतमद्वैतं तस्मै भगवते नमः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003650085, "chapter_id": 23650, "verse_number": "१-२-३७-८६", "content_sanskrit": "इति जपः ।\nनैषु क्रोधो न मात्सर्यं पुण्यपापार्जनेन च ।\nअयुतं द्विगुणं चापि क्रमादायुः प्रकीर्तितम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003650086, "chapter_id": 23650, "verse_number": "१-२-३७-८७", "content_sanskrit": "जपंतः कामिनीयुक्ता विहरंत्यमरा इव ।\nअथ ते संप्रवक्ष्यामि ऊर्ध्वलोकस्य संस्थितिम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]