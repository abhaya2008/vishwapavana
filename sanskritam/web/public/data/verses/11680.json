[{"id": 50021255, "chapter_id": 11680, "verse_number": "1", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50021256, "chapter_id": 11680, "verse_number": "2", "content_sanskrit": "जितेन्द्रियस्य युक्तस्य जितश्वासस्य योगिनः। मयि धारयतश्चेत उपतिष्ठन्ति सिद्धयः॥ ११/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50021257, "chapter_id": 11680, "verse_number": "3", "content_sanskrit": "उद्धव उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50021258, "chapter_id": 11680, "verse_number": "4", "content_sanskrit": "कया धारणया का स्वित् कथं वा सिद्धिरच्युत। कति वा सिद्धयो ब्रूहि योगिनां सिद्धिदो भवान्॥ ११/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50021259, "chapter_id": 11680, "verse_number": "5", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50021260, "chapter_id": 11680, "verse_number": "6", "content_sanskrit": "सिद्धयोऽष्टादश प्रोक्ता धारणायोगपारगैः। तासामष्टौ मत्प्रधाना ता एव१ गुणहेतवः॥ ११/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50021261, "chapter_id": 11680, "verse_number": "7", "content_sanskrit": "अणिमा महिमा मूर्तेर्लघिमा प्राप्तिरिन्द्रियैः। प्राकाश्यं श्रुतदृष्टेषु शक्तिप्रेरणमीशिता॥ ११/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50021262, "chapter_id": 11680, "verse_number": "8", "content_sanskrit": "गुणेष्वसङ्गो वशिता यत्कामस्तदवाप्स्यति। एता मे सिद्धयः सौम्य अष्टावौत्पत्तिका मताः॥ ११/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50021263, "chapter_id": 11680, "verse_number": "9", "content_sanskrit": "अनूर्मिमत्त्वं देहेऽस्मिन् दूरश्रवणदर्शनम्। मनोजवः कामरूपं परकायप्रवेशनम्॥ ११/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50021264, "chapter_id": 11680, "verse_number": "10", "content_sanskrit": "स्वच्छन्दमृत्युर्देवानां सहक्रीडानुदर्शनम्। यथासङ्कल्पसंसिद्धिराज्ञाऽप्रतिहतागतिः॥ ११/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50021265, "chapter_id": 11680, "verse_number": "11", "content_sanskrit": "त्रिकालज्ञत्वमद्वन्द्वं परचित्ताद्यभिज्ञता। अग्न्यर्काम्बुविषादीनां प्रतिस्तम्भोऽपराजयः॥ ११/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50021266, "chapter_id": 11680, "verse_number": "12", "content_sanskrit": "एताश्चाष्टादश प्रोक्ता योगधारणसिद्धयः। यया धारणयाऽद्धा स्याद् यथा वा स्यान्निबोध मे॥ ११/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50021267, "chapter_id": 11680, "verse_number": "13", "content_sanskrit": "भूतसूक्ष्मात्मनि मयि तन्मात्रं धारयन् मनः। अणिमानमवाप्नोति तन्मात्रोपासको मम॥ ११/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50021268, "chapter_id": 11680, "verse_number": "14", "content_sanskrit": "महत्यात्मन् मयि परे यथासंस्थं मनो दधत्। महिमानमवाप्नोति भूतानां च पृथक्पृथक्॥ ११/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50021269, "chapter_id": 11680, "verse_number": "15", "content_sanskrit": "परमाणुमये चित्तं भूतानां मयि रञ्जयन्। कालसूक्ष्मात्मके योगी लघिमानमवाप्नुयात्॥ ११/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50021270, "chapter_id": 11680, "verse_number": "16", "content_sanskrit": "धारयन् मय्यहन्तत्वे मनो वैकारिकेऽखिलम्। सर्वेन्द्रियाणामात्मत्वं प्राप्तिं प्राप्नोति मन्मनाः॥ ११/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50021271, "chapter_id": 11680, "verse_number": "17", "content_sanskrit": "महत्यात्मनि यः सूत्रे धारयन् मयि मानसम्। प्राकाश्यं पारमेष्ठ्यं मे विन्दतेऽव्यक्तजन्मनः॥ ११/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50021272, "chapter_id": 11680, "verse_number": "18", "content_sanskrit": "विष्णौ चाधीश्वरे चित्तं धारयन् कालविग्रहे। स ईशित्वमवाप्नोति क्षेत्रक्षेत्रज्ञचोदनम्॥ ११/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50021273, "chapter_id": 11680, "verse_number": "19", "content_sanskrit": "नारायणे तुरीयाख्ये भगवच्छब्दशब्दिते। मनो मय्यादधद्योगी मद्धर्मो वशितामियात्॥ ११/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50021274, "chapter_id": 11680, "verse_number": "20", "content_sanskrit": "निर्गुणे ब्रह्मणि मयि धारयन् विशदं मनः। परमानन्दमाप्नोति यत्र कामोऽवसीयते॥ ११/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50021275, "chapter_id": 11680, "verse_number": "21", "content_sanskrit": "श्वेतद्वीपपतौ चित्तं शुद्धे धर्ममये मयि। धारयन् श्वेततां याति षडूर्मिरहितोऽमरः॥ ११/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50021276, "chapter_id": 11680, "verse_number": "22", "content_sanskrit": "मय्याकाशात्मनि प्राणे मनसा घोषमुद्वहन्। तत्रोपलब्धा भूतानां हंसो वाचः शृणोत्यसौ॥ ११/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50021277, "chapter_id": 11680, "verse_number": "23", "content_sanskrit": "चक्षुस्त्वष्टरि संयोज्य त्वष्टारमपि चक्षुषि। मां तत्र मनसा ध्यायन् विश्वं पश्यति सूक्ष्मदृक्॥ ११/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50021278, "chapter_id": 11680, "verse_number": "24", "content_sanskrit": "मनो मनसि संयोज्य देहं तदनु वायुना। मद्धारणानुभावेन तत्रात्मा यत्र वै मनः॥ ११/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50021279, "chapter_id": 11680, "verse_number": "25", "content_sanskrit": "यदा मन उपादाय यद्यद् रूपं बुभूषति। तत्तद् भजेन्मनोरूपं मद्योगबलमाश्रितः॥ ११/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50021280, "chapter_id": 11680, "verse_number": "26", "content_sanskrit": "परकायं विशन् सिद्ध आत्मानं तत्र भावयेत्। पिण्डं हित्वा विशेत् प्राणो वायुभूतः षडङ्घ्रिवत्॥ ११/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50021281, "chapter_id": 11680, "verse_number": "27", "content_sanskrit": "पाष्र्ण्याऽऽपीड्य गुदं प्राणं हृदुरःकण्ठमूर्धसु। आरोप्य ब्रह्मरन्ध्रेण ब्रह्म नीत्वोत्सृजेत् तनुम्॥ ११/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50021282, "chapter_id": 11680, "verse_number": "28", "content_sanskrit": "विहरिष्यन् सुराक्राडे मत्स्थं सत्वं विभावयेत्। विमानेनोपतिष्ठन्ति सत्ववृत्तिं सुरस्त्रियः॥ ११/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50021283, "chapter_id": 11680, "verse_number": "29", "content_sanskrit": "यथा सङ्कल्पयेद् बुद्ध्या यथा वा मत्परः पुमान्। मयि सत्ये मनो युञ्जन् तथा तत् समवाप्नुते॥ ११/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50021284, "chapter_id": 11680, "verse_number": "30", "content_sanskrit": "यो वै मद्भावमापन्न ईशितुर्वशितुः पुमान्। न कुतश्चन हन्येत तस्य चाज्ञा यथा मम॥ ११/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50021285, "chapter_id": 11680, "verse_number": "31", "content_sanskrit": "मद्भक्त्या शुद्धसत्वस्य योगिनो धारणाविदः। तस्य त्रैकालिका बुद्धिर्जन्ममृत्यूपबृंहिता॥ ११/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50021286, "chapter_id": 11680, "verse_number": "32", "content_sanskrit": "अग्न्यादिभिर्न हन्येत मुनेर्योगमयं वपुः। मद्योगश्रान्तचित्तस्य यादसामुदकैर्यथा॥ ११/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50021287, "chapter_id": 11680, "verse_number": "33", "content_sanskrit": "मद्विभूतीरभिध्यायन् श्रीवत्सास्त्रविभूषिताः। ध्वजातपत्रव्यजनैः स भवेदपराजितः॥ ११/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50021288, "chapter_id": 11680, "verse_number": "34", "content_sanskrit": "उपासकस्य मामेवं योगधारणया पुनः। सिद्धयः पूर्वकथिता उपतिष्ठन्त्यशेषतः॥ ११/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50021289, "chapter_id": 11680, "verse_number": "35", "content_sanskrit": "जितेन्द्रियस्य दान्तस्य जितश्वासात्मनो मुनेः। मद्धारणां धारयतः का नु सिद्धिः सुदुर्लभा॥ ११/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50021290, "chapter_id": 11680, "verse_number": "36", "content_sanskrit": "अन्तरायान् वदन्त्येतान् युञ्जतो योगमुत्तमम्। मया सम्पद्यमानस्य कालक्षेपणहेतवः॥ ११/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50021291, "chapter_id": 11680, "verse_number": "37", "content_sanskrit": "जन्मौषधितपोमन्त्रैर्यावतीरिह सिद्धयः। योगेनाप्नोति ताः सर्वा यैर्यैर्योगगतिं व्रजेत्॥ ११/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50021292, "chapter_id": 11680, "verse_number": "38", "content_sanskrit": "सर्वासामपि सिद्धीनां हेतुः पतिरहं प्रभुः। अहं योगस्य साङ्ख्यस्य धर्मस्य ब्रह्मवादिनाम्॥ ११/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50021293, "chapter_id": 11680, "verse_number": "39", "content_sanskrit": "अहमात्माऽन्तरो बाह्योऽनावृतः सर्वदेहिनाम्। यथा भूतानि भूतेषु बहिरन्तस्त्वहं तथा॥ ११/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50021294, "chapter_id": 11680, "verse_number": "40", "content_sanskrit": "इति श्रीमद्भागवते एकादशस्कन्धे पञ्चदशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]