[{"id": 7006237000, "chapter_id": 26237, "verse_number": "२-६५-१", "content_sanskrit": "सूत उवाच पिता सोमस्य वै विप्रा जज्ञेऽत्रिर्भगवानृषिः ।\nतत्रात्रिः सर्वलोकानां तस्थौ स्वेनौजसा वृतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006237001, "chapter_id": 26237, "verse_number": "२-६५-२", "content_sanskrit": "कर्मणा मनसा वाचा शुभान्येव समाचरन् ।\nकाष्ठकुड्यशिलाभूत ऊर्द्ध्वबाहुर्महाद्युतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006237002, "chapter_id": 26237, "verse_number": "२-६५-३", "content_sanskrit": "सुदुश्चरं नाम तपो येन तप्तं महात्पुरा ।\nत्रीणि वर्षसहस्राणि दिव्यानीति हि नः श्रुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006237003, "chapter_id": 26237, "verse_number": "२-६५-४", "content_sanskrit": "तस्योर्द्ध्वरेतसस्तत्र स्थितस्यानिमिषस्य ह ।\nसोमत्वं तनुरापेदे महाबुद्धिः स वै द्विजः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006237004, "chapter_id": 26237, "verse_number": "२-६५-५", "content_sanskrit": "ऊर्द्ध्वमाचक्रमे तस्य सोमत्वं भावितात्मनः ।\nनेत्राभ्या मस्रवत्सोमो दशधा द्योतयन् दिशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006237005, "chapter_id": 26237, "verse_number": "२-६५-६", "content_sanskrit": "तं गर्भं विधिना हृष्टा दश देव्यो दधुस्तदा ।\nसमेत्य धारयामासुर्न च ताः समशक्नुवन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006237006, "chapter_id": 26237, "verse_number": "२-६५-७", "content_sanskrit": "स ताभ्यः सहसैवाथ दिग्भ्यो गर्भः प्रसाधितः ।\nपपात भासयंल्लोकाञ्छीतांशुः सर्वभावनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006237007, "chapter_id": 26237, "verse_number": "२-६५-८", "content_sanskrit": "यदा न धारणे शक्तास्तस्य गर्भस्य ताः स्त्रियः ।\nततः सहाभिः शीतांशुर्निपपात वसुंधराम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006237008, "chapter_id": 26237, "verse_number": "२-६५-९", "content_sanskrit": "पतन्तं सोममालोक्य ब्रह्मा लोकपितामहः ।\nरथमारोपयामास लोकानां हितकाम्यया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006237009, "chapter_id": 26237, "verse_number": "२-६५-१०", "content_sanskrit": "स हि वेदमयो विप्रा धर्मात्मा सत्यसंगरः ।\nयुक्ते वाजिसहस्रेण रथेऽध्यास्तेति नःश्रुतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006237010, "chapter_id": 26237, "verse_number": "२-६५-११", "content_sanskrit": "तस्मिन्निपतिते देवाः पुत्रेऽत्रेः परमात्मनः ।\nतुष्टुवुर्ब्रह्मणः पुत्रा मानसाः सप्त विश्रुताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006237011, "chapter_id": 26237, "verse_number": "२-६५-१२", "content_sanskrit": "तत्रैवाङ्गिरसास्तस्य भृगोश्चैवात्मजास्तथा ।\nऋग्भिर्यजुर्भिर्बहुभिरथर्वाङ्गिरसैरपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006237012, "chapter_id": 26237, "verse_number": "२-६५-१३", "content_sanskrit": "ततः संस्तूयमानस्य तेजः सोमस्य भास्वतः ।\nआप्यायमानं लोकांस्त्रीन्भावयामास सर्वशः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006237013, "chapter_id": 26237, "verse_number": "२-६५-१४", "content_sanskrit": "स तेन रथमुख्येन सागरान्तां वसुंधराम् ।\nत्रिःसप्तकृत्वोऽतियशाश्चकाराभिप्रदक्षिणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006237014, "chapter_id": 26237, "verse_number": "२-६५-१५", "content_sanskrit": "तस्य यद्वर्द्धितं तेजः पृथिवीमन्वपद्यत ।\nओषध्यस्ताः समुद्भूतास्तेजसा खं ज्वलत्युत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006237015, "chapter_id": 26237, "verse_number": "२-६५-१६", "content_sanskrit": "ताभिः पुण्यात्ययं लोकान्प्रजाश्चापि चतुर्विधाः ।\nपोष्टा हि भगवान्सोमो जगतो हि द्विजोत्तमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006237016, "chapter_id": 26237, "verse_number": "२-६५-१७", "content_sanskrit": "स लब्धतेजास्तपसा संस्तवैस्तैः स्वकर्मभिः ।\nतवस्तेपे महाभागः समानां नवतीर्दश ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006237017, "chapter_id": 26237, "verse_number": "२-६५-१८", "content_sanskrit": "इरण्यवर्णा या देव्यो धारयन्त्यात्मना जगत् ।\nविभुस्तासां मुदा सोमः प्रख्यातःस्वेन कर्मणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006237018, "chapter_id": 26237, "verse_number": "२-६५-१९", "content_sanskrit": "ततस्तस्मै ददौ राज्यं ब्रह्मा ब्रह्मविदां वरः ।\nबीजौषधीनां विप्राणामपां च द्विजसत्तमाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006237019, "chapter_id": 26237, "verse_number": "२-६५-२०", "content_sanskrit": "सोऽभिषिक्तो महातेजा महाराज्येन राजराट् ।\nलोकान्वै भावयामास तेजस्वी तपतां वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006237020, "chapter_id": 26237, "verse_number": "२-६५-२१", "content_sanskrit": "सप्तविंशतिरिन्दोस्तु दाक्षायण्यो महाव्रताः ।\nददौ प्राचेतसो दक्षो नक्षत्राणीति या विदुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006237021, "chapter_id": 26237, "verse_number": "२-६५-२२", "content_sanskrit": "स तत्प्राप्य महाद्राज्यं सोमः सोमवतां प्रभुः ।\nसमारेभे राजसूयं सहस्रशतदक्षिणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006237022, "chapter_id": 26237, "verse_number": "२-६५-२३", "content_sanskrit": "हिरण्यगर्भश्चोद्गाता ब्रह्मा ब्रह्मत्वमीयिवान् ।\nसदस्यस्तत्र भगवान्हरिर्नारायणः प्रभुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006237023, "chapter_id": 26237, "verse_number": "२-६५-२४", "content_sanskrit": "सनत्कुमारप्रमुखैराद्यैर्ब्रह्मर्षिभिर्वृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006237024, "chapter_id": 26237, "verse_number": "२-६५-२५", "content_sanskrit": "दक्षिणामददात्सोमस्त्रींल्लोकानिति नः श्रुतम् ।\nतेभ्यो ब्रह्मर्षिमुख्येभ्यः सदस्येभ्यश्च वै द्विजाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006237025, "chapter_id": 26237, "verse_number": "२-६५-२६", "content_sanskrit": "तं सिनी च कुहूश्चैव वपुः पुष्टिः प्रभा वसुः ।\nकीर्त्तिर्धृतिश्च लक्ष्मीश्च नव देव्यः सिषेविरे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006237026, "chapter_id": 26237, "verse_number": "२-६५-२७", "content_sanskrit": "प्राप्यावभृथमव्यग्रः सर्वदेवर्षिपूजितः ।\nअतिरेजे हि राजेन्द्रो दशधा भासयन्दिशः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006237027, "chapter_id": 26237, "verse_number": "२-६५-२८", "content_sanskrit": "तस्य तत्प्राप्य दुष्प्रापमैश्वर्यमृषिसंस्तुतम् ।\nविबभ्राम मतिर्विप्रा विनयादनयावृता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006237028, "chapter_id": 26237, "verse_number": "२-६५-२९", "content_sanskrit": "बृहस्पतेः सवै भार्यां तारां नाम यशस्विनीम् ।\nजहार सहसा सर्वानवमत्याङ्गिरःसुतान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006237029, "chapter_id": 26237, "verse_number": "२-६५-३०", "content_sanskrit": "स याच्यमानो देवैश्च तथा देवर्षिभिश्च ह ।\nनैव व्यसर्जयत्तारां तस्मा अङ्गिरसे तदा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006237030, "chapter_id": 26237, "verse_number": "२-६५-३१", "content_sanskrit": "उशनास्तस्य जग्राह पार्ष्णिमङ्गिरसो भवः ।\nस हि शिष्यो महातेजाः पितुः पूर्वं बृहस्पतेः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006237031, "chapter_id": 26237, "verse_number": "२-६५-३२", "content_sanskrit": "तेन स्नेहेन भगवान्रुद्रस्तस्य बृहस्पतेः ।\nपार्ष्मिग्राहोऽभवद्देवः प्रगृह्याजगवं धनुः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006237032, "chapter_id": 26237, "verse_number": "२-६५-३३", "content_sanskrit": "तेन ब्रह्मशिरो नाम परमास्त्रं महात्मना ।\nउद्दिश्य देवानुत्सृष्टं येनैषां नाशितं यशः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006237033, "chapter_id": 26237, "verse_number": "२-६५-३४", "content_sanskrit": "तत्र तद्युद्धमभवत्प्रख्यातं तारकामयम् ।\nदेवानां दानवानां च लोकक्षयकरं महत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006237034, "chapter_id": 26237, "verse_number": "२-६५-३५", "content_sanskrit": "तत्र शिष्टास्तु ये देवास्तुषिताश्चैव ते स्मृताः ।\nब्रह्माणं शरणं जग्मुरादिदेवं पितामहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006237035, "chapter_id": 26237, "verse_number": "२-६५-३६", "content_sanskrit": "ततो निवार्योशनसं रुद्रं ज्येष्ठं च शङ्करम् ।\nददावाङ्गिरसे तारां स्वयमेत्य पितामहः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006237036, "chapter_id": 26237, "verse_number": "२-६५-३७", "content_sanskrit": "अन्तर्वत्नीं च तां दृष्ट्वा तारां ताराधिपाननाम् ।\nगर्भमुत्सृज सद्यस्त्वं विप्रः प्राह बृहस्पतिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006237037, "chapter_id": 26237, "verse_number": "२-६५-३८", "content_sanskrit": "मदीयायां न ते योनौ गर्भो धार्यः कथञ्चन ।\nअथो तारासृजद्गर्भं ज्वलन्तमिव पावकम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006237038, "chapter_id": 26237, "verse_number": "२-६५-३९", "content_sanskrit": "जातमात्रोऽथ भगवान्देवानामाक्षिपद्वपुः ।\nततः संशयमापन्नस्तारामकथयन्सुराः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006237039, "chapter_id": 26237, "verse_number": "२-६५-४०", "content_sanskrit": "सत्यं ब्रूहि सुतः कस्य सोमस्याथ बृहस्पतेः ।\nह्रीयमाणा यदा देवान्नाह सा साध्वसाधु वा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006237040, "chapter_id": 26237, "verse_number": "२-६५-४१", "content_sanskrit": "तदा तां शप्तुमारब्धः कुमारो दस्युहन्तमः ।\nतं निवार्य तदाब्रह्मा तारां पप्रच्छ संशयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006237041, "chapter_id": 26237, "verse_number": "२-६५-४२", "content_sanskrit": "यदत्र तथ्यं तद्ब्रूहि तारे कस्य सुतस्त्वयम् ।\nसा प्राञ्जलिरुवाचेदं ब्रह्माणं वरदं प्रभुम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006237042, "chapter_id": 26237, "verse_number": "२-६५-४३", "content_sanskrit": "सोमस्यति महात्मानं कुमारं दस्युहन्तमम् ।\nततः सुतमुपाघ्राय सोमो राजा प्रजापतिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006237043, "chapter_id": 26237, "verse_number": "२-६५-४४", "content_sanskrit": "बुध इत्यकरोन्नाम तस्य पुत्रस्य धीमतः ।\nप्रतिघस्रं च गगने समभ्युत्तिष्ठते बुधः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006237044, "chapter_id": 26237, "verse_number": "२-६५-४५", "content_sanskrit": "उत्पादयामास तदा पुत्रं वे राजपुत्रिका ।\nतस्य पुत्रो महातेजा बभूवैलः पुरूरवाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006237045, "chapter_id": 26237, "verse_number": "२-६५-४६", "content_sanskrit": "उर्वश्यां जज्ञिरे तस्य पत्राः षट्सुमहौजसः ।\nप्रसह्य धर्षितस्तत्र विवशो राजयक्ष्मणा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006237046, "chapter_id": 26237, "verse_number": "२-६५-४७", "content_sanskrit": "ततो यक्ष्माभिभूतस्तु सोमः प्रक्षिणमण्डलः ।\nजगाम शरणायाथ पितरं सोऽत्रिमेव तु ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006237047, "chapter_id": 26237, "verse_number": "२-६५-४८", "content_sanskrit": "तस्य तत्पापशमनं चकारात्रिर्महायशाः ।\nस राजयक्ष्मणा मुक्तः श्रीया जजवाल सर्वशः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006237048, "chapter_id": 26237, "verse_number": "२-६५-४९", "content_sanskrit": "एतत्सोमस्य वै जन्म कीर्त्तितं द्विजसत्तमाः ।\nवंशं तस्य द्विजश्रेष्ठा कीर्त्यमानं निबोधत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006237049, "chapter_id": 26237, "verse_number": "२-६५-५०", "content_sanskrit": "धन्यमारोग्यमायुष्यं पुण्यं कल्मषशोधनम् ।\nसौम्यस्य चन्म श्रुत्वैवं सर्वपापैः प्रमुच्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]