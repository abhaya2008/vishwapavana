[{"id": 2075153, "chapter_id": 2589, "verse_number": "१२-९४-०x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075154, "chapter_id": 2589, "verse_number": "१२-९४-१", "content_sanskrit": "अयुद्धेनैव विजयं वर्धयेद्वसुधाधिपः।\nजघन्यमाहुर्विजयं युद्धेन च नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075155, "chapter_id": 2589, "verse_number": "१२-९४-२", "content_sanskrit": "न चाप्यलब्धं लिप्सेत मूले नातिदृढे सति।\nन हि दुर्बलमूलस्य राज्ञो लाभो विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075156, "chapter_id": 2589, "verse_number": "१२-९४-३", "content_sanskrit": "यस्य स्फीतो जनपदः संपन्नप्रियराजकः।\nसंतुष्टः पुष्टसचिवो दृढमूलः स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075157, "chapter_id": 2589, "verse_number": "१२-९४-४", "content_sanskrit": "यस्य योधाः सुसंतुष्टाः स्वनुरक्ताः सुपूजिताः।\nअल्पेनापि स दण्डेन महीं जयति पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075158, "chapter_id": 2589, "verse_number": "१२-९४-५", "content_sanskrit": "`दण्डो हि बलवान्यत्र तत्र साम प्रयुज्यते।\nप्रदानं सामपूर्वं च भेदमूलं प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075159, "chapter_id": 2589, "verse_number": "१२-९४-६", "content_sanskrit": "त्रयाणां विफलं कर्म यदा पश्येत भूमिपः।\nरन्ध्रं ज्ञात्वा ततो दण्डं प्रयुञ्जीताविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075160, "chapter_id": 2589, "verse_number": "१२-९४-७", "content_sanskrit": "अभिभूतो यदा शत्रुः शत्रुभिर्बलवत्तरैः।\nउपेक्षा तत्र कर्तव्या वध्यता बलिनां बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075161, "chapter_id": 2589, "verse_number": "१२-९४-८", "content_sanskrit": "दुर्बलो हि महीपालो यदा भवति भारत।\nउपेक्षा तत्र कर्तव्या चतुर्णामविरोधीनि।\nउपायः पञ्चमः सोऽपि सर्वेषां बलवत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075162, "chapter_id": 2589, "verse_number": "१२-९४-९", "content_sanskrit": "भार्गवेण च गीतानां श्लोकानां कोसलाधिप।\nविज्ञाय तत्वं तत्वज्ञ तत्वतस्तत्करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075163, "chapter_id": 2589, "verse_number": "१२-९४-१०", "content_sanskrit": "यदि रक्षःपिशाचेन हन्यते यत्रकुत्रचित्।\nउपेक्षा तत्र कर्तव्या वाच्यतां बलिनां बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075164, "chapter_id": 2589, "verse_number": "१२-९४-११", "content_sanskrit": "दुर्बलोऽपि महीपाल शत्रूणां शत्रुमुद्धरेत्।\nपादलग्नं करस्थेन कण्टकेनैव कण्टकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075165, "chapter_id": 2589, "verse_number": "१२-९४-१२", "content_sanskrit": "शठानां उचिवानां च म्लेच्छानां च महीपते।\nएष उक्त उपायानामुपेक्षा बलवत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075166, "chapter_id": 2589, "verse_number": "१२-९४-१३", "content_sanskrit": "अश्मना नाशयेल्लोहं लोहेनाश्मानमेव तु।\nबिल्वानि वा परैर्बिल्वैर्म्लेच्छैर्म्लेच्छान्प्रसादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075167, "chapter_id": 2589, "verse_number": "१२-९४-१४", "content_sanskrit": "दासानां च प्रदृप्तानामेतदेव हि कारयेत्।\nचण्डालम्लेच्छजातीनां दण्डेनैव निवारणम्।\nशठानां दुर्विनीतैश्च पूर्वमुक्तं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075168, "chapter_id": 2589, "verse_number": "१२-९४-१५", "content_sanskrit": "अन्त्याः शठाश्च सचिवास्तथा कुब्राह्मणादयः।\nउपायैः पञ्चभिः साध्याश्चतुर्वर्गविरोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075169, "chapter_id": 2589, "verse_number": "१२-९४-१६", "content_sanskrit": "पौरजानपदा यस्य स्वनुरक्ता अपीडिताः।\nराष्ट्रकर्मकरा ह्येते राष्ट्रस्य च विरोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075170, "chapter_id": 2589, "verse_number": "१२-९४-१७", "content_sanskrit": "दुर्विनीता विनीताश्च सर्वे साध्याः प्रयत्नतः।\nचण्डालम्लेच्छजात्याश्च पाषण्डाश्च विकर्मिणः।\nबलिनश्चाश्रमाश्चैव तथा गायकनर्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075171, "chapter_id": 2589, "verse_number": "१२-९४-१८", "content_sanskrit": "पौरजानपदा यस्य भूतेषु च दयालवः।\nसधना धान्यवन्तश्च दृढमूलः स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075172, "chapter_id": 2589, "verse_number": "१२-९४-१९", "content_sanskrit": "प्रतापकालमधिकं यदा मन्येत चात्मनः।\nतदा लिप्सेत मेधावी परभूमिधनान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075173, "chapter_id": 2589, "verse_number": "१२-९४-२०", "content_sanskrit": "भोगेषूदयमानस्य भूतेषु च दयावतः।\nवर्धते त्वरमाणस्य विषयो रक्षितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075174, "chapter_id": 2589, "verse_number": "१२-९४-२१", "content_sanskrit": "तक्षेदात्मानमेवं स वनं परशुना यथा।\nयः सम्यग्वर्तमानेषु स्वेषु मिथ्या प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075175, "chapter_id": 2589, "verse_number": "१२-९४-२२", "content_sanskrit": "नैव द्विषन्तो हीयन्ते राज्ञो नित्यमनिघ्नतः।\nक्रोधं निहन्तुं यो वेद तस्य द्वेष्टा न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075176, "chapter_id": 2589, "verse_number": "१२-९४-२३", "content_sanskrit": "यदार्यजनविद्विष्टं कर्म तन्नाचरेद्बुधः।\nयत्कल्याणमभिध्यायेत्तत्रात्मानं नियोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075177, "chapter_id": 2589, "verse_number": "१२-९४-२४", "content_sanskrit": "नैवमन्येऽवजानन्ति नात्मना परितप्यते।\nकृत्यशेषेण यो राजा सुखान्यनुबुभूषति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075178, "chapter_id": 2589, "verse_number": "१२-९४-२५", "content_sanskrit": "इदं वृत्तं मनुष्येषु वर्तते यो महीपतिः।\nउभौ लोकौ विनिर्जित्य विजये संप्रतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075179, "chapter_id": 2589, "verse_number": "१२-९४-२६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075180, "chapter_id": 2589, "verse_number": "१२-९४-२६", "content_sanskrit": "इत्युक्तो वामदेवेन सर्वं तत्कृतवान्नृपः।\nतथा कुर्वंस्त्वमप्येतौ लोकौजेता न संशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075181, "chapter_id": 2589, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुर्नवतितमोऽध्यायः॥ ९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]