[{"id": 2094721, "chapter_id": 3026, "verse_number": "१३-१५६-१", "content_sanskrit": "युधिष्ठिर उवाच।\nश्रुतं मे भरतश्रेष्ठ पुष्पधूपप्रदायिनाम्।\nफलं बलिविधाने च तद्भूयो वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094722, "chapter_id": 3026, "verse_number": "१३-१५६-२", "content_sanskrit": "धूपप्रदानस्य फलं प्रदीपस्य तथैव च।\nबलयश्च किमर्थं वै क्षिप्यन्ते गृहमेधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094723, "chapter_id": 3026, "verse_number": "१३-१५६-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094724, "chapter_id": 3026, "verse_number": "१३-१५६-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनहुषस्य च संवादमगस्त्यस्य भृगोस्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094725, "chapter_id": 3026, "verse_number": "१३-१५६-४", "content_sanskrit": "नहुषो हि महाराज राजर्षिः सुमहातपाः।\nदेवराज्यमनुप्राप्तः सुकृतेनेह कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094726, "chapter_id": 3026, "verse_number": "१३-१५६-५", "content_sanskrit": "तत्रापि प्रयतो राजन्नहुषस्त्रिदिवे वसन्।\nमानुषीश्चैव दिव्याश्च कुर्वाणो विविधाः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094727, "chapter_id": 3026, "verse_number": "१३-१५६-६", "content_sanskrit": "मानुष्यस्तत्र सर्वाः स्म क्रियास्तस्य महात्मनः।\nप्रवृत्तास्त्रिदिवे राजन्दिव्याश्चैव सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094728, "chapter_id": 3026, "verse_number": "१३-१५६-७", "content_sanskrit": "अग्निकार्याणि समिधः कुशाः सुमनसस्तथा।\nबलयश्चान्नलाजाभिर्धूपनं दीपकर्म च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094729, "chapter_id": 3026, "verse_number": "१३-१५६-८", "content_sanskrit": "सर्वं तस्य गृहे राज्ञः प्रावर्तत महात्मनः।\nजपयज्ञान्मनोयज्ञांस्त्रिदिवेऽपि चकार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094730, "chapter_id": 3026, "verse_number": "१३-१५६-९", "content_sanskrit": "देवानभ्यर्चयच्चापि विधिवत्स सुरेश्वरः।\nसर्वानेव यथान्यायं यथापूर्वमरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094731, "chapter_id": 3026, "verse_number": "१३-१५६-१०", "content_sanskrit": "अथेनद्रोऽहमिति ज्ञात्वा अहङ्कारं समाविशत्।\nसर्वाश्चैव क्रियास्तस्य पर्यहीयन्त भूपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094732, "chapter_id": 3026, "verse_number": "१३-१५६-११", "content_sanskrit": "सप्तर्षीन्वाहयामास वरदानदमान्वितः।\nपरिहीनक्रियश्चैव दुर्बलत्वमुपेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094733, "chapter_id": 3026, "verse_number": "१३-१५६-१२", "content_sanskrit": "तस्य वाहयतः कालो मुनिमुख्यांस्तपोधनान्।\nअहङ्काराभिभूतस्य सुमहानत्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094734, "chapter_id": 3026, "verse_number": "१३-१५६-१३", "content_sanskrit": "अथ पर्यायशः सर्वान्वाहनायोपचक्रमे।\nपर्यायश्चाप्यगस्त्यस्य समपद्यत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094735, "chapter_id": 3026, "verse_number": "१३-१५६-१४", "content_sanskrit": "अथागत्य महातेजा भृगुर्ब्रह्मविदांवरः।\nअगस्त्यमाश्रमस्थं वै समुपेत्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094736, "chapter_id": 3026, "verse_number": "१३-१५६-१५", "content_sanskrit": "एवं वयमसत्कारं देवेन्द्रस्यास्य दुर्मतेः।\nनहुषस्य किमर्थं वै मर्षयाम महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094737, "chapter_id": 3026, "verse_number": "१३-१५६-१६x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094738, "chapter_id": 3026, "verse_number": "१३-१५६-१६", "content_sanskrit": "कथमेष मया शक्यः शप्तुं यस्य महामुने।\nवरदेन वरो दत्तो भवतो विदितश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094739, "chapter_id": 3026, "verse_number": "१३-१५६-१७", "content_sanskrit": "यो मे दृष्टिपथं गच्छेत्स मे वश्यो भवेदिति।\nइत्यनेन वरं देवो याचितो गच्छता दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094740, "chapter_id": 3026, "verse_number": "१३-१५६-१८", "content_sanskrit": "एवं न दग्धः स मया भवता च न संशयः।\nअन्येनाप्यृषिमुख्येन न दग्धो न च पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094741, "chapter_id": 3026, "verse_number": "१३-१५६-१९", "content_sanskrit": "अमृतं चैव पानाय दत्तमस्मै पुरा विभो।\nमहात्मना तदर्तं च नास्माभिर्विनिपात्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094742, "chapter_id": 3026, "verse_number": "१३-१५६-२०", "content_sanskrit": "प्रायच्छत वरं देवः प्रजानां दुःखकारणम्।\nद्विजेष्वधर्मयुक्तानि स करोति नराधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094743, "chapter_id": 3026, "verse_number": "१३-१५६-२१", "content_sanskrit": "तत्र यत्प्राप्तकालं नस्तद्ब्रू वदतांवर।\nभवांश्चापि यथा ब्रूयात्तत्कर्तास्मि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094744, "chapter_id": 3026, "verse_number": "१३-१५६-२२x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094745, "chapter_id": 3026, "verse_number": "१३-१५६-२२", "content_sanskrit": "पितामहनियोगेन भवन्तं सोऽहमागतः।\nप्रतिकर्तुं बलवति नहुषे दर्पमोहिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094746, "chapter_id": 3026, "verse_number": "१३-१५६-२३", "content_sanskrit": "अद्य हि त्वां सुदुर्बुद्धी रथे योक्ष्यति देवराट्।\nअद्यैनमहमुद्वृत्तं करिष्येऽनिन्द्रमोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094747, "chapter_id": 3026, "verse_number": "१३-१५६-२४", "content_sanskrit": "अद्येन्द्रं स्थापयिष्यामि पश्यतस्ते शतक्रतुम्।\nसञ्चाल्य पापकर्माणमैन्द्रात्स्थानात्सुदुर्मतिम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094748, "chapter_id": 3026, "verse_number": "१३-१५६-२५", "content_sanskrit": "अद्य चासौ कुदेवेन्द्रस्त्वां पदा धर्षयिष्यति।\nदैवोपहतचित्तत्वादात्मनाशाय मन्दधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094749, "chapter_id": 3026, "verse_number": "१३-१५६-२६", "content_sanskrit": "व्युत्क्रान्तधर्मं तमहं धर्षणामर्षितो भृशम्।\nअहिर्भवस्वेति रुषा शप्स्ये पापं द्विजद्रुहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094750, "chapter_id": 3026, "verse_number": "१३-१५६-२७", "content_sanskrit": "तत एनं सुदुर्बुद्धिं धिक्शब्दाभिहतत्विषम्।\nधरण्यां पातयिष्यामि पश्यतस्ते महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094751, "chapter_id": 3026, "verse_number": "१३-१५६-२८", "content_sanskrit": "नहुषं पापकर्माणमैश्वर्यबलमोहितम्।\nयथा च रोचते तुभ्यं तथा कर्तास्म्यहं मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094752, "chapter_id": 3026, "verse_number": "१३-१५६-२९", "content_sanskrit": "एवमुक्तस्तु भृगुणा मैत्रावरुणिरव्ययः।\nअगस्त्यः परमप्रीतो बभूव विगतज्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094753, "chapter_id": 3026, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्पञ्चाशदधिकशततमोऽध्यायः॥ १५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]