[{"id": 40019828, "chapter_id": 9320, "verse_number": "1", "content_sanskrit": "प्राप्तराज्यस्य रामस्य राक्षसानां वधे कृते । आजग्मुर्ऋषयः सर्वे राघवं प्रतिनन्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019829, "chapter_id": 9320, "verse_number": "2", "content_sanskrit": "कौशिको ऽथ यवक्रीतो गार्ग्यो गालव एव च । कण्वो मेधातिथेः पुत्रः पूर्वस्यां दिशि ये श्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019830, "chapter_id": 9320, "verse_number": "3", "content_sanskrit": "स्वस्त्यात्रेयो ऽथ भगवान्नमुचिः प्रमुचिस्तथा । आजग्मुस्ते सहागस्त्या ये श्रिता दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019831, "chapter_id": 9320, "verse_number": "4", "content_sanskrit": "नृषद्गुः कवषो धौम्यो रौद्रेयश्च महानृषिः । ते ऽप्याजग्मुः सशिष्या वै ये श्रिताः पश्चिमां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019832, "chapter_id": 9320, "verse_number": "5", "content_sanskrit": "वसिष्ठः कश्यपो ऽथात्रिर्विश्वामित्रः सगौतमः । जमदग्निर्भरद्वाजस्ते ऽपि सप्तर्षयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019833, "chapter_id": 9320, "verse_number": "6", "content_sanskrit": "उदीच्यां दिशि सप्तैते नित्यमेव निवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019834, "chapter_id": 9320, "verse_number": "7", "content_sanskrit": "सम्प्राप्य ते महात्मानो राघवस्य निवेशनम् । विष्टिताः प्रतिहारार्थं हुताशनसमप्रभाः । वेदवेदाङ्गविदुषो नानाशास्त्रविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019835, "chapter_id": 9320, "verse_number": "8", "content_sanskrit": "द्वाःस्थं प्रोवाच धर्मात्मा अगस्त्यो मुनिसत्तमः । निवेद्यतां दाशरथेर्ऋषीनस्मान्समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019836, "chapter_id": 9320, "verse_number": "9", "content_sanskrit": "प्रतीहारस्ततस्तूर्णमगस्त्यवचनाद्द्रुतम् । समीपं राघवस्याशु प्रविवेश महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019837, "chapter_id": 9320, "verse_number": "10", "content_sanskrit": "नयेङ्गितज्ञः सद्वृत्तो दक्षो धैर्यसमन्वितः । स रामं दृश्य सहसा पूर्णचन्द्रसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019838, "chapter_id": 9320, "verse_number": "11", "content_sanskrit": "अगस्त्यं कथयामास सम्प्राप्तमृषिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019839, "chapter_id": 9320, "verse_number": "12", "content_sanskrit": "श्रुत्वा प्राप्तान्मुनींस्तांस्तु बालसूर्यसमप्रभान् । प्रत्युवाच ततो द्वास्स्थं प्रवेशय यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019840, "chapter_id": 9320, "verse_number": "13", "content_sanskrit": "तान् सम्प्राप्तान् मुनीन् दृष्ट्वा प्रत्युत्थाय कृताञ्जलिः । पाद्यार्घ्यादिभिरानर्च गां निवेद्य च सादरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019841, "chapter_id": 9320, "verse_number": "14", "content_sanskrit": "रामो ऽभिवाद्य प्रयत आसनान्यादिदेश ह । तेषु काञ्चनचित्रेषु महत्सु च वरेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019842, "chapter_id": 9320, "verse_number": "15", "content_sanskrit": "कुशान्तर्धानदत्तेषु मृगचर्मयुतेषु च । यथार्हमुपविष्टास्ते आसनेष्वृषिपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019843, "chapter_id": 9320, "verse_number": "16", "content_sanskrit": "रामेण कुशलं पृष्टाः सशिष्याः सपुरोगमाः । महर्षयो वेदविदो रामं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019844, "chapter_id": 9320, "verse_number": "17", "content_sanskrit": "कुशलं नो महाबाहो सर्वत्र रघुनन्दन । त्वां तु दिष्ट्या कुशलिनं पश्यामो हतशात्रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019845, "chapter_id": 9320, "verse_number": "18", "content_sanskrit": "दिष्ट्या त्वया हतो राजन्रावणो लोकरावणः । न हि भारः स ते राम रावणः पुत्रपौत्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019846, "chapter_id": 9320, "verse_number": "19", "content_sanskrit": "सधनुस्त्वं हि लोकांस्त्रीन्विजयेथा न संशयः । दिष्ट्या त्वया हतो राम रावणो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019847, "chapter_id": 9320, "verse_number": "20", "content_sanskrit": "दिष्ट्या विजयिनं त्वाद्य पश्यामः सह सीतया । लक्ष्मणेन च धर्मात्मन्भ्रात्रा त्वद्धितकारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019848, "chapter_id": 9320, "verse_number": "21", "content_sanskrit": "मातृभिर्भ्रातृसहितं पश्यामो ऽद्य वयं नृप । दिष्ट्या प्रहस्तो विकटो विरूपाक्षो महोदरः । अकम्पनश्च दुर्धर्षो निहतास्ते निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019849, "chapter_id": 9320, "verse_number": "22", "content_sanskrit": "यस्य प्रमाणाद्विपुलं प्रमाणं नेह विद्यते । दिष्ट्या ते समरे राम कुम्भकर्णो निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019850, "chapter_id": 9320, "verse_number": "23", "content_sanskrit": "त्रिशिराश्चातिकायश्च देवान्तकनरान्तकौ । दिष्ट्या ते निहता राम महावीर्या निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019851, "chapter_id": 9320, "verse_number": "24", "content_sanskrit": "कुम्भश्चैव निकुम्भश्च राक्षसौ भीमदर्शनौ । दिष्ट्या तौ निहतौ राम कुम्भकर्णसुतौ मृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019852, "chapter_id": 9320, "verse_number": "25", "content_sanskrit": "युद्धोन्मत्तश्च मत्तश्च कालान्तकयमोपमौ । यज्ञकोपश्च बलवान्धूम्राक्षो नाम राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019853, "chapter_id": 9320, "verse_number": "26", "content_sanskrit": "कुर्वन्तः कदनं घोरमेते शस्त्रास्त्रपारगाः । अन्तकप्रतिमैर्बाणैर्दिष्ट्या विनिहतास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019854, "chapter_id": 9320, "verse_number": "27", "content_sanskrit": "दिष्ट्या त्वं राक्षसेन्द्रेण द्वन्द्वयुद्धमुपागतः । देवतानामवध्येन विजयं प्राप्तवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019855, "chapter_id": 9320, "verse_number": "28", "content_sanskrit": "सङ्ख्ये तस्य न किञ्चित्तु रावणस्य पराभवः । द्वन्द्वयुद्धमनुप्राप्तो दिष्ट्या ते रावणिर्हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40019856, "chapter_id": 9320, "verse_number": "29", "content_sanskrit": "दिष्ट्या तस्य महाबाहो कालस्येवाभिधावतः । मुक्तः सुररिपोर्वीर प्राप्तश्च विजयस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40019857, "chapter_id": 9320, "verse_number": "30", "content_sanskrit": "अभिनन्दाम ते सर्वे संश्रुत्येन्द्रजितो वधम् । सो ऽवध्यः सर्वभूतानां महामायाधरो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40019858, "chapter_id": 9320, "verse_number": "31", "content_sanskrit": "विस्मयस्त्वेष चास्माकं तच्छ्रुत्वेन्द्रजितं हतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40019859, "chapter_id": 9320, "verse_number": "32", "content_sanskrit": "एते चान्ये च बहवो राक्षसाः कामरूपिणः । दिष्ट्या त्वया हता वीरा रघूणां कुलवर्द्धन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40019860, "chapter_id": 9320, "verse_number": "33", "content_sanskrit": "दत्त्वा पुण्यामिमां वीर सौम्यामभयदक्षिणाम् ।। दिष्ट्या वर्धसि काकुत्स्थ जयेनामित्रकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40019861, "chapter_id": 9320, "verse_number": "34", "content_sanskrit": "श्रुत्वा तु तेषां वचनमृषीणां भावितात्मनाम् । विस्मयं परमं गत्वा रामः प्राञ्जलिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40019862, "chapter_id": 9320, "verse_number": "35", "content_sanskrit": "भगवन्तः कुम्भकर्णं रावणं च निशाचरम् । अतिक्रम्य महावीर्यौ किं प्रशंसथ रावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40019863, "chapter_id": 9320, "verse_number": "36", "content_sanskrit": "महोदरं प्रहस्तं च विरूपाक्षं च राक्षसम् । मत्तोन्मत्तौ च दुर्धर्षौ देवान्तकनरान्तकौ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40019864, "chapter_id": 9320, "verse_number": "37", "content_sanskrit": "अतिक्रम्य महावीर्यान् किं प्रशंसथ रावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40019865, "chapter_id": 9320, "verse_number": "38", "content_sanskrit": "अतिकायं त्रिशिरसं धूम्राक्षं च निशाचरम् । अतिक्रम्य महावीर्यान्किं प्रशंसथ रावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40019866, "chapter_id": 9320, "verse_number": "39", "content_sanskrit": "कीदृशो वै प्रभावो ऽस्य किं बलं कः पराक्रमः । केन वा कारणेनैष रावणादतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40019867, "chapter_id": 9320, "verse_number": "40", "content_sanskrit": "शक्यं यदि मया श्रोतुं न खल्वाज्ञापयामि वः । यदि गुह्यं न चेद्वक्तुं श्रोतुमिच्छामि कथ्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40019868, "chapter_id": 9320, "verse_number": "41", "content_sanskrit": "शक्रो ऽपि विजितस्तेन कथं लब्धवरश्च सः । कथं च बलवानन्पुत्रो न पिता तस्य रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40019869, "chapter_id": 9320, "verse_number": "42", "content_sanskrit": "कथं पितुश्चाभ्यधिको महाहवे शक्रस्य जेता हि कथं स राक्षसः । वराश्च लब्धाः कथयस्व मे ऽद्य तत्पृच्छतश्चास्य मुनीन्द्र सर्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]