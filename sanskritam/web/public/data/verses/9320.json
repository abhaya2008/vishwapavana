[{"id": 5000320000, "chapter_id": 9320, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे अष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000320001, "chapter_id": 9320, "verse_number": "४-४८-१", "content_sanskrit": "सह ताराङ्गदाभ्यां तु सहसा हनुमान् कपिः।\nसुग्रीवेण यथोद्दिष्टं गन्तुं देशं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000320002, "chapter_id": 9320, "verse_number": "४-४८-२", "content_sanskrit": "स तु दूरमुपागम्य सर्वैस्तैः कपिसत्तमैः।\nततो विचित्य विन्ध्यस्य गुहाश्च गहनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000320003, "chapter_id": 9320, "verse_number": "४-४८-३", "content_sanskrit": "पर्वताग्रनदीदुर्गान् सरांसि विपुलद्रुमान्।\nवृक्षषण्डांश्च विविधान् पर्वतान् वनपादपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000320004, "chapter_id": 9320, "verse_number": "४-४८-४", "content_sanskrit": "अन्वेषमाणास्ते सर्वे वानराः सर्वतो दिशम्।\nन सीतां ददृशुर्वीरा मैथिलीं जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000320005, "chapter_id": 9320, "verse_number": "४-४८-५", "content_sanskrit": "ते भक्षयन्तो मूलानि फलानि विविधान्यपि।\nअन्वेषमाणा दुर्धर्षा न्यवसंस्तत्र तत्र ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000320006, "chapter_id": 9320, "verse_number": "४-४८-६", "content_sanskrit": "स तु देशो दुरन्वेषो गुहागहनवान् महान्।\nनिर्जलं निर्जनं शून्यं गहनं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000320007, "chapter_id": 9320, "verse_number": "४-४८-७", "content_sanskrit": "तादृशान्यप्यरण्यानि विचित्य भृशपीडिताः।\nस देशश्च दुरन्वेष्यो गुहागहनवान् महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000320008, "chapter_id": 9320, "verse_number": "४-४८-८", "content_sanskrit": "त्यक्त्वा तु तं ततो देशं सर्वे वै हरियूथपाः।\nदेशमन्यं दुराधर्षं विविशुश्चाकुतोभयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000320009, "chapter_id": 9320, "verse_number": "४-४८-९", "content_sanskrit": "यत्र वन्ध्यफला वृक्षा विपुष्पाः पर्णवर्जिताः।\nनिस्तोयाः सरितो यत्र मूलं यत्र सुदुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000320010, "chapter_id": 9320, "verse_number": "४-४८-१०", "content_sanskrit": "न सन्ति महिषा यत्र न मृगा न च हस्तिनः।\nशार्दूलाः पक्षिणो वापि ये चान्ये वनगोचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000320011, "chapter_id": 9320, "verse_number": "४-४८-११", "content_sanskrit": "न चात्र वृक्षा नौषध्यो न वल्ल्यो नापि वीरुधः।\nस्निग्धपत्राः स्थले यत्र पद्मिन्यः फुल्लपङ्कजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000320012, "chapter_id": 9320, "verse_number": "४-४८-१२", "content_sanskrit": "प्रेक्षणीयाः सुगन्धाश्च भ्रमरैश्च विवर्जिताः।\nकण्डुर्नाम महाभागः सत्यवादी तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000320013, "chapter_id": 9320, "verse_number": "४-४८-१३", "content_sanskrit": "महर्षिः परमामर्षी नियमैर्दुष्प्रधर्षणः।\nतस्य तस्मिन् वने पुत्रो बालको दशवार्षिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000320014, "chapter_id": 9320, "verse_number": "४-४८-१४", "content_sanskrit": "प्रणष्टो जीवितान्ताय क्रुद्धस्तेन महामुनिः।\nतेन धर्मात्मना शप्तं कृत्स्नं तत्र महद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000320015, "chapter_id": 9320, "verse_number": "४-४८-१५", "content_sanskrit": "अशरण्यं दुराधर्षं मृगपक्षिविवर्जितम्।\nतस्य ते काननान्तांस्तु गिरीणां कन्दराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000320016, "chapter_id": 9320, "verse_number": "४-४८-१६", "content_sanskrit": "प्रभवाणि नदीनां च विचिन्वन्ति समाहिताः।\nतत्र चापि महात्मानो नापश्यञ्जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000320017, "chapter_id": 9320, "verse_number": "४-४८-१७", "content_sanskrit": "हर्तारं रावणं वापि सुग्रीवप्रियकारिणः।\nते प्रविश्य तु तं भीमं लतागुल्मसमावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000320018, "chapter_id": 9320, "verse_number": "४-४८-१८", "content_sanskrit": "ददृशुर्भीमकर्माणमसुरं सुरनिर्भयम्।\nतं दृष्ट्वा वानरा घोरं स्थितं शैलमिवासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000320019, "chapter_id": 9320, "verse_number": "४-४८-१९", "content_sanskrit": "गाढं परिहिताः सर्वे दृष्ट्वा तं पर्वतोपमम्।\nसोऽपि तान् वानरान् सर्वान् नष्टाः स्थेत्यब्रवीद् बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000320020, "chapter_id": 9320, "verse_number": "४-४८-२०", "content_sanskrit": "अभ्यधावत संक्रुद्धो मुष्टिमुद्यम्य संगतम्।\nतमापतन्तं सहसा वालिपुत्रोऽङ्गदस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000320021, "chapter_id": 9320, "verse_number": "४-४८-२१", "content_sanskrit": "रावणोऽयमिति ज्ञात्वा तलेनाभिजघान ह।\nस वालिपुत्राभिहतो वक्त्राच्छोणितमुद्वमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000320022, "chapter_id": 9320, "verse_number": "४-४८-२२", "content_sanskrit": "असुरो न्यपतद् भूमौ पर्यस्त इव पर्वतः।\nते तु तस्मिन् निरुच्छ्वासे वानरा जितकाशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000320023, "chapter_id": 9320, "verse_number": "४-४८-२३", "content_sanskrit": "व्यचिन्वन् प्रायशस्तत्र सर्वं ते गिरिगह्वरम्।\nविचितं तु ततः सर्वं सर्वे ते काननौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000320024, "chapter_id": 9320, "verse_number": "४-४८-२४", "content_sanskrit": "अन्यदेवापरं घोरं विविशुर्गिरिगह्वरम्।\nते विचित्य पुनः खिन्ना विनिष्पत्य समागताः।\nएकान्ते वृक्षमूले तु निषेदुर्दीनमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000320025, "chapter_id": 9320, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे अष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]