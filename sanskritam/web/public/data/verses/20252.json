[{"id": 7000252000, "chapter_id": 20252, "verse_number": "१-६-१", "content_sanskrit": "भीष्म उवाच ।\nदेवानां दानवानां च गंधर्वोरगरक्षसाम् ।\nउत्पत्तिं विस्तरेणेमां गुरो ब्रूहि यथाविधि॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000252001, "chapter_id": 20252, "verse_number": "१-६-२", "content_sanskrit": "पुलस्त्य उवाच ।\nसंकल्पाद्दर्शनात्स्पर्शात्पूर्वेषां सृष्टिरुच्यते ।\nदक्षात्प्राचेतसादूर्ध्वं सृष्टिर्मैथुनसंभवा॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000252002, "chapter_id": 20252, "verse_number": "१-६-३", "content_sanskrit": "यथा ससर्ज चैवासौ तथैव शृणु कौरव ।\nयदा तु सृजतस्तस्य देवर्षिगणपन्नगान्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000252003, "chapter_id": 20252, "verse_number": "१-६-४", "content_sanskrit": "न वृद्धिमगमल्लोकस्तदा मैथुनयोगतः ।\nदक्षः पुत्रसहस्राणि तदासिक्न्यामजीजनत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000252004, "chapter_id": 20252, "verse_number": "१-६-५", "content_sanskrit": "तांस्तु दृष्ट्वा महाभागान्सिसृक्षून्विविधाः प्रजाः ।\nनारदः प्राह हर्यश्वान्दक्षपुत्रान्समागतान्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000252005, "chapter_id": 20252, "verse_number": "१-६-६", "content_sanskrit": "भुवः प्रमाणं सर्वं तु ज्ञात्वोर्द्धमध एव वा ।\nततः सृष्टिं विशेषेण कुरुध्वमृषिसत्तमाः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000252006, "chapter_id": 20252, "verse_number": "१-६-७", "content_sanskrit": "ते तु तद्वचनं श्रुत्वा प्रयाताः सर्वतोदिशम् ।\nअद्यापि न निवर्त्तंते समुद्रादिव सिंधवः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000252007, "chapter_id": 20252, "verse_number": "१-६-८", "content_sanskrit": "हर्यश्वेषु प्रणष्टेषु पुनर्दक्षः प्रजापतिः ।\nवीरिण्यामेव पुत्राणां सहस्रमसृजत्प्रभुः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000252008, "chapter_id": 20252, "verse_number": "१-६-९", "content_sanskrit": "शबलाश्वा नाम ते च समेताः सृष्टिकर्मणि ।\nनारदोनुगतान्प्राह पुनस्तान्पूर्ववन्मुनिः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000252009, "chapter_id": 20252, "verse_number": "१-६-१०", "content_sanskrit": "भुवः प्रमाणं सर्वं तु ज्ञात्वा भ्रातॄनथो पुनः ।\nआगत्य च पुनः सृष्टिं करिष्यथ विशेषतः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000252010, "chapter_id": 20252, "verse_number": "१-६-११", "content_sanskrit": "तेपि तेनैव मार्गेण जग्मुर्भ्रात्रनुगास्तदा ।\nततः प्रभृति न भ्रातुः कनीयान्मार्गमिच्छति॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000252011, "chapter_id": 20252, "verse_number": "१-६-१२", "content_sanskrit": "अन्वेष्टा दुःखमाप्नोति तेन तत्परिवर्जयेत् ।\nततस्तेष्वपि नष्टेषु षष्टिं कन्याः प्रजापतिः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000252012, "chapter_id": 20252, "verse_number": "१-६-१३", "content_sanskrit": "वीरिण्यां जनयामास दक्षः प्राचेतसस्तदा ।\nप्रादात्स दश धर्माय कश्यपाय त्रयोदश॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000252013, "chapter_id": 20252, "verse_number": "१-६-१४", "content_sanskrit": "विंशतिसप्त सोमाय चतस्रोरिष्टनेमिने ।\nद्वे चैव भृगुपुत्राय द्वे कृशाश्वाय धीमते॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000252014, "chapter_id": 20252, "verse_number": "१-६-१५", "content_sanskrit": "द्वे चैवांगिरसे प्रादात्तासां नामानि विस्तरात् ।\nशृणु त्वं देवमातॄणां प्रजाविस्तारमादितः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000252015, "chapter_id": 20252, "verse_number": "१-६-१६", "content_sanskrit": "अरुंधती वसुर्जामिर्लम्बा भानुर्मरुत्वती ।\nसंकल्पा च मुहूर्ता च साध्या विश्वा च भामिनी॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000252016, "chapter_id": 20252, "verse_number": "१-६-१७", "content_sanskrit": "धर्मपत्न्यः समाख्यातास्तासां पुत्रान्निबोध मे ।\nविश्वेदेवास्तु विश्वायाः साध्या साध्यानजीजनत्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000252017, "chapter_id": 20252, "verse_number": "१-६-१८", "content_sanskrit": "मरुत्वत्यां मरुत्वंतो वसोस्तु वसवस्तथा ।\nभानोस्तु भानवो जाता मूहूर्त्ताया मुहूर्तजाः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000252018, "chapter_id": 20252, "verse_number": "१-६-१९", "content_sanskrit": "लंबायां घोषनामानो नागवीथी तु जामिजा ।\nपृथिवीतलसंभूतमरुंधत्यामजायत॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000252019, "chapter_id": 20252, "verse_number": "१-६-२०", "content_sanskrit": "संकल्पायास्तु संकल्पा वसु सृष्टिं निधारय ।\nज्योतिष्मतंश्च ये देवा व्यापकाः सर्वतोदिशम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000252020, "chapter_id": 20252, "verse_number": "१-६-२१", "content_sanskrit": "वसवस्ते समाख्यातास्तेषां नामानि मे शृणु ।\nआपो ध्रुवश्च सोमश्च धरश्चैवानिलोनलः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000252021, "chapter_id": 20252, "verse_number": "१-६-२२", "content_sanskrit": "प्रत्यूषश्च प्रभासश्च वसवोष्टौ प्रकीर्तिताः ।\nआपस्य पुत्राश्चत्वारः श्रांतो वैतण्ड एव च॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000252022, "chapter_id": 20252, "verse_number": "१-६-२३", "content_sanskrit": "अपि शांतो मुनिर्वभ्रुर्यज्ञरक्षाधिकारिणः ।\nध्रुवस्य कालः पुत्रस्तु वर्चाः सोमादजायत॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000252023, "chapter_id": 20252, "verse_number": "१-६-२४", "content_sanskrit": "द्रविणो हव्यवाहश्च धर पुत्राविमौ स्मृतौ ।\nकल्पांतस्थस्ततः प्राणो रमणः शिशिरोपि च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000252024, "chapter_id": 20252, "verse_number": "१-६-२५", "content_sanskrit": "मनोहरो धवश्चाथ शिवो वाथ हरेः सुताः ।\nशिवो मनोजवं पुत्रमविज्ञातगतिप्रदम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000252025, "chapter_id": 20252, "verse_number": "१-६-२६", "content_sanskrit": "अवाप चानलः पुत्रानग्निप्रायगुणांस्ततः ।\nतत्र शाखो विशाखश्च निगमेषु स्वयंभुवः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000252026, "chapter_id": 20252, "verse_number": "१-६-२७", "content_sanskrit": "अपत्यं कृत्तिकानां च कार्तिकेयस्ततः स्मृतः ।\nप्रत्यूषस्य ऋभुः पुत्रो मुनिर्नामाथ देवलः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000252027, "chapter_id": 20252, "verse_number": "१-६-२८", "content_sanskrit": "विश्वकर्मा प्रभासस्य पुत्रः शिल्पी प्रजापतिः ।\nप्रासादभवनोद्यान प्रतिमा भूषणादिषु॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000252028, "chapter_id": 20252, "verse_number": "१-६-२९", "content_sanskrit": "तटाकारामकूपेषु त्रिदशानां च वर्द्धकिः ।\nअजैकपादहिर्बुध्न्यो विरूपाक्षोथ रैवतः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000252029, "chapter_id": 20252, "verse_number": "१-६-३०", "content_sanskrit": "हरश्च बहुरूपश्च त्र्यंबकश्च सुरेश्वरः ।\nसावित्त्रश्च जयंतश्च पिनाकी चापराजितः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000252030, "chapter_id": 20252, "verse_number": "१-६-३१", "content_sanskrit": "एते रुद्रास्समाख्याता एकादश गणेश्वराः ।\nएतेषां मानसानां तु त्रिशूलवरधारिणाम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000252031, "chapter_id": 20252, "verse_number": "१-६-३२", "content_sanskrit": "कोट्यश्चतुरशीतिस्तु तत्पुत्राश्चाक्षया मताः ।\nदिक्षु सर्वासु ये रक्षां प्रकुर्वन्ति गणेश्वराः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000252032, "chapter_id": 20252, "verse_number": "१-६-३३", "content_sanskrit": "एते वै पुत्रपौत्राश्च सुरभीगर्भसंभवाः ।\nकश्यपस्य प्रवक्ष्यामि पुत्रपौत्रादि पत्निषु॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000252033, "chapter_id": 20252, "verse_number": "१-६-३४", "content_sanskrit": "अदितिर्दितिर्दनुश्चैव अरिष्टा सुरसा तथा ।\nसुरभिर्विनता चैव ताम्रा क्रोधवशा इरा॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000252034, "chapter_id": 20252, "verse_number": "१-६-३५", "content_sanskrit": "कद्रू खसा मुनिस्तद्वत्तासु पुत्रान्निबोध मे ।\nतुषिता नाम ये देवाश्चाक्षुषस्यांतरे मनोः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000252035, "chapter_id": 20252, "verse_number": "१-६-३६", "content_sanskrit": "वैवस्वतेंतरे चैव आदित्या द्वादश स्मृताः ।\nइन्द्रो धाता भगस्त्वष्टा मित्त्रोऽथ वरुणोऽर्यमा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000252036, "chapter_id": 20252, "verse_number": "१-६-३७", "content_sanskrit": "विवस्वान्सविता पूषा अंशुमान्विष्णुरेव च ।\nएते सहस्रकिरणा आदित्या दाद्वश स्मृताः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000252037, "chapter_id": 20252, "verse_number": "१-६-३८", "content_sanskrit": "मारीचात्कश्यपाज्जाताः पुत्त्रास्तेऽदितिनंदनाः ।\nकृशाश्वस्य ऋषेः पुत्रा देवप्रहरणाः स्मृताः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000252038, "chapter_id": 20252, "verse_number": "१-६-३९", "content_sanskrit": "एते देवगणास्तात प्रतिमन्वंतरेषु च ।\nउत्पद्यंते विलीयंते कल्पेकल्पे तथैव च॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000252039, "chapter_id": 20252, "verse_number": "१-६-४०", "content_sanskrit": "दितिः पुत्रद्वयं लेभे कश्यपादिति नः श्रुतम् ।\nहिरण्यकशिपुं चैव हिरण्याक्षं तथैव च॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000252040, "chapter_id": 20252, "verse_number": "१-६-४१", "content_sanskrit": "हिरण्यकशिपोस्तद्वज्जातं पुत्रचतुष्टयम् ।\nप्रह्लादश्चानुह्लादश्च संह्लादोह्लाद एव च॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000252041, "chapter_id": 20252, "verse_number": "१-६-४२", "content_sanskrit": "प्रह्लादपुत्रा आयुष्मान्शिबिर्बाष्कलिरेव च ।\nविरोचनश्चतुर्थस्तु स बलिं पुत्रमाप्तवान्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000252042, "chapter_id": 20252, "verse_number": "१-६-४३", "content_sanskrit": "बलेः पुत्रशतं त्वासीद्बाणज्येष्ठं ततो नृप ।\nधृतराष्ट्रस्तथासूर्य्यो विवस्वानंशुतापनः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000252043, "chapter_id": 20252, "verse_number": "१-६-४४", "content_sanskrit": "निकुम्भनामा गुर्वक्षः कुक्षिर्भौमोथ भीषणः ।\nएवमन्ये तु बहवो बाणोज्येष्ठो गुणाधिकः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000252044, "chapter_id": 20252, "verse_number": "१-६-४५", "content_sanskrit": "बाणस्सहस्रबाहुस्तु सर्वास्त्रगुणसंयुतः ।\nतपसा तोषितो यस्य पुरे वसति शूलधृत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000252045, "chapter_id": 20252, "verse_number": "१-६-४६", "content_sanskrit": "महाकालत्वमगमत्सार्थ्यं यस्य पिनाकिनः ।\nहिरण्याक्षस्य पुत्रोभूदंधको नामनामतः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000252046, "chapter_id": 20252, "verse_number": "१-६-४७", "content_sanskrit": "भूतसंतापनश्चैव महानागस्तथैव च ।\nएतेभ्यः पुत्रपौत्राणां कोटयः सप्तसप्ततिः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000252047, "chapter_id": 20252, "verse_number": "१-६-४८", "content_sanskrit": "महाबला महाकाया नानारूपा महौजसः ।\nदनुः पुत्रशतं लेभे कश्यपाद्वरदर्पितम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000252048, "chapter_id": 20252, "verse_number": "१-६-४९", "content_sanskrit": "विप्रचित्तिः प्रधानोभूदेषां मध्ये महाबलः ।\nद्विरष्टमूर्द्धा शकुनिस्तथा शंकुशिरोधरः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000252049, "chapter_id": 20252, "verse_number": "१-६-५०", "content_sanskrit": "अयोमुखः शंबरश्च कपिलो वामनस्तथा ।\nमरीचिर्मागधश्चैव हरिर्गजशिरास्तथा॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000252050, "chapter_id": 20252, "verse_number": "१-६-५१", "content_sanskrit": "निद्राधरश्च केतुश्च केतुवीर्यः शतक्रतुः ।\nइन्द्रमित्रग्रहश्चैव वज्रनाभस्तथैव च॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000252051, "chapter_id": 20252, "verse_number": "१-६-५२", "content_sanskrit": "एकवस्त्रो महाबाहुर्वज्राक्षस्तारकस्तथा ।\nअसिलोमा पुलोमा च विकुर्वाणो महासुरः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000252052, "chapter_id": 20252, "verse_number": "१-६-५३", "content_sanskrit": "स्वर्भानुर्वृषपर्वा च एवमाद्या दनोस्सुताः ।\nस्वर्भानोः सुप्रभा कन्या शची चैव पुलोमजा॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000252053, "chapter_id": 20252, "verse_number": "१-६-५४", "content_sanskrit": "उपदानवी मयस्यासीत्तथा मंदोदरी कुहूः ।\nशर्मिष्ठा सुंदरी चैव चंडा च वृषपर्वणः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000252054, "chapter_id": 20252, "verse_number": "१-६-५५", "content_sanskrit": "पुलोमा कालका चैव वैश्वनरसुते उभे ।\nबह्वपत्यो महासत्वो मारीचस्य परिग्रहः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000252055, "chapter_id": 20252, "verse_number": "१-६-५६", "content_sanskrit": "तयोः षष्टिसहस्राणि दानवानां पुराभवन् ।\nपौलोमान्कालखंजांश्च मारीचोजनयत्पुरा॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000252056, "chapter_id": 20252, "verse_number": "१-६-५७", "content_sanskrit": "अवध्या ये नराणां वै हिरण्यपुरवासिनः ।\nचतुर्मुखाल्लब्धवरा ये हता विजयेन तु॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000252057, "chapter_id": 20252, "verse_number": "१-६-५८", "content_sanskrit": "विप्रचित्तिः सिंहिकायां नव पुत्रानजीजनत् ।\nहिरण्यकशिपोर्येवै भागिनेयास्त्रयोदश॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000252058, "chapter_id": 20252, "verse_number": "१-६-५९", "content_sanskrit": "कंसः शंखश्च राजेन्द्र नलो वातापिरेव च ।\nइल्वलो नमुचिश्चैव खसृमश्चांजनस्तथा॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000252059, "chapter_id": 20252, "verse_number": "१-६-६०", "content_sanskrit": "नरकः कालनाभश्च परमाणुस्तथैव च ।\nकल्पवीर्यश्च विख्यातो दनुवंशविवर्द्धनः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000252060, "chapter_id": 20252, "verse_number": "१-६-६१", "content_sanskrit": "संह्लादस्य तु दैत्यस्य निवातकवचाः कुले ।\nअवध्याः सर्वदेवानां गंधर्वोरगराक्षसाम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000252061, "chapter_id": 20252, "verse_number": "१-६-६२", "content_sanskrit": "ये हता बलमाश्रित्य अर्जुनेन रणाजिरे ।\nषट्कन्या जनयामास ताम्रा मारीचवीर्यतः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000252062, "chapter_id": 20252, "verse_number": "१-६-६३", "content_sanskrit": "शुकीं श्येनीं च भासीं च सुगृध्रीं गृध्रिकां शुचिम् ।\nशुकी शुकानुलूकांश्च जनयामास धर्मतः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000252063, "chapter_id": 20252, "verse_number": "१-६-६४", "content_sanskrit": "श्येनी श्येनांश्च भासी च कुररानप्यजीजनत् ।\nगृध्री गृध्रान्सुगृध्री च पारावतविहंगमान्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000252064, "chapter_id": 20252, "verse_number": "१-६-६५", "content_sanskrit": "हंस सारस कारंड प्लवान्शुचिरजीजनत् ।\nएते ताम्रासुताः प्रोक्ता विनताया निशामय॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000252065, "chapter_id": 20252, "verse_number": "१-६-६६", "content_sanskrit": "गरुडः पतगश्रेष्ठोऽरुणश्चेशः पतत्रिणाम् ।\nसौदामिनी तथा कन्या येयं नभसि विश्रुता॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000252066, "chapter_id": 20252, "verse_number": "१-६-६७", "content_sanskrit": "संपातिश्च जटायुश्च अरुणस्य सुतावुभौ ।\nसंपातिपुत्रो बभ्रुश्च शीघ्रगश्चातिविश्रुतः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000252067, "chapter_id": 20252, "verse_number": "१-६-६८", "content_sanskrit": "जटायोः कर्णिकारश्च शतगामी च विश्रुतौ ।\nतेषामसंख्यमभवत्पक्षिणां पुत्रपौत्रकम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000252068, "chapter_id": 20252, "verse_number": "१-६-६९", "content_sanskrit": "सुरसायां सहस्रं तु सर्पाणामभवत्पुरा ।\nसहस्रशिरसां कद्रूः सहस्रं प्राप सुव्रता॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000252069, "chapter_id": 20252, "verse_number": "१-६-७०", "content_sanskrit": "प्रधानास्तेषु विख्याता ष्षड्विंशतिररिन्दम ।\nशेषवासुकिकर्कोट शंखैरावतकंबलाः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000252070, "chapter_id": 20252, "verse_number": "१-६-७१", "content_sanskrit": "धनंजय महानील पद्माश्वतर तक्षकाः ।\nएलापत्र महापद्म धृतराष्ट्र बलाहकाः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000252071, "chapter_id": 20252, "verse_number": "१-६-७२", "content_sanskrit": "शंखपाल महाशंख पुष्पदंष्ट्रं शुभाननाः ।\nशंखरोमा च नहुषो रमणः पणिनस्तथा॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000252072, "chapter_id": 20252, "verse_number": "१-६-७३", "content_sanskrit": "कपिलो दुर्मुखश्चापि पतंजलिमुखास्तथा ।\nएषामनंतमभवत्सर्वेषां पुत्रपौत्रकम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000252073, "chapter_id": 20252, "verse_number": "१-६-७४", "content_sanskrit": "प्रायशो यत्पुरादग्धं जनमेजयमंदिरे ।\nरक्षोगणं क्रोधवशा सुनामानमजीजनत्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000252074, "chapter_id": 20252, "verse_number": "१-६-७५", "content_sanskrit": "दंष्ट्रिणां नियुतं तेषां भीमसेनादगात्क्षयम् ।\nदंष्ट्रि गोमायु काकादीन्महिषीर्गोवराङ्गनाः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000252075, "chapter_id": 20252, "verse_number": "१-६-७६", "content_sanskrit": "सुरभिर्जनयामास कश्यपात्त्त्रितयं पुरा ।\nमुनिर्मुनीनां च गणं गणमप्सरसां तथा॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000252076, "chapter_id": 20252, "verse_number": "१-६-७७", "content_sanskrit": "तथा किन्नरगंधर्वानरिष्टा जनयद्बहून् ।\nतृणवृक्षलता गुल्ममिरा सर्वमजीजनतत्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000252077, "chapter_id": 20252, "verse_number": "१-६-७८", "content_sanskrit": "खसा तु यक्षरक्षांसि जनयामास कोटिशः ।\nएते कश्यपदायादाः शतशोथ सहस्रशः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000252078, "chapter_id": 20252, "verse_number": "१-६-७९", "content_sanskrit": "एष मन्वंतरे भीष्म सर्गः स्वारोचिषे स्मृतः ।\nततस्त्वेकोनपंचाशन्मरुतः कश्यपाद्दितिः ।\nजनयामास धर्मज्ञ सर्वानमरवल्लभान्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]