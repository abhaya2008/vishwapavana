[{"id": 2150344, "chapter_id": 4261, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150345, "chapter_id": 4261, "verse_number": "१", "content_sanskrit": "एवमुक्तस्य दूतेन द्रुपदस्य तदा नृप ।\nचोरस्येव गृहीतस्य न प्रावर्तत भारती\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150346, "chapter_id": 4261, "verse_number": "२", "content_sanskrit": "स यत्नमकरोत् तीव्रं सम्बन्धिन्यनुशासने ।\nदूतैर्मधुरसम्भाषैर्न तदस्तीति सन्दिशन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150347, "chapter_id": 4261, "verse_number": "३", "content_sanskrit": "स राजा भूय एवाथ ज्ञात्वा तत्त्वमथागमत् ।\nकन्येति पाञ्चालसुतां त्वरमाणो विनिर्ययौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150348, "chapter_id": 4261, "verse_number": "४", "content_sanskrit": "ततः सम्प्रेषयामास मित्राणाममितौजसाम् ।\nदुहितुर्विप्रलम्भं तं धात्रीणां वचनात् तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150349, "chapter_id": 4261, "verse_number": "५", "content_sanskrit": "ततः समुदयं कृत्वा बलानां राजसत्तमः ।\nअभियाने मतिं चक्रे द्रुपदं प्रति भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150350, "chapter_id": 4261, "verse_number": "६", "content_sanskrit": "ततः सम्मन्त्रयामास मन्त्रिभिः स महीपतिः ।\nहिरण्यवर्मा राजेन्द्र पाञ्चाल्यं पार्थिवं प्रति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150351, "chapter_id": 4261, "verse_number": "७", "content_sanskrit": "तत्र वै निश्चितं तेषामभूद् राज्ञां महात्मनाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150352, "chapter_id": 4261, "verse_number": "८", "content_sanskrit": "तथ्यं भवति चेदेतत् कन्या राजन् शिखण्डिनी ।\nबद्ध्वा पाञ्चालराजानमानयिष्यामहे गृहम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150353, "chapter_id": 4261, "verse_number": "९", "content_sanskrit": "अन्यं राजानमाधाय पाञ्चालेषु नरेश्वरम् ।\nअद्यैव पातयिष्यामो द्रुपदं सशिखण्डिनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150354, "chapter_id": 4261, "verse_number": "१०", "content_sanskrit": "स तथा द्रुतमाज्ञाय पुनः क्षत्तारमीश्वरः ।\nप्रास्थापयत् पार्षताय निहन्मीति स्थिरो भव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150355, "chapter_id": 4261, "verse_number": "११", "content_sanskrit": "स हि प्रकृत्या भीतश्च किल्बिषी च नराधिपः ।\nभयं तीव्रमनुप्राप्तो द्रुपदः पृथिवीपतिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150356, "chapter_id": 4261, "verse_number": "१२", "content_sanskrit": "विसृज्य दूतान् दाशार्णे द्रुपदः शोकमूर्च्छितः ।\nसमेत्य भार्यां रहिते वाक्यमाह नराधिपः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150357, "chapter_id": 4261, "verse_number": "१३", "content_sanskrit": "भयेन महताऽऽविष्टो हृदि शोकेन कर्शितः ।\nपाञ्चालराजो दयितां मातरं वै शिखण्डिनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150358, "chapter_id": 4261, "verse_number": "१४", "content_sanskrit": "अभियास्यति मां कोपात् सम्बन्धी सुमहाबलः ।\nहिरण्यवर्मा नृपतिः कर्षमाणो वरूथिनीम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150359, "chapter_id": 4261, "verse_number": "१५", "content_sanskrit": "किमिदानीं करिष्यावो मूढौ कन्यामिमां प्रति ।\nशिखण्डी किल पुत्रस्ते कन्येति परिशङ्कितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150360, "chapter_id": 4261, "verse_number": "समाप्तिः", "content_sanskrit": "इति निश्चित्य तत्वेन समित्रः सबलानुगः ।\nवञ्चितोऽस्मीति मन्वानो मां किलोद्धर्तुमिच्छति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150361, "chapter_id": 4261, "verse_number": "१७", "content_sanskrit": "किमत्र तथ्यं सुश्रोणि किं मिथ्या ब्रूहि शोभने ।\nश्रुत्वा त्वत्तः श्रुतं वाक्यं संविधास्याम्यहं तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150362, "chapter_id": 4261, "verse_number": "१८", "content_sanskrit": "अहं हि संशयं प्राप्तो बाला चेयं शिखण्डिनी ।\nत्वं च राज्ञि महत् कृच्छ्रं सम्प्राप्ता वरवर्णिनि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150363, "chapter_id": 4261, "verse_number": "१९", "content_sanskrit": "सा त्वं सर्वविमोक्षाय तत्त्वमाख्याहि पृच्छतः ।\nतथा विदध्यां सुश्रोणि कृत्यमाशु शुचिस्मिते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150364, "chapter_id": 4261, "verse_number": "२०", "content_sanskrit": "शिखण्डिनि च मा भैस्त्वं विधास्ये तत्र तत्त्वतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150365, "chapter_id": 4261, "verse_number": "२१", "content_sanskrit": "कृपयाऽहं वरारोहे वञ्चितः पुत्रधर्मतः ।\nमया दाशार्णको राजा वञ्चितः स महीपतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150366, "chapter_id": 4261, "verse_number": "२२", "content_sanskrit": "तदाचक्ष्व महाभागे विधास्ये तत्र यद्धितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150367, "chapter_id": 4261, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150368, "chapter_id": 4261, "verse_number": "२३", "content_sanskrit": "जानता हि नरेन्द्रेण ख्यापनार्थं परस्य वै ।\nप्रकाशं चोदिता देवी प्रत्युवाच महीपतिम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150369, "chapter_id": 4261, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्विनवत्युत्तरशततमोऽध्यायः ॥१९२॥\nअम्बोपाख्यानपर्वणि द्वाविंशोऽध्यायः ॥२२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]