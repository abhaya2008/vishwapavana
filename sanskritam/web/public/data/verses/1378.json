[{"id": 2018231, "chapter_id": 1378, "verse_number": "३-१६-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018232, "chapter_id": 1378, "verse_number": "३-१६-१", "content_sanskrit": "तां तूपयातो राजेन्द्र साल्वः सौभपतिस्तदा।\nप्रभूतनरनागेन बलेनोपविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018233, "chapter_id": 1378, "verse_number": "३-१६-२", "content_sanskrit": "समे निविष्टां सा सेना प्रभूतसलिलाशये।\nचतुरङ्गबलोपेता साल्वराजाभिपालिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018234, "chapter_id": 1378, "verse_number": "३-१६-३", "content_sanskrit": "वर्जयित्वा श्मशानानि देवतायतनानि च।\nवल्मीकांश्चैव चैत्यांश्च संनिविष्टमभूद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018235, "chapter_id": 1378, "verse_number": "३-१६-४", "content_sanskrit": "अनीकानां विभागेन पन्थानः सुकृतास्तथा।\nप्रथमा नवमाश्चैव साल्वस्य शिबिरे नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018236, "chapter_id": 1378, "verse_number": "३-१६-५", "content_sanskrit": "सर्वायुधसमोपेतं सर्वशस्त्रविशारदम्।\nरथनागाश्वकलिलं पदातिजनसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018237, "chapter_id": 1378, "verse_number": "३-१६-६", "content_sanskrit": "तुष्टपुष्टबलोपेतं वीरलक्षणलक्षितम्।\nविचित्रध्वजसन्नाहं विचित्ररथकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018238, "chapter_id": 1378, "verse_number": "३-१६-७", "content_sanskrit": "संनिवेश्य च कौरव्य द्वारकायां नरर्षभ।\nअभिसारयामास तदा वेगैन पतगेन्द्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018239, "chapter_id": 1378, "verse_number": "३-१६-८", "content_sanskrit": "तदापतन्तं संदृश्य बलं साल्वपतेस्तदा।\nनिर्याय योधयामासुः कुमारा वृष्णिनन्दनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018240, "chapter_id": 1378, "verse_number": "३-१६-९", "content_sanskrit": "असहन्तोऽभियानं तत्साल्वराजस्य कौरव।\nचारुदेष्णश्च साम्बश्च प्रद्युम्नश्च रमहारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018241, "chapter_id": 1378, "verse_number": "३-१६-१०", "content_sanskrit": "ते रथैर्दंशिताः सर्वेविचित्राभरणध्वजाः।\nसंसक्ताः साल्वराजस्य बहुभिर्योधपुङ्गवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018242, "chapter_id": 1378, "verse_number": "३-१६-११", "content_sanskrit": "गृहीत्वा कार्मुकं साम्बः साल्वस्य सचिवं रणे।\nयीधयामास संहृष्टः क्षेमधूर्तिं चमूपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018243, "chapter_id": 1378, "verse_number": "३-१६-१२", "content_sanskrit": "तस्य बाणमयं वर्षं जाम्बवत्याः सुतो महत्।\nमुमोच भरतश्रेष्ठ यथावर्षं सहस्रदृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018244, "chapter_id": 1378, "verse_number": "३-१६-१३", "content_sanskrit": "तद्बाणवर्षं तुमुलं विषेहे स चमूपतिः।\nक्षेमधूर्तिर्महाराज हिमवानिव निश्चलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018245, "chapter_id": 1378, "verse_number": "३-१६-१४", "content_sanskrit": "ततः साम्बाय राजेन्द्र क्षेमधूर्तिरपि स्वयम्।\nमुमोच मायाविहितं शरजालं महत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018246, "chapter_id": 1378, "verse_number": "३-१६-१५", "content_sanskrit": "ततो मायामयं जालं माययैव विदार्यसः।\nसाम्बः शरसहस्रेण रथमस्याभ्यवर्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018247, "chapter_id": 1378, "verse_number": "३-१६-१६", "content_sanskrit": "ततः स विद्धः साम्बेन क्षेमधूर्तिश्चमूपतिः।\nअपायाज्जवनैरश्वैः साम्बबाणप्रपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018248, "chapter_id": 1378, "verse_number": "३-१६-१७", "content_sanskrit": "तस्मिन्विप्रद्रुते शरे साल्वस्याथ चमूपतौ।\nवेगवान्नाम दैतेयः सुतं मेऽभ्यद्रवद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018249, "chapter_id": 1378, "verse_number": "३-१६-१८", "content_sanskrit": "अभिपन्नस्तु राजेन्द्र साम्बो वृष्णिकुलोद्वहः।\nवेगं वेगवतो राजंस्तस्थौ वीरो विधारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018250, "chapter_id": 1378, "verse_number": "३-१६-१९", "content_sanskrit": "स वेगवति कौन्तेय साम्बो वेगवतीं गदाम्।\nचिक्षेप तरसा वीरो व्याविद्ध्यन्सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018251, "chapter_id": 1378, "verse_number": "३-१६-२०", "content_sanskrit": "तया त्वभिहतो राजन्वेगवान्न्यपतद्भुवि।\nवातरुग्णं इव क्षुण्णो जीर्णमूलोवनस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018252, "chapter_id": 1378, "verse_number": "३-१६-२१", "content_sanskrit": "तस्मिन्निपतिते वीरे गदारुग्णे महासुरे।\nप्रविश्य महतीं सेनां योधयामास मे सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018253, "chapter_id": 1378, "verse_number": "३-१६-२२", "content_sanskrit": "चारुदेष्णेन संसक्तो विविन्ध्यो नाम दानवः।\nमहारथः समाज्ञातो महाराज महाधनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018254, "chapter_id": 1378, "verse_number": "३-१६-२३", "content_sanskrit": "ततः सुतुमुलं युद्धं चारुदेष्णविविन्ध्ययोः।\nवृत्रवासवयो राजन्यथापूर्वं तथाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018255, "chapter_id": 1378, "verse_number": "३-१६-२४", "content_sanskrit": "अन्योन्यस्याभिसंक्रुद्धावन्योन्यं जघ्नतुः शरैः।\nविनदन्तौ महाराज सिंहाविव महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018256, "chapter_id": 1378, "verse_number": "३-१६-२५", "content_sanskrit": "रौक्मिणेयस्ततो बाणमग्न्यर्कोपमवर्चसम्।\nअभिमन्त्र्य महास्त्रेण संदधे शत्रुनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018257, "chapter_id": 1378, "verse_number": "३-१६-२६", "content_sanskrit": "स विविन्ध्याय सक्रोधः समाहूय महारथः।\nचिक्षेप मे सुतो राजन्स गतासुरथापतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018258, "chapter_id": 1378, "verse_number": "३-१६-२७", "content_sanskrit": "विविन्ध्यं निहृतं दृष्ट्वा तां च विक्षोभितां चमूम्।\nकामगेन स सौभेन साल्वः पुनरुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018259, "chapter_id": 1378, "verse_number": "३-१६-२८", "content_sanskrit": "ततो व्याकुलितं सर्वं द्वारकावासि तद्बलम्।\nदृष्ट्वा साल्वं महाबाहो सौभस्थं पृथिवीगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018260, "chapter_id": 1378, "verse_number": "३-१६-२९", "content_sanskrit": "ततो निर्याय कौरव्य अवस्थाप्य च तद्बलम्।\nआनर्तानां महाराज प्रद्युम्नो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018261, "chapter_id": 1378, "verse_number": "३-१६-३०", "content_sanskrit": "सर्वे भवन्तस्तिष्ठन्तु सर्वे पश्यन्तु मां युधि।\nनिवारयन्तं संग्रामे बलात्सौभं सराजकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018262, "chapter_id": 1378, "verse_number": "३-१६-३१", "content_sanskrit": "अयं सौभपतेः सेनामायसैर्भुजगैरिव।\nधनुर्भुजविनिर्मुक्तैर्नाशयम्यद्य यादवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018263, "chapter_id": 1378, "verse_number": "३-१६-३२", "content_sanskrit": "आश्वसध्वं न भीः कार्या सौभराडद्य नश्यति।\nमयाऽभिपन्नो दुष्टात्मा ससौभो विनशिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018264, "chapter_id": 1378, "verse_number": "३-१६-३३", "content_sanskrit": "एवं ब्रुवति संहृष्टे प्रद्युम्ने पाण्डुनन्दन।\nधिष्टितं तद्बलं द्वारि युयुधे च यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018265, "chapter_id": 1378, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि षोडशोऽध्यायः ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]