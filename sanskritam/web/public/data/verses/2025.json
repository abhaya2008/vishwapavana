[{"id": 2046124, "chapter_id": 2025, "verse_number": "६-७४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046125, "chapter_id": 2025, "verse_number": "६-७४-१", "content_sanskrit": "अथ राजन्महाबाहुः सात्यकिर्युद्धदुर्मदः।\nविकृष्य चापं समरे भारसाहमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046126, "chapter_id": 2025, "verse_number": "६-७४-२", "content_sanskrit": "यत्तत्सख्युस्तु पूर्वेण अर्जुनादुपशिक्षितम् ।\nप्रगाढं लघु चित्रं च दर्शयन्हस्तलाघवम्।\nप्रामुञ्चत्पुङ्खसंयुक्ताञ्शरानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046127, "chapter_id": 2025, "verse_number": "६-७४-३", "content_sanskrit": "तस्य विक्षिपतस्छापं शरानन्यांश्च मुञ्चतः।\nआददानस्य भूयश्च संदधानस्य चापरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046128, "chapter_id": 2025, "verse_number": "६-७४-४", "content_sanskrit": "क्षिपतश्च परांस्तस्य रणे शत्रून्विनिघ्नतः।\nददृशे रूपमत्यर्थं मेघस्येव प्रवर्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046129, "chapter_id": 2025, "verse_number": "६-७४-५", "content_sanskrit": "तमुदीर्यन्तमालोक्य राजा दुर्योधस्ततः ।\nरथानामयुतं तस्य प्रेषयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046130, "chapter_id": 2025, "verse_number": "६-७४-६", "content_sanskrit": "तांस्तु सर्वान्महेष्वासान्सात्यकिः सत्यविक्रमः ।\nजघान परमेष्वासो दिव्येनास्त्रेण वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046131, "chapter_id": 2025, "verse_number": "६-७४-७", "content_sanskrit": "स कृत्कवा दारुणं कर्म प्रगृहीतशरासनः।\nआससाद ततो वीरो भूरिश्रवसमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046132, "chapter_id": 2025, "verse_number": "६-७४-८", "content_sanskrit": "स हि संदृश्य सेनां ते युयुधानेन पातिताम् ।\nअभ्यधावत संक्रुद्धः कुरूणां कीर्तिवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046133, "chapter_id": 2025, "verse_number": "६-७४-९", "content_sanskrit": "इन्द्रायुधसवर्णं तु विस्फार्य सुमहद्धनुः ।\nसृष्टवान्वज्रसंकाशाञ्शरानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046134, "chapter_id": 2025, "verse_number": "६-७४-१०", "content_sanskrit": "सहस्रशो माहाराज दर्शयन्पाणिलाघवम् ।\nशरांस्तान्मृत्युसंस्पर्शान्सात्यकेश्च पदानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046135, "chapter_id": 2025, "verse_number": "६-७४-११", "content_sanskrit": "न विषेहुस्तदा राजन्दुद्रुवुस्ते समन्ततः ।\nविहाय सात्यकिं राजन्समरे युद्धदुर्मदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046136, "chapter_id": 2025, "verse_number": "६-७४-१२", "content_sanskrit": "तं दृष्ट्वा युयुधानस्य सुता दश महाबलाः ।\nमहारथाःक समाख्याताश्चित्रवर्मायुधध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046137, "chapter_id": 2025, "verse_number": "६-७४-१३", "content_sanskrit": "समासाद्य महेष्वासं भूरिश्रवसमाहवे।\nऊचुः सर्वे सुसंरब्धा यूपकेतुं महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046138, "chapter_id": 2025, "verse_number": "६-७४-१४", "content_sanskrit": "भोभो कौरवादायाद सहास्माभिर्महाबल ।\nएहि युध्यस्व संग्रामे समस्तैः पृथगेव वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046139, "chapter_id": 2025, "verse_number": "६-७४-१५", "content_sanskrit": "अस्मान्वा त्वं पराजित्य यशः प्राप्नुहि संयुगे।\nवयं वा त्वां पराजित्य प्रीतिं धास्यामहे पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046140, "chapter_id": 2025, "verse_number": "६-७४-१६", "content_sanskrit": "एवमुक्तस्तदा शूरैस्तानुवाच महाबलः ।\nवीर्यश्लाघी नरश्रेष्ठस्तान्दृष्ट्वा समवस्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046141, "chapter_id": 2025, "verse_number": "६-७४-१७", "content_sanskrit": "साध्विदं कथ्यते वीरा यंद्येवं मतिरद्य वः।\nयुध्यध्वं सहिता यत्ता निहनिष्यामि वो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046142, "chapter_id": 2025, "verse_number": "६-७४-१८", "content_sanskrit": "एवमुक्ता महेष्वासास्ते वीराः क्षिप्रकारिणः ।\nमहता शरवर्षेण अभ्यधावन्नरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046143, "chapter_id": 2025, "verse_number": "६-७४-१९", "content_sanskrit": "सोऽपराह्णे महाराज संग्रामस्तुमुलोऽभवत्।\nएकस्य च बहूनां च समेतानां रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046144, "chapter_id": 2025, "verse_number": "६-७४-२०", "content_sanskrit": "तमेकं रथिनां श्रेष्ठं शरैस्ते समवाकिरन् ।\nप्रावृषीव यथा मेरुं सिषिचुर्जलदा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046145, "chapter_id": 2025, "verse_number": "६-७४-२१", "content_sanskrit": "तैस्तु मुक्ताञ्शरान्घोरान्यमदण्डाशनिप्रभान् ।\nअसंप्राप्तानसंभ्राकन्तिश्चिच्छेदाशु महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046146, "chapter_id": 2025, "verse_number": "६-७४-२२", "content_sanskrit": "तत्राद्भुतमपश्याम सौमदत्तेः पराक्रमम् ।\nयदेको बहुबिर्युद्धे समसञ्जदभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046147, "chapter_id": 2025, "verse_number": "६-७४-२३", "content_sanskrit": "विसृज्य शरवृष्टिं तां दश राजन्महारथाः ।\nपरिवार्य महाबाहुं निहन्तुमुपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046148, "chapter_id": 2025, "verse_number": "६-७४-२४", "content_sanskrit": "समदत्तिस्ततः क्रुद्धस्तेषां चापानि भारत ।\nचिच्छेद समरे राजन्युध्यमानो महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046149, "chapter_id": 2025, "verse_number": "६-७४-२५", "content_sanskrit": "अथैषां छिन्नधनुषां शरैः सन्नतपर्वभिः ।\nचिच्छेद समरे राजञ्शिरांसि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046150, "chapter_id": 2025, "verse_number": "६-७४-२६", "content_sanskrit": "ते हता न्यपतन्राजन्वज्रभग्ना इव द्रुमाः । ६-७४-२६bतान्दृष्ट्वा निहतान्वीरो रणे पुत्रान्महाबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046151, "chapter_id": 2025, "verse_number": "६-७४-२७", "content_sanskrit": "वार्ष्णेयो विनदराजन्भूरिश्रवसमभ्ययात्।\nरथं रथेन समरे पीडयित्वा महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046152, "chapter_id": 2025, "verse_number": "६-७४-२८", "content_sanskrit": "तावन्योन्यं हि समरे निहत्य रथवाजिनः ।\nविरथावभिवल्गन्तौ समेयातां महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046153, "chapter_id": 2025, "verse_number": "६-७४-२९", "content_sanskrit": "प्रगृहीतमहाखङ्गौ तौ चर्मवरधारिणौ ।\nशुशुभाते नरव्याघ्रौ युद्धाय समवस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046154, "chapter_id": 2025, "verse_number": "६-७४-३०", "content_sanskrit": "असह्यमसियुद्धाय भूरिश्रवसमाहवे।\nमत्वा वृकोदरस्तूर्णमभिप्लुत्य महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046155, "chapter_id": 2025, "verse_number": "६-७४-३१", "content_sanskrit": "ततः सात्यकिमभ्येत्य निस्त्रिंशवरधारिणम् ।\nभीमसेनस्त्वरन्राजन्रथमारोपयत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046156, "chapter_id": 2025, "verse_number": "६-७४-३२", "content_sanskrit": "तवापि तनयो राजन्भूरिश्रवसमाहवे।\nआरोपयद्रथं तूर्णं पश्यतां सर्वधन्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046157, "chapter_id": 2025, "verse_number": "६-७४-३३", "content_sanskrit": "तस्मिस्तथा वर्तमाने रणे भीष्मं महारथम्।\nअयोधयन्त संरब्धाः पाण्डवा भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046158, "chapter_id": 2025, "verse_number": "६-७४-३४", "content_sanskrit": "लोहितायति चादित्ये त्वरमाणो धनञ्जयः ।\nपञ्चविंशतिसाहस्रान्निजघान महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046159, "chapter_id": 2025, "verse_number": "६-७४-३५", "content_sanskrit": "ते हि दुर्योधनादिष्टास्तदा पार्थनिबर्हणे ।\nसंप्राप्यैव गता नाशं शलभा इव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046160, "chapter_id": 2025, "verse_number": "६-७४-३६", "content_sanskrit": "ततो मत्स्याः केकयाश्च धनुर्वेदविशारदाः ।\nपरिवव्रुस्तदा पार्थं सहपुत्रं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046161, "chapter_id": 2025, "verse_number": "६-७४-३७", "content_sanskrit": "एवस्मिन्नेव काले तु सूर्येऽस्तमुपगच्छति।\nसर्वेषां चैव सैन्यानां प्रमोहः समजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046162, "chapter_id": 2025, "verse_number": "६-७४-३८", "content_sanskrit": "अवहारं ततश्चक्रे पिता देवव्रतस्तव ।\nसंध्याकाले महाराज सैन्यानां श्रान्तवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046163, "chapter_id": 2025, "verse_number": "६-७४-३९", "content_sanskrit": "पाण्डवानां कुरूणां च परस्परसमागमे।\nते सेने भृशसंविग्ने ययतुः स्वं निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046164, "chapter_id": 2025, "verse_number": "६-७४-४०", "content_sanskrit": "ततः स्वशिबिरं गत्वा न्यविशंस्तत्र भारत।\nपाण्डवाः सृञ्जयैः सार्धं कुरवश्च यथाविधिः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046165, "chapter_id": 2025, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि प़ञ्चमदिवसयुद्धए चतुःसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]