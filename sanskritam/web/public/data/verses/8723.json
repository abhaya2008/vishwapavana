[{"id": 900009100, "chapter_id": 8723, "verse_number": "13.1", "content_sanskrit": "एतेन पदं पदार्थस्मृतिमात्रोपक्षीणं नान्वितबोधकं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009101, "chapter_id": 8723, "verse_number": "13.2", "content_sanskrit": "नच शक्तिस्मृतिरेवावान्तरव्यापारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009102, "chapter_id": 8723, "verse_number": "13.3", "content_sanskrit": "वस्तुतस्तु मन्मते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009103, "chapter_id": 8723, "verse_number": "13.4", "content_sanskrit": "न चैवं पदार्थस्मृतिरूपावान्तरव्यापाराभावाच्छब्दस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009104, "chapter_id": 8723, "verse_number": "13.5", "content_sanskrit": "एतेन पदार्थमात्रे शक्तस्य पदस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009105, "chapter_id": 8723, "verse_number": "13.6", "content_sanskrit": "किञ्चैवं ‘‘वेला तत्तीरनीरयोः’’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]