[{"id": 2093581, "chapter_id": 3000, "verse_number": "१३-१३०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nउक्तं पितामहेनेदं गवां दानमनुत्तमम्।\nविशेषेण नरेन्द्राणामिह धर्ममवेक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093582, "chapter_id": 3000, "verse_number": "१३-१३०-२", "content_sanskrit": "राज्यं हि सततं दुःखमाश्रमाश्च सुदुर्विदाः।\nपरिचारेषु वै दुःखं दुर्धरं चाकृतात्मभिः।\nभूयिष्ठं च नरेन्द्राणां विद्यते न शुभा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093583, "chapter_id": 3000, "verse_number": "१३-१३०-३", "content_sanskrit": "पूयन्ते तत्र नियतं प्रयच्छन्तो वसुन्धराम्।\nसर्वे च कथिता धर्मास्त्वया मे कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093584, "chapter_id": 3000, "verse_number": "१३-१३०-४", "content_sanskrit": "एवमेव गवामुक्तं प्रदानं ते नृगेण ह।\nऋषिणा नाचिकेतेन पूर्वमेव निदर्शितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093585, "chapter_id": 3000, "verse_number": "१३-१३०-५", "content_sanskrit": "वेदोपनिषदे चैव सर्वकर्मसु दक्षिणाः।\nसर्वक्रतुषु चोद्दिष्टा भूमिर्गावोऽथ काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093586, "chapter_id": 3000, "verse_number": "१३-१३०-६", "content_sanskrit": "तत्र श्रुतिस्तु परमा सुवर्णं दक्षिणेति वै।\nएतदिच्छाम्यहं श्रोतुं पितामह यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093587, "chapter_id": 3000, "verse_number": "१३-१३०-७", "content_sanskrit": "किं सुवर्णं कथं जातं कस्मिन्काले किमात्मकम्।\nकिंदैव किंफलं चैव कस्माच्च परमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093588, "chapter_id": 3000, "verse_number": "१३-१३०-८", "content_sanskrit": "कस्माद्दानं सुवर्णस्य पूजयन्ति मनीषिणः।\nकस्माच्च दक्षिणार्थं तद्यज्ञकर्मसु शस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093589, "chapter_id": 3000, "verse_number": "१३-१३०-९", "content_sanskrit": "कस्माच्च पावनं श्रेष्ठं भूमेर्गोभ्यश्च काञ्चनम्।\nपरमं दक्षिणार्थे च तद्ब्रवीहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093590, "chapter_id": 3000, "verse_number": "१३-१३०-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093591, "chapter_id": 3000, "verse_number": "१३-१३०-१०", "content_sanskrit": "शृणु राजन्नवहितो बहुकारणविस्तरम्।\nजातरूपसमुत्पत्तिमनुभूतं च यन्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093592, "chapter_id": 3000, "verse_number": "१३-१३०-११", "content_sanskrit": "पिता मम महातेजाः श्तनुर्निधनं गतः।\nतस्य दित्सुरहं श्राद्धं गङ्गाद्वारमुपागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093593, "chapter_id": 3000, "verse_number": "१३-१३०-१२", "content_sanskrit": "तत्रागम्य पितुः पुत्र श्राद्धकर्म समारभम्।\nमातो मे जाह्नवी चात्र साहाय्यमकरोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093594, "chapter_id": 3000, "verse_number": "१३-१३०-१३", "content_sanskrit": "तत्रागतांस्तपस्सिद्धानुपवेश्य बहूनृषीन्।\nतोयप्रदानात्प्रभृति कार्याण्यहमथारभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093595, "chapter_id": 3000, "verse_number": "१३-१३०-१४", "content_sanskrit": "तत्समाप्य यथोद्दिष्टं पूर्वकर्म समाहितः।\nदातुं निर्वपणं सम्यग्यथावदहमारभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093596, "chapter_id": 3000, "verse_number": "१३-१३०-१५", "content_sanskrit": "ततस्तं दर्भविन्यासं भित्त्वा सुरुचिराङ्गदः।\nप्रलम्बाभरणो बाहुरुदतिष्ठद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093597, "chapter_id": 3000, "verse_number": "१३-१३०-१६", "content_sanskrit": "मुहूर्तमपि तं दृष्ट्वा परं विस्मयमागमम्।\nप्रतिग्रहीता साक्षान्मे पितेति भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093598, "chapter_id": 3000, "verse_number": "१३-१३०-१७", "content_sanskrit": "ततो मे पुनरेवासीत्संज्ञा सञ्चिन्त्य शास्त्रतः।\nनायं वेदेषु विहितो विधिर्हस्त इति प्रभो।\nपिण्डो देयो नरेणेह ततो मतिरभून्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093599, "chapter_id": 3000, "verse_number": "१३-१३०-१८", "content_sanskrit": "साक्षान्नेह मनुष्यस्य पिण्डं हि पितरः क्वचित्।\nगृह्णन्ति विहितं चेत्थं पिण्डो देयः कुशेष्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093600, "chapter_id": 3000, "verse_number": "१३-१३०-१९", "content_sanskrit": "ततोऽहं तदनादृत्य पितुर्हस्तनिदर्शनम्।\nशास्त्रप्रामाण्यसूक्ष्मं तु विधइं पिण्डस्य संस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093601, "chapter_id": 3000, "verse_number": "१३-१३०-२०", "content_sanskrit": "ततो दर्भेषु तत्सर्वमददं भरतर्षभ।\nशास्त्रमार्गानुसारेण तद्विद्धि मनुजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093602, "chapter_id": 3000, "verse_number": "१३-१३०-२१", "content_sanskrit": "ततः सोऽन्तर्हितो बाहुः पितुर्मम जनाधिप।\nततो मां दर्शयामासुः स्वप्नान्ते पितरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093603, "chapter_id": 3000, "verse_number": "१३-१३०-२२", "content_sanskrit": "प्रीयमाणास्तु मामूचुः प्रीताः स्म भरतर्षभ।\nविज्ञानेन तवानेन यन्न मुह्यसि धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093604, "chapter_id": 3000, "verse_number": "१३-१३०-२३", "content_sanskrit": "त्वया हि कुर्वता शास्त्रं प्रमाणमिह पार्थिव।\nआत्मा धर्मः श्रुतं वेदाः पितरश्चर्षिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093605, "chapter_id": 3000, "verse_number": "१३-१३०-२४", "content_sanskrit": "साक्षात्पितामहो ब्रह्मा गुरवोऽथ प्रजापतिः।\nप्रमाणमुपनीता वै स्थिताश्च न विचालिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093606, "chapter_id": 3000, "verse_number": "१३-१३०-२५", "content_sanskrit": "तदिदं सम्यगारब्धं त्वयाऽद्य भरतर्षभ।\nकिन्तु भूमेर्गवां चार्थे सुवर्णं दीयतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093607, "chapter_id": 3000, "verse_number": "१३-१३०-२६", "content_sanskrit": "एवं वयं च धर्मश्च सर्वे चास्मत्पितामहाः।\nपाविता वै भविष्यन्ति पावनं हि परं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093608, "chapter_id": 3000, "verse_number": "१३-१३०-२७", "content_sanskrit": "दश पूर्वान्दशैवान्यांस्तथा सन्तारयन्ति ते।\nसुवर्णं ये प्रयच्छन्ति एवं मत्पितरोऽब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093609, "chapter_id": 3000, "verse_number": "१३-१३०-२८", "content_sanskrit": "ततोऽहं विस्मितो राजन्प्रतिबुद्धो विशाम्पते।\nसुवर्णदानेऽकरवं मतिं च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093610, "chapter_id": 3000, "verse_number": "१३-१३०-२९", "content_sanskrit": "इतिहासमिमं चापि शृणु राजन्पुरातनम्।\nजामदग्न्यं प्रति विभो धन्यमायुष्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093611, "chapter_id": 3000, "verse_number": "१३-१३०-३०", "content_sanskrit": "जामदग्न्येन रामेण तीव्ररोषान्वितेन वै।\nत्रिःसप्तकृत्वः पृथिवी कृता निःक्षत्रिया पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093612, "chapter_id": 3000, "verse_number": "१३-१३०-३१", "content_sanskrit": "ततो जित्वा महीं कृत्स्नां रामो राजीवलोचनः।\nआजहार क्रतुं वीरो ब्रह्मक्षत्रेण पूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093613, "chapter_id": 3000, "verse_number": "१३-१३०-३२", "content_sanskrit": "वाजिमेधं महाराज सर्वकामसमन्वितम्।\nपावनं सर्वभूतानां तेजोद्युतिविवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093614, "chapter_id": 3000, "verse_number": "१३-१३०-३३", "content_sanskrit": "विपाप्मा च स तेजस्वी तेन क्रतुफलेन च।\nनैवात्मनोऽथ लघुतां जामदग्न्योऽध्यगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093615, "chapter_id": 3000, "verse_number": "१३-१३०-३४", "content_sanskrit": "स तु क्रतुवरेणेष्ट्वा महात्मा दक्षिणावता।\nपप्रच्छागमसम्पन्नानृषीन्देवांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093616, "chapter_id": 3000, "verse_number": "१३-१३०-३५", "content_sanskrit": "पावनं यत्परं नॄणामुग्रे कर्मणि वर्तताम्।\nतदुच्यतां महाभागा इति जागघृणोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093617, "chapter_id": 3000, "verse_number": "१३-१३०-३६", "content_sanskrit": "इत्युक्ता वेदशास्त्रज्ञास्तमूचुस्ते महर्षयः।\nराम विप्राः सत्क्रियन्तां वेदप्रामाण्यदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2093618, "chapter_id": 3000, "verse_number": "१३-१३०-३७", "content_sanskrit": "भूयश्च विप्रर्षिगणाः प्रष्टव्याः पावनं प्रति।\nते यद्ब्रूर्महाप्राज्ञास्तच्चैव समुदाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2093619, "chapter_id": 3000, "verse_number": "१३-१३०-३८", "content_sanskrit": "ततो वसिष्ठं देवर्षिमगस्त्यमथ काश्यपम्।\nतमेवार्तं महातेजाः पप्रच्छ भृगुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2093620, "chapter_id": 3000, "verse_number": "१३-१३०-३९", "content_sanskrit": "जाता मतिर्मे विप्रेन्द्राः कथं पूयेयमित्युत।\nकेन वा कर्मयोगेन प्रदानेनेह केन वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2093621, "chapter_id": 3000, "verse_number": "१३-१३०-४०", "content_sanskrit": "यदि वोऽनुग्रहकृता बुद्धिर्मां प्रति सत्तमाः।\nप्रबूत पावनं किं मे भवेदिति तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2093622, "chapter_id": 3000, "verse_number": "१३-१३०-४१x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2093623, "chapter_id": 3000, "verse_number": "१३-१३०-४१", "content_sanskrit": "गाश्च भूमिं च वित्तं च दत्त्वेह भृगुनन्दन।\nपापकृत्पूयते मर्त्य इति भार्गव शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2093624, "chapter_id": 3000, "verse_number": "१३-१३०-४२", "content_sanskrit": "अन्यद्दानं तु विप्रर्षे श्रूयतां पावनं महत्।\nदिव्यमत्यद्भुताकारमपत्यं जातवेदसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2093625, "chapter_id": 3000, "verse_number": "१३-१३०-४३", "content_sanskrit": "दग्ध्वा लोकान्पुरा वीर्यात्सम्भूतमिह शुश्रुम।\nसुवर्णमिति विख्यातं तद्ददत्सिद्धिमेष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2093626, "chapter_id": 3000, "verse_number": "१३-१३०-४४", "content_sanskrit": "ततोऽब्रवीद्वसिष्ठस्तं भगवान्संशितव्रतः।\nशृणु राम यथोत्पन्नं सुवर्णमनलप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2093627, "chapter_id": 3000, "verse_number": "१३-१३०-४५", "content_sanskrit": "फलं दास्यति ते यत्तु दाने परमिहोच्यते।\nसुवर्णं यच्च यस्माच्च यथा च गुणवत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2093628, "chapter_id": 3000, "verse_number": "१३-१३०-४६", "content_sanskrit": "तन्निबोध महाबाहो सर्वं निगदतो मम।\nअग्निषोमात्मकमिदं सुवर्णं विद्दि निश्चये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2093629, "chapter_id": 3000, "verse_number": "१३-१३०-४७", "content_sanskrit": "अजोऽग्निर्वरुणो मेषः सूर्योऽश्च इति दर्शनम्।\nकुञ्जराश्च मृगा नागा महिषाश्चासुरा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2093630, "chapter_id": 3000, "verse_number": "१३-१३०-४८", "content_sanskrit": "कुक्कुटाश्च वराहाश्च राक्षसा भृगुनन्दन।\nइडा गावः पयः सोमो भूमिरित्येव च स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2093631, "chapter_id": 3000, "verse_number": "१३-१३०-४९", "content_sanskrit": "जगत्सर्वं च निर्मथ्य तेजोराशिः समुत्थितः।\nसुवर्णमेभ्यो विप्रर्षे रत्नं परममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2093632, "chapter_id": 3000, "verse_number": "१३-१३०-५०", "content_sanskrit": "एतस्मात्कारणाद्देवा गन्धर्वोरगराक्षसाः।\nमनुष्याश्च पिशाचाश्च प्रयता धारयन्ति तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2093633, "chapter_id": 3000, "verse_number": "१३-१३०-५१", "content_sanskrit": "मुकुटैरङ्गदयुतैरलङ्कारैः पृथग्विधैः।\nसुवर्णविकृतैस्तत्र विराजन्ते भृगूत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2093634, "chapter_id": 3000, "verse_number": "१३-१३०-५२", "content_sanskrit": "तस्मात्सर्वपवित्रेभ्यः पवित्रं परमं स्मृतम्।\nभूमेर्गोभ्योऽथ रत्नेभ्यस्तद्विद्धि मनुजर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2093635, "chapter_id": 3000, "verse_number": "१३-१३०-५३", "content_sanskrit": "पृथिवीं गाश्च दत्त्वेह यच्चान्यदपि किञ्चन।\nविशिष्यते सुवर्णस्य दानं परमकं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2093636, "chapter_id": 3000, "verse_number": "१३-१३०-५४", "content_sanskrit": "अक्षयं पावनं चैव सुवर्णममरद्युते।\nप्रयच्छ द्विजमुख्येभ्यः पावनं ह्येतदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2093637, "chapter_id": 3000, "verse_number": "१३-१३०-५५", "content_sanskrit": "सुवर्णमेव सर्वासु दक्षिणासु विधीयते।\nसुवर्णं ये प्रयच्छन्ति सर्वदास्ते भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2093638, "chapter_id": 3000, "verse_number": "१३-१३०-५६", "content_sanskrit": "देवतास्ते प्रयच्छन्ति ये सुवर्णं ददत्यथ।\nअग्निर्हि देवताः सर्वाः सुवर्णं च तदात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2093639, "chapter_id": 3000, "verse_number": "१३-१३०-५७", "content_sanskrit": "तस्मात्सुवर्णं ददता दत्ताः सर्वाः स्म देवताः।\nभवन्ति पुरुषव्याघ्र न ह्यतः परमं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2093640, "chapter_id": 3000, "verse_number": "१३-१३०-५८", "content_sanskrit": "भूय एव च महात्म्यं सुवर्णस्य निबोध मे।\nगदतो मम विप्रर्षे सर्वशस्त्रभृतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2093641, "chapter_id": 3000, "verse_number": "१३-१३०-५९", "content_sanskrit": "मया श्रुतमिदं पूर्वं पुराणे भृगुनन्दन।\nप्रजापतेः कथयतो मनोः स्वायंभुवस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2093642, "chapter_id": 3000, "verse_number": "१३-१३०-६०", "content_sanskrit": "शूलपाणेर्भगवतो रुद्रस्य च महात्मनः।\nगिरौ हिमवति श्रेष्ठे तदा भृगुकुलोद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2093643, "chapter_id": 3000, "verse_number": "१३-१३०-६१", "content_sanskrit": "देव्या विवाहे निर्वृत्ते रुद्राण्या भृगुनन्दन।\nसमागमे भगवतो देव्या सह महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2093644, "chapter_id": 3000, "verse_number": "१३-१३०-६२", "content_sanskrit": "ततः सर्वे समुद्विग्रा देवा रुद्रमुपागमन्॥\nते महादेवमासीनं देवीं च वरदामुमाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2093645, "chapter_id": 3000, "verse_number": "१३-१३०-६३", "content_sanskrit": "प्रसाद्य शिरसा सर्वे रुद्रमूचुर्भृगूद्वह॥\nअयं समागमो देव देव्या सह तवानघ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2093646, "chapter_id": 3000, "verse_number": "१३-१३०-६४", "content_sanskrit": "तपस्विनस्तपस्विन्या तेजस्विन्याऽतितेजसः॥\nअमोघतेजास्त्वं देव देवी चेयमुमा तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2093647, "chapter_id": 3000, "verse_number": "१३-१३०-६५", "content_sanskrit": "अपत्यं युवयोर्देव बलवद्भविता विभो।\nतन्नूनं त्रिषु लोकेषु न किञ्चिच्छेषयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2093648, "chapter_id": 3000, "verse_number": "१३-१३०-६६", "content_sanskrit": "तदेभ्यः प्रणतेभ्यस्त्वं देवेभ्यः पृथुलोचन।\nवरं प्रयच्छ लोकेश त्रैलोक्यहितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2093649, "chapter_id": 3000, "verse_number": "१३-१३०-६७", "content_sanskrit": "अपत्यार्थं निगृह्णीष्व तेजः परमकं विभो।\n[त्रैलोक्यसारौ हि युवां लोकं सन्तापयिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2093650, "chapter_id": 3000, "verse_number": "१३-१३०-६८", "content_sanskrit": "तदपत्यं हि युवयोर्देवानभिभवेद्ध्रुवम्।\nन हि ते पृथिवी देवी न च द्यौर्न दिवं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2093651, "chapter_id": 3000, "verse_number": "१३-१३०-६९", "content_sanskrit": "नेदं धारयितुं शक्ताः समस्ता इति मे मतिः।\nतेजःप्रभावनिर्दग्धं तस्मात्सर्वमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2093652, "chapter_id": 3000, "verse_number": "१३-१३०-७०", "content_sanskrit": "तस्मात्प्रसादं भगवन्कर्तुमर्हसि नः प्रभो।\nन देव्यां सम्भवेत्पुत्रो भवतः सुरसत्तम।\nधैर्यादेव निगृह्णीष्व तेजो ज्वलितमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2093653, "chapter_id": 3000, "verse_number": "१३-१३०-७१", "content_sanskrit": "इति तेषां कथयतां भगवान्वृषभध्वजः]।\nएवमस्त्विति देवांस्तान्विप्रर्षे प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2093654, "chapter_id": 3000, "verse_number": "१३-१३०-७२", "content_sanskrit": "इत्युक्त्वा चोर्ध्वमनयद्रेतो वृषभवाहनः।\nऊर्ध्वरेषः समभवत्ततः प्रभृति चापि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2093655, "chapter_id": 3000, "verse_number": "१३-१३०-७३", "content_sanskrit": "रुद्राणीति ततः क्रुद्धा प्रजोच्छेद तदा कृते।\nदेवानथाब्रवीत्तत्र स्त्रीभावात्परुषं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2093656, "chapter_id": 3000, "verse_number": "१३-१३०-७४", "content_sanskrit": "यस्मादपत्यकामो वै भर्ता मे विनिवर्तितः।\nतस्मात्सर्वे सुरा भूयमनपत्या भविष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2093657, "chapter_id": 3000, "verse_number": "१३-१३०-७५", "content_sanskrit": "प्रजोच्छेदो मम कृतो यस्माद्युष्माभिरद्य वै।\nतस्मात्प्रजा वः खगमाः सर्वेषां न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2093658, "chapter_id": 3000, "verse_number": "१३-१३०-७६", "content_sanskrit": "पावकस्तु न तत्रासीच्छापकाले भृगूद्वह।\nदेवा देव्यास्तथा शापादनपत्यास्ततोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2093659, "chapter_id": 3000, "verse_number": "१३-१३०-७७", "content_sanskrit": "रुद्रस्तु तेजोऽप्रतिमं धारयामास वै तदा।\nप्रस्कन्नं तु ततस्तस्मात्किंचित्तत्रापतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2093660, "chapter_id": 3000, "verse_number": "१३-१३०-७८", "content_sanskrit": "उत्पपात तदा वह्नौ ववृधे चाद्भुतोपमम्।\nतेजस्तेजसि संयुक्तमेकयोनित्वमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2093661, "chapter_id": 3000, "verse_number": "१३-१३०-७९", "content_sanskrit": "एतस्मिन्नेव काले तु देवाः शक्रपुरोगमाः।\nअसुरस्तारको नाम तेन सन्तापिता भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2093662, "chapter_id": 3000, "verse_number": "१३-१३०-८०", "content_sanskrit": "आदित्या वसवो रुद्रा मरुतोऽथाश्विनावपि।\nसाध्याश्च सर्वे संत्रस्ता दैतेयस्य पराक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2093663, "chapter_id": 3000, "verse_number": "१३-१३०-८१", "content_sanskrit": "स्थानानि देवतानां हि विमानानि पुराणि च।\nऋषीणां चाश्रमाश्चैव बभूवुरसुरैर्हृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2093664, "chapter_id": 3000, "verse_number": "१३-१३०-८२", "content_sanskrit": "ते दीनमनसः सर्वे देवता ऋषयश्च ये।\nप्रजग्मुः शरणं देवं ब्रह्माणमजरं विभुम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2093665, "chapter_id": 3000, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिंशदधिकशततमोऽध्यायः॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]