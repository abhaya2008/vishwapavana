[{"id": 7003160000, "chapter_id": 23160, "verse_number": "४-९६-१", "content_sanskrit": "नारायण उवाच ।\nश्रीकृष्णस्मरणं कृत्वा गमनोन्मुखमुद्धवम् ।\nनतं राधापदाम्भोजे शिरसा पुलकाञ्चितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003160001, "chapter_id": 23160, "verse_number": "४-९६-२", "content_sanskrit": "उवाच माधवी गोपी रुदती प्रेमविह्वला ।\nभक्तं रुदन्तमुच्छैश्च राधाविच्छेदकातरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003160002, "chapter_id": 23160, "verse_number": "४-९६-३", "content_sanskrit": "माधव्युवाच ।\nउद्धव शृणु वक्ष्यामि क्षणं तिष्ठ यथोचितम् ।\nनिगूढं परमं ज्ञानं यत्ते मनसि वाञ्छितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003160003, "chapter_id": 23160, "verse_number": "४-९६-४", "content_sanskrit": "सुदुर्लभं पुराणेषु वेदेषु गोपनीयकम् ।\nप्रश्नं कुरु महाभाग राधिकां त्रिजगत्प्रसूम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003160004, "chapter_id": 23160, "verse_number": "४-९६-५", "content_sanskrit": "इत्युक्त्वा सा च गोपीशा समुवास मुसंसदि ।\nउवाच मधुरं शान्तामुद्धवश्चापि राधिकाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003160005, "chapter_id": 23160, "verse_number": "४-९६-६", "content_sanskrit": "उद्धवउवाच ।\nएकाकी भवमायाति यात्येकाकी पुनः पुनः ।\nप्राणी कर्मानुरोधेन स्वकर्मफलभुक्पुमान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003160006, "chapter_id": 23160, "verse_number": "४-९६-७", "content_sanskrit": "कर्मणा जायते जन्तुः कर्मणौव प्रलीयते ।\nसुखं दुःखं भयं शोकं कर्मणैवाभिपद्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003160007, "chapter_id": 23160, "verse_number": "४-९६-८", "content_sanskrit": "जन्तुर्भोगावशेषेण भोगं भुङ्क्ते भवेषु च ।\nपुनश्च कर्मणो भोगात्समायाति च याति च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003160008, "chapter_id": 23160, "verse_number": "४-९६-९", "content_sanskrit": "रत्नादिकं च यत्किचिन्मह्यं दत्तं त्वया सति ।\nमया सार्ध न यात्येव तेन मे किं प्रयोजनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003160009, "chapter_id": 23160, "verse_number": "४-९६-१०", "content_sanskrit": "भवाब्थितारणे देवि भवती तरणिर्वरा ।\nकर्णधारः स्वयं कृष्णः सर्वेषां पारकारकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003160010, "chapter_id": 23160, "verse_number": "४-९६-११", "content_sanskrit": "किंचिद्यानं देहि मह्यं भवाब्धिपारकारणम् ।\nप्राप्य प्रसातं यास्यामि मथुरां कृष्ममूलकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003160011, "chapter_id": 23160, "verse_number": "४-९६-१२", "content_sanskrit": "यां यां कालगतिं मातः सुराणां च नृणामपि ।\nपितॄणां ब्रह्मलोकस्य तदूर्ध्वस्य च तां वद ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003160012, "chapter_id": 23160, "verse_number": "४-९६-१३", "content_sanskrit": "तामेव दुस्तरां घोरां तीर्त्वा यामि हरेः पदम् ।\nएवंभूतमुपायं च देहि मे कमलालये ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003160013, "chapter_id": 23160, "verse_number": "४-९६-१४", "content_sanskrit": "दूरतो यत्पदाम्भोजं ध्यायन्ते च दिवानिशम् ।\nदेवा ब्रह्मेशशेषाद्यास्त्वं तद्वक्षः स्थलस्थिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003160014, "chapter_id": 23160, "verse_number": "४-९६-१५", "content_sanskrit": "उद्धवस्य वचः श्रुत्वा जहास कमलालया ।\nवाससा नेत्रनीरं च संभार्ज्य तमुवाच सा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003160015, "chapter_id": 23160, "verse_number": "४-९६-१६", "content_sanskrit": "राधोवाच ।\nमाधवीवचनेनैव करोषि प्रश्नमुद्धव ।\nस्त्रीजातिरबला लोके किं वा ज्ञानं ददामि ते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003160016, "chapter_id": 23160, "verse_number": "४-९६-१७", "content_sanskrit": "शुद्धां कालगतिं वत्स जानाति भगवान्हरिः ।\nब्रह्म महेशः शेषश्च वेदाश्चत्वार एव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003160017, "chapter_id": 23160, "verse_number": "४-९६-१८", "content_sanskrit": "किंचिद्वेदानुसारेण सन्तो जानन्ति पुत्रक ।\nश्रूयतां कुष्णवक्त्रेण गोलोके रासमण़्डले ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003160018, "chapter_id": 23160, "verse_number": "४-९६-१९", "content_sanskrit": "गोलोके चापि वैकुण्ठे ब्रह्मलोके च सांप्रतम् ।\nया च दृष्टा कालगतिस्तामेव कथयामि ते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003160019, "chapter_id": 23160, "verse_number": "४-९६-२०", "content_sanskrit": "नृणां पितॄणां देवानां ब्रह्मलोकादिकस्य च ।\nबहिर्लोकस्य ब्रह्माण्डात्पातालानां च निश्चितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003160020, "chapter_id": 23160, "verse_number": "४-९६-२१", "content_sanskrit": "दुरत्ययां कालगतिं येनोपायेन पण्डिताः ।\nनिस्तरन्ति बुधश्रेष्ठ कथयामि निशामय ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003160021, "chapter_id": 23160, "verse_number": "४-९६-२२", "content_sanskrit": "भजन्ति जगतां नाथं कालकालं जगद्गुरुम् ।\nनिर्गुणं च निरीहं च परमात्मानमीश्वरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003160022, "chapter_id": 23160, "verse_number": "४-९६-२३", "content_sanskrit": "सद्यः पतति देहोऽयं विना येन सदात्मना ।\nतं निषेव्य कालगतिं तलत्येव हि केवलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003160023, "chapter_id": 23160, "verse_number": "४-९६-२४", "content_sanskrit": "आयुर्हरति सर्वेषां प्राणिनां रविरेव च ।\nश्रीहरेः शुद्धभक्तानां सतां पुण्यवतां विना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003160024, "chapter_id": 23160, "verse_number": "४-९६-२५", "content_sanskrit": "विधेर्मानसिकान्पुत्रांश्चतुरः पश्य पुत्रक ।\nसनकादीन्भागवतान्येषां च सुस्थिरं वमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003160025, "chapter_id": 23160, "verse_number": "४-९६-२६", "content_sanskrit": "रुद्राद्यान्वयसा नित्याञ्ज्ञातिनां च गुरोर्गुरून् ।\nबालाननुपनीतांश्च पञ्चवर्षशिशून्यथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003160026, "chapter_id": 23160, "verse_number": "४-९६-२७", "content_sanskrit": "अम्यन्तरे महास्फीतान्सस्मितांश्च दिगम्बरान् ।\nश्रीकृष्णध्यानपूताश्च तीर्थपूतांश्च वैष्णवान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003160027, "chapter_id": 23160, "verse_number": "४-९६-२८", "content_sanskrit": "वेदवेदाङ्गशास्त्राणां चिन्ताहीनान्प्रफुल्लितान् ।\nभक्त्या दिवानिशं शश्वद्धरिभावेन तत्परान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003160028, "chapter_id": 23160, "verse_number": "४-९६-२९", "content_sanskrit": "बाह्यपूजाविहीनांश्च पूतान्मानसिकांस्तथा ।\nमृत्युञ्जयान्महाभागान्कालव्यालजितस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003160029, "chapter_id": 23160, "verse_number": "४-९६-३०", "content_sanskrit": "सनकं च सनन्दं च तृतीयं च सनातनम् ।\nपरं सनत्कुमारं च ये स्मरन्ति च सर्वशः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003160030, "chapter_id": 23160, "verse_number": "४-९६-३१", "content_sanskrit": "तीर्थस्नानफलं लब्ध्वा मुच्यते कृतपातकात् ।\nहरिभक्तिर्भवेत्तेषां हरिदास्यं लभन्ति च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003160031, "chapter_id": 23160, "verse_number": "४-९६-३२", "content_sanskrit": "मृकण्डुबालकं पश्य कर्मणा च द्विजोत्तमम् ।\nदशवर्षायुषं तीव्रं ज्वलन्तं ब्रह्मतेजसा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003160032, "chapter_id": 23160, "verse_number": "४-९६-३३", "content_sanskrit": "हरिसेवनतः पश्चात्सप्तकल्पान्तजीविनम् ।\nवोढुं पञ्चशिखं पश्य लोमशं चाऽऽसुरिं तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003160033, "chapter_id": 23160, "verse_number": "४-९६-३४", "content_sanskrit": "सर्वकर्मविहीनं च हरिसेवनतत्परम् ।\nशतकल्पायुषं चैव ध्यायमानं हरेः पदम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003160034, "chapter_id": 23160, "verse_number": "४-९६-३५", "content_sanskrit": "जमदग्नेः सुतं पश्य रामं तं चिरजीविनम् ।\nहनुमन्तं बलिं व्यासमश्वत्थामानमेव च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003160035, "chapter_id": 23160, "verse_number": "४-९६-३६", "content_sanskrit": "विभीषणं कृपं विप्रं जाम्बवन्तं च भल्लुकम् ।\nहरिभावनया चैते शुद्धाः सुचिरजीविनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003160036, "chapter_id": 23160, "verse_number": "४-९६-३७", "content_sanskrit": "सिद्धेन्द्रेषु मुनीन्द्रेषु नरेष्वन्येषु चोद्धव ।\nहरिभावनशुद्धाश्च सर्वे ते चिरजीविनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003160037, "chapter_id": 23160, "verse_number": "४-९६-३८", "content_sanskrit": "प्रह्लादं पश्य दैत्येषु हिरण्यकशिपोः सुतम् ।\nहरिद्विषो दुरन्तस्य हरिभावनतत्परम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003160038, "chapter_id": 23160, "verse_number": "४-९६-३९", "content_sanskrit": "चिरायुषं कालजितं पश्यान्यं चाप्यसंख्यकम् ।\nअनेकजन्मतपसा लब्ध्वा जन्म च भारते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003160039, "chapter_id": 23160, "verse_number": "४-९६-४०", "content_sanskrit": "ये हरिं तं न सेवन्ते ते मूढाः कृतपापिनः ।\nवासुदेवं परित्यज्य विषये निरतो जनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003160040, "chapter_id": 23160, "verse_number": "४-९६-४१", "content_sanskrit": "त्यक्त्वाऽमृतं महामूढो विषं भुङ्क्ते निजेच्छया ।\nकस्य स्त्री कस्य वा पुत्रः कस्य वा बान्धवास्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003160041, "chapter_id": 23160, "verse_number": "४-९६-४२", "content_sanskrit": "कः कस्य बन्धुर्विपदि श्रीकृष्णेन विना भुवि ।\nतस्मात्सन्तः सदा कृष्णं भजन्त्येव दिवानिशम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003160042, "chapter_id": 23160, "verse_number": "४-९६-४३", "content_sanskrit": "जन्ममृत्युजराव्याधिहरं सर्वहरं परम् ।\nकालस्य तरणोपायं भजनं परमात्मनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003160043, "chapter_id": 23160, "verse_number": "४-९६-४४", "content_sanskrit": "आनन्दनन्दनस्यैव परिपूर्णतमस्य च ।\nशृणु कालगतिं वत्स मदीयज्ञानगोचराम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003160044, "chapter_id": 23160, "verse_number": "४-९६-४५", "content_sanskrit": "नराणां च पितॄणां च सुराणां चापि ब्रह्मणः ।\nनागानां राक्षसादीनां तत्परेषां च पुत्रक ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003160045, "chapter_id": 23160, "verse_number": "४-९६-४६", "content_sanskrit": "कथयामि निगूढार्थं सावधानं निशामय ।\nसर्वस्माच्च परं स्थानं सर्वाधारो महान्विराट् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003160046, "chapter_id": 23160, "verse_number": "४-९६-४७", "content_sanskrit": "यस्य लोमसु विश्वानि चासंख्यानि च तानि च ।\nसर्वस्माच्च परं सूक्ष्मं परमाणुं निशामय ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003160047, "chapter_id": 23160, "verse_number": "४-९६-४८", "content_sanskrit": "कालारम्भात्मकं सर्वमनूरं परमीप्सितम् ।\nचरमः सद्विशेषाणामनेकोऽसंयुतः सदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003160048, "chapter_id": 23160, "verse_number": "४-९६-४९", "content_sanskrit": "परमाणुः स विज्ञेयो नृपामैक्यभ्रमो यतः ।\nपरमाणुद्वयेनाणुस्त्रसरेणुस्तु ते त्रयः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003160049, "chapter_id": 23160, "verse_number": "४-९६-५०", "content_sanskrit": "त्रसरेणुत्रिकेणापि त्रुटिरुक्ता मनीषिभिः ।\nवेधस्त्रुटिशतेनैव त्रिवेधेन लवस्तथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003160050, "chapter_id": 23160, "verse_number": "४-९६-५१", "content_sanskrit": "त्रिलवेन निमेषश्च त्रि निमेषेण च क्षणः ।\nकाष्ठा पञ्चक्षणेनैव लघुश्च दशकाष्ठया ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003160051, "chapter_id": 23160, "verse_number": "४-९६-५२", "content_sanskrit": "लघुपञ्चदशं दण्डस्तत्प्रमाणं निशामय ।\nद्वादशार्धपलोन्मानं चतुर्भिश्चतुरङ्गुलैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003160052, "chapter_id": 23160, "verse_number": "४-९६-५३", "content_sanskrit": "स्वर्णमाषैः कृतच्छिद्रं यावत्प्रस्थजलप्लुतम् ।\nदण्डद्वये मुहूर्तः स्यात्वष्टिदण्डात्मिका तिथिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003160053, "chapter_id": 23160, "verse_number": "४-९६-५४", "content_sanskrit": "तदष्टभागः प्रहरः प्रमाणं च निरूपणम् ।\nचतुर्भिः प्रहरै रात्रिश्चतुर्भिर्दिनमुच्यते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003160054, "chapter_id": 23160, "verse_number": "४-९६-५५", "content_sanskrit": "तिथिपञ्चदशेनैव पक्षमानं प्रकीर्तितम् ।\nपक्षद्वयेन मासः स्याच्छुक्लकृष्णाभिधेन च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003160055, "chapter_id": 23160, "verse_number": "४-९६-५६", "content_sanskrit": "ऋतुर्मासद्वयेनैव तत्षट्केनैव वत्सरः ।\nवसन्तग्रीष्मवर्षाश्च शरद्धेमन्तशीतकाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003160056, "chapter_id": 23160, "verse_number": "४-९६-५७", "content_sanskrit": "वर्षाः पञ्चविधा ज्ञेयाः कालविद्भिर्निरूपिताः ।\nसंवत्सरः प्रवत्सर इलावत्सर एव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003160057, "chapter_id": 23160, "verse_number": "४-९६-५८", "content_sanskrit": "अनुवत्सरो वत्सरोऽयमिति कालविदो विदुः ।\nअब्दो द्विषट्कमासैश्च तन्नाम शुणु चोद्धव ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003160058, "chapter_id": 23160, "verse_number": "४-९६-५९", "content_sanskrit": "वैशाखो ज्येष्ठ आषाढः श्रावणो भाद्र एव च ।\nआश्विनः कार्तिको मार्गः पौषो माघस्तु फाल्गुनः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003160059, "chapter_id": 23160, "verse_number": "४-९६-६०", "content_sanskrit": "सैत्रस्तु चरमो ज्ञेयो वर्षशेषी निरूपितः ।\nवसन्तश्चैत्रवैशाखमासयुग्मेन कीर्तितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003160060, "chapter_id": 23160, "verse_number": "४-९६-६१", "content_sanskrit": "ज्येष्ठावाढद्वयेनैव ग्रीष्मस्तु परिकीर्तितः ।\nवर्षा श्रावणभद्रे च ह्याश्विने कार्तिके शरत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003160061, "chapter_id": 23160, "verse_number": "४-९६-६२", "content_sanskrit": "मार्गे पौषे च हेमन्तः शिशिरो माघफाल्गुने ।\nअब्दस्तु चायनै द्वे वै चोत्तरे दक्षिणायने ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003160062, "chapter_id": 23160, "verse_number": "४-९६-६३", "content_sanskrit": "माघादिषड्विनिर्मितमुत्तरायणमीप्सितम् ।\nश्रावणादिमासषट्कं दक्षिणायनमेव च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003160063, "chapter_id": 23160, "verse_number": "४-९६-६४", "content_sanskrit": "माघादाषाढपर्यन्तं दिनं वृद्धं क्रमेण वै ।\nनक्तं वृद्धं श्रावणश्च पौषपर्यन्तमेव च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003160064, "chapter_id": 23160, "verse_number": "४-९६-६५", "content_sanskrit": "प्रतिपत्पूर्णिमान्तश्च शुक्लपक्षः प्रकीर्तितः ।\nपूर्णिमायाः प्रतिपदश्चामावास्यान्त एव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003160065, "chapter_id": 23160, "verse_number": "४-९६-६६", "content_sanskrit": "कृष्णपक्षस्तु विज्ञेयो वेदविद्भिर्निरूपितः ।\nद्वितीया च तृतीया च चतुर्थी पञ्चमी तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003160066, "chapter_id": 23160, "verse_number": "४-९६-६७", "content_sanskrit": "षष्ठी च सप्तमी चैव ह्यष्टमी नवमी तथा ।\nदशम्येकादशी चापि द्वादशी च त्रयोदशी ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003160067, "chapter_id": 23160, "verse_number": "४-९६-६८", "content_sanskrit": "चतुर्दशी कुहूर्यावद्दिनं तु गणनं स्मृतम् ।\nअस्विनी भरणी चापि कृत्तिका रोहिणी तथा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003160068, "chapter_id": 23160, "verse_number": "४-९६-६९", "content_sanskrit": "मृगशिरस्त्थाऽऽर्द्रा च नक्षत्रे द्वे पुनर्वसू ।\nपुष्याश्लेषे मघा चैव पूर्वा चोत्तरफाल्गुनी ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003160069, "chapter_id": 23160, "verse_number": "४-९६-७०", "content_sanskrit": "हस्तचित्रे तथा स्वाती विशाखा चानुराधिका ।\nज्येष्ठा मूलं तथा ज्ञेया पूर्वाषाढोत्तरा तथा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003160070, "chapter_id": 23160, "verse_number": "४-९६-७१", "content_sanskrit": "श्रवणाभिजिती चैव धनिष्ठा च प्रकीर्तिता ।\nततः शतभिषा ज्ञेय पूर्वाभाद्रपदा तथा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003160071, "chapter_id": 23160, "verse_number": "४-९६-७२", "content_sanskrit": "तथोत्तरा तु विज्ञेया रेवती चरमा स्मृता ।\nअष्टाविंशति नक्षत्रं कलत्रं शशिनस्तथा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003160072, "chapter_id": 23160, "verse_number": "४-९६-७३", "content_sanskrit": "क्रमेण ताभिः सार्ध च चन्द्रस्तिष्ठति नित्यशः ।\nसप्तविंशति नक्षत्रं कलत्रं च श्रुतौ श्रुतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003160073, "chapter_id": 23160, "verse_number": "४-९६-७४", "content_sanskrit": "अभिजिच्छूवणच्छाया तेनाष्टाविंशतिः स्मृता ।\nएकदा च मधौ चन्द्रो रोहिण्या वामया सह ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003160074, "chapter_id": 23160, "verse_number": "४-९६-७५", "content_sanskrit": "रेमे दिवानिशं नित्यं श्रवणा च चुकोप सा ।\nछायां च दत्त्वा चन्द्राय ययौ तातान्तिकं भिया ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003160075, "chapter_id": 23160, "verse_number": "४-९६-७६", "content_sanskrit": "ततः पितरमादाय सा चक्रे च विभागकम् ।\nबभूव तेन नक्षत्रमभिजिन्नामकं पुरा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003160076, "chapter_id": 23160, "verse_number": "४-९६-७७", "content_sanskrit": "एतच्छ्रुत्वा कृष्णमुखाच्छतश्रृङ्गे च पर्वते ।\nनक्षत्रं कथितं वत्स तिथ्या भ्रमति नित्यशः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003160077, "chapter_id": 23160, "verse_number": "४-९६-७८", "content_sanskrit": "योगं च करणं चैव मद्वक्त्रेण निशामय ।\nविष्कम्भः प्रीतिरायुष्मान्सौभाग्यः शोभनस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003160078, "chapter_id": 23160, "verse_number": "४-९६-७९", "content_sanskrit": "अतिगण्डः सुकर्मा च घृतिः शूलस्तथैव च ।\nगण्डो वृद्धिर्ध्रुवश्चैव व्याघातो हर्षणास्तथा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003160079, "chapter_id": 23160, "verse_number": "४-९६-८०", "content_sanskrit": "वज्रं सिद्धिर्व्यतीपातो वरीयान्परिघः शिवः ।\nसिद्धिः साध्यः शुभः शुक्लो ब्रह्मेन्द्रो वैधृतिस्तथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003160080, "chapter_id": 23160, "verse_number": "४-९६-८१", "content_sanskrit": "कीर्तितस्ते योगगणः करणं श्रूयतामिति ।\nबवश्च बालवश्चैव कौलवस्तैतिलस्तथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003160081, "chapter_id": 23160, "verse_number": "४-९६-८२", "content_sanskrit": "गरश्च वणिजश्चापि विष्टिश्च शकुनिस्तथा ।\nचतुष्पाच्चापि नागश्च किंस्तुघ्न इति कीर्तितम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003160082, "chapter_id": 23160, "verse_number": "४-९६-८३", "content_sanskrit": "नराणां चापि मासेन पितॄणां च दिवानिशम् ।\nशुक्ले चापि दिनं तेषां कृष्णे नक्तं प्रकीर्तितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003160083, "chapter_id": 23160, "verse_number": "४-९६-८४", "content_sanskrit": "वत्सरेण नाराणां च सुराणां च दिवानिशम् ।\nदिनं तेषामुत्तरे च नक्तं च दक्षिणायने ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003160084, "chapter_id": 23160, "verse_number": "४-९६-८५", "content_sanskrit": "मन्वन्तरं तु दिव्यानां युगानामेकसप्ततिः ।\nमनोरायुः परिमितं शक्रस्याऽऽयुः प्रकीर्तितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003160085, "chapter_id": 23160, "verse_number": "४-९६-८६", "content_sanskrit": "पञ्चविंशत्सहस्रं च तथा पञ्चशतं परम् ।\nतत्र सूर्यगतिर्नास्ति शक्रपातानुसारतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003160086, "chapter_id": 23160, "verse_number": "४-९६-८७", "content_sanskrit": "दिवानिशं च जानन्ति ब्रह्मलोकनिवासिनः ।\nदण्डद्वयं नरपलं शक्रपातेन तत्पलम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003160087, "chapter_id": 23160, "verse_number": "४-९६-८८", "content_sanskrit": "एवं त्रिशद्दिनेनैव धातुर्मासः प्रकीर्तितः ।\nअब्दो द्वादशभिर्मासैरेवं तस्य शतायुषः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003160088, "chapter_id": 23160, "verse_number": "४-९६-८९", "content_sanskrit": "ब्रह्मणः पतनेनैव निमेषाच्छ्रीहरेरपि ।\nधातुः पातानुसारेण वैकुण्ठे न दिवानिशम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003160089, "chapter_id": 23160, "verse_number": "४-९६-९०", "content_sanskrit": "तत्र सूर्यगतिर्नास्ति चैवं गोलोकतः स्मृतम् ।\nवैकुण्ठवासिनः सर्वे न वै जानन्त्यहर्निशम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003160090, "chapter_id": 23160, "verse_number": "४-९६-९१", "content_sanskrit": "चन्द्रस्यापि ग्रहाणां च गतिर्नास्ति च तत्र वै ।\nचक्रं नैव भ्रमत्येव राशीनामिच्छया हरेः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003160091, "chapter_id": 23160, "verse_number": "४-९६-९२", "content_sanskrit": "दिनं च तेजसा दीप्तं कृष्णस्य परमात्मनः ।\nनक्तं तेजोविहीनं च हरौ च मन्दिरं गते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003160092, "chapter_id": 23160, "verse_number": "४-९६-९३", "content_sanskrit": "एवं कालगतिस्तत्र विष्णुलोकेऽस्ति संततम् ।\nकालस्वरूपो भगवान्परमात्मा निराकृतिः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003160093, "chapter_id": 23160, "verse_number": "४-९६-९४", "content_sanskrit": "चन्द्रसूर्यगतिर्नास्चि पातालेषु च सप्तषु ।\n,द्वासिनश्च जानन्ति शङ्कन्ते न दिवानिशम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003160094, "chapter_id": 23160, "verse_number": "४-९६-९५", "content_sanskrit": "दिने च मूर्ध्निनागानां मणिर्ज्वलति नित्यशः ।\nसंध्यायां दीप्तमग्निश्च रात्रिश्च तमसाऽऽवृता ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003160095, "chapter_id": 23160, "verse_number": "४-९६-९६", "content_sanskrit": "कालं ताम्रीप्रमाणेन जानन्ति तन्निवासिनः ।\nयथा भुवि तथा तत्र परिमाणं प्रकीर्तितम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003160096, "chapter_id": 23160, "verse_number": "४-९६-९७", "content_sanskrit": "कृतं त्रेता द्वापरं च कलिश्चेति चतुर्युगम् ।\nदिव्यैर्द्वादशसाहस्रैर्वत्सरैश्चापि तन्मितम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003160097, "chapter_id": 23160, "verse_number": "४-९६-९८", "content_sanskrit": "अष्टौ शतान्यप्यधिकं सहस्राणां चतुष्टयम् ।\nदिव्यैर्वर्षैः कृतयुगं कालविद्भिर्निरूपितम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003160098, "chapter_id": 23160, "verse_number": "४-९६-९९", "content_sanskrit": "अष्टाविंशत्सहस्राण्यप्यधिकं परिमाणकम् ।\nलक्षाणां च सप्तदशं नृमानं परिकीन्तितम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003160099, "chapter_id": 23160, "verse_number": "४-९६-१००", "content_sanskrit": "अधिकं षट्शतान्येव सहस्राणां त्रयं तथा ।\nदिव्यैर्वर्षैश्च त्रेतेति वत्स कालविदो विदुः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003160100, "chapter_id": 23160, "verse_number": "४-९६-१०१", "content_sanskrit": "षण्णवतिसहस्राणि लक्षैर्द्वादशभिः सह ।\nनृणां वर्षैश्च त्रेतेति कालविद्भिः प्रकीर्तितः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003160101, "chapter_id": 23160, "verse_number": "४-९६-१०२", "content_sanskrit": "चतुष्टयं शतानां चाप्यधिकं द्विसहस्रकम् ।\nवर्ष दिव्यं द्वापरं च कालज्ञैः परिकीर्तितम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003160102, "chapter_id": 23160, "verse_number": "४-९६-१०३", "content_sanskrit": "चतुःषष्टिसहस्राणि लक्षैरष्टभिरेव च ।\nनृणां वर्षैर्द्वापरं च कालज्ञैः परिकीर्तितम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003160103, "chapter_id": 23160, "verse_number": "४-९६-१०४", "content_sanskrit": "अधिकं द्विशतं चैव दिव्यं वर्षसहस्रकम् ।\nएवंमितं कलियुगं वत्स प्राज्ञैर्निरूपितम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003160104, "chapter_id": 23160, "verse_number": "४-९६-१०५", "content_sanskrit": "द्वात्रिंशच्च सहस्रं च चतुर्लक्षं नृमानकम् ।\nवर्ष चेति कलियुगे चकार कालकोविदः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003160105, "chapter_id": 23160, "verse_number": "४-९६-१०६", "content_sanskrit": "लक्षैर्द्विचत्वारिंशद्भिः सह विंशत्सहस्रकैः ।\nनृमानवर्षैः कालज्ञैर्व्यक्तमेव चतुर्युगम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003160106, "chapter_id": 23160, "verse_number": "४-९६-१०७", "content_sanskrit": "इति ते कथितं वत्स कालसंख्यानिरूपणम् ।\nयथाश्रुतं यथाज्ञानं गच्छ वत्स हरेः पुरम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]