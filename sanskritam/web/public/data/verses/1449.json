[{"id": 2021750, "chapter_id": 1449, "verse_number": "३-८७-०x", "content_sanskrit": "धौम्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021751, "chapter_id": 1449, "verse_number": "३-८७-१", "content_sanskrit": "अवन्तीषु प्रतीच्यां वै कीर्तयिष्यामि ते दिशि।\nयानि तत्रपवित्राणि पुण्यान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021752, "chapter_id": 1449, "verse_number": "३-८७-२", "content_sanskrit": "प्रियङ्ग्वाम्रवणोपेता वानीरफलमालिनी।\nप्रत्यक्स्रोता नदी पुण्या नर्मदा तत्र भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021753, "chapter_id": 1449, "verse_number": "३-८७-३", "content_sanskrit": "त्रैलोक्ये यानि तीर्थानि पुण्यान्यायतनानि च।\nसरिद्वनानि शैलेन्द्रा देवाश्च सपितामहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021754, "chapter_id": 1449, "verse_number": "३-८७-४", "content_sanskrit": "नर्मदायां कुरुश्रेष्ठ सहसिद्धर्षिचारणैः।\nस्नातुमायान्ति पुण्यौधैः सदा वारिषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021755, "chapter_id": 1449, "verse_number": "३-८७-५", "content_sanskrit": "निरेतः श्रूयते पुण्यो यत्र विश्रवसो मुनेः।\nजज्ञे धनपतिर्यत्र कुबेरो नरवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021756, "chapter_id": 1449, "verse_number": "३-८७-६", "content_sanskrit": "वैढूर्यशिखरो नाम पुण्यो गिरिवरः शिवः।\nनित्यपुष्पफलास्तत्र पादपा हरितच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021757, "chapter_id": 1449, "verse_number": "३-८७-७", "content_sanskrit": "तस्य शैलस्य शिखरे सरः पुण्यं महीपते।\nफुल्लपद्मं महाराज देवगन्धर्वसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021758, "chapter_id": 1449, "verse_number": "३-८७-८", "content_sanskrit": "बह्वाश्चर्यं महाराज दृश्यते तत्र पर्वते।\nपुण्ये स्वर्गोपमे चैव देवर्षिगणसेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021759, "chapter_id": 1449, "verse_number": "३-८७-९", "content_sanskrit": "ह्रदिनी पुण्यतीर्था च राजर्षेस्तत्र वै सरित्।\nविश्चामित्रेण तपसा निर्मिता सर्वपावनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021760, "chapter_id": 1449, "verse_number": "३-८७-१०", "content_sanskrit": "यस्यास्तीरे सतां मध्ये ययातिर्नहुषात्मजः।\nपपात स पुनर्लोकाँल्लेभे धर्मान्सनातनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021761, "chapter_id": 1449, "verse_number": "३-८७-११", "content_sanskrit": "तत्रपुण्यो ह्रदः ख्यातो मैनाकश्चैव पर्वतः।\nबहुमूलफलोपेतस्त्वमितो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021762, "chapter_id": 1449, "verse_number": "३-८७-१२", "content_sanskrit": "आश्रमः कक्षसेनस्य पुण्यस्तत्रयुधिष्ठिरः।\nच्यवनस्याश्रमश्चैव विख्यातस्तत्रपाण्डव।\nतत्राल्पेनैव सिद्ध्यन्ति मानवास्तपसा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021763, "chapter_id": 1449, "verse_number": "३-८७-१३", "content_sanskrit": "जम्बूमार्गो महाराज ऋषीणां भावितात्मनाम्।\nआश्रम शाम्यतां श्रेष्ठ मृगद्विजनिषेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021764, "chapter_id": 1449, "verse_number": "३-८७-१४", "content_sanskrit": "ततः पुण्यतमा राजन्सततं तापसैर्युता।\nकेतुमाला च मेध्या च गङ्गाद्वारं च भूमिप।\nख्यातं च सैन्धवारण्यं पुण्यं द्विजनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021765, "chapter_id": 1449, "verse_number": "३-८७-१५", "content_sanskrit": "पितामहसरः पुण्यं पुष्करं नाम नामतः।\nवैखानसानां सिद्धानामृषीणामाश्रमः प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021766, "chapter_id": 1449, "verse_number": "३-८७-१६", "content_sanskrit": "अप्यत्र संश्रयार्थाय प्रजापतिरथो जगौ।\nपुष्करेषु कुरुश्रेष्ठ गाथां सुकृतिनांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021767, "chapter_id": 1449, "verse_number": "३-८७-१७", "content_sanskrit": "मनसाऽप्यभिकामस्य पुष्कराणि मनखिनः।\nविप्रणश्यन्ति पापानि नाकपृष्ठे च मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021768, "chapter_id": 1449, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणइ सप्ताशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]