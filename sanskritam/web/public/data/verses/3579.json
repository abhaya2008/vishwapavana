[{"id": 2120014, "chapter_id": 3579, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120015, "chapter_id": 3579, "verse_number": "१", "content_sanskrit": "पतितौ हंसडिभकौ कंसामात्यौ निपातितौ ।\nजरासन्धस्य निधने कालोऽयं समुपागतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120016, "chapter_id": 3579, "verse_number": "२", "content_sanskrit": "न स शक्यो रणे जेतुं सर्वैरपि सुरासुरैः ।\nबाहुयुद्धेन जेतव्यः स इत्युपलभामहे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120017, "chapter_id": 3579, "verse_number": "३", "content_sanskrit": "मयि नीतिर्बलं भीमे रक्षिता चावयोर्जयः ।\nसाधयिष्याम तं राजन् वयं त्रय इवाग्नयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120018, "chapter_id": 3579, "verse_number": "४", "content_sanskrit": "त्रिभिरासादितोऽस्माभिः विजने स नराधिपः ।\nन सन्देहो यथा युद्धमेकेनाभ्युपगच्छति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120019, "chapter_id": 3579, "verse_number": "५", "content_sanskrit": "अवमानाच्च लोकस्य व्यायामाच्चैव हर्षितः ।\nभीमेन सह युद्धाय ध्रुवमभ्युपयास्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120020, "chapter_id": 3579, "verse_number": "६", "content_sanskrit": "अलं तस्य महाबाहुः भीमसेनो महाबलः ।\nलोकस्य समुदीर्णस्य निधनायान्तको यथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120021, "chapter_id": 3579, "verse_number": "७", "content_sanskrit": "यदि ते हृदयं वेत्ति यदि ते प्रत्ययो मयि ।\nभीमसेनार्जुनौ शीघ्रं न्यासभूतौ प्रयच्छ मे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120022, "chapter_id": 3579, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120023, "chapter_id": 3579, "verse_number": "८", "content_sanskrit": "एवमुक्तो भगवता प्रत्युवाच युधिष्ठिरः ।\nभीमपार्थौ समालोक्य सम्प्रहृष्टमुखौ स्थितौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120024, "chapter_id": 3579, "verse_number": "९", "content_sanskrit": "अच्युताच्युत मा मैवं व्याहरामित्रकर्शन ।\nपाण्डवानां भवान् नाथो भवन्तं चाश्रिता वयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120025, "chapter_id": 3579, "verse_number": "१०", "content_sanskrit": "यथा वदसि गोविन्द तथा तदुपपद्यते ।\nनहि त्वदग्रतस्तेषां येषां लक्ष्मीः पराङ्मुखी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120026, "chapter_id": 3579, "verse_number": "११", "content_sanskrit": "निहतश्च जरासन्धो मोक्षिताश्च महीक्षितः ।\nराजसूयश्च मे लब्धो निदेशे तव तिष्ठतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120027, "chapter_id": 3579, "verse_number": "१२", "content_sanskrit": "क्षिप्रकारिन् यथा त्वेतत् कार्यं समुपपद्यते ।\nमम कार्यं जगत्कार्यं तथा कुरु नरोत्तम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120028, "chapter_id": 3579, "verse_number": "१३", "content_sanskrit": "त्रिभिर्भवद्भिर्हि विना नाहं जीवितुमुत्सहे ।\nधर्मकामार्थरहितो रोगार्त इव दुर्गतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120029, "chapter_id": 3579, "verse_number": "१४", "content_sanskrit": "न शौरिणा विना पार्थो न शौरिः पाण्डवं विना ।\nनाजेयोऽस्त्यनयोर्लोके कृष्णयोरिति मे मतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120030, "chapter_id": 3579, "verse_number": "१५", "content_sanskrit": "अयं च बलिनां श्रेष्ठः श्रीमानपि वृकोदरः ।\nयुवाभ्यां सहितो वीरः किं न कुर्यात् महायशाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120031, "chapter_id": 3579, "verse_number": "१६", "content_sanskrit": "सुप्रणीतबलो यो हि कुरुते कार्यमुत्तमम् ।\nअन्धं जडं बलं प्राहुः प्रणीतमविचक्षणैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120032, "chapter_id": 3579, "verse_number": "१७", "content_sanskrit": "यतो हि निम्नं भवति नयतीह ततो जलम् ।\nयतश्छिद्रं ततश्चापि नयन्ति विदुषो बलम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120033, "chapter_id": 3579, "verse_number": "१८", "content_sanskrit": "वयमाश्रित्य गोविन्दं यतामः कार्यसिद्धये ।\nतस्मात् नयविधानज्ञं पुरुषं लोकविश्रुतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120034, "chapter_id": 3579, "verse_number": "१९", "content_sanskrit": "एवं प्रज्ञानयबलं क्रियोपायविशारदम् ।\nपुरस्कुर्वन्ति कार्येषु कृष्ण कार्यार्थसिद्धये\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120035, "chapter_id": 3579, "verse_number": "२०", "content_sanskrit": "एवमेव यदुश्रेष्ठ पार्थकार्यार्थसिद्धये ।\nअर्जुनः कृष्णमन्वेतु भीमोऽन्वेतु धनञ्जयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120036, "chapter_id": 3579, "verse_number": "२१", "content_sanskrit": "नयो जयो बलं चैव विक्रमाद् वृद्धिमेष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120037, "chapter_id": 3579, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120038, "chapter_id": 3579, "verse_number": "२२", "content_sanskrit": "एवमुक्तास्ततः सर्वे भ्रातरौ विपुलौजसौ ।\nवार्ष्णेयः पाण्डवेयौ च प्रतस्थुर्मागधान् प्रति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120039, "chapter_id": 3579, "verse_number": "२३", "content_sanskrit": "वर्षास्विनां ब्राह्मणानां स्नातकानां परिच्छदैः ।\nआच्छाद्य सुहृदां वाक्यैर्मनोज्ञैरभिनन्दिताः ।\nमाधवः पाण्डवेयौ च प्रतस्थुर्व्रतधारिणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120040, "chapter_id": 3579, "verse_number": "२४", "content_sanskrit": "अमर्षादभितप्तानां ज्ञात्यर्थं मुख्यतेजसाम् ।\nरविसोमाग्निवपुषां भीममासीत् तदा वपुः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120041, "chapter_id": 3579, "verse_number": "२५", "content_sanskrit": "हतं मेने जरासन्धं राजा भीमपुरोगमौ ।\nएककार्ये समुद्युक्तौ दृष्ट्वा कृष्णधनञ्जयौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120042, "chapter_id": 3579, "verse_number": "२६", "content_sanskrit": "ईशौ हि तौ महात्मानौ सर्वकार्यप्रवर्तिनौ ।\nधर्मार्थौ काममोक्षाणां कार्याणामिव निग्रहे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120043, "chapter_id": 3579, "verse_number": "२७", "content_sanskrit": "कुरुभ्यः प्रस्थितास्ते तु मध्येन कुरुजाङ्गलम् ।\nरम्यं पद्मसरो गत्वा कालकूटमतीत्य च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120044, "chapter_id": 3579, "verse_number": "२८", "content_sanskrit": "सन्तीर्य सरयूं रम्यां दृष्ट्वा पूर्वांश्च कोसलान् ।\nगण्डकीमनुरागां च सदानीरां तथैव च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120045, "chapter_id": 3579, "verse_number": "२९", "content_sanskrit": "एकपर्वतके नद्यः क्रमेणातिव्रजन्ति ते ।\nअतीत्य मिथिलां जग्मुः पश्यन्तो विपुला नदीः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120046, "chapter_id": 3579, "verse_number": "३०", "content_sanskrit": "उत्तीर्य गङ्गां शोणां च सर्वे ते प्राङ्मुखास्त्रयः ।\nरम्यं जनपदं स्फीतं मागधं जग्मुरच्युताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120047, "chapter_id": 3579, "verse_number": "३१", "content_sanskrit": "देशं च गोधनाकीर्णं मधुमन्तं शुभद्रुमम् ।\nगोरथं गिरिमारुह्य ददृशुर्मागधं पुरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120048, "chapter_id": 3579, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकविंशोऽध्यायः ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120049, "chapter_id": 3579, "verse_number": "१", "content_sanskrit": "जरासन्धवधपर्वणि प्रथमोऽध्यायः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120050, "chapter_id": 3579, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]