[{"id": 7004944000, "chapter_id": 24944, "verse_number": "७-१-१२७-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि क्षेमेश्वरमनुत्तमम् ।\nतस्मादुत्तरकोणस्थं कपालेशाग्निगोचरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004944001, "chapter_id": 24944, "verse_number": "७-१-१२७-२", "content_sanskrit": "धनुषां पंचदशके कपालेश्वरतः स्थितम् ।\nलिंगं महाप्रभावं हि सर्वपातकनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004944002, "chapter_id": 24944, "verse_number": "७-१-१२७-३", "content_sanskrit": "क्षेममूर्तिः पुरा राजा बभूव स महाबलः ।\nतेन तत्र तपस्तप्तं चिरकालं महात्मना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004944003, "chapter_id": 24944, "verse_number": "७-१-१२७-४", "content_sanskrit": "ततः संस्थापितं लिंगं भक्त्या भावितचेतसा ।\nतद्दृष्ट्वा क्षेममायाति कार्यं क्षेमेण सिद्ध्यति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004944004, "chapter_id": 24944, "verse_number": "७-१-१२७-५", "content_sanskrit": "सर्वकामसमृद्धात्मा भूया ज्जन्मनिजन्मनि ।\nएवं क्षेमेश्वरं लिंगं ख्यातं पातकनाशनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004944005, "chapter_id": 24944, "verse_number": "७-१-१२७-६", "content_sanskrit": "सर्वकामप्रदं नृणां श्रुतं सौभाग्यदायकम् ।\nदर्शनेनापि तस्यापि गोशतस्य फलं स्मृतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004944006, "chapter_id": 24944, "verse_number": "७-१-१२७-७", "content_sanskrit": "तस्मात्क्षेत्रफलाकांक्षी नित्यं तल्लिंगमाश्रयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004944007, "chapter_id": 24944, "verse_number": "७-१-१२७-८", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये क्षेमंकरेश्वरमाहात्म्यवर्णनंनाम सप्तविंशत्युत्तरशततमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]