[{"id": 2115879, "chapter_id": 3494, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115880, "chapter_id": 3494, "verse_number": "१", "content_sanskrit": "कारणं ब्रूहि गन्धर्व किं तद् येनाद्य धर्षिताः ।\nयत् तद् ब्रह्मविदः सन्तः सर्वे रात्रावरिन्दमाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115881, "chapter_id": 3494, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115882, "chapter_id": 3494, "verse_number": "२", "content_sanskrit": "अनग्रयोऽनाहुतयो न च विप्रपुरस्कृताः ।\nधर्षिताः स्थ ततो यूयं मया पाण्डवनन्दन \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115883, "chapter_id": 3494, "verse_number": "३", "content_sanskrit": "यक्षराक्षसगन्धर्वपिशाचोरगपन्नगाः ।\nधर्षयन्ति नरव्याघ्र नब्राह्मणपुरस्कृतान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115884, "chapter_id": 3494, "verse_number": "४", "content_sanskrit": "जानता च मया तस्मात् तेजश्चाभिजनं च वः ।\nइयं मतिमतां श्रेष्ठ धर्षितुं वै कृता मतिः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115885, "chapter_id": 3494, "verse_number": "५", "content_sanskrit": "को हि वस्त्रिषु लोकेषु न वेद भरतर्षभ ।\nस्वैर्गुणैर्विस्तृतं श्रीमद् यशोऽग्य्रं भूरिवर्चसाम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115886, "chapter_id": 3494, "verse_number": "६", "content_sanskrit": "यक्षराक्षसगन्धर्वाः पिशाचोरगपन्नगाः ।\nविस्तारं कुरुवंशस्य श्रीमन्तः कथयन्ति ते \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115887, "chapter_id": 3494, "verse_number": "७", "content_sanskrit": "नारदप्रभृतीनां च महर्षीणां मया पुरा ।\nश्रुतं कथयतां पार्थ कुरूणां वंशमादितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115888, "chapter_id": 3494, "verse_number": "८", "content_sanskrit": "स्वयं चापि मया दृष्टश्चरता सागराम्बराम् ।\nइमां वसुमतीं कृत्स्नां प्रभावः सुकुलस्य च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115889, "chapter_id": 3494, "verse_number": "९", "content_sanskrit": "वेदे धनुषि चाचार्यमभिजानामि चार्जुन ।\nविश्रुतं त्रिषु लोकेषु भारद्वाजं यशस्विनम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115890, "chapter_id": 3494, "verse_number": "१०", "content_sanskrit": "सर्ववेदविदां श्रेष्ठं सर्वशस्त्रभृतां वरम् ।\nद्रोणमिष्वस्त्रकुशलं धनुष्यङ्गिरसां वरम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115891, "chapter_id": 3494, "verse_number": "११", "content_sanskrit": "धर्मं वायुं च शक्रं च विजानाम्यश्विनावपि ।\nपाण्डुं च नृपशार्दूलं षडेतान् कुलवर्धनान् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115892, "chapter_id": 3494, "verse_number": "१२", "content_sanskrit": "पुत्रानेतानहं पार्थ देवमानुषसत्तमान् ।\nदिव्यात्मानो महात्मानः सर्वशस्त्रभृतां वराः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115893, "chapter_id": 3494, "verse_number": "१३", "content_sanskrit": "भवन्तो भ्रातरः सर्वे शूराश्च चरितव्रताः ।\nउत्तमां तु मनोवृत्तिं भवतां भावितात्मनाम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115894, "chapter_id": 3494, "verse_number": "१४", "content_sanskrit": "जानन्नपि च वः पार्थ कृतवानिह धर्षणाम् ।\nस्त्रीसकाशे च कौरव्य न पुमान् क्षन्तुमर्हति \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115895, "chapter_id": 3494, "verse_number": "१५", "content_sanskrit": "धर्षणामात्मनः पश्यन् बाहुद्रविणमात्मनः ।\nनक्तं च बलमस्माकं भूय एवाभिवर्धते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115896, "chapter_id": 3494, "verse_number": "१६", "content_sanskrit": "यतस्ततो मां कौन्तेय सदारं मन्युराविशत् ।\nसोऽहं त्वयेह विजितः सङ्खे तापत्यनन्दन \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115897, "chapter_id": 3494, "verse_number": "१७", "content_sanskrit": "केनेह विधिना सर्वं कीर्त्यमानं निबोध मे ।\nब्रह्मचर्यं परो धर्मः स चापि नियतस्त्वयि \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115898, "chapter_id": 3494, "verse_number": "१८", "content_sanskrit": "यस्मादस्मादहं पार्थ रणेऽस्मिन् विजितस्त्वया ।\nयस्तु स्यात् क्षत्रियः कश्चित् कामवृत्तः परन्तप \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115899, "chapter_id": 3494, "verse_number": "१८", "content_sanskrit": "नक्तं च युधि युध्येत न स जीवेत् कथञ्चन ।\nयस्तु स्यात् कामवृत्तोऽपि राजा राजीवलोचन \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115900, "chapter_id": 3494, "verse_number": "१९", "content_sanskrit": "जयेन्नक्तञ्चरान् सर्वान् स पुरोहितधूर्गतः ।\nतस्मात् तापत्य यत् किञ्चिन्नृणां श्रेय इहेप्सितम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115901, "chapter_id": 3494, "verse_number": "२०", "content_sanskrit": "तस्मिन् कर्मणि योक्तव्या दान्तात्मानः पुरोहिताः ।\nवेदे षडङ्गे नियताः शुचयः सत्यवादिनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115902, "chapter_id": 3494, "verse_number": "२१", "content_sanskrit": "धर्मात्मानः कृतात्मानः स्युर्नृपस्य पुरोहिताः ।\nजयश्च नियतो राज्ञः स्वर्गश्च स्यादनन्तरम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115903, "chapter_id": 3494, "verse_number": "२२", "content_sanskrit": "यस्य स्याद् धर्मविद् वाग्मी पुरोधाः शीलवान् शुचिः ।\nअलब्धस्य च लाभाय लब्धस्य परिरक्षणे \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115904, "chapter_id": 3494, "verse_number": "२३", "content_sanskrit": "पुरोहितं प्रकुर्वीत राजा गुणसमन्वितम् ।\nपुरोहितमते तिष्ठेद् य इच्छेत् पृथिवीं नृपः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115905, "chapter_id": 3494, "verse_number": "२४", "content_sanskrit": "प्राप्तुं मेरुवरोत्तंसां सागराम्बरधारिणीम् ।\nन हि केवलशौर्येण तापत्याभिजनेन च \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115906, "chapter_id": 3494, "verse_number": "२५", "content_sanskrit": "जयेदब्राह्मणः कश्चिद् भुवि भूमिपतिः क्वचित् ।\nतस्मादेवं विजानीहि कुरूणां कीर्तिवर्धन ।\nब्राह्मणप्रमुखं राज्यं शक्यं पालयितुं चिरम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115907, "chapter_id": 3494, "verse_number": "६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रिसप्तत्यधिकशततमोऽध्यायः ॥१७३॥ ॥ इति चैत्ररथपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115908, "chapter_id": 3494, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]