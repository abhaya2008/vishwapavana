[{"id": 2116620, "chapter_id": 3510, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116621, "chapter_id": 3510, "verse_number": "१", "content_sanskrit": "अजिनान्यवधुन्वन्तः करकांश्च द्विजर्षभाः ।\nऊचुस्ते भीर्न कर्तव्या वयं योत्स्यामहे रिपून् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116622, "chapter_id": 3510, "verse_number": "२", "content_sanskrit": "तानेवं वदतो विप्रानर्जुनः प्रहसन्निव ।\nउवाच प्रेक्षका भूत्वा यूयं तिष्ठत पार्श्वतः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116623, "chapter_id": 3510, "verse_number": "३", "content_sanskrit": "अहमेनानजिह्माग्रैः शतशो विकिरञ्छरैः ।\nवारयिष्यामि सङ्क्रुद्धान् मन्त्रैराशीविषानिव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116624, "chapter_id": 3510, "verse_number": "४", "content_sanskrit": "इत्युक्त्वा धनुरादाय शुल्कावाप्तमहारथः ।\nभ्रात्रा भीमेन सहितः तस्थौ गिरिरिवाचलः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116625, "chapter_id": 3510, "verse_number": "५", "content_sanskrit": "ततः कर्णमुखान् क्रुद्धान् क्षत्रियान् समुपस्थितान् ।\nआसेदतुरुभौ पार्थौ गजौ प्रतिगजानिव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116626, "chapter_id": 3510, "verse_number": "६", "content_sanskrit": "ऊचुश्च वाचः परुषाः ते राजानो युयुत्सवः ।\nआहवेषु द्विजस्यापि वधो दृष्टो युयुत्सतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116627, "chapter_id": 3510, "verse_number": "७", "content_sanskrit": "ततो वैकर्तनः कर्णो जगामार्जुनमोजसा ।\nयुद्धार्थी वासिताहेतोर्गजः प्रतिगजं यथा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116628, "chapter_id": 3510, "verse_number": "८", "content_sanskrit": "भीमसेनं ययौ राजा मद्राणामीश्वरो बली ।\nदुर्योधनादयः सर्वे ब्राह्मणैः सह सङ्गताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116629, "chapter_id": 3510, "verse_number": "९", "content_sanskrit": "मृदुपूर्वमयत्नेन प्रत्ययुध्यंस्तदाऽऽहवे ।\nततोऽर्जुनः प्रत्यविध्यत् तापयंस्तं त्रिभिः शरैः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116630, "chapter_id": 3510, "verse_number": "१०", "content_sanskrit": "कर्णं वैकर्तनं धीमान् विकृष्य बलवद् धनुः ।\nबलेन सुव्यवच्छिन्नैरवार्यं तमवारयत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116631, "chapter_id": 3510, "verse_number": "११", "content_sanskrit": "तेषां शराणां वेगेन शितानां तिग्मतेजसाम् ।\nविमोह्यमानो राधेयो यत्नात् तमनुधावति \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116632, "chapter_id": 3510, "verse_number": "१२", "content_sanskrit": "तावुभावप्यनिर्देश्यौ लाघवाज्जयतां वरौ ।\nअयुध्येतां सुसङ्क्रुद्धावन्योन्यं विजयैषिणौ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116633, "chapter_id": 3510, "verse_number": "१३", "content_sanskrit": "कृते प्रतिकृतं पश्य पश्य बाहुबलं च मे ।\nइति शूरौ स्ववचनैरभाषेतां परस्परम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116634, "chapter_id": 3510, "verse_number": "१४", "content_sanskrit": "ततोऽर्जुनस्य भुजयोर्वीर्यमप्रतिमं भुवि ।\nज्ञात्वा वैकर्तनः कर्णः संरब्धः समयोधयत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116635, "chapter_id": 3510, "verse_number": "१५", "content_sanskrit": "अर्जुनेन प्रयुक्तांस्तान् बाणान् वेगवतस्तथा ।\nप्रतिहत्य ननादोच्चैः सैन्यास्तमभिपूजयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116636, "chapter_id": 3510, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116637, "chapter_id": 3510, "verse_number": "१६", "content_sanskrit": "तुष्यामि ते विप्रमुख्य भुजवीर्यस्य संयुगे ।\nअविषादस्य चैवास्य शस्त्रास्त्रविषयस्य च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116638, "chapter_id": 3510, "verse_number": "१७", "content_sanskrit": "त्वं धनुर्वेदः किं साक्षात् रामो वा विप्रसत्तमः ।\nअथ साक्षाद्धरिहयः साक्षाद्वा विष्णुरव्ययः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116639, "chapter_id": 3510, "verse_number": "१८", "content_sanskrit": "आत्मप्रच्छादनार्थं वै बाहुवीर्यमुपाश्रितः ।\nविप्ररूपं विधायेदं ततो मां प्रतियुध्यसे \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116640, "chapter_id": 3510, "verse_number": "१९", "content_sanskrit": "न हि मामाहवे क्रुद्धमन्यः साक्षाच्छचीपतेः ।\nपुमान् योधयितुं शक्तः पाण्डवाद्वा किरीटिनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116641, "chapter_id": 3510, "verse_number": "२०", "content_sanskrit": "त्वामासाद्य महाबाहो बलं मे प्रतिहन्यते ।\nदग्धा जतुगृहे सर्वे पाण्डवाः सार्जुनास्तदा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116642, "chapter_id": 3510, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116643, "chapter_id": 3510, "verse_number": "२१", "content_sanskrit": "इत्युवाचार्जुनमिदं प्रत्याहन्तुमशक्रुवन् ।\nतमेवंवादिनं तत्र प्रत्युवाचाथ फल्गुनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116644, "chapter_id": 3510, "verse_number": "२२", "content_sanskrit": "नास्मि कर्ण धनुर्वेदो नास्मि रामः प्रतापवान् ।\nनाहं विष्णुर्न शक्रोऽहं कश्चिदन्यो बलान्वितः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116645, "chapter_id": 3510, "verse_number": "२३", "content_sanskrit": "ब्राह्मणोऽस्मि युधां श्रेष्ठः सर्वशस्त्रभृतां वरः ।\nब्राह्मे चास्त्रे च वेदे च निष्ठितो गुरुशासनात् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116646, "chapter_id": 3510, "verse_number": "२४", "content_sanskrit": "स्थितोऽस्म्यथ रणे जेतुं त्वां वीर विचलो भव ।\nनिर्जितोऽस्मीति वा ब्रूहि ततो व्रज यथासुखम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116647, "chapter_id": 3510, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116648, "chapter_id": 3510, "verse_number": "२५", "content_sanskrit": "एवमुक्त्वा तु कर्णस्य धनुर्ज्यामथ सोऽच्छिनत् ।\nततः कर्णविनाशाय सन्दधे शरमर्जुनः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116649, "chapter_id": 3510, "verse_number": "२६", "content_sanskrit": "जितोऽस्मीत्यब्रवीत् कर्णः सञ्जहार ततोऽर्जुनः ।\nयुद्धायोपगतौ तत्र राजन् शल्यवृकोदरौ \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116650, "chapter_id": 3510, "verse_number": "२७", "content_sanskrit": "बलिनौ युगपन्मत्तौ स्पर्धया च बलेन च ।\nअन्योन्यमाह्वयन्तौ तौ मत्ताविव महागजौ \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116651, "chapter_id": 3510, "verse_number": "२८", "content_sanskrit": "मुष्टिभिर्जानुभिश्चैव निघ्नन्तावितरेतरम् ।\nमुहूर्तं तावथान्योन्यं बाहुभ्यामपकर्षताम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116652, "chapter_id": 3510, "verse_number": "२९", "content_sanskrit": "ततो भीमः समुत्क्षिप्य बाहुभ्यां शल्यमाहवे ।\nनावधीद् बलिनां श्रेष्ठो जहसुर्ब्राह्मणास्तदा \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116653, "chapter_id": 3510, "verse_number": "३०", "content_sanskrit": "ततो राजसमूहस्य सङ्क्रुद्धो वृक्षमारुजत् ।\nततस्तु भीमं सञ्ज्ञाभिर्वारयामास धर्मराट् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116654, "chapter_id": 3510, "verse_number": "३१", "content_sanskrit": "आकारज्ञस्ततो भ्रातुः पाण्डवोऽपि न्यवर्तत ।\nधर्मराजश्च कौरव्य दुर्योधनममर्षिणम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116655, "chapter_id": 3510, "verse_number": "३२", "content_sanskrit": "ब्रह्मरूपप्रतिच्छन्नो राजानं समयोधयत् ।\nभुजयोरन्तरेऽविध्यद् बाणेनानतपर्वणा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116656, "chapter_id": 3510, "verse_number": "३३", "content_sanskrit": "दुर्योधनममित्रघ्नं धर्मराजो युधिष्ठिरः ।\nततो दुर्योधनः क्रुद्धो दण्डाहत इवोरगः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116657, "chapter_id": 3510, "verse_number": "३४", "content_sanskrit": "प्रत्यविध्यत राजानं यत्नं परममास्थितः ।\nछित्त्वा राजा धनुर्ज्यां तु धार्तराष्ट्रस्य संयुगे \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116658, "chapter_id": 3510, "verse_number": "३५", "content_sanskrit": "नाराचेन सुतीक्ष्णेन कायावरणभेदिना ।\nहृदि विव्याध भूयोऽस्य बाह्वोरुरसि चार्पयत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116659, "chapter_id": 3510, "verse_number": "३६", "content_sanskrit": "अभ्यवर्षच्छरौघैस्तं स हित्वा प्राद्रवद्रणात् ।\nदुश्शासनस्तु सङ्क्रुद्धः सहदेवेन सङ्गतः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116660, "chapter_id": 3510, "verse_number": "३७", "content_sanskrit": "युध्वा च सुचिरं कालं धनुषा स महारथः ।\nउत्सृज्य च धनुः सङ्खे बाहुभ्यामेव कौरव \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116661, "chapter_id": 3510, "verse_number": "३८", "content_sanskrit": "पाण्डवं त्वभिदुद्राव सोऽसिं जग्राह चर्म च ।\nविकर्णचित्रसेनाभ्यां निगृहीतश्च कौरवः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2116662, "chapter_id": 3510, "verse_number": "३९", "content_sanskrit": "दुस्सहो नकुलश्चापि युद्धं कर्तुं समुद्यतौ ।\nतौ दृष्ट्वा कौरवा युद्धं वाक्यमूचुर्महाबलौ \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2116663, "chapter_id": 3510, "verse_number": "४०", "content_sanskrit": "निवर्तन्तां भवन्तो वै कुतो विप्रेषु विग्रहः ।\nन चेमे केवलं विप्रा न चैषां मानुषं बलम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2116664, "chapter_id": 3510, "verse_number": "४१", "content_sanskrit": "द्वावत्र ब्राह्मणौ क्रूरौ वाय्वग्निसदृशौ बले ।\nये वा के वा नमस्तेभ्यो गच्छामः स्वपुरं वयम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2116665, "chapter_id": 3510, "verse_number": "४२", "content_sanskrit": "एवं सम्भाष्य ते वीरा विनिवर्तन्त कौरवाः ।\nजहसुर्ब्राह्मणास्तत्र समेता राजमण्डले \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2116666, "chapter_id": 3510, "verse_number": "४३", "content_sanskrit": "ते प्रयातास्ततस्तत्र क्षत्रिया रणमूर्धनि ।\nब्राह्मणाश्च जयं प्राप्य कन्यामादाय निर्ययुः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2116667, "chapter_id": 3510, "verse_number": "४४", "content_sanskrit": "पातिते भीमसेनेन शल्ये कर्णे च निर्जिते ।\nदुर्योधने चापगते तथा दुश्शासने रणात् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2116668, "chapter_id": 3510, "verse_number": "४५", "content_sanskrit": "शङ्किताः सर्वराजानः समरे चातिमानुषे ।\nऊचुश्च सहितास्तत्र साध्विमे ब्राह्मणर्षभाः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2116669, "chapter_id": 3510, "verse_number": "४६", "content_sanskrit": "विज्ञायन्तां क्वजन्मानः क्वनिवासास्तथैव च ।\nको हि राधासुतं कर्णं शक्तो वारयितुं रणे \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2116670, "chapter_id": 3510, "verse_number": "४७", "content_sanskrit": "तथैव मद्रराजानं शल्यं बलवतां वरम् ।\nबलदेवादृते वीरात् कृपाद्वापि शरद्वतः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2116671, "chapter_id": 3510, "verse_number": "४८", "content_sanskrit": "कृष्णाद् वा देवकीपुत्रात् फल्गुनाद् वा परन्तपात् ।\nक्रियतामपहारोऽस्माद् युद्धाद् ब्राह्मणसंयुतात् ।\nतथैनानुपलभ्येह पुनर्योत्स्यामहे वयम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2116672, "chapter_id": 3510, "verse_number": "४९", "content_sanskrit": "तत्कर्म भीमस्य समीक्ष्य कृष्णः\nकुन्तीसुतौ तौ परिशङ्कमानः ।\nनिवारयामास महीपतींस्तान्\nधर्मेण लब्धेत्यनुनीय सर्वान् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2116673, "chapter_id": 3510, "verse_number": "५०", "content_sanskrit": "एवं ते सन्निरुद्धास्तु युद्धाद् युद्धविशारदाः ।\nयथावासं ययुः सर्वे विस्मिता राजसत्तम \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2116674, "chapter_id": 3510, "verse_number": "५१", "content_sanskrit": "वृत्तो ब्रह्मोत्तरो रङ्गः पाञ्चाली ब्राह्मणैर्हृता ।\nइति ब्रुवन्तः प्रययुर्ये तत्रासन् समागताः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2116675, "chapter_id": 3510, "verse_number": "५२", "content_sanskrit": "ब्राह्मणैश्च प्रतिच्छन्नौ रौरवाजिनवासिभिः ।\nकृच्छ्रेण जग्मतुस्तत्र भीमसेनधनञ्जयौ \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2116676, "chapter_id": 3510, "verse_number": "५३", "content_sanskrit": "विमुक्तौ जनसम्बाधाच्छत्रुभिः परिवीक्षितौ ।\nकृष्णयाऽनुगतौ तत्र नृवीरौ हि विचेरतुः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2116677, "chapter_id": 3510, "verse_number": "५४", "content_sanskrit": "तेषां माता बहुविधं विनाशं पर्यचिन्तयत् ।\nअनागच्छत्सु पुत्रेषु भैक्षकालेऽभिगच्छति \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2116678, "chapter_id": 3510, "verse_number": "५५", "content_sanskrit": "धार्तराष्ट्रैर्हता नूनं विज्ञाय कुरुपुङ्गवाः ।\nमायान्वितैर्वा रक्षोभिः सुघोरैर्दृढवैरिभिः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2116679, "chapter_id": 3510, "verse_number": "५६", "content_sanskrit": "विपरीतं मतं जातं व्यासस्यापि महात्मनः ।\nइत्येवं चिन्तयामास सुतस्नेहान्विता पृथा \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2116680, "chapter_id": 3510, "verse_number": "५७", "content_sanskrit": "ततो भुक्तजनप्राये घनैः सूर्य इवावृतः ।\nब्राह्मणैः प्राविशत् तत्र जिष्णुर्धर्मपुरस्कृतः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2116681, "chapter_id": 3510, "verse_number": "१८९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोननवत्यधिकशततमोऽध्यायः ॥१८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2116682, "chapter_id": 3510, "verse_number": "६", "content_sanskrit": "॥ इति स्वयंवरपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2116683, "chapter_id": 3510, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]