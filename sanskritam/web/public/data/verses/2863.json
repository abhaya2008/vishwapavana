[{"id": 2087723, "chapter_id": 2863, "verse_number": "१२-३६८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087724, "chapter_id": 2863, "verse_number": "१२-३६८-१", "content_sanskrit": "अथ तेन नरश्रेष्ठ ब्राह्मणेन तपस्विना।\nनिराहारेण वसता दुःखितास्ते भुजङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087725, "chapter_id": 2863, "verse_number": "१२-३६८-२", "content_sanskrit": "सर्वे संभूय सहिता ह्यस्य नावस्य बान्धवाः।\nभ्रातरस्तनया भार्या ययुस्तं ब्राह्मणं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087726, "chapter_id": 2863, "verse_number": "१२-३६८-३", "content_sanskrit": "तेऽपश्यन्पुलिने तं वै विविक्ते नियतव्रतम्।\nसमासीनं निराहारं द्विजं जप्यपरायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087727, "chapter_id": 2863, "verse_number": "१२-३६८-४", "content_sanskrit": "ते सर्वे समभिक्रम्य विप्रमभ्यर्च्य चासकृत्।\nऊचुर्वाक्यमसंदिग्धमातिथेयस्य बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087728, "chapter_id": 2863, "verse_number": "१२-३६८-५", "content_sanskrit": "षष्ठो हि दिवसस्तेऽद्य प्राप्तस्येह तपोधन।\nन चाभिभाषसे किंचिदाहारं धर्मवत्सल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087729, "chapter_id": 2863, "verse_number": "१२-३६८-६", "content_sanskrit": "आमानभिगतश्चासि वयं च त्वामुपस्थिताः।\nकार्यं चातिथ्यमस्माभिरीप्सितं तव ऋद्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087730, "chapter_id": 2863, "verse_number": "१२-३६८-७", "content_sanskrit": "मूलं फलं वा पर्णं वा पयो वा द्विजसत्तम।\nआहारहेतोरन्नं वा भोक्तुमर्हसि ब्राह्मण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087731, "chapter_id": 2863, "verse_number": "१२-३६८-८", "content_sanskrit": "त्यक्ताहारेण भवता वने निवसता त्वया।\nबालवृद्धमिदं सर्वं पीड्यते धर्मसंकरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087732, "chapter_id": 2863, "verse_number": "१२-३६८-९", "content_sanskrit": "न हि नो भ्रूणहा कश्चित्पन्नगेष्विह विद्यते।\nपूर्वाशी वा कुले ह्यस्मिन्देवतातिथिबन्धुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087733, "chapter_id": 2863, "verse_number": "१२-३६८-१०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087734, "chapter_id": 2863, "verse_number": "१२-३६८-१०", "content_sanskrit": "उपदेशेन युष्माकमाहारोऽयं कृतो मया।\nद्विरूनं दशरात्रं वै नागस्यागमनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087735, "chapter_id": 2863, "verse_number": "१२-३६८-११", "content_sanskrit": "यद्यष्टरात्रेऽतिक्रान्ते नागमिष्यति पन्नगः।\nतदाहारं करिष्यामि तन्निमित्तमिद व्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087736, "chapter_id": 2863, "verse_number": "१२-३६८-१२", "content_sanskrit": "कर्तव्यो न च संतापो गम्यतां च यथागतम्।\nतन्निमित्तमिदं सर्वं नैतद्भेत्तुगिहार्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087737, "chapter_id": 2863, "verse_number": "१२-३६८-१३", "content_sanskrit": "ते तेन समनुज्ञाता ब्राह्मणेन भुजङ्गमाः।\nस्वमेव भवनं जग्मुरकृतार्था नरर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087738, "chapter_id": 2863, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टषष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]