[{"id": 2142549, "chapter_id": 4074, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142550, "chapter_id": 4074, "verse_number": "१", "content_sanskrit": "भूतानां प्राणिनः श्रेष्ठाः प्राणिनां बुद्धिजीविनः ।\nबुद्धिमत्सु नराः श्रेष्ठा नराणां तु द्विजातयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142551, "chapter_id": 4074, "verse_number": "२", "content_sanskrit": "द्विजेषु वैद्याः श्रेयांसो वैद्येषु कृतबुद्धयः ।\nकृतबुद्धिषु कर्तारः कर्तृषु ब्रह्मवेदिनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142552, "chapter_id": 4074, "verse_number": "३", "content_sanskrit": "स भवान् कृतबुद्धीनां प्रधान इति मे मतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142553, "chapter_id": 4074, "verse_number": "४", "content_sanskrit": "कुलेन च विशिष्टोऽसि वयसा च श्रुतेन च ।\nप्रज्ञया सदृशश्चासि शुक्रेणाङ्गिरसेन च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142554, "chapter_id": 4074, "verse_number": "५", "content_sanskrit": "विदितं चापि ते सर्वं यथावृत्तः स कौरवः ।\nपाण्डवश्च यथावृत्तः कुन्तीपुत्रो युधिष्ठिरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142555, "chapter_id": 4074, "verse_number": "६", "content_sanskrit": "धृतराष्ट्रस्य विदिते वञ्चिताः पाण्डवाः परैः ।\nविदुरेणानुनीतोऽपि पुत्रमेवानुवर्तते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142556, "chapter_id": 4074, "verse_number": "७", "content_sanskrit": "शकुनिर्बुद्धिपूर्वं हि कुन्तीपुत्रं समाह्वयत् ।\nअनक्षज्ञं मताक्षः सन् क्षत्रवृत्ते स्थितं शुचिम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142557, "chapter_id": 4074, "verse_number": "८", "content_sanskrit": "ते तथा वञ्चयित्वा तु धर्मराजं युधिष्ठिरम् ।\nन कस्याञ्चिदवस्थायां राज्यं दास्यन्ति वै स्वयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142558, "chapter_id": 4074, "verse_number": "९", "content_sanskrit": "भवांस्तु धर्मसंयुक्तं धृतराष्ट्रं ब्रुवन् वचः ।\nमनांसि तस्य योधानां ध्रुवमार्जवयिष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142559, "chapter_id": 4074, "verse_number": "१०", "content_sanskrit": "विदुरश्चापि तद्वाक्यं साधयिष्यति तावकम् ।\nभीष्मद्रोणकृपादीनां भेदं सञ्जनयिष्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142560, "chapter_id": 4074, "verse_number": "११", "content_sanskrit": "अमात्येषु च भिन्नेषु योधेषु विमुखेषु च ।\nपुनरैकाग्र्यकरणं तेषां कर्म भविष्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142561, "chapter_id": 4074, "verse_number": "१२", "content_sanskrit": "एतस्मिन्नन्तरे पार्थाः सुखमेकाग्रबुद्धयः ।\nसेनाकर्म करिष्यन्ति द्रव्याणां चैव सञ्चयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142562, "chapter_id": 4074, "verse_number": "१३", "content_sanskrit": "भिद्यमानेषु च स्वेषु लम्बमाने तथा त्वयि ।\nन तथा ते करिष्यन्ति सेनाकर्म न संशयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142563, "chapter_id": 4074, "verse_number": "१४", "content_sanskrit": "एतत्प्रयोजनं चात्र प्राप्यान्येनोपलभ्यते ।\nसङ्गत्य धृतराष्ट्रश्च कुर्याद् धर्म्यं वचस्तव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142564, "chapter_id": 4074, "verse_number": "१५", "content_sanskrit": "स भवान् धर्मयुक्तश्च स्थविरश्च विशेषवित् ।\nकृपालेषु परिक्लेशान् पाण्डवीयान् प्रकीर्तयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142565, "chapter_id": 4074, "verse_number": "१६", "content_sanskrit": "वृद्धेषु कुलधर्मं च ब्रुवन् पूर्वैरनुष्ठितम् ।\nविभेत्स्यति मनांस्येषामिति मे नात्र संशयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142566, "chapter_id": 4074, "verse_number": "१७", "content_sanskrit": "न च तेभ्यो भयं तेऽस्ति ब्राह्मणो ह्यसि वेदवित् ।\nदूतकर्मणि युक्तश्च स्थविरश्च विशेषतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142567, "chapter_id": 4074, "verse_number": "१८", "content_sanskrit": "स भवान् पुष्ययोगेन मुहूर्तेन जयेन च ।\nकौरवेयान् प्रयात्वाशु कौन्तेयस्यार्थसिद्धये\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142568, "chapter_id": 4074, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142569, "chapter_id": 4074, "verse_number": "१९", "content_sanskrit": "तथाऽनुशिष्टः प्रययौ द्रुपदेन महात्मना ।\nपुरोधा वृत्तसम्पन्नो नगरं नागसाह्वयम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142570, "chapter_id": 4074, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nउद्योगपर्वणि षष्ठोऽध्यायः ॥६॥ सेनोद्योगपर्वणि षष्ठोऽध्यायः ॥६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]