{"50011399": [{"id": 1, "verse_id": 50011399, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“ऋते हैहयवैन्यादीनार्षभस्येह कः समः। यस्योपदेशात् सिन्ध्वीशो ददर्श कपिलं प्रभुम् 【पाठभेदः: BG—विभुम्】 ॥” इति च॥ २६॥"}], "50011402": [{"id": 1, "verse_id": 50011402, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "युज्यतेऽनेनेति योगो हरिः। साङ्ख्यशिरसे उत्तमज्ञानस्वरूपाय॥ २९॥"}, {"id": 2, "verse_id": 50011402, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये पञ्चमस्कन्धे त्रयोदशोऽध्यायः॥"}]}