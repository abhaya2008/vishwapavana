{"50007349": [{"id": 1, "verse_id": 50007349, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“कैशोरयौवनाभ्यन्तःकाल आपीच्यमुच्यते” इत्यभिधानम्॥ ४॥"}, {"id": 2, "verse_id": 50007349, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये प्रथमस्कन्धे विंशोऽध्यायः॥"}, {"id": 3, "verse_id": 50007349, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये प्रथमस्कन्धः सम्पूर्णः॥"}]}