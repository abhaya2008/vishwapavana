{"50007214": [{"id": 1, "verse_id": 50007214, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "बिभ्यतमिव मेहन्तम्॥ २॥"}], "50007234": [{"id": 1, "verse_id": 50007234, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "असतां सूचकस्य न दोषः, तथाऽपि सतां न सूचनीयमिति दर्शयितुम्। ज्ञातुं शक्यत्वाच्च राज्ञः। “यद्यधर्मः कृतः सद्भिः स न वाच्यः कथञ्चन। असत्कृतमधर्मं तु वदन् धर्ममवाप्नुयात्॥” इति व्यासस्मृतौ॥ २१॥"}], "50007235": [{"id": 1, "verse_id": 50007235, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "तस्य गोचरत्वेऽपि भूतानामगोचरेति ज्ञापयितुं वा॥ २२॥"}], "50007247": [{"id": 1, "verse_id": 50007247, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "ब्रह्मयज्ञा वितानयज्ञाश्च॥ ३२॥"}], "50007248": [{"id": 1, "verse_id": 50007248, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "इष्टात्ममूर्तिः इच्छातनुः॥ ३३॥"}], "50007256": [{"id": 1, "verse_id": 50007256, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "विहितातिरेकेण न सेवेत॥ ४०॥"}, {"id": 2, "verse_id": 50007256, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये प्रथमस्कन्धे सप्तदशोऽध्यायः॥"}]}