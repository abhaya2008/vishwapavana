{"50008110": [{"id": 1, "verse_id": 50008110, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“आधार आश्रयो धिष्ण्यं निधानं चाभिधीयते” इत्यभिधानम् ॥ ४॥"}], "50008119": [{"id": 1, "verse_id": 50008119, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“उदकं वायुना शुष्कं भिन्नं पद्ममभूद्धरेः” इति पाद्मे॥ १३॥"}], "50008120": [{"id": 1, "verse_id": 50008120, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "आत्मा विष्णुरस्य योनिः॥ १४॥"}], "50008122": [{"id": 1, "verse_id": 50008122, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“पद्मसंस्थाद्धरेस्तत्र ब्रह्माऽजनि चतुर्मुखः” इति च।"}, {"id": 2, "verse_id": 50008122, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "सर्वगुणावभासं पृथिव्यात्मकम्। पृथिव्यां हि सर्वे शब्दादयो गुणा अवभासन्ते। “तस्यासनविधानार्थं पृथिवी पद्ममुच्यते” (कुत्र: भारते १२/१७५/३६) इति मोक्षधर्मे॥ १५-१६॥"}], "50008124": [{"id": 1, "verse_id": 50008124, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“प्रधानवाचकस्त्वेकश्चानन्यः केवलः स्वयम्” इति ब्राह्मे।"}, {"id": 2, "verse_id": 50008124, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "सता ब्रह्मणा। “स ब्रह्माऽचिन्तयत् कुतो नु पद्मं ब्रह्मणः स्यादिति” इति मैत्रायणश्रुतिः॥ १८॥"}], "50008132": [{"id": 1, "verse_id": 50008132, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "भिन्नम् अन्येभ्यो विलक्षणम्॥ २६॥"}], "50008135": [{"id": 1, "verse_id": 50008135, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“तस्मादव्यक्तमुत्पन्नं त्रिगुणं द्विजसत्तम” (कुत्र: भारतम् १२/३४२/३२) इति मोक्षधर्मे॥ २९॥"}], "50008137": [{"id": 1, "verse_id": 50008137, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "सूर्येन्दुवाय्वग्न्यादिभिस्त्रिधाम्नो विष्णोरगच्छद्भिः प्राधानिकैः।"}, {"id": 2, "verse_id": 50008137, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“मुक्तवाय्वादिभिर्विष्णुं वृतं ब्रह्मा ददर्श ह। तदन्याभावतो नान्यदतस्तत् स्रष्टुमैच्छत॥” इति ब्रह्माण्डे॥ ३१॥"}, {"id": 3, "verse_id": 50008137, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये तृतीयस्कन्धे नवमोऽध्यायः॥"}]}