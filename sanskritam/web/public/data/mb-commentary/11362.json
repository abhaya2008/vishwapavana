{"50006786": [{"id": 1, "verse_id": 50006786, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "भक्तियोगविधानविषयम्॥ २३॥"}], "50006791": [{"id": 1, "verse_id": 50006791, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "अपुनर्भवं दर्शयति॥ २८॥"}], "50006794": [{"id": 1, "verse_id": 50006794, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "तत्तद्योग्यतया समत्वम्॥ ३१॥"}], "50006804": [{"id": 1, "verse_id": 50006804, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "यर्हि भवतो दर्शनं तदा यदूनामस्माकं नामरूपे॥ ४१॥"}, {"id": 2, "verse_id": 50006804, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये प्रथमस्कन्धेऽष्टमोऽध्यायः॥"}]}