{"50006603": [{"id": 1, "verse_id": 50006603, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "शारीरमानसयोरभेदादुभयथाऽपि युज्यते। स्वतन्त्रत्वादात्मनैव ह्यलम्बुद्धिः॥ २॥"}], "50006605": [{"id": 1, "verse_id": 50006605, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "शोचसि प्रकाशयसि। “अजस्रेण शोचिषा शोशुचानः” (कुत्र: ऋग्वेदसंहिता ७/५/४) इति हि श्रुतिः॥ ४॥"}], "50006607": [{"id": 1, "verse_id": 50006607, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“ज्ञानशक्तिस्वरूपोऽपि ह्यज्ञाशक्तं वदेद्धरिः। अज्ञानां मोहनायेशस्तेन मुह्यन्ति मोहिताः॥” इति पाद्मे॥ ५॥"}], "50006612": [{"id": 1, "verse_id": 50006612, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "धर्मादीनाल्पकथनेन पूर्तिः। न वासुदेवमहिम्नोऽतिकथितस्यापि॥ ९॥"}], "50006613": [{"id": 1, "verse_id": 50006613, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "वायसं तीर्थं वयोमात्रानुजीवि शास्त्रम्॥ १०॥"}], "50006615": [{"id": 1, "verse_id": 50006615, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "परोक्षज्ञानं न शोभते। अपरोक्षज्ञानं न भक्त्या विनोत्पद्यते। “यस्य देवे परा भक्तिः”, (कुत्र: श्वेताश्वतरोपनिषत् ६/२३) “यमेवैष वृणुते तेन लभ्यः”, (कुत्र: काठकोपनिषत् १/२/२३) “यद् वासुदेवशरणा विदुरञ्जसैव” (कुत्र: भागवतम् २/७/१९) इत्यादेः॥ १२॥"}], "50006616": [{"id": 1, "verse_id": 50006616, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "शुचिश्रवाः विष्णुः। समाधिना समाधिभाषया। स्मरणं ग्रन्थकृतिः। “स्मरन्ति च” (कुत्र: ब्रह्मसूत्रम् २/३/४७) इत्यादेः॥ १३॥"}], "50006618": [{"id": 1, "verse_id": 50006618, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "प्रवृत्तिधर्मकृते॥ १५॥"}], "50006619": [{"id": 1, "verse_id": 50006619, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "अनन्तपारस्य विभोः सकाशाद् यत् सुखम्॥ १६॥"}], "50006623": [{"id": 1, "verse_id": 50006623, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "इतरः अपि भगवान् विश्वमिव। स्वातन्त्र्यात्॥ २०॥"}], "50006630": [{"id": 1, "verse_id": 50006630, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "मयि स्थिते ब्रह्मणि स्थीयतामत्रेतीश्वरेच्छया परिकल्पितम्॥ २७॥"}], "50006643": [{"id": 1, "verse_id": 50006643, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "त्वम् ईश्वरः अपि॥ ४०॥"}, {"id": 2, "verse_id": 50006643, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये प्रथमस्कन्धे पञ्चमोऽध्यायः॥"}]}