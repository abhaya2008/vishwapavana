{"50010295": [{"id": 1, "verse_id": 50010295, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“गुणाः स्वरूपभूताश्च बाह्याश्चेति द्विधा मताः। स्वरूपभूता व्यज्यन्ते हरेर्बाह्यान् दुहुः पयः ॥” इति ब्राह्मे॥ १५॥"}], "50010296": [{"id": 1, "verse_id": 50010296, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“प्रतिमन्वन्तरं प्रायः प्रह्लादाद्या बभूविरे” इति च॥ १६॥"}], "50010311": [{"id": 1, "verse_id": 50010311, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“गोष्ठं घोष इति प्रोक्तो व्रजस्तत्पालसंस्थितिः” इत्यभिधानम्॥ ३१॥"}, {"id": 2, "verse_id": 50010311, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये चतुर्थस्कन्धेऽष्टादशोऽध्यायः॥"}]}