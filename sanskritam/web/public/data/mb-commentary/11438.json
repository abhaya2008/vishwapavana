{"50010237": [{"id": 1, "verse_id": 50010237, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“राज्ञा समानवयसः श्रेणयस्त्वङ्गरक्षकाः” इत्यभिधानम्॥ २॥"}], "50010242": [{"id": 1, "verse_id": 50010242, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "पूर्वतनानां कथासम्बन्धेन हरेर्यशः॥ ६॥"}], "50010271": [{"id": 1, "verse_id": 50010271, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“ब्रह्मादिजीवदेहास्तु मायादेहाः प्रकीर्तिताः” इति वाराहे॥ २९॥"}], "50010274": [{"id": 1, "verse_id": 50010274, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "स परतः ईश्वरः इत्याक्षेपः॥ ३२॥"}], "50010275": [{"id": 1, "verse_id": 50010275, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“विरुद्धशक्तयो यस्य नित्या युगपदेव च। तस्मै नमो भगवते विष्णवे सर्वजिष्णवे॥” इति च॥ ३३॥"}, {"id": 2, "verse_id": 50010275, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये चतुर्थस्कन्धे सप्तदशोऽध्यायः॥"}]}