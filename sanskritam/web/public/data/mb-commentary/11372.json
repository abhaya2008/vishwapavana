{"50007265": [{"id": 1, "verse_id": 50007265, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“विज्ञानमात्मयोग्यं स्याज्ज्ञानं साधारणं स्मृतम्” इति भागवततन्त्रे॥ ३॥"}], "50007276": [{"id": 1, "verse_id": 50007276, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“सम्यक्स्वरूपाभिव्यक्तिरभावो 【पाठभेदः: BG—“सम्यक्स्वरूपस्याव्यक्तिरभावो】 जननस्य च। अल्पयत्नात् ततो वृद्धिहेतोः सत्सङ्गतिर्वरा॥” इति वायुप्रोक्ते॥ १३॥"}], "50007283": [{"id": 1, "verse_id": 50007283, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "अनन्तः देशतः कालतश्च॥ १९॥"}], "50007286": [{"id": 1, "verse_id": 50007286, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "परमहंसाश्रमप्राप्यं सत्यं ब्रह्म॥ २२॥"}], "50007290": [{"id": 1, "verse_id": 50007290, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“स्वतो मनःस्थितिर्विष्णौ ब्रह्मभाव उदाहृतः” इति ब्रह्माण्डे॥ २६॥"}], "50007293": [{"id": 1, "verse_id": 50007293, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“अप्रीतिर्मद्वशो नायमिति मत्सर ईरितः” इति नाममहोदधौ॥ २९॥"}], "50007300": [{"id": 1, "verse_id": 50007300, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "कौशिकी कुशपाणिः॥ ३६॥"}], "50007307": [{"id": 1, "verse_id": 50007307, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“सेना पराकिणी 【पाठभेदः: BG—वरूथिनी】 प्रोक्ता वरूथो गुप्तिरुच्यते” इत्यभिधानम्॥ ४३॥"}], "50007308": [{"id": 1, "verse_id": 50007308, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“विड् राष्ट्रं पशुरुत्सेको भ्रमरश्चेति कथ्यते” इति च॥ ४४॥"}], "50007314": [{"id": 1, "verse_id": 50007314, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "स्वकृतो गुणस्तस्यैव यतः॥ ५०॥"}, {"id": 2, "verse_id": 50007314, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये प्रथमस्कन्धेऽष्टादशोऽध्यायः॥"}]}