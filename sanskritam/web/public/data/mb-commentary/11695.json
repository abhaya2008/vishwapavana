{"50021999": [{"id": 1, "verse_id": 50021999, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "तनुमत्यजत्। अतिशयेनाहरत्। “अज हरणे” इति धातोः। भूलोकात् स्वर्गलोकं प्रत्यहरदित्यर्थः॥ २॥"}], "50022000": [{"id": 1, "verse_id": 50022000, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "कः सुखरूपः। अनुमानः कवीनां मानानुसारी॥ ३॥"}, {"id": 2, "verse_id": 50022000, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णय एकादशस्कन्धे त्रिंशोऽध्यायः॥"}]}