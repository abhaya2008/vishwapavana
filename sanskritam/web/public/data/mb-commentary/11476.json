{"50011732": [{"id": 1, "verse_id": 50011732, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "इलावृतस्थस्तुतिवत् पातालमूलस्थस्तुतिर्योजनीयाऽनन्तविषया 【पाठभेदः: BG—इळावृतस्थस्तुतिवत् पाताळमूलस्थस्तुतिर्योजनीयाऽनन्तविषया】 ॥ ३८॥"}, {"id": 2, "verse_id": 50011732, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये पञ्चमस्कन्धे त्रयोविंशोऽध्यायः॥"}, {"id": 3, "verse_id": 50011732, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये पञ्चमस्कन्धः सम्पूर्णः॥"}]}