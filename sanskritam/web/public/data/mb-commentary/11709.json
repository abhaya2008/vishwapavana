{"50022673": [{"id": 1, "verse_id": 50022673, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "नित्यादोषस्वरूपाय गुणपूर्णाय सर्वदा। नारायणाय हरये नमः प्रेष्ठतमाय मे॥ *॥"}, {"id": 2, "verse_id": 50022673, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये द्वादशस्कन्धः सम्पूर्णः॥"}, {"id": 3, "verse_id": 50022673, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ समाप्तोऽयं ग्रन्थः॥"}]}