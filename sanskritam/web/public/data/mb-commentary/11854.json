{"50024382": [{"id": 1, "verse_id": 50024382, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "वीर्यवन्तश्च ये सोमा यजमानेष्टसाधकाः। पिब तान् ---- ---- ---- ---- ---- ----॥ २३/१॥"}], "50024383": [{"id": 1, "verse_id": 50024383, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "---- सर्वदेवानां ज्ञानाधिक्यौ दिविस्पृशौ॥ २३/२॥"}], "50024384": [{"id": 1, "verse_id": 50024384, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "मनसः प्रेरकौ चैव बहुज्ञानौ धियस्पती॥ २३/३॥"}], "50024385": [{"id": 1, "verse_id": 50024385, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "जज्ञानौ व्यज्यमानौ तु यजमानस्य शोधकौ॥ २३/४॥"}], "50024386": [{"id": 1, "verse_id": 50024386, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "परेण ब्रह्मणा तस्मिन् वृद्धौ सत्यपती सदा। सत्यं ज्योतिः प्रकाशत्वात् तौ मित्रावरुणौ हुवे॥ २३/५॥ (८)"}], "50024387": [{"id": 1, "verse_id": 50024387, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "संसिद्धान् कुरुतां नस्तौ ------ ----- ॥ २३/६॥"}], "50024388": [{"id": 1, "verse_id": 50024388, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "-------- ----- ----- सगणस्तृप्यतां हरिः॥ २३/७॥"}], "50024389": [{"id": 1, "verse_id": 50024389, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "पूषा पूर्णत्वतो विष्णुस्तन्मित्राः पूषरातयः॥ २३/८॥"}], "50024390": [{"id": 1, "verse_id": 50024390, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "सहसा बलरूपेण शक्रेण सहिताः सुराः। मदज्ञानं हतातीव दानशीला न शक्नुयात्॥ दुर्वाक् तद्वान् पुमान् वा नः ----- ----- ॥ २३/९॥"}], "50024391": [{"id": 1, "verse_id": 50024391, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "------ ----- ----- ----- ----- भारती पृश्निरुच्यते। गोरूपा च क्वचित् साऽभूत् तत्सुताश्चाखिलाः सुराः॥ अन्यत्रापि सुतास्तस्याः ------ ----- ----- -----॥ २३/१०॥ (९)"}], "50024392": [{"id": 1, "verse_id": 50024392, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "---- ----- ----- ----- ----- ----- ----- जयतामिव तद्ध्वनिः। धैर्याद् याति यदा विष्णुं वायुं वा याथनोत्तमम्॥ २३/११॥"}], "50024393": [{"id": 1, "verse_id": 50024393, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "दोषत्यागाद् गुणप्राप्तेर्हस्कारो वायुरुच्यते। विद्युद् विशिष्टज्ञानत्वाद् भारती तत्सुता हि ते॥ सर्वे देवाश्च मरुतो रक्षन्त्वेतादृशो हरिः। तत्तदन्तर्गतत्वेन ------ ---- ---- ----॥ २३/१२॥"}], "50024394": [{"id": 1, "verse_id": 50024394, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "----- -----  -----  ----- पूषा पूर्णत्वतश्च सः। आघृणिः पूर्णरश्मित्वादाज नश्चित्रबर्हिषम्॥ ब्रह्माणं च दिवो देव्या भर्तारं वायुमाज गाम्। यथा गतम् ----- -----  -----  -----  -----॥ २३/१३॥"}], "50024395": [{"id": 1, "verse_id": 50024395, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "-----  ----- ---- जगद्राजमविन्दद् भगवान् सुतम्। स्वकुक्षिगूढं ब्रह्माणम् ---- -----  -----  -----॥ २३/१४॥"}], "50024396": [{"id": 1, "verse_id": 50024396, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "------ -----  -----  ----- मह्यं सोमैश्च तर्पितः। साधयामास षड् युक्तानीन्द्रियाणि चकार च॥ साधनं शक्तिदानं तु गोभिर्वार्भिर्यथा यवम्॥ २३/१५॥ (१०)"}], "50024397": [{"id": 1, "verse_id": 50024397, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "अम्बयो मातरो ह्यापः कारणत्वात् सहोदराः। जगतो जामयो यस्मात् सह ताभिर्विवर्धते॥ अध्वरं कुर्वतां क्षीरं सोमं चापि प्रपृञ्चतीः। सम्पृक्ताः ------- ------- ------- -------॥ २३/१६॥"}], "50024398": [{"id": 1, "verse_id": 50024398, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "----- याः समीपस्थाः सूर्यस्य सहिता अपि॥ २३/१७॥"}], "50024399": [{"id": 1, "verse_id": 50024399, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "ह्वयामि ता याः पिबन्ति गावो नः सर्वथा हविः। कार्यं नदीभ्यः ------ ------- ------- -------॥ २३/१८॥"}], "50024400": [{"id": 1, "verse_id": 50024400, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "------- ------- तास्वन्तरदृश्यममृतं स्थितम्। अपामेव प्रशंसार्थं सहायाः सन्तु नः सुराः॥ २३/१९॥"}], "50024401": [{"id": 1, "verse_id": 50024401, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "तात्पर्यार्थं पुनर्वाक्यं सुखाधारो हुताशनः॥ २३/२०॥ (११)"}], "50024402": [{"id": 1, "verse_id": 50024402, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "वरूथं गुप्तिरुद्दिष्टा ज्योतिर्विष्णुदृशे तथा। सूरिप्राप्यो यतो विष्णुः सूर्य इत्यभिधीयते॥ “पृण दाने” ------- ------- ------- -------॥ २३/२१॥"}], "50024403": [{"id": 1, "verse_id": 50024403, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "----- अखिलं पापमापः प्रवहतापि नः। हिंसाजं शेपजं चैव तथैवानृतसम्भवम्॥ २३/२२॥"}], "50024404": [{"id": 1, "verse_id": 50024404, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "रसेन सङ्गताश्च स्मो यस्मादनुचरा हि वः॥ २३/२३॥"}], "50024405": [{"id": 1, "verse_id": 50024405, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "कुर्युर्मामपि विद्वांसं मदर्थं सर्वदा सुराः। एतं मामिति वाऽर्थः स्यादनुजानन्तु वोदितम्॥ २३ (२/४)/२४॥ (१२) (५)"}]}