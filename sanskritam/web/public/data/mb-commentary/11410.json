{"50008850": [{"id": 1, "verse_id": 50008850, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "देहली द्वारबन्धः॥ १८॥"}], "50008852": [{"id": 1, "verse_id": 50008852, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "कृत्रिमान् शोभार्थं कृतान्॥ २०॥"}], "50008862": [{"id": 1, "verse_id": 50008862, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "आदर्शे ददर्श॥ ३०॥"}], "50008870": [{"id": 1, "verse_id": 50008870, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "उद्गुणपानवीच्यः उत्तमामृतवीचीयुक्तः॥ ३८॥"}], "50008877": [{"id": 1, "verse_id": 50008877, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "“प्राप्तषोडशवर्षः सन्नावीच्य इति कथ्यते” इत्यभिधानम्॥ ४५॥"}, {"id": 2, "verse_id": 50008877, "commentary_type": "सर्वमूलभाष्यम्", "author": "श्रीमध्वाचार्यः", "content": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्भागवततात्पर्यनिर्णये तृतीयस्कन्धे चतुर्विंशोऽध्यायः॥"}]}