    {
      "id": 1,
      "verse_id": 20013730,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "सटानां स्कन्धरोम्णां छटया समूहेन स्फोटितो मेघसंघो येन । तीव्रशब्देन त्रा भूतसंघो येन । संवेगेन संमूर्छितो संमोहितो लोकसंघो येन । किमेतदित्याकुलो देवसंघो यस्मात्स मुमुत्पपातेतिपूर्वेण संबन्धः ॥ ४० ॥"
    }
  ]
