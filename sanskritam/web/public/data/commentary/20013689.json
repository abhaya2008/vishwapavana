    "verse_number": "10.111",
    "content_sanskrit": "तीररुहैः कृष्णयास्तीरेऽवात्सीत्तिरोहितोष्णायाः । आवर्जिततृष्णाया आचार्येन्द्रो निरस्तकाष्ण्र्यायाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  "commentaries": [
    {
      "id": 1,
      "verse_id": 20013689,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "ततश्च तीररुहैराम्रादिवृक्षैः श्यामायास्तिरोहितमुष्णं यस्यां यया वाऽऽवर्जित- तृट्‌तृष्णा च यस्या निरस्तं काष्ण्र्यं यस्यास्तथाभूताया नद्यास्तीर आचार्येन्द्रोऽ- वात्सीत् । गीतिः ॥ १३ ॥"
    },
    {
      "id": 2,
      "verse_id": 20013689,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "आवर्जिता स्वसौष्ठवप्रकटनद्वारा सुसंपादिता तृष्णा स्वविषयकरतिर्यया सा तथा"
    }
  ]
}