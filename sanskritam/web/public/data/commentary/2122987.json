{"verse": {"id": 2122987, "chapter_id": 3639, "verse_number": "१२", "content_sanskrit": "शतं दासीसहस्राणि तरुण्यो हेमभूषणाः ।\nकञ्चुकेयूरहारिण्यो निष्ककण्ठ्यः स्वलङ्कृताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, "commentaries": [{"id": 1, "verse_id": 2122987, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) कञ्चुकेयूर इत्यत्र कञ्चुः कञ्चुकः ।"}]}