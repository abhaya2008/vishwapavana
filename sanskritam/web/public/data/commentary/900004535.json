{"verse": {"id": 900004535, "chapter_id": 8347, "verse_number": "6.4", "content_sanskrit": "विषयाऽश्रयं चेदज्ञानं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, "commentaries": [{"id": 1, "verse_id": 900004535, "commentary_type": "तत्त्वोद्योतः", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "आत्मज्ञानस्याऽत्माविषयकत्वे तेनात्माज्ञानाऽनिवृत्त्यापादनम्\nविषयाऽश्रयं चेदज्ञानं"}, {"id": 2, "verse_id": 900004535, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "किञ्च अस्तु वा आत्माज्ञानम् । तथाऽपि न वेदान्तवाक्यजनितविज्ञानस्याऽत्मज्ञानत्वं सम्भवति । तस्यानात्मविषयत्वेन तन्निवर्तकत्वायोगात् । यद्विषयं हि यद्विज्ञानं तदेव तदज्ञानं निवर्तयदुपलब्धम् ।"}, {"id": 3, "verse_id": 900004535, "commentary_type": "श्रीविजयीन्द्रभिक्षु", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अनात्मविषयत्वेनेति ।। आत्मविषयकत्वरहितत्वेनेत्यर्थः । एवमग्रेऽपि ।"}, {"id": 4, "verse_id": 900004535, "commentary_type": "श्रीवेदेशतीर्थ", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अनात्मविषयत्वेनेति ।। आत्मविषयत्वरहितत्वेनेत्यर्थः । एवमग्रेऽपि ।"}, {"id": 5, "verse_id": 900004535, "commentary_type": "श्रीराघवेन्द्रतीर्थ", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अनात्मेति ।। १आत्माविषयत्वेनेत्यर्थः ।"}, {"id": 6, "verse_id": 900004535, "commentary_type": "जनार्दनभट्टीया", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "तस्य अनात्मविषयत्वेनेति ।। वेदान्तवाक्यजन्यज्ञानस्य सत्यज्ञानादिपदप्रवृत्ति-निमित्ततत्तद्गुणादिविशिष्टविषयत्वेन भिन्नविषयतया शुद्धाज्ञाननिवर्तकत्वासम्भवादिति भावः ।"}]}