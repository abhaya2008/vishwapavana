{"verse": {"id": 900003704, "chapter_id": 8299, "verse_number": "14.10", "content_sanskrit": "गीता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, "commentaries": [{"id": 1, "verse_id": 900003704, "commentary_type": "श्रीमद्भगवद्गीतातात्पर्यम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "गीता\nइति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः ।\nमद्भक्त एतद्विज्ञाय मद्भावायोपपद्यते ।। १९ ।।"}, {"id": 2, "verse_id": 900003704, "commentary_type": "तात्पर्यम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "मद्भावाय मयि भावाय ।। १९ ।।"}, {"id": 3, "verse_id": 900003704, "commentary_type": "न्यायदीपिका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "उक्तमुपसंहृत्य तज्ज्ञानं स्तूयते ।। इतीति ।। तत्र मद्भावपदमन्यथाप्रतीतिनिरासाय व्याचष्टे ।। मद्भावायेति ।। १९ ।।"}, {"id": 4, "verse_id": 900003704, "commentary_type": "किरणावली", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अन्यथाप्रतीतीति ।। मदैक्यायेत्यन्यथाप्रतीतीत्यर्थः ।। १९ ।।"}, {"id": 5, "verse_id": 900003704, "commentary_type": "भावदीपः", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अन्यथाप्रतीतीति ।। मदात्मकत्वप्रतीतीत्यर्थः ।। १९ ।।"}, {"id": 6, "verse_id": 900003704, "commentary_type": "भावप्रकाशः", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "तद्ज्ञानमिति । क्षेत्रादिविषयकं ज्ञानमित्यर्थः ।। १९ ।।"}]}