{"verse": {"id": 900008109, "chapter_id": 8618, "verse_number": "9.4", "content_sanskrit": "अनिर्वचनीयासिद्धेरेवानुमानस्याप्यसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, "commentaries": [{"id": 1, "verse_id": 900008109, "commentary_type": "श्रीतत्वोद्योतस्य टीकाया विवृतिः", "author": "", "lang": "sa", "content": "दृश्यत्वाद्यनुमानानां दृष्टान्तस्य साध्यसाधनवैकल्यसमर्थनम्\nअनिर्वचनीयासिद्धेरेवानुमानस्याप्यसिद्धिः"}, {"id": 2, "verse_id": 900008109, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "", "lang": "sa", "content": "अथ वा शुक्तिरजतादेरनिर्वचनीयासिद्धेस्तथा शुक्तिकाया एव दृग्विषयत्वा-भ्युपगमादनिर्वचनीयतयाऽभिमतस्य रजतस्यासिद्धेरदृश्यत्वाद्दृष्टान्तस्य साध्यसाधन-वैकल्येनानुमानस्यानुपपत्तिरिति योजनीयम् ।"}]}