    "verse_number": "1.23",
    "content_sanskrit": "बुद्ध्वा मीनध्वजकलास्तत्प्रसङ्गप्रपञ्चनम् । सर्ग एकादशे तूग्रभैरवाभिधनिर्जयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  "commentaries": [
    {
      "id": 1,
      "verse_id": 20012578,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "मीनध्वजस्य कामस्य कला बुद्ध्वा तासां कलानां प्रसङ्गस्य प्रपञ्चनं प्रकटीकरण- मिति पूर्वेणान्वयः । एकादशे सर्गे तूग्रभैरवाभिधस्य कापालिकस्य निर्जयः स्थितः ॥२३॥ ॥ २३ ॥"
    },
    {
      "id": 2,
      "verse_id": 20012578,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "तत्प्रसङ्गेति । तयोभयभारत्यभिधसरस्वत्या सह यः प्रसङ्गः पुनर्जल्पादिस्तस्य प्रप- ञ्चनमिति यावत्"
    }
  ]
}