{"verse": {"id": 900003662, "chapter_id": 8296, "verse_number": "11.7", "content_sanskrit": "गीता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, "commentaries": [{"id": 1, "verse_id": 900003662, "commentary_type": "श्रीमद्भगवद्गीतातात्पर्यम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "मद्विषयचेष्टा रमन्ति\nगीता\nमच्चित्ता मद्गतप्राणा बोधयन्तः परस्परम् ।\nकथयन्तश्च मां नित्यं तुष्यन्ति च रमन्ति च ।। ९ ।।"}, {"id": 2, "verse_id": 900003662, "commentary_type": "तात्पर्यम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "मद्गतप्राणाः मद्विषयचेष्टाः ।। ९ ।।"}, {"id": 3, "verse_id": 900003662, "commentary_type": "न्यायदीपिका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "प्राणानां भगवद्गतत्वं कथमित्यत आह ।। मद्गतेति ।। ९ ।।"}]}