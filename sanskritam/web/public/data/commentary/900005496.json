{"verse": {"id": 900005496, "chapter_id": 8431, "verse_number": "12.22", "content_sanskrit": "जन्माद्यस्येति तेनैतद्विष्णोरेव स्वलक्षणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, "commentaries": [{"id": 1, "verse_id": 900005496, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एवं सौत्रस्य विष्णुलक्षणस्याव्याप्तिप्रसक्त्यभावादतिव्याप्तिमसंभवं च परिहृत्योप-संहतति जन्मादीति ।"}, {"id": 2, "verse_id": 900005496, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "जन्माद्यस्येति तेनैतद्विष्णोरेव स्वलक्षणम् ।।\nतेनोक्तप्रकारेण जन्मद्यस्येत्युक्तं जगज्जन्मादिकारणत्वं विष्णोः संभवति नान्येषाम् । अतोऽसंभवाद्यभावाद्विष्णोर्लक्षणं युक्तमिति योज्यम् ।"}, {"id": 3, "verse_id": 900005496, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अव्याप्तिप्रसक्तयभावादिति । लक्ष्यस्यैक व्यक्तित्वादिति भावः ।"}, {"id": 4, "verse_id": 900005496, "commentary_type": "यादुपत्यम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अव्याप्तिप्रसक्तयभावादिति । लक्ष्यभेदाभावादिति भावः ।"}]}