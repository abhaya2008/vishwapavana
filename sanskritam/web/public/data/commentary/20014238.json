  "commentaries": [
    {
      "id": 1,
      "verse_id": 20014238,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "तत्र हेतुमाह । कटकाश्रयभूतदीप्तसुवर्णस्य तदैव रुचकाधारत्वं यथा तथैव नित्यज्ञानाश्रयस्य भूयो ज्ञानान्तराधारतया स्थितेरयोगात् ॥ ३४ ॥ ॥ ३४॥"
    },
    {
      "id": 2,
      "verse_id": 20014238,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "रुचकेति । रुचकसंज्ञकालंकारविशेषाधारकत्वं तदैव कटकदशायामेव यथा न घटते तथैव"
    }
  ]
}