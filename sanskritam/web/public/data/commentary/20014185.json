  "commentaries": [
    {
      "id": 1,
      "verse_id": 20014185,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "वावदूकोऽतिवक्ता सनन्दनार्यस्तं प्रतिपद्योवाच । तं विशिनष्टि । अभिरूपकुलस्य बुधगणस्यावतंसभूतम् । 'अभिरूपो बुधे रम्ये' इति मेदिनी । बहुधा व्याख्यातो वेदरा-शिर्येनायत्नेन निरस्ता दुःसपत्ना येन तम् ॥ ८१ ॥"
    }
  ]
}