{"verse": {"id": 2203573, "chapter_id": 5341, "verse_number": "४२", "content_sanskrit": "हृष्टपुष्टविहङ्गश्च प्रफुल्लद्रुमकाननः ।\nसिद्धचारणसङ्घैश्च प्रीतियुक्तैः समाकुलः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, "commentaries": [{"id": 1, "verse_id": 2203573, "commentary_type": "ಕನ್ನಡ ಅರ್ಥ", "author": "ಕನ್ನಡ ಅರ್ಥ", "lang": "kn", "content": "ಹೃಷ್ಟ-ಪುಷ್ಟ ಪಕ್ಷಿಗಳು, ಅರಳಿದ ಹೂಗಳುಳ್ಳ ಮರಗಳ ಕಾನನಗಳು, ಸಂತೋಷದಿಂದ ಕೂಡಿದ ಸಿದ್ಧ-ಚಾರಣ ಸಂಘಗಳು ನಿಬಿಡವಾಗಿ ಕಂಡುಬಂದವು."}]}