  "commentaries": [
    {
      "id": 1,
      "verse_id": 20013909,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "यदुवाच तदाह । नेति । इन्द्रवज्रा वृत्तम् ॥ ५५ ॥"
    },
    {
      "id": 2,
      "verse_id": 20013909,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "अर्चनायै पूजायै । तर्हि किमर्थं विहितोऽयं प्रबन्ध इत्यत्राऽऽह । नेति । तत्र हेतुमाह । नेति"
    }
  ]
