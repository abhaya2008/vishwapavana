{"verse": {"id": 900007653, "chapter_id": 8578, "verse_number": "159.12", "content_sanskrit": "तत्परीक्षितमानेन न दोषो विष्णवि क्वचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, "commentaries": [{"id": 1, "verse_id": 900007653, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तत्परीक्षितमानेन न दोषो विष्णवि क्वचित्"}, {"id": 2, "verse_id": 900007653, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "‘अपरीक्षितमेवे’त्यादिनोक्तमुपसंहरति तदिति ।"}, {"id": 3, "verse_id": 900007653, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तत्परीक्षितमानेन न दोषो विष्णवि क्वचित् ।।\nतत्तस्मात्परीक्षितमेव मानम् । तेन च भगवति क्वचिदपि दोषो नास्तीति सिद्धम् । तद्विरोधादपरीक्षितं दोषदर्शनमप्रमाणमेवेत्यर्थः ।"}, {"id": 4, "verse_id": 900007653, "commentary_type": "वाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तदित्युत्तरग्रन्थस्य परीक्षितमेवेत्यादिनोक्तार्थोपसंहारतासिद्ध्यर्थमनेकोद्देश्यविधेयभावाश्रयणेन तद्योजयति तत्तस्मादिति ।"}, {"id": 5, "verse_id": 900007653, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "शेषोक्तयार्थमाह अपरीक्षितमित्यादि । मूले विष्णवीत्युक्तेः समाधानमुक्तमानुमानिकनये ।"}]}