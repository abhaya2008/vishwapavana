{"verse": {"id": 2137247, "chapter_id": 3974, "verse_number": "१", "content_sanskrit": "यत्तदा ह महद् ब्रह्मल्लोमशो वाक्यमब्रवीत् ।\nइन्द्रस्य वचनादेव पाण्डुपुत्रं युधिष्ठिरम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, "commentaries": [{"id": 1, "verse_id": 2137247, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) यत्तदा इत्यत्र हेति पदच्छेदः ।"}]}