    "avatarnika": ""
  },
  "commentaries": [
    {
      "id": 1,
      "verse_id": 20012853,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "स मुनिः श्रीशंकरः पदचित्रैर्नवनीतवत्कोमलैर्मधुरैः स्तवैर्मुराख्यासुरविदारकस्य विष्णोः कुटुम्बिनीं लक्ष्मीं द्विजदारिद्र्यदशानिवृत्तय उपासितवान् ॥ २५ ॥"
    },
    {
      "id": 2,
      "verse_id": 20012853,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "पदेति । शब्दालंकारसंग्रहार्थम् । नवनीतेति । माधुर्याख्यगुणग्रहणार्थम् । मधुरपदेन रसार्थालंकारयोर्ग्रहः"
    }
  ]
}