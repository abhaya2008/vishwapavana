{"verse": {"id": 900004388, "chapter_id": 8337, "verse_number": "13.32", "content_sanskrit": "सिद्धसाधकोऽसङ्गतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, "commentaries": [{"id": 1, "verse_id": 900004388, "commentary_type": "प्रमाणलक्षणटीका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "तर्हि सिद्धसाधकत्वं दोषान्तरमस्तीत्यत आह"}, {"id": 2, "verse_id": 900004388, "commentary_type": "प्रमाणलक्षणम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "सिद्धसाधकोऽसङ्गतः ।\nबुभुत्सितसाधनस्यैव सङ्गतत्वात् सिद्धसाधकोऽसङ्गतो भवति ।"}, {"id": 3, "verse_id": 900004388, "commentary_type": "प्रमाणलक्षणटीकावाक्यार्थकौमुदी", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "।। तर्हीति ।। सिद्धसाधनताप्रयुक्ताऽश्रयासिद्धेर्दोषत्व इत्यर्थः ।। दोषान्तरमिति ।। हेतोरिति शेषः । तथा च हेतुविरोधद्वैविध्यकथनमसदिति भावः । सङ्गतत्वादित्यनन्तरं सिद्धे च बोद्धुमिच्छाया अयोगादिति वाक्यशेषः ।"}]}