{"verse": {"id": 2120015, "chapter_id": 3579, "verse_number": "१", "content_sanskrit": "पतितौ हंसडिभकौ कंसामात्यौ निपातितौ ।\nजरासन्धस्य निधने कालोऽयं समुपागतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, "commentaries": [{"id": 1, "verse_id": 2120015, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) पतितौ इत्यत्र पतितौ दुर्मार्गवर्तिनौ ।"}]}