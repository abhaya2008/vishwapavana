{"verse": {"id": 900005558, "chapter_id": 8433, "verse_number": "14.7", "content_sanskrit": "मुख्यार्थो भगवान्विष्णुः सर्वशास्त्रास्य नापरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, "commentaries": [{"id": 1, "verse_id": 900005558, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "मुख्यार्थो भगवान्विष्णुः सर्वशास्त्रास्य नापरः"}, {"id": 2, "verse_id": 900005558, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तदेवं जगज्जन्मादिकारणत्वेन मुख्यया वृत्त्या वर्णपदवाक्यात्मकाशेषशास्त्रप्रतिपाद्यं नारायणाख्यं ब्रह्मैवेति सुस्थं लक्षणमिति सिद्धम् ।। १-१-४ ।।"}, {"id": 3, "verse_id": 900005558, "commentary_type": "वाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "चतुर्थपादीयज्योतिरधिकरणोक्तसमन्वयस्याप्रतिज्ञातताशङ्कामुपसंहारव्याजेन परिहरति तदेवमिति ।। १-१-४ ।।"}, {"id": 4, "verse_id": 900005558, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "फलोक्त्योपसंहरति तदेवमिति ।। १-१-४ ।।"}, {"id": 5, "verse_id": 900005558, "commentary_type": "यादुपत्यम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "नारायणाख्यमेवेत्येवकारान्वयः। न तु हरहिरण्यगर्भाख्यमित्यर्थः । अत्र विष्ण्वाख्य- मिति वक्तव्ये यन्नारायाणाख्यमिति वचनं तद्ब्रह्मशब्दव्याख्यानसूचनायेत्यवगन्तव्यम् ।। १-१-४ ।।"}, {"id": 6, "verse_id": 900005558, "commentary_type": "वाक्यार्थरत्नमाला", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "वर्णपदवाक्येत्यधिकोक्तिप्रयोजनमाह  चतुर्थपादीयेति ।।\nइति समन्वयाधिकरणम्"}]}