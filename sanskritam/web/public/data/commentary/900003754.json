{"verse": {"id": 900003754, "chapter_id": 8304, "verse_number": "19.9", "content_sanskrit": "गीता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, "commentaries": [{"id": 1, "verse_id": 900003754, "commentary_type": "श्रीमद्भगवद्गीतातात्पर्यम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "कर्मणां पञ्चकारणानि\nगीता\nअधिष्ठानं तथा कर्ता करणं च पृथग्विधम् ।\nविविधाश्च पृथक्चेष्टा दैवं चैवात्र पञ्चमम् ।। १४ ।।\nशरीरवाङ्मनोभिर्यत्कर्म प्रारभते नरः ।\nन्याय्यं वा विपरीतं वा पञ्चैते तस्य हेतवः ।। १५ ।।\nतत्रैवं सति कर्तारमात्मानं केवलं तु यः ।\nपश्यत्यकृतबुद्धित्वान्न स पश्यति दुर्मतिः ।। १६ ।।"}, {"id": 2, "verse_id": 900003754, "commentary_type": "तात्पर्यम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अधिष्ठानं शरीरादि ।। १४१६ ।।"}, {"id": 3, "verse_id": 900003754, "commentary_type": "प्रकाशिका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "‘‘अधिष्ठानं तथा कर्तेत्यत्राधिष्ठानशब्दार्थमाह ।। शरीरादीति ।। १४१६ ।।"}, {"id": 4, "verse_id": 900003754, "commentary_type": "न्यायदीपिका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अधिष्ठानपदस्यात्र विवक्षितमर्थमाह ।। अधिष्ठानमिति ।। १४१६ ।।"}]}