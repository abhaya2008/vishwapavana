{"verse": {"id": 900005525, "chapter_id": 8431, "verse_number": "12.51", "content_sanskrit": "तदखण्डं च खण्डितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, "commentaries": [{"id": 1, "verse_id": 900005525, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एवं विशेषानङ्गीकारे वाक्यद्वयस्यानुपपत्तिमभिधायोपसंहरति तदिति ।"}, {"id": 2, "verse_id": 900005525, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तदखण्डं च खण्डितम् ।।\nसुधा\nतत्तस्मादखण्डं निर्विशेषं वाक्यद्वयप्रतिपाद्यमित्येतन्मतं खण्डितं दूषितं वेदितव्य-मित्यर्थः ।"}, {"id": 3, "verse_id": 900005525, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "वाक्यद्वयस्येति । महावाक्यावान्तरवाक्यरूपवाक्यद्वयस्येत्यर्थः ।"}, {"id": 4, "verse_id": 900005525, "commentary_type": "श्रीनिवासतीर्थीया", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "वाक्यद्वयस्य महावाक्यावान्तररूपवाक्यद्वयस्य ।"}]}