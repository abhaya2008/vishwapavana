{"verse": {"id": 2125353, "chapter_id": 3687, "verse_number": "४६", "content_sanskrit": "वृष्टिश्चैवानुगृह्णीयादनेनास्तत्र कर्षकः ।\nयदन्यः पुरुषः कुर्यात् कृतं तत् सकलं मया\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, "commentaries": [{"id": 1, "verse_id": 2125353, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) यदन्यः पुरुष इत्यत्र अन्यः कृषीवलपुरुषः ।"}]}