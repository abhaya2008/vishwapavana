{"verse": {"id": 900006886, "chapter_id": 8506, "verse_number": "87.5", "content_sanskrit": "सदोषत्वान्नेशः पशुपतिस्ततः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, "commentaries": [{"id": 1, "verse_id": 900006886, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "सदोषत्वान्नेशः पशुपतिस्ततः"}, {"id": 2, "verse_id": 900006886, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "सूत्रार्थमुपसंहरति सदोषत्वादिति ।"}, {"id": 3, "verse_id": 900006886, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "........... सदोषत्वान्नेशः पशुपतिस्ततः ।।\nततः श्रुतिबलेन सदोषत्वात्पशुपतिः ईशो जगत्कर्ता न भवति । दोषिणो यज्ञदत्तस्येव जगत्कर्तृत्वानुपपत्तेरिति ।"}, {"id": 4, "verse_id": 900006886, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "ईश इत्यनुवादः । जगत्कर्तेति व्याख्या ।"}]}