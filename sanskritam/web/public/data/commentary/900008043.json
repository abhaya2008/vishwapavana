{"verse": {"id": 900008043, "chapter_id": 8614, "verse_number": "5.11", "content_sanskrit": "विषयाऽश्रयं चेदज्ञानं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, "commentaries": [{"id": 1, "verse_id": 900008043, "commentary_type": "श्रीतत्वोद्योतस्य टीकाया विवृतिः", "author": "", "lang": "sa", "content": "आत्मज्ञानस्यात्माविषयकत्वे तेनात्माज्ञानानिवृत्त्यापादनम्\nविषयाऽश्रयं चेदज्ञानं"}, {"id": 2, "verse_id": 900008043, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "", "lang": "sa", "content": "किञ्च अस्तु वा आत्माज्ञानम् । तथापि न वेदान्तवाक्यजनित-विज्ञानस्याऽत्मज्ञानत्वं सम्भवति । तस्यानात्मविषयत्वेन तन्निवर्तकत्वायोगात् । यद्विषयं हि यद्विज्ञानं तदेव तदज्ञानं निवर्तयदुपलब्धम् ।"}, {"id": 3, "verse_id": 900008043, "commentary_type": "द्वैतद्युमणि:", "author": "", "lang": "sa", "content": "।। किञ्चेति ।। अनात्मविषयत्वेन शुद्धात्माविषयकत्वेन ।\nआत्माविषयकस्याऽत्मज्ञानस्याऽत्माज्ञाननिवर्तकत्वे घटज्ञानस्यापि तन्निवर्तकत्वाऽपादनम्"}]}