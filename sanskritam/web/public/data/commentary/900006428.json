{"verse": {"id": 900006428, "chapter_id": 8489, "verse_number": "70.12", "content_sanskrit": "चेतनेच्छानुसारेण यदा दृष्टः पटोद्भवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, "commentaries": [{"id": 1, "verse_id": 900006428, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "चेतनेच्छानुसारेण यदा दृष्टः पटोद्भवः"}, {"id": 2, "verse_id": 900006428, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एतेन कार्यत्वमभूत्वाभावित्वं चेदसिद्धमस्माकम् । अभिव्यक्तिधर्मकत्वं चेद्युष्माकमिति च निरस्तम् । तदिदमुक्तं केन वार्यत इति ।।"}, {"id": 3, "verse_id": 900006428, "commentary_type": "शेषवाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एतेनेति ।। उद्भवो नामोत्पत्तिरभिव्यक्तिर्वेति विकल्पदूषणनिराकरणप्रकारेणेत्यर्थः । असत्कार्यवादस्य साधितत्वेन सत्कार्यवादस्य दूषितत्वेन चाभूत्वाभावित्वरूपकार्य त्वस्य सिद्धतया तदसिद्ध्यप्रसक्तेरिति भावः । कृतस्य, चर्चस्योद्भाष्यत्वपरिहाराय मूलारूढतां दर्शयति तदिदमिति ।"}, {"id": 4, "verse_id": 900006428, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एतेनेति । उक्तदिशा सत्कार्यत्वादिहेतूनां अपाकरणेनेत्यर्थः ।"}, {"id": 5, "verse_id": 900006428, "commentary_type": "यादुपत्यम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एतेनेति । सत्कार्यवादस्य दूषितत्वेन, सदसत्कार्यवादस्य समर्थितत्वेन चाभूत्वाभावित्वरूपकार्यत्वस्यासिद्ध्यभावेनेत्यर्थः ।"}, {"id": 6, "verse_id": 900006428, "commentary_type": "श्रीनिवासतीर्थीया", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अस्माकम् अत्यन्तसत्कार्यवादिनां साङ्ख्यानामस्माकमसत एवोत्पत्तिरूपमभूत्वाभावित्वमसिद्धमित्यर्थः । युष्माकं सिद्धान्तिभिर्भवद्भिरसत्त्वस्याप्यङ्गीकारेणाभिव्यक्तिर्नाङ्गीकृतेत्यर्थः ।।"}]}