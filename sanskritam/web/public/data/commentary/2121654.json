{"verse": {"id": 2121654, "chapter_id": 3608, "verse_number": "७", "content_sanskrit": "हेमसूत्रा महाकक्ष्याः तोमरैर्वीर्यशाळिनः ।\nभीमरूपाश्च मातङ्गाः प्रवाळविकृताः कुथाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, "commentaries": [{"id": 1, "verse_id": 2121654, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) प्रवाळविकृता इत्यत्र कुथाः गजास्तरणकम्बलविशेषाः ।"}]}