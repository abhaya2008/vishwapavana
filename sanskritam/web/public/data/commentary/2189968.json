{"verse": {"id": 2189968, "chapter_id": 5039, "verse_number": "५", "content_sanskrit": "स्वपतां जाग्रतां चैव सर्वेषामात्मचिन्तितम् ।\nप्रधानद्वैधयुक्तानां जहतां कर्मजं रजः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, "commentaries": [{"id": 1, "verse_id": 2189968, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) प्रधानाद्वैधमुक्तानाम् इत्यत्र द्वैधं द्विप्रकारावलम्बसंशयः ।"}]}