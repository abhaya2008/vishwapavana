{"verse": {"id": 900007433, "chapter_id": 8559, "verse_number": "140.4", "content_sanskrit": "लोकवाक्याद्विशेषश्चाव्यभिचारेण सिध्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, "commentaries": [{"id": 1, "verse_id": 900007433, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "उन्मत्तादिवाक्यात् वेदस्य वैलक्षण्यम्\nलोकवाक्याद्विशेषश्चाव्यभिचारेण सिध्यति"}, {"id": 2, "verse_id": 900007433, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तृतीयं निराकरोति लोकेति ।"}, {"id": 3, "verse_id": 900007433, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "लोकवाक्याद्विशेषश्चाव्यभिचारेण सिध्यति ।।\nउन्मत्तादिवाक्यात् । विशेषो वेदस्य । अव्यभिचारेण बाधराहित्येन । न हि वैदिकोऽर्थः प्रत्यक्षसिद्धो येन तत्तत्र बाधकतयाऽवकाशं लभेत ।एतेन चतुर्थोऽपि निरस्तः ।"}, {"id": 4, "verse_id": 900007433, "commentary_type": "वाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एतेनेति  वैदिकार्थस्याप्रत्यक्षत्वेन तत्र प्रत्यक्षस्य बाधकत्वासम्भवप्रतिपादनेन बाधकसद्भावादिति चतुर्थोऽपि निरस्त इत्यर्थः ।"}, {"id": 5, "verse_id": 900007433, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एतेनेति । फलसंवादकथनेनेत्यर्थः ।"}, {"id": 6, "verse_id": 900007433, "commentary_type": "वाक्यार्थरत्नमाला", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "बाधकसद्भावादितीति । बाधितत्वादिति मूलस्यार्थानुवादोयमित्यदोषः ।"}]}