{"verse": {"id": 900007469, "chapter_id": 8561, "verse_number": "142.10", "content_sanskrit": "कणादयोगाक्षपादा अपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, "commentaries": [{"id": 1, "verse_id": 900007469, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "वैशेषिकपातञ्जलनैयायिका अपि अनुपपन्नभाषिणः\nकणादयोगाक्षपादा अपि"}, {"id": 2, "verse_id": 900007469, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "वैशेषिकाद्युक्तं मोक्षसाधनं निराकरोति कणादेति ।"}, {"id": 3, "verse_id": 900007469, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "कणादयोगाक्षपादा अपि ......\nयोगशब्देन योगानुशासनस्य प्रणेता पतञ्जलिरुपलक्ष्यते । अनुपपन्नभाषिण इति शेषः । न केवलं साङ्ख्याद्या इत्यपेरर्थः ।"}, {"id": 4, "verse_id": 900007469, "commentary_type": "वाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "समयकर्तृपरपूर्वोत्तरपदसन्दृष्टत्वाच्छास्त्रवाचकोऽपि योगशब्दः शास्त्रकर्तृपर इति भावेनाह योगशब्देनेति ।"}, {"id": 5, "verse_id": 900007469, "commentary_type": "वाक्यार्थरत्नमाला", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "पूर्वोत्तरपदेति । कणादाक्षपादरूपपदद्वयेत्यर्थः ।"}]}