{"verse": {"id": 2180339, "chapter_id": 4819, "verse_number": "१७", "content_sanskrit": "मरुप्रपातं प्रपतन् ज्वलनं वा समाविशन् ।\nमहाप्रस्थानमातिष्ठन् मुच्यते सर्वकिल्बिषैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, "commentaries": [{"id": 1, "verse_id": 2180339, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) मरुप्रपातम् इत्यत्र मरुप्रपातं मरुदेशस्थकूपम् ।"}]}