  "commentaries": [
    {
      "id": 1,
      "verse_id": 20210014,
      "commentary_type": "धातुरूपनन्दिनी",
      "author": "",
      "content": " क्लिन्दते क्लिन्दन्तीत्येवम् इदितः परिवेदने । ' क्लिद्यतीत्यार्द्रभावेर्थे क्लिदेः श्यन्यूदितो भवेत्' ( श्लो. 102 ) इति देवः । परिदेवनम् = शोचनम् । क्लिन्दते चैत्रम् ।"
    }
  ]
}