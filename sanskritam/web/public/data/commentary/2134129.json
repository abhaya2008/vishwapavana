{"verse": {"id": 2134129, "chapter_id": 3895, "verse_number": "१६", "content_sanskrit": "युवा काञ्चनसन्नाहः शक्तिभृद् दिव्यकुण्डलः ।\nयद् वज्रविशनाज्जातो विशाखस्तेन सोऽभवत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, "commentaries": [{"id": 1, "verse_id": 2134129, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) यद्वज्रविशनात् इत्यत्र विशनात् विशसनात् ।"}]}