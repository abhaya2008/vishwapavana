{"verse": {"id": 2139222, "chapter_id": 4012, "verse_number": "४", "content_sanskrit": "पाञ्चालराजस्य सुता दृष्ट्वा सुरसुतोपमा ।\nधर्मज्ञा व्यवहाराणां कीचकं कृतकिल्बिषम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, "commentaries": [{"id": 1, "verse_id": 2139222, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) कीचकं कृतकिल्बिषम् इत्यत्र स्मरन्तीत्युत्तरेणान्वयः ।"}]}