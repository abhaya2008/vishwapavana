{"verse": {"id": 2135970, "chapter_id": 3948, "verse_number": "१९", "content_sanskrit": "सा तद्वचः समाज्ञाय तथा चक्रे मनोजवा ।\nइतश्चेतश्च गच्छन्ती वैरसन्धुक्षणे रता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, "commentaries": [{"id": 1, "verse_id": 2135970, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) वैरसन्धुक्षणे रता इत्यत्र वैरसन्धाने ।"}]}