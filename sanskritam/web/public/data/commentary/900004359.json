{"verse": {"id": 900004359, "chapter_id": 8337, "verse_number": "13.3", "content_sanskrit": "आत्मनोऽपि दृश्यत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, "commentaries": [{"id": 1, "verse_id": 900004359, "commentary_type": "प्रमाणलक्षणम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "विश्वमिथ्यात्वानुमाने दृश्यत्वहेतोर्व्यभिचारः"}, {"id": 2, "verse_id": 900004359, "commentary_type": "प्रमाणलक्षणटीका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "दृश्यत्वहेतोरव्याप्तिमुपपादयति"}, {"id": 3, "verse_id": 900004359, "commentary_type": "प्रमाणलक्षणम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "आत्मनोऽपि दृश्यत्वात्\nसत्यत्वेनाङ्गीकृतस्यात्मनो विपक्षत्वात् तत्र च दृश्यत्व-हेतोर्वर्तमानत्वात् व्याप्तिहीनोऽप्यसौ भवति । एतेन व्यतिरेक-दृष्टान्तात् साधनाव्यावृत्तिश्चोपपादिता भवति ।"}]}