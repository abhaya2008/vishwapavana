{"verse": {"id": 2182672, "chapter_id": 4872, "verse_number": "समाप्तिः", "content_sanskrit": "इति वाचा मधुरया श्लक्ष्णया सोपचारया ।\nस्वरश्मीनभ्यवसृजेद् युगमादाय कालवित्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, "commentaries": [{"id": 1, "verse_id": 2182672, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) स्वरश्मीनभ्यवसृजेत् इत्यत्र स्वरश्मीन् स्वविनयपाशान् ।"}]}