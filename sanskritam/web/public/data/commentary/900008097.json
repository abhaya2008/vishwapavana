{"verse": {"id": 900008097, "chapter_id": 8617, "verse_number": "8.4", "content_sanskrit": "यद्येवमपि नानिर्वचनीयत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, "commentaries": [{"id": 1, "verse_id": 900008097, "commentary_type": "श्रीतत्वोद्योतस्य टीकाया विवृतिः", "author": "", "lang": "sa", "content": "प्रसङ्गस्य विपर्यये पर्यत्तसानम्"}, {"id": 2, "verse_id": 900008097, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "", "lang": "sa", "content": "एवं प्रसङ्गमुक्त्वा विपर्यये पर्यवसानमाह ।"}, {"id": 3, "verse_id": 900008097, "commentary_type": "मूलं", "author": "", "lang": "sa", "content": "यद्येवमपि नानिर्वचनीयत्वं ब्रह्मणस्तर्हि जगतोऽपि न स्यात् ।\nएवं भिन्नत्वादिविकल्पानुपपत्त्या प्रसक्तमपि नानिर्वचनीयत्वं ब्रह्मणोऽङ्गीक्रियते चेत्तर्हि विशिष्टादेर्जगतोऽपि न भवत्यविशेषात् ।"}]}