  "commentaries": [
    {
      "id": 1,
      "verse_id": 20012587,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "अनर्थरूपं तेषां कृत्यमाहुः । वर्णाश्रमाणां ये सम्यगाचारास्तान्द्विषन्ति यतो ब्र- ह्माणं ब्राह्मणं वेदं तपो ब्रह्म च विद्विषन्तीति ब्रह्मविद्विषोऽत एव वेदवचनानां जी- विकामात्रतां ब्रुवन्ति । वेदा जीविकार्थं निर्मिता इति कथयन्ति हे प्रभो ॥ ३२ ॥ ॥३२॥"
    },
    {
      "id": 2,
      "verse_id": 20012587,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "आम्नायेति । ‘श्रुतिः स्त्री वेद आम्नायस्त्रयी’ इत्यमराद्वेदवाक्यानामित्यर्थः"
    }
  ]
}