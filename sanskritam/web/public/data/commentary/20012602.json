    "avatarnika": ""
  },
  "commentaries": [
    {
      "id": 1,
      "verse_id": 20012602,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "चन्द्रशेखरः शिवः स्वसुतममन्दं बुद्धिमन्तं स्कन्दमवददुक्तवान् । चन्द्रशेखरं विशि- नष्टि । दन्तात्मकैश्चन्द्रातपैश्चन्द्रज्योत्स्नाभिरानन्दिनो वृन्दारका देवा एव चकोरका यस्य दन्तलक्षणानां चन्द्राणामातपैरिति वा । पाठान्तरे तु क्रियाविशेषणम् ॥ ४७ ॥ ॥ ४७ ॥"
    },
    {
      "id": 2,
      "verse_id": 20012602,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "अमन्दं स्पष्टं यथा भवति तथा"
    }
  ]
}