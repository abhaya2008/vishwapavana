{"verse": {"id": 900007444, "chapter_id": 8560, "verse_number": "141.1", "content_sanskrit": "आनन्दमेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, "commentaries": [{"id": 1, "verse_id": 900007444, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "आत्मस्वरूपे जिनस्य स्खलितवाक्यत्वम्\nआनन्दमेव च"}, {"id": 2, "verse_id": 900007444, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "प्रकारान्तरेणात्मस्वरूपे जिनवचनस्खलनं दर्शयति आनन्दमेवेति ।"}, {"id": 3, "verse_id": 900007444, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "....... ........ आनन्दमेव च ।।\nन मन्यते पुद्गलं स ...... .......\nअत्राप्यपुद्गलपुद्गलशब्दाभ्यामात्मोच्यते । तत्त्वविद आत्मानमानन्दमेवानन्देनात्यन्ताभिन्नं मन्यन्ते । स जिनस्तमानन्दमेव न मन्यते । भिन्नत्वादिना सप्तप्रकारं ब्रवीति । तत्सप्तभङ्गीनयनिरासेन पुंस्त्वादिवदित्यात्मनः सुखाद्यत्यन्ताभेदसाधनेन च निरस्तम् । अतश्च स्खलितवागसाविति भावः ।"}, {"id": 4, "verse_id": 900007444, "commentary_type": "वाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अत्रापीति । नवीनजरज्जैनस्वमतभेदेनेति शेषः ।। सप्तभङ्गिनयनिरासेनेति । ‘नैकस्मिन्नसम्भवादि’ति सूत्रोक्तन्यायेनेत्यर्थः ।"}, {"id": 5, "verse_id": 900007444, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "पुंस्त्वादिवदिति । पुंस्त्वादिवत्त्वस्य सतोऽभिव्यक्तियोगादिति वियत्पादीयजीवविषयकसूत्र इत्यर्थः ।"}]}