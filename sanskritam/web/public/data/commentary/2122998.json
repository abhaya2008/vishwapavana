{"verse": {"id": 2122998, "chapter_id": 3639, "verse_number": "१९", "content_sanskrit": "रथास्तावन्त एवैते हेमभाण्डाः पताकिनः ।\nहयैर्विनीतैः सम्पन्ना रथिभिश्चित्रयोधिभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, "commentaries": [{"id": 1, "verse_id": 2122998, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) हेमभाण्डाः सुवर्णोपकरणानि ।"}]}