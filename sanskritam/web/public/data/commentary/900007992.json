{"verse": {"id": 900007992, "chapter_id": 8611, "verse_number": "2.7", "content_sanskrit": "अनुमानस्य चाप्रसिद्धविशेषणः पक्षः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, "commentaries": [{"id": 1, "verse_id": 900007992, "commentary_type": "श्रीतत्वोद्योतस्य टीकाया विवृतिः", "author": "", "lang": "sa", "content": "अनिर्वचनीयस्यानुमानसिद्धत्वशङ्का तन्निरासश्च"}, {"id": 2, "verse_id": 900007992, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "", "lang": "sa", "content": "माभूत्प्रत्यक्षेणानिर्वचनीयार्थसिद्धिः । विवादपदमनिर्वचनीयम् । बाध्यत्वात् । यन्नानिर्वचनीयं न तद्बाध्यं यथात्मेत्यनुमानेन भविष्यतीत्यत आह"}, {"id": 3, "verse_id": 900007992, "commentary_type": "मूलं", "author": "", "lang": "sa", "content": "अनुमानस्य चाप्रसिद्धविशेषणः पक्षः ।\nचशब्दः प्रत्यक्षनिराकरणेनानुमाननिराकरणसमुच्चये वर्तते ।"}]}