{"verse": {"id": 900004230, "chapter_id": 8328, "verse_number": "4.6", "content_sanskrit": "अयोगिज्ञानमुत्पत्तिविनाशवत्, अल्पम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, "commentaries": [{"id": 1, "verse_id": 900004230, "commentary_type": "प्रमाणलक्षणम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अयोगिज्ञाननिरूपणम्"}, {"id": 2, "verse_id": 900004230, "commentary_type": "प्रमाणलक्षणटीका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अयोगिज्ञानं किमीश्वराऽदिज्ञानवदनादिनित्यमेव सदिन्द्रियसन्निकर्षाऽदिनाभिव्यज्यते । उत सादि विनाशि चेति। तत्राह –"}, {"id": 3, "verse_id": 900004230, "commentary_type": "प्रमाणलक्षणम्", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अयोगिज्ञानमुत्पत्तिविनाशवत्\nतस्य लक्षणमाह\nअल्पम्\nईशादन्यत्राल्पविषयम् ।"}]}