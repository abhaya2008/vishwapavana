  "commentaries": [
    {
      "id": 1,
      "verse_id": 20012626,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "स विशेषेण सर्वं जानातीति विज्ञः सर्वज्ञो भट्टपादो द्विषां शत्रूणां सुगतानां सर्व- ज्ञपदमसहमान इवेत्यन्वयः ॥ ७१ ॥"
    },
    {
      "id": 2,
      "verse_id": 20012626,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "इवेति । चित्रविन्यस्तानिवेत्युत्तरत्राप्यनुकृष्य योज्यम्"
    }
  ]
}