{"verse": {"id": 2202976, "chapter_id": 5324, "verse_number": "५", "content_sanskrit": "शृणुष्वावहितस्तात ज्ञानयोगमनुत्तमम् ।\nअप्रभूतं प्रभूतार्थं वेदशास्त्रार्थसारकम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, "commentaries": [{"id": 1, "verse_id": 2202976, "commentary_type": "ಕನ್ನಡ ಅರ್ಥ", "author": "ಕನ್ನಡ ಅರ್ಥ", "lang": "kn", "content": "ಪ್ರೀತಿಪಾತ್ರನೇ, ಶ್ರೇಷ್ಠವಾದ, ಅಲ್ಪವಾದ, ಮಹಾಫಲದಾಯಕವಾದ, ವೇದಶಾಸ್ತ್ರಗಳ ಅರ್ಥಸಾರರೂಪವಾದ ಜ್ಞಾನಯೋಗವನ್ನು ಕೇಳು."}]}