{"verse": {"id": 2207314, "chapter_id": 5420, "verse_number": "२", "content_sanskrit": "सोऽनुनीतो भगवता विष्टरश्रवसा स्वयम् ।\nद्वैपायनेन कृष्णेन देवस्थानेन चैव हि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, "commentaries": [{"id": 1, "verse_id": 2207314, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) देवस्थानेन देवस्थानाख्यऋषिणा ।"}]}