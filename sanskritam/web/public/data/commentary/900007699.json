{"verse": {"id": 900007699, "chapter_id": 8580, "verse_number": "161.13", "content_sanskrit": "तादृशोऽपि स्वभावश्चेदज्ञस्यापि भवेत्तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, "commentaries": [{"id": 1, "verse_id": 900007699, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "उक्तार्थसमर्थनम्\nतादृशोऽपि स्वभावश्चेदज्ञस्यापि भवेत्तथा"}, {"id": 2, "verse_id": 900007699, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "नन्वेते प्रागनुष्ठानकाले भयपूर्वं कृच्छ्रेणाशुभपरित्यागेनैवानुष्ठितवन्तः । अतः तत्स्वभावा एव संवृत्ता इदानीमपि तत्स्वाभाव्येन तथैव कुर्वन्तीत्यङ्गीकारे को दोष इत्याशङ्क्याह तादृशोऽपीति ।"}, {"id": 3, "verse_id": 900007699, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तादृशोऽपि स्वभावश्चेदज्ञस्यापि भवेत्तथा ।।\nभयपूर्वप्रवृत्त्यादिरूपोऽपि ।"}, {"id": 4, "verse_id": 900007699, "commentary_type": "वाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "नन्वित्यादिशङ्कासमाधानग्रन्थः स्पष्टार्थः ।"}, {"id": 5, "verse_id": 900007699, "commentary_type": "श्रीनिवासतीर्थीया", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "संवृत्ताः सञ्जाताः ।"}]}