  },
  "commentaries": [
    {
      "id": 1,
      "verse_id": 20211564,
      "commentary_type": "उपसर्गार्थाः",
      "author": "",
      "content": "आ — आकुंचित करना या होना\nसम् — संकुचित करना या होना"
    },
    {
      "id": 2,
      "verse_id": 20211564,
      "commentary_type": "धातुरूपनन्दिनी",
      "author": "",
      "content": "सङ्कोचः ह्रस्वीभवनम् । प्रायेण सम्पूर्वक एव अयं प्रयुज्यते । ' सङ्कोचे कुचतीति स्यात् काचेत् सम्पर्चनादिषु ' (श्लो. 54) इति देवः ।"
    }
  ]
}