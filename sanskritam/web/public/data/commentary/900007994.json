{"verse": {"id": 900007994, "chapter_id": 8611, "verse_number": "2.9", "content_sanskrit": "अनुमानस्य चाप्रसिद्धविशेषणः पक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, "commentaries": [{"id": 1, "verse_id": 900007994, "commentary_type": "श्रीतत्वोद्योतस्य टीकाया विवृतिः", "author": "", "lang": "sa", "content": "अप्रसिद्धविशेषणत्वस्यासाधकत्वहेतुत्वसमर्थनम्\nअनुमानस्य चाप्रसिद्धविशेषणः पक्षः"}, {"id": 2, "verse_id": 900007994, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "", "lang": "sa", "content": "अथ कथमप्रसिद्धविशेषणत्वमसाधकत्वे हेतुः । व्याप्तिपक्षधर्मताविरहात् । न ह्यप्रतीतेन कस्यापि व्याप्तिश्शक्यग्रहा । सन्दिग्धसाध्यदर्मवांश्च पक्षः । न चाप्रसिद्ध-विशेषणोल्लेखी सन्देहो युज्यते ।"}]}