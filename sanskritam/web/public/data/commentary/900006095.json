{"verse": {"id": 900006095, "chapter_id": 8471, "verse_number": "52.24", "content_sanskrit": "याथार्थ्यमेव मानत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, "commentaries": [{"id": 1, "verse_id": 900006095, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "याथार्थ्यमेव मानत्वम्"}, {"id": 2, "verse_id": 900006095, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "(नापि) न पञ्चमः । तादृशस्य दर्शयितुमशक्यत्वादिति ।।"}, {"id": 3, "verse_id": 900006095, "commentary_type": "वाक्यार्थचन्द्रिका", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अस्तु तर्ह्यन्यत्किञ्चिदर्थमिति पञ्चमः कल्पो नेत्याह नापीति । हेतुमाह तादृशस्येति । तस्य सतो निर्वचनापातान्निर्वक्तुं चाशक्यत्वादित्यर्थः ।"}, {"id": 4, "verse_id": 900006095, "commentary_type": "परिमळ", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अन्यस्मै कस्मैचित् प्रयोजनायेत्येतन्निराह नापि पञ्चम इति ।।"}, {"id": 5, "verse_id": 900006095, "commentary_type": "श्रीनिवासतीर्थीया", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "तादृशस्य तथाविधप्रयोजनस्य ।"}]}