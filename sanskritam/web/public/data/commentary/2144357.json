{"verse": {"id": 2144357, "chapter_id": 4108, "verse_number": "११", "content_sanskrit": "अजोऽश्वश्चन्दनं वीणा आदर्शो मधुसर्पिषी ।\nविषमौदुम्बरं शङ्खः स्वर्णनाभोऽथ रोचना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, "commentaries": [{"id": 1, "verse_id": 2144357, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) विषमौदुम्बरम् इत्यत्र विषम् उदकम् ।"}]}