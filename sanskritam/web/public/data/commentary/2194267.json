{"verse": {"id": 2194267, "chapter_id": 5126, "verse_number": "१९", "content_sanskrit": "शब्द एकमतैरेष व्याहृतः परमर्षिभिः ।\nनान्यो ह्यधोक्षजो लोके ऋते नारायणं प्रभुम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, "commentaries": [{"id": 1, "verse_id": 2194267, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) एकमतैः एकैकमतप्रवर्तकैः ।"}]}