{"verse": {"id": 2185968, "chapter_id": 4947, "verse_number": "८", "content_sanskrit": "शालतालधवाश्वत्थचिञ्चागरुवनैस्तथा ।\nचन्दनस्य च मुख्यस्य पादपैरुपशोभितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, "commentaries": [{"id": 1, "verse_id": 2185968, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) चिञ्चगरुवनैस्तथा इत्यत्र चिञ्चा तिन्त्रिणी ।"}, {"id": 2, "verse_id": 2185968, "commentary_type": "ಕನ್ನಡ ಅರ್ಥ", "author": "ಕನ್ನಡ ಅರ್ಥ", "lang": "kn", "content": "ಶಾಲ-ತಾಲ-ಧವ-ಅಶ್ವತ್ಥ-ಹುಣಸೆ, ಅಗರುಗಳ ವನಗಳು ಆ ವನದಲ್ಲಿದ್ದವು. ಬಹಳ ಚಂದನ ವೃಕ್ಷಗಳಿಂದ ಅರಣ್ಯವು ಶೋಭಿಸುತ್ತಿತ್ತು."}]}