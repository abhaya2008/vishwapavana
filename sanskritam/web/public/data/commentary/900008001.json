{"verse": {"id": 900008001, "chapter_id": 8612, "verse_number": "3.1", "content_sanskrit": "न च बाष्पारोपितधूमेन धूमवत्त्वं व्यभिचरति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, "commentaries": [{"id": 1, "verse_id": 900008001, "commentary_type": "श्रीतत्वोद्योतस्य टीकाया विवृतिः", "author": "", "lang": "sa", "content": "धूमत्वस्य बाष्पारोपितधूमवृत्तित्वाङ्गीकारे दोषकथनम्"}, {"id": 2, "verse_id": 900008001, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "", "lang": "sa", "content": "ननु बाष्पारोपितधूमेऽपि धूमत्वसामान्याङ्गीकारे को दोष इति चेत् तदा पर्वतस्याग्निमत्त्वे साध्ये प्रयुज्यमानं धूमत्त्वं बाष्पारोपितधूमेन निरग्निकेऽपि ह्रदादौ वर्तमानेन निमित्तेनाग्निव्यभिचारि स्यात् । न च तेन तदग्निं व्यभिचरति । निःशङ्कं लोकव्यवहारहेतुत्वादित्याह ।"}, {"id": 3, "verse_id": 900008001, "commentary_type": "मूलं", "author": "", "lang": "sa", "content": "न च बाष्पारोपितधूमेन धूमवत्त्वं व्यभिचरति ।"}]}