{"verse": {"id": 2113833, "chapter_id": 3447, "verse_number": "४०", "content_sanskrit": "प्राङ्मुखश्चोपविष्टश्च रसं पिबत पाण्डवः ।\nएकोच्छ्वासात् तदा कुण्डं पिबति स्म महाबलः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, "commentaries": [{"id": 1, "verse_id": 2113833, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) पिबत पाण्डव इत्यत्र पिबत अपिबत ।"}]}