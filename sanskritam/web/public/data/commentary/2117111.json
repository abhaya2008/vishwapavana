{"verse": {"id": 2117111, "chapter_id": 3522, "verse_number": "१", "content_sanskrit": "सौमदत्तेर्वचः श्रुत्वा कर्णो वैकर्त्तनो वृषा ।\nउवाच वचनं काले कालज्ञः सर्वकर्मणाम् \t॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, "commentaries": [{"id": 1, "verse_id": 2117111, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) वृषा श्रेष्ठः ।"}]}