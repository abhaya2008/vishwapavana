{"verse": {"id": 2117592, "chapter_id": 3531, "verse_number": "११", "content_sanskrit": "नभस्स्थलेन दिव्येन दुर्लभेनातपस्विनाम् ।\nभूतार्चितो भूतधरां राष्ट्रमन्दिरभूषिताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, "commentaries": [{"id": 1, "verse_id": 2117592, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) भूतधरां भूतधात्रीं भूमिम् ।"}]}