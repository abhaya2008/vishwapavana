{"verse": {"id": 900005548, "chapter_id": 8432, "verse_number": "13.13", "content_sanskrit": "चातिप्रसङ्गोऽनुमयेदृशा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, "commentaries": [{"id": 1, "verse_id": 900005548, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "चातिप्रसङ्गोऽनुमयेदृशा"}, {"id": 2, "verse_id": 900005548, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "आभाससमानयोगक्षेमं चेश्वरानुमानजातमित्याह चातिप्रसङ्ग इति ।"}, {"id": 3, "verse_id": 900005548, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "चातिप्रसङ्गोऽनुमयेदृशा ।।\nसुधा\nईदृशा आगमादिसहायसंपदमपहायात्यन्तातीन्द्रियार्थेषु प्रयुज्यमानया अनुमया अतिप्रसङ्गश्च भवतीत्यर्थः । अतिप्रसङ्गमेव दर्शयति वस्तुत्वादिति ।"}]}