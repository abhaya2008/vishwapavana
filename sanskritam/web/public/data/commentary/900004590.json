{"verse": {"id": 900004590, "chapter_id": 8349, "verse_number": "8.14", "content_sanskrit": "यद्येवमपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, "commentaries": [{"id": 1, "verse_id": 900004590, "commentary_type": "तत्त्वोद्योतः", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "प्रसङ्गस्य विपर्यये पर्यवसानम्"}, {"id": 2, "verse_id": 900004590, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "एवं प्रसङ्गमुक्त्वा विपर्यये पर्यवसानमाह-"}, {"id": 3, "verse_id": 900004590, "commentary_type": "मूल", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "यद्येवमपि नानिर्वचनीयत्वं ब्रह्मणस्तर्हि जगतोऽपि न स्यात् ।\nएवं भिन्नत्वादिविकल्पानुपपत्त्या प्रसक्तमपि नानिर्वचनीयत्वं ब्रह्मणोऽङ्गीक्रियते चेत्तर्हि विशिष्टादेर्जगतोऽपि न भवत्यविशेषात् ।"}]}