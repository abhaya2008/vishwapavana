    "verse_number": "८४",
    "content_sanskrit": "यस्य साध्याभावः प्रमाणान्तरेण पक्षे निश्चितः, स बाधितः । यथा वह्निरनुष्णो द्रव्यत्वादिति । अत्रानुष्णत्वं साध्यं, तदभाव उष्णत्वं स्पार्शनप्रत्यक्षेण गृह्यते इति बाधितत्वम् ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": "बाधितः"
  },
  "commentaries": [
    {
