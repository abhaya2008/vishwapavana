  "commentaries": [
    {
      "id": 1,
      "verse_id": 20211722,
      "commentary_type": "उपसर्गार्थाः",
      "author": "",
      "content": "आ — चारों और से बांधना\nअनु — जोड़ना, चिपकाना, एकत्र करना, अनुसरण करना\nनि — बन्धन मुक्त करना, इकठ्ठा करना\nसम् — मिलाप करना"
    },
    {
      "id": 2,
      "verse_id": 20211722,
      "commentary_type": "धातुरूपनन्दिनी",
      "author": "",
      "content": " नोपधः । ' बध्नाति बन्धने बन्धेर्बाधयेदिति संयमे ' (श्लो. 120) इति देवः ।"
    }
  ]
}