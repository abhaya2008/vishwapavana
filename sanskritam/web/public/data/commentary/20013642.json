  "commentaries": [
    {
      "id": 1,
      "verse_id": 20013642,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "तदुदाहरति । 'ईशानः सर्वविद्यानामीश्वरः सर्वभूतानां ब्रह्माधिपतिः' इत्यादिमन्त्र- प्रतिपादितः सदाशिवो हे ब्रह्मन्साक्षाद्भवानित्यर्थः ॥ ६६ ॥"
    },
    {
      "id": 2,
      "verse_id": 20013642,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "ब्रह्मणश्चतुरानन- स्येत्यर्थः । एवं चेदानीं तदवतारस्यास्य मद्भर्तुः संन्यासप्रदानपूर्वकानुग्रहकरणेऽ- वियोग्योऽसीति सूचितम्"
    }
  ]
}