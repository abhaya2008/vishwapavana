    "avatarnika": "बुद्धिः"
  },
  "commentaries": [
    {
      "id": 1,
      "verse_id": 20216659,
      "commentary_type": "टीका",
      "author": "",
      "content": "सर्वेति । बुद्धिलक्षणमाह सर्वेति । सर्वे ये व्यवहाराः आहारविहारादयः तेषां हेतुर्बुद्धिः इत्यर्थः । दण्डादिवारणाय सर्वव्यवहारेति । कालादिवारणाय असाधारणेति देयम् ।"
    }
  ]
}