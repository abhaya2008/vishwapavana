{"verse": {"id": 900007309, "chapter_id": 8548, "verse_number": "129.3", "content_sanskrit": "अखण्डखण्डनादेवं विशेषोऽखण्डवादिना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, "commentaries": [{"id": 1, "verse_id": 900007309, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अखण्डखण्डनादेवं विशेषोऽखण्डवादिना"}, {"id": 2, "verse_id": 900007309, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "उपसंहरति अखण्डेति ।"}, {"id": 3, "verse_id": 900007309, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अखण्डखण्डनादेवं विशेषोऽखण्डवादिना ।।\nखण्डितेनापि मनसा स्वीकार्योऽनन्यथागतेः ।।\nएव(यस्मादे)मखण्डखण्डनादखण्डवादिनाऽपीत्यन्वयः । अनन्यथागतेः हेतोः, खण्डितेन उत्तरोत्प्रेक्षारहितेन ।"}, {"id": 4, "verse_id": 900007309, "commentary_type": "श्रीनिवासतीर्थीया", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "अन्यथागतेर्हेतोरिति । अन्यथा गत्यभावरूपत्वात्कारणादित्यर्थः ।"}]}