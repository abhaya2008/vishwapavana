{"verse": {"id": 2179663, "chapter_id": 4804, "verse_number": "१५", "content_sanskrit": "पुत्रसङ्क्रामितश्रीस्तु वने वन्येन वर्तयन् ।\nविधिना श्रावणेनैव कुर्यात् कालमतन्द्रितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, "commentaries": [{"id": 1, "verse_id": 2179663, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) विधिना श्रावणेनैव इत्यत्र श्रावणेन श्रवणानुकूलेन ।"}]}