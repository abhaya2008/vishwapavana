  "commentaries": [
    {
      "id": 1,
      "verse_id": 20013559,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "एवमज्ञस्याविकारिणः सच्वादिभिरविशेषशास्त्रसाफल्यमुक्त्वा तत्त्वविदोऽधिकाराभावमाह । कृता संपादिता महावाक्यजन्या धीर्येन स त्वाश्रमादिविनिर्मुक्तमात्मानमात्मत्वेनावगत्य वेदान्तप्रतिपाद्यस्वरूपत्वान्निगमस्य मूर्ध्नि वसन्विधिकिंकरतां न भजेत् । विधिग्रहणं प्रतिषेधस्याप्युपलक्षणम् ॥ ९३ ॥"
    },
    {
      "id": 2,
      "verse_id": 20013559,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "[ अवर्ण ब्राह्मणादिवर्णशून्यम् । अजाति मनुष्यत्वाद जातिविधुरम् ]"
    }
  ]
}