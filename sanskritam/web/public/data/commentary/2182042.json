{"verse": {"id": 2182042, "chapter_id": 4858, "verse_number": "१२", "content_sanskrit": "चौर्यमव्यवहारश्च व्यवहारोपसेवनम् ।\nअदण्ड्यदण्डनं चैव दण्ड्यानां चाप्यदण्डनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, "commentaries": [{"id": 1, "verse_id": 2182042, "commentary_type": "लक्षालङ्कारः", "author": "श्रीमन्महाभारतलक्षालङ्कारः — श्रीवादिराजतीर्थविरचितः", "content": "(ल) व्यवहारोपसेवनं वैश्यवत् क्रयविक्रयादिव्यवहारोपसेवनम् ।"}]}