    "chapter_id": 6702,
    "verse_number": "10.54",
    "content_sanskrit": "अविगीतमेवं नरपतिराकर्ण्य वर्णितात्मार्थम् । विससर्ज पूरिताशानेतानितिकर्तव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  "commentaries": [
    {
      "id": 1,
      "verse_id": 20013632,
      "commentary_type": "डिण्डिमटीका (धनपतिसूरिः)",
      "author": "",
      "content": "एवमविगीतमनिन्दितं वर्णितमात्मवस्तु श्रुत्वा । 'अर्थो विषयार्थनयोर्धनकारणवस्तुषु' इति मेदिनी । निर्ज्ञातं कर्तव्यं येन स नृपतिः पूरिता आशा येषां तानेतान्शि- ष्यान्विससर्ज । 'आर्याद्वितीयकेऽर्धे यद्गदितं लक्षणं तत्स्यात् । यद्युभयोरपि दलयोरुपगीतिं तां मुनिर्ब्रूते' । ॥ ५६ ॥"
    },
    {
      "id": 2,
      "verse_id": 20013632,
      "commentary_type": "अद्वैतराज्यलक्ष्मी (अच्युतः)",
      "author": "",
      "content": "भूरिवाशानिङ्गितेनानुमोदनसूचितेनान्तःपूरितमनोरथान्पारितोषिकवि- स्रवस्त्रविभूषणादिदानेन बहिरपि तथा"
    }
  ]
}