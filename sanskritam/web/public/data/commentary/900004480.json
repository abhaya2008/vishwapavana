{"verse": {"id": 900004480, "chapter_id": 8344, "verse_number": "3.4", "content_sanskrit": "मिथ्याशब्दोऽनिर्वचनीयं वदतीत्यत्र च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, "commentaries": [{"id": 1, "verse_id": 900004480, "commentary_type": "तत्त्वोद्योतः", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "पूर्वोक्तशङ्काद्वयनिरासः"}, {"id": 2, "verse_id": 900004480, "commentary_type": "श्रीमज्जयतीर्थटीका", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "अत्रेदं वक्तव्यम् । किं मिथ्याशब्दोऽनिर्वचनीयस्य वाचक इति कृत्वा भ्रान्त्युत्थितस्य तत्प्रयोगदर्शनादनिर्वचनीयविषयः प्रत्ययोऽनुमीयते । उतावाचकेनापि तेन भ्रान्त्युत्थितोऽ-निर्वचनीयं व्यवहरतीति कृत्वा । आद्यं निराकरोति-"}, {"id": 3, "verse_id": 900004480, "commentary_type": "मूल", "author": "श्रीमध्वाचार्यः", "lang": "sa", "content": "मिथ्याशब्दोऽनिर्वचनीयं वदतीत्यत्र च ।\nन किञ्चिन्मानमित्यस्यानुकर्षणार्थश्चकारः ।"}]}