    "verse_number": "2.11",
    "content_sanskrit": "स्त्रियोप्सरायमाणास्तं संक्रन्दनसमद्युतिम् । प्रतिभूषितनिःशेषभूषणाङ्ग्यस्सिषेविरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
