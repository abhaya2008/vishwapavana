  "commentaries": [
    {
      "id": 1,
      "verse_id": 20010431,
      "commentary_type": "विवरणव्याख्यानम्",
      "author": "",
      "content": "अप्सरस्तुल्याः स्त्रियः तमिन्द्रतेजसं सिषेविरे । प्रतीपं भूषितानि सर्वाणि भूषणानि हारवलयादीनि यैस्तान्यङ्गानि यासां ताः । अतिसौन्दर्यादाभरणान्यपि निजगात्रैर्भूषयन्त्य इति यावत् ॥"
    }
  ]
}