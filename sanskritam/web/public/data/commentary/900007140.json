{"verse": {"id": 900007140, "chapter_id": 8530, "verse_number": "111.10", "content_sanskrit": "सिद्धप्रश्नादिकं यत्तदाधिक्यान्तर्गतं भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, "commentaries": [{"id": 1, "verse_id": 900007140, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "सिद्धर्थतावैफल्ययोराधिक्येऽन्तर्भावः\nसिद्धप्रश्नादिकं यत्तदाधिक्यान्तर्गतं भवेत्"}, {"id": 2, "verse_id": 900007140, "commentary_type": "सुधा", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "नन्वेवं सति षडेव निग्रहस्थानानीति नियमो भज्येत । स्वव्याहत्यसङ्गत्योर्विरोधासङ्गत्यन्तर्भावेऽपि सिद्धार्थतावैफल्ययोरतिरिक्तत्वादित्यत आह सिद्धेति ।"}, {"id": 3, "verse_id": 900007140, "commentary_type": "अनुव्याख्यानम्", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "सिद्धप्रश्नादिकं यत्तदाधिक्यान्तर्गतं भवेत् ।"}, {"id": 4, "verse_id": 900007140, "commentary_type": "श्रीनिवासतीर्थीया", "author": "श्रीजयतीर्थः", "lang": "sa", "content": "एवं सीति । चतुर्णां प्रश्नदोषसत्वे ।"}]}