[["ख आपतन्तं ज्वलितं महोल्कवन्निरीक्ष्य दुष्प्रेक्ष्यमजातविक्लवः।", "6.12.3"], ["खं रोदसी ज्योतिरनीकमाशाः सूर्येन्दुवह्निश्वसनाम्बुधींश्च।", "10.8.38"], ["खं रोदसी भगणानद्रिसागरान् द्वीपान् सवर्षान् ककुभः सुरासुरान्।", "12.8.28"], ["खं वायुमग्निं सलिलं महीं च ज्योतींषि सत्त्वानि दिशो द्रुमादीन्।", "11.2.41"], ["खं वायुर्ज्योतिरापो भूस्तत्कृतेषु यथाशयम्।", "10.74.25"], ["खं व्यभ्रमुदितादित्यं वातवर्षं च दारुणम्।", "10.23.25"], ["खगणस्तत्सुतस्तस्माद् विधृतश्चाभवत् सुतः।", "9.10.3"], ["खगा वीतफलं वृक्षं भुक्त्वा चातिथयो गृहम्।", "10.45.8"], ["खट्वाङ्गस्य च मान्धातुः सौभरेः सगरस्य च।", "12.12.23"], ["खट्वाङ्गाद् दीर्घबाहुश्च रघुस्तस्मात् पृथुश्रवाः।", "9.8.82"], ["खट्वाङ्गो नाम राजर्षिः ज्ञात्वेयत्तामिहायुषः।", "2.1.13"], ["खड्गमादाय तरसा प्रलीनोडुगणे निशि।", "9.3.6"], ["खद्योताविर्मुखी च प्राग्द्वारावेकत्र निर्मिते।", "4.25.48"], ["खमशोभत निर्मेघं शरद्विमलतारकम्।", "10.18.41"], ["खरैरुष्ट्रैर्महाकोशान् रथांश्च द्रविणं महत्।", "10.64.32"], ["खरोष्ट्राः कर्कशैः क्षत्तः खुरैर्घ्नन्तो धरातलम्।", "3.18.11"], ["खरोऽश्वोऽश्वतरो गौरः शरभश्चमरी तथा।", "3.11.22"], ["खल्विदं महदाश्चर्यं यद् रजःप्रकृतेस्तव।", "6.12.21"], ["खाण्डिक्यः कर्मतत्त्वज्ञो भीतः केशिध्वजाद् गतः।", "9.11.21"], ["खान्याकाशे द्रवं तोये यथास्थानं विभागशः।", "4.23.16"], ["खुरैः क्षुरप्रैर्दरयंस्तदाप उत्पारवारं त्रिवरू रसायाम्।", "3.14.32"], ["खे खानि वायौ निःश्वासान् तेजस्यूष्माणमात्मवान्।", "7.12.25"]]